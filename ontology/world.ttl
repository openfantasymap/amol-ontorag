    rpg:hasTag amol:HermeticConcept .
amol:FantasticBeastLore a rpg:Proficiency ;
    rpg:name "Fantastic Beast Lore" ;
    dc:description "Ability appearing in character or covenant library statistics in the Roman Tribunal." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:FeastOfTheDead a rpg:Tag ;
    skos:prefLabel "Feast of the Dead" ;
    dc:description "Minor Supernatural Virtue letting a faerie recover 2 Might after draining a Long Term Fatigue level or causing a Medium Wound to a human." ;
    rpg:hasTag amol:Virtue .
amol:FimusWarriorDemon a rpg:Creature ;
