amol:TheGodOfLaw a rpg:Tag ;
    skos:prefLabel "The God of Law" ;
    dc:description "In the new dualist faith near the Bohemian Forest, the stern god who created and rules the material world but cares not for its inhabitants, falsely worshipped (the faith claims) by the Church." ;
    rpg:hasTag amol:HermeticConcept .
amol:TheGodOfTruth a rpg:Tag ;
    skos:prefLabel "The God of Truth" ;
    dc:description "The creator deity of a new dualist faith in the villages near the Bohemian Forest, said to be immaterial and found only in wild places, opposed to the God of Law; his angels are said to be faeries, and his prophet is Iacob." ;
    rpg:hasTag amol:HermeticConcept .
amol:TheGoddessSCompanion a rpg:Tag ;
    skos:prefLabel "The Goddess's Companion" ;
    dc:description "Dindyméné's ritual power creating a mundane bear." ;
    rpg:hasTag amol:HermeticConcept .
amol:TheGoddessSProtector a rpg:Tag ;
    skos:prefLabel "The Goddess's Protector" ;
    dc:description "Dindyméné's ritual power creating a mundane lion." ;
    rpg:hasTag amol:HermeticConcept .
amol:TheGodhead a rpg:Creature ;
    rpg:name "The Godhead" ;
    dc:description "A demon of the Order of False Gods, an invisible stone head replacing Mercury's statue head, who poses as Mercury to corrupt magi." ;
    skos:altLabel "False Mercury" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:TheGoodWitness a rpg:Spell ;
    rpg:name "The Good Witness" ;
    dc:description "CrMe 25 spell refreshing a subject's memory of one day." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheGrayBull a rpg:Creature ;
    rpg:name "The Gray Bull" ;
    dc:description "Iceland's third guardian, a spirit bull tamed by the Dominion at Skalholt in 1105 and held as Bishop Magnus's stud; if freed it grows into a vast aurochs." ;
    skos:altLabel "Grey Bull" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:TheGreatDiscord a rpg:Spell ;
    rpg:name "The Great Discord" ;
    dc:description "CrVi 55 Ritual that taints a parish so everyone suffers The Gift's social penalties for a Moon." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheGreatPlay a rpg:Tag ;
    skos:prefLabel "The Great Play" ;
    dc:description "A tournament hosted every few years by the Shadow-Masters in which a built labyrinth or setting filled with illusions challenges participants; succeeding wins the responsibility to host the next event." ;
    rpg:hasTag amol:HermeticConcept .
amol:TheHalfShell a rpg:Item ;
    rpg:name "The Half Shell" ;
    dc:description "A large ship serving as the mobile site (an Edifice Boon) of the Swashbuckling covenant." ;
    skos:altLabel "The Large Ship The Half Shell" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheHalfGlade a schema:Place ;
    rpg:name "The Half-Glade" ;
    dc:description "Half circle of nine trees in the Faerie forest serving as a seasonal portal to far Faerie places." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheHedgeLordSSynthemataOfX a rpg:Spell ;
    rpg:name "The Hedge Lord's Synthemata of (X)" ;
    dc:description "MuVi spell from Synthemata Magia adding (level-5) to Casting Score against the named being for two minutes." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheHerbalOfCrateuas a rpg:Item ;
    rpg:name "The Herbal of Crateuas" ;
    dc:description "Crateuas's catalog of herbs and their powers, written in ancient Greek; a summa for several Abilities and rumored source of Insight into the Root-Cutter Virtue." ;
    skos:altLabel "Crateuas's herbal" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheHornThatFurnishesSoldiers a rpg:Item ;
    rpg:name "The Horn that Furnishes Soldiers" ;
    dc:description "Further idea for a prop story element." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheHorsemen a rpg:Creature ;
    rpg:name "The Horsemen" ;
    dc:description "Ghostly faerie riders of the Wild Hunt (Faerie Might 20) embodying icy winter storms, who can spread fear, control winds, and inflict cold; they can produce spells like Broom of the Winds." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:TheImmortalSGrimoire a rpg:Spell ;
    rpg:name "The Immortal's Grimoire" ;
    dc:description "ReVi Mystery enchantment letting a talisman hold a spell so an immortal can cast it normally." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheImpassableRiver a rpg:Spell ;
    rpg:name "The Impassable River" ;
    dc:description "ReCo 60 ritual turning a river into a magical boundary that no man, woman or child can cross, used to protect lands from invasion." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheImperfectDefense a rpg:Tag ;
    skos:prefLabel "The Imperfect Defense" ;
    dc:description "Secret that a Divine aura suppresses Magvillus's Aegis for two hours before sunrise on Good Friday." ;
    rpg:hasTag amol:HermeticConcept .
amol:TheImpossibleRetreat a rpg:Tag ;
    skos:prefLabel "The Impossible Retreat" ;
    dc:description "Halcyon power to teleport to an Arcane Connection." ;
    rpg:hasTag amol:HermeticConcept .
amol:TheIncoherenceOfTheIncoherence a rpg:Item ;
    rpg:name "The Incoherence of the Incoherence" ;
    dc:description "A book by Averroes refuting al-Ghazali's The Incoherence of the Philosophers." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheIncoherenceOfThePhilosophers a rpg:Item ;
    rpg:name "The Incoherence of the Philosophers" ;
    dc:description "A book by al-Ghazali rejecting the ideas of Aristotle, Plato, and Socrates as harmful to the faithful." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheIncubusSTrick a rpg:Spell ;
    rpg:name "The Incubus's Trick" ;
    dc:description "A spell that turns a male caster into a woman, the counterpart of The Succubus's Trick." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheInfernalGraveOfWilliamTheConqueror a rpg:Tag ;
    skos:prefLabel "The Infernal Grave of William the Conqueror" ;
    dc:description "Story of William's corpse, inhabited by a demon trapped by his botched funeral rite." ;
    rpg:hasTag amol:HermeticConcept .
amol:TheInnOfGoodRest a schema:Place ;
    rpg:name "The Inn of Good Rest" ;
    dc:description "Brothel run by followers of a faerie lord that poisons pilgrims visiting a local shrine just after they reach a state of grace." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheInscription a rpg:Item ;
    rpg:name "The Inscription" ;
    dc:description "Ancient story on a cave wall binding Winter from Somerset; Averna believed it a Titan weapon." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheInstantBreach a rpg:Item ;
    rpg:name "The Instant Breach" ;
    dc:description "PeTe 15 Charged Item destroying a section of stone wall." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheInverted a rpg:Creature ;
    rpg:name "The Inverted" ;
    dc:description "Merfolk-derived faeries placed on land who sail sky-boats and net birds as fishers do fish." ;
    skos:altLabel "Inverted Fishers", "Inverted Men" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:TheInvisibleGlassWorker a rpg:Spell ;
    rpg:name "The Invisible Glass-worker" ;
    dc:description "A ReTe 4 spell (Touch, Momentary, Individual) that transforms a piece of glass into a finished form as if shaped by a glassworker." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheInvisibleShield a rpg:Item ;
    rpg:name "The Invisible Shield" ;
    dc:description "Enchanted item owned by Victor the redcap that protects him from metal weapons." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheIrresistibleDance a rpg:Spell ;
    rpg:name "The Irresistible Dance" ;
    dc:description "Empathy/Beguile 25 rite compelling the target to dance with hedonistic abandon." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheIrresistiblePressgang a rpg:Spell ;
    rpg:name "The Irresistible Pressgang" ;
    dc:description "CrMe Ritual granting a group fanatical loyalty to the caster for a year and 5 Warping Points; Anacrôn uses it to make cagoux." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheIsthmus a schema:Place ;
    rpg:name "The Isthmus" ;
    dc:description "Low swampy isthmus joining Bear Island to the mainland." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheJourneyNotYetComplete a rpg:Item ;
    rpg:name "The Journey not yet Complete" ;
    dc:description "Apologia tractatus by Trianoma favoring admitting the Order Miscellanea; the original is at Durenmar." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheKeepersOfThePearlOfGreatPrice a rpg:Faction ;
    rpg:name "The Keepers of the Pearl of Great Price" ;
    dc:description "A Jerbiton league whose members surreptitiously stave off poverty in large cities; leaderless since crusaders sacked their Constantinople headquarters." ;
    skos:altLabel "The Keepers" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:TheKeepersOfTheThousandTales a rpg:Faction ;
    rpg:name "The Keepers of the Thousand Tales" ;
    dc:description "A group of Merinita magi and companions formed in the Holy Land to collect, catalog, and spread the greatest stories, believing faerie immortality is ensured through legend; they have covenants in the Levant and Iberian Tribunals." ;
    skos:altLabel "the Keepers" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:TheKettle a schema:Place ;
    rpg:name "The Kettle" ;
    dc:description "Deep calm pool on the north side of Inner Farne, the island's only harbor, kept calm by Eider Ducks of Virtue." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheKeyOfTheodorus a rpg:Spell ;
    rpg:name "The Key of Theodorus" ;
    dc:description "A ReTe 5 Hermetic spell (R: Touch, D: Mom, T: Part) that magically opens any single lock regardless of complexity, named for Theodorus of Samos." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheKeysOfSolomon a rpg:Item ;
    rpg:name "The Keys of Solomon" ;
    dc:description "Book containing the Ars Notoria." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheKingSGoblet a rpg:Item ;
    rpg:name "The King's Goblet" ;
    dc:description "A wondrous gold cup that trembles in the holder's hand if a poisoned beverage is poured into it (Craft Level 13)." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheKingSName a rpg:Item ;
    rpg:name "The King's Name" ;
    dc:description "The selkie king's name, a form of audible vis (five pawns of Animal) trapped in a seashell; using it destroys the king." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheKissOfDeath a rpg:Spell ;
    rpg:name "The Kiss of Death" ;
    dc:description "A Perdo Corpus spell (Level 45) by which the person kissed dies suddenly, leaving only the black imprint of the caster's lips; requires no spoken words." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheKonigstuhl a schema:Place ;
    rpg:name "The Konigstuhl" ;
    dc:description "A 380-foot chalk cliff on Rugen; legend says whoever climbs it from the sea becomes king of Rugen, as Valdemar I did, and cheaters fail." ;
    skos:altLabel "Königstuhl", "The King's Seat" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheLORDShallPreserveTheeFromAllEvilHeShallPreserveThySoul a rpg:Spell ;
    rpg:name "The LORD shall preserve thee from all evil: he shall preserve thy soul" ;
    dc:description "Invocation Blessing effect granting Divine Magic Resistance equal to the effect's level." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheLaboratoryOfBonisagus a rpg:Spell ;
    rpg:name "The Laboratory of Bonisagus" ;
    dc:description "A Creo Terram 45 ritual that furnishes an empty chamber with a fully equipped standard Hermetic laboratory better than normal, granting Flawless Equipment, Flawless Tools, and Spotless." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheLaisOfMarieDeFrance a rpg:Item ;
    rpg:name "The Lais of Marie de France" ;
    dc:description "Tractatus, Charm, by Marie de France." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheLancetOfGoodHealth a rpg:Item ;
    rpg:name "The Lancet of Good Health" ;
    dc:description "CrCo 25 scalpel giving +6 to Disease Recovery rolls." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheLastingSynthemataOfX a rpg:Spell ;
    rpg:name "The Lasting Synthemata of (X)" ;
    dc:description "Diameter-duration MuVi Mystery synthemata spell adding (level-5) to Penetration for all spells against the named being while it lasts." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheLeafyCounselor a rpg:Creature ;
    rpg:name "The Leafy Counselor" ;
    dc:description "Eudokian example tree acting as Donor, at odds with its fellows." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:TheLensOfWisdom a rpg:Item ;
    rpg:name "The Lens of Wisdom" ;
    dc:description "A crystal lens bound in brass that, focusing the summer-solstice noon sun on a blank parchment, burns indecipherable glyphs into the page, each page containing Intellego vis." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheLightningBringer a rpg:Item ;
    rpg:name "The Lightning-Bringer" ;
    dc:description "A highly magical device of copper spheres, gold rods, and enchanted glass vessels invented by a Tremere Archimagus; on each new moon it summons a thunderstorm and accumulates its lightning as Auram vis." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheLimitOfExperience a rpg:Tag ;
    skos:prefLabel "The Limit of Experience" ;
    dc:description "A lesser limit of Hermetic magic: it cannot create or transfer skills, knowledge, or Abilities in a person." ;
    rpg:hasTag amol:HermeticConcept .
amol:TheLimitOfTheSoul a rpg:Tag ;
    skos:prefLabel "The Limit of the Soul" ;
    dc:description "A lesser limit of Hermetic magic: it cannot create an immortal soul, true human life, or restore the dead to life." ;
    rpg:hasTag amol:HermeticConcept .
amol:TheLindenOfNeustadt a rpg:Creature ;
    rpg:name "The Linden of Neustadt" ;
    dc:description "A protective Forest spirit (Magic Might 30) manifesting as a great lime tree that has adopted the town of Neustadt as its realm and grants victory and virtues to the town's defenders." ;
    skos:altLabel "Linden", "the great Lime" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:TheLineOfQuendalon a rpg:Faction ;
    rpg:name "The Line of Quendalon" ;
    dc:description "The lineage of magi descended from Quendalon who Initiate the three Arcadian Mysteries; many are Seekers devoted to experimental research, sometimes called 'The Last Commission' for Bonisagus's reputed charge." ;
    skos:altLabel "The Last Commission" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:TheLittleMermaid a rpg:Character ;
    rpg:name "The Little Mermaid" ;
    dc:description "Fairy-tale heroine who deliberately reverses traditional stories, losing her voice and then her life for love of a mortal." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:TheLlancarfanSaintsLives a rpg:Item ;
    rpg:name "The Llancarfan Saints' Lives" ;
    dc:description "Tractatus, Dominion Lore, Quality 6, hagiographies referencing Arthur." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheLongManOfWilmington a schema:Place ;
    rpg:name "The Long Man of Wilmington" ;
    dc:description "A figure about 240 feet tall picked out by trenches on a Sussex hillside, grasping two staves; said variously to represent St. Paul or the keeper of the gates of dawn who may open them for travelers." ;
    skos:altLabel "The Long Man" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheLongestRace a rpg:Spell ;
    rpg:name "The Longest Race" ;
    dc:description "Power of the Wamses (ReTe 30) letting an island heave itself a few paces." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheLordSTerrifyingHerald a rpg:Tag ;
    skos:prefLabel "The Lord's Terrifying Herald" ;
    dc:description "Abbas' power, as Jupiter's Resounding Blow." ;
    rpg:hasTag amol:HermeticConcept .
amol:TheLostCity a rpg:Spell ;
    rpg:name "The Lost City" ;
    dc:description "PeIm 45 Boundary ritual with Rego requisite that makes the island wall and everything within it invisible to outsiders." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheLuneburgHeath a schema:Place ;
    rpg:name "The Luneburg Heath" ;
    dc:description "A wild heathland south of Luneburg where shepherds tend flocks of Heidschnucken, goat-sheep crossbreeds descended from Corsican mouflon." ;
    skos:altLabel "Lüneburg Heath" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheMagestonesOfVerditius a rpg:Item ;
    rpg:name "The Magestones of Verditius" ;
    dc:description "Onyx-pebble enchanted devices crafted by Verditius, each bearing a powerful Creo Vim effect that manifests a Magic aura of 3; three were secretly gifted to Oculus Septentrionalis, the rest guarded by Durenmar, and their technique was never replicated." ;
    skos:altLabel "magestones" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheMagicFountain a schema:Place ;
    rpg:name "The Magic Fountain" ;
    dc:description "A spring near the Brocken that grants visions to those who drink from it." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheMagicRing a rpg:Item ;
    rpg:name "The Magic Ring" ;
    dc:description "Further idea for a prop story element." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheMamlukEmir a rpg:Tag ;
    skos:prefLabel "The Mamluk Emir" ;
    dc:description "Companion template for a proud, reckless, land-holding Mamluk noble cursed by jinn." ;
    rpg:hasTag amol:CharacterType .
amol:TheMamlukSoldier a rpg:Tag ;
    skos:prefLabel "The Mamluk Soldier" ;
    dc:description "Grog template for a low-ranking Turkish Mamluk soldier." ;
    rpg:hasTag amol:CharacterType .
amol:TheManInBlackWithASackOnHisBack a rpg:Creature ;
    rpg:name "The Man in Black with a Sack on His Back" ;
    dc:description "Scarecrow-bodied faerie that steals naughty children in a sack." ;
    skos:altLabel "Man in Black" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:TheMandrakeSScream a rpg:Tag ;
    skos:prefLabel "The Mandrake's Scream" ;
    dc:description "Story seed about a nobleman's son killed by a mandrake's scream at a hangman's tree." ;
    rpg:hasTag amol:HermeticConcept .
amol:TheManyHuedConflagration a rpg:Spell ;
    rpg:name "The Many-hued Conflagration" ;
    dc:description "A Muto Ignem spell (Level 5) that makes a fire burn brightly in shifting colors, potentially blinding onlookers for a round if they fail a Stamina roll." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheMargravateOfLusatia a schema:Place ;
    rpg:name "The Margravate of Lusatia" ;
    dc:description "A mainly forest-wilderness margravate east of the Elbe bordering Silesia, populated by Sorbs and ruled by the margraves of Meissen." ;
    skos:altLabel "Lusatia", "Luzica" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheMarketAtTheCrossroads a schema:Place ;
    rpg:name "The Market at the Crossroads" ;
    dc:description "Scenery story element: a faerie market of rough stalls where purchases are not always what they seem." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheMarvelousHound a rpg:Item ;
    rpg:name "The Marvelous Hound" ;
    dc:description "A Muto Animal (Corpus, Mentem) 34 enchanted collar that transforms a normal hound into an erect, handed servant with a grog's intellect while retaining hound loyalty." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheMasterOfNaumburg a rpg:Character ;
    rpg:name "The Master of Naumburg" ;
    dc:description "A young, enigmatic architect and sculptor of German origin who travels Germany working on great churches; some claim his unmatched work is aided by sorcery." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:TheMasterSThings a rpg:Tag ;
    skos:prefLabel "The Master's Things" ;
    dc:description "Lutin power granting awareness of every item in the room it occupies." ;
    rpg:hasTag amol:HermeticConcept .
amol:TheMazeOfSingingMirrors a schema:Place ;
    rpg:name "The Maze of Singing Mirrors" ;
    dc:description "A repository where copies of all recordings made by the Daughters of Echo are kept and sold to Jerbiton magi unable to attend performances." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheMindSImagination a schema:Place ;
    rpg:name "The Mind's Imagination" ;
    dc:description "Land within the mind reachable from dream that persists into waking; possessing spirits may reside there." ;
    skos:altLabel "Imagination" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheMindSMemory a schema:Place ;
    rpg:name "The Mind's Memory" ;
    dc:description "Region of a person's mind containing all memories, reachable by dream travelers, where memories can be moved or made solid." ;
    skos:altLabel "Memory" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheMiniatureOfImmortality a rpg:Spell ;
    rpg:name "The Miniature of Immortality" ;
    dc:description "A ritual Creo Herbam spell (Level 20) that creates a painted miniature of a person or scene on a wooden panel within voice range." ;
    skos:altLabel "CrHe(An)(Te) Level 20" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheMoleSWork a rpg:Item ;
    rpg:name "The Mole's Work" ;
    dc:description "Lab texts by Adanos Lutorum of Tytalus." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheMoon a rpg:Tag ;
    skos:prefLabel "The Moon" ;
    dc:description "Planet influencing emotions, tides, cyclic magic, fertility; governs Dexterity." ;
    rpg:hasTag amol:HermeticConcept .
amol:TheMorpheanGate a rpg:Spell ;
    rpg:name "The Morphean Gate" ;
    dc:description "Re(Mu)Co(Me) 40 Mystery spell transporting the caster bodily through a portal into a dream, creating a dream portal back to the real world." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheMotivatedPlow a rpg:Item ;
    rpg:name "The Motivated Plow" ;
    dc:description "A Rego Terram 15 enchanted plow-shaped device that transforms hard-packed earth into well-plowed soil in a circle; based on The Forgiving Earth and doing the work of about three laborers." ;
    skos:altLabel "Motivated Plough" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheMournfulMaga a rpg:Creature ;
    rpg:name "The Mournful Maga" ;
    dc:description "A faerie that apprentices face while growing up." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:TheMouseGroom a rpg:Creature ;
    rpg:name "The Mouse-Groom" ;
    dc:description "Actor: a talking mouse who courts a female character." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:TheMuslimTraveller a rpg:Tag ;
    skos:prefLabel "The Muslim Traveller" ;
    dc:description "Companion template for a Muslim scholar wandering Europe, inspired by a guardian angel." ;
    rpg:hasTag amol:CharacterType .
amol:TheMysteriesRevised a rpg:Item ;
    rpg:name "The Mysteries (Revised)" ;
    dc:description "Forthcoming book said to cover initiation into Holy Magic." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheMysticalCarpenter a rpg:Spell ;
    rpg:name "The Mystical Carpenter" ;
    dc:description "A ReHe 25 spell (Touch, Momentary, Group) that cuts, splits, carves, and joins a pile of wood into a desired form, substituting Perception + Finesse for Craft: Carpenter." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheNeriusianPortal a rpg:Spell ;
    rpg:name "The Neriusian Portal" ;
    dc:description "CrVi 65 holy ritual (R: Touch, D: Sun, T: Circle) creating a level 1 terrestrial regio around the caster; said to have been taught to Nerius by the angel Samuil." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheNewIconophiles a rpg:Faction ;
    rpg:name "The New Iconophiles" ;
    dc:description "A Jerbiton league, led ideologically by the Primus, attempting to recover the artistic treasures of Constantinople; based in Valnastium." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:TheNightBadgersBurrow a rpg:Spell ;
    rpg:name "The Night-Badgers' Burrow" ;
    dc:description "ReAn(Te) 20 spell moving targets from the Animal province to the Terram province." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheOathSwearing a rpg:Spell ;
    rpg:name "The Oath Swearing" ;
    dc:description "Truffle Matron's power binding oath-takers so that breaking the oath inflicts a Minor Flaw." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheOathOfTruth a rpg:Spell ;
    rpg:name "The Oath of Truth" ;
    dc:description "Lesser PeCo ritual binding a willing subject to tell the truth at trial, seen as infallible." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheObedientFire a rpg:Spell ;
    rpg:name "The Obedient Fire" ;
    dc:description "A ReIg 20 spell that controls the rate and direction a fire spreads, able to make it move as fast as a man walks; the fire's heat is non-magical and bypasses Magic Resistance." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheObedientSlave a rpg:Spell ;
    rpg:name "The Obedient Slave" ;
    dc:description "Malachi's Power forcing any person to perform commanded tasks." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheOdenwald a schema:Place ;
    rpg:name "The Odenwald" ;
    dc:description "A German forest that comes into bloom earliest and most spectacularly, an ideal site for the Court of the Alder Prince, with bandits lurking on its western edge." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheOldGuard a rpg:Spell ;
    rpg:name "The Old Guard" ;
    dc:description "Evocation/Conjure 20 rite creating a glamour of ten grogs to protect the caster." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheOldOak a schema:Place ;
    rpg:name "The Old Oak" ;
