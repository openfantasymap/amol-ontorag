    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Taboo a rpg:Tag ;
    skos:prefLabel "Taboo" ;
    dc:description "Rules within a faerie's glamour forbidding or requiring actions; humans breaking them owe redress. Detailed as Flaws." ;
