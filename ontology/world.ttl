    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheEarForTheDistantVoice a rpg:Spell ;
    rpg:name "The Ear for the Distant Voice" ;
    dc:description "Spell (InIm 20) known by a template magus or referenced in the text." ;
