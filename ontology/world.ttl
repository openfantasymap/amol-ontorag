    rpg:hasTag amol:HermeticConcept .
amol:DeepSleeper a rpg:Tag ;
    skos:prefLabel "Deep Sleeper" ;
    dc:description "Flaw appearing in character statistics or rules in this text." ;
    rpg:hasTag amol:Flaw .
amol:Demetrius a rpg:Character ;
    rpg:name "Demetrius" ;
    dc:description "An alchemist Criamon magus, teacher of the current Prima Muscaria, whose carnal urges are embodied in the captured adulteration called the Carnal Wolf." ;
    skos:altLabel "the magician Demetrius" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:DemonicSteed a rpg:Creature ;
    rpg:name "Demonic Steed" ;
    dc:description "A corrupt beast (Might 7, Animal) appearing as a fearsome black stallion with iron hooves, unimpeded by poor terrain; one of three created by an Infernalist magus using a tainted Steed of Vengeance spell." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:DemonsOfFutility a rpg:Creature ;
    rpg:name "Demons of Futility" ;
    dc:description "Evil spirit demons (Infernal Might 5 Aquam) imprisoned on Megstone who drown sailors and encourage despair; appear as short black hooded creatures riding goats." ;
    skos:altLabel "Demons of Megstone" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Deodand a rpg:Tag ;
    skos:prefLabel "Deodand" ;
    dc:description "A stolen donkey that caused a death and holds a fragment of the dead man's angry ghost, able to turn into a spectral centaur-like creature with donkey hindquarters." ;
    skos:altLabel "Deodand Donkey" ;
    rpg:hasTag amol:HermeticConcept .
amol:Devotion a rpg:Tag ;
    skos:prefLabel "Devotion" ;
    dc:description "Theological virtue (normally called Faith); at True Faith 2 grants Premonitions and the ability to dispel illusions and glamour with a Faith Point." ;
    rpg:hasTag amol:HermeticConcept .
amol:Dhimmi a rpg:Tag ;
    skos:prefLabel "Dhimmi" ;
    dc:description "A Minor General Flaw marking a non-Muslim living under Muslim rule, who must pay the jizya head tax and abide by social restrictions in return for tolerance and protection." ;
    rpg:hasTag amol:Flaw .
amol:DifficultSpontaneousMagic a rpg:Tag ;
    skos:prefLabel "Difficult Spontaneous Magic" ;
    dc:description "A Hermetic Flaw referenced as combinable with Weak Spontaneous Magic to create a magus who cannot cast spontaneous magic at all." ;
    rpg:hasTag amol:Flaw .
amol:DindymN a rpg:Character ;
    rpg:name "Dindyméné" ;
    dc:description "A titaness and kosmokrator Daimon of the Magic Realm, mother of Zeus, imprisoned asleep beneath Mount Dindymon; embodies fertility, mountains and wild beasts, with Magic Might 75." ;
    skos:altLabel "Kubaba", "Kybélé", "Mother-Goddess", "Rhea" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Diocese a rpg:Tag ;
    skos:prefLabel "Diocese" ;
