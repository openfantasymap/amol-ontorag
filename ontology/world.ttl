    rpg:hasTag amol:NamedSpell .
amol:Edinburgh a schema:Place ;
    rpg:name "Edinburgh" ;
    dc:description "Capital of Scotland, a royal burgh with about 1,500 inhabitants." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:EdwardOfMilton a rpg:Character ;
    rpg:name "Edward of Milton" ;
    dc:description "A Jerbiton archmagus and nominated head of the covenant Schola Pythagoranis in Cambridge, friend and former teacher of the scholar Robert Grosseteste." ;
    skos:altLabel "Archmagus Edward of Milton", "Edward of Milton, follower of Jerbiton" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Ehwaz a rpg:Proficiency ;
    rpg:name "Ehwaz" ;
    dc:description "Elder Futhark rune \"Horse\" used as a vitkir Art. Rune of the horse, mobility in combat and the bond of horse and rider; associated with Animal." ;
    skos:altLabel "Eh" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticArt .
amol:Eidolon a rpg:Spell ;
    rpg:name "Eidolon" ;
    dc:description "Common spirit power used to create illusions and communicate, e.g. an oasis illusion or phantom noises." ;
    skos:altLabel "Eidolon (power)" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Ekstasis a rpg:Tag ;
    skos:prefLabel "Ekstasis" ;
    dc:description "The magical power defining nightwalker traditions, also called straying, which lets a magician send forth his spirit while unconscious; it has no corresponding Ability." ;
    skos:altLabel "Straying", "stray", "straying" ;
    rpg:hasTag amol:HermeticConcept .
amol:Elf a rpg:Creature ;
    rpg:name "Elf" ;
    dc:description "Possible baby thief who forgot to leave a changeling." ;
    skos:altLabel "Elves", "elves" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:ElizabethOfSchNau a rpg:Character ;
    rpg:name "Elizabeth of Schönau" ;
    dc:description "Benedictine nun and mystic (born 1129) at Schönau who recorded her visions in the Books of Visions and corresponded with Hildegard." ;
    skos:altLabel "Elizabeth" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Empathy a rpg:Proficiency ;
    rpg:name "Empathy" ;
    dc:description "Faerie Method (Stamina) drawing Faerie power within the caster through a trance ritual costing Fatigue, doubling Sympathy for effect limits." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:EnchantingAbility a rpg:Tag ;
    skos:prefLabel "Enchanting (Ability)" ;
    dc:description "A Minor Supernatural Ability Virtue applying to a particular artistic expression (dance, drawing, storytelling, craftwork) that in Faerie auras can control events through art." ;
    skos:altLabel "Enchanting (Storytelling)" ;
    rpg:hasTag amol:Virtue .
amol:Enchantment a rpg:Tag ;
    skos:prefLabel "Enchantment" ;
    dc:description "A Free laboratory Supernatural Virtue: the lab itself has been enchanted as a magic item, granting Virtues, Flaws, or Specialization changes." ;
    rpg:hasTag amol:Virtue .
amol:Encumbrance a rpg:Tag ;
    skos:prefLabel "Encumbrance" ;
    dc:description "A penalty derived from the Load of carried equipment, calculated through Burden and offset by Strength, that subtracts from athletic and spellcasting rolls." ;
    skos:altLabel "Burden", "Load" ;
    rpg:hasTag amol:HermeticConcept .
amol:EnduringMagic a rpg:Tag ;
    skos:prefLabel "Enduring Magic" ;
    dc:description "A Minor, Hermetic Virtue causing the magus's spells to last longer than usual, with the storyguide secretly multiplying durations by a die roll." ;
    rpg:hasTag amol:Virtue .
amol:EnslaveTheMortalMind a rpg:Spell ;
    rpg:name "Enslave the Mortal Mind" ;
    dc:description "A spell that lets the caster completely control the loyalty, emotions, desires, and activities of any person." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:EnthrallingSound a rpg:Spell ;
    rpg:name "Enthralling Sound" ;
    dc:description "Faerie power producing fear or infatuation through sound, used by Lamashtu, gorgons and the Lesser Nymph." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:EnviedBeauty a rpg:Tag ;
    skos:prefLabel "Envied Beauty" ;
    dc:description "A Major Story Flaw whose character's beauty draws revulsion and jealousy, especially from vain persons of the character's gender." ;
    rpg:hasTag amol:Flaw .
amol:EnvironmentalSensitivity a rpg:Tag ;
    skos:prefLabel "Environmental Sensitivity" ;
    dc:description "A Minor General Flaw in which the character is unusually sensitive to an uncommon environmental feature, suffering a Stamina penalty when exposed." ;
    rpg:hasTag amol:Flaw .
amol:EssentialFlaw a rpg:Tag ;
    skos:prefLabel "Essential Flaw" ;
    dc:description "Major or Minor General Flaw giving a detrimental Essential Trait tied to a Characteristic." ;
    rpg:hasTag amol:Flaw .
amol:EssentialNature a rpg:Tag ;
    skos:prefLabel "Essential Nature" ;
    dc:description "A character's intrinsic, magically defining nature, which can make certain Flaws impossible to remove even with Hermetic magic." ;
    rpg:hasTag amol:HermeticConcept .
amol:Ethiopia a schema:Place ;
    rpg:name "Ethiopia" ;
    dc:description "The location of a cave complex that is the perfect site for the Microcosm ritual on the Path of the Body, discovered in North Africa." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Eudokia a schema:Place ;
    rpg:name "Eudokia" ;
    dc:description "The world of the Faerie Realm where one's personal story, moral dilemma, or life transition is told; reached by the Path of Choice." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Eule a rpg:Character ;
    rpg:name "Eule" ;
    dc:description "An aged master of House Bjornaer at Fengheld with the heartbeast of an owl and the honorary rank of Quaesitor; she may have entered Final Twilight and her wisdom is faked by Gunther." ;
    skos:altLabel "Eule of Fengheld", "Eule, Follower of Bjornaer" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Eunuch a rpg:Tag ;
    skos:prefLabel "Eunuch" ;
    dc:description "Minor General Flaw for a castrated male character, often made so for work in a harem or military school; grants freedom of movement among the sexes." ;
    rpg:hasTag amol:Virtue .
amol:EvilEye a rpg:Tag ;
    skos:prefLabel "Evil Eye" ;
    dc:description "Minor Supernatural Flaw: the uncontrolled potential to harm others; those making stress rolls in the character's presence roll an extra botch die, warded off by amulets, rituals, or magic resistance." ;
    rpg:hasTag amol:Flaw .
amol:ExiledAtlantean a rpg:Tag ;
    skos:prefLabel "Exiled Atlantean" ;
    dc:description "A Minor Supernatural Flaw marking the character as an Atlantean tainted by contact with the surface world and unable to return to her native magic regio." ;
    rpg:hasTag amol:Flaw .
amol:Exorcism a rpg:Tag ;
    skos:prefLabel "Exorcism" ;
    dc:description "Christian rite costing a Confidence or Faith point that helps a possessed person break free of infernal influence." ;
    rpg:hasTag amol:HermeticConcept .
amol:ExoticCasting a rpg:Tag ;
    skos:prefLabel "Exotic Casting" ;
    dc:description "A Minor Hermetic Virtue allowing a magus to cast Hermetic spells using non-Hermetic methods, making it hard for others to recognize the spell being cast." ;
    rpg:hasTag amol:Virtue .
amol:ExperimentalPhilosophy a rpg:Tag ;
    skos:prefLabel "Experimental Philosophy" ;
    dc:description "A system of 'natural' magic that produces wondrous effects through the intrinsic power of the subject rather than any arcane force, using contagion, affinity, similarity, hidden virtues, astrology, ligatures and formulae." ;
    skos:altLabel "Natural Magic", "empirica", "empiricae", "natural magic" ;
    rpg:hasTag amol:HermeticConcept .
amol:ExtendedGlamour a rpg:Tag ;
    skos:prefLabel "Extended Glamour" ;
    dc:description "Personal power granting awareness of everything within a domain; the faerie is coterminous with its landscape feature and extends an aura." ;
    skos:altLabel "Extend Glamour" ;
    rpg:hasTag amol:HermeticConcept .
amol:EyesOfTheEagle a rpg:Spell ;
    rpg:name "Eyes of the Eagle" ;
    dc:description "An Intellego Imaginem spell (Level 25) that lets the caster see distant things clearly, making out details as if they were a foot away while still judging distance accurately." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:FablePoints a rpg:Tag ;
    skos:prefLabel "Fable Points" ;
    dc:description "Measures accumulated vitality spent in Faerie; determines time dilation and warping on leaving and lets characters swap Virtues and Flaws for faerie ones." ;
    skos:altLabel "Fable Score", "fable point", "fable score" ;
    rpg:hasTag amol:HermeticConcept .
amol:Fachan a rpg:Creature ;
    rpg:name "Fachan" ;
    dc:description "One-eyed, one-armed, one-legged faerie of distant lochs and valleys in Ireland and Scotland that hates humans and fights with club or poisoned flail." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:FaerieBeast a rpg:Tag ;
    skos:prefLabel "Faerie Beast" ;
    dc:description "Minor Supernatural Virtue: the character appears to be an animal with all advantages of a faerie body." ;
    rpg:hasTag amol:Virtue .
amol:FaerieHeritage a rpg:Tag ;
    skos:prefLabel "Faerie Heritage" ;
    dc:description "Story Flaw a player taking Brown Wullie as character would have." ;
    rpg:hasTag amol:Flaw .
amol:FaerieWolf a rpg:Creature ;
    rpg:name "Faerie Wolf" ;
    dc:description "Creature of local superstition said to lick a newborn left in a clearing and bequeath supernatural powers." ;
    skos:altLabel "Faerie Wolves", "Faerie wolves" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:FaerieRaisedMagic a rpg:Tag ;
    skos:prefLabel "Faerie-Raised Magic" ;
    dc:description "A Major Hermetic Virtue conditioning a character to invent spells very quickly, allowing self-teaching of spells outside the lab; common in the Line of Quendalon." ;
    skos:altLabel "Faerie - Raised Magic" ;
    rpg:hasTag amol:Virtue .
amol:FailedMonk a rpg:Tag ;
    skos:prefLabel "Failed Monk" ;
    dc:description "A Minor Social Status Flaw in which the character was cast out of a cloistered order, gaining a poor reputation but freedom from monastic vows." ;
    skos:altLabel "Failed Nun" ;
    rpg:hasTag amol:Flaw .
amol:FalseGift a rpg:Tag ;
    skos:prefLabel "False Gift" ;
    dc:description "Corrupted version of The Gift, described in Chapter 12: Black Magic, for apprentices or magi marked by Hell." ;
    rpg:hasTag amol:HermeticConcept .
amol:Fehu a rpg:Proficiency ;
    rpg:name "Fehu" ;
    dc:description "Elder Futhark rune \"Wealth\" used as a vitkir Art. Rune of common wealth such as cattle, silver and grain; as a target it is associated with Animal or Terram (domesticated animals)." ;
    skos:altLabel "Fe", "Febu", "Feoh" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticArt .
amol:FeralScent a rpg:Tag ;
    skos:prefLabel "Feral Scent" ;
    dc:description "A Minor General Flaw giving a character the strong natural smell of a wild animal, imposing a social penalty and an Unclean Reputation but doubling Scent Target spell areas if Sensory Magic is Initiated." ;
    rpg:hasTag amol:Flaw .
amol:Feritel a rpg:Faction ;
    rpg:name "Feritel" ;
    dc:description "Unrecognized independent covenant founded 1117, officially a subject commune of Genoa, whose magi live as nobility and aid the Genoese." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:FerramentumOfVerditius a rpg:Character ;
    rpg:name "Ferramentum of Verditius" ;
    dc:description "A magus of House Verditius whose wizard's sigil makes his spells very orderly, seen in his versions of The Cloudless Sky Returned and Curse of the Rotted Wood." ;
    skos:altLabel "Ferramentum" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:FertilityBattles a rpg:Tag ;
    skos:prefLabel "Fertility Battles" ;
    dc:description "Battles in spirit form that nightwalkers fight, usually four times a year, determining the harvest, hunting and fishing of their area." ;
    skos:altLabel "Fertility Battle", "night battles" ;
    rpg:hasTag amol:HermeticConcept .
amol:Fetch a rpg:Tag ;
    skos:prefLabel "Fetch" ;
    dc:description "The gruagach's spirit companion, sent out by Vision spells to scout; visible to those with Second Sight. Trollsynir call it a fylgja." ;
    skos:altLabel "Doppelganger", "fetches" ;
    rpg:hasTag amol:Virtue .
amol:FetteredMagic a rpg:Tag ;
    skos:prefLabel "Fettered Magic" ;
    dc:description "A Minor Hermetic Flaw making all of the character's spells and activated magic item effects Arcane Connections to him." ;
    rpg:hasTag amol:Flaw .
amol:FirstCrusade a rpg:Tag ;
    skos:prefLabel "First Crusade" ;
    dc:description "Crusade from 1095 that found the Holy Lance, took Jerusalem and founded the Latin Kingdom of Jerusalem." ;
    rpg:hasTag amol:HermeticConcept .
amol:FlashOfTheScarletFlames a rpg:Spell ;
    rpg:name "Flash of the Scarlet Flames" ;
    dc:description "A Creo Ignem spell that explodes a brilliant red flash in the air, able to temporarily or permanently blind a target who fails a Stamina roll; Rose of Jerbiton's version smells of roses." ;
    skos:altLabel "CrIg 15" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:FlawedPowers a rpg:Tag ;
    skos:prefLabel "Flawed Powers" ;
    dc:description "A Minor Hermetic Flaw applying the effects of a Major Hermetic Flaw (such as Restriction or Necessary Condition) to a character's Supernatural Virtues rather than to Hermetic magic." ;
    rpg:hasTag amol:Flaw .
amol:Florae a rpg:Creature ;
    rpg:name "Florae" ;
    dc:description "Airy Spirits attending plants, appearing female with vegetative features; also called nymphae." ;
    skos:altLabel "Flora", "flora", "nymphae" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:ForfeitImmunity a rpg:Tag ;
    skos:prefLabel "Forfeit Immunity" ;
    dc:description "Loss of legal protection under Hermetic Law, e.g. during Wizard War, when committing a crime, or when intruding in a sanctum." ;
    skos:altLabel "Sanctum Invasion" ;
    rpg:hasTag amol:HermeticConcept .
amol:ForgeCompanion a rpg:Tag ;
    skos:prefLabel "Forge-Companion" ;
    dc:description "A Minor, Social Status Virtue for an unGifted craftsman attached to a Verditius magus and working in his lab, with extra experience for Crafts." ;
    skos:altLabel "forge-companions" ;
    rpg:hasTag amol:Virtue .
amol:Forgery a rpg:Proficiency ;
    rpg:name "Forgery" ;
    dc:description "Ability listed in the Alpine redcap template or Hera's statistics." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:FormOfMan a rpg:Tag ;
    skos:prefLabel "Form of Man" ;
    dc:description "Vessels of Iniquity Power to shapeshift into any human after Form of Wickedness." ;
    rpg:hasTag amol:HermeticConcept .
amol:FormOfWickedness a rpg:Tag ;
    skos:prefLabel "Form of Wickedness" ;
    dc:description "Vessels of Iniquity variant of Coagulation, a shapeless form of visible sin overwhelming viewers." ;
    rpg:hasTag amol:HermeticConcept .
amol:Fortunam a rpg:Proficiency ;
    rpg:name "Fortunam" ;
    dc:description "Learned-magician Form; Fortunam charms influence luck and actions of others." ;
    skos:altLabel "Fa" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticArt .
amol:Fosterage a rpg:Tag ;
    skos:prefLabel "Fosterage" ;
    dc:description "Covenant Hook: magi educate a young noble, potentially spreading acceptance of Hermetic magic; also a way to seal supernatural alliances." ;
    skos:altLabel "Fostering" ;
    rpg:hasTag amol:HermeticConcept .
amol:Franks a rpg:Faction ;
    rpg:name "Franks" ;
    dc:description "Historical Germanic people whose history, by Gregory of Tours, is a cited period source." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:FreeingTheStridingTree a rpg:Spell ;
    rpg:name "Freeing the Striding Tree" ;
    dc:description "A Rego Herbam spell (Level 30) like Lord of the Trees but enabling the tree to walk half as fast as a human; a botched Concentration roll causes the tree to attack the caster." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:FrightfulPresence a rpg:Tag ;
    skos:prefLabel "Frightful Presence" ;
    dc:description "A Minor, Supernatural Virtue letting a character instill dread or awe, forcing witnesses to make Brave Personality rolls." ;
    rpg:hasTag amol:Virtue .
amol:Gabai a rpg:Tag ;
    skos:prefLabel "Gabai" ;
    dc:description "A Minor Social Status Flaw marking the character as the local Jewish tax collector appointed by the community council, with a negative Tax Collector Reputation." ;
    rpg:hasTag amol:Flaw .
amol:Galen a rpg:Character ;
    rpg:name "Galen" ;
    dc:description "The ancient authority on medicine since whom chirurgy has held a less prestigious position; quoted on the distinction between knowledge by experience and by reason." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Garus a rpg:Character ;
    rpg:name "Garus" ;
    dc:description "The current Primus of House Flambeau in 1220, an aging former soldier-of-fortune and tournament champion who leads the milites and authored the Code of Garus." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:GateOfCountlessVistas a rpg:Item ;
    rpg:name "Gate of Countless Vistas" ;
    dc:description "A stone arched doorway enchanted for instant transport to connected locations, keyed to individual users." ;
    skos:altLabel "Gate", "Gates of Countless Vistas" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:GatheringOfTwelveYears a rpg:Tag ;
    skos:prefLabel "Gathering of Twelve Years" ;
    dc:description "A periodic gathering of House Bjornaer (the Swan Clan performs a special ritual role at it); held in 1227 and figures in the Crintera Schism as each rival faction holds its own." ;
    skos:altLabel "Devil's Year", "Teufelsjahr", "the Gathering", "the gathering" ;
    rpg:hasTag amol:HermeticConcept .
amol:GatheringOfTheStormyMight a rpg:Spell ;
    rpg:name "Gathering of the Stormy Might" ;
    dc:description "A Rego Auram spell (Level 40) like Clouds of Thunderous Might but producing a larger storm that can cover the entire visible sky." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Gebo a rpg:Proficiency ;
    rpg:name "Gebo" ;
    dc:description "Elder Futhark rune \"Gift\" used as a vitkir Art. Rune of gifts, generosity and obligation; targets objects given as gifts and people in the vitki's debt." ;
    skos:altLabel "Gyfu" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticArt .
amol:Geirlaug a rpg:Character ;
    rpg:name "Geirlaug" ;
    dc:description "A notable contemporary House Flambeau Archmaga of Montverte covenant in the Normandy Tribunal, renowned for her great age, power, and mastery of Ignem." ;
    skos:altLabel "Archmaga Geirlaug of Montverte", "Geirlaug of Montverte" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Ghibellines a rpg:Faction ;
    rpg:name "Ghibellines" ;
    dc:description "One of the two factions feuding over Florence since 1216, splitting the city along with the Guelphs." ;
    skos:altLabel "Ghibelline" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Ghula a rpg:Creature ;
    rpg:name "Ghula" ;
    dc:description "Rapacious wasteland faeries of the Arabic world whose unions with human men produce ghula daughters or ghul-blooded sons." ;
    skos:altLabel "Ghul", "ghul", "ghuls" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:GiftOfSpeech a rpg:Tag ;
    skos:prefLabel "Gift of Speech" ;
    dc:description "A Virtue or Magic Quality named among the traits of magical animals or dragons in this text." ;
    rpg:hasTag amol:Virtue .
amol:Glanconer a rpg:Creature ;
    rpg:name "Glanconer" ;
    dc:description "Handsome male faerie who courts girls until they pine to death." ;
    skos:altLabel "Glanconers", "love talker" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:GlastonburyTor a schema:Place ;
    rpg:name "Glastonbury Tor" ;
    dc:description "A commanding hill near Glastonbury where St. Collen confronted Gwynn ab Nudd's faerie castle." ;
    skos:altLabel "the Tor" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:GloomOfEvening a rpg:Spell ;
    rpg:name "Gloom of Evening" ;
    dc:description "A Perdo Ignem spell (Level 10) that substantially drops the level of light in a target room, making it gloomy with deep shadows." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Goblin a rpg:Creature ;
    rpg:name "Goblin" ;
    dc:description "General term for a subterranean faerie of destructive bent found in caves or mines, or a malicious faerie of short stature; prone to taking children for changelings." ;
    skos:altLabel "Goblin King", "Goblins", "goblins" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Golem a rpg:Creature ;
    rpg:name "Golem" ;
    dc:description "Clay figure brought to life by Divine energies through Kabbalah, usually in human form as protector of a community; has Divine Might and may be empowered, go mad, or be destroyed." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:GrandSilesia a rpg:Faction ;
    rpg:name "Grand Silesia" ;
    dc:description "A covenant founded between the Oder and Warta rivers in Poland by magi from Rethra and Crintera (993-1009); it split to form the New Slavonic Tribunal and was destroyed in the Schism War." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:Grant a rpg:Creature ;
    rpg:name "Grant" ;
    dc:description "Faerie Power to bless or curse a target with Warping Points, temporary Virtues/Flaws, or Sympathy Traits." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:GrantMajorVirtue a rpg:Spell ;
    rpg:name "Grant (Major Virtue)" ;
    dc:description "Ritual faerie power (Vim) imposing a named Major Virtue on a target, temporarily or permanently." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:GrantPuissanceInAbility a rpg:Spell ;
    rpg:name "Grant Puissance in (Ability)" ;
    dc:description "Spirit power granting Virtues to chosen humans, e.g. Grant Dowsing, Grant Puissance in (Ability)." ;
    skos:altLabel "Grant (Virtue)" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Gratitude a rpg:Tag ;
    skos:prefLabel "Gratitude" ;
    dc:description "A structured advancement system in which characters earn Gratitude points for exceptional service to their lord, redeemed for office, land, or goods." ;
    skos:altLabel "Gratitude points" ;
    rpg:hasTag amol:HermeticConcept .
amol:GraziaFiliaNatura a rpg:Character ;
    rpg:name "Grazia filia Natura" ;
    dc:description "Animál specialist who supervises Valnastium's stables, kennels and mews and is beginning to investigate taming griffins." ;
    skos:altLabel "Grazia" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:GreatElixir a rpg:Tag ;
    skos:prefLabel "Great Elixir" ;
    dc:description "Major Mystery Virtue letting an alchemist create and consume a potion that transforms him into an immortal being of the Magic realm; requires Unaging and Lesser Elixir." ;
    skos:altLabel "Elixir Vitae", "Elixir of Life", "Greater Elixir" ;
    rpg:hasTag amol:Virtue .
amol:GreaterBenediction a rpg:Tag ;
    skos:prefLabel "Greater Benediction" ;
    dc:description "A Major, Supernatural Virtue granting a major blessing from a supernatural power, with examples such as Flight, True Sight, and Universally Liked." ;
    rpg:hasTag amol:Virtue .
amol:Grimgroth a rpg:Character ;
    rpg:name "Grimgroth" ;
    dc:description "Named in the book's trademark notice as a property of the Order of Hermes setting." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:GuardiansOfTheForests a rpg:Tag ;
    skos:prefLabel "Guardians of the Forests" ;
    dc:description "A Rhine Tribunal ruling permitting protection of wildernesses, which the Hawthorn Gild and Crintera unsuccessfully sought to invoke against the Danish invasion of Rugen." ;
    skos:altLabel "Guardians of the Forests ruling" ;
    rpg:hasTag amol:HermeticConcept .
amol:Guelphs a rpg:Faction ;
    rpg:name "Guelphs" ;
    dc:description "One of the two factions feuding over Florence since 1216, splitting the city along with the Ghibellines." ;
    skos:altLabel "Guelph" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Hagalaz a rpg:Proficiency ;
    rpg:name "Hagalaz" ;
    dc:description "Elder Futhark rune \"Hail\" used as a vitkir Art. Rune of hail and the cruel side of nature, storms and missiles; associated with Auram, Aquam and missile weapons." ;
    skos:altLabel "Haegl", "Hagall" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticArt .
amol:Hagen a rpg:Character ;
    rpg:name "Hagen" ;
    dc:description "Gunther's powerful and treacherous vassal in the Nibelungenlied who murders Siegfried, steals and sinks the Nibelung treasure, and is finally decapitated by Kriemhild." ;
    skos:altLabel "Hagen filius Flauberto the Difficult" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Halcyon a rpg:Creature ;
    rpg:name "Halcyon" ;
    dc:description "A mythical magic sea bird serving Dindyméné that calms winds around the winter solstice and eats the Magic regio's Herbam vis; Magic Might 15 (Auram)." ;
    skos:altLabel "Kingfisher of Virtue", "halycon" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Hamr a rpg:Tag ;
    skos:prefLabel "Hamr" ;
    dc:description "Norse term for a corporeal phantasticum, an animal-shaped battle spirit of a trance warrior." ;
    skos:altLabel "Hamr Virtue", "Hvar" ;
    rpg:hasTag amol:Virtue .
amol:Hannibal a rpg:Character ;
    rpg:name "Hannibal" ;
    dc:description "Commander whose three victories over the Romans in Italy Cercistum claimed he could raise as ghosts." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Harold a rpg:Character ;
    rpg:name "Harold" ;
    dc:description "An example character who knows Performance Magic (Hunt) and casts Hunter's Tracks of the Faerie Glow while hunting." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Harut a rpg:Creature ;
    rpg:name "Harut" ;
    dc:description "One of two fallen angels who, per the Qur'an, taught sihr (magic) to mankind to tempt them from Islam." ;
    skos:altLabel "Harut and Marut", "Marut" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Hatred a rpg:Tag ;
    skos:prefLabel "Hatred" ;
    dc:description "A Major or Minor Personality Flaw in which the character hates someone or some group so much that hurting them dominates his life." ;
    rpg:hasTag amol:Flaw .
amol:Haunted a rpg:Tag ;
    skos:prefLabel "Haunted" ;
    dc:description "A Minor laboratory Supernatural Flaw: the lab is home to a haunting spirit that occasionally disturbs the owner (+1 Warping, -1 Aesthetics, +2 Mentem)." ;
    rpg:hasTag amol:Flaw .
amol:Hebrew a rpg:Proficiency ;
    rpg:name "Hebrew" ;
    dc:description "Hebrew: Ability used by holy or divine characters in this text, e.g. in Abbas the Hunted's or the Chalkydri's statistics or divine rules." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:HenryTheLion a rpg:Character ;
    rpg:name "Henry the Lion" ;
    dc:description "The greatest Welf ruler in living memory, duke of both Saxony and Bavaria, stripped of most estates by Frederick Barbarossa; he beautified Brunswick." ;
    skos:altLabel "Heinrich der Löwe" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:HenryTheYoungKing a rpg:Character ;
    rpg:name "Henry the Young King" ;
    dc:description "Son of Henry II, who took five hundred knights to Lagny-sur-Marne in 1179 and was tutored by William Marshal." ;
    skos:altLabel "the Young King" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Hephaestus a rpg:Character ;
    rpg:name "Hephaestus" ;
    dc:description "The lame Greek god of smiths and divine artificer, founder of the Cult of Hephaestus, who built sacred forges and crafted famous magical items for the gods." ;
    skos:altLabel "the divine artificer" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:HerbsOfVirtue a rpg:Tag ;
    skos:prefLabel "Herbs of Virtue" ;
    dc:description "Plants that naturally contain vis and can be Enriched into charms that grant Virtues or powers." ;
    skos:altLabel "Herb of Virtue" ;
    rpg:hasTag amol:HermeticConcept .
amol:Herbwife a rpg:Tag ;
    skos:prefLabel "Herbwife" ;
    dc:description "The poor man's answer to the apothecary; usually a woman who maintains a village's health with preserved garden products and often acts as local midwife." ;
    skos:altLabel "Herbalist", "herbalist", "herbman" ;
    rpg:hasTag amol:CharacterType .
amol:Hercules a rpg:Character ;
    rpg:name "Hercules" ;
    dc:description "A god and hero of legendary strength, identified by the Romans with the Gaulish Ogmios and worshiped as protector of the magical springs at the Sanctuary of Hercules." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:HermesTrismegistus a rpg:Character ;
    rpg:name "Hermes Trismegistus" ;
    dc:description "The legendary sage to whom magi attribute the maxim 'As above, so below,' cited regarding astrology and the Stone of Death." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:HermeticAlchemy a rpg:Tag ;
    skos:prefLabel "Hermetic Alchemy" ;
    dc:description "Hermetic Minor Virtue letting a magus extract more vis from an aura or extract Form-specific vis, using Shape and Material Bonuses." ;
    rpg:hasTag amol:Virtue .
amol:HermeticIntegration a rpg:Tag ;
    skos:prefLabel "Hermetic Integration" ;
    dc:description "Research projects to integrate folk witch practices into Hermetic magic via breakthroughs." ;
    rpg:hasTag amol:HermeticConcept .
amol:HermeticPatron a rpg:Tag ;
    skos:prefLabel "Hermetic Patron" ;
    dc:description "A Minor Story Flaw, available to Redcaps or magi, in which an older magus or established Redcap watches over and aids the character in exchange for service." ;
    rpg:hasTag amol:Flaw .
amol:HeronOfAlexandria a rpg:Character ;
    rpg:name "Heron of Alexandria" ;
    dc:description "Ancient inventor whose works inspired the wonderful steam-rotator machines powering an Unnatural Law covenant." ;
    skos:altLabel "Heron", "Heron of Alexander" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:HiddenShape a rpg:Tag ;
    skos:prefLabel "Hidden Shape" ;
    dc:description "An aspect of the heartbeast whereby, due to the Limit of Essential Nature, a transformed Bjornaer appears as a mundane animal to magic." ;
    rpg:hasTag amol:HermeticConcept .
amol:HighCrimes a rpg:Tag ;
    skos:prefLabel "High Crimes" ;
    dc:description "Serious Hermetic charges that the pirates of Waddenzee would face if the mundane authorities moved against them with no Tribunal support." ;
    rpg:hasTag amol:HermeticConcept .
amol:HighestAspiration a rpg:Faction ;
    rpg:name "Highest Aspiration" ;
    dc:description "A covenant that previously held the Motherhouse site and was destroyed in the Sundering of Tremere, leaving its resources unclaimed." ;
    skos:altLabel "Covenant of the Highest Aspiration" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:Hildesheim a schema:Place ;
    rpg:name "Hildesheim" ;
    dc:description "A splendid cathedral city of northern Germany famed for its civic buildings and churches, raised to greatness by St. Bernward, whose crypt lies in St. Michael's church." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:HiptaTheNurse a rpg:Creature ;
    rpg:name "Hipta the Nurse" ;
    dc:description "A powerful shapechanger Daimon (Magic Might 15, Animal), the nurse of Dionysus, who favors the form of a dove and is invoked for forgiveness from curses and magical harm." ;
    skos:altLabel "Hipta" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:HisMasterSVoice a rpg:Tag ;
    skos:prefLabel "His Master's Voice" ;
    dc:description "Rumael's power to summon lesser demons without controlling them." ;
    rpg:hasTag amol:HermeticConcept .
amol:HolyConnection a rpg:Tag ;
    skos:prefLabel "Holy Connection" ;
    dc:description "The holy equivalent of an Arcane Connection, formed through religious ceremonies, prayer, holy authority or consecration." ;
    rpg:hasTag amol:HermeticConcept .
amol:HolyMusic a rpg:Proficiency ;
    rpg:name "Holy Music" ;
    dc:description "Ability of the Holy Method of Meditation allowing a supernatural state of mind by singing praises to God." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:HolyOilOfConsecration a rpg:Item ;
    rpg:name "Holy Oil of Consecration" ;
    dc:description "Ampoule of never-ending oil brought by a dove at Clovis's baptism, used to anoint French kings; a 3-point relic in Reims Cathedral." ;
    skos:altLabel "Holy Oil", "holy oil", "holy phial", "oil of anointing", "sacred ampoule" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:HolySocietates a rpg:Faction ;
    rpg:name "Holy Societates" ;
    dc:description "Traditions that teach Holy Magic as a favored Ability, typically associated with the Order of Hermes, which can train Gifted and unGifted holy magi." ;
    skos:altLabel "Holy Societas" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Honos a rpg:Creature ;
    rpg:name "Honos" ;
    dc:description "A Roman Daimon (Magic Might 30, Corpus) of morality and military honor, appearing as a young warrior with a lance and cornucopia, able to instill Leadership and produce a magical feast." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Hooks a rpg:Tag ;
    skos:prefLabel "Hooks" ;
    dc:description "The story component that drags the characters into the action, often connected to a Story or Personality Flaw of a key character." ;
    skos:altLabel "Hook" ;
    rpg:hasTag amol:HermeticConcept .
amol:HornetFire a rpg:Spell ;
    rpg:name "Hornet Fire" ;
    dc:description "A Muto Ignem spell (Level 10) with a Rego requisite that turns a fire into a swarm of insect-sized fireballs that harass a target, imposing a penalty and extra botch dice without dealing real damage." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:HorseClan a rpg:Faction ;
    rpg:name "Horse Clan" ;
    dc:description "A Crintera clan that maintains the covenant's wild steeds, possesses the Animal Ken Virtue, provides provisioning, and acts as a messenger service." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:HouseMysteries a rpg:Tag ;
    skos:prefLabel "House Mysteries" ;
    dc:description "The Bjornaer Mysteries (Heartbeast, Secret Name, Sensory Magic, Theriomorphy) Initiated by Clan Ilfetu that allow magi to emulate their ancestors." ;
    skos:altLabel "Exoteric Mysteries", "Exoteric Mystery" ;
    rpg:hasTag amol:HermeticConcept .
amol:HouseOfCanmore a rpg:Faction ;
    rpg:name "House of Canmore" ;
    dc:description "The royal line of Malcolm Canmore and Margaret that ruled Scotland in the 12th and 13th centuries." ;
    skos:altLabel "Canmore", "line of Canmore" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:HousesOfHermesSocietates a rpg:Item ;
    rpg:name "Houses of Hermes: Societates" ;
    dc:description "An Ars Magica sourcebook whose Tytalus chapter details House Tytalus' debate system." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:HughDeLusignan a rpg:Character ;
    rpg:name "Hugh de Lusignan" ;
    dc:description "The count of Marche, a powerful vassal of the king in Poitou and husband of Queen Isabella." ;
    skos:altLabel "Count of Marche", "County of Marche", "count of Marche" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Humanities a rpg:Proficiency ;
    rpg:name "Humanities" ;
    dc:description "Ability appearing in character or covenant library statistics in the Roman Tribunal." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:HungerForFormMagic a rpg:Tag ;
    skos:prefLabel "Hunger for (Form) Magic" ;
    dc:description "A Major Supernatural Flaw in which the character has become dependent on consuming 1 pawn of vis of a particular Form each season or lose Fatigue Levels." ;
    skos:altLabel "Hunger for Animal Vis", "Hunger for Ignem Magic" ;
    rpg:hasTag amol:Flaw .
amol:Huns a rpg:Faction ;
    rpg:name "Huns" ;
    dc:description "Invaders from Asia whose last coming was presaged by trade disruption." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:HuntForTheWildHerb a rpg:Spell ;
    rpg:name "Hunt for the Wild Herb" ;
    dc:description "An Intellego Herbam spell (Level 5) that lets you smell one sort of plant and follow its scent, requiring a sample of that plant." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:HygwaldVeritas a rpg:Character ;
    rpg:name "Hygwald Veritas" ;
    dc:description "A devious magus of House Tremere and co-founder of Waddenzee, a specialist in Rego Mentem who is scrupulously honest with the Quaesitores and aspires to join them." ;
    skos:altLabel "Hygwald", "Hygwald Veritas of Waddenzee" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:HLoSe a rpg:Character ;
    rpg:name "Héloïse" ;
    dc:description "Famous nun, disappointed lover of Peter Abelard, prioress at Argenteuil and abbess of the Paraclete." ;
    skos:altLabel "Heloise" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:HRisson a rpg:Character ;
    rpg:name "Hérisson" ;
    dc:description "A tenth-century Bjornaer magus who founded the Harmonist philosophy of living in harmony with nature, ridiculed in his own time." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Iaculus a rpg:Creature ;
    rpg:name "Iaculus" ;
    dc:description "A large venomous snake with feathered wings that flies from trees onto victims; one found dead drained of blood and vis." ;
    skos:altLabel "Iaculii", "iaculii", "syrenii" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Iblis a rpg:Character ;
    rpg:name "Iblis" ;
    dc:description "In Islamic cosmology, a jinn loyal to God who led the angels against the jinn, then refused to worship Adam out of pride and was cast into Hell; afterwards called Shaitan." ;
    skos:altLabel "Shaitan" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Ignatio a rpg:Character ;
    rpg:name "Ignatio" ;
    dc:description "A grog used in combat examples, fighting with a shortsword and round shield, who defeats the Infernal wolf Polandrus and later fights his faerie duplicate." ;
    skos:altLabel "Ignatio the shield grog" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:IgorRastvan a rpg:Character ;
    rpg:name "Igor Rastvan" ;
    dc:description "An archmage of House Ex Miscellanea and high priest of Radegast who leads Roznov's covenfolk in pagan worship and human sacrifice; his cursing magic draws on Slavic traditions and pagan ceremony, and his zeal may be unhinging him via Twilight." ;
    skos:altLabel "Igor", "Rastvan" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Ihwaz a rpg:Proficiency ;
    rpg:name "Ihwaz" ;
    dc:description "Elder Futhark rune \"Yew\" used as a vitkir Art. Rune of the yew tree, associated with death, witchcraft, trees, bows and spirits of the dead." ;
    skos:altLabel "Eoh", "Yr" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticArt .
amol:IllusionOfTheMisplacedCastle a rpg:Spell ;
    rpg:name "Illusion of the Misplaced Castle" ;
    dc:description "A Rego Imaginem ritual (Level 50) that moves the image of any bounded structure the size of a castle or less up to one mile from its actual position." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ImageFromTheWizardTorn a rpg:Spell ;
    rpg:name "Image from the Wizard Torn" ;
    dc:description "A Rego Imaginem spell (Level 35) with an Intellego requisite that separates the caster's image from their body so it can speak and be seen through, leaving the caster invisible and silent." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ImanitosMendax a rpg:Character ;
    rpg:name "Imanitos Mendax" ;
    dc:description "A vain, treacherous magus of Oculus Septentrionalis with a focus in Mentem (and Imaginem for disguises); he runs a tavern, brothel, and extortion business in Lubeck and is secretly conspiring with the pirate covenant Waddenzee." ;
    skos:altLabel "Imanitos", "Imanitos Mendax of Oculus Septentrionalis", "Imanitos, Follower of Jerbiton", "the prophet of Radegast" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Imanitosi a rpg:Character ;
    rpg:name "Imanitosi" ;
    dc:description "Prima of House Verditius who succumbed to Final Twilight in September 1219 while experimenting in her laboratory." ;
    skos:altLabel "Prima Imanitosi" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Immanola a rpg:Character ;
    rpg:name "Immanola" ;
    dc:description "The prima of House Ex Miscellanea and oldest maga in the tribunal, over 150 years old, gifted in prophecy; blocked from the praeco position by Blackthorn and now seen as Twilight-ridden." ;
    skos:altLabel "Immanola, prima of House Ex Miscellanea" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:ImpiousFriend a rpg:Tag ;
    skos:prefLabel "Impious Friend" ;
    dc:description "A Minor Story Tainted Flaw in which a minor demon poses as a friend of the character to guide him toward a tragic destiny." ;
    rpg:hasTag amol:Flaw .
amol:ImprovedDamage a rpg:Tag ;
    skos:prefLabel "Improved Damage" ;
    dc:description "Minor Supernatural Virtue enhancing a natural weapon by up to +5 Damage." ;
    rpg:hasTag amol:Virtue .
amol:ImprovedInitiative a rpg:Tag ;
    skos:prefLabel "Improved Initiative" ;
    dc:description "Minor Supernatural Virtue increasing a natural weapon's Initiative by 3." ;
    rpg:hasTag amol:Virtue .
amol:ImprovedMight a rpg:Tag ;
    skos:prefLabel "Improved Might" ;
    dc:description "Magic Quality increasing Might, taken by several Beasts of Virtue." ;
    rpg:hasTag amol:Virtue .
amol:IncantationOfTheMilkyEyes a rpg:Spell ;
    rpg:name "Incantation of the Milky Eyes" ;
    dc:description "A Perdo Corpus spell (Level 30) that blinds a target, leaving the eyes milky with cataracts; heals as a Heavy Wound." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:IncompatibleHedgeArts a rpg:Tag ;
    skos:prefLabel "Incompatible Hedge Arts" ;
    dc:description "Minor Supernatural Flaw preventing use of one Technique-Form combination." ;
    rpg:hasTag amol:Flaw .
amol:Indenture a rpg:Tag ;
    skos:prefLabel "Indenture" ;
    dc:description "A proposed period of required seasons of labor after apprenticeship to remunerate the Order, similar to a guild journeyman phase." ;
    rpg:hasTag amol:HermeticConcept .
amol:InfamousMaster a rpg:Tag ;
    skos:prefLabel "Infamous Master" ;
    dc:description "A Minor Hermetic Flaw in which the character's master was a diabolist or fool, causing other magi to treat the character with contempt." ;
    rpg:hasTag amol:Flaw .
amol:InfernalBlessing a rpg:Tag ;
    skos:prefLabel "Infernal Blessing" ;
    dc:description "Major or Minor Supernatural Tainted Virtue granting 60 or 120 levels of beneficial unholy effects from a demon or Infernal tradition." ;
    skos:altLabel "Infernal Blessings" ;
    rpg:hasTag amol:Virtue .
amol:InfernalGhost a rpg:Creature ;
    rpg:name "Infernal Ghost" ;
    dc:description "A damned human soul allowed to roam the earth under arrangement with Hell; belongs to an order but lacks the Coagulation Power." ;
    skos:altLabel "Infernal Ghosts" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:InfernalReputation a rpg:Tag ;
    skos:prefLabel "Infernal Reputation" ;
    dc:description "Reputation among demons and infernalists of a demon's perceived power in Hell, affecting summoning." ;
    rpg:hasTag amol:HermeticConcept .
amol:InfernalTraditions a rpg:Tag ;
    skos:prefLabel "Infernal Traditions" ;
    dc:description "Optional groups of like-minded infernalists defined by Methods, Powers and Favored Abilities." ;
    skos:altLabel "traditions" ;
    rpg:hasTag amol:HermeticConcept .
amol:Infiltrator a rpg:Tag ;
    skos:prefLabel "Infiltrator" ;
    dc:description "Minor or Major Social Interaction Virtue for a faerie that lives as a human, costing as the mimicked Social Status." ;
    rpg:hasTag amol:Virtue .
amol:Ingwaz a rpg:Proficiency ;
    rpg:name "Ingwaz" ;
    dc:description "Elder Futhark rune \"Lord\" used as a vitkir Art. Rune of peace, family and a secure home; targets buildings and household members." ;
    skos:altLabel "Ing" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticArt .
amol:IntangibleFlesh a rpg:Tag ;
    skos:prefLabel "Intangible Flesh" ;
    dc:description "Major Supernatural Flaw: the character is immaterial and cannot physically influence the world." ;
    rpg:hasTag amol:Flaw .
amol:IntricacyPoints a rpg:Tag ;
    skos:prefLabel "Intricacy Points" ;
    dc:description "Points representing complex portions of a faerie's glamour, used to raise a power's Initiative or reduce its Might cost." ;
    rpg:hasTag amol:HermeticConcept .
amol:IntuitionOfTheForest a rpg:Spell ;
    rpg:name "Intuition of the Forest" ;
    dc:description "An Intellego Herbam spell (Level 10) giving an intuitive sense of how to get along in a forest, granting +3 to nature-oriented rolls there." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Invisibility a rpg:Proficiency ;
    rpg:name "Invisibility" ;
    dc:description "Ability/power of cu sith and Gliocas to vanish when followed." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:InvisibleSlingOfVilano a rpg:Spell ;
    rpg:name "Invisible Sling of Vilano" ;
    dc:description "A popular indirect Rego Terram (ReTe 10) spell that hurls a stone as a projectile; bypasses Magic Resistance with a successful aiming roll, inflicting +5 damage." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:InvocationOfWeariness a rpg:Spell ;
    rpg:name "Invocation of Weariness" ;
    dc:description "A Perdo Corpus spell (Level 20) that causes the target to lose a Fatigue level, often via singsong melodies that lull the victim into drowsiness." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Ioanna a rpg:Character ;
    rpg:name "Ioanna" ;
    dc:description "A Redcap follower of Mercere murdered in the city of Trier in 1151 AD, prompting a Quaesitorial investigation; she had earlier recorded directions to Treverorum and Rheinstein." ;
    skos:altLabel "the Redcap Ioanna" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Isa a rpg:Proficiency ;
    rpg:name "Isa" ;
    dc:description "Elder Futhark rune \"Ice\" used as a vitkir Art. Rune of ice, cold and cold emotions; associated with Aquam, Ignem or Mentem." ;
    skos:altLabel "Is", "Iss" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticArt .
amol:Isabelle a rpg:Character ;
    rpg:name "Isabelle" ;
    dc:description "A woman living at the covenant of Semita Errabunda, named in an example command of a Psychomachia maleficium." ;
    skos:altLabel "Isabelle the Beautiful" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:IsleOfUshant a schema:Place ;
    rpg:name "Isle of Ushant" ;
    dc:description "A flat-topped island off Brittany with vertical cliffs and treacherous reefs, on which the Tytalus Domus Magna Fudarus is built." ;
    skos:altLabel "Ushant" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Jason a rpg:Character ;
    rpg:name "Jason" ;
    dc:description "The leader of the Argonauts who, on Chiron's advice, brought Orpheus on the voyage to retrieve the Golden Fleece." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Jera a rpg:Proficiency ;
    rpg:name "Jera" ;
    dc:description "Elder Futhark rune \"Year\" used as a vitkir Art. Rune of the harvest and year-long bounty; mostly associated with Herbam." ;
    skos:altLabel "Ar", "Ger" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticArt .
amol:JoachimOfFlora a rpg:Character ;
    rpg:name "Joachim of Flora" ;
    dc:description "Charismatic Sicilian-born Cistercian abbot and prophet (d. 1200) who taught the Three Ages of the World; some Trinitarian ideas were condemned by the Fourth Lateran Council." ;
    skos:altLabel "Abbot Joachim", "Blessed Joachim of Flora", "Joachim" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:JohnOfSalisbury a rpg:Character ;
    rpg:name "John of Salisbury" ;
    dc:description "Twelfth-century writer (1115-1180) whose Policraticus complains of diviners at court; he crystal-gazed as a pupil." ;
    skos:altLabel "John" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Journeyman a rpg:Tag ;
    skos:prefLabel "Journeyman" ;
    dc:description "A Minor Social Status Virtue for a trained guild craftsman who may practice his trade in town under guild supervision and work for a master for a wage." ;
    rpg:hasTag amol:Virtue .
amol:JudaicLore a rpg:Proficiency ;
    rpg:name "Judaic Lore" ;
    dc:description "A General Ability covering knowledge of Jewish cultural practice such as poetry, folklore, and songs." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:Julius a rpg:Character ;
    rpg:name "Julius" ;
    dc:description "Archmagus of House Flambeau and Ignem specialist who, with Lavinia, leads the Hermetic crusade against Iceland and kills Biorn Egilsson." ;
    skos:altLabel "Archmagus Julius", "Julian", "Julius of the Oder" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:JunoSSpire a rpg:Faction ;
    rpg:name "Juno's Spire" ;
    dc:description "Chapter house of the Covenant of the Icy North serving as the personal demesne of Archmagus Pietro, linked to the Motherhouse by a defended Hermes Portal." ;
    skos:altLabel "Spire of Juno", "Spire of Juno Chapter", "the Spire" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:KalliopeFiliaBibliophilus a rpg:Character ;
    rpg:name "Kalliope filia Bibliophilus" ;
    dc:description "Middle-aged magus, latest in an intermittent line of librarian-magi at Valnastium." ;
    skos:altLabel "Kalliope" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:KaraiteMagic a rpg:Tag ;
    skos:prefLabel "Karaite Magic" ;
    dc:description "Major Hermetic Flaw requiring all magic to be designed with Holy Magic, forbidding divination, astrology, and summoning spirits, and barring acceptance of non-Karaite magic or healing." ;
    rpg:hasTag amol:Flaw .
amol:Kauno a rpg:Proficiency ;
    rpg:name "Kauno" ;
    dc:description "Elder Futhark rune \"Pain\" used as a vitkir Art. Rune of torches, fever and burning pain; affects fire and heat (Ignem) as well as sores and sickness." ;
    skos:altLabel "Cen", "Kaun" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticArt .
amol:Kelpie a rpg:Creature ;
    rpg:name "Kelpie" ;
    dc:description "Carnivorous magical creature (Might 20 Aquam) of deep fresh-water pools, a mass of tentacles that can turn into a black stallion to lure and drown victims." ;
    skos:altLabel "Water Horse" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:KennethMacAlpin a rpg:Character ;
    rpg:name "Kenneth MacAlpin" ;
    dc:description "King of the Scots who stood on the Stone of Destiny in 834 and conquered the Picts with the aid of House Diedne." ;
    skos:altLabel "Kenneth", "Kenneth Mac Alpin" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Kerguntuil a rpg:Faction ;
    rpg:name "Kerguntuil" ;
    dc:description "Diedne vassal of Branugurix (920-1007) on the Rose Coast, interested in giant lore." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:Kintyre a schema:Place ;
    rpg:name "Kintyre" ;
    dc:description "Peninsula added to the kingdom of Man by Magnus Barelegs in 1098; rich in stone alignments." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:KnightBanneret a rpg:Tag ;
    skos:prefLabel "Knight Banneret" ;
    dc:description "A knight who leads other knights under his own banner. The rank can be claimed by arriving with ten liveried knights or bestowed by a liege." ;
    skos:altLabel "Banneret", "banneret" ;
    rpg:hasTag amol:CharacterType .
amol:KnightErrant a rpg:Tag ;
    skos:prefLabel "Knight Errant" ;
    dc:description "+1 Background Virtue: you have been knighted and may bear arms and be addressed as sir, owing no fealty or service." ;
    rpg:hasTag amol:Virtue .
amol:KnightsHospitaller a rpg:Faction ;
    rpg:name "Knights Hospitaller" ;
    dc:description "A military order of monk-knights holding land across Christendom whose English houses gather funds and supplies for the Levant." ;
    skos:altLabel "Hospitallers", "Knights of the Hospital of St. John of Jerusalem", "Order of Hospitallers" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:KnightsOfTheGreenStone a rpg:Faction ;
    rpg:name "Knights of the Green Stone" ;
    dc:description "A group of magi who believe the romances conceal the true story of the Grail and seek clues to a great artifact." ;
    skos:altLabel "the Knights" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Knowe a schema:Place ;
    rpg:name "Knowe" ;
    dc:description "Faerie hills where seelie faeries live; farmers avoid planting or grazing on them." ;
    skos:altLabel "Faerie Knowes", "knowes" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:KolazontaTheChastiser a rpg:Creature ;
    rpg:name "Kolazonta, the Chastiser" ;
    dc:description "A Divine angel (Might 30, Ignem) tasked to chastise the faithful for their failings, appearing as a dark cloud or man of white fire; he brought the plague upon the Israelites for rebelling against Moses." ;
    skos:altLabel "Kolazonta" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Kolossos a rpg:Item ;
    rpg:name "Kolossos" ;
    dc:description "Stone buried in place of an absent body, acting as an Arcane Connection anchoring the spirit; Aristeas's is a statue with a raven emerging from his mouth." ;
    skos:altLabel "Kolossoi", "kolossoi" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:La a rpg:Character ;
    rpg:name "La" ;
    dc:description "Prima of House Criamon and Praeco, an elderly Rego specialist once called Lucia who murdered a priest under the Black Mark and is cursed by God." ;
    skos:altLabel "La, primus of Criamon", "Lucia", "Prima La" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Laguz a rpg:Proficiency ;
    rpg:name "Laguz" ;
    dc:description "Elder Futhark rune \"Water\" used as a vitkir Art. Rune of water, especially the ocean; almost always associated with Aquam." ;
    skos:altLabel "Lagu", "Logr" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticArt .
amol:Lamia a rpg:Creature ;
    rpg:name "Lamia" ;
    dc:description "Former queen of Libya, cursed by Hera, now a serpent-bodied faerie who eats children and steals eyes." ;
    skos:altLabel "Lamiae", "lesser lamiae" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Languedoc a schema:Place ;
    rpg:name "Languedoc" ;
    dc:description "A region of central southern France where Brother Julian wanders and preaches against the spread of the Cathar heresy." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:LatentMagicalAbility a rpg:Tag ;
    skos:prefLabel "Latent Magical Ability" ;
    dc:description "A Virtue granting uncontrolled magical talent; Torven's Latent Magical Ability causes wolf packs to come to his aid in the forest." ;
    rpg:hasTag amol:Virtue .
amol:LearnFromMistakes a rpg:Tag ;
    skos:prefLabel "Learn From Mistakes" ;
    dc:description "Mastery ability granting experience when botching or narrowly failing the spell." ;
    rpg:hasTag amol:HermeticConcept .
amol:LegendaryArtist a rpg:Tag ;
    skos:prefLabel "Legendary Artist" ;
    dc:description "An artist whose Reputation reaches 11 and is taken by his muse into a supernatural realm, becoming an immortal being with a Might score and supernatural powers based on his Craft or Profession." ;
    skos:altLabel "Maestro", "Maestro (Special Free Virtue)", "maestro", "maestros", "mythic artist" ;
    rpg:hasTag amol:CharacterType .
amol:LeprosyHermetic a rpg:Creature ;
    rpg:name "Leprosy, Hermetic" ;
    dc:description "A Critical Melancholic Disease caused by Hermetic spells, a rapid hideous wasting disease with a pungent rotting smell." ;
    skos:altLabel "Hermetic Leprosy", "Hermetic leprosy" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:LesserCharm a rpg:Tag ;
    skos:prefLabel "Lesser Charm" ;
    dc:description "Minor Supernatural Flaw: a Virtue activated by a secret ritual charm." ;
    skos:altLabel "Charm Flaw", "Greater Charm" ;
    rpg:hasTag amol:Flaw .
amol:LesserElixir a rpg:Tag ;
    skos:prefLabel "Lesser Elixir" ;
    dc:description "Minor Mystery Virtue enhancing a Longevity Ritual with extra ingredients whose Elixir Points raise the Aging Bonus; requires Hermetic Alchemy." ;
    skos:altLabel "Lesser Elixir of Life" ;
    rpg:hasTag amol:Virtue .
amol:Libellus a rpg:Faction ;
    rpg:name "Libellus" ;
    dc:description "The newest and one of the largest covenants in the tribunal, founded and led by Stephen Eruditus of Jerbiton; an unknown quantity in tribunal politics." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:LicenseOfAbsence a rpg:Tag ;
    skos:prefLabel "License of Absence" ;
    dc:description "A Major, General Virtue for a priest relieved of some duties, giving an extra free season each year; only available to Priest Social Status." ;
    rpg:hasTag amol:Virtue .
amol:Lickspitten a rpg:Creature ;
    rpg:name "Lickspitten" ;
    dc:description "A famulus in the form of a black cat with a star of white hairs on its belly, serving a witch by hiding the taint of her Powers." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Lickstone a rpg:Item ;
    rpg:name "Lickstone" ;
    dc:description "Small metal plate attached to the palate carrying redcap spells; Cymena's contains Seven-League Stride." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:Ligurio a rpg:Faction ;
    rpg:name "Ligurio" ;
    dc:description "Vassal of Fudarus (913-1011) in the Vendée, destroyed by giants presumed sent by Kerguntuil." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:Lilin a rpg:Creature ;
    rpg:name "Lilin" ;
    dc:description "Female Tempter night spirits giving nightmares and smothering children; their offspring with men are shedim and lilin." ;
    skos:altLabel "lil" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:LimitOfArcaneConnections a rpg:Tag ;
    skos:prefLabel "Limit of Arcane Connections" ;
    dc:description "A Hermetic limit concerning the use of Arcane Connections; a Touch-range spell on a room does not violate it even when affecting unseen people within." ;
    rpg:hasTag amol:HermeticConcept .
amol:LimitsOfMagic a rpg:Tag ;
    skos:prefLabel "Limits of Magic" ;
    dc:description "The fundamental boundaries constraining Hermetic magic; Major Breakthroughs push them, Hermetic Breakthroughs break Lesser Limits such as the Limit of Magic Resistance." ;
    skos:altLabel "Greater Limits of Magic", "Hermetic Limit", "Laws of Magic", "Lesser Limits of Magic", "Limit of Arcane Connection", "Limit of Magic" ;
    rpg:hasTag amol:HermeticConcept .
amol:Limoges a schema:Place ;
    rpg:name "Limoges" ;
    dc:description "City divided between the Cité and the commercial center around the Abbey of St. Martial." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:LivingConditions a rpg:Tag ;
    skos:prefLabel "Living Conditions" ;
    dc:description "Game modifier for living in a city or town, halved to +1 in the saga seed thanks to food preservation." ;
    rpg:hasTag amol:HermeticConcept .
amol:LivingConditionsModifier a rpg:Tag ;
    skos:prefLabel "Living Conditions Modifier" ;
    dc:description "Aging modifier that magic can indirectly improve at +1 per 40 levels of enchantment." ;
    rpg:hasTag amol:HermeticConcept .
amol:Lombards a rpg:Faction ;
    rpg:name "Lombards" ;
    dc:description "Long-bearded barbarians who ruled Italy from Pavia until 774." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:LordGoulis a rpg:Character ;
    rpg:name "Lord Goulis" ;
    dc:description "Diabolist seneschal of the Scottish king who built Monksend castle, hunting souls in the Borders with his demonic familiar and demon dogs." ;
    skos:altLabel "David Goulis", "David, Lord Goulis", "Goulis" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:LordOfTheTrees a rpg:Spell ;
    rpg:name "Lord of the Trees" ;
    dc:description "A Rego Herbam spell (Level 25) that causes a tree to move its branches and bend its trunk as mentally directed; a large tree gains Initiative, Attack, and Damage scores." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Lotharingia a schema:Place ;
    rpg:name "Lotharingia" ;
    dc:description "The middle kingdom of the divided Carolingian empire that belonged to Lothar, later reabsorbed into Germany and divided into Upper and Lower Lorraine." ;
    skos:altLabel "Lorraine" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:LouisVII a rpg:Character ;
    rpg:name "Louis VII" ;
    dc:description "King of France, first husband of Eleanor, father of Philip Augustus." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:LouisOfFrance a rpg:Character ;
    rpg:name "Louis of France" ;
    dc:description "The French prince who invaded England with an army in the civil war and controlled much of southern England before being driven out by William Marshal as regent." ;
    skos:altLabel "Louis" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:LowerLorraine a schema:Place ;
    rpg:name "Lower Lorraine" ;
    dc:description "The lower half of the ancient kingdom of Lotharingia, fractured into counties and duchies including the rival duchies of Brabant and Limburg, with forested uplands of the Ardennes and Eifel." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Lucian a rpg:Character ;
    rpg:name "Lucian" ;
    dc:description "An elder House Merinita magus of the covenant of Aegea in the Theban Tribunal, renowned for knowledge of Byzantine and ancient Greek literature and rumored initiated into story magic." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Luciferans a rpg:Faction ;
    rpg:name "Luciferans" ;
    dc:description "A misguided Infernal tradition that worships Lucifer as a kinder, benevolent God; strongest in 1220 within the Church in Germany, Austria and Bohemia." ;
    skos:altLabel "Luciferan" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Lucifuges a rpg:Creature ;
    rpg:name "Lucifuges" ;
    dc:description "Family of Aerial Powers (Might 20), Destroyers; Psellos' heliophobic demons who hate the sun and kill by breath or touch." ;
    skos:altLabel "Lucifugus", "fly-the-lights", "heliophobic demons", "lucifuge", "lucifugus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:LungsOfTheFish a rpg:Spell ;
    rpg:name "Lungs of the Fish" ;
    dc:description "A Muto Aquam spell (Level 20) with an Auram requisite that turns water into air as it enters the lungs, allowing the caster to breathe water." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Lupercalia a rpg:Tag ;
    skos:prefLabel "Lupercalia" ;
    dc:description "A festival held from 13 to 15 February at which all luperci of a region may try to dispel curses laid on the community, drawing on the Daimon of Revenge." ;
    rpg:hasTag amol:HermeticConcept .
amol:Lupersus a rpg:Creature ;
    rpg:name "Lupersus" ;
    dc:description "A Divine creature (Might 20, Animal) appearing as a noble silver-gray wolf sent by God to guard a holy hermit, provide food, and lead those in need to him; not an angel." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Lyonesse a schema:Place ;
    rpg:name "Lyonesse" ;
    dc:description "A drowned land that once stretched from Cornwall to the Scilly Isles, Tristan's birthplace, sunk by the anger of the Fair Folk; its town was called Lyon and its remains can be seen at low tide." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:MacBeth a rpg:Character ;
    rpg:name "MacBeth" ;
    dc:description "Mormaer of Moray who killed Duncan with the aid of Pictish wizards and renegade Ex Miscellanea magi, ruled seventeen years, and was killed by Malcolm Canmore." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Maggots a rpg:Creature ;
    rpg:name "Maggots" ;
    dc:description "Tiny Tempter demons like winged apes that eat into victims' brains causing delusions; also called astasian and commanded by Beelzebub." ;
    skos:altLabel "astasian" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:MagiOrbi a rpg:Tag ;
    skos:prefLabel "Magi Orbi" ;
    dc:description "Magi who began in a different House but were exiled and found refuge in House Ex Miscellanea; they retain their former House's rules but lose its privileges and secrets." ;
    skos:altLabel "Orba", "Orbi", "Orbus", "orbus" ;
    rpg:hasTag amol:HermeticConcept .
amol:MagicalArmillarySphere a rpg:Item ;
    rpg:name "Magical Armillary Sphere" ;
    dc:description "An enchanted armillary sphere that continually tracks astrological time and planetary influences, halving the Ease Factor of Astrological Duration calculations." ;
    skos:altLabel "Armillary Sphere", "armillary sphere", "spherical astrolabe" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:MagicalBlood a rpg:Tag ;
    skos:prefLabel "Magical Blood" ;
    dc:description "Minor Supernatural Virtue: exposure to the Magic realm improves the character's true form, giving -1 on Aging rolls, access to Magic Lore and a minor physical advantage; sometimes called faerie blood." ;
    rpg:hasTag amol:Virtue .
amol:MagicalCovenfolk a rpg:Tag ;
    skos:prefLabel "Magical Covenfolk" ;
    dc:description "Free Social Status Virtue for a magical being accepted as an equal by the people of its covenant." ;
    rpg:hasTag amol:Virtue .
amol:MagicalMemory a rpg:Tag ;
    skos:prefLabel "Magical Memory" ;
    dc:description "A Minor Hermetic Virtue allowing a magus to reproduce magical creations without keeping laboratory texts, getting the benefit of a Lab Text from memory." ;
    rpg:hasTag amol:Virtue .
amol:MagicalMount a rpg:Tag ;
    skos:prefLabel "Magical Mount" ;
    dc:description "A Minor General Virtue granting a mount or beast-of-burden with Cunning and a Magic Might Score up to 25 that obeys simple verbal commands." ;
    rpg:hasTag amol:Virtue .
amol:Magicam a rpg:Proficiency ;
    rpg:name "Magicam" ;
    dc:description "Learned magician Form governing magic, protection from hostile magic and magical powers; corresponds most closely to Vim." ;
    skos:altLabel "Ma" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticArt .
amol:Magyars a rpg:Faction ;
    rpg:name "Magyars" ;
    dc:description "Nomadic Hungarian raiders of northern Italy; small enclaves remain." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:MaintainTheDemandingSpell a rpg:Spell ;
    rpg:name "Maintain the Demanding Spell" ;
    dc:description "A Vim spell cited as not eligible for the Rebuttal Mastery special ability." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Mainz a schema:Place ;
    rpg:name "Mainz" ;
    dc:description "Formerly the Roman city Moguntiacum, raised to an archbishopric by St. Boniface; its archbishop is Archchancellor of the Empire and primas germaniae, and its see is a Holy See with a Divine aura of 7." ;
    skos:altLabel "Moguntiacum" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:MajaridaMountains a schema:Place ;
    rpg:name "Majarida Mountains" ;
    dc:description "The mountains around the Wolf's Court, home to unusually bold wolf packs that include Wolves of Virtue." ;
    skos:altLabel "Majarida", "Majaridas", "Monts de la Margeride" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:MalcolmCanmore a rpg:Character ;
    rpg:name "Malcolm Canmore" ;
    dc:description "Duncan's son raised in England who killed MacBeth with the aid of two mysterious magi and brought English influence to Scotland." ;
    skos:altLabel "Malcolm", "Malcolm III Canmore" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:ManannanMacLir a rpg:Character ;
    rpg:name "Manannan Mac Lir" ;
    dc:description "Irish faerie sovereign and wizard-king, once god of Irish sailors and the Isle of Man; a shapeshifter with Faerie Might 55." ;
    skos:altLabel "Manannan", "Mannanan" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Mandrake a rpg:Creature ;
    rpg:name "Mandrake" ;
    dc:description "Magic Thing root with Might 5 whose deadly scream kills those who hear it; may be Enriched to grant Premonitions or bonded as a homunculus familiar." ;
    skos:altLabel "Mandrake Root of Virtue", "Mandrake of Virtue" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Mannaz a rpg:Proficiency ;
    rpg:name "Mannaz" ;
    dc:description "Elder Futhark rune \"Man\" used as a vitkir Art. Rune of mankind and cooperation; usually linked to Corpus and used to target persons with other runes." ;
    skos:altLabel "Madhr", "Mann" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticArt .
amol:ManufacturedIgnorance a rpg:Tag ;
    skos:prefLabel "Manufactured Ignorance" ;
    dc:description "A Minor Story Tainted Flaw in which a group of minor demons sustains the tainted character's delusion by arranging supporting fortunate occurrences." ;
    rpg:hasTag amol:Flaw .
amol:Marco a rpg:Character ;
    rpg:name "Marco" ;
    dc:description "A disreputable Redcap, frequently described as a liar and charlatan, who reports many strange tales of covenants." ;
    skos:altLabel "Marco the Student" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:MarcusNavicularius a rpg:Character ;
    rpg:name "Marcus Navicularius" ;
    dc:description "A Follower of Verditius (age 58) and the foremost shipwright in Lübeck, a master of Terram who enchants extremely large items such as ships for sale to other covenants." ;
    skos:altLabel "Marcus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Maria a rpg:Character ;
    rpg:name "Maria" ;
    dc:description "A young woman near Mount Etna who has the Visions Flaw, feeling an empathy for fire and able to predict the volcano's eruptions through her dreams." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:MariusOfTremere a rpg:Character ;
    rpg:name "Marius of Tremere" ;
    dc:description "A magus of House Tremere whose version of Ball of Abysmal Flame causes the ball to make a loud bang on impact; his magical sigil is a gaudiness in his spells." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Mars a rpg:Character ;
    rpg:name "Mars" ;
    dc:description "The Roman war deity; the Resting Place of Mars is speculated to be the sleeping place of such a war god." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:MassHealing a rpg:Tag ;
    skos:prefLabel "Mass Healing" ;
    dc:description "Saint Power available through invoking Muslim holy forbears or relics." ;
    rpg:hasTag amol:HermeticConcept .
amol:MasterOfForm a rpg:Tag ;
    skos:prefLabel "Master of (Form)" ;
    dc:description "Spirit power duplicating non-Ritual Muto or Perdo spells of a Form at a Might cost, e.g. Master of Water, Master of Earth, Master of Plants." ;
    skos:altLabel "Master of Earth", "Master of Plants", "Master of Water" ;
    rpg:hasTag amol:HermeticConcept .
amol:MemoryOfTheDistantDream a rpg:Spell ;
    rpg:name "Memory of the Distant Dream" ;
    dc:description "A Creo Mentem spell (Level 20) that inserts a full false memory into a person's mind, revealed as false on a successful Intelligence roll; the memory vanishes when the duration expires." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Mendalus a rpg:Character ;
    rpg:name "Mendalus" ;
    dc:description "A hierophant of the Huntress who in 1129 proclaimed at the Grand Tribunal that the Order should follow Merinita's true path; crazed by Twilight and believing himself the messiah, he was slain by fellow hierophants via Wizard's War." ;
    skos:altLabel "Mendalus of House Merinita" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:MentoredByDemons a rpg:Tag ;
    skos:prefLabel "Mentored by Demons" ;
    dc:description "A Minor General Tainted Virtue letting a character learn Abilities faster than possible with human teachers, though demons only teach what suits their plans." ;
    rpg:hasTag amol:Virtue .
amol:Mercuralia a rpg:Tag ;
    skos:prefLabel "Mercuralia" ;
    dc:description "Festival of Mercury on May 15th, when the Priest sprinkles enchanted water on the Congregation's hands." ;
    skos:altLabel "Festival of Mercuralia" ;
    rpg:hasTag amol:HermeticConcept .
amol:MerryDevils a rpg:Creature ;
    rpg:name "Merry Devils" ;
    dc:description "Vessels of Iniquity who encourage young men to seek pleasure regardless of consequences, using intoxicants and illusions." ;
    skos:altLabel "Merry Devil" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:MiklosFiliusKosma a rpg:Character ;
    rpg:name "Miklos filius Kosma" ;
    dc:description "Faerie-blooded young Jerbiton magus at Journeys End, a musician and enchanted tailor married to Lyndsay." ;
    skos:altLabel "Miklos" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Milo a rpg:Character ;
    rpg:name "Milo" ;
    dc:description "Second apprentice of Verditius who combined Boethius's philosophy with Germanic runes to invent Verditius Runes and discovered Hephaestus's torture chair at Ravenna." ;
    skos:altLabel "House of Milo" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:MindOfTheBeast a rpg:Spell ;
    rpg:name "Mind of the Beast" ;
    dc:description "A Muto Mentem spell (Level 30) with an Animal requisite that turns the target's mind into that of an animal of the caster's choice, with the victim acting like that animal." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Minerva a rpg:Character ;
    rpg:name "Minerva" ;
    dc:description "A pagan goddess whose image in high relief is carved into rock just south of Chester and is said to continue to watch over the city." ;
    skos:altLabel "the pagan goddess Minerva" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Miniature a rpg:Tag ;
    skos:prefLabel "Miniature" ;
    dc:description "A Flaw or Inferiority named among the traits of magical animals or dragons in this text." ;
    rpg:hasTag amol:Flaw .
amol:Ministeriales a rpg:Tag ;
    skos:prefLabel "Ministeriales" ;
    dc:description "Unfree German knights who served in exchange for upkeep and are being absorbed into the hereditary knightly class." ;
    skos:altLabel "reichsministeriales" ;
    rpg:hasTag amol:CharacterType .
amol:Minotaur a rpg:Creature ;
    rpg:name "Minotaur" ;
    dc:description "Immortal minotaur arena gladiator (Magic Might 10) lairing beneath the ruined amphitheater of the temple town." ;
    skos:altLabel "Maze Beast" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Miracles a rpg:Tag ;
    skos:prefLabel "Miracles" ;
    dc:description "The direct intervention of God in the world, which can do anything, cannot fail, and cannot be resisted by any other power including creature Magic Resistance." ;
    skos:altLabel "Divine miracles", "Miracle", "Praying for Miracles", "miracle" ;
    rpg:hasTag amol:HermeticConcept .
amol:MiraculousEffects a rpg:Tag ;
    skos:prefLabel "Miraculous Effects" ;
    dc:description "Limited but reliable supernatural effects produced by holy characters by combining a Method and a Power, rolled against a target level." ;
    skos:altLabel "Effect Total", "holy effects" ;
    rpg:hasTag amol:HermeticConcept .
amol:MissingEar a rpg:Tag ;
    skos:prefLabel "Missing Ear" ;
    dc:description "A Minor General Flaw in which the character cannot accurately locate the direction of sounds, suffering a penalty to hearing rolls." ;
    rpg:hasTag amol:Flaw .
amol:MolesMagna a rpg:Faction ;
    rpg:name "Moles Magna" ;
    dc:description "Vassal of Oleron (1136-1182) built within a dam on the edge of the Morvan, destroyed when the dam burst." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:MonasticVowsHermetic a rpg:Tag ;
    skos:prefLabel "Monastic Vows (Hermetic)" ;
    dc:description "Major Hermetic Flaw: vows of poverty, chastity and obedience; the magus cannot own vis, possesses only functional magic devices, and may be barred from binding a familiar. All Neriusians take it." ;
    skos:altLabel "Monastic Vows" ;
    rpg:hasTag amol:Flaw .
amol:MonstrousBlood a rpg:Tag ;
    skos:prefLabel "Monstrous Blood" ;
    dc:description "A Minor Supernatural Flaw in which the character's essential nature has been changed through exposure to the Magic realm, giving her true form unfortunate supernatural properties and a visible deformity, while granting a -1 bonus to Aging rolls." ;
    rpg:hasTag amol:Flaw .
amol:MontJoux a schema:Place ;
    rpg:name "Mont Joux" ;
    dc:description "The tallest summit in Europe, called Mons Iovis by the Romans after Jupiter Pennius; site of the Covenant Where Journeys End (later known as Mont Blanc)." ;
    skos:altLabel "Mons Iovis", "Mont Blanc", "Montjoux" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Montmartre a schema:Place ;
    rpg:name "Montmartre" ;
    dc:description "Hill north of Paris named for the martyrdom of St. Denis, formerly Mons Mercurius." ;
    skos:altLabel "Mons Mercurius" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:MotherhouseOfTheCovenantOfTheIcyNorth a schema:Place ;
    rpg:name "Motherhouse of the Covenant of the Icy North" ;
    dc:description "The Bavarian seat of the Covenant of the Icy North, effectively a Guernicus house covenant of Quaesitores who manage the Bavarian Common and host the Tribunal and the Midsummer Fair." ;
    skos:altLabel "Icy North motherhouse", "Mother House", "Motherhouse", "the Motherhouse" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:MountOlympus a schema:Place ;
    rpg:name "Mount Olympus" ;
    dc:description "The mountain home of the Greek gods from which Hephaestus was twice cast out; also the location of an all-Verditius covenant and a Forge of Hephaestus." ;
    skos:altLabel "Olympus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:MountPilatus a schema:Place ;
    rpg:name "Mount Pilatus" ;
    dc:description "A mountain in the Alps where climbing can generate terrible storms, cited as an example of a Site of Weakness Hook." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:MountSinai a schema:Place ;
    rpg:name "Mount Sinai" ;
    dc:description "Holy site with high Dominion (5-10) and terrestrial regiones." ;
    skos:altLabel "Sinai" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Muhammad a rpg:Character ;
    rpg:name "Muhammad" ;
    dc:description "Prophet of Islam born at Mecca c. 570, recipient of the Qur'an; the most revered holy forbear with Divine Might 100." ;
    skos:altLabel "Seal of the Prophets", "the Prophet" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Muirgheal a rpg:Character ;
    rpg:name "Muirgheal" ;
    dc:description "A Quaesitor who led the Order's investigation into the Normandy restless-dead crisis and invited the Gifted Donatores to join the Order en masse." ;
    skos:altLabel "Murigheal", "Quaesitor Muirgheal" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Muqta a rpg:Tag ;
    skos:prefLabel "Muqta" ;
    dc:description "A Major Social Status Virtue for an important emir entrusted with an iqta', a feudal-like fief, following the Landed Noble rules." ;
    rpg:hasTag amol:Virtue .
amol:MutantumMagic a rpg:Tag ;
    skos:prefLabel "Mutantum Magic" ;
    dc:description "Minor Hermetic Virtue for descendants of the Mutantes allowing Boosted, Harnessed and Tethered spells and items." ;
    rpg:hasTag amol:Virtue .
amol:MysticFraternityOfSamos a rpg:Faction ;
    rpg:name "Mystic Fraternity of Samos" ;
    dc:description "A Pythagorean Mystery Cult organized into degrees that teach planetary, geometric and theurgic Virtues; its Inner Order members run publicly known Schools." ;
    skos:altLabel "Fraternity of Samos", "Pythagorean Fraternity", "Pythagoreans", "Samos Cult", "the Fraternity" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:MythicAlchemists a rpg:Faction ;
    rpg:name "Mythic Alchemists" ;
    dc:description "Alternate learned tradition that creates potions, powders and pastilles rather than charms." ;
    skos:altLabel "Alchemist", "mythic alchemist" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:MythicAlchemy a rpg:Tag ;
    skos:prefLabel "Mythic Alchemy" ;
    dc:description "Major Supernatural Virtue and Ability allowing magical transmutation of substances, preparing superior craft materials and extracting vis." ;
    rpg:hasTag amol:Virtue .
amol:Naples a schema:Place ;
    rpg:name "Naples" ;
    dc:description "A city whose catacombs harbored the necromancer Guorna the Fetid and her tradition, which Tytalus and Tremere destroyed." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:NativeLanguage a rpg:Proficiency ;
    rpg:name "Native Language" ;
    dc:description "Ability used by young characters, e.g. in example childhoods and sample characters." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:NaturalLeader a rpg:Tag ;
    skos:prefLabel "Natural Leader" ;
    dc:description "A Minor General Virtue giving a +3 bonus to social situations where the dominant character takes the lead, partly overcoming the social penalty of The Gift." ;
    skos:altLabel "Pack leader" ;
    rpg:hasTag amol:Virtue .
amol:Naudiz a rpg:Proficiency ;
    rpg:name "Naudiz" ;
    dc:description "Elder Futhark rune \"Need\" used as a vitkir Art. Very negative rune of hardship and need; can delay or bind other rune effects." ;
    skos:altLabel "Naubiz", "Naudhr", "Nyd" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticArt .
amol:NegativeReaction a rpg:Tag ;
    skos:prefLabel "Negative Reaction" ;
    dc:description "Minor Social Interaction Flaw giving -3 on all social rolls." ;
    rpg:hasTag amol:Flaw .
amol:NeoMercurians a rpg:Faction ;
    rpg:name "Neo-Mercurians" ;
    dc:description "Mystery cult seeking to reconstruct authentic Mercurian magic within Hermetic theory, restoring ancient temples." ;
    skos:altLabel "Neo-Mercurian Cult", "Neo-Mercurian temple" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:NeptuneSWrath a rpg:Spell ;
    rpg:name "Neptune's Wrath" ;
    dc:description "A Rego Aquam Ritual spell (Level 40) that creates a gigantic wave up to a mile wide capable of capsizing ships and devastating coastlines." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Nero a rpg:Character ;
    rpg:name "Nero" ;
    dc:description "Roman emperor in whose last years Apollonius travelled through Rome and Iberia." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Nibelungenlied a rpg:Tag ;
    skos:prefLabel "Nibelungenlied" ;
    dc:description "The great epic poem of the tragic fate of the Burgundian people, immortalizing Siegfried, Kriemhild, Gunther, and Hagen, treated as true history in Mythic Germany." ;
    skos:altLabel "Song of the Nibelungs" ;
    rpg:hasTag amol:HermeticConcept .
amol:NicolaDeHay a rpg:Character ;
    rpg:name "Nicola de Hay" ;
    dc:description "The elderly hereditary constable of Lincoln castle and sheriff of the shire who held the castle through a siege and is locked in a conflict with the earl of Salisbury over her position." ;
    skos:altLabel "Nicola" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Nigrasaxa a rpg:Faction ;
    rpg:name "Nigrasaxa" ;
    dc:description "A relatively new, large covenant of two shining black towers, founded by Maximianus of Bonisagus to break the cycle of invalid tribunals." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:Nitibus a rpg:Creature ;
    rpg:name "Nitibus" ;
    dc:description "A shedeh (Tempter) and personal corrupter with two faces, who encourages his victim's habit of criticism and panders to his vanity." ;
    skos:altLabel "Nitibus, a Personal Corrupter" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:NoHands a rpg:Tag ;
    skos:prefLabel "No Hands" ;
    dc:description "A Major General Flaw in which the character has no hands; magi take a -5 penalty to all Casting Scores, offset by the Subtle Magic Virtue or Still Casting." ;
    rpg:hasTag amol:Flaw .
amol:Noah a rpg:Character ;
    rpg:name "Noah" ;
    dc:description "Patriarch whose Ark carried two pious Nephilim." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:NobleReputation a rpg:Tag ;
    skos:prefLabel "Noble Reputation" ;
    dc:description "A fourth style of Reputation alongside Local, Hermetic, and Ecclesiastic, allowing members of the landed class to know about each other." ;
    skos:altLabel "Prudhomme", "Prudhomme Reputation" ;
    rpg:hasTag amol:HermeticConcept .
amol:NonLethalCombat a rpg:Tag ;
    skos:prefLabel "Non-Lethal Combat" ;
    dc:description "Optional replacement for ArM5 scuffling rules using Bruises instead of Fatigue loss." ;
    rpg:hasTag amol:HermeticConcept .
amol:Northumbria a schema:Place ;
    rpg:name "Northumbria" ;
    dc:description "Saxon kingdom, successor to Bernicia, with its capital at Bamburgh." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Notary a rpg:Tag ;
    skos:prefLabel "Notary" ;
    dc:description "A Minor Social Status Virtue for a legal official employed by lords or towns who draws up contracts, witnesses charters, and affixes a seal." ;
    rpg:hasTag amol:CharacterType .
amol:NumerologistSBook a rpg:Item ;
    rpg:name "Numerologist's Book" ;
    dc:description "Enchanted book attuned to Numerological magic, lesser (+4) or greater (+8), adding a book bonus to Numerology, Rotes, Geometry and Architecture." ;
    skos:altLabel "Greater Numerologist's Book", "Lesser Numerologist's Book" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:Obligation a rpg:Tag ;
    skos:prefLabel "Obligation" ;
    dc:description "Flaw appearing in a Roman Tribunal vocation template." ;
    rpg:hasTag amol:Flaw .
amol:Ogham a rpg:Tag ;
    skos:prefLabel "Ogham" ;
    dc:description "Pictish script used by gruagachan to write Lab Texts and initiation scripts on stone or wood." ;
    rpg:hasTag amol:HermeticConcept .
amol:OrderOfMiscellany a rpg:Faction ;
    rpg:name "Order of Miscellany" ;
    dc:description "Pralix's group of wizards, spared from war and admitted as House Ex Miscellanea." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:OrderOfSuleiman a rpg:Faction ;
    rpg:name "Order of Suleiman" ;
    dc:description "A legendary organization of Islamic magi, rivals in power to the Order of Hermes, said to be the association of the non-Hermetic sahirs with close ties to Levantine rulers." ;
    skos:altLabel "Order of Suleiman (Solomon)", "putative Order of Suleiman" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:OrdoVagorum a rpg:Faction ;
    rpg:name "Ordo Vagorum" ;
    dc:description "The 'Order of Vagrants', a mock religious order of wandering clerks (vagantes) that is an Infernal societas, with chapters in Paris, Austria and northern Italy." ;
    skos:altLabel "Order of Vagrants", "Vagantes", "vagabond order", "vagabonds", "vagantes", "vaganti" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:OrkneyIslands a schema:Place ;
    rpg:name "Orkney Islands" ;
    dc:description "Northern islands owned by Norway, rich in standing stones; once called the Orcades, Isles of the Dead." ;
    skos:altLabel "Orcades", "Orkney", "Orkneys" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Ostia a schema:Place ;
    rpg:name "Ostia" ;
    dc:description "Cardinal-bishop town near Rome." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Othila a rpg:Proficiency ;
    rpg:name "Othila" ;
    dc:description "Elder Futhark rune \"Inheritance\" used as a vitkir Art. Rune of inherited property such as lands and heirlooms; most often tied to Terram." ;
    skos:altLabel "Ethel", "Otbila" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticArt .
amol:PactOfCrunClach a rpg:Tag ;
    skos:prefLabel "Pact of Crun Clach" ;
    dc:description "Pact of 1189 in which Scottish magi swore not to aid kings or invaders, regulating raids and theft." ;
    rpg:hasTag amol:HermeticConcept .
amol:Pallas a rpg:Character ;
    rpg:name "Pallas" ;
    dc:description "A maga whose death left her lover, a nymph of unmatched beauty, in inconsolable mourning, leaving a covenant tower unused for sixty years." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:PantherOfVirtue a rpg:Creature ;
    rpg:name "Panther of Virtue" ;
    dc:description "A magical panther whose lure causes mysterious disappearances of animals and can ensnare incautious investigators." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Parish a rpg:Tag ;
    skos:prefLabel "Parish" ;
    dc:description "Basic unit beneath deaneries where a priest conducts Mass; virtually every covenant lies in one." ;
    rpg:hasTag amol:HermeticConcept .
amol:PartingTheWaves a rpg:Spell ;
    rpg:name "Parting the Waves" ;
    dc:description "A Rego Aquam spell (Level 30) that parts a body of water, revealing a dry path five paces wide along the bottom." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:PassTheUnyieldingPortal a rpg:Spell ;
    rpg:name "Pass the Unyielding Portal" ;
    dc:description "A Muto Herbam spell (Level 5) that makes the wood of a door pliable, allowing the magus to bend it open regardless of most locks or bars." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:PassionSLostFeeling a rpg:Spell ;
    rpg:name "Passion's Lost Feeling" ;
    dc:description "A spell that renders the target unable to feel any emotion, leaving them listless and without motivation." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:PastOfAnother a rpg:Spell ;
    rpg:name "Past of Another" ;
    dc:description "A Muto Mentem ritual (Level 35) that completely rewrites the target's memories so they cannot remember their actual life until the effect is dispelled or expires." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Pendule a rpg:Character ;
    rpg:name "Pendule" ;
    dc:description "A legendary Provençal hedge wizard who evaded the Founder Flambeau, took four Hermetic followers (two from House Merinita), taught illusion Mysteries, and died in 854 AD." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Pentecost a rpg:Tag ;
    skos:prefLabel "Pentecost" ;
    dc:description "Feast 49 days after Easter with feasting, dancing and horse racing, often followed by a week of holidays." ;
    skos:altLabel "Whitsunday" ;
    rpg:hasTag amol:HermeticConcept .
amol:PerceiveTheMagicalScent a rpg:Spell ;
    rpg:name "Perceive the Magical Scent" ;
