    rpg:hasTag amol:Place .
amol:MemoryPalace a rpg:Tag ;
    skos:prefLabel "Memory Palace" ;
    dc:description "A mnemonic structure of rooms and loci used in the Art of Memory, traditionally a square villa with a central courtyard; number of rooms equals Art of Memory score." ;
    rpg:hasTag amol:HermeticConcept .
amol:MenOfGoodIntent a rpg:Creature ;
    rpg:name "Men of Good Intent" ;
    dc:description "Minor Spirits of Deceit, human-sized snakes with a man's head, who encourage spiritual laxity by peddling a single vice." ;
    skos:altLabel "Man of Good Intent" ;
