    rpg:hasTag amol:HermeticConcept .
amol:ThresholdFaerie a rpg:Creature ;
    rpg:name "Threshold faerie" ;
    dc:description "A faerie that mediates Eudokian stories governing a life transition and sends characters home with Spirit Away." ;
    skos:altLabel "Threshold faeries" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Thrones a rpg:Creature ;
    rpg:name "Thrones" ;
    dc:description "Angelic Choir of Camuel, Munkar and Nakir; pious kings are placed among them." ;
    skos:altLabel "Ofanim", "Throne" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Thrym a rpg:Character ;
    rpg:name "Thrym" ;
    dc:description "Villain of the Theft of Thor's Hammer, cited as an example of the villain role." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Tiber a schema:Place ;
    rpg:name "Tiber" ;
