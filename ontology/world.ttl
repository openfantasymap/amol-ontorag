amol:ForkedTongueOfTheSerpent a rpg:Tag ;
    skos:prefLabel "Forked Tongue of the Serpent" ;
    dc:description "Neqael's power making the target believe any lie until relating it to someone else." ;
    rpg:hasTag amol:HermeticConcept .
amol:FountainOfYouth a schema:Place ;
