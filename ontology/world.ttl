    dc:description "A Minor Illusion Mystery of the Followers of Pendule granting new spell Durations (Held, Midday/Midnight, Season, While/Not/If Condition) and recurring spell effects." ;
    skos:altLabel "Spell Timing (Minor Illusion Mystery)" ;
    rpg:hasTag amol:Virtue .
amol:SpellLikeVis a rpg:Tag ;
    skos:prefLabel "Spell-Like Vis" ;
    dc:description "Extraordinary vis mimicking a high-level spell, consumed at the end of the effect." ;
    rpg:hasTag amol:HermeticConcept .
amol:Spharios a rpg:Tag ;
    skos:prefLabel "Spharios" ;
    dc:description "The conscious sphere/mind of the universe at the moment of complete harmony, to which followers of the Path of Walking Backwards may ascend and rejoin in repose." ;
    skos:altLabel "Spahrios" ;
    rpg:hasTag amol:HermeticConcept .
amol:Spindle a rpg:Item ;
    rpg:name "Spindle" ;
    dc:description "Implement female magi carry to disguise magic items; has form and effect bonuses." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:SpiritForm a rpg:Spell ;
    rpg:name "Spirit Form" ;
    dc:description "A power (Vim) of the angels Nasir and Seferiel that lets them become a creature of pure spirit, unable to affect or be affected physically." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:SpiritOfTheRhine a rpg:Creature ;
    rpg:name "Spirit of the Rhine" ;
    dc:description "A powerful water elemental spirit of the Rhine, pinioned at the Rhinefalls by a giant's rock; Schwall has served it through Quests and plots to release it." ;
    skos:altLabel "Rhenus", "Rhine elemental", "Rhine spirit", "watery spirit" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:SpiritsOfSolomon a rpg:Creature ;
    rpg:name "Spirits of Solomon" ;
    dc:description "Seven female Deluder spirits named Deception, Strife, Battle, Envy, Power, Error and Corruption, once bound by Solomon, who inflict curses." ;
    skos:altLabel "Seven Spirits of Solomon" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:SpiritualAnchor a rpg:Tag ;
    skos:prefLabel "Spiritual Anchor" ;
    dc:description "A mundane object into which a faerie writes its glamour, around which its body agglomerates; it holds the faerie's vis." ;
    skos:altLabel "Anchor", "Anchored vis", "Anchors" ;
    rpg:hasTag amol:HermeticConcept .
amol:SpontaneousCastingTools a rpg:Tag ;
    skos:prefLabel "Spontaneous Casting Tools" ;
    dc:description "A Minor Hermetic Flaw in which the character must use casting tools to cast spontaneous spells, with 15 tools one for each Art; only available to Verditius magi." ;
    rpg:hasTag amol:Flaw .
amol:Spotless a rpg:Tag ;
    skos:prefLabel "Spotless" ;
    dc:description "A Free laboratory Outfittings Virtue: the lab is impeccably clean, requiring a season's work and maintenance (+1 Health, +1 Aesthetics, +1 Creo)." ;
    skos:altLabel "Spotless Virtue" ;
    rpg:hasTag amol:Virtue .
amol:SpreadingAMantleOfSnow a rpg:Tag ;
    skos:prefLabel "Spreading a Mantle of Snow" ;
    dc:description "Power coating the ground in ice and snow, used by the Cailleach Bheur and koerakoonlane war leaders." ;
    rpg:hasTag amol:HermeticConcept .
amol:SpringOfArtakia a schema:Place ;
    rpg:name "Spring of Artakia" ;
    dc:description "A spring near Artakia with a Magic aura of 2, the easiest site on Bear Island at which to found a covenant." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:StAmbrose a rpg:Character ;
    rpg:name "St Ambrose" ;
    dc:description "Wrote that Mary first saw the Resurrection; greater saint, patron of bishops, learning and bees." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:StJerome a rpg:Character ;
    rpg:name "St Jerome" ;
    dc:description "Churchman to whom some copies of the malleus epistula are attributed." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:StMatthew a rpg:Character ;
    rpg:name "St Matthew" ;
    dc:description "Apostle whose lost head-relic at St. Matthew's Point quells storms." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:StGildasDeRhuys a schema:Place ;
    rpg:name "St-Gildas-de-Rhuys" ;
