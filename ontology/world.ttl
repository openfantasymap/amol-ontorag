amol:Aura a rpg:Tag ;
    skos:prefLabel "Aura" ;
    dc:description "A regional concentration of one of the Realms of Power that affects magic within it; magic is opposed by both Divine and Infernal auras, and a covenant's Magical aura can fade or strengthen. A Dominion aura can spring up where holiness accumulates." ;
    skos:altLabel "Arcadia", "Arcadian forest", "Auras", "Courtly Faerie", "Courtly Faeries", "Daoine Sith", "Deep Arcadia", "Divine" ;
    rpg:hasTag amol:Realm .
amol:Warping a rpg:Tag ;
    skos:prefLabel "Warping" ;
    dc:description "The accumulation of Warping Points from exposure to supernatural power; gained from Realms, auras, Longevity Rituals, and miracles, and affected by Susceptibility to Warping and Raised from the Dead." ;
    skos:altLabel "Faerie Warping", "Infernal Warping", "Warped", "Warping Point", "Warping Points", "Warping Score", "Warping Scores", "Warping point" ;
    rpg:hasTag amol:HermeticConcept .
amol:Demon a rpg:Creature ;
    rpg:name "Demon" ;
