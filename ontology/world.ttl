amol:Radhanites a rpg:Faction ;
    rpg:name "Radhanites" ;
    dc:description "Jewish merchants; the Radhanite merchant template serves the Muqta' of Baghdad." ;
    skos:altLabel "Radhanite Merchant", "Radhanite merchant" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Raido a rpg:Proficiency ;
    rpg:name "Raido" ;
    dc:description "Elder Futhark rune \"Riding\" used as a vitkir Art. Rune of riding, journeys and travel, possibly invoking Thor; targets carts, ships, wheels and harnesses." ;
    skos:altLabel "Rad", "Reidh" ;
