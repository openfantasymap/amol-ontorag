    rpg:hasTag amol:FactionTag .
amol:Mazzikim a rpg:Creature ;
    rpg:name "Mazzikim" ;
    dc:description "Tempters of the wilderness, the harmers of man, shaped like wild animals standing on two legs with human chests; related to the shaitans." ;
    skos:altLabel "mazzik" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Meadow a rpg:Tag ;
    skos:prefLabel "Meadow" ;
    dc:description "Grassy plain between Kyzikos and the Thracian Harbor, holding King Kyzikos' tumulus with an Infernal aura 4." ;
    skos:altLabel "Leimonian Plain" ;
    rpg:hasTag amol:HermeticConcept .
amol:Mecklenburg a schema:Place ;
    rpg:name "Mecklenburg" ;
    dc:description "A region whose nobility still secretly come to Rethra to honor their god; its Slavic princes are drawn into the schemes of Radegast." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:MeddlingWithMundanes a rpg:Tag ;
    skos:prefLabel "Meddling with mundanes" ;
