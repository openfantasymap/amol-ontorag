amol:ShroudTheStenchOfThePit a rpg:Tag ;
    skos:prefLabel "Shroud the Stench of the Pit" ;
    dc:description "Godhead's power disguising his infernal powers and taint from Hermetic detection." ;
    rpg:hasTag amol:HermeticConcept .
amol:SideEffect a rpg:Tag ;
