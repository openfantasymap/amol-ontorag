    rpg:hasTag amol:FactionTag .
amol:DarkFaeries a rpg:Creature ;
    rpg:name "Dark faeries" ;
    dc:description "Malevolent faeries who care only that stories end in screaming and blood; can enter houses via holly invitation and hunt bean kings." ;
