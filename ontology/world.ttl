    dc:description "Sample vitkir rune spell. Naudiz (Ingwaz) 20, Method II: residents of a structure lose 1 Confidence." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheRunemasterCallsHisChildrenToHisSide a rpg:Spell ;
