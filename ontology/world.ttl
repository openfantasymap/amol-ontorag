    rpg:hasTag amol:Place .
amol:AncestorSite a rpg:Tag ;
    skos:prefLabel "Ancestor Site" ;
    dc:description "A place strongly resonating with shapechanging and the Magic Realm that serves House Bjornaer; the Wolf's Court could be one." ;
    rpg:hasTag amol:HermeticConcept .
amol:AnchoredToTheLand a rpg:Tag ;
    skos:prefLabel "Anchored to the (Land)" ;
    dc:description "A Minor General Flaw: the character suffers loneliness and a -3 penalty when traveling through any environment other than a particular favored one." ;
    rpg:hasTag amol:Flaw .
amol:Anchorhold a schema:Place ;
    rpg:name "Anchorhold" ;
    dc:description "The cell of an anchoress, usually attached to a church with a window onto the altar and another onto the street." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:AncreneRiwle a rpg:Item ;
    rpg:name "Ancrene Riwle" ;
    dc:description "The anchoress' rule, written in England in the early 13th century for three anchoresses, based on monastic rules but adapted to the anchoress' enclosed life." ;
    skos:altLabel "Anchoress' Rule", "Riwle" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:Andresina a schema:Place ;
    rpg:name "Andresina" ;
    dc:description "A ruined and abandoned Roman city southwest of Toul with a great temple to Apollo and a Magic aura of 2, a possible covenant site." ;
