    rpg:hasTag amol:NamedSpell .
amol:Aldico a rpg:Character ;
    rpg:name "Aldico" ;
    dc:description "Primus of Mercere during the Schism War who helped negotiate peace." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Alectryomancy a rpg:Tag ;
    skos:prefLabel "Alectryomancy" ;
