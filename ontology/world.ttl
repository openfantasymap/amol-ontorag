    skos:altLabel "House of Augustus", "Virgilian", "the Brotherhood" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Augustina a rpg:Character ;
    rpg:name "Augustina" ;
    dc:description "Ragoneda's apprentice of eight years, a bone maga working in Animál who seeks adventure." ;
    skos:altLabel "Augustina of Confluensis", "Augustina of Tytalus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:AugustinianCanons a rpg:Faction ;
    rpg:name "Augustinian Canons" ;
    dc:description "Regular canons following the Rule of St. Augustine of Hippo who, unlike monks, are not sequestered from the world and undertake pastoral duties." ;
    skos:altLabel "Augustinians", "Black Canons", "Regular canons" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Auvergne a schema:Place ;
    rpg:name "Auvergne" ;
    dc:description "Upland region in eastern Aquitaine where Atsingani currently camps and where the Capuchonnes massacred brigands." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Avarret a rpg:Character ;
    rpg:name "Avarret" ;
    dc:description "Magus elevated to Primus of House Bonisagus in 1191, returning the House to conservative refinement of Hermetic theory; selected Murion as successor before Final Twilight." ;
    skos:altLabel "Avarret of Bonisagus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:AventineHill a schema:Place ;
    rpg:name "Aventine Hill" ;
    dc:description "Hill in Rome near which Bonisagus found a cache of Cult of Mercury rituals." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:AverseToRisk a rpg:Tag ;
    skos:prefLabel "Averse to Risk" ;
    dc:description "A Minor Ordeal Flaw making a Verditius magus reluctant to undertake risky laboratory activities, forbidding experimentation; incompatible with Prone to Chance." ;
    skos:altLabel "Adverse to Risk" ;
    rpg:hasTag amol:Flaw .
amol:AwakenedTrees a rpg:Creature ;
    rpg:name "Awakened Trees" ;
    dc:description "Trees in Magic auras that are aware and capable of limited movement; at aura 6+ they are fully awake, having Cunning but no Might." ;
    skos:altLabel "Awakened Tree" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:BaAlOv a rpg:Faction ;
    rpg:name "Ba'al Ov" ;
    dc:description "Ancient Jewish summoners and necromancers, 'spirit borrowers', considered the first sorcerers." ;
    skos:altLabel "Meonen", "Sho'elim 'ov", "sho'el 'ov", "spirit borrowers", "spirit consulters" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:BaalPeorLordOfFilth a rpg:Creature ;
    rpg:name "Baal-Peor, Lord of Filth" ;
    dc:description "A demon of wealth and filth (Might 30, Corpus) who creates discord by moving mortal riches disruptively, sprays noxious vomit, and was worshipped as an embodiment of the desire to consume and defile." ;
    skos:altLabel "Baal-Peor", "Belphegor", "Lord of Filth", "Lord of the Openings", "Treasurer of Hell" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:BaiocassiumMinor a rpg:Faction ;
    rpg:name "Baiocassium Minor" ;
    dc:description "Lost Diedne vassal covenant rumored to lie in a regio within the town of Bayeux." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:Bamberg a schema:Place ;
    rpg:name "Bamberg" ;
    dc:description "A bishopric city elevated by Henry II and built on seven hills to rival Rome; its main export is beer, with over a dozen breweries including the ancient Bierhaus." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Bamburgh a schema:Place ;
    rpg:name "Bamburgh" ;
    dc:description "Heavily garrisoned English fortress, former capital of Bernicia and Northumbria, whose constable holds wardship over the Farne Islands." ;
    skos:altLabel "Bamburgh Castle" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Banishing a rpg:Tag ;
    skos:prefLabel "Banishing" ;
    dc:description "A Major Supernatural Accelerated Ability of the Donatores that banishes any creature with a Might score from a designated area for a time; aligned with the Divine for the Donatores but possible with any realm." ;
    rpg:hasTag amol:Virtue .
amol:Barcelona a schema:Place ;
    rpg:name "Barcelona" ;
    dc:description "County ruled by the same family as Provence, which claims to inherit the ancient margraviate." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Bard a rpg:Tag ;
    skos:prefLabel "Bard" ;
    dc:description "A Free Social Status Virtue for a graduate of a Hibernian bardic school at the rank of Dos, with a Local Reputation among the Irish." ;
    skos:altLabel "Bard/Olamh", "Olamh", "Rard", "fili" ;
    rpg:hasTag amol:Virtue .
amol:BarkingBeast a rpg:Creature ;
    rpg:name "Barking Beast" ;
    dc:description "Faerie beast that lives to be hunted, with the body of a leopard and a baying of hounds from its belly; the greatest test of a hunter's skill." ;
    skos:altLabel "Questing Beast" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:BattleOfBouvines a rpg:Tag ;
    skos:prefLabel "Battle of Bouvines" ;
    dc:description "1214 battle where Philip won and captured Count Ferdinand of Flanders." ;
    rpg:hasTag amol:HermeticConcept .
amol:BavarianCommon a schema:Place ;
    rpg:name "Bavarian Common" ;
    dc:description "The collective vis sources of the fallen covenant Highest Aspiration, harvested under Quaesitor oversight and divided annually among Alpine covenants." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:BeastMasters a rpg:Faction ;
    rpg:name "Beast Masters" ;
    dc:description "An Ex Miscellanea tradition whose apprentices are abandoned in the wilderness and develop the Summon Animals Virtue, Animal Ken, and a Minor Magical Focus with a specific group of animals." ;
    rpg:inWorld amol:MythicEurope ;
