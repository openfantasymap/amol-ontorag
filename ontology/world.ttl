amol:ThePathOfStrife a rpg:Tag ;
    skos:prefLabel "The Path of Strife" ;
    dc:description "The Criamon path of worldly magic that transgresses House morality; its servants kill, lie, and destroy demons to prolong the universe, and they cannot enter Final Twilight." ;
    rpg:hasTag amol:HermeticConcept .
amol:ThePathOfTheMirror a rpg:Tag ;
    skos:prefLabel "The Path of the Mirror" ;
    dc:description "The Criamon path followed only by living Primi under instruction of their predecessors, a series of Initiations for those who choose to serve the worldly House." ;
    rpg:hasTag amol:HermeticConcept .
amol:ThePawnbrokers a rpg:Faction ;
    rpg:name "The Pawnbrokers" ;
    dc:description "Societas Merceris of Redcaps who harvest vis into custom shapes such as tokens, coins, jewelry or tattoos, named in memory of Venafro." ;
