    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Tiberius a rpg:Character ;
    rpg:name "Tiberius" ;
    dc:description "Younger noble son guided by a demon posing as his grandfather's ghost, designed by Valefar as a snare for magi." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:TicklingTheHumors a rpg:Spell ;
    rpg:name "Tickling the Humors" ;
