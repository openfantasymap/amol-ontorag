    rpg:hasTag amol:HermeticConcept .
amol:AlexanderIII a rpg:Character ;
    rpg:name "Alexander III" ;
    dc:description "Pope (1159-81) during whose pontificate a priest was suspended for calling up a demon." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:AlexanderTheGreat a rpg:Character ;
    rpg:name "Alexander the Great" ;
    dc:description "Conqueror reminded he was not a god; a past life of the Blessed One." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Alfar a rpg:Creature ;
    rpg:name "Alfar" ;
    dc:description "Beings referenced in the rune spell for sensing vis." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:AlfonsoTheWise a rpg:Character ;
    rpg:name "Alfonso the Wise" ;
    dc:description "King of Castile and Leon, credited with writing a lapidary." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:AlfredTheGreat a rpg:Character ;
    rpg:name "Alfred the Great" ;
    dc:description "King of Wessex from 871 who drove back the Danes, established defensive burhs, and was a learned translator; subject of the legend of the burnt cakes." ;
    skos:altLabel "Alfred" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:AlignedAura a rpg:Tag ;
    skos:prefLabel "Aligned Aura" ;
    dc:description "A Magic aura with a special aspect, such as enhancing an emotion or aligning with a Hermetic Art, discernible by Intellego Vim." ;
    skos:altLabel "Creo aligned aura" ;
    rpg:hasTag amol:HermeticConcept .
amol:Allod a rpg:Tag ;
    skos:prefLabel "Allod" ;
    dc:description "Land held by descent from time immemorial rather than from a superior. Its holders need not swear fealty, and some covenants claim it." ;
    skos:altLabel "Allodial land", "allodial land" ;
    rpg:hasTag amol:HermeticConcept .
amol:Almohads a rpg:Faction ;
    rpg:name "Almohads" ;
    dc:description "Current rulers of Muslim Spain and North Africa, whose doctrine blends Sunni, Shi'i and Mu'tazili elements; founded by Ibn Tumart." ;
    skos:altLabel "Almohad" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Alsia a rpg:Character ;
    rpg:name "Alsia" ;
    dc:description "One of Merinita's first apprentices who later joined Quendalon and developed a spell allowing those with Faerie Magic to temporarily bind a familiar." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:AmBalla a rpg:Creature ;
    rpg:name "Am Balla" ;
    dc:description "Being at Crun Clach who will gladly make stone containers for potions, provided the potions do not stain or corrode the rock." ;
    skos:altLabel "Balla", "The Wall" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Amazonia a schema:Place ;
    rpg:name "Amazonia" ;
    dc:description "Territory of the Amazons whose fall is imagined in a story seed." ;
    skos:altLabel "Land of the Amazons" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Amazons a rpg:Faction ;
    rpg:name "Amazons" ;
    dc:description "Warrior sorceresses from Amazonia described in Rival Magic whose tales reach the Order; in a story seed they join House Flambeau." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:AmbrosiusOfMerinita a rpg:Character ;
    rpg:name "Ambrosius of Merinita" ;
    dc:description "Son of the seer Emrys, adopted as Quendalon's apprentice; of strong faerie heritage, he became a master of symbolic prediction and founder of the Heirs to Merlin lineage." ;
    skos:altLabel "Ambrosius" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:AmbushOnTheDesertedRoad a rpg:Spell ;
    rpg:name "Ambush on the Deserted Road" ;
    dc:description "A PeIm 20 transparency spell that destroys the species a group emits in one direction, making a traveling party invisible from the direction of those they wish to ambush." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Amorphous a rpg:Tag ;
    skos:prefLabel "Amorphous" ;
    dc:description "Major or Minor Supernatural Tainted Virtue letting the character take any non-specific human form, as his body has the almost-gaseous property of demonic flesh." ;
    rpg:hasTag amol:Virtue .
amol:AnEveningSIllumination a rpg:Spell ;
    rpg:name "An Evening's Illumination" ;
    dc:description "A cantation (low-level formulaic spell for apprentices) listed in the book's contents." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Anatolia a schema:Place ;
    rpg:name "Anatolia" ;
    dc:description "Region where Dindyméné is called Kubaba; also a suggested location for the Cursewood in the Theban variant." ;
