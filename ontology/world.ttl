amol:MarieOfFrance a rpg:Character ;
    rpg:name "Marie of France" ;
    dc:description "Poet who versified the tale of the knight Owein's journey through purgatory." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:MarieOfOignes a rpg:Character ;
    rpg:name "Marie of Oignes" ;
    dc:description "One of the founders of the beguine movement (1176-1213), a mystic who lived in poverty near the priory of Oignes, conversed with her guardian angel and had insight into the hearts of others." ;
    skos:altLabel "Marie" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:MarketGuild a rpg:Faction ;
    rpg:name "Market Guild" ;
    dc:description "Guild of faerie merchants that sets and enforces the Devil's Lane market rules through a council." ;
    skos:altLabel "guild council" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Marriage a rpg:Tag ;
    skos:prefLabel "Marriage" ;
    dc:description "Sacrament joining two people against temptation, granting both a Faith Point and a holy connection." ;
    rpg:hasTag amol:HermeticConcept .
amol:Martigny a schema:Place ;
    rpg:name "Martigny" ;
    dc:description "Site of the Queen of the Herd festival." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Masks a rpg:Tag ;
    skos:prefLabel "Masks" ;
    dc:description "Mundane allies through which covenants act to avoid charges of meddling." ;
    skos:altLabel "mask" ;
    rpg:hasTag amol:HermeticConcept .
amol:MasterBard a rpg:Tag ;
    skos:prefLabel "Master Bard" ;
    dc:description "A Major Social Status Virtue for a character who has spent at least nine years at an Irish bardic school and is a master of the trade, called an Anruth." ;
    skos:altLabel "Anruth" ;
    rpg:hasTag amol:Virtue .
amol:MasterOfAnimalCreatures a rpg:Tag ;
    skos:prefLabel "Master of Animal Creatures" ;
    dc:description "A Virtue the She-Wolf uses to train the magical wolves of the Majarida." ;
    rpg:hasTag amol:Virtue .
amol:MasterOfKennels a rpg:Tag ;
    skos:prefLabel "Master of Kennels" ;
    dc:description "A Minor Social Status Virtue for a character who manages the kennels of a noble patron, responsible for training, breeding, and health of the dogs." ;
    rpg:hasTag amol:Virtue .
amol:MasterOfSkills a rpg:Tag ;
    skos:prefLabel "Master of Skills" ;
    dc:description "Faeries that seek out mortals at the peak of their profession to raise them up or cast them down, having the disputed Ability as a Pretense of at least 9." ;
    rpg:hasTag amol:CharacterType .
amol:Masterpiece a rpg:Tag ;
    skos:prefLabel "Masterpiece" ;
    dc:description "A Minor Hermetic Virtue allowing a Verditius magus to keep the lesser enchanted item he made to pass his Gauntlet, with vis costs ignored." ;
    rpg:hasTag amol:Virtue .
amol:MasteryPoints a rpg:Tag ;
    skos:prefLabel "Mastery points" ;
    dc:description "Points spent to improve a power's Initiative, Might cost or related Abilities." ;
    rpg:hasTag amol:HermeticConcept .
amol:MateosTheFaerieButler a rpg:Creature ;
    rpg:name "Mateos, the Faerie Butler" ;
    dc:description "A child-sized faerie (Might 10, Herbam) who lives for drunken parties, serving intoxicating drinks from an endless barrel and encouraging people to embarrass themselves." ;
    skos:altLabel "Mateos" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:MaterialAnchor a rpg:Spell ;
    rpg:name "Material Anchor" ;
    dc:description "Spirit power used to mark prey and intentionally form Arcane Connections; used by the Erinnyes." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:MathematicusOfBologna a rpg:Tag ;
    skos:prefLabel "Mathematicus of Bologna" ;
    dc:description "Free Social Status marking membership in the Mathematici tradition; requires a Hedge Technique and Form and a mundane Social Status." ;
    rpg:hasTag amol:Virtue .
amol:Mathematikoi a rpg:Tag ;
    skos:prefLabel "Mathematikoi" ;
    dc:description "The Inner Order of the Fraternity of Samos, robed in black or white, who abstain from meat and beans and must teach new Initiates." ;
    skos:altLabel "Inner Order" ;
    rpg:hasTag amol:CharacterType .
amol:MathieusOfConstantinople a rpg:Character ;
    rpg:name "Mathieus of Constantinople" ;
    dc:description "A contemporary House Jerbiton Archmagus trained in Constantinople but long resident in Paris, who gave up the study of magic but grew more active after Constantinople's fall." ;
    skos:altLabel "Archmagus Mathieus", "Mathieus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:MattieusOfCherson a rpg:Character ;
    rpg:name "Mattieus of Cherson" ;
    dc:description "A historically important twelfth-century Primus of House Jerbiton who believed Jerbiton magi should serve as ambassadors to the mundanes." ;
    skos:altLabel "Mattieus", "Mattieus the twelfth-century Primus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:MaximianusOfBonisagus a rpg:Character ;
    rpg:name "Maximianus of Bonisagus" ;
    dc:description "An ancient, widely respected Bonisagus master of Corpus magic and prolific author who founded Nigrasaxa to break the cycle of invalid tribunals." ;
    skos:altLabel "Maximianus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:MayDayEve a rpg:Tag ;
    skos:prefLabel "May Day Eve" ;
    dc:description "Night when magi retreat behind Aegises due to peasant purification festivals able to Hex magi." ;
    rpg:hasTag amol:HermeticConcept .
amol:MazdeanPriest a rpg:Tag ;
    skos:prefLabel "Mazdean Priest" ;
    dc:description "A Minor Social Status Virtue for an ordained Mazdean priest, initiated as a mobed, who performs Zoroastrian rituals and tends sacred fires." ;
    skos:altLabel "mobed" ;
    rpg:hasTag amol:Virtue .
amol:Mazzeru a rpg:Faction ;
    rpg:name "Mazzeru" ;
    dc:description "Corsican nightwalker tradition that fights with asphodel and is compelled to hunt in dreams, killing animals representing villagers destined to die." ;
    skos:altLabel "Mazzeri" ;
