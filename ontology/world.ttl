    rpg:hasTag amol:Virtue .
amol:Ephesus a schema:Place ;
    rpg:name "Ephesus" ;
    dc:description "A site in the Theban Tribunal holding a statue of Diana that Huntress initiates may anoint with sacred oil during the Eumolpid initiation." ;
    skos:altLabel "Epheseus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Eremite a rpg:Tag ;
    skos:prefLabel "Eremite" ;
    dc:description "Major Supernatural Flaw: exploring the divine alone, unable to learn Supernatural Abilities from any tradition; requires True Faith." ;
    skos:altLabel "eremites" ;
    rpg:hasTag amol:CharacterType .
amol:EssentialVirtue a rpg:Tag ;
    skos:prefLabel "Essential Virtue" ;
    dc:description "Virtue granting a beneficial Essential Trait; every Beast of Virtue must take one to represent how it typifies its species." ;
    rpg:hasTag amol:Virtue .
amol:Eve a rpg:Character ;
    rpg:name "Eve" ;
    dc:description "The first woman, whom Satan caused to eat the forbidden fruit, bringing about man's fall." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:ExceptionalTalent a rpg:Tag ;
    skos:prefLabel "Exceptional Talent" ;
