amol:SummoningTheDistantImages a rpg:Spell ;
    rpg:name "Summoning the Distant Images" ;
    dc:description "Spell (InIm 35) known by Amberitus." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:SunderingOfHouseTremere a rpg:Tag ;
    skos:prefLabel "Sundering of House Tremere" ;
    dc:description "Historical punishment of House Tremere questioned by Children of Hermes." ;
    rpg:hasTag amol:HermeticConcept .
amol:SunderingOfTremere a rpg:Tag ;
    skos:prefLabel "Sundering of Tremere" ;
    dc:description "An event that reduced House Tremere's power, after which Blackthorn's influence in the tribunal was diminished." ;
    skos:altLabel "the Sundering" ;
    rpg:hasTag amol:HermeticConcept .
amol:SuperbScrinium a rpg:Item ;
    rpg:name "Superb Scrinium" ;
    dc:description "An enchanted walnut writing desk that copies and binds an entire book in hours." ;
    skos:altLabel "Scrinium" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:SuperiorArmaments a rpg:Tag ;
    skos:prefLabel "Superior Armaments" ;
