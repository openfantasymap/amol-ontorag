    rpg:hasTag amol:Place .
amol:StAndrews a schema:Place ;
    rpg:name "St. Andrews" ;
    dc:description "Bishopric whose bishop is primate of the Church in Scotland." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:StBenedict a rpg:Character ;
    rpg:name "St. Benedict" ;
