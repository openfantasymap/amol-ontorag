    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:TheApprenticeSDelight a rpg:Spell ;
    rpg:name "The Apprentice's Delight" ;
    dc:description "CrHe 3 cantation that creates a ripe apple lasting two minutes, sweet but not nourishing." ;
