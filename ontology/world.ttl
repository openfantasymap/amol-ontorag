    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticArt .
amol:TalhaearnTadAwen a rpg:Character ;
    rpg:name "Talhaearn Tad Awen" ;
    dc:description "One of the five great Welsh poets believed by the Order to have left Daimons behind after death." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Taliesin a rpg:Character ;
    rpg:name "Taliesin" ;
    dc:description "One of the five great Welsh poets believed by the Order to have left Daimons behind after death." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Tallage a rpg:Tag ;
    skos:prefLabel "Tallage" ;
    dc:description "A lord's levy on his peasants, described in Chapter Six: Manorial Fiefs; lords demanded heavy tallage to fund crusades." ;
    rpg:hasTag amol:HermeticConcept .
amol:TalonsOfTheWind a rpg:Spell ;
    rpg:name "Talons of the Wind" ;
    dc:description "MuAu 20 Potent spell, Potency 8, fan made from ship's sail." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TalonsOfTheWinds a rpg:Spell ;
    rpg:name "Talons of the Winds" ;
    dc:description "A Muto Auram spell (Level 20) that transforms a wind into an abrasive medium that tears at everything in its path, inflicting +4 damage from cuts; requires an existing breeze." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TamedMagic a rpg:Tag ;
    skos:prefLabel "Tamed Magic" ;
    dc:description "Major Hermetic Virtue granting Harnessed and Tethered Magic without drawbacks, usable with spontaneous spells; requires Mutantum Magic." ;
    rpg:hasTag amol:Virtue .
amol:TamgorOfQuaesitor a rpg:Character ;
    rpg:name "Tamgor of Quaesitor" ;
    dc:description "Quaesitor who journeyed through the Roman Tribunal's covenants to gather information ahead of Jarane's triad, recording his findings in a journal." ;
    skos:altLabel "Tamgor" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Tanaiste a rpg:Tag ;
    skos:prefLabel "Tanaiste" ;
    dc:description "Heir-designate of a Highland clan chief, held by Raibert Mac Donncadh." ;
    skos:altLabel "Tanist", "tanist" ;
    rpg:hasTag amol:HermeticConcept .
amol:Tanakh a rpg:Item ;
    rpg:name "Tanakh" ;
    dc:description "The Hebrew Bible, comprising Torah, Nevi'im and Ketuvim." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TangentialMagi a rpg:Tag ;
    skos:prefLabel "Tangential Magi" ;
    dc:description "Criamon magi who have faded peacefully into Final Twilight and dwell in the Hypostasis outside time, sending visions through the Axis to their mortal successors." ;
    skos:altLabel "tangential immortal", "the tangential" ;
    rpg:hasTag amol:CharacterType .
amol:TangleOfWoodAndThorns a rpg:Spell ;
    rpg:name "Tangle of Wood and Thorns" ;
    dc:description "A Rego Herbam (ReHe 15) indirect spell that immobilizes a magus with wood without touching him, completely effective in bypassing Magic Resistance." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Tartessos a schema:Place ;
    rpg:name "Tartessos" ;
    dc:description "An ancient rich port at the edge of the world whose faerie gods may rouse when a new rich port is built." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Tatzelwurmli a rpg:Creature ;
    rpg:name "Tatzelwurmli" ;
    dc:description "Monstrous limbless land dragon in the Aare Gorge whose lair no covenant can harvest." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:TeachingSourceQuality a rpg:Tag ;
    skos:prefLabel "Teaching Source Quality" ;
    dc:description "Communication + Teaching + 3 + bonuses; compared to a Target Level when teaching a Hermetic Virtue." ;
    rpg:hasTag amol:HermeticConcept .
amol:TeethOfTheEarthMother a rpg:Spell ;
    rpg:name "Teeth of the Earth Mother" ;
    dc:description "A Muto Terram spell that springs twenty sharp white marble pillars from the ground in a circle, able to cage, wall, or skewer enemies for +25 damage." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TemenosOfDindymN a schema:Place ;
    rpg:name "Temenos of Dindyméné" ;
    dc:description "A sacred grove atop Mount Dindymon ringed by oaks and chestnuts, with a Magic aura of 3, leading to both a Faerie and a Magic regio." ;
    skos:altLabel "Sacred Grove", "temenos" ;
