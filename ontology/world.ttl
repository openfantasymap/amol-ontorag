    rpg:hasTag amol:Creature .
amol:ReducedPower a rpg:Tag ;
    skos:prefLabel "Reduced Power" ;
    dc:description "Minor Supernatural Flaw subtracting 5 intricacy points from a faerie's powers." ;
    rpg:hasTag amol:Flaw .
amol:Refining a rpg:Proficiency ;
    rpg:name "Refining" ;
    dc:description "Elementalist Technique taking a season of lab-like work to purify or break down a target, often yielding raw vis." ;
