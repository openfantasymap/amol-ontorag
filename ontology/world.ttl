    rpg:name "Dog of Virtue" ;
    dc:description "A magical dog that may heal wounds by licking them; its body parts are useful in warding." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Doge a rpg:Tag ;
    skos:prefLabel "Doge" ;
