    rpg:hasTag amol:Place .
amol:MengalazTheRat a rpg:Creature ;
    rpg:name "Mengalaz the Rat" ;
    dc:description "Bartholomew's faerie rat familiar, leader of the rat pack." ;
    skos:altLabel "Mengalaz" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:MerchantAdventurer a rpg:Tag ;
