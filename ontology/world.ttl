    rpg:hasTag amol:MagicItem .
amol:ThePerilOfPhoebos a rpg:Item ;
    rpg:name "The Peril of Phoebos" ;
    dc:description "Tractatus on Ignem by Perpauca Bonisagi." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:ThePerilousForest a schema:Place ;
    rpg:name "The Perilous Forest" ;
