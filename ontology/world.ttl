    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:ThePenitentSConfession a rpg:Spell ;
    rpg:name "The Penitent's Confession" ;
    dc:description "ReMe 30 spell compelling the target to relate his involvement truthfully; counts as scrying and causes warping." ;
