    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Tireless a rpg:Tag ;
    skos:prefLabel "Tireless" ;
    dc:description "Virtue or creature Quality listed for a being (Anne, Minerva Sulis, Balneator) or setting feature described here." ;
    rpg:hasTag amol:Virtue .
amol:Tithe a rpg:Tag ;
    skos:prefLabel "Tithe" ;
    dc:description "One tenth of everything a person gets, owed to the Church; divided traditionally into quarters for rector, curate, church fabric and the poor, effectively taking twenty percent of peasant income." ;
    skos:altLabel "Tithes" ;
