    rpg:hasTag amol:HermeticConcept .
amol:TheInexorableHunter a rpg:Item ;
    rpg:name "The Inexorable Hunter" ;
    dc:description "A magical power of the Virtuous Hound (Animal, 2 points) allowing it to flawlessly follow a creature's scent until it is located, despite the prey's ruses." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
