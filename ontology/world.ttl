    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:StandardOfTheShadowyMen a rpg:Item ;
    rpg:name "Standard of the Shadowy Men" ;
    dc:description "Jerbiton item creating Group Seven League Stride, invisibility and grog enhancements, used against the Fanes." ;
