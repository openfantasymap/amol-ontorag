# 3780 extracted entities

amol:Aura a rpg:Tag ;
    skos:prefLabel "Aura" ;
    dc:description "A regional concentration of one of the Realms of Power that affects magic within it; magic is opposed by both Divine and Infernal auras, and a covenant's Magical aura can fade or strengthen. A Dominion aura can spring up where holiness accumulates." ;
    skos:altLabel "Arcadian forest", "Auras", "Divine", "Divine Aura", "Divine Might", "Divine Power", "Divine Powers", "Divine Realm" ;
    rpg:hasTag amol:Realm .
amol:Warping a rpg:Tag ;
    skos:prefLabel "Warping" ;
    dc:description "The accumulation of Warping Points from exposure to supernatural power; gained from Realms, auras, Longevity Rituals, and miracles, and affected by Susceptibility to Warping and Raised from the Dead." ;
    skos:altLabel "Warped", "Warping Point", "Warping Points", "Warping Score", "Warping Scores", "Warping point", "Warping points" ;
    rpg:hasTag amol:HermeticConcept .
amol:SecondSight a rpg:Tag ;
    skos:prefLabel "Second Sight" ;
    dc:description "A supernatural Ability for seeing through illusions and the supernatural; True Sight Criamon magi may use Enigmatic Wisdom as if it were Second Sight, and spectral travelers can be seen by it." ;
    skos:altLabel "Second Sight Virtue" ;
    rpg:hasTag amol:Virtue .
amol:ArtesLiberales a rpg:Proficiency ;
    rpg:name "Artes Liberales" ;
    dc:description "An academic Ability covering the liberal arts (including the specialty of Rhetoric) favored by the Sophists; used as an Attack Ability in debate and taught to Tytalan apprentices." ;
    skos:altLabel "liberal arts", "seven liberal arts", "the seven liberal arts" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:Durenmar a rpg:Faction ;
    rpg:name "Durenmar" ;
    dc:description "A leading Rhine covenant in the Black Forest that sponsors new covenants; it offered resources to bring Roznov into the Rhine, its leadership decides to recolonize the Rhine Gorge, and its Forum hosts initiations into the Order." ;
    skos:altLabel "Durenmar Collection", "Durenmar Library", "Great Library", "Great Library of Durenmar", "The Tower of Bonisagus", "the Great Library", "the Oldest Covenant" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:MinorMagicalFocus a rpg:Tag ;
    skos:prefLabel "Minor Magical Focus" ;
    dc:description "A Hermetic Virtue narrowing and strengthening a magus's magic; the range of a Supernatural Ability is meant to approximate one, and it is required for the Beast Masters tradition." ;
    skos:altLabel "Magical Foci", "Magical Focus", "Major Magical Focus", "Major Magical Focus in illusions", "Major Magical Focus with Faerie", "Major Magical Focus with Familiars", "Minor Magical Focus (Healing)", "Minor Magical Focus (Swords)" ;
    rpg:hasTag amol:Virtue .
amol:Skinchanger a rpg:Tag ;
    skos:prefLabel "Skinchanger" ;
    dc:description "A Virtue gained by stronger supernatural members of werewolf families (often women/witches), granting shapeshifting plus other magical abilities; Bjornaer the Founder was one such witch." ;
    skos:altLabel "Shapeshift", "Shapeshifter", "Shapeshifter Virtue", "Skinchanger Virtue" ;
    rpg:hasTag amol:Virtue .
amol:SchismWar a rpg:Tag ;
    skos:prefLabel "Schism War" ;
    dc:description "A Hermetic war (also called the Sundering/Domination) during which a pagan-filled House was annihilated and a tyrannical House (Tremere) was shattered; House Jerbiton withdrew and later aided reconstruction." ;
    skos:altLabel "Sundering, The", "the Schism", "the Sundering" ;
    rpg:hasTag amol:HermeticConcept .
amol:CultOfMercury a rpg:Faction ;
    rpg:name "Cult of Mercury" ;
    dc:description "An ancient cult whose powerful rituals are sought as Hermetic treasures; a fallen temple of Mercury still contains details of some of its rituals, and recovering its lost rituals can be an object of a quest." ;
    skos:altLabel "Hermetic Cult of Mercury", "Mercurian", "Mercurian Ritual", "Mercurian priests", "Mercurian rituals", "Mercurians", "Order of Mercury", "Roman Cult of Mercury" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:GrandTribunal a rpg:Faction ;
    rpg:name "Grand Tribunal" ;
    dc:description "The supreme Tribunal of the Order of Hermes that can modify the Code as practiced in all Tribunals; it ended the Tytalus-Flambeau conflict in 1063 and sponsored joint covenants." ;
    skos:altLabel "Grand", "Grand Tribunal meetings", "Grand Tribunal of 1228", "Grand Tribunals" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Tribunal .
amol:HouseDiedne a rpg:Faction ;
    rpg:name "House Diedne" ;
    dc:description "One of the Twelve Founders, a woman cast out from the druid religion, who brought spontaneous magic to Bonisagus and founded House Diedne; in modern accounts her name is sometimes replaced with Trianoma's." ;
    skos:altLabel "Diedne", "Díedne", "House Díedne" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:HermeticHouse .
amol:Philosophiae a rpg:Proficiency ;
    rpg:name "Philosophiae" ;
