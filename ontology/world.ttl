    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:SpellFoci a rpg:Tag ;
    skos:prefLabel "Spell Foci" ;
    dc:description "A Minor Hermetic Virtue letting a rustic magus incorporate a small casting tool into spells to add a shape/material bonus to the Casting Total." ;
    skos:altLabel "Spell Focus", "spell focus" ;
    rpg:hasTag amol:HermeticConcept .
amol:StCuthbert a rpg:Character ;
    rpg:name "St. Cuthbert" ;
    dc:description "A saint whose shrine is at Durham cathedral; in a vision he told Godric to settle at Finchale near Durham, and pilgrims visit Godric's shrine as part of visiting Cuthbert's." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:StDenis a rpg:Character ;
    rpg:name "St. Denis" ;
    dc:description "Third-century missionary to Paris beheaded at Montmartre; patron saint of France." ;
    skos:altLabel "Denis", "Saint Denis" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:StPatrick a rpg:Character ;
    rpg:name "St. Patrick" ;
    dc:description "A holy man who came from Ireland to Glastonbury and was made abbot, bringing the monks under a rule of life just before the time of Arthur." ;
    skos:altLabel "Patrick" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Stentorius a rpg:Character ;
    rpg:name "Stentorius" ;
    dc:description "A powerful older House Tremere Archmagus, leader of Fengheld in the Rhine Tribunal, who holds three-fifths of the Tremere sigils there and commands the House in that Tribunal." ;
    skos:altLabel "Archmage Stentorius", "Archmagus Stentorius", "Stentorius of Fengheld", "Stentorius of Tremere", "Stentorius, Follower of Tremere" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:StrongWilled_2 a rpg:Tag ;
    skos:prefLabel "Strong Willed" ;
    dc:description "A Virtue gained through Clan Sirnas's Trial of Self Control, alongside Deleterious Circumstances when hungry." ;
    rpg:hasTag amol:Virtue .
amol:Succubus a rpg:Creature ;
    rpg:name "Succubus" ;
    dc:description "An Infernal entity that sometimes poses as a faerie partner, making intercourse with it worse than the mortal sin of faerie bestiality." ;
    skos:altLabel "Incubi", "Incubi and Succubae", "Incubus", "Succubae", "incubus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Summoner a rpg:Tag ;
    skos:prefLabel "Summoner" ;
    dc:description "A Mythic Companion versed in the Goetic Art of Summoning, often living as a hermit with ghostly servants and a ghostly warder." ;
    skos:altLabel "Apparitor" ;
    rpg:hasTag amol:CharacterType .
amol:SupernaturalBeauty a rpg:Tag ;
    skos:prefLabel "Supernatural Beauty" ;
    dc:description "A Major Supernatural Virtue of mystical beauty that calls royal power, folk magic, and heroism to its defense, letting the player request a fortunate coincidence once per story." ;
    rpg:hasTag amol:Virtue .
amol:SusceptibleToDivinePower a rpg:Tag ;
    skos:prefLabel "Susceptible to Divine Power" ;
    dc:description "Flaw appearing in character statistics or rules in this text." ;
    rpg:hasTag amol:Flaw .
amol:Taltos a rpg:Faction ;
    rpg:name "Taltos" ;
    dc:description "Wizards among the Magyar people of Hungary who use herbcraft to boost their physical characteristics and martial skills and to heal; many have Skinchanger; a Pharmocopoeian variant." ;
    skos:altLabel "Taltós" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:TasteOfTheSpicesAndHerbs a rpg:Spell ;
    rpg:name "Taste of the Spices and Herbs" ;
    dc:description "A Muto Imaginem spell (Level 5) that makes a setting's worth of food or drink taste and smell exactly as the caster designates." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Temper a rpg:Tag ;
    skos:prefLabel "Temper" ;
    dc:description "A particular aspect of the divine invoked into a Dominion aura as a Personality Trait, aiding compatible acts and hindering opposed ones." ;
    skos:altLabel "Aura Temper" ;
    rpg:hasTag amol:HermeticConcept .
amol:Temperate a rpg:Tag ;
    skos:prefLabel "Temperate" ;
    dc:description "Flaw typical of Ikhwan as-Safa' or Tulab Ibn Sina members owing to their devotion." ;
    rpg:hasTag amol:Flaw .
amol:TemporaryMight a rpg:Tag ;
    skos:prefLabel "Temporary Might" ;
    dc:description "Magic Inferiority always possessed by Magic Things: spent Might recovers slowly and injury separates Might as vis." ;
    rpg:hasTag amol:Flaw .
amol:TheBalticSea a schema:Place ;
    rpg:name "The Baltic Sea" ;
    dc:description "The sea across which Baltic trade ceases each winter when the Queen of Winter freezes it; a ritual at Arkona must be performed to thaw the ice." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheBible a rpg:Item ;
    rpg:name "The Bible" ;
    dc:description "Christian Scriptures of Old and New Testaments; a Summa on Theology (Level 10, Quality 3) and Church Lore (Level 3, Quality 3)." ;
    skos:altLabel "New Testament", "Old Testament", "Scriptures" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheCaptiveVoice a rpg:Spell ;
    rpg:name "The Captive Voice" ;
    dc:description "An Imaginem spell that a magus can vary to collect a poet's spoken poem, the captured words acting as an Arcane Connection to the poet until the spell ends." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheCarnalWolf a rpg:Creature ;
    rpg:name "The Carnal Wolf" ;
    dc:description "An adulteration caged within the Cave of Twisting Shadows, a great wolf with jaws too large to close, embodying the carnal urges of Demetrius; used to teach apprentices about spiritual impurity." ;
    skos:altLabel "Lupus", "Wolf", "the Wolf" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:TheFaithfulMadeWhole a rpg:Tag ;
    skos:prefLabel "The Faithful Made Whole" ;
    dc:description "A sample relic power (4 points, Init +15, Corpus) that cures the recipient of all disease and heals all physical wounds." ;
    rpg:hasTag amol:HermeticConcept .
amol:TheForumOfHermes a schema:Place ;
    rpg:name "The Forum of Hermes" ;
    dc:description "An enclosed miniature amphitheater at Durenmar, built on a Roman temple and flanked by statues of the Twelve Founders, where Rhine and Grand Tribunals meet." ;
    skos:altLabel "Forum", "the Forum" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheGiftOfReason a rpg:Spell ;
    rpg:name "The Gift of Reason" ;
    dc:description "A Creo Mentem ritual (Level 35) that permanently increases the target's Intelligence by 1 point, to no higher than 0." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheHounds a rpg:Faction ;
    rpg:name "The Hounds" ;
    dc:description "Immense insubstantial grey dogs of the Wild Hunt (Faerie Might 10) whose howls are arctic winds and whose bites inflict an effect similar to Talons of the Winds." ;
    skos:altLabel "Hound of God", "Hounds of God", "The Hounds of God" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:TheLimitOfTime a rpg:Tag ;
    skos:prefLabel "The Limit of Time" ;
    dc:description "Hermetic limit preventing true knowledge of the future; considered Divine by the Magoi and constraining Hermetic Divination." ;
    rpg:hasTag amol:HermeticConcept .
amol:TheMysteriesRevisedEdition a rpg:Item ;
    rpg:name "The Mysteries Revised Edition" ;
    dc:description "An Ars Magica supplement detailing Mysteries such as Hermetic Theurgy, Names of Power, Invocation Magic, Hermetic Synthemata, Ascendancy to the Hall of Heroes, and the Inscription on the Soul Virtue." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:ThePharmacopoeians a rpg:Faction ;
    rpg:name "The Pharmacopoeians" ;
    dc:description "A Minor Hermetic Virtue letting a magus collect magical ingredients to reduce the vis cost of healing Rituals; defining Virtue of the Pharmacopoeians." ;
    skos:altLabel "Pharmacoepians", "Root-Cutter", "Root-Cutters" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:TheRhineGorge a schema:Place ;
    rpg:name "The Rhine Gorge" ;
    dc:description "The narrow, castle-lined stretch of the Rhine between Bingen and Koblenz where nobles enforce tolls; the focus of the saga and supposedly cursed, with all its covenants failing within seven decades." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheSerpentSOracle a rpg:Tag ;
    skos:prefLabel "The Serpent's Oracle" ;
    dc:description "Neqael's power duplicating any Intellego spell or understanding the immediate consequences of an act." ;
    rpg:hasTag amol:HermeticConcept .
amol:TheThreeFaerieCords a rpg:Tag ;
    skos:prefLabel "The Three Faerie Cords" ;
    dc:description "Three additional negative cords (leaden, iron, tin) discovered by Farrago Bonisagi that permanently bind a faerie familiar by hindering the maga's mind, body, and spirit to offset cord decay." ;
    skos:altLabel "Iron Cord", "Leaden Cord", "Tin Cord", "iron cord", "leaden cord", "tin cord" ;
    rpg:hasTag amol:HermeticConcept .
amol:TheologyJudaism a rpg:Proficiency ;
