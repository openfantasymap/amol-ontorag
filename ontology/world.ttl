    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheCourtsOfTheSeasons a rpg:Faction ;
    rpg:name "The Courts of the Seasons" ;
    dc:description "Four intrinsically linked faerie woodland courts (Holly, Alder, Oak, Willow) tied to the passage of the seasons, formed when one forest spirit splintered into four and each allied with a faerie lord." ;
    skos:altLabel "Four Seasonal Courts" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:TheCreationOfAcornsAplenty a rpg:Spell ;
    rpg:name "The Creation of Acorns Aplenty" ;
    dc:description "CrHe 20 ritual that creates a vast pile of acorns totaling 1,000 cubic paces." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheCreationOfVerdantGrassland a rpg:Spell ;
    rpg:name "The Creation of Verdant Grassland" ;
    dc:description "CrHe 10 ritual covering about 1.25 acres with thick grass a pace high." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheCreationOfAForest a rpg:Spell ;
    rpg:name "The Creation of a Forest" ;
    dc:description "CrHe 40 ritual that creates a thousand mature trees." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheCrinteraSchism a rpg:Tag ;
    skos:prefLabel "The Crintera Schism" ;
    dc:description "A saga concept revolving around the troubles within Crintera: the shapeshifter feud, the Harmonist-Wilderist split, and the Rügen crisis, culminating in the covenant being sundered and warring domus magnae." ;
    rpg:hasTag amol:HermeticConcept .
amol:TheCrone a rpg:Character ;
    rpg:name "The Crone" ;
    dc:description "An aged, respected village woman with the Unaging Virtue whose menstrual blood contains Creo vis; though not Gifted, she knows something of magic and serves as a vis source near a covenant." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:TheCrowSSong a rpg:Spell ;
    rpg:name "The Crow's Song" ;
    dc:description "Power (PeCo 40) that forces an Aging Roll with +5 on a target the next time he sleeps." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheCrownOfHermes a rpg:Item ;
    rpg:name "The Crown of Hermes" ;
    dc:description "An elaborate jewel-encrusted golden crown (Cr(In,Mu,Re)Me 50) whose creator is lost to memory; it lets its wearer enter a trance to create and work in an imaginary laboratory, inflicting Warping points." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheCruelStepmother a rpg:Creature ;
    rpg:name "The Cruel Stepmother" ;
    dc:description "Further idea for an actor story element." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:TheCultOfMercuryBook a rpg:Item ;
    rpg:name "The Cult of Mercury (book)" ;
    dc:description "Fenicil's ninth-century tractatus on Organization Lore: Cult of Mercury, Quality 8." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheCultOfVesta a rpg:Faction ;
    rpg:name "The Cult of Vesta" ;
