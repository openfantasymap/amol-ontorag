amol:HuonOfBordeaux a rpg:Character ;
    rpg:name "Huon of Bordeaux" ;
    dc:description "Hero of a song aided by Oberon." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:HurlingTheDropletOfLye a rpg:Spell ;
    rpg:name "Hurling the Droplet of Lye" ;
