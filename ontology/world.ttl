    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:Trianoma a rpg:Character ;
    rpg:name "Trianoma" ;
    dc:description "The maga and apprentice of Bonisagus who traveled widely to recruit wizards and negotiate the Oath of Hermes, becoming the driving force behind the founding of the Order. She declined to be one of the twelve Founders." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:FaerieLore a rpg:Proficiency ;
    rpg:name "Faerie Lore" ;
    dc:description "An Ability representing knowledge of faeries; used to navigate faerie regiones in Initiations and combined with Magic Lore to inform Faerie Magic." ;
