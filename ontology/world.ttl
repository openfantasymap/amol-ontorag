    rpg:hasTag amol:HermeticConcept .
amol:DionysusTheAreopagite a rpg:Character ;
    rpg:name "Dionysus the Areopagite" ;
    dc:description "Authority who lists the archangels as Michael, Gabriel, Raphael, Uriel, Chamuel, Zadkiel and Jophiel." ;
    skos:altLabel "St. Dionysus the Areopagite" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Diplomacy a rpg:Proficiency ;
    rpg:name "Diplomacy" ;
    dc:description "Ability appearing in character or covenant library statistics in the Roman Tribunal." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:DirectionSense a rpg:Proficiency ;
    rpg:name "Direction Sense" ;
