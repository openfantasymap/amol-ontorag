    skos:altLabel "Al-Risala al-Jami'a" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheCongregation a rpg:Tag ;
    skos:prefLabel "The Congregation" ;
    dc:description "Rank-and-file Neo-Mercurian Initiates who recover lost secrets of ancient temples and serve the Priests." ;
    rpg:hasTag amol:CharacterType .
amol:TheConqueredBastard a rpg:Item ;
    rpg:name "The Conquered Bastard" ;
    dc:description "Infernal Lore tractatus (Quality 6) describing the demon in William's corpse." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheConstantExpression a rpg:Tag ;
    skos:prefLabel "The Constant Expression" ;
    dc:description "A Major Hermetic Flaw: the maga perpetually casts non-fatiguing Spontaneous magic effects, losing a permanent long-term Fatigue level and making laboratory work risky." ;
    rpg:hasTag amol:Flaw .
amol:TheCopyistSCriticalEye a rpg:Spell ;
    rpg:name "The Copyist's Critical Eye" ;
    dc:description "InIm 10 spell revealing where a second text differs from the first." ;
