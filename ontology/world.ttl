    rpg:hasTag amol:NamedSpell .
amol:Destiny a rpg:Tag ;
    skos:prefLabel "Destiny" ;
    dc:description "Virtue appearing in character statistics or rules in this text." ;
    rpg:hasTag amol:Virtue .
amol:Destrier a rpg:Creature ;
    rpg:name "Destrier" ;
