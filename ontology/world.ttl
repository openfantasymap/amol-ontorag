    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheBloodcaps a rpg:Faction ;
    rpg:name "The Bloodcaps" ;
    dc:description "Societas Merceris lineage descended from a Mercere adoptee's daughter and a violent border faerie; they dye their caps in blood." ;
    skos:altLabel "Bloodcap" ;
