    dc:description "Sample vitkir rune spell. Ingwaz 35, Method II: transports a family member to the runes." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheRunemasterCarvesTheIceOfTheNorth a rpg:Spell ;
