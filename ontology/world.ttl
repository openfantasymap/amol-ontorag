    rpg:hasTag amol:CharacterType .
amol:Terentia a rpg:Creature ;
    rpg:name "Terentia" ;
    dc:description "A powerful demon of rage and war whose diabolist followers slew Regulus with an infernal artifact." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:TerraeMagi a rpg:Faction ;
    rpg:name "Terrae-magi" ;
    dc:description "A small earth-wizard lineage descended from a Mercurian priest, knowing spells of earth and metal conjuring; Guernicus was its last member." ;
    skos:altLabel "Terrae-Magus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:TerrifyTheUnbeliever a rpg:Tag ;
    skos:prefLabel "Terrify the Unbeliever" ;
    dc:description "Saint Power available through invoking Muslim holy forbears or relics." ;
    rpg:hasTag amol:HermeticConcept .
amol:TerritorialAdvantage a rpg:Tag ;
    skos:prefLabel "Territorial Advantage" ;
    dc:description "Difference between the two sides' Deployment Totals, added to Event Totals; magic affecting terrain adds its magnitude." ;
    rpg:hasTag amol:HermeticConcept .
amol:TerrorOfTheChargingBoar a rpg:Spell ;
    rpg:name "Terror of the Charging Boar" ;
    dc:description "Power of the Wild Boar of the Woods that overwhelms anything he charges with mortal fear." ;
