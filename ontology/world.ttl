    skos:altLabel "Interfering with Mundanes", "interfering with mundanes" ;
    rpg:hasTag amol:HermeticConcept .
amol:Medicus a rpg:Tag ;
    skos:prefLabel "Medicus" ;
    dc:description "A general term for a practitioner who may perform medicine or surgery but has no formal claim to the higher title of doctor; the majority of practicing physicians." ;
    rpg:hasTag amol:CharacterType .
amol:Mediterranean a schema:Place ;
    rpg:name "Mediterranean" ;
    dc:description "Sea averaging 1630 paces deep, an alternative site for a magical island." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Megstone a schema:Place ;
    rpg:name "Megstone" ;
    dc:description "Isolated rock with Infernal aura 1 where Saint Cuthbert imprisoned 144 demons, trapped at zero Might for centuries." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Melee a rpg:Tag ;
    skos:prefLabel "Melee" ;
    dc:description "Tourney event in which grogs try to capture opponents' magical castles." ;
