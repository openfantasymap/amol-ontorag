    skos:altLabel "Chooser of the Slain", "Shield maidens", "Valkyries" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:VardianSTomb a rpg:Faction ;
    rpg:name "Vardian's Tomb" ;
    dc:description "Unrecognized covenant in a forgotten catacomb south of Rome near the Tiber, fractured between Jerbiton founders and Ex Miscellanea necromancers." ;
    skos:altLabel "the Tomb" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:VerditiusElderRunes a rpg:Tag ;
    skos:prefLabel "Verditius Elder Runes" ;
    dc:description "A Verditius Inner Mystery and set of philosophically-grounded runes, derived from Wayland's rune magic and refined by Boethius's philosophy, carved to add power to enchantments." ;
    skos:altLabel "Elder Runes", "Philosophiae", "Verditius Rune", "Verditius Runes", "Verditius lesser runes", "elder runes" ;
    rpg:hasTag amol:HermeticConcept .
amol:Verona a schema:Place ;
    rpg:name "Verona" ;
    dc:description "Veronese magi of Castro Selvaggio who used illusory Veronese soldiers to fool the Milanese." ;
    skos:altLabel "Veronese" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:VisPrava a rpg:Tag ;
    skos:prefLabel "Vis Prava" ;
    dc:description "The most vile Infernal vis, found in strong Infernal auras or powerful demons; any roll using it is automatically a zero for non-Infernal users." ;
    skos:altLabel "wicked vis" ;
    rpg:hasTag amol:HermeticConcept .
amol:Watchers a rpg:Creature ;
    rpg:name "Watchers" ;
    dc:description "The Watchers, the tenth Choir who stayed neutral in the War in Heaven, were cast to Earth, bred with mortals and now wander as masters of lore, trapped in their Mantles." ;
    skos:altLabel "Grigori", "Sons of God" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:WilliamDeLongespee a rpg:Character ;
    rpg:name "William de Longespee" ;
    dc:description "Earl of Salisbury since 1198 and a bastard son of Henry II; a close counselor of King John and a ruthless opportunist disputing Lincoln with Nicola de Hay." ;
    skos:altLabel "Longsword", "William", "William Longespee", "William Longespée", "William Longsword", "earl of Salisbury" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:WingsOfTheSoaringWind a rpg:Spell ;
    rpg:name "Wings of the Soaring Wind" ;
    dc:description "A Creo Auram spell (Level 30) with a Rego requisite that generates a gust supporting and propelling the caster through the air at up to 40 mph." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:WizardSBoost a rpg:Spell ;
    rpg:name "Wizard's Boost" ;
    dc:description "A Vim spell example that is not eligible for the Rebuttal Mastery special ability because it does not affect a spell used by another being." ;
    skos:altLabel "Wizard's Boost (Form)" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:WolfSCourt a schema:Place ;
    rpg:name "Wolf's Court" ;
    dc:description "The remnants of a Roman shrine to vengeance at the Wolf's Court; they are not essential to the Court, and if destroyed the She-Wolf may move to another Magic aura." ;
    skos:altLabel "Fane of Vengeance", "Roman fane of vengeance" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Wonders a rpg:Proficiency ;
    rpg:name "Wonders" ;
    dc:description "Major Supernatural Power Virtue to conjure holy items, creatures and elements; grants Wonders 1." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:Yorkshire a schema:Place ;
    rpg:name "Yorkshire" ;
    dc:description "Region with a tale that revenants are destroyed by stakes through their hearts." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:FormResistance a rpg:Tag ;
    skos:prefLabel "(Form) Resistance" ;
    dc:description "Supernatural Ability for characters with Magic Might, adding to Soak and Magic Resistance against a Form; e.g. Vim, Ignem, Animal, Terram Resistance." ;
    skos:altLabel "Animal Resistance", "Ignem Resistance", "Terram Resistance", "Vim Resistance" ;
    rpg:hasTag amol:Virtue .
amol:Aachen a schema:Place ;
    rpg:name "Aachen" ;
    dc:description "A city founded by Charlemagne over Roman thermal springs; its cathedral houses his tomb, holy relics, and the throne where the German king is crowned. Its Divine aura sapped a local forest spirit." ;
    skos:altLabel "Aix-la-Chapelle" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:AdeptLaboratoryStudent a rpg:Tag ;
    skos:prefLabel "Adept Laboratory Student" ;
    dc:description "A Minor Hermetic Virtue granting +6 to Lab Totals when working from others' lab texts." ;
    rpg:hasTag amol:Virtue .
amol:AdranusTheSpiritOfMountEtna a rpg:Creature ;
    rpg:name "Adranus, the Spirit of Mount Etna" ;
    dc:description "A powerful Magic spirit (Might 50, Ignem) coterminous with Mount Etna, able to duplicate Creo/Rego/Muto/Perdo Ignem and Terram spells and grant Flaws such as Visions, Simple-Minded, and Wrathful." ;
    skos:altLabel "Adranus", "Spirit of Mount Etna" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:AdriaticSea a schema:Place ;
    rpg:name "Adriatic Sea" ;
    dc:description "Sea where the Tremere fleet is active; griffin vultures live along its coast." ;
    skos:altLabel "Adriatic" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:AerialPowers a rpg:Creature ;
    rpg:name "Aerial Powers" ;
    dc:description "Order of elemental demons including aethnici, fictiles, lucifuges, Fimus, Morrighu, Rahab and Xaphan, sharing Elemental Control and Recalcitrance Powers." ;
    skos:altLabel "Gibborim", "Potestates aeriae" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:AestheticQuality a rpg:Tag ;
    skos:prefLabel "Aesthetic Quality" ;
    dc:description "A score determining how aesthetically pleasing a piece of artwork is, calculated from Dexterity + Craft or Communication + Profession plus bonuses, analogous to a book's Quality." ;
    rpg:hasTag amol:HermeticConcept .
amol:Aging a rpg:Tag ;
    skos:prefLabel "Aging" ;
    dc:description "Characters in the Faerie Realm make aging rolls based on time spent in Faerie, not real-world time." ;
    rpg:hasTag amol:HermeticConcept .
amol:AgingRoll a rpg:Tag ;
    skos:prefLabel "Aging Roll" ;
    dc:description "A periodic roll determining a character's aging, modified by Healthy or Unhealthy environmental features at a covenant." ;
    skos:altLabel "Aging rolls" ;
    rpg:hasTag amol:HermeticConcept .
amol:Agnes a rpg:Character ;
    rpg:name "Agnes" ;
    dc:description "A Merinita apprentice who in 1158 claimed to have learned nature magic from a lady in green in Bohemia and was hailed as a True Merinitae having learned Nature Lore from the Founder." ;
    skos:altLabel "Agnes of Assisi", "Agnes of Tremere", "Catherine" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:AirySpirits a rpg:Creature ;
    rpg:name "Airy Spirits" ;
    dc:description "Spirits native to the material world, swarming in Magic auras and often unnoticed." ;
    skos:altLabel "Airy Spirit" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:AlbertusMagnus a rpg:Character ;
    rpg:name "Albertus Magnus" ;
    dc:description "Born 1206 in Bavaria, the most talented natural magician and philosopher of his time and a Dominican; potentially recruitable into the Order of Hermes and a future saint." ;
    skos:altLabel "Albert of Cologne" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Alchemy a rpg:Tag ;
    skos:prefLabel "Alchemy" ;
    dc:description "Science of refining substances and seeking transmutation and the elixir, introduced to Europe from the Arabic world." ;
    rpg:hasTag amol:HermeticConcept .
amol:Allure a rpg:Spell ;
    rpg:name "Allure" ;
    dc:description "Faerie power (Mentem) granting +3 to impress or convince others." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Aloof a rpg:Tag ;
    skos:prefLabel "Aloof" ;
    dc:description "Minor General Flaw: the faerie finds humans uninteresting and rarely increases Pretenses." ;
    rpg:hasTag amol:Flaw .
amol:Amulet a rpg:Item ;
    rpg:name "Amulet" ;
    dc:description "Protective or aiding object crafted with Craft Amulets, Minor (for an individual, lasting days or weeks) or Major (taking seasons to create)." ;
    skos:altLabel "Amulets", "Major Amulet", "Minor Amulet", "Seggulot", "amulets", "seggulah" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:Anchorite a rpg:Tag ;
    skos:prefLabel "Anchorite" ;
    dc:description "Woman enclosed in a cell attached to a church, respected and able to interact through her window, served by female servants." ;
    skos:altLabel "Anchoress" ;
    rpg:hasTag amol:CharacterType .
amol:AngevinDynasty a rpg:Faction ;
    rpg:name "Angevin Dynasty" ;
    dc:description "Dynasty of Anjou ruling England and Aquitaine, symbolized by three gold lions; legendarily descended from Melusine." ;
    skos:altLabel "Angevin Blood", "Angevin family", "Angevins", "Plantagenets" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:AnneKors a rpg:Character ;
    rpg:name "Anne Kors" ;
    dc:description "Companion template: Nolwenn of Finistere, who took the name Anne and lives as a hermit in a woodland cave guided by her Guardian Angel." ;
    skos:altLabel "Anne", "Anne, a Holy Hermit", "Anne, a Lady Not Noble But Suitable", "Nolwenn" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Aonaranan a rpg:Tag ;
    skos:prefLabel "Aonaranan" ;
    dc:description "Highland hermit magi, some of whom attend Calum's court; hermits hold full tribunal votes." ;
    skos:altLabel "Aonaran", "Apparaman", "aonaran", "hermits" ;
    rpg:hasTag amol:CharacterType .
amol:Archbishop a rpg:Tag ;
    skos:prefLabel "Archbishop" ;
    dc:description "A bishop (metropolitan) with responsibility over up to a dozen neighboring dioceses forming a province; receives the pallium and Commanding Aura." ;
    skos:altLabel "Metropolitan" ;
    rpg:hasTag amol:CharacterType .
amol:ArsMagica a rpg:Tag ;
    skos:prefLabel "Ars Magica" ;
    dc:description "The tabletop roleplaying game system in which this Rhine Tribunal supplement is set; rules references point to Ars Magica 5th Edition." ;
    skos:altLabel "ArM5", "Ars Magica 5th Edition", "Ars Magica Fifth Edition" ;
    rpg:hasTag amol:HermeticConcept .
amol:Aschlaranda a rpg:Character ;
    rpg:name "Aschlaranda" ;
    dc:description "A maga exiled from Durenmar and House Bonisagus during the Schism War who founded Dankmar in 1052 to oppose Durenmar, bringing her apprentice Schadrit with her." ;
    skos:altLabel "the maga Aschlaranda" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Athena a rpg:Character ;
    rpg:name "Athena" ;
    dc:description "Guernicus Intéllego specialist and chief Quaesitor of the Alps, who coordinates the Midsummer Fair and favors a greater role for the Tremere." ;
    skos:altLabel "Athena Alpina" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Atlantis a schema:Place ;
    rpg:name "Atlantis" ;
    dc:description "Legendary realm reported by the Greeks and ruled by Poseidon, which Rumael claims to have created and destroyed." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Austria a schema:Place ;
    rpg:name "Austria" ;
    dc:description "Region of Luciferans and Vagi Scholares." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Autocrat a rpg:Tag ;
    skos:prefLabel "Autocrat" ;
    dc:description "A single covenant official combining two specialist roles (commonly steward and chamberlain), contributing the loyalty points of both." ;
    rpg:hasTag amol:CharacterType .
amol:BaAlShem a rpg:Faction ;
    rpg:name "Ba'al Shem" ;
    dc:description "Jewish itinerant folk magicians, 'masters of the Divine name', who craft amulets and deliver blessings for pay; favored Abilities Adjuration, Blessing, Craft Amulets and Invocation." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Baden a schema:Place ;
    rpg:name "Baden" ;
    dc:description "A Swabian town named Aquae by the Romans for its hot springs, whose ruined upper part retains a Magic aura of 2 and is owned by Durenmar, which harvests vis from the springs." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Baghdad a schema:Place ;
    rpg:name "Baghdad" ;
    dc:description "City of the Muqta' who protects the Radhanite merchant." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Baiocassium a rpg:Faction ;
    rpg:name "Baiocassium" ;
    dc:description "Diedne-dominated covenant near Bayeux, raided by Vikings, destroyed in the Schism War after destroying Pagus." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:BaneOfTheDecrepitBody a rpg:Spell ;
    rpg:name "Bane of the Decrepit Body" ;
    dc:description "A Perdo Corpus spell (Level 25) that ages the target 5 years; does not work on children younger than 16." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Bayeux a schema:Place ;
    rpg:name "Bayeux" ;
    dc:description "Town, once Gallic Baiocasses, with Bayeux Cathedral and mills; rumored to hide the regio of Baiocassium Minor." ;
    skos:altLabel "Baiocasses" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:BearIsland a schema:Place ;
    rpg:name "Bear Island" ;
    dc:description "Peninsula off Anatolia on the southern shore of the Sea of Marmara in the Thebes Tribunal, visited by Jason and the Argonauts; home to the Gegenees, the Idaian Daktyls and the bound titaness Dindyméné." ;
    skos:altLabel "Arktonnessos", "Bear Mountain", "Oros Arkton" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Belin a rpg:Character ;
    rpg:name "Belin" ;
    dc:description "Mercere's last apprentice, renowned for her devotion to the Order and dedication to delivering messages despite having no Gift; held up as an ideal in House Mercere." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:BelovedRival a rpg:Tag ;
    skos:prefLabel "Beloved Rival" ;
    dc:description "A formally declared lifelong rivalry within House Tytalus, ceremonially issued with a spiral drawn in blood, persisting until the death of one opponent; also a Minor Story Flaw." ;
    rpg:hasTag amol:Flaw .
amol:Benedict a rpg:Character ;
    rpg:name "Benedict" ;
    dc:description "Saint whose Rule the monastic orders follow; those devoted to him are protected from Patarus." ;
    skos:altLabel "Saint Benedict", "Saint Benedict of Nursia", "St. Benedict of Nursia" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:BetrayalOfTheHeart a rpg:Tag ;
    skos:prefLabel "Betrayal of the Heart" ;
    dc:description "Iurgator power revealing a secret fact about a target." ;
    rpg:hasTag amol:HermeticConcept .
amol:Bibracte a rpg:Faction ;
    rpg:name "Bibracte" ;
    dc:description "Vassal of Fudarus (822-969) on Mount Beauvray that revived a cult of Vercingetorix and was destroyed by Wizard Wars from Montverte magi." ;
    skos:altLabel "Bribracte" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:BlackLineage a rpg:Faction ;
    rpg:name "Black Lineage" ;
    dc:description "An intelligent lineage of cats descended from House Jerbiton's Founder's familiar that understand human language, often have Second Sight, live around 40 years, and have a parliament that elects a monarch (the King of the Cats)." ;
    skos:altLabel "Black Cats" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Blackmail a rpg:Tag ;
    skos:prefLabel "Blackmail" ;
    dc:description "A Flaw used to represent coercion of an agent by a principal, such as a priest controlling a knight through blackmail or other leverage." ;
    rpg:hasTag amol:Flaw .
amol:BladeOfTheVirulentFlame a rpg:Spell ;
    rpg:name "Blade of the Virulent Flame" ;
    dc:description "A Creo Ignem spell (Level 15) that forms fire along a metal blade, doubling the weapon's damage (or adding +5) and starting fires; repeated castings can melt the blade." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Bomburkhan a rpg:Creature ;
    rpg:name "Bomburkhan" ;
    dc:description "A minor imp demon (Might 5, Vim) appearing as a jet-black bat with a human face who punctures the egos of the prideful by granting talents that contradict boasts; released after the fall of Jerusalem." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:BordelonAPersonalTormentor a rpg:Creature ;
    rpg:name "Bordelon, a Personal Tormentor" ;
    dc:description "A demon (Might 15, Corpus) appearing as a stern governess who chooses a child as her personal tormentor, crushing ambition and meekness through punishment whenever the child distinguishes himself." ;
    skos:altLabel "Bordelon", "Bordelon, Personal Tormentor" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Borders a schema:Place ;
    rpg:name "Borders" ;
    dc:description "Border region between England and Scotland, lawless and raided by families on both sides." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Brawling a rpg:Proficiency ;
    rpg:name "Brawling" ;
    dc:description "Ability listed in the Alpine redcap template or Hera's statistics." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:BrethrenOfTheFreeSpirit a rpg:Faction ;
    rpg:name "Brethren of the Free Spirit" ;
    dc:description "A heretical pantheistic cult emerging at the start of the 13th century from Paris theologians and spreading in Cologne, equating God to primary matter and holding that there is no sin." ;
    skos:altLabel "Illuminati", "the Brethren" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:BridgeOfWood a rpg:Spell ;
    rpg:name "Bridge of Wood" ;
    dc:description "A Creo Herbam spell (Level 15) that creates a bridge of living leaves, vines, and wood up to 20 paces long supporting creatures up to Size +4." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:BrochBuilders a rpg:Faction ;
    rpg:name "Broch-builders" ;
    dc:description "Ancient people of the Western Isles conquered by the Picts; possibly builders of the stone monuments." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:BuryStEdmundS a schema:Place ;
    rpg:name "Bury St. Edmund's" ;
    dc:description "A wealthy abbey town in West Suffolk wholly under the abbey's control, founded in 633 by King Sigebert and home to the tomb of St. Edmund, a major pilgrimage site." ;
    skos:altLabel "Abbey of St. Edmund", "Bury Saint Edmunds", "St. Edmund's Abbey" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:CabalLegacy a rpg:Tag ;
    skos:prefLabel "Cabal Legacy" ;
    dc:description "Flaw that for the Fraternity merely means badgering by would-be Initiates." ;
    rpg:hasTag amol:Virtue .
amol:Caecilius a rpg:Character ;
    rpg:name "Caecilius" ;
    dc:description "A Quaesitor of Durenmar and a contender for the oldest magus in the Tribunal, who ruled firmly that no wilderness had been invaded in the Crintera/Guardians of the Forests dispute." ;
    skos:altLabel "Caecilius of Durenmar", "the Quaesitor Caecilius" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Calabria a schema:Place ;
    rpg:name "Calabria" ;
    dc:description "Covenant in southern Italy weakened by a Verdi-instigated Mussulman invasion; its Magi fled to Novgorod." ;
    skos:altLabel "Calabria (covenant)" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Caladrius a rpg:Creature ;
    rpg:name "Caladrius" ;
    dc:description "A magnificent all-white mystical bird of the Magic Realm, sought by royal households, which can draw a non-fatal disease out of a sick person into itself and burn it away by flying toward the sun." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:CapetianDynasty a rpg:Faction ;
    rpg:name "Capetian Dynasty" ;
    dc:description "French royal dynasty descended from Hugh Capet, noted for piety, symbolized by gold lilies on blue." ;
    skos:altLabel "Capetian Blood", "Capetian kings", "Capetians" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Carefree a rpg:Tag ;
    skos:prefLabel "Carefree" ;
    dc:description "Virtue named in the text, associated with Larta chefs, smiths, minstrels or muses." ;
    rpg:hasTag amol:Flaw .
amol:Carnac a schema:Place ;
    rpg:name "Carnac" ;
    dc:description "Stone monument site in Brittany to which the stones may allow travel." ;
    skos:altLabel "Camac" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Carthage a schema:Place ;
    rpg:name "Carthage" ;
    dc:description "Ancient city whose men worshiped Adramelech as Moloch." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:CatacombsOfRome a schema:Place ;
    rpg:name "Catacombs of Rome" ;
    dc:description "Catacombs where Vespillo searched for the tombs of the Mercurian priesthood; his companions died there." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:CatoOfBonisagus a rpg:Character ;
    rpg:name "Cato of Bonisagus" ;
    dc:description "A spectral Criamon Primus who was a Bonisagus magus before joining; he believes Criamon magi create the majority of all adulterations." ;
    skos:altLabel "Cato", "Primus Cato" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Cercistum a rpg:Character ;
    rpg:name "Cercistum" ;
    dc:description "A Primus of House Tremere during the Schism War, quoted observing that the Tytali fought a different battle on the Plain of Wolves than the Tremere pretended to." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:ChangeForm a rpg:Tag ;
    skos:prefLabel "Change Form" ;
    dc:description "Spirits of Deceit Power to change their shape to human or animal forms." ;
    rpg:hasTag amol:HermeticConcept .
amol:Changeling a rpg:Creature ;
    rpg:name "Changeling" ;
    dc:description "A story-seed faerie who comes regularly to a market for human food to sustain a stolen human child raised by her group living in nearby woodland." ;
    skos:altLabel "Changelings", "Gerontified Faerie" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:ChaosOfTheAngryWaves a rpg:Spell ;
    rpg:name "Chaos of the Angry Waves" ;
    dc:description "A Rego Aquam spell (Level 30) that causes water to churn wildly in a circular area, overturning small craft and penalizing Swim rolls." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Cherbourg a schema:Place ;
    rpg:name "Cherbourg" ;
    dc:description "Town on the Cotentin near the ruined covenant Pagus, with a Fengheld chapterhouse." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Christianity a rpg:Faction ;
    rpg:name "Christianity" ;
    dc:description "One of the three most important Divine religions in Mythic Europe; many magi are Christians and its relics are most common." ;
    skos:altLabel "Christian", "Christians" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:ChrTienDeTroyes a rpg:Character ;
    rpg:name "Chrétien de Troyes" ;
    dc:description "Author of epic poems about the Knights of the Round Table in which giants appear as brutish villains." ;
    skos:altLabel "Chretien", "Chretien de Troyes" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:CloakOfMist a rpg:Spell ;
    rpg:name "Cloak of Mist" ;
    dc:description "A Muto Corpus spell (Level 40) with an Auram requisite that turns the caster into a human-sized cohesive mist able to float and seep through cracks." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:CloudsOfSummerSnow a rpg:Spell ;
    rpg:name "Clouds of Summer Snow" ;
    dc:description "A Creo Auram spell (Level 25) that creates clouds dropping snow over an area about half a mile across without affecting temperature." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Clutch a rpg:Tag ;
    skos:prefLabel "Clutch" ;
    dc:description "A study group of the Criamon magi within a single Tribunal, originally living as a covenant following a single path; the Cave of Twisting Shadows holds the Central Clutch." ;
    skos:altLabel "Central Clutch", "clutches" ;
    rpg:hasTag amol:HermeticConcept .
amol:Conciatta a rpg:Character ;
    rpg:name "Conciatta" ;
    dc:description "Maga of House Bonisagus who expanded Hermetic understanding across the four realms; author of The Application of Vim to the Supernatural Humors, whose lost research may reduce aura penalties including the Dominion." ;
    skos:altLabel "Bonisagi Conciatta", "Conciatta of Bonisagus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Consors a rpg:Tag ;
    skos:prefLabel "Consors" ;
    dc:description "An acknowledged asset of the covenant, as which a companion lord may receive magical support." ;
    skos:altLabel "Caraid", "Consortis", "consortis" ;
    rpg:hasTag amol:CharacterType .
amol:ConsummateTalisman a rpg:Tag ;
    skos:prefLabel "Consummate Talisman" ;
    dc:description "Major Hermetic Mystery Virtue allowing Muto Vim effects and Names of Power to be enchanted into a talisman to affect the magus's own spellcasting." ;
    rpg:hasTag amol:Virtue .
amol:ContagiousObsession a rpg:Tag ;
    skos:prefLabel "Contagious Obsession" ;
    dc:description "Vessels of Iniquity Power making Obsession victims carriers who spread it." ;
    rpg:hasTag amol:HermeticConcept .
amol:Continence a rpg:Tag ;
    skos:prefLabel "Continence" ;
    dc:description "A Minor Personality Flaw: the character does not engage in sexual activity, due to a vow of celibacy or personal choice." ;
    rpg:hasTag amol:Flaw .
amol:CorruptedAbilities a rpg:Tag ;
    skos:prefLabel "Corrupted Abilities" ;
    dc:description "A Minor Supernatural Tainted Flaw: one or more Abilities was taught by a demon, giving +3 for selfish use and -3 for selfless use, with use sensed by Divine Powers." ;
    rpg:hasTag amol:Flaw .
amol:CotentinPeninsula a schema:Place ;
    rpg:name "Cotentin Peninsula" ;
    dc:description "Lightly settled, swampy region of Normandy containing Confluensis and the ruins of Pagus." ;
    skos:altLabel "Cotentin" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:CourtOfBrightWinter a rpg:Faction ;
    rpg:name "Court of Bright Winter" ;
    dc:description "A Seelie faerie court associated with light, snow, cold, and the hunt, found in midwinter among the high hills of the Westerwald; rival to Dark Summer." ;
    skos:altLabel "Bright Winter", "Winter Court" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Coven a rpg:Faction ;
    rpg:name "Coven" ;
    dc:description "A group of folk witches (usually three to a dozen) dispersed over a locale, the folk witch equivalent of a Hermetic covenant." ;
    skos:altLabel "Infernal Ceremony", "covens" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:CovenantWhereJourneysEnd a rpg:Faction ;
    rpg:name "Covenant Where Journeys End" ;
    dc:description "Merinita and Bjornaer covenant in a frigid faerie regio on Mont Joux, founded 817, known for kidnapping travelers and its ice-distorted covenfolk." ;
    skos:altLabel "Journeys End", "Where Journeys End" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:CovenantOfTarragonVale a rpg:Faction ;
    rpg:name "Covenant of Tarragon Vale" ;
    dc:description "Unterwalden covenant of metaphysical geographers whose four magi and covenfolk vanished twenty-two years ago; its vis income is held by the Quaesitores." ;
    skos:altLabel "Tarragon Vale" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:CovenantOfTheIcyNorth a rpg:Faction ;
    rpg:name "Covenant of the Icy North" ;
    dc:description "A covenant founded in 771 by magi of different Houses, now a loose affiliation of nine autonomous chapters across the Alps that meet annually at the Motherhouse in Bavaria." ;
    skos:altLabel "Icy North", "Icy North — Motherhouse" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:CraftAmulets a rpg:Proficiency ;
    rpg:name "Craft Amulets" ;
    dc:description "Supernatural Ability used by the Ba'al Shem with Holy Methods and Powers to create Minor and Major amulets of Touch range and Worn duration." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:CrafterSHealing a rpg:Tag ;
    skos:prefLabel "Crafter's Healing" ;
    dc:description "A Major Supernatural Virtue letting a character magically heal wounds by touching them with the tools of his trade; it grants the Crafter's Healing Ability and is a power Hermetic magi cannot understand." ;
    rpg:hasTag amol:Virtue .
amol:CreativeBlock a rpg:Tag ;
    skos:prefLabel "Creative Block" ;
    dc:description "A Minor Hermetic Flaw: the magus has problems creating new things in the lab, taking -3 to Lab Totals unless using a Laboratory Text or being taught." ;
    rpg:hasTag amol:Flaw .
amol:CrystalsOfMontjoux a rpg:Item ;
    rpg:name "Crystals of Montjoux" ;
    dc:description "Quartz and fluorite crystals found embedded together at Montjoux, with magical form and effect bonuses." ;
    skos:altLabel "Black Quartz", "Smoky Quartz", "black quartz", "fluorite", "smoky quartz" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:Curate a rpg:Tag ;
    skos:prefLabel "Curate" ;
    dc:description "Local priest appointed by the bishop to care for souls in a parish; temporary curates serve perpetual curates." ;
    rpg:hasTag amol:CharacterType .
amol:Cyclopes a rpg:Creature ;
    rpg:name "Cyclopes" ;
    dc:description "Giant one-eyed race of eastern Sicily who departed centuries ago, leaving Polyphemus." ;
    skos:altLabel "cyclops" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Cyprus a schema:Place ;
    rpg:name "Cyprus" ;
    dc:description "Island bought by the Templars from King Richard, ruled by the Lusignans." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Damascus a schema:Place ;
    rpg:name "Damascus" ;
    dc:description "Syrian city claiming the head of John the Baptist." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:DamhadhDuidsan a rpg:Faction ;
    rpg:name "Damhadh-Duidsan" ;
    dc:description "A tradition of House Ex Miscellanea descended from Damhadh-Duidas who carve Ogam runes to curse, wound, and heal; they try to escape their Infernal past, with Giant Blood common." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Danu a rpg:Creature ;
    rpg:name "Danu" ;
    dc:description "A faerie elemental spirit of the River Danube, formerly worshiped as a goddess by many peoples before the Romans; her presence remains strong at the river's source." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Danube a schema:Place ;
    rpg:name "Danube" ;
    dc:description "A river embodied in ancient times as a faerie goddess whose nymphs guard treasure grottos and gateways to Arcadia." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Deficiency a rpg:Tag ;
    skos:prefLabel "Deficiency" ;
    dc:description "A Hermetic Flaw imposed when a master opens an apprentice's Arts while having a score below five in an Art; inflicting it is normally a Low Crime." ;
    skos:altLabel "Deficiency Flaw", "Hermetic Deficiency" ;
    rpg:hasTag amol:Flaw .
amol:Deluders a rpg:Creature ;
    rpg:name "Deluders" ;
    dc:description "Order of demons, appearing as slashes of darkness filled with eyes and teeth, who make magic seem stronger; includes Aqrab, enervators, Watchers and the Spirits of Solomon." ;
    skos:altLabel "Juggling Impostors", "Memunim", "Praestigiatores" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Depressed a rpg:Tag ;
    skos:prefLabel "Depressed" ;
    dc:description "A Minor Personality Flaw giving the character a dark outlook on life, seeing little point in acting and taking no pleasure in events." ;
    rpg:hasTag amol:Flaw .
amol:Deprivation a rpg:Tag ;
    skos:prefLabel "Deprivation" ;
    dc:description "Rules for lack of food or air (ArM5 p.180) invoked for besieged characters and constriction victims." ;
    rpg:hasTag amol:HermeticConcept .
amol:DietrichOfBern a rpg:Character ;
    rpg:name "Dietrich of Bern" ;
    dc:description "A Daimon (Magic Might 35, Corpus) of the German hero and boy-king of Bern, whose tomb in the Lessini Mountains holds dragon-blood-enchanted arms; he animates his corpse to test those who enter." ;
    skos:altLabel "Dietrich" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Disenchant a rpg:Spell ;
    rpg:name "Disenchant" ;
    dc:description "A Perdo Vim ritual that permanently strips a Hermetic magic item of all its powers, destroying its enchantment and invested vis." ;
    skos:altLabel "Disenchantment" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Disputatio a rpg:Tag ;
    skos:prefLabel "Disputatio" ;
    dc:description "A formal academic debate resolved much like certamen, using paired totals (Attack, Defense, Weakening, Resistance) and symbolic Fatigue Levels to determine a winner across deliberative, epideictic, and forensic forms." ;
    skos:altLabel "Disputatio Total", "disputation", "disputationes" ;
    rpg:hasTag amol:HermeticConcept .
amol:DivineWarping a rpg:Tag ;
    skos:prefLabel "Divine Warping" ;
    dc:description "Warping from Divine sources such as auras, powerful Divine effects and Divine botches, producing visions, stigmata and angelic transfigurations." ;
    rpg:hasTag amol:HermeticConcept .
amol:Dodge a rpg:Proficiency ;
    rpg:name "Dodge" ;
    dc:description "Ability appearing in character or covenant library statistics in this text." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:DonningTheCorporealVeil a rpg:Spell ;
    rpg:name "Donning the Corporeal Veil" ;
    dc:description "She-Wolf power creating and animating a physical she-wolf body for the spirit." ;
    skos:altLabel "Doning the Corporeal Veil" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:DurescaScrolls a rpg:Item ;
    rpg:name "Duresca Scrolls" ;
    dc:description "Letters purportedly between Guernicus and his filii revealing a plan to dominate the Order, declared fraudulent by the Iberian Tribunal." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:EarthThatBreaksNoMore a rpg:Spell ;
    rpg:name "Earth That Breaks No More" ;
    dc:description "A Muto Terram spell that turns a volume of packed dirt up to ten cubic paces into stone." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Easter a rpg:Tag ;
    skos:prefLabel "Easter" ;
    dc:description "The most important Christian holy day, celebrating Christ's resurrection, on the first Sunday after the first full moon after the spring equinox." ;
    skos:altLabel "Good Friday" ;
    rpg:hasTag amol:HermeticConcept .
amol:Ebroin a rpg:Character ;
    rpg:name "Ebroin" ;
    dc:description "The relatively young current Primus of House Ex Miscellanea, elected after Immanola entered Final Twilight, with ambitions to revitalize the House from Cad Gadu." ;
    skos:altLabel "Primus Ebroin" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Embitterment a rpg:Tag ;
    skos:prefLabel "Embitterment" ;
    dc:description "A Major Non-Hermetic Supernatural Ability of the Nemthengacha allowing a speaker, through conversation, to make a listener hostile to a chosen target, up to the level of murder." ;
    rpg:hasTag amol:Virtue .
amol:Emir a rpg:Tag ;
    skos:prefLabel "Emir" ;
    dc:description "A Minor, Social Status Virtue equivalent to Knight but for Muslim emirs, who are skilled in hunting, religious teachings, and culture as well as martial pursuits." ;
    rpg:hasTag amol:Virtue .
amol:EndOfTheMightyCastle a rpg:Spell ;
    rpg:name "End of the Mighty Castle" ;
    dc:description "A Perdo Terram (PeTe 25) spell that collapses a building; since non-magical stone falls due to gravity, Magic Resistance does not protect against it." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Energumen a rpg:Tag ;
    skos:prefLabel "Energumen" ;
    dc:description "A human possessed by a demon, targeted by Exorcise the Filthy Spirit." ;
    rpg:hasTag amol:CharacterType .
amol:Enrichment a rpg:Tag ;
    skos:prefLabel "Enrichment" ;
    dc:description "The process of treating a Thing of Virtue (herb, object, tree) through a ritual procedure, usually over a season, so it confers a Virtue or power instead of being harvested for vis." ;
    skos:altLabel "Enriched", "Enrichment Total" ;
    rpg:hasTag amol:HermeticConcept .
amol:Enthrallment a rpg:Spell ;
    rpg:name "Enthrallment" ;
    dc:description "Special gruagach ability of Damhan-allaidh. Like Rego and Perdo Mentem; used to take over minds of nobles, magi or churchmen." ;
    skos:altLabel "Enthrall" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:EnticerOfMultitudes a rpg:Tag ;
    skos:prefLabel "Enticer of Multitudes" ;
    dc:description "A Minor, General, Tainted Virtue giving a corrupt version of Inspirational usable only to manipulate people toward evil acts." ;
    rpg:hasTag amol:Virtue .
amol:EntreatThePowers a rpg:Tag ;
    skos:prefLabel "Entreat the Powers" ;
    dc:description "Major Supernatural Virtue letting a learned magician minimize negative effects of Divine or Infernal auras on magic." ;
