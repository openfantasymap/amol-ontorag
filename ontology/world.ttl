    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Andrew a rpg:Creature ;
    rpg:name "Andrew" ;
    dc:description "An infernal ghost of the Accusers, a peasant hanged for murdering his wife and her lover, who now uncovers the crimes of unfaithful lovers." ;
    skos:altLabel "Andrew, an Infernal Ghost" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Andrilikes a rpg:Character ;
    rpg:name "Andrilikes" ;
    dc:description "A theurgist magus of the Novgorod Tribunal who wrote a Hermetic ritual for summoning the lesser Daimon Pukis to his sanctum." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:AngelEyesPotion a rpg:Item ;
    rpg:name "Angel Eyes Potion" ;
    dc:description "MuAq(Im) 15 charged potion causing hallucinations." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:AngelOfDeath a rpg:Creature ;
    rpg:name "Angel of Death" ;
