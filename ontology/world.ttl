amol:ConjurationOfTheIndubitableCold a rpg:Spell ;
    rpg:name "Conjuration of the Indubitable Cold" ;
    dc:description "A Perdo Ignem spell (Level 25) that cools the air within ten paces below freezing, chilling nonliving things thoroughly and costing living things a Fatigue level while shrinking fires." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Controlling a rpg:Proficiency ;
    rpg:name "Controlling" ;
    dc:description "Elementalist Technique based on Presence that lets an elementalist dictate the behavior of summoned or encountered targets via gesture and incantation." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticArt .
amol:Corinth a schema:Place ;
    rpg:name "Corinth" ;
    dc:description "Site of an ancient shrine to Lamia and of Apollonios's wedding confrontation." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Cornwall a schema:Place ;
    rpg:name "Cornwall" ;
    dc:description "English county whose people paid King John 5,000 marks to be deforested." ;
