    rpg:hasTag amol:HermeticConcept .
amol:Crush a rpg:Spell ;
    rpg:name "Crush" ;
    dc:description "Obligatory Greater Power of earth elementals, a clubbing attack that can pin and damage equipment." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:CulhwchExMiscellanea a rpg:Character ;
