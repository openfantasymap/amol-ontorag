    rpg:hasTag amol:Creature .
amol:QurAn a rpg:Item ;
    rpg:name "Qur'an" ;
    dc:description "Muslim holy book compiled from revelations to Muhammad; a Summa of Theology: Islam and can be invoked for baraka." ;
