    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheRoadToLemnos a rpg:Spell ;
    rpg:name "The Road To Lemnos" ;
    dc:description "Mu(In)Me 40 Mystery spell that brings the spirits of a touched group of travelers into a sleeper's dream, their bodies lying in trance." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheRoosterSCrow a rpg:Spell ;
    rpg:name "The Rooster's Crow" ;
