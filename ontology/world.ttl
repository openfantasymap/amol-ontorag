    rpg:hasTag amol:FactionTag .
amol:TheCurseOfPoseidon a rpg:Tag ;
    skos:prefLabel "The Curse of Poseidon" ;
    dc:description "Polyphemus' power (ReAq 50) making the ocean the victim's enemy until Polyphemus or Poseidon is appeased." ;
