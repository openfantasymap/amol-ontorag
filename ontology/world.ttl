# Ars Magica Open License — OntoRAG world graph
#
# Hand-authored instance graph for the AMOL dataset. This is the *source of truth*
# for the ontology layer: `tools/build.py` parses it (rdflib) to emit the flat
# `entities.jsonl` index used for fast loading and chunk↔entity linking.
#
# Schema alignment: classes/properties prefixed `rpg:` come from the rpg-schema
# TTRPG ontology (catalog slug "rpg"); `schema:`, `dc:`, `foaf:`, `skos:` are the
# usual vocabularies. Everything under `amol:` is data specific to this dataset.
#
# License of the described content: CC-BY-SA-4.0 (see /LICENSE.md and content/sources.json).

@prefix amol:   <https://www.fantasymaps.org/amol-ontorag/id/> .
@prefix rpg:    <http://www.rpg-schema.org/1.0/> .
@prefix schema: <https://schema.org/> .
@prefix dc:     <http://purl.org/dc/terms/> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

#################################################################
#  World, RuleSet, Publisher
#################################################################

amol:MythicEurope a rpg:World ;
    rpg:name "Mythic Europe" ;
    rdfs:label "Mythic Europe" ;
    dc:description "The setting of Ars Magica: an early-13th-century Europe in which the myths and superstitions of the age are literally true. Magi of the Order of Hermes wield potent magic from covenants hidden across the continent, while faeries, demons, angels and magical beasts inhabit the wider world." ;
    schema:genre "Historical fantasy" ;
    rpg:worldUsesRuleSet amol:ArM5 ;
    dc:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    skos:altLabel "Mythic Europe" .

amol:ArM5 a rpg:RuleSet ;
    rpg:name "Ars Magica, Fifth Edition" ;
    rdfs:label "Ars Magica 5th Edition" ;
    dc:description "The fifth edition of Ars Magica, a tabletop roleplaying game of magi in Mythic Europe, renowned for its deep Hermetic magic system built from five Techniques and ten Forms. Published by Atlas Games and released under CC-BY-SA-4.0 as the Ars Magica Open License." ;
    rpg:ruleSetType amol:CoreRuleSet ;
    rpg:publisher amol:AtlasGames ;
    dc:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    skos:altLabel "ArM5", "Ars Magica 5e" .

amol:CoreRuleSet a rpg:RuleSetType ;
    rdfs:label "Core RuleSet" ;
    rpg:termCode "core" .

amol:AtlasGames a foaf:Organization, schema:Organization ;
    schema:name "Atlas Games" ;
    rdfs:label "Atlas Games" ;
    schema:url <https://www.atlas-games.com/arsmagica> .

#################################################################
#  Grouping tags (controlled vocabulary)
#################################################################

amol:HermeticHouse   a rpg:Tag ; skos:prefLabel "Hermetic House" ; rpg:termCode "house" .
amol:Technique       a rpg:Tag ; skos:prefLabel "Technique" ; rpg:termCode "technique" .
amol:Form            a rpg:Tag ; skos:prefLabel "Form" ; rpg:termCode "form" .
amol:Tribunal        a rpg:Tag ; skos:prefLabel "Tribunal" ; rpg:termCode "tribunal" .
amol:Realm           a rpg:Tag ; skos:prefLabel "Realm of Power" ; rpg:termCode "realm" .
amol:HermeticAbility a rpg:Tag ; skos:prefLabel "Hermetic Ability" ; rpg:termCode "ability" .
amol:HermeticConcept a rpg:Tag ; skos:prefLabel "Hermetic Concept" ; rpg:termCode "concept" .
amol:NamedSpell      a rpg:Tag ; skos:prefLabel "Named Spell" ; rpg:termCode "spell" .
amol:CharacterType   a rpg:Tag ; skos:prefLabel "Character Type" ; rpg:termCode "chartype" .

#################################################################
#  The Four Realms of Power
#################################################################

amol:RealmMagic a rpg:Tag ;
    skos:prefLabel "The Magic Realm" ;
    rpg:hasTag amol:Realm ;
    dc:description "The realm of magical power, source of the Arts, magical creatures and raw vis." ;
    skos:altLabel "Magic Realm", "Realm of Magic" .

amol:RealmFaerie a rpg:Tag ;
    skos:prefLabel "The Faerie Realm" ;
    rpg:hasTag amol:Realm ;
    dc:description "The realm of faeries: glamour, story and the power of belief and emotion." ;
    skos:altLabel "Faerie Realm", "Realm of Faerie" .

amol:RealmDivine a rpg:Tag ;
    skos:prefLabel "The Divine Realm" ;
    rpg:hasTag amol:Realm ;
    dc:description "The realm of the one God, angels and the major monotheistic faiths; supreme over the other realms." ;
    skos:altLabel "Divine Realm", "Realm of the Divine" .

amol:RealmInfernal a rpg:Tag ;
    skos:prefLabel "The Infernal Realm" ;
    rpg:hasTag amol:Realm ;
    dc:description "The realm of demons and damnation, which corrupts and deceives." ;
    skos:altLabel "Infernal Realm", "Realm of the Infernal" .

#################################################################
#  The Hermetic Arts — 5 Techniques + 10 Forms
#  Modeled as rpg:Proficiency (a Capability) defined in the ArM5 ruleset.
#################################################################

amol:Creo a rpg:Proficiency ;
    rpg:name "Creo" ;
    dc:description "Technique meaning 'I create'. Creates things and brings them to a more perfect state; the Art of healing and creation." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:Technique .

amol:Intellego a rpg:Proficiency ;
    rpg:name "Intellego" ;
    dc:description "Technique meaning 'I perceive'. Gathers information and reveals hidden truths." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:Technique .

amol:Muto a rpg:Proficiency ;
    rpg:name "Muto" ;
    dc:description "Technique meaning 'I transform'. Changes a target into something unnatural to itself." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:Technique .

amol:Perdo a rpg:Proficiency ;
    rpg:name "Perdo" ;
    dc:description "Technique meaning 'I destroy'. Destroys, weakens, harms or removes." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:Technique .

amol:Rego a rpg:Proficiency ;
    rpg:name "Rego" ;
    dc:description "Technique meaning 'I control'. Directs or controls a target according to its own nature." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:Technique .

amol:Animal a rpg:Proficiency ;
    rpg:name "Animal" ;
    dc:description "Form governing animals and products of animals." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:Form .

amol:Aquam a rpg:Proficiency ;
    rpg:name "Aquam" ;
    dc:description "Form governing water and liquids." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:Form .

amol:Auram a rpg:Proficiency ;
    rpg:name "Auram" ;
    dc:description "Form governing air, weather and gases." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:Form .

amol:Corpus a rpg:Proficiency ;
    rpg:name "Corpus" ;
    dc:description "Form governing the human body." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:Form .

amol:Herbam a rpg:Proficiency ;
    rpg:name "Herbam" ;
    dc:description "Form governing plants and products of plants." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:Form .

amol:Ignem a rpg:Proficiency ;
    rpg:name "Ignem" ;
    dc:description "Form governing fire, heat, cold and light." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:Form .

amol:Imaginem a rpg:Proficiency ;
    rpg:name "Imaginem" ;
    dc:description "Form governing species: images, sounds and other sensory impressions." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:Form .

amol:Mentem a rpg:Proficiency ;
    rpg:name "Mentem" ;
    dc:description "Form governing minds, thoughts and emotions." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:Form .

amol:Terram a rpg:Proficiency ;
    rpg:name "Terram" ;
    dc:description "Form governing earth and solid inanimate materials." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:Form .

amol:Vim a rpg:Proficiency ;
    rpg:name "Vim" ;
    dc:description "Form governing raw magical power and vis itself." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:Form .

#################################################################
#  The Twelve Houses of Hermes — modeled as rpg:Faction
#################################################################

amol:HouseBonisagus a rpg:Faction ;
    rpg:name "House Bonisagus" ;
    dc:description "The lineage of the founders who created the Order; devoted to magic theory, original research and the leadership of the Order. Its members freely share breakthroughs with all magi." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:HermeticHouse ;
    skos:altLabel "Bonisagus" .

amol:HouseGuernicus a rpg:Faction ;
    rpg:name "House Guernicus" ;
    dc:description "The Quaesitores: judges and investigators who uphold and enforce the Code of Hermes, slowing the wheel of fate that would tear the Order apart." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:HermeticHouse ;
    skos:altLabel "Guernicus", "Quaesitor", "Quaesitores" .

amol:HouseMercere a rpg:Faction ;
    rpg:name "House Mercere" ;
    dc:description "The Redcaps: heralds, messengers and merchants who bind the Order together by carrying communication and trade between covenants." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:HermeticHouse ;
    skos:altLabel "Mercere", "Redcap", "Redcaps" .

amol:HouseTremere a rpg:Faction ;
    rpg:name "House Tremere" ;
    dc:description "A disciplined, hierarchical House that prizes cooperation and preparation; masters of certamen who gather influence to meet crises before they arrive." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:HermeticHouse ;
    skos:altLabel "Tremere" .

amol:HouseBjornaer a rpg:Faction ;
    rpg:name "House Bjornaer" ;
    dc:description "A Mystery House whose magi each possess a heartbeast, an animal soul into which they can transform; organized into clans and septs." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:HermeticHouse ;
    skos:altLabel "Bjornaer", "Heartbeast" .

amol:HouseCriamon a rpg:Faction ;
    rpg:name "House Criamon" ;
    dc:description "An enigmatic Mystery House devoted to the Enigma and the mysteries of Twilight, seeking enlightenment over worldly power." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:HermeticHouse ;
    skos:altLabel "Criamon" .

amol:HouseMerinita a rpg:Faction ;
    rpg:name "House Merinita" ;
    dc:description "A Mystery House deeply tied to the Faerie Realm, practicing faerie magic and guarding the secrets of the Fae." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:HermeticHouse ;
    skos:altLabel "Merinita" .

amol:HouseVerditius a rpg:Faction ;
    rpg:name "House Verditius" ;
    dc:description "A Mystery House of magical craftsmen who enchant items through Verditius magic, bound by oaths of secrecy and rivalry in their contests of craft." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:HermeticHouse ;
    skos:altLabel "Verditius" .

amol:HouseFlambeau a rpg:Faction ;
    rpg:name "House Flambeau" ;
    dc:description "A martial House of magi who excel at combat magic, heirs to the fiery legacy of their founder." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:HermeticHouse ;
    skos:altLabel "Flambeau" .

amol:HouseJerbiton a rpg:Faction ;
    rpg:name "House Jerbiton" ;
    dc:description "A House that values mundane civilization, art and beauty, and engages thoughtfully with the world beyond the covenant." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:HermeticHouse ;
    skos:altLabel "Jerbiton" .

amol:HouseTytalus a rpg:Faction ;
    rpg:name "House Tytalus" ;
    dc:description "A House that seeks out conflict and challenge of every kind as the path to growth and power." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:HermeticHouse ;
    skos:altLabel "Tytalus" .

amol:HouseExMiscellanea a rpg:Faction ;
    rpg:name "House Ex Miscellanea" ;
    dc:description "The largest and most diverse House, a refuge of hedge traditions and minor lineages gathered under Hermetic protection." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:HermeticHouse ;
    skos:altLabel "Ex Miscellanea" .

#################################################################
#  A selection of Tribunals — modeled as rpg:Faction (regional bodies)
#################################################################

amol:TribunalRhine a rpg:Faction ;
    rpg:name "The Rhine Tribunal" ;
    dc:description "The tradition-bound Tribunal of the Holy Roman Empire's heartlands, the 'Guardians of the Forests'." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Tribunal ;
    skos:altLabel "Rhine Tribunal" .

amol:TribunalNormandy a rpg:Faction ;
    rpg:name "The Normandy Tribunal" ;
    dc:description "A competitive, resource-poor Tribunal where covenants vie for vis through the system of redes and fairs." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Tribunal ;
    skos:altLabel "Normandy Tribunal" .

amol:TribunalTheban a rpg:Faction ;
    rpg:name "The Theban Tribunal" ;
    dc:description "The Tribunal of the Greek-speaking world, governed by Hellenic custom and the 'sundered eagle' of a divided empire." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Tribunal ;
    skos:altLabel "Theban Tribunal" .

amol:TribunalHibernian a rpg:Faction ;
    rpg:name "The Hibernian Tribunal" ;
    dc:description "The Tribunal of Ireland, the 'Contested Isle', shaped by its native traditions and tense relations with newcomers." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Tribunal ;
    skos:altLabel "Hibernian Tribunal" .

amol:TribunalTransylvanian a rpg:Faction ;
    rpg:name "The Transylvanian Tribunal" ;
    dc:description "The eastern Tribunal dominated by House Tremere, organized and hierarchical, standing 'against the dark'." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Tribunal ;
    skos:altLabel "Transylvanian Tribunal" .

amol:TribunalStonehenge a rpg:Faction ;
    rpg:name "The Stonehenge Tribunal" ;
    dc:description "The Tribunal of England, the 'Heirs to Merlin', rich in ancient magic and Arthurian legacy." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Tribunal ;
    skos:altLabel "Stonehenge Tribunal" .

amol:TribunalProvencal a rpg:Faction ;
    rpg:name "The Provençal Tribunal" ;
    dc:description "The Tribunal of southern France, of 'Faith & Flame', set against the upheaval of the Albigensian Crusade." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Tribunal ;
    skos:altLabel "Provençal Tribunal", "Provencal Tribunal" .

amol:TribunalLochLeglean a rpg:Faction ;
    rpg:name "The Loch Leglean Tribunal" ;
    dc:description "The Tribunal of Scotland, the 'Lion of the North', a wild and contested land of Highland magic." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Tribunal ;
    skos:altLabel "Loch Leglean Tribunal", "Loch Leglean" .

amol:TribunalRoman a rpg:Faction ;
    rpg:name "The Roman Tribunal" ;
    dc:description "The Tribunal centered on Rome and Italy, ancient seat of Hermetic and mundane power." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Tribunal ;
    skos:altLabel "Roman Tribunal", "Rome Tribunal" .

amol:TribunalGreaterAlps a rpg:Faction ;
    rpg:name "The Greater Alps Tribunal" ;
    dc:description "The Alpine Tribunal of the 'Sanctuary of Ice', a region of mountain covenants and hidden magic." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Tribunal ;
    skos:altLabel "Greater Alps Tribunal", "Greater Alps" .

#################################################################
#  The Order of Hermes (the overarching organization)
#################################################################

amol:OrderOfHermes a rpg:Faction ;
    rpg:name "The Order of Hermes" ;
    dc:description "The society of Hermetic magi founded by Bonisagus and Trianoma, organized into Houses and Tribunals and bound by the Code of Hermes." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:HermeticConcept ;
    skos:altLabel "Order of Hermes", "the Order" .

#################################################################
#  Core Hermetic Abilities (skills) — rpg:Proficiency
#################################################################

amol:ParmaMagica a rpg:Proficiency ;
    rpg:name "Parma Magica" ;
    dc:description "The Hermetic defense against magic, invented by Bonisagus; the personal magic resistance that made the Order possible." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility ;
    skos:altLabel "Parma Magica", "Parma" .

amol:MagicTheory a rpg:Proficiency ;
    rpg:name "Magic Theory" ;
    dc:description "The Ability that governs understanding of Hermetic magic: inventing spells, enchanting items and studying from books." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility ;
    skos:altLabel "Magic Theory" .

amol:Penetration a rpg:Proficiency ;
    rpg:name "Penetration" ;
    dc:description "The Ability and value determining whether a spell overcomes a target's Magic Resistance." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility ;
    skos:altLabel "Penetration" .

amol:Certamen a rpg:Proficiency ;
    rpg:name "Certamen" ;
    dc:description "The ritualized magical duel by which magi resolve disputes without resorting to Wizard's War." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility ;
    skos:altLabel "Certamen", "certamen" .

amol:Finesse a rpg:Proficiency ;
    rpg:name "Finesse" ;
    dc:description "The Ability governing precision and control when directing a spell's effect." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility ;
    skos:altLabel "Finesse" .

#################################################################
#  Core Hermetic Concepts & rules — rpg:Tag
#################################################################

amol:CodeOfHermes a rpg:Tag ;
    skos:prefLabel "The Code of Hermes" ;
    dc:description "The law of the Order of Hermes, sworn in the Hermetic Oath, forbidding magi from harming one another, dealing with devils, or endangering the Order." ;
    rpg:hasTag amol:HermeticConcept ;
    skos:altLabel "Code of Hermes", "Hermetic Code", "the Code" .

amol:HermeticOath a rpg:Tag ;
    skos:prefLabel "The Hermetic Oath" ;
    dc:description "The oath every magus swears on joining the Order, binding them to the Code of Hermes." ;
    rpg:hasTag amol:HermeticConcept ;
    skos:altLabel "Hermetic Oath" .

amol:PeripheralCode a rpg:Tag ;
    skos:prefLabel "The Peripheral Code" ;
    dc:description "The accumulated body of Tribunal rulings that interpret and extend the Code of Hermes." ;
    rpg:hasTag amol:HermeticConcept ;
    skos:altLabel "Peripheral Code" .

amol:Twilight a rpg:Tag ;
    skos:prefLabel "Twilight" ;
    dc:description "The mysterious altered state magi enter from excess magic; prolonged exposure leads to Final Twilight, removing a magus from the mortal world." ;
    rpg:hasTag amol:HermeticConcept ;
    skos:altLabel "Final Twilight" .

amol:Gauntlet a rpg:Tag ;
    skos:prefLabel "The Gauntlet" ;
    dc:description "The final test of apprenticeship, after which an apprentice becomes a full magus of the Order." ;
    rpg:hasTag amol:HermeticConcept .

amol:WizardsWar a rpg:Tag ;
    skos:prefLabel "Wizard's War" ;
    dc:description "A formally declared state of war between magi, the one circumstance in which the Code permits a magus to slay another." ;
    rpg:hasTag amol:HermeticConcept ;
    skos:altLabel "Wizards' War" .

amol:WizardsMarch a rpg:Tag ;
    skos:prefLabel "Wizard's March" ;
    dc:description "A Tribunal sentence declaring a magus an outlaw, stripped of the Code's protection so any magus may destroy them." ;
    rpg:hasTag amol:HermeticConcept .

amol:ArcaneConnection a rpg:Tag ;
    skos:prefLabel "Arcane Connection" ;
    dc:description "A physical or sympathetic link to a target that lets a magus reach it across any distance with magic." ;
    rpg:hasTag amol:HermeticConcept .

amol:MagicResistance a rpg:Tag ;
    skos:prefLabel "Magic Resistance" ;
    dc:description "The capacity to ward off magical effects, granted to magi chiefly by the Parma Magica." ;
    rpg:hasTag amol:HermeticConcept .

amol:LongevityRitual a rpg:Tag ;
    skos:prefLabel "Longevity Ritual" ;
    dc:description "A ritual that slows a magus's aging, prolonging life across centuries at the cost of fertility and warping." ;
    rpg:hasTag amol:HermeticConcept .

amol:TheGift a rpg:Tag ;
    skos:prefLabel "The Gift" ;
    dc:description "The innate capacity to work Hermetic magic; ordinarily it unsettles mundanes and animals, except for the rare Gentle Gift." ;
    rpg:hasTag amol:HermeticConcept ;
    skos:altLabel "Gentle Gift", "Blatant Gift" .

amol:Vis a rpg:Tag ;
    skos:prefLabel "Vis" ;
    dc:description "Raw magical power in physical form, the currency of magical effort, collected from sources and spent on rituals and study." ;
    rpg:hasTag amol:HermeticConcept ;
    skos:altLabel "vis" .

amol:Covenant a rpg:Tag ;
    skos:prefLabel "Covenant" ;
    dc:description "The home and community of a group of magi, the basic social unit of the Order, with its own resources, charter and politics." ;
    rpg:hasTag amol:HermeticConcept ;
    skos:altLabel "covenant", "covenants", "Covenants" .

#################################################################
#  Iconic spells — rpg:Spell
#################################################################

amol:AegisOfTheHearth a rpg:Spell ;
    rpg:name "Aegis of the Hearth" ;
    dc:description "The ritual ward that protects a covenant, weakening or barring hostile magic within its bounds." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell ;
    skos:altLabel "Aegis" .

amol:PilumOfFire a rpg:Spell ;
    rpg:name "Pilum of Fire" ;
    dc:description "An iconic attack spell hurling a javelin of flame; a signature of House Flambeau." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .

amol:DemonsEternalOblivion a rpg:Spell ;
    rpg:name "Demon's Eternal Oblivion" ;
    dc:description "A Perdo Vim spell that damages or destroys demons and other infernal beings." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell ;
    skos:altLabel "Demons Eternal Oblivion" .

#################################################################
#  Character types — rpg:Tag
#################################################################

amol:Magus a rpg:Tag ;
    skos:prefLabel "Magus" ;
    dc:description "A fully trained Hermetic wizard and member of the Order of Hermes; the central player-character type of Ars Magica." ;
    rpg:hasTag amol:CharacterType ;
    skos:altLabel "magus", "magi", "Magi", "maga", "Maga" .

amol:Grog a rpg:Tag ;
    skos:prefLabel "Grog" ;
    dc:description "A mundane soldier or servant of a covenant, the rank-and-file companions who guard and serve the magi." ;
    rpg:hasTag amol:CharacterType ;
    skos:altLabel "grog", "grogs", "Grogs" .

