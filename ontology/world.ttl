    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Daniel a rpg:Character ;
    rpg:name "Daniel" ;
    dc:description "Biblical figure who fixed a weigh-in with the help of God, whose miracle the abbot hopes to repeat." ;
