    rpg:name "The Ring of Terror" ;
    dc:description "Muto Mentem 35 constant ward causing terror to magi entering the graveyard ring." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheRiver a schema:Place ;
    rpg:name "The River" ;
