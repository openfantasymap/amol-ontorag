    rpg:name "Hypnotic Gaze" ;
    dc:description "A cantation (low-level formulaic spell for apprentices) listed in the book's contents." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Iacob a rpg:Character ;
    rpg:name "Iacob" ;
    dc:description "The most politically active magus of Irencillia, leader of the Elder Gild and apprentice of Handri; a master of Mentem magics running a secret project to establish a fae religion, identified as the Prophet of the God of Truth by his white crow caricature Nestor." ;
    skos:altLabel "Iacob filius Handri", "the Prophet Iacob" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Iain a rpg:Character ;
    rpg:name "Iain" ;
    dc:description "Vindolanda figure who can command the gate spirit to swallow the gatestone and seal off Scartaris from the mainland." ;
    skos:altLabel "Iain Mac Gabhan" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:IceOfDrowning a rpg:Spell ;
    rpg:name "Ice of Drowning" ;
    dc:description "A Rego Aquam spell (Level 35) that turns part of a body of water into jagged ice chunks that pound against anything on the surface, damaging swimmers and small boats." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:IciliusTheTraitor a rpg:Character ;
    rpg:name "Icilius the Traitor" ;
    dc:description "A 12th-century Verditius magus of the Normandy Tribunal who released the Inner Mystery Automata to the Order of Hermes and was hunted down and slain by Wizard's War." ;
    skos:altLabel "Icilius" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:IdaianDaktyls a rpg:Creature ;
    rpg:name "Idaian Daktyls" ;
    dc:description "Ten faeries (five male smiths, five female healers) who act as intercessors between Dindyméné and her worshipers and guard her xoanon; Faerie Might 30." ;
    skos:altLabel "Daktyl", "Daktyls", "Idaian Daktyl" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Iernilus a rpg:Character ;
    rpg:name "Iernilus" ;
    dc:description "Stubborn, fair-minded Quaesitor who drafted the Treaty of the Roman Tribunal, finalized in 1068." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:IkhwanAsSafa a rpg:Faction ;
    rpg:name "Ikhwan as-Safa'" ;
    dc:description "Brethren of Purity: secretive tenth-century Isma'ili fraternity from Basra teaching Philosophical Summoning and Refining through four grades." ;
    skos:altLabel "Brethren of Purity", "Brethren of Purity & Loyal Friends", "Ilkhwan as-Safa'", "The Brethren" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:IllegitimateLineage a rpg:Tag ;
    skos:prefLabel "Illegitimate Lineage" ;
    dc:description "Minor Hermetic Flaw for a member of House Mercere not descended by blood from Mercere, giving a poor reputation and denying House benefits." ;
    rpg:hasTag amol:Flaw .
amol:Illumination a rpg:Tag ;
    skos:prefLabel "Illumination" ;
    dc:description "Angelic mode of communication conveying the essence of a message directly to the soul, with Penetration zero." ;
    rpg:hasTag amol:HermeticConcept .
amol:IllusionOfCoolFlames a rpg:Spell ;
    rpg:name "Illusion of Cool Flames" ;
    dc:description "A Perdo Imaginem spell (Level 10) that makes a source of heat seem to lose its heat and drop to surrounding temperature, while it still has its normal beneficial and harmful effects." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:IllusionOfTheShiftedImage a rpg:Spell ;
    rpg:name "Illusion of the Shifted Image" ;
    dc:description "A Rego Imaginem spell (Level 10) that makes any person or object appear a pace away from its actual position; the spell ends as soon as the original or image moves." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:IllusionaryHome a rpg:Tag ;
    skos:prefLabel "Illusionary Home" ;
    dc:description "Faerie power using glamour to make a place look, sound, smell and feel like a suitable home for the faerie's role; used by the Ghula." ;
    rpg:hasTag amol:HermeticConcept .
amol:ImageOfTheBeast a rpg:Spell ;
    rpg:name "Image of the Beast" ;
    dc:description "An Intellego Animal spell (Level 5) that gives a hazy mental image of an animal to which the caster has an Arcane Connection, useful for identifying an attacker." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Imbolc a rpg:Tag ;
    skos:prefLabel "Imbolc" ;
    dc:description "Quarter day on February 1, the Feast of St. Bride." ;
    skos:altLabel "Feast of St. Bride" ;
    rpg:hasTag amol:HermeticConcept .
amol:ImbuedWithTheSpiritOfForm a rpg:Tag ;
    skos:prefLabel "Imbued with the Spirit of (Form)" ;
    dc:description "A Minor, Hermetic Virtue letting a magus who absorbed an elemental's powers substitute Long-Term Fatigue for vis of the chosen Form." ;
    rpg:hasTag amol:Virtue .
amol:Immortals a rpg:Creature ;
    rpg:name "Immortals" ;
    dc:description "In House Criamon's cosmology, a perfect race of spiritual beings that fell into the material world; magi (or all people) are reincarnated immortals." ;
    skos:altLabel "Amesha Spentas" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:ImmuneToDisease a rpg:Tag ;
    skos:prefLabel "Immune to Disease" ;
    dc:description "Major Supernatural Tainted Virtue marking the character as property of a powerful demon so that lesser disease demons refuse to harm him." ;
    rpg:hasTag amol:Virtue .
amol:ImpedeTheImpertinentInterloper a rpg:Spell ;
    rpg:name "Impede the Impertinent Interloper" ;
    dc:description "PeVi General spell cancelling instant transportation into or out of a circle." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ImprovedAbilities a rpg:Tag ;
    skos:prefLabel "Improved Abilities" ;
    dc:description "Virtue or creature Quality listed for a being (Anne, Minerva Sulis, Balneator) or setting feature described here." ;
    rpg:hasTag amol:Virtue .
amol:ImprovedCharacteristic a rpg:Tag ;
    skos:prefLabel "Improved Characteristic" ;
    dc:description "A General Virtue from the core ArM5 rules listed as inappropriate for imbuing into a figurine via Figurine Magic." ;
    rpg:hasTag amol:Virtue .
amol:ImprovedVoiceRange a rpg:Tag ;
    skos:prefLabel "Improved Voice Range" ;
