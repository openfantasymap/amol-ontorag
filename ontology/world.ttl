    rpg:hasTag amol:NamedSpell .
amol:TheAppropriateAttire a rpg:Spell ;
    rpg:name "The Appropriate Attire" ;
    dc:description "MuAn 4 cantation that changes the color and cut of leather, wool or fur clothing, giving +1 to Etiquette or Charm." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheAshOfNortorf a rpg:Creature ;
    rpg:name "The Ash of Nortorf" ;
    dc:description "An infernal entity (Infernal Might 15, potential 60) manifesting as an ash seedling in the churchyard of Nortorf; prophesied to grow into a tree that will bring a king with fell powers if a black horseman defeats the white horseman." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:TheBeast a rpg:Character ;
    rpg:name "The Beast" ;
    dc:description "The Beast from Beauty and the Beast, initially a threat, then needing help, then giving rewards." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:TheBeastRemade a rpg:Spell ;
    rpg:name "The Beast Remade" ;
