    skos:prefLabel "Inspirational" ;
    dc:description "A Minor, General Virtue making a character a stirring speaker or heroic figure, granting targets +3 to appropriate Personality Trait rolls." ;
    rpg:hasTag amol:Virtue .
amol:Intrigue a rpg:Proficiency ;
    rpg:name "Intrigue" ;
    dc:description "An Ability factors use to hire skilled criminals and to find allies or spread gossip against noble targets; combined with Communication or Intelligence in skullduggery and indirect action." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:Latin a rpg:Proficiency ;
    rpg:name "Latin" ;
    dc:description "The scholarly language ability; a magus can rewrite up to Latin x 20 levels of Laboratory Texts per season to make them usable by others, and literacy in Latin is required to write or copy Lab Texts." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:Lycanthrope a rpg:Tag ;
    skos:prefLabel "Lycanthrope" ;
    dc:description "A Flaw causing loss of control over an inner heartbeast for a few nights each month; some Great Beasts inflict it on their Initiates, and it is a major hindrance within House Bjornaer." ;
    skos:altLabel "Lycanthrope Flaw", "Lycanthropy", "shapechanger" ;
    rpg:hasTag amol:Flaw .
amol:MercerHouse a rpg:Tag ;
    skos:prefLabel "Mercer House" ;
    dc:description "Powerful permanent magical gateways crafted by House Mercere, enchanted with the Hermes Portal effect; each connects to one matching pair, with hubs at Harco and Durenmar." ;
    skos:altLabel "Mercer Houses", "Mercere House", "Mercere Portal", "Portal" ;
    rpg:hasTag amol:HermeticConcept .
amol:Murion a rpg:Character ;
    rpg:name "Murion" ;
    dc:description "Prima of House Bonisagus and Praeco of the Rhine Tribunal, a powerful and overbearing archmagus who presents her plan to recolonize the Rhine Gorge to the new magi at the Forum of Durenmar." ;
    skos:altLabel "Archmaga Murion", "Prima Murion", "Prima of Bonisagus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Pralix a rpg:Character ;
    rpg:name "Pralix" ;
    dc:description "The founder of the Lineage and the Ordo Miscellanea who defeated Damhan-Allaidh, learned a Supernatural Ability from an ancient wizard, and integrated her order into the Order of Hermes." ;
    skos:altLabel "Pralix filia Tytalus", "Pralix the pupil of Tytalus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:SenseHolinessAndUnholiness a rpg:Proficiency ;
    rpg:name "Sense Holiness and Unholiness" ;
    dc:description "A Supernatural Ability granted by the Divine realm to feel the presence of good and evil in areas, persons, or objects, including detecting demons and angels." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:SubtleMagic a rpg:Tag ;
    skos:prefLabel "Subtle Magic" ;
    dc:description "A Hermetic Virtue letting a magus cast spells without gestures, exemplified by the Sorcerous Musician Orlando who can cast while playing or singing." ;
    rpg:hasTag amol:Virtue .
amol:TheChirurgeonSHealingTouch a rpg:Spell ;
    rpg:name "The Chirurgeon's Healing Touch" ;
    dc:description "A Creo Corpus spell (CrCo20) that magically closes wounds; under Unnatural Magic, wounds it closes reopen because the magic lasts only a moment." ;
    skos:altLabel "Chirurgeon's Healing Touch, The", "CrCo20" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Urgen a rpg:Character ;
    rpg:name "Urgen" ;
    dc:description "An Archmage of House Bjornaer (heartbeast of a bear) holding the Seat of the Bear at Crintera; former Primus (1165-1203), leader of the Hawthorn Gild and the most influential Wilderist." ;
    skos:altLabel "Archmage Urgen", "Archmage Urgen Midusulfis Twin-Slayer", "Archmagus Urgen", "Primus Urgen" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:WindOfMundaneSilence a rpg:Spell ;
    rpg:name "Wind of Mundane Silence" ;
    dc:description "A Perdo Vim spell that raises a metaphorical breeze canceling the effects of spells in an area, and can dispel Parma Magica if it penetrates strongly enough." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:BlackForest a schema:Place ;
    rpg:name "Black Forest" ;
    dc:description "The largest forest in western Europe in the south-west of the Rhine Tribunal, an impenetrable sinister faerie wilderness with a Faerie aura, ruled by the King of the Black Mountain." ;
    skos:altLabel "Schwarzwald" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Craft a rpg:Proficiency ;
    rpg:name "Craft" ;
    dc:description "The skill governing a craftsman's production; a character's Craft Ability score determines Workshop Totals and how many items can be produced in a season." ;
    skos:altLabel "Blacksmith", "Craft (Type)", "Craft Ability", "Swordsmith" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:Crintera a rpg:Faction ;
    rpg:name "Crintera" ;
    dc:description "The domus magna of House Bjornaer, located on the island of Rügen in the Eastern Marches, organized around six council seats of Elders and divided into six clans. Its turb is the fiercest and most bestial of the Rhine covenants." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:Demon a rpg:Creature ;
    rpg:name "Demon" ;
    dc:description "Infernal beings made of the essence of deception; summoning and dealing with them is forbidden in the Order, they cannot be reliably detected, and they can be fought with Vim magic." ;
    skos:altLabel "demonkind", "demons", "devils", "diabolist", "diabolists", "fallen angels" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:DomusMagna a rpg:Tag ;
    skos:prefLabel "Domus Magna" ;
    dc:description "The principal covenant of a Hermetic House, many of which have excellent libraries focused on their House's interests; examples include Durenmar and the Cave of Twisting Shadows." ;
    skos:altLabel "domus magnae" ;
    rpg:hasTag amol:HermeticConcept .
amol:FaerieFriend a rpg:Tag ;
    skos:prefLabel "Faerie Friend" ;
    dc:description "A Flaw taken as an Ordeal in the sample Line of Quendalon Initiation, representing a befriended faerie appropriate to the Initiate's highest Technique and Form." ;
    skos:altLabel "Faerie Friend Flaw" ;
    rpg:hasTag amol:Flaw .
amol:Fengheld a rpg:Faction ;
    rpg:name "Fengheld" ;
    dc:description "One of the two most powerful Rhine covenants, founded in the Harz Mountains in 1039 by veteran Tremere and Flambeau magi; rival to Durenmar and keen to found a chapter house in the Rhine Gorge." ;
    skos:altLabel "Fengheld House" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:FlawlessMagic a rpg:Tag ;
    skos:prefLabel "Flawless Magic" ;
    dc:description "A Major, Hermetic Virtue that automatically masters every spell learned at Spell Mastery 1 and doubles Spell Mastery Advancement Totals." ;
    rpg:hasTag amol:Virtue .
amol:InfernalLore a rpg:Proficiency ;
    rpg:name "Infernal Lore" ;
    dc:description "An Arcane Ability concerning knowledge of the Infernal; the Diabolic Past Flaw permits its purchase even when Arcane Abilities are normally restricted." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:MythicBlood a rpg:Tag ;
    skos:prefLabel "Mythic Blood" ;
    dc:description "A Virtue marking descent from a supernatural ancestor such as Birna or a Great Beast, granting a magical feat spell, a Minor Magical Focus, and a hereditary Personality Flaw." ;
    skos:altLabel "Mythic Blood Virtue" ;
    rpg:hasTag amol:Virtue .
amol:NecessaryCondition a rpg:Tag ;
    skos:prefLabel "Necessary Condition" ;
    dc:description "A Flaw imposed as a Great Beast's Ordeal requiring a condition for magic (e.g., a bull chimera touching the ground); also a common Bjornaer flaw when in human or heartbeast form." ;
    rpg:hasTag amol:Flaw .
amol:OrderOfOdin a rpg:Faction ;
    rpg:name "Order of Odin" ;
    dc:description "A putative organized group of powerful pagan Norse wizards in Scandinavia, a long-standing threat and bugbear of the Order of Hermes whose very existence remains unconfirmed." ;
    skos:altLabel "Norse wizards", "Scandinavian wizards", "rumored Order of Odin" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Sanctum a rpg:Tag ;
    skos:prefLabel "Sanctum" ;
    dc:description "An area, usually a magus's laboratory and living quarters, designated under Hermetic law; by a ruling of the Grand Tribunal of 997 it must be marked by a circle inscribed in a square with diagonals." ;
    skos:altLabel "sancta", "sanctum marker" ;
    rpg:hasTag amol:HermeticConcept .
amol:SelfConfident a rpg:Tag ;
    skos:prefLabel "Self-Confident" ;
    dc:description "A Virtue shared by all magi who survive a Tytalan apprenticeship, earned upon defeating one's master in the Apprentice's Gauntlet." ;
    skos:altLabel "Self Confident", "Self Confident Virtue" ;
    rpg:hasTag amol:Virtue .
amol:SocialContacts a rpg:Tag ;
    skos:prefLabel "Social Contacts" ;
    dc:description "A Virtue providing useful social connections; gained temporarily by a marriage broker, and possessed by smugglers and their suppliers because many people sympathize with them." ;
    rpg:hasTag amol:Virtue .
amol:Vow a rpg:Tag ;
    skos:prefLabel "Vow" ;
    dc:description "A Minor Personality Flaw representing a solemn religious obligation, taken by priests for celibacy and by Cathar Perfecti and Mazdean priests for ritual purity." ;
    skos:altLabel "Vow (Pacifism)", "Vow (celibacy)", "Vow Flaw" ;
    rpg:hasTag amol:Flaw .
amol:Waddenzee a rpg:Faction ;
    rpg:name "Waddenzee" ;
    dc:description "A Rhine covenant whose piracy thwarts Oculus Septentrionalis's mercantile ambitions; some members are Ash Gild members who exterminate non-Hermetic Norse wizards, and it figures in demon Gymir's plans." ;
    skos:altLabel "Terschelling" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:Warrior a rpg:Tag ;
    skos:prefLabel "Warrior" ;
    dc:description "A Minor General Virtue: the character is trained to fight, may acquire Martial Abilities at creation, and gains 50 experience points spent on Martial Abilities." ;
    rpg:hasTag amol:Virtue .
amol:WaysOfTheForest a rpg:Tag ;
    skos:prefLabel "Ways of the Forest" ;
    dc:description "A Virtue common among the exsules and suggested for werewolf companions (as Ways of the Land), reflecting deep attunement to a wilderness area." ;
    skos:altLabel "Way of the Dunes", "Ways of the (Land)", "Ways of the Mountain", "Ways of the Steppe", "Ways of the Town" ;
    rpg:hasTag amol:Virtue .
amol:WeakMagicResistance a rpg:Tag ;
    skos:prefLabel "Weak Magic Resistance" ;
    dc:description "A Flaw under which those knowing a magus's secret name need not subtract spell level from Penetration; acquired as a minor Ordeal in the Secret Name Initiation." ;
    skos:altLabel "Limited Magic Resistance", "Limited Magic Resistance to Vim" ;
    rpg:hasTag amol:Flaw .
amol:AgonyOfTheBeast a rpg:Spell ;
    rpg:name "Agony of the Beast" ;
    dc:description "A Perdo Animal spell (Level 15) that causes a beast to lash about wildly and howl in great pain, hindering its actions." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:AppleGild a rpg:Faction ;
    rpg:name "Apple Gild" ;
    dc:description "A Rhine political gild founded by western covenants seeking to push the limits of the Code through mundane dealings; described disparagingly as a front for mundane meddling." ;
    skos:altLabel "Apple Gild Trained", "the Apple" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:CircularWardAgainstDemons a rpg:Spell ;
    rpg:name "Circular Ward Against Demons" ;
    dc:description "A Rego Vim spell (R: Touch, D: Ring, T: Circle) that prevents creatures with Infernal Might equal to or less than its level from entering a circle or harming those within; at night it may appear as a silver-hued dome." ;
    skos:altLabel "Circle Ward Against Demons" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ClanIlfetu a rpg:Faction ;
    rpg:name "Clan Ilfetu" ;
    dc:description "A clan within House Bjornaer that gives extra ritual training and teaches the Divination method of haemagmomancy (divination by the blood splatters of wounded animals)." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Dankmar a rpg:Faction ;
    rpg:name "Dankmar" ;
    dc:description "A wilderness Rhine covenant occupied by Aschlaranda and her apprentice Schadrit; recognized as a Rhine covenant in 1067 and later accused Durenmar of faerie molestation." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:Diana a rpg:Creature ;
    rpg:name "Diana" ;
    dc:description "The mater of Theoderic; the last magus to attempt to reach the Lunar Sphere, she was blasted into fragments of glass in a laboratory accident, and a Fallen Temple at the covenant is dedicated to her." ;
    skos:altLabel "Diana Nemorensis", "Diana of the Wood", "Mother Goddess", "the Goddess Diana" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:DominionLore a rpg:Proficiency ;
    rpg:name "Dominion Lore" ;
    dc:description "A supernatural Ability covering knowledge of the Divine realm; the angels Seferiel (Divine Lore 10) and Nasir (Dominion Lore 8) both have it with a specialty in angels." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:ElderGild a rpg:Faction ;
    rpg:name "Elder Gild" ;
    dc:description "A gild that split from the Hawthorn Gild to pursue a fae-focused agenda, concentrating on preserving faeries and friendly contact with them; led by Iacob of Irencillia and made up mostly of Merinita magi." ;
    skos:altLabel "Elder Gilds" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Falke a rpg:Character ;
    rpg:name "Falke" ;
    dc:description "The Prima of House Bjornaer who seeks to end animosity with non-Hermetic shapeshifters and admit them to the House; leader of the Harmonist faction who becomes besieged on Rügen during the Crintera Schism." ;
    skos:altLabel "Falke Bjornaer", "Falke of Bjornaer", "Falke, Prima of Bjornaer", "Prima Falke", "Prima of House Bjornaer" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:FolkKen a rpg:Proficiency ;
    rpg:name "Folk Ken" ;
    dc:description "An Ability used (with Awareness) to recognize hidden social or behavioral patterns, such as identifying the mushroom circle as dance steps." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:FormulaicMagic a rpg:Tag ;
    skos:prefLabel "Formulaic Magic" ;
    dc:description "A category of Hermetic spell with fixed parameters, distinct from Spontaneous and Ritual magic, affected by Virtues like Boosted and Flexible Formulaic Magic." ;
    skos:altLabel "Formulaic", "Formulaic Spellcasting", "Formulaic spell", "Formulaic spells" ;
    rpg:hasTag amol:HermeticConcept .
amol:FrostyBreathOfTheSpokenLie a rpg:Spell ;
    rpg:name "Frosty Breath of the Spoken Lie" ;
    dc:description "An Intellego Mentem spell (Level 20) that makes a target exhale misty breath with each spoken lie; House Guernicus brought it to the Order and it is essential to Quaesitors." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:HolyRomanEmpire a rpg:Character ;
    rpg:name "Holy Roman Empire" ;
    dc:description "The greatest Christian realm on earth, of which Germany is part; its emperor is crowned by the Pope, and the Rhine Tribunal extends over its lands north of the Alps." ;
    skos:altLabel "Emperor Frederick II", "Frederick II", "German Empire", "Holy Roman Emperor", "the Empire", "the Holy Roman Emperor", "the empire" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:KeenVision a rpg:Tag ;
    skos:prefLabel "Keen Vision" ;
    dc:description "A Minor Virtue acquirable by a Bjornaer inner heartbeast, appropriate for an eagle heartbeast and possessed by crows, eagles, and wild goats." ;
    rpg:hasTag amol:Virtue .
amol:KnightsTemplar a rpg:Faction ;
    rpg:name "Knights Templar" ;
    dc:description "A military order of monk-knights founded by Hugh de Payns and Godfrey of St. Omer in 1118, notable for banking and building round churches including one in London." ;
    skos:altLabel "Poor Knights of the Temple of Solomon", "Templar", "Templars", "the order" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Lame a rpg:Tag ;
    skos:prefLabel "Lame" ;
    dc:description "A Minor General Flaw in which both of the character's legs are severely damaged, requiring crutches and heavily penalizing movement and combat." ;
    skos:altLabel "Crippled", "Hobbled" ;
    rpg:hasTag amol:Flaw .
amol:MagisterInMedicina a rpg:Tag ;
    skos:prefLabel "Magister in Medicina" ;
    dc:description "A Major Social Status Virtue for a character who graduated from a higher university faculty; the highest educational license in Mythic Europe, granting 300 experience points and Academic Reputation 3." ;
    skos:altLabel "Doctor in legibus", "Doctor in medicina", "Doctor in theologia" ;
    rpg:hasTag amol:Virtue .
amol:Myanar a rpg:Character ;
    rpg:name "Myanar" ;
    dc:description "A figure who challenged Quendalon for leadership of the cult of Diana and was slain by him; his followers fled to House Bjornaer and founded the rival secret cult that became the Huntress." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:OculusSeptentrionalis a rpg:Faction ;
    rpg:name "Oculus Septentrionalis" ;
    dc:description "A Rhine Tribunal covenant based in Lubeck, dominated by Jerbiton magi and merchants and lacking a Magic aura at its city site; deeply involved in commerce and the genesis of the Hanseatic League." ;
    skos:altLabel "Eye of the North" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:Outsider a rpg:Tag ;
    skos:prefLabel "Outsider" ;
    dc:description "A Minor or Major Social Status Flaw in which the character belongs to an identifiable group that is distrusted or disliked, giving a bad Reputation among the dominant social group." ;
    skos:altLabel "the Outsider Flaw" ;
    rpg:hasTag amol:Flaw .
amol:PiercingGaze a rpg:Tag ;
    skos:prefLabel "Piercing Gaze" ;
    dc:description "A Minor General Virtue letting a character unsettle people with an intent stare and gain +3 to intimidation rolls; faeries and demons are unaffected." ;
    rpg:hasTag amol:Virtue .
amol:PuissantPerdo a rpg:Tag ;
    skos:prefLabel "Puissant Perdo" ;
    dc:description "A Virtue granting bonus effectiveness with an Art or Ability; House Flambeau offers a choice of Puissant Perdo or Puissant Ignem as its House Virtue." ;
    skos:altLabel "Puissant Art (Ignem)", "Puissant Art (Perdo)", "Puissant Ignem", "Puissant Magic Theory" ;
    rpg:hasTag amol:Virtue .
amol:QuietMagic a rpg:Tag ;
    skos:prefLabel "Quiet Magic" ;
    dc:description "A Virtue (also called Quiet Magic) that the Silent Ones league seeks to integrate into standard Hermetic practice for casting inconspicuously in cities." ;
    rpg:hasTag amol:Virtue .
amol:Reputation a rpg:Tag ;
    skos:prefLabel "Reputation" ;
    dc:description "A game trait representing how a character is known in society; deep cover disguises establish a Reputation that grows like an Ability and offsets the social penalty of The Gift." ;
    skos:altLabel "Ecclesiastical Reputation", "Hermetic Reputation", "Local Reputation", "Reputations" ;
    rpg:hasTag amol:HermeticConcept .
amol:ScholaPythagoranis a rpg:Faction ;
    rpg:name "Schola Pythagoranis" ;
    dc:description "A Hermetic covenant sited on the edge of Cambridge whose magi disguise themselves as a scholarly organization; it invited fleeing Oxford masters to Cambridge and was visited by Robert Grosseteste." ;
    skos:altLabel "School of Pythagoras", "The School of Pythagoras" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:SpontaneousMagic a rpg:Tag ;
    skos:prefLabel "Spontaneous Magic" ;
    dc:description "Magic producing effects not corresponding to a spell the magus knows, decided at the moment of casting; can be fatiguing or non-fatiguing." ;
    skos:altLabel "Spontaneous", "Spontaneous Spellcasting", "Spontaneous spell", "Spontaneous spells" ;
    rpg:hasTag amol:HermeticConcept .
amol:StudyRequirement a rpg:Tag ;
    skos:prefLabel "Study Requirement" ;
    dc:description "A Major Hermetic Flaw in which the character cannot study magic from books or vis alone, but must study in the presence of the appropriate Art." ;
    rpg:hasTag amol:Flaw .
amol:SusceptibilityToInfernalPower a rpg:Tag ;
    skos:prefLabel "Susceptibility to Infernal Power" ;
    dc:description "A Minor Hermetic Flaw in which the character is especially vulnerable to dark powers, risking illness in Infernal auras and having halved Magic Resistance against infernal effects." ;
    skos:altLabel "Susceptibility to Divine Power" ;
    rpg:hasTag amol:Flaw .
amol:TheLeapOfHomecoming a rpg:Spell ;
    rpg:name "The Leap of Homecoming" ;
    dc:description "A teleportation spell; each Redcap carries an enchanted item casting a higher-level version once per day to return himself and his horse to Mercer House." ;
    skos:altLabel "Leap Of Homecoming, The" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ThebesTribunal a rpg:Faction ;
    rpg:name "Thebes Tribunal" ;
    dc:description "A Tribunal where vis is scarce and magical animals plentiful, where Verditius magi developed the Bind Magical Creatures Mystery." ;
    skos:altLabel "Thebes", "Tribunal of Thebes" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Tribunal .
amol:Theology a rpg:Proficiency ;
    rpg:name "Theology" ;
    dc:description "The highest-ranked Academic Ability concerning religious doctrine, with faith-specific variants (Christian, Islamic, Judaic) used for writing books and disputationes against other faiths." ;
    skos:altLabel "Christian Theology", "Islam Theology" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:Tough a rpg:Tag ;
    skos:prefLabel "Tough" ;
    dc:description "A Minor Virtue acquirable by a Bjornaer inner heartbeast and suitable for beasts such as the bear, boar, and wolf; stacks with Thick Fur and Tough Hide for Protection." ;
    rpg:hasTag amol:Virtue .
amol:TrueLove a rpg:Tag ;
    skos:prefLabel "True Love" ;
    dc:description "A Minor General Virtue: the character has found the one person meant for them, giving +3 to appropriate Personality Trait rolls; the True Love must be another player character with this Virtue." ;
    skos:altLabel "True Friend", "True Love (NPC)", "True Love (PC)", "True Love Virtue" ;
    rpg:hasTag amol:Virtue .
amol:UniversityOfParis a schema:Place ;
    rpg:name "University of Paris" ;
    dc:description "An influential medieval university that in 1220 has banned teaching the New Aristotle under threat of excommunication, with its bans echoing throughout northern Europe." ;
    skos:altLabel "Paris" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:VerditiusMagic a rpg:Tag ;
    skos:prefLabel "Verditius Magic" ;
    dc:description "The Outer Mystery of House Verditius allowing magi to incorporate craft Abilities into enchantment, add Verditius Runes for bonuses, and reduce vis costs, but requiring casting tools to cast Formulaic and Ritual spells." ;
    rpg:hasTag amol:Virtue .
amol:Visions a rpg:Tag ;
    skos:prefLabel "Visions" ;
    dc:description "A Flaw that gives the bearer prophetic dreams or visions; Maria has it to predict the volcano, Adranus can grant it, and Valkyries possess it to know where worthy men will die." ;
    rpg:hasTag amol:Flaw .
amol:WizardSCommunion a rpg:Spell ;
    rpg:name "Wizard's Communion" ;
    dc:description "A Hermetic ritual spell cast cooperatively by between three and twelve magi; a life-sized diagram for it appears in the biggest codex of the Durenmar Library, and it may be led dangerously from a casting tablet." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Apprentice a rpg:Tag ;
    skos:prefLabel "Apprentice" ;
    dc:description "A magus-in-training whose Arts are opened by a master over a season; the master must extend Parma Magica to cover the apprentice and meet score requirements to avoid Deficiencies." ;
    skos:altLabel "discipulus" ;
    rpg:hasTag amol:CharacterType .
amol:Archmage a rpg:Tag ;
    skos:prefLabel "Archmage" ;
    dc:description "A free Social Status Virtue applicable to any Tribunal, granting the title archimagus, a high Hermetic Reputation, and an additional proxy vote in the Rhine." ;
    skos:altLabel "Archmaga", "Archmagi", "archmage contest", "archmagus" ;
    rpg:hasTag amol:CharacterType .
amol:AreaLore a rpg:Proficiency ;
    rpg:name "Area Lore" ;
    dc:description "A Lore Ability whose score governs knowledge of local lacunae and familiarity with the similes of objects occurring in an area; can be specialized in lacunae." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:Arthur a rpg:Character ;
    rpg:name "Arthur" ;
    dc:description "A claimant given into Hubert de Burgh's custody by King John, who ordered him killed; Hubert refused and feigned it, but John later took Arthur and he was never seen alive again." ;
    skos:altLabel "King Arthur" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Bologna a schema:Place ;
    rpg:name "Bologna" ;
    dc:description "A famous student-run university in northern Italy, the finest legal school in Mythic Europe, organized around student nations and faculties of Law and of Arts and Medicine." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Brawl a rpg:Proficiency ;
    rpg:name "Brawl" ;
    dc:description "The combat Ability used for unarmed and natural-weapon attacks; all natural weapons (teeth, claws, hooves) use Brawl, and bulls have an Affinity with it." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:BroomOfTheWinds a rpg:Spell ;
    rpg:name "Broom of the Winds" ;
    dc:description "A Creo Auram spell (Level 15) that whips up violent swirling winds around a target who must make rolls to remain standing." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:CadGadu a rpg:Faction ;
    rpg:name "Cad Gadu" ;
    dc:description "The domus magna of House Ex Miscellanea on an island in a Welsh lake within a strong magical regio; site of the final battle against Damhan-Allaidh, formerly home of the Columbae." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:Charlemagne a rpg:Character ;
    rpg:name "Charlemagne" ;
    dc:description "The Frankish ruler who attempted (and failed) to dig a canal linking the Main and Danube, and whose late-eighth-century monetary reforms fixed the pound-of-silver system used in Mythic Europe in 1220." ;
    skos:altLabel "Carolus Magnus", "Karl der Grosse" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Charm a rpg:Proficiency ;
    rpg:name "Charm" ;
    dc:description "Casting aids made by magi who study Faerie Magic that identify a magical effect through sympathetic magic; they may be objects, performances, or pronouncements, and can boost Penetration and Casting Totals." ;
    skos:altLabel "permanent charm", "story charm", "temporary charm" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:ClearThinker a rpg:Tag ;
    skos:prefLabel "Clear Thinker" ;
    dc:description "A Virtue that decreases the penalties for reduced Fatigue Levels in debate by one point and is recommended for politically minded Tytalan magi." ;
    rpg:hasTag amol:Virtue .
amol:CloseFamilyTies a rpg:Tag ;
    skos:prefLabel "Close Family Ties" ;
    dc:description "A Minor Story Flaw: the character's family is one of the most important things in their life and supports them even at personal risk, but requires help in return." ;
    rpg:hasTag amol:Virtue .
amol:Darius a rpg:Character ;
    rpg:name "Darius" ;
    dc:description "A magus of House Flambeau with a Warping Score of 6 who, while hunting a Renounced magus, botches a spell, enters Twilight, and gains a Twilight Scar making dead meat he touches seem rotten." ;
    skos:altLabel "Darius of Flambeau", "Uwe" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Dominicans a rpg:Faction ;
    rpg:name "Dominicans" ;
    dc:description "An orthodox religious Order whose friars at Paris live in private hospices, strictly adhere to papal authority, and criticize teachers of possibly heretical ideas." ;
    skos:altLabel "Black Friars", "Dominican Order", "Dominican friars", "Dominican order", "Dominician Friars", "Order of Preachers", "friars of St. Dominic" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Dowsing a rpg:Proficiency ;
    rpg:name "Dowsing" ;
    dc:description "A Supernatural Ability to find things nearby using a dowsing rod and an intuitive sense, requiring a sympathetic connection to the thing sought." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:Dutybound a rpg:Tag ;
    skos:prefLabel "Dutybound" ;
    dc:description "A Flaw binding a character to a sense of duty; those with this Flaw who partake of Honos' Centurions' Feast are instantly cured of Light and Medium Wounds." ;
    rpg:hasTag amol:Flaw .
amol:Favors a rpg:Tag ;
    skos:prefLabel "Favors" ;
    dc:description "A Story Flaw representing being an agent who is periodically contacted by a principal or factor to provide information or assistance; also a minor inconvenient flaw on the Resistance table." ;
    skos:altLabel "Favor" ;
    rpg:hasTag amol:Flaw .
amol:GhostlyWarder a rpg:Tag ;
    skos:prefLabel "Ghostly Warder" ;
    dc:description "A bound ghost covenfolk template with Magic Might 10 (Mentem), insubstantial and invisible, that stands watch over a covenant; bound magically rather than haunting." ;
    rpg:hasTag amol:Virtue .
amol:GiantBlood a rpg:Tag ;
    skos:prefLabel "Giant Blood" ;
    dc:description "A Virtue indicating descent from giants, cited as a possible background Virtue for an Ex Miscellanea magus and common among the Damhadh-Duidsan." ;
    rpg:hasTag amol:Virtue .
amol:Handri a rpg:Character ;
    rpg:name "Handri" ;
    dc:description "The Primus of House Merinita, an obsessively secretive man aged 81 who has turned his attentions to the faeries and a secret project to establish a religion in the name of the fae; his caricature is Rosmert, Queen of Irencillia's fae." ;
    skos:altLabel "Iacob filius Handri's father", "Primus Handri" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Harco a rpg:Faction ;
    rpg:name "Harco" ;
    dc:description "The covenant of House Mercere in the Roman Tribunal, reachable from Durenmar via the Mercere Portal and a destination for Redcaps." ;
    skos:altLabel "Covenant of Harco" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:HawthornGild a rpg:Faction ;
    rpg:name "Hawthorn Gild" ;
    dc:description "A political/philosophical gild of the Rhine Tribunal led by Urgen, with which Balastor's primal philosophy is in concordance; it argued for retaliatory strikes for Crintera." ;
    skos:altLabel "Hawthorn" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:HenryIII a rpg:Character ;
    rpg:name "Henry III" ;
    dc:description "The twelve-year-old king of England in 1220 (born 1207, crowned 1216), a minor under the regency triumvirate; pious, devoted to St. Edward the Confessor, with a love of hunting and luxury." ;
    skos:altLabel "Henry", "King Henry", "King Henry III of England", "the young king" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Heorot a rpg:Faction ;
    rpg:name "Heorot" ;
    dc:description "A covenant recently founded on Zealand to discover more about the wizards of the North; closely allied to Oculus Septentrionalis and in conflict with the martial Waddenzee." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:Hercynius a rpg:Character ;
    rpg:name "Hercynius" ;
    dc:description "A Bonisagus magus whose lineage, the Hercynian magi of the Waldherz chapter, maintained harmony with the Black Forest fae before being exiled and eradicated during the Schism War." ;
    skos:altLabel "tradition of Hercynius" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Hoplite a rpg:Tag ;
    skos:prefLabel "Hoplite" ;
    dc:description "An informal group of combat magi, many from House Flambeau, who work with the Quaesitores to hunt down and slay magi cast out of the Order for crimes." ;
    skos:altLabel "Hoplites" ;
    rpg:hasTag amol:CharacterType .
amol:IncompatibleArts a rpg:Tag ;
    skos:prefLabel "Incompatible Arts" ;
    dc:description "A Minor Hermetic Flaw in which the character is completely unable to use two specified combinations of Techniques and Forms." ;
    skos:altLabel "Incompatible Arts (MuCo & PeAn)" ;
    rpg:hasTag amol:Flaw .
amol:Jinn a rpg:Creature ;
    rpg:name "Jinn" ;
    dc:description "A Free Virtue marking a category of spirits associated with the Islamic lands, who are all vulnerable to Sahir magic and may belong to the Magic, Faerie, or Infernal realms." ;
    skos:altLabel "Infernal jinn", "Jinn (Virtue)", "Jinni", "genii loci", "jann", "jinii", "jinni", "jinniyya" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Legerdemain a rpg:Proficiency ;
    rpg:name "Legerdemain" ;
    dc:description "An Ability used by a thieving performer to pick a victim's pocket via a Dexterity + Legerdemain roll while the crowd is captivated." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:Leprosy a rpg:Tag ;
    skos:prefLabel "Leprosy" ;
    dc:description "A Major General Flaw representing the divine disease; it gives a permanent -2 Living Condition modifier and an extra Heavy Wound during Aging Crises, and prevents gaining a positive reputation." ;
    rpg:hasTag amol:Flaw .
amol:LesserLimitsOfHermeticMagic a rpg:Tag ;
    skos:prefLabel "Lesser Limits of Hermetic Magic" ;
    dc:description "The boundaries of what Hermetic magic can achieve, resulting from Bonisagus' unfinished theory; the forest paths each lead to overcoming one of these limits." ;
    skos:altLabel "Lesser Limits", "Lesser Limits of Magic", "Limit of Essential Nature", "Limit of True Feeling" ;
    rpg:hasTag amol:HermeticConcept .
amol:LifeBoost a rpg:Tag ;
    skos:prefLabel "Life Boost" ;
    dc:description "A Minor, Hermetic Virtue letting a magus boost Formulaic or Ritual spell casting totals by +5 per additional Fatigue level spent, risking damage." ;
    rpg:hasTag amol:Virtue .
amol:LindenGild a rpg:Faction ;
    rpg:name "Linden Gild" ;
    dc:description "A peace-striving go-between gild founded by former magi of Fengheld after the Schism War, seeking cooperation between magi and covenants; led by Occultes of Durenmar." ;
    skos:altLabel "Linden Gild Trained", "Lindengilde" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:MythicCompanion a rpg:Tag ;
    skos:prefLabel "Mythic Companion" ;
    dc:description "A powerful tier of player character that may take up to 10 points of Flaws and twice the normal Virtues, defined by a Free Virtue specifying which type of Mythic Companion they are." ;
    skos:altLabel "Mythic Companions" ;
    rpg:hasTag amol:CharacterType .
amol:Occultes a rpg:Character ;
    rpg:name "Occultes" ;
    dc:description "A Follower of Bonisagus and figurehead of the outward-looking faction favoring hedge wizardry; former librarian and now leader of the Linden Gild who secretly hoards restricted texts." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Proud a rpg:Tag ;
    skos:prefLabel "Proud" ;
    dc:description "A Personality Flaw that automatically increases a Verditius magus's Hubris score (by 1 for Minor, 3 for Major); also gained as a Personality Trait by magi converted into the House." ;
    skos:altLabel "Pride" ;
    rpg:hasTag amol:Flaw .
amol:RitualMagic a rpg:Tag ;
    skos:prefLabel "Ritual Magic" ;
    dc:description "A type of elaborate spell that always requires botch dice (unless mastered) and whose effects cannot be placed in enchantments unless they are Ritual only due to level over 50." ;
    skos:altLabel "Ritual", "Ritual Spellcasting", "Ritual Spells", "Ritual spell", "Ritual spells", "rituals" ;
    rpg:hasTag amol:HermeticConcept .
amol:Roznov a rpg:Faction ;
    rpg:name "Roznov" ;
    dc:description "An Autumn covenant in eastern Moravia combining two traditions: a pagan priesthood of Radegast (House Ex Miscellanea at Roznov Castle) and an archconservative House Tremere stronghold (at Roznov Fort)." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:Salerno a schema:Place ;
    rpg:name "Salerno" ;
    dc:description "A southern center of medical learning whose school accepts female students and is the source of secret Theriacs such as the Cataplasm of Mandrake and Soporific Sponge." ;
    skos:altLabel "School of Salerno", "medical school at Salerno" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:SharpEars a rpg:Tag ;
    skos:prefLabel "Sharp Ears" ;
    dc:description "A Minor Virtue acquirable by a Bjornaer inner heartbeast and possessed by the stag and wolf." ;
    rpg:hasTag amol:Virtue .
amol:Siegfried a rpg:Character ;
    rpg:name "Siegfried" ;
    dc:description "The legendary hero of the Nibelungenlied who slew the dragon Fafnir, won the Nibelung treasure, became invulnerable except for one spot, and was treacherously slain by Hagen." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:SummonAnimals a rpg:Tag ;
    skos:prefLabel "Summon Animals" ;
    dc:description "A Major Non-Hermetic Virtue/Supernatural Ability of the Beast Masters allowing them to summon mundane animals over long distances with an audible call, breaking the Limit of Arcane Connection." ;
    skos:altLabel "Summon Animals (Ability)" ;
    rpg:hasTag amol:Virtue .
amol:TaintedWithEvil a rpg:Tag ;
    skos:prefLabel "Tainted with Evil" ;
    dc:description "A Minor General Flaw in which an air of corruption surrounds the character, making others ill at ease and making positive Reputation impossible." ;
    rpg:hasTag amol:Flaw .
amol:Teaching a rpg:Proficiency ;
    rpg:name "Teaching" ;
    dc:description "An Ability that adds to the Source Quality when a character teaches; the maximum number of students equals the teacher's Teaching score times five." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:TheChurch a rpg:Faction ;
    rpg:name "The Church" ;
    dc:description "The dominant religious institution of Mythic Europe, headed by the Pope, the Bishop of Rome, and backed by the Divine. It structures medieval life around the seven sacraments, canon law, and a hierarchy of bishops, priests, monasteries, and parishes." ;
    skos:altLabel "Church Militant", "Church Triumphant", "Church, The", "Roman Catholic Church", "the Roman Catholic church" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:TheInexorableSearch a rpg:Spell ;
    rpg:name "The Inexorable Search" ;
    dc:description "A spell that uses an arcane connection such as a lock of hair to locate someone; library vouchers act as arcane connections for it, and other library-location spells are based on it." ;
    skos:altLabel "Inexorable Search, The" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheShroudedGlen a rpg:Spell ;
    rpg:name "The Shrouded Glen" ;
    dc:description "A Mentem spell that conceals a location from discovery; because it affects minds and not animals, a hunted deer could lead hunters to a covenant protected by it." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheWoundThatWeeps a rpg:Spell ;
    rpg:name "The Wound that Weeps" ;
    dc:description "A Perdo Corpus spell (PeCo15) cited to illustrate how the Harmless Magic Flaw makes a wound briefly bleed then close again." ;
    skos:altLabel "PeCo15" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Triamore a rpg:Faction ;
    rpg:name "Triamore" ;
    dc:description "A covenant holding a castle and manorial estate by the river Meuse on the edge of the Ardennes at the western fringe of the Rhine Tribunal; led by Daria la Gris and embroiled in mundane politics." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:Trier a schema:Place ;
    rpg:name "Trier" ;
    dc:description "The oldest German city (Roman Augusta Treverorum), ruled by its archbishop; site of Roman remains, the Porta Nigra, the Cathedral of St. Peter, and the underground former covenant of Treverorum." ;
    skos:altLabel "Augusta Treverorum" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Valnastium a rpg:Faction ;
    rpg:name "Valnastium" ;
    dc:description "The domus magna of House Jerbiton, a secluded valley covenant in the Greater Alps founded by Iconophiles to store icons and relics; filled with alien ancient art and home to the cats of the Black Lineage." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:Venice a schema:Place ;
    rpg:name "Venice" ;
    dc:description "The dominant north Italian city-state of Mythic Europe, controlling trade with Constantinople and the Levant and monopolies on alum and potash; its Doge annually weds the sea with a vis-bearing ring." ;
    skos:altLabel "Serene Republic of Venice", "Venetian", "Venetians" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:WellTraveled a rpg:Tag ;
    skos:prefLabel "Well-Traveled" ;
    dc:description "A Minor General Virtue: the character has journeyed extensively, gaining 50 bonus experience points for living languages, Area Lores, and social abilities." ;
    rpg:hasTag amol:Virtue .
amol:WhistleUpTheWind a rpg:Tag ;
    skos:prefLabel "Whistle Up The Wind" ;
    dc:description "A Major Supernatural Virtue granting a score of 1 in the Supernatural Ability Whistle Up The Wind, letting the character create winds by whistling." ;
    skos:altLabel "Whistle Up The Wind (Ability)" ;
    rpg:hasTag amol:Virtue .
amol:AnimalHandling a rpg:Proficiency ;
    rpg:name "Animal Handling" ;
    dc:description "The Ability used to command and teach tamed animals; a Master of the Pack uses Animal Handling instead of Leadership to control dogs, and instead of Teaching to give beasts experience." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:AraeFlaviae a rpg:Faction ;
    rpg:name "Arae Flaviae" ;
    dc:description "An early Rhine Tribunal covenant, established in 780, that was among the first to mix magi of several Houses; its model democratic charter is widely copied across the Order." ;
    skos:altLabel "Charter of Arae Flaviae" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:AshGild a rpg:Faction ;
    rpg:name "Ash Gild" ;
    dc:description "A Rhine Tribunal gild dominated by Flambeau magi who wish to strike aggressively against the Norse wizards beyond the Baltic; led by Philippus Niger and behind the creation of Oculus Septentrionalis." ;
    skos:altLabel "Ash Gilds", "the Ash" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:BallOfAbysmalFlame a rpg:Spell ;
    rpg:name "Ball of Abysmal Flame" ;
    dc:description "A Creo Ignem spell (Level 35) that shoots a ball of flame to strike a single target for +30 damage; Marius of Tremere's version makes a loud bang on impact." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Berserk a rpg:Tag ;
    skos:prefLabel "Berserk" ;
    dc:description "A Virtue causing a creature to fight with reckless fury for greater attack at the cost of defense; possessed by the wild boar and an earth elemental." ;
    rpg:hasTag amol:Virtue .
amol:BindWound a rpg:Spell ;
    rpg:name "Bind Wound" ;
    dc:description "A Creo Corpus spell (Level 10) that binds the target's wounds so activity does not worsen them, though wound penalties and inability to heal naturally remain." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Blackthorn a rpg:Faction ;
    rpg:name "Blackthorn" ;
    dc:description "A powerful covenant in caves under the Black Mountains of south Wales that long dominated the tribunal; home of praeco Talion and seat of recent Stonehenge tribunals." ;
    skos:altLabel "Blackthorn covenant" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:Capo a rpg:Tag ;
    skos:prefLabel "Capo" ;
    dc:description "A game-defined merchant role: the leader of a merchant company who sets grand strategy, appoints factors, and engages in politics; characters must take the Capo Social Status Virtue." ;
    skos:altLabel "Capo Social Status Virtue" ;
    rpg:hasTag amol:Virtue .
amol:CastingTablet a rpg:Tag ;
    skos:prefLabel "Casting Tablet" ;
    dc:description "A variant Laboratory Text containing fixed instructions for casting a particular spell, usable by magi who have not learned the spell but dangerous and inflexible." ;
    skos:altLabel "Casting Tablets", "casting tablets" ;
    rpg:hasTag amol:HermeticConcept .
amol:Columbae a rpg:Faction ;
    rpg:name "Columbae" ;
    dc:description "A tradition of Welsh hedge wizards within House Ex Miscellanea famous for ward-magic (the Warding Ability); they introduced Ring/Circle warding spells to the Order." ;
    skos:altLabel "Columbine", "House Columbae", "pigeons", "swynwr", "swynwyr", "ward-makers", "white-nailed" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Confidence a rpg:Tag ;
    skos:prefLabel "Confidence" ;
    dc:description "A pool of points a character can spend to add +3 per point to a roll after seeing the result; points are awarded for achievements and good roleplaying." ;
    skos:altLabel "Confidence Points", "Confidence Score" ;
    rpg:hasTag amol:HermeticConcept .
amol:ConjuringTheMysticTower a rpg:Spell ;
    rpg:name "Conjuring the Mystic Tower" ;
    dc:description "A Creo spell that conjures a stone tower, allowing the caster to determine the layout of its chambers; can also be used by a magus to construct a lab building." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:CovenantUpbringing a rpg:Tag ;
    skos:prefLabel "Covenant Upbringing" ;
    dc:description "A Flaw (and background) reflecting a character raised within a covenant, granting Latin and Order of Hermes Lore; held by the Scribe, Minstrel, Washer-woman, and Weapons Instructor templates." ;
    rpg:hasTag amol:Flaw .
amol:CurseOfVenus a rpg:Tag ;
    skos:prefLabel "Curse of Venus" ;
    dc:description "A Major Story Flaw: the character is attractive to unwanted people and falls in love with inappropriate people in inappropriate circumstances." ;
    skos:altLabel "Curse of Venus Flaw" ;
    rpg:hasTag amol:Flaw .
amol:CurseOfTheLeprousFlesh a rpg:Spell ;
    rpg:name "Curse of the Leprous Flesh" ;
    dc:description "A Perdo Corpus spell (Level 25) that inflicts leprosy on the target, causing an Incapacitating Wound and loss of Stamina as the flesh rots." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Custos a rpg:Tag ;
    skos:prefLabel "Custos" ;
    dc:description "A social-status Virtue denoting a trusted covenant servant or guard, taken by the glass-blower, lore-master, and political agent templates." ;
    rpg:hasTag amol:Virtue .
amol:CyclicMagic a rpg:Tag ;
    skos:prefLabel "Cyclic Magic" ;
    dc:description "A Hermetic Virtue/Flaw making a magus's power wax and wane with a cycle; Felicia has Cyclic Magic (Positive) in winter and (Negative) in summer." ;
    skos:altLabel "Cyclic Magic (positive)" ;
    rpg:hasTag amol:Virtue .
amol:Daimon a rpg:Creature ;
    rpg:name "Daimon" ;
    dc:description "Ancient, named individual spirits dwelling deep in the Magic Realm, being the spirits of heroes, ancient pagan deities, or sacred groves; they cannot enter the material world but project Aspects of themselves as agents on Earth." ;
    skos:altLabel "Daimons", "daimons" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:DamhanAllaidh a rpg:Character ;
    rpg:name "Damhan-Allaidh" ;
    dc:description "A powerful and evil wizard in the British Isles who led organized resistance to the Order in the early ninth century; defeated by Pralix though rumors persist he survived." ;
    skos:altLabel "Damhan-Allaidh (Latinized Davanallus)", "Davanallus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:DisguiseOfTheTransformedImage a rpg:Spell ;
    rpg:name "Disguise of the Transformed Image" ;
    dc:description "A spell useful for creating a persona with specific physical characteristics such as a particular sex, hair color, or stature." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Driven a rpg:Tag ;
    skos:prefLabel "Driven" ;
    dc:description "A Personality Flaw compelling a character to pursue a particular goal relentlessly; Darius is Driven to hunt enemies of the Order." ;
    rpg:hasTag amol:Flaw .
amol:Factor a rpg:Tag ;
    skos:prefLabel "Factor" ;
    dc:description "A minor Social Status Virtue for a character who manages the interests of a trading house in a single city; also used for independent traders with capital but lacking other-city connections." ;
    rpg:hasTag amol:Virtue .
amol:FailedApprentice a rpg:Tag ;
    skos:prefLabel "Failed Apprentice" ;
    dc:description "A Minor, Social Status Virtue for someone once apprenticed to a mage who never completed studies, familiar with magi's lives and possibly retaining Supernatural Abilities." ;
    skos:altLabel "Failed Apprentice Social Virtue" ;
    rpg:hasTag amol:Virtue .
amol:Famous a rpg:Tag ;
    skos:prefLabel "Famous" ;
    dc:description "A Virtue that cannot be used for an Artist Reputation, since characters with Famous are known for something other than their artwork." ;
    rpg:hasTag amol:Virtue .
amol:FeralUpbringing a rpg:Tag ;
    skos:prefLabel "Feral Upbringing" ;
    dc:description "A Flaw representing a wild, untamed childhood; a required Flaw of all Beast Masters due to their abandonment in the wilderness." ;
    rpg:hasTag amol:Flaw .
amol:FragileConstitution a rpg:Tag ;
    skos:prefLabel "Fragile Constitution" ;
    dc:description "A Minor General Flaw making the character sickly with a -3 penalty on rolls to recover from wounds and diseases." ;
    rpg:hasTag amol:Flaw .
amol:GlastonburyAbbey a schema:Place ;
    rpg:name "Glastonbury Abbey" ;
    dc:description "The oldest and richest monastery in England, identified with the isle of Avalon and the burial place of Arthur, standing near Glastonbury Tor in the Somerset fens." ;
    skos:altLabel "Glastonbury", "Lady Chapel at Glastonbury Abbey", "isle of Avalon" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Gorgiastic a rpg:Faction ;
    rpg:name "Gorgiastic" ;
    dc:description "Former House Criamon magi (or their descendants) who rejected the quest for the answer; named for a student of Empedocles, most found in Houses Ex Miscellanea and Jerbiton." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:GreaterPurifyingTouch a rpg:Tag ;
    skos:prefLabel "Greater Purifying Touch" ;
    dc:description "A Supernatural Virtue (Greater or Lesser) cited as a possible Major Virtue for a magus Ex Miscellanea and common among the Scinnfolk." ;
    skos:altLabel "Purifying Touch" ;
    rpg:hasTag amol:Virtue .
amol:Harmonists a rpg:Faction ;
    rpg:name "Harmonists" ;
    dc:description "A faction within House Bjornaer led by Falke that becomes dominant at Crintera and, in the Schism, remains besieged on Rügen claiming to be the true domus magna." ;
    skos:altLabel "Concordiarii", "Harmonist", "Harmonist Bjornaer", "Harmonist faction", "Harmonist views", "the Harmonist faction" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:HigherPurpose a rpg:Tag ;
    skos:prefLabel "Higher Purpose" ;
    dc:description "A Personality Flaw of dedication to a cause, suggested for Mithraic characters and milites who take the Code of Garus seriously." ;
    rpg:hasTag amol:Flaw .
amol:KingJohn a rpg:Character ;
    rpg:name "King John" ;
    dc:description "The late king of England, Henry III's father, remembered for arbitrary rule, the loss of Normandy, the interdict, and his volatility; he submitted England as a vassal of the Holy See." ;
    skos:altLabel "John" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:KingOfTheBlackMountain a rpg:Character ;
    rpg:name "King of the Black Mountain" ;
    dc:description "The dread faerie ruler of the Black Forest with Faerie Might 90, dwelling atop the Feldberg; born from a rebellious splinter of the original genius locus and seeking the destruction of Durenmar." ;
    skos:altLabel "King Fir", "King Fir of the Black Forest" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:LabTotal a rpg:Tag ;
    skos:prefLabel "Lab Total" ;
    dc:description "The core laboratory work measure (Technique + Form + Intelligence + Magic Theory + Aura Modifier) used for all lab activities such as inventing spells, enchanting items, and binding familiars." ;
    skos:altLabel "Lab Totals", "Laboratory Total", "Technique Form Lab Total" ;
    rpg:hasTag amol:HermeticConcept .
amol:LampWithoutFlame a rpg:Spell ;
    rpg:name "Lamp without Flame" ;
    dc:description "A Creo Ignem spell that creates a steady daylight-bright light with no apparent source, illuminating about ten paces across a point that may be a mobile item." ;
    skos:altLabel "Sung Lamp Without Flame" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:LevantTribunal a rpg:Faction ;
    rpg:name "Levant Tribunal" ;
    dc:description "A Hermetic Tribunal in the Levant; off Ascalon within it, a Muslim fleet was defeated in 1123, leaving the cursed dead of Ascalon." ;
    skos:altLabel "Levant", "Tribunal of the East", "Tribunal of the Levant" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Tribunal .
amol:London a schema:Place ;
    rpg:name "London" ;
    dc:description "The principal English city whose ruling aldermen seek to increase the freedoms of the city; a center of specialized crafts and home to round churches and vagabond clerks." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:LBeck a schema:Place ;
    rpg:name "Lübeck" ;
    dc:description "The most important coastal port in Germany and a hub of Baltic trade, effectively founded in 1157 by Henry the Lion and home to the covenant Oculus Septentrionalis." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:MariAmwithig a rpg:Character ;
    rpg:name "Mari Amwithig" ;
    dc:description "An example Merinita maga used to illustrate Charm Magic, Story Magic, and Symbolic Magic, who modifies spells with charms and tricks faerie lords out of their treasures." ;
    skos:altLabel "Maga Mari Amwithig", "Mari", "Mari Amwithig of Merinita" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:MercurianMagic a rpg:Tag ;
    skos:prefLabel "Mercurian Magic" ;
    dc:description "A Major Hermetic Virtue whose magical lineage descends from the Roman priests of Mercury, granting skill with Ritual Magic, free Wizard's Vigil, and halved vis requirements for Ritual spells." ;
    rpg:hasTag amol:Virtue .
amol:Merlin a rpg:Character ;
    rpg:name "Merlin" ;
    dc:description "The greatest mage in the history of the tribunal, of mysterious birth and fate, connected with Arthur's rise; Hermetic opinion holds he was half fay, and he raised Stonehenge and enabled Arthur's conception." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:MonasticVows a rpg:Tag ;
    skos:prefLabel "Monastic Vows" ;
    dc:description "A Major Story Flaw in which the character has taken vows of poverty, chastity, and obedience to a religious superior, as a friar, monk, or nun." ;
    rpg:hasTag amol:Flaw .
amol:Montpellier a schema:Place ;
    rpg:name "Montpellier" ;
    dc:description "A famed southern medical school where Gilles de Corbeil taught before leaving amid feuding with the faculty; one of the schools granting the Magister in Medicina." ;
    skos:altLabel "Montpelier" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Mystagogue a rpg:Tag ;
    skos:prefLabel "Mystagogue" ;
    dc:description "A charismatic Mystery Cult figure who commands a probationer and grants Initiation; Criamon usually use guides instead, though the Paths of Mirror and Strife use formal Mystagogues." ;
    rpg:hasTag amol:CharacterType .
amol:NatureLore a rpg:Proficiency ;
    rpg:name "Nature Lore" ;
    dc:description "A Mystery (Virtue) Initiated by the Vestals with the unique focus of lares (household spirits), letting them interact with the faeries of a settlement as nature magi do with the wilderness." ;
    skos:altLabel "Animal Lore", "Forest Lore", "Mountain Lore", "Nature Lore Mystery" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:Nephilim a rpg:Tag ;
    skos:prefLabel "Nephilim" ;
    dc:description "A Mythic Companion type: divine giants and heroes of ancient myth, descended from angels, who age very slowly and dwell mostly in divine regiones. They require the Blood of the Nephilim and related Divine-aligned Virtues." ;
    rpg:hasTag amol:CharacterType .
amol:Nocturnal a rpg:Tag ;
    skos:prefLabel "Nocturnal" ;
    dc:description "A Minor General Flaw in which the character's body rhythms keep him sleeping until noon, giving -1 on all rolls between dawn and midday but ease at night." ;
    skos:altLabel "Nocturnal Personality Flaw" ;
    rpg:hasTag amol:Flaw .
amol:Noncombatant a rpg:Tag ;
    skos:prefLabel "Noncombatant" ;
    dc:description "A Flaw making a creature unwilling or unable to fight; possessed by the courser horse and the caladrius and listed among Flaws suitable for beasts." ;
    skos:altLabel "Noncombatant Flaw" ;
    rpg:hasTag amol:Flaw .
amol:Notatus a rpg:Character ;
    rpg:name "Notatus" ;
    dc:description "The first Hermetic apprentice of Bonisagus, chosen as Primus of House Bonisagus and thereby the first Praeco of the Rhine after Bonisagus; his sigil is held by Murion." ;
    skos:altLabel "Notatus of Bonisagus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:OakGild a rpg:Faction ;
    rpg:name "Oak Gild" ;
    dc:description "A political gild of the Rhine Tribunal that, in the Crintera Schism, aligns with the Harmonist Bjornaer to start a territorial dispute with Novgorod; Roznov's other magi belong to the Ash or Oak Gilds." ;
    skos:altLabel "the Oak" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:PanicOfTheTremblingHeart a rpg:Spell ;
    rpg:name "Panic of the Trembling Heart" ;
    dc:description "A Creo Mentem spell cited as an example of a base-level-4 spell creating emotion directed at a particular person or object." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Persona a rpg:Tag ;
    skos:prefLabel "Persona" ;
    dc:description "A Supernatural Ability and deep-cover disguise technique allowing a magus to flawlessly alter his appearance and mannerisms to adopt a distinct identity; a subtle form of Muto Corpus magic." ;
    skos:altLabel "Persona Supernatural Ability", "personae" ;
    rpg:hasTag amol:Virtue .
amol:PlaguedBySupernaturalEntity a rpg:Tag ;
    skos:prefLabel "Plagued by Supernatural Entity" ;
    dc:description "A Flaw representing a supernatural entity (often a spirit too powerful to defeat) that torments a character; a jinni variant afflicts sahirs." ;
    skos:altLabel "Plagued by Jinni" ;
    rpg:hasTag amol:Flaw .
amol:Praeco a rpg:Tag ;
    skos:prefLabel "Praeco" ;
    dc:description "The presiding senior officer of a tribunal who calls magi forward, sets the order of business, and convenes tribunals; normally the oldest maga but in Stonehenge held by Talion of Blackthorn." ;
    skos:altLabel "praecones" ;
    rpg:hasTag amol:CharacterType .
amol:PrivilegedUpbringing a rpg:Tag ;
    skos:prefLabel "Privileged Upbringing" ;
    dc:description "A Minor General Virtue giving 50 extra experience points spendable on General, Academic, or Martial Abilities from a childhood with teachers and study time." ;
    rpg:hasTag amol:Virtue .
amol:Restriction a rpg:Tag ;
    skos:prefLabel "Restriction" ;
    dc:description "A Flaw preventing magic under a circumstance (e.g., at sea, or in bright light as suffered by Ulf); imposed as a Great Beast Ordeal and a common Bjornaer flaw." ;
    skos:altLabel "Restriction (bright light)" ;
    rpg:hasTag amol:Flaw .
amol:Rheinstein a rpg:Faction ;
    rpg:name "Rheinstein" ;
    dc:description "A former covenant founded 1123 AD on the island of Pfalz in the Rhine Gorge; attacked and destroyed in 1200 AD by an army of irate mundanes led by the archbishop of Trier." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:Rudiaria a rpg:Faction ;
    rpg:name "Rudiaria" ;
    dc:description "A former covenant affiliated to House Flambeau, founded 892 AD on the right bank of the Rhine opposite Bingen; charged with diabolism and destroyed in 969 AD by an apparent catastrophic magical accident." ;
    skos:altLabel "Rudiaria covenant" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:Schadrit a rpg:Character ;
    rpg:name "Schadrit" ;
    dc:description "The ancient maga of Ex Miscellanea who leads Dankmar with malice; a former Bonisagus apprentice cast out with her mistress Aschlaranda, she is an expert in Faerie Magic." ;
    skos:altLabel "Shadrith", "Shadrith of Dankmar" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:SightOfTheTrueForm a rpg:Spell ;
    rpg:name "Sight of the True Form" ;
    dc:description "An Intellego Corpus spell (General) that lets you see the true, original form of any person whose form has been changed or masked." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:SingleWeapon a rpg:Proficiency ;
    rpg:name "Single Weapon" ;
    dc:description "A Martial Ability for fighting with a weapon used in one hand, possibly with a shield in the other, including lances from horseback." ;
    skos:altLabel "Single" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:SpellImprovisation a rpg:Tag ;
    skos:prefLabel "Spell Improvisation" ;
    dc:description "A Minor Hermetic Virtue letting a magus add the magnitude of a known Formulaic spell as a bonus to his Casting Total when spontaneously casting a similar spell." ;
    rpg:hasTag amol:Virtue .
amol:StudyBonus a rpg:Tag ;
    skos:prefLabel "Study Bonus" ;
    dc:description "A Minor Hermetic Virtue granting bonuses to study an Art from books or raw vis when in the presence of a sufficient physical manifestation of that Form or Technique." ;
    rpg:hasTag amol:Virtue .
amol:Summa a rpg:Tag ;
    skos:prefLabel "Summa" ;
    dc:description "One of the two types of study books in Ars Magica, providing repeatable study of an Art or Ability up to a level; restricting summae limits a covenant's power advancement." ;
    skos:altLabel "Ability Summae", "Art Summae", "summae" ;
    rpg:hasTag amol:HermeticConcept .
amol:Tempestaria a rpg:Faction ;
    rpg:name "Tempestaria" ;
    dc:description "A tradition of Saxon-associated weather witches within House Ex Miscellanea who summon rain, fog, and especially wind beyond Hermetic capacity, using sympathetic tools." ;
    skos:altLabel "Tempestariae", "Weather Witch", "tempestarius", "weather-witch", "weather-witches", "weathermages" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:TeutonicKnights a rpg:Faction ;
    rpg:name "Teutonic Knights" ;
    dc:description "A landowning monastic military order suspicious of Lübeck's charter that promotes its own less autonomous charter to Baltic towns and controls a section of Acre." ;
    skos:altLabel "Order of Teutonic Knights", "Teutonic Order" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:TheIncantationOfLightning a rpg:Spell ;
    rpg:name "The Incantation of Lightning" ;
    dc:description "A 6th-magnitude or greater Hermetic spell cited as an example of magic that, cast in a Magic aura, can inflict the final Warping point needed to rarefy an elemental." ;
    skos:altLabel "Incantation Of Lightning, The" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheInvisibleEyeRevealed a rpg:Spell ;
    rpg:name "The Invisible Eye Revealed" ;
    dc:description "A spell that allows a magus to magically recognize an Intangible Tunnel and cast spells back through it." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Tractatus a rpg:Tag ;
    skos:prefLabel "Tractatus" ;
    dc:description "A short book conveying an author's insights on a subject, studied once for experience; breakthroughs and encyclopedia volumes are disseminated as tractatus." ;
    rpg:hasTag amol:HermeticConcept .
amol:TrustOfChildlikeFaith a rpg:Spell ;
    rpg:name "Trust of Childlike Faith" ;
    dc:description "A Perdo Mentem spell that destroys adult judgment regarding truth and falsity, used as a template for spells diminishing other mental capacities." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Unaging a rpg:Tag ;
    skos:prefLabel "Unaging" ;
    dc:description "A Minor Supernatural Virtue: the character does not suffer the effects of age, with aging points only building up Decrepitude points rather than reducing Characteristics." ;
    rpg:hasTag amol:Virtue .
amol:VeilOfInvisibility a rpg:Spell ;
    rpg:name "Veil of Invisibility" ;
    dc:description "A Perdo Imaginem spell (Level 20) that makes the target completely undetectable to normal sight regardless of what it does, though it still casts a shadow." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Verdi a rpg:Faction ;
    rpg:name "Verdi" ;
    dc:description "The domus magna of House Verditius on the island of Sardinia, built over the Forge of Hephaestus, consisting of a squat central tower surrounded by six taller towers amid nuraghi." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:WardAgainstHeatAndFlames a rpg:Spell ;
    rpg:name "Ward Against Heat and Flames" ;
    dc:description "A Rego Ignem spell (Level 25) that keeps heat and fire at bay, granting the target a +15 Soak against fire-related damage so weaker fires cannot penetrate the ward." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:WeakParens a rpg:Tag ;
    skos:prefLabel "Weak Parens" ;
    dc:description "A Minor Hermetic Flaw representing a less powerful or worse-teaching parens, giving fewer experience points and spell levels from apprenticeship." ;
    skos:altLabel "Weak Parens Flaw" ;
    rpg:hasTag amol:Flaw .
amol:WieldingTheInvisibleSling a rpg:Spell ;
    rpg:name "Wielding the Invisible Sling" ;
    dc:description "A Rego Terram spell (ReTe 10) that hurls any nearby throwable object at a target within range, doing up to +5 damage but resisted by Magic Resistance." ;
    skos:altLabel "Invisible Sling" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Wilderists a rpg:Faction ;
    rpg:name "Wilderists" ;
    dc:description "A philosophy within House Bjornaer favoring the wilderness; the Hawthorn Gild is populated primarily by Bjornaer with a Wilderist philosophy, including Schwall." ;
    skos:altLabel "Feritarii", "Wilderist", "Wilderist faction", "Wilderist philosophy" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:AbilityBlock a rpg:Tag ;
    skos:prefLabel "Ability Block" ;
    dc:description "A Minor General Flaw: the character is completely unable to learn a certain class of Abilities, such as Martial Abilities or languages other than the native tongue." ;
    skos:altLabel "Ability Block (Arcane)", "Ability Block (Logic)", "Ability Block (Martial Abilities)" ;
    rpg:hasTag amol:Flaw .
amol:AfflictedTongue a rpg:Tag ;
    skos:prefLabel "Afflicted Tongue" ;
    dc:description "A Minor General Flaw: a speech impediment giving -2 to voice rolls and Casting Scores using words, plus an extra botch die for magi." ;
    rpg:hasTag amol:Flaw .
amol:Ambitious a rpg:Tag ;
    skos:prefLabel "Ambitious" ;
    dc:description "A Major or Minor Personality Flaw: the character wants to be the most successful or powerful person in some respect and avoids distractions from that ambition." ;
    rpg:hasTag amol:Flaw .
amol:Andru a rpg:Character ;
    rpg:name "Andru" ;
    dc:description "The current Primus of House Jerbiton, a charming, effective middle-aged leader who has rallied the House around interventionism and ancient values after the fall of Constantinople." ;
    skos:altLabel "Andrus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Apothecary a rpg:Proficiency ;
    rpg:name "Apothecary" ;
    dc:description "A General Ability allowing a character to identify, cultivate, and prepare herbs, animal parts and minerals into medicinal remedies; an adjunct to Medicine." ;
    skos:altLabel "Profession Apothecary" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:Apromor a rpg:Character ;
    rpg:name "Apromor" ;
    dc:description "A Flambeau magus and founder of a major lineage and the School of Apromor, focused on the Technique of Perdo; Boreas was descended from Flambeau through his line." ;
    skos:altLabel "Apromor filius Flambeau", "Michel" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:ArcOfFieryRibbons a rpg:Spell ;
    rpg:name "Arc of Fiery Ribbons" ;
    dc:description "A Creo Ignem spell (Level 25) in which a dozen multi-hued ribbons of flame leap from the caster's hands covering a 60-degree arc, dealing +10 damage to all in the arc." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Aristotle a rpg:Character ;
    rpg:name "Aristotle" ;
    dc:description "The ancient Greek philosopher whose newly translated works, the New Aristotle, were central to scholastic learning and embraced by Muslim scholars." ;
    skos:altLabel "The Philosopher", "the Philosopher" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:ArsMagica a rpg:Tag ;
    skos:prefLabel "Ars Magica" ;
    dc:description "The tabletop roleplaying game system in which this Rhine Tribunal supplement is set; rules references point to Ars Magica 5th Edition." ;
    skos:altLabel "ArM5", "Ars Magica 5th Edition", "Ars Magica Fifth Edition" ;
    rpg:hasTag amol:HermeticConcept .
amol:ArtOfMemory a rpg:Proficiency ;
    rpg:name "Art of Memory" ;
    dc:description "An Ability that aids recall; a victim of Chnoubis' bite may add Art of Memory to a Stamina roll to remember what transpired while affected." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:Aschlaranda a rpg:Character ;
    rpg:name "Aschlaranda" ;
    dc:description "A maga exiled from Durenmar and House Bonisagus during the Schism War who founded Dankmar in 1052 to oppose Durenmar, bringing her apprentice Schadrit with her." ;
    skos:altLabel "the maga Aschlaranda" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Athletics a rpg:Proficiency ;
    rpg:name "Athletics" ;
    dc:description "A general physical Ability used by acrobats for tasks outside performance, such as climbing, distinct from the Profession: Acrobat Ability." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:BelovedRival a rpg:Tag ;
    skos:prefLabel "Beloved Rival" ;
    dc:description "A formally declared lifelong rivalry within House Tytalus, ceremonially issued with a spiral drawn in blood, persisting until the death of one opponent; also a Minor Story Flaw." ;
    rpg:hasTag amol:Flaw .
amol:BlessingOfChildlikeBliss a rpg:Spell ;
    rpg:name "Blessing of Childlike Bliss" ;
    dc:description "A spell that reduces an adult mind to a child's level, so the target reasons and expresses emotion as a three-year-old and cannot cast spells." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:BookLearner a rpg:Tag ;
    skos:prefLabel "Book Learner" ;
    dc:description "A Virtue that modifies the Source Quality from books when calculating a character's Advancement Total." ;
    rpg:hasTag amol:Virtue .
amol:BrandedCriminal a rpg:Tag ;
    skos:prefLabel "Branded Criminal" ;
    dc:description "A Minor Social Status Flaw: a mark burned into the cheek as punishment for a past crime that hampers functioning in society; cannot take Wealthy." ;
    rpg:hasTag amol:Flaw .
amol:BuildPoints a rpg:Tag ;
    skos:prefLabel "Build Points" ;
    dc:description "Points spent during covenant creation; realia collections cost Build Points scaling with quality, and Great Works cost the Build Points of an equivalent book." ;
    rpg:hasTag amol:HermeticConcept .
amol:Busybody a rpg:Tag ;
    skos:prefLabel "Busybody" ;
    dc:description "A useful minor Flaw representing a character compelled to meddle in others' affairs; listed as a resource increasing an agent's Resistance Strength." ;
    rpg:hasTag amol:Flaw .
amol:Caecilius a rpg:Character ;
    rpg:name "Caecilius" ;
    dc:description "A Quaesitor of Durenmar and a contender for the oldest magus in the Tribunal, who ruled firmly that no wilderness had been invaded in the Crintera/Guardians of the Forests dispute." ;
    skos:altLabel "Caecilius of Durenmar", "the Quaesitor Caecilius" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Cambridge a schema:Place ;
    rpg:name "Cambridge" ;
    dc:description "A medium-sized port town on the edge of the Fens with a young university and an unusual number of natural magicians, owing to the influence of Schola Pythagoranis." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:CaveOfTwistingShadows a rpg:Faction ;
    rpg:name "Cave of Twisting Shadows" ;
    dc:description "A labyrinthine covenant serving as the domus magna of House Criamon, the largest and perhaps unfinished Great Work, whose structures embody the quest for the Enigma; its ghosts teach the Arts." ;
    skos:altLabel "Axis Magica regio" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:Coeris a rpg:Faction ;
    rpg:name "Coeris" ;
    dc:description "The domus magna of House Tremere in the Transylvanian Tribunal, to which Gifted children identified at the Prague slave market are delivered." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:CovenantOfCalebais a rpg:Faction ;
    rpg:name "Covenant of Calebais" ;
    dc:description "A covenant that fell under mysterious circumstances and has lain undisturbed since, suggested as a place to explore (referenced via the supplement Calebais: The Broken Covenant)." ;
    skos:altLabel "Calebais", "Calebais: The Broken Covenant", "The Broken Covenant", "The Broken Covenant of Calebais" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:CrafterSHealing a rpg:Tag ;
    skos:prefLabel "Crafter's Healing" ;
    dc:description "A Major Supernatural Virtue letting a character magically heal wounds by touching them with the tools of his trade; it grants the Crafter's Healing Ability and is a power Hermetic magi cannot understand." ;
    rpg:hasTag amol:Virtue .
amol:Craftsman a rpg:Tag ;
    skos:prefLabel "Craftsman" ;
    dc:description "A free Social Status Virtue for a general craftsman practicing a trade not represented by a guild, who may be male or female and live rurally or in town." ;
    rpg:hasTag amol:Virtue .
amol:CultOfDiana a rpg:Faction ;
    rpg:name "Cult of Diana" ;
    dc:description "A struggling pagan cult of the goddess Diana that absorbed the rites of Vesta and survived the Fall of Rome in the wilderness; Merinita is said to have been one of its high priestesses." ;
    skos:altLabel "Diana cult", "priestesses of Diana" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:CurseOfCirce a rpg:Spell ;
    rpg:name "Curse of Circe" ;
    dc:description "A transformation spell that turns a target into a pig; cited as an example whose effect could be modified by experimentation to turn the target into a goat instead." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:CurseOfTheUnportendedPlague a rpg:Spell ;
    rpg:name "Curse of the Unportended Plague" ;
    dc:description "A Perdo Corpus ritual (Level 55) that starts a plague within a city or boundary; its use or transcription is rigorously discouraged by most of the Order of Hermes." ;
    skos:altLabel "Curse of the Unportended Plaque" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:DeleteriousCircumstances a rpg:Tag ;
    skos:prefLabel "Deleterious Circumstances" ;
    dc:description "A Minor Hermetic Flaw that halves all of the magus's magic totals (excluding Magic Resistance) under certain uncommon circumstances of state, target, or place." ;
    rpg:hasTag amol:Flaw .
amol:DietrichOfBern a rpg:Character ;
    rpg:name "Dietrich of Bern" ;
    dc:description "A Daimon (Magic Might 35, Corpus) of the German hero and boy-king of Bern, whose tomb in the Lessini Mountains holds dragon-blood-enchanted arms; he animates his corpse to test those who enter." ;
    skos:altLabel "Dietrich" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:DiscernTheImagesOfTruthAndFalsehood a rpg:Spell ;
    rpg:name "Discern the Images of Truth and Falsehood" ;
    dc:description "An Intellego Imaginem (General) spell that lets the caster tell whether an image was created or altered by a spell, seeing both original and false images." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Dragon a rpg:Creature ;
    rpg:name "Dragon" ;
    dc:description "A dragon that killed the last Verditius magus (Parsirus) of Ungulus and against which Sinead burns for revenge; a magical force now pushes her away from it." ;
    skos:altLabel "Dragon-Slayers", "dragons" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Embitterment a rpg:Tag ;
    skos:prefLabel "Embitterment" ;
    dc:description "A Major Non-Hermetic Supernatural Ability of the Nemthengacha allowing a speaker, through conversation, to make a listener hostile to a chosen target, up to the level of murder." ;
    rpg:hasTag amol:Virtue .
amol:EnduranceOfTheBerserkers a rpg:Spell ;
    rpg:name "Endurance of the Berserkers" ;
    dc:description "A Rego Corpus spell (Level 15) that makes the caster's body act as though unwounded and unfatigued while concentrating, with deferred Fatigue loss." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:EnduringConstitution a rpg:Tag ;
    skos:prefLabel "Enduring Constitution" ;
    dc:description "A Minor, General Virtue allowing a character to withstand pain and fatigue, reducing Fatigue and wound penalties and granting +3 to resist pain." ;
    rpg:hasTag amol:Virtue .
amol:Enfeebled a rpg:Tag ;
    skos:prefLabel "Enfeebled" ;
    dc:description "A Major General Flaw preventing the character from exerting himself for more than a few seconds, rendering him helpless in combat or chases." ;
    rpg:hasTag amol:Flaw .
amol:England a schema:Place ;
    rpg:name "England" ;
    dc:description "A kingdom of Mythic Europe where women have fewer rights than in most other parts (partly an effect of the Norman Conquest) and large areas are set aside as noble hunting ranges; its king has sworn fealty to the king of France for mainland possessions." ;
    skos:altLabel "England and Wales" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Etiquette a rpg:Proficiency ;
    rpg:name "Etiquette" ;
    dc:description "The Ability central to Jerbiton 'tasteful living,' used to convey symbolic messages, make individual impressions at events, and force rivals into faux pas." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:FaerieDoctor a rpg:Tag ;
    skos:prefLabel "Faerie Doctor" ;
    dc:description "A Mythic Companion type: a faerie-trained healer who removes blights, banes, and diseases via Curse-Throwing, dowses for water and lost things, and keeps a faerie companion. They swear oaths to remain apart from humanity." ;
    skos:altLabel "Faerie Doctors", "Sin-Eater", "lybman" ;
    rpg:hasTag amol:CharacterType .
amol:FaerieUpbringing a rpg:Tag ;
    skos:prefLabel "Faerie Upbringing" ;
    dc:description "A Minor Personality Flaw in which the character was raised by faeries, gaining enhanced understanding of magic and faeries but finding human society bizarre." ;
    rpg:hasTag amol:Flaw .
amol:Fafnir a rpg:Creature ;
    rpg:name "Fafnir" ;
    dc:description "The great dragon slain by the hero Siegfried at Drachenfels, in whose blood Siegfried bathed to become invulnerable; his brood or his brother Regin's may still endure." ;
    skos:altLabel "the dragon Fafnir" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Fear a rpg:Tag ;
    skos:prefLabel "Fear" ;
    dc:description "A Minor Personality Flaw gained as an Ordeal in the sample Wayfarers Arcadian Travel Initiation, representing dread of something encountered on the path." ;
    skos:altLabel "Fear (of overt magic)" ;
    rpg:hasTag amol:Flaw .
amol:Fenistal a rpg:Faction ;
    rpg:name "Fenistal" ;
    dc:description "The hidden 'covenant' base of the exsules, located in the southern Bohemian Forest in the upper level of a powerful magic regio (aura 8); the original temple of Diana where Merinita served, occupied by renegade House Merinita exiles." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:Ferocity a rpg:Tag ;
    skos:prefLabel "Ferocity" ;
    dc:description "A Minor Virtue for beasts only, granting confidence points usable when the animal's natural ferocity is triggered, such as defending its den; possessed by many of the Beasts of Legend." ;
    skos:altLabel "Ferocity Virtue" ;
    rpg:hasTag amol:Virtue .
amol:FlawedParmaMagica a rpg:Tag ;
    skos:prefLabel "Flawed Parma Magica" ;
    dc:description "A Minor Hermetic Flaw in which the character's Parma Magica provides only half the normal Magic Resistance against a certain Form." ;
    skos:altLabel "Flawed Parma Magica Flaw" ;
    rpg:hasTag amol:Flaw .
amol:FranciscanOrder a rpg:Faction ;
    rpg:name "Franciscan Order" ;
    dc:description "A mendicant order of friars founded in Italy in 1209, found preaching in market places and public squares, which had not yet spread beyond Italy and France." ;
    skos:altLabel "Franciscans", "Friars Minor", "Gray Friars", "Order of Little Brothers", "followers of St. Francis" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:FrederickBarbarossa a rpg:Character ;
    rpg:name "Frederick Barbarossa" ;
    dc:description "The emperor who in 1190 granted Bolognese scholars freedom of movement throughout the Holy Roman Empire and safe residences, the root of universities' political autonomy." ;
    skos:altLabel "Emperor and King of Germany", "Frederick Barborossa", "Frederick I", "Frederick I Barbarossa" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Fudarus a rpg:Faction ;
    rpg:name "Fudarus" ;
    dc:description "The domus magna of House Tytalus, where the memory of Kalliste is ritually cursed each midwinter; it is currently occupied by both rival Primi and maintains an immense spy network." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:GiftOfTheBearSFortitude a rpg:Spell ;
    rpg:name "Gift of the Bear's Fortitude" ;
    dc:description "A Muto Corpus spell (Level 25) that makes the caster's flesh resistant to physical damage (+3 Soak) but insensitive to touch." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Glamour a rpg:Tag ;
    skos:prefLabel "Glamour" ;
    dc:description "A Major Illusion Mystery of House Merinita that creates illusions with real substance via Muto or Creo Imaginem; Merinitae gain the Vulnerable Magic Flaw on Initiation." ;
    skos:altLabel "Mysteries of Glamour", "glamor" ;
    rpg:hasTag amol:HermeticConcept .
amol:GoldenCord a rpg:Tag ;
    skos:prefLabel "Golden Cord" ;
    dc:description "The three mystical cords forged when binding a familiar: golden (magic), silver (mind), and bronze (body), each rated 0 to +5 and granting specific benefits." ;
    skos:altLabel "bronze cord", "silver cord" ;
    rpg:hasTag amol:HermeticConcept .
amol:GreatIntelligence a rpg:Tag ;
    skos:prefLabel "Great Intelligence" ;
    dc:description "A Virtue that raises a character's Intelligence Characteristic beyond the normal limit; an example Great Characteristic Virtue." ;
    skos:altLabel "Great Characteristic" ;
    rpg:hasTag amol:Virtue .
amol:GreaterMalediction a rpg:Tag ;
    skos:prefLabel "Greater Malediction" ;
    dc:description "A Major Supernatural Flaw in which the character has been cursed by a supernatural power in a way comparable to other Major Flaws." ;
    rpg:hasTag amol:Flaw .
amol:Greedy a rpg:Tag ;
    skos:prefLabel "Greedy" ;
    dc:description "A Minor Personality Flaw driving a character toward acquisitiveness; the Nephilim must take it due to their enormous appetite." ;
    rpg:hasTag amol:Flaw .
amol:Guile a rpg:Proficiency ;
    rpg:name "Guile" ;
    dc:description "An Ability governing deception and disguise used by Tytalan magi; rolled for disguises and serving as a Defense Ability in debate (supporting fabrication of the truth)." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:GuornaTheFetid a rpg:Character ;
    rpg:name "Guorna the Fetid" ;
    dc:description "Perhaps the greatest necromancer who ever lived, mater to Tytalus, Tremere, and Pralix; killed by her pupils after plotting to steal one of their bodies, cursing Tytalus with leprosy." ;
    skos:altLabel "Guorna" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:HanseaticLeague a rpg:Faction ;
    rpg:name "Hanseatic League" ;
    dc:description "A trade confederation of towns whose formation Oculus Septentrionalis becomes centrally involved in; its spread is encouraged by the demon Radegast and exploited by Imanitos Mendax." ;
    skos:altLabel "Hansa", "Hanse", "Hanseatic towns", "the League" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Hariste a rpg:Character ;
    rpg:name "Hariste" ;
    dc:description "Tytalus's cherished filia and the first Prima of House Tytalus; she collated his sayings into the Analects of Tytalus and founded the leper magi lineage when she contracted leprosy." ;
    skos:altLabel "Prima Hariste" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:HarmlessMagic a rpg:Tag ;
    skos:prefLabel "Harmless Magic" ;
    dc:description "A Minor Hermetic Flaw whereby the character's non-ritual Perdo spells cannot permanently destroy anything, merely disrupting targets temporarily like a Muto effect." ;
    rpg:hasTag amol:Flaw .
amol:Harpax a rpg:Character ;
    rpg:name "Harpax" ;
    dc:description "Buliste's younger Hermetic brother who became the tenth Primus of House Tytalus after she entered Twilight, then refused to relinquish leadership when she recovered; his supporters wear revolutionary green." ;
    skos:altLabel "the tenth Primus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:HedgeWizard a rpg:Tag ;
    skos:prefLabel "Hedge Wizard" ;
    dc:description "A practitioner of non-Hermetic magic who cannot be taught Hermetic Virtues but whose traditions can serve as sources of insight for Integration into Hermetic theory." ;
    skos:altLabel "Hedge magic", "hedge magic", "non-Hermetic wizard" ;
    rpg:hasTag amol:CharacterType .
amol:HenriDeTours a rpg:Character ;
    rpg:name "Henri de Tours" ;
    dc:description "A skilled diplomat and famous merchant associated with Oculus Septentrionalis, who may play a leading role in negotiating the Treaty of Lubeck and Hamburg and rising to become Alderman of the Hanseatic League." ;
    skos:altLabel "Henri" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:HermesPortal a rpg:Spell ;
    rpg:name "Hermes Portal" ;
    dc:description "A high-level Rego Terram ritual that creates a magical portal for near-instantaneous travel between two locations, cast simultaneously at both." ;
    skos:altLabel "Mercurian Ritual" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Hex a rpg:Tag ;
    skos:prefLabel "Hex" ;
    dc:description "A Supernatural Ability to bring injury or ruin upon enemies via eye contact, occult signs, or sympathetic magic, often a false power tainted by the Infernal." ;
    rpg:hasTag amol:Virtue .
amol:HildegardOfBingen a rpg:Character ;
    rpg:name "Hildegard of Bingen" ;
    dc:description "A famous Benedictine abbess and polymath (theology, medicine, music) of the 12th century, founder of Rupertsberg monastery; said to have been admitted to House Jerbiton as a pious unGifted Larta maga." ;
    skos:altLabel "Abbess Hildegard", "Hildegard" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Horst a rpg:Character ;
    rpg:name "Horst" ;
    dc:description "A 68-year-old master Redcap of House Mercere at Fengheld, a famed encyclopedic author (despite having no Gift) and the senior Redcap of the Rhine Tribunal." ;
    skos:altLabel "Horst of Fengheld", "Horst of House Mercere", "Horst, Follower of Mercere" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Iberia a schema:Place ;
    rpg:name "Iberia" ;
    dc:description "The region where Ramius joined House Flambeau's struggle against the Moorish wizards and perfected his combat method." ;
    skos:altLabel "Iberian Peninsula" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Infamous a rpg:Tag ;
    skos:prefLabel "Infamous" ;
    dc:description "A minor Flaw representing a damaging reputation, likely to inconvenience a principal and lower an agent's Resistance Strength." ;
    rpg:hasTag amol:Flaw .
amol:InoffensiveToAnimals a rpg:Tag ;
    skos:prefLabel "Inoffensive to Animals" ;
    dc:description "A Virtue often possessed by Donatores who received a vision from Saint Gertrude of Nivelles." ;
    rpg:hasTag amol:Virtue .
amol:Jerusalem a schema:Place ;
    rpg:name "Jerusalem" ;
    dc:description "A major city of Mythic Europe suggested as a covenant location; casting a spell in its Church of the Holy Sepulcher carries the maximum botch dice." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:JupiterSResoundingBlow a rpg:Spell ;
    rpg:name "Jupiter's Resounding Blow" ;
    dc:description "A Creo Auram spell (Level 10) that creates a thunderclap that may deafen anyone directly underneath." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:KeenSenseOfSmell a rpg:Tag ;
    skos:prefLabel "Keen Sense of Smell" ;
    dc:description "A Minor General Virtue giving a +3 bonus to all rolls involving the sense of smell, including tracking with the Hunt Ability." ;
    rpg:hasTag amol:Virtue .
amol:Knight a rpg:Tag ;
    skos:prefLabel "Knight" ;
    dc:description "A Minor, Social Status Virtue for a member of the noble warrior class who may have high-quality weapons, armor, and a horse, and take Martial Abilities." ;
    rpg:hasTag amol:Virtue .
amol:LandedNoble a rpg:Tag ;
    skos:prefLabel "Landed Noble" ;
    dc:description "A Major Social Status Virtue granting a character an agency prior to play; listed with a Resistance of 3 on the Resistance of Agents Table." ;
    rpg:hasTag amol:Virtue .
amol:LayToRestTheHauntingSpirit a rpg:Spell ;
    rpg:name "Lay to Rest the Haunting Spirit" ;
    dc:description "A Perdo Mentem (General) spell that reduces a ghost or spirit's Might by the spell's level if it penetrates, causing the spirit to vanish if its Might reaches zero." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:LeperMagus a rpg:Tag ;
    skos:prefLabel "Leper Magus" ;
    dc:description "A Major Hermetic Virtue exclusive to House Tytalus describing the mystic legacy of leprosy passed from Tytalus through Hariste's line; grants Life Boost and lets the magus mortify his flesh to produce vis." ;
    rpg:hasTag amol:Virtue .
amol:LesserPurifyingTouch a rpg:Tag ;
    skos:prefLabel "Lesser Purifying Touch" ;
    dc:description "A Minor, Supernatural Virtue letting a character heal a specific minor or self-recovering illness with a touch and a Fatigue level." ;
    rpg:hasTag amol:Virtue .
amol:LightningReflexes a rpg:Tag ;
    skos:prefLabel "Lightning Reflexes" ;
    dc:description "A Virtue granting superior reflexes, cited in connection with the adder's reflexive attacks and listed as suitable for beasts." ;
    rpg:hasTag amol:Virtue .
amol:LimitOfTheDivine a rpg:Tag ;
    skos:prefLabel "Limit of the Divine" ;
    dc:description "One of the two fundamental limits of Hermetic magic: magic cannot affect the Divine, with most lesser limits believed to derive from it." ;
    rpg:hasTag amol:HermeticConcept .
amol:LongWinded a rpg:Tag ;
    skos:prefLabel "Long-Winded" ;
    dc:description "A Minor Virtue acquirable by a Bjornaer inner heartbeast and suitable for beasts such as the wild goat, horse, and wolf." ;
    rpg:hasTag amol:Virtue .
amol:Loreley a rpg:Creature ;
    rpg:name "Loreley" ;
    dc:description "A beautiful, malevolent water faerie (Faerie Might 30, Aquam) who lures sailors to their deaths from the cliffs of the Rhine Gorge with her song; daughter of the Rhine Spirit." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:LossOfButAMomentSMemory a rpg:Spell ;
    rpg:name "Loss of But a Moment's Memory" ;
    dc:description "A spell that removes up to five continuous minutes from a target's memory, leaving a blank focused on a specific event or time." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:MagicalWarder a rpg:Tag ;
    skos:prefLabel "Magical Warder" ;
    dc:description "A Major General Virtue giving the character a magical being, such as a ghost, that watches over him and comes to no harm; designed as a magic character." ;
    rpg:hasTag amol:Virtue .
amol:MaskingTheOdorOfMagic a rpg:Spell ;
    rpg:name "Masking the Odor of Magic" ;
    dc:description "A spell of magical concealment that hides the traces of magic, which Tabanus's Reveal the Magical Deception is designed to overcome." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:MendicantFriar a rpg:Tag ;
    skos:prefLabel "Mendicant Friar" ;
    dc:description "A Minor Social Status Virtue for a follower of St. Francis or St. Dominic who wanders among rich and poor spreading the word of God." ;
    rpg:hasTag amol:Virtue .
amol:Michael a rpg:Creature ;
    rpg:name "Michael" ;
    dc:description "A minor demon (Might 10, Corpus) who tempts people to wrath through elaborate, painful practical jokes disguised as the victim's friends, taking the name of the famous angel." ;
    skos:altLabel "archangel Michael" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:MichaelScot a rpg:Character ;
    rpg:name "Michael Scot" ;
    dc:description "Named court wizard of Frederick II, the Holy Roman Emperor, cited as a Greater example of profiting from wizardry." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:MirrorOfOpposition a rpg:Spell ;
    rpg:name "Mirror of Opposition" ;
    dc:description "A Muto Vim spell cast on another spell being cast, causing it to have the exact opposite of its normal effects; ten Form-specific versions exist." ;
    skos:altLabel "Mirror of Opposition (form)", "Mirror of Opposition [Form]" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Muse a rpg:Tag ;
    skos:prefLabel "Muse" ;
    dc:description "A title for any supernatural entity from the four realms that attaches itself to a prominent artist, granting Virtues, powers, and Warping in exchange for promoting its interests, eventually carrying the artist to its home realm." ;
    skos:altLabel "muses" ;
    rpg:hasTag amol:Virtue .
amol:MysticalChoreography a rpg:Tag ;
    skos:prefLabel "Mystical Choreography" ;
    dc:description "A Minor Hermetic Virtue letting a magus perform Ceremonial Magic faster (five minutes per magnitude, or one minute in a prepared space) through skilled body movement." ;
    rpg:hasTag amol:Virtue .
amol:MythicPound a rpg:Tag ;
    skos:prefLabel "Mythic Pound" ;
    dc:description "The standardized currency unit used for prices in Ars Magica, equivalent to a pound of silver, a typical peasant's annual income, or a year's upkeep of an average Hermetic laboratory." ;
    skos:altLabel "Mythic Pounds" ;
    rpg:hasTag amol:HermeticConcept .
amol:Oakdell a rpg:Faction ;
    rpg:name "Oakdell" ;
    dc:description "A former covenant founded 934 AD by magi of House Diedne in the Westerwald; razed to the ground with all its Diedne magi slain during the Schism War in 1016 AD." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:Optimistic a rpg:Tag ;
    skos:prefLabel "Optimistic" ;
    dc:description "A Personality Flaw making a character habitually optimistic; held by the Scribe template, swappable for Carefree or Pessimistic." ;
    rpg:hasTag amol:Flaw .
amol:PalmOfFlame a rpg:Spell ;
    rpg:name "Palm of Flame" ;
    dc:description "A Creo Ignem spell (Level 5) in which a flame leaps up in the caster's upturned palm, casting torch-like light and igniting flammable items without burning or damaging the caster." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Parens a rpg:Tag ;
    skos:prefLabel "Parens" ;
    dc:description "A magus's master/teacher within the Order; the parens trains the apprentice, sets the gauntlet, and conventionally is regarded as a superior throughout life." ;
    skos:altLabel "filia", "filii", "filius", "parentes", "pater" ;
    rpg:hasTag amol:HermeticConcept .
amol:PerfectBalance a rpg:Tag ;
    skos:prefLabel "Perfect Balance" ;
    dc:description "A Minor General Virtue granting +6 to rolls to avoid falling or tripping, especially on narrow ledges or tightropes." ;
    rpg:hasTag amol:Virtue .
amol:PetrusOfVerdun a rpg:Character ;
    rpg:name "Petrus of Verdun" ;
    dc:description "A tenth-century Primus of House Jerbiton who advocated magi living within mundane communities as wealthy citizens, abandoning multi-House covenants." ;
    skos:altLabel "Petrus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:PhilippusNiger a rpg:Character ;
    rpg:name "Philippus Niger" ;
    dc:description "An Archmage of Durenmar who uses the Holy Vehm to execute hedge magicians and at least one Marched magus, and promotes spread of the Vehmgerichte as a tool against hedge wizards." ;
    skos:altLabel "Archmage Philippus", "Archmage Philippus Niger", "Philippus", "Philippus the Black" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:PitOfTheGapingEarth a rpg:Spell ;
    rpg:name "Pit of the Gaping Earth" ;
    dc:description "A Perdo Terram (PeTe 15) spell that opens a pit beneath a target's feet; no one can resist it, so it bypasses Magic Resistance, and it can also create defensive trenches." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:PoorHearing a rpg:Tag ;
    skos:prefLabel "Poor Hearing" ;
    dc:description "A Minor General Flaw subtracting 3 from rolls involving hearing and making hard-to-understand speech nearly impossible to follow." ;
    rpg:hasTag amol:Flaw .
amol:PosingTheSilentQuestion a rpg:Spell ;
    rpg:name "Posing the Silent Question" ;
    dc:description "An Intellego Mentem spell (Level 20) that lets the caster ask one silent mental question of a target and detect the answer, limited by the target's knowledge." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ProfessionScribe a rpg:Proficiency ;
    rpg:name "Profession: Scribe" ;
    dc:description "A profession Ability; in one season a character can copy Profession: Scribe x 60 levels of Laboratory Texts that are already written understandably." ;
    skos:altLabel "Scribe" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:PryingEyes a rpg:Spell ;
    rpg:name "Prying Eyes" ;
    dc:description "An Intellego Imaginem spell that lets the caster see inside a room as long as they touch one of its walls, changing viewpoint within during the duration." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Radegast a rpg:Creature ;
    rpg:name "Radegast" ;
    dc:description "An archetypal Slavic god of chieftainship, war, fertility, and harvest worshipped at Rethra and Mount Radhost; in saga material revealed as a powerful demon controlling the Slavic lands and a willing source of vis through human sacrifice." ;
    skos:altLabel "Radhost" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Reckless a rpg:Tag ;
    skos:prefLabel "Reckless" ;
    dc:description "A Major or Minor Personality Flaw in which the character fails to notice threatening situations and charges right in." ;
    rpg:hasTag amol:Flaw .
amol:Relic a rpg:Item ;
    rpg:name "Relic" ;
    dc:description "Physical objects housing part of the power of the Divine, often parts of saints' bodies; they grant Faith Points, Divine Might, Magic Resistance, and an aura hostile to Infernal creatures." ;
    skos:altLabel "Relics", "Sample Relic Powers", "relics" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:Rethra a rpg:Faction ;
    rpg:name "Rethra" ;
    dc:description "A former great Slavic pagan fortress-temple housing the Oracle of the god Radegast; once a covenant of Slavic magi-priests, it was abolished by the Tribunal in 1207 and retains a Faerie aura of 4 (secretly Infernal)." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:RisingIre a rpg:Spell ;
    rpg:name "Rising Ire" ;
    dc:description "A Creo Mentem spell (Level 15) that makes the target furious at someone or something of the caster's choice; an appropriate Personality Trait roll can hold the anger in check." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:RGen a schema:Place ;
    rpg:name "Rügen" ;
    dc:description "An island in the Eastern Marches that is home to the covenant of Crintera and a focus of the Crintera Schism; the spread of the Church there makes recruiting difficult." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Sahir a rpg:Faction ;
    rpg:name "Sahir" ;
    dc:description "A type of non-Hermetic wizard of the Mythic Middle East; an Infernally-aligned sahir bound the Buran of Yenghissar within his ancestral sword using the Goetic Art of Binding." ;
    skos:altLabel "Hermetic Sahirs", "Sahirs", "sahira", "sahirs" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Schwall a rpg:Character ;
    rpg:name "Schwall" ;
    dc:description "An eccentric elderly Bjornaer magus and Wilderist of the Hawthorn Gild, formerly of Rheinstein, living at the Rhinefalls; he plots to release the Rhine elemental and merge with its spirit." ;
    skos:altLabel "Schwall of Bjornaer" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:ShortAttentionSpan a rpg:Tag ;
    skos:prefLabel "Short Attention Span" ;
    dc:description "A Minor Flaw that affected covenfolk may acquire after a year under the Instant Loyalty of the Rebellious Turb ritual." ;
    rpg:hasTag amol:Flaw .
amol:SimpleMinded a rpg:Tag ;
    skos:prefLabel "Simple-Minded" ;
    dc:description "A Minor Personality Flaw in which the character can only think about one thing at a time and becomes easily confused without clear instructions." ;
    rpg:hasTag amol:Flaw .
amol:SlowCaster a rpg:Tag ;
    skos:prefLabel "Slow Caster" ;
    dc:description "A Minor Hermetic Flaw given to Confraternity of Irene Initiates, whose spellcasting mimics the long time it takes to paint or sculpt." ;
    rpg:hasTag amol:Flaw .
amol:SmallFrame a rpg:Tag ;
    skos:prefLabel "Small Frame" ;
    dc:description "A Minor General Flaw in which the character is of lighter-than-average build with Size reduced to -1; incompatible with Giant Blood, Large, or Dwarf." ;
    rpg:hasTag amol:Flaw .
amol:Stealth a rpg:Proficiency ;
    rpg:name "Stealth" ;
    dc:description "The Ability governing hiding and moving unseen; gains large bonuses from invisibility for hiding, contested in opposed rolls to locate invisible characters." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:Stentorius a rpg:Character ;
    rpg:name "Stentorius" ;
    dc:description "A powerful older House Tremere Archmagus, leader of Fengheld in the Rhine Tribunal, who holds three-fifths of the Tremere sigils there and commands the House in that Tribunal." ;
    skos:altLabel "Archmage Stentorius", "Archmagus Stentorius", "Stentorius of Fengheld", "Stentorius of Tremere", "Stentorius, Follower of Tremere" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Sufi a rpg:Tag ;
    skos:prefLabel "Sufi" ;
    dc:description "Muslim mystics organized into tariqas led by shaykhs, seeking union with God; some wield supernatural powers and one Egyptian school uses unreadable texts for meditation." ;
    skos:altLabel "Sufi Muslims", "tariqa" ;
    rpg:hasTag amol:Virtue .
amol:SupernaturalBeauty a rpg:Tag ;
    skos:prefLabel "Supernatural Beauty" ;
    dc:description "A Major Supernatural Virtue of mystical beauty that calls royal power, folk magic, and heroism to its defense, letting the player request a fortunate coincidence once per story." ;
    rpg:hasTag amol:Virtue .
amol:SupernaturalNuisance a rpg:Tag ;
    skos:prefLabel "Supernatural Nuisance" ;
    dc:description "A Major Story Flaw in which supernatural entities interfere in the character's life in minor ways, without long-term plans, whenever he is around them." ;
    skos:altLabel "Supernatural Nuisance Flaw" ;
    rpg:hasTag amol:Flaw .
amol:Survival a rpg:Proficiency ;
    rpg:name "Survival" ;
    dc:description "A General Ability covering finding food, water, shelter, routes, and safety in the wilderness, including building fires and cooking without implements." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:TasteOfTheSpicesAndHerbs a rpg:Spell ;
    rpg:name "Taste of the Spices and Herbs" ;
    dc:description "A Muto Imaginem spell (Level 5) that makes a setting's worth of food or drink taste and smell exactly as the caster designates." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TemporalInfluence a rpg:Tag ;
    skos:prefLabel "Temporal Influence" ;
    dc:description "A minor general Virtue granting influence in mundane government or institutions; raises an agent's Resistance Strength, as with the merchant Godfroi." ;
    rpg:hasTag amol:Virtue .
amol:TheBountifulFeast a rpg:Spell ;
    rpg:name "The Bountiful Feast" ;
    dc:description "A Creo Herbam ritual (Level 35) cast at noon the day after the winter solstice to ensure crops within its target grow healthy and fruitful." ;
    skos:altLabel "Bountiful Feast, The" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheCrystalDart a rpg:Spell ;
    rpg:name "The Crystal Dart" ;
    dc:description "A Muto Terram spell (with Rego requisite) that transforms a stone into a 10-inch crystal dart that flies at a target for +5 damage." ;
    skos:altLabel "Crystal Dart, The" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheDonatoresRequietisAeternae a rpg:Faction ;
    rpg:name "The Donatores Requietis Aeternae" ;
    dc:description "A young, secretive necromantic tradition of House Ex Miscellanea with religious backgrounds who ensure the spirits of the dead reach their final rest using the Banishing Ability." ;
    skos:altLabel "Donator", "Donatores", "Donatores (necromancers)", "Givers of Eternal Rest" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:TheMysteriesRevisedEdition a rpg:Item ;
    rpg:name "The Mysteries Revised Edition" ;
    dc:description "An Ars Magica supplement detailing Mysteries such as Hermetic Theurgy, Names of Power, Invocation Magic, Hermetic Synthemata, Ascendancy to the Hall of Heroes, and the Inscription on the Soul Virtue." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:ThePharmacopoeians a rpg:Faction ;
    rpg:name "The Pharmacopoeians" ;
    dc:description "A Minor Hermetic Virtue letting a magus collect magical ingredients to reduce the vis cost of healing Rituals; defining Virtue of the Pharmacopoeians." ;
    skos:altLabel "Pharmacoepians", "Root-Cutter", "Root-Cutters" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:TheRhineGorge a schema:Place ;
    rpg:name "The Rhine Gorge" ;
    dc:description "The narrow, castle-lined stretch of the Rhine between Bingen and Koblenz where nobles enforce tolls; the focus of the saga and supposedly cursed, with all its covenants failing within seven decades." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheWalkingCorpse a rpg:Spell ;
    rpg:name "The Walking Corpse" ;
    dc:description "A spell that animates a corpse into an automaton; such corpses use a revenant's physical statistics but are not supernatural and have no Might score or Magic Resistance." ;
    skos:altLabel "Walking corpses" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Theurgy a rpg:Tag ;
    skos:prefLabel "Theurgy" ;
    dc:description "A Hermetic Mystery of summoning and dealing with spirits, including Aspects of Daimons, requiring synthemata and long invocations; ordinary Hermetic magic cannot summon a Daimon's Aspect without it." ;
    skos:altLabel "Hermetic Theurgy", "Mystery of Theurgy", "Theurgist", "theurgist", "theurgists" ;
    rpg:hasTag amol:Virtue .
amol:TracksOfTheFaerieGlow a rpg:Spell ;
    rpg:name "Tracks of the Faerie Glow" ;
    dc:description "A spell used in a Performance Magic example; its Hunter's variant is cast by Harold using Performance Magic (Hunt) to gain magically enhanced vision while hunting." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Treverorum a rpg:Faction ;
    rpg:name "Treverorum" ;
    dc:description "A former covenant in the city of Trier dedicated to recovering lost Roman secrets, approved in 1095 AD; abolished in 1172 AD after its magi repeatedly meddled in the affairs of mundanes and the Church." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:UnseenArm a rpg:Spell ;
    rpg:name "Unseen Arm" ;
    dc:description "A Rego Terram spell (ReTe 5) used to hold an object in the air without concentration; moving the object still requires concentration." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:VerditiusElderRunes a rpg:Tag ;
    skos:prefLabel "Verditius Elder Runes" ;
    dc:description "A Verditius Inner Mystery and set of philosophically-grounded runes, derived from Wayland's rune magic and refined by Boethius's philosophy, carved to add power to enchantments." ;
    skos:altLabel "Elder Runes", "Verditius Rune", "Verditius Runes", "Verditius lesser runes", "elder runes" ;
    rpg:hasTag amol:HermeticConcept .
amol:VictorOfMercere a rpg:Character ;
    rpg:name "Victor of Mercere" ;
    dc:description "A famous magus of House Mercere from Semita Errabunda; a faerie dell named Victor Valley after him might be inhabited by a faerie sharing his reputed qualities." ;
    skos:altLabel "Victor" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Vinaria a rpg:Character ;
    rpg:name "Vinaria" ;
    dc:description "An archmage and former Prima of House Merinita who stepped down after being outmaneuvered by Handri; she returned after seven years of claimed Faerie Twilight with a new inner strength that frightens Handri, and is strong in the raw elemental arts." ;
    skos:altLabel "Archmage Vinaria", "Vinaria of Irencillia", "Vinaria of Merinita" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Voluntas a rpg:Faction ;
    rpg:name "Voluntas" ;
    dc:description "A vigorous covenant near the village of Wilton, founded by Norman magi, that has led the anti-Blackthorn opposition for over a century and is famed for its library." ;
    skos:altLabel "Voluntas covenant" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:WardAgainstFaeriesOfTheWater a rpg:Spell ;
    rpg:name "Ward Against Faeries of the Water" ;
    dc:description "A Rego Aquam General ward spell preventing water faeries whose Faerie Might is at or below the spell level from affecting those targeted." ;
    skos:altLabel "ReAq Gen", "Ward Against Faeries of the Waters" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:WeightOfAThousandHells a rpg:Spell ;
    rpg:name "Weight of a Thousand Hells" ;
    dc:description "A Creo Mentem spell (Level 25) that makes the victim feel the despair and pain of a thousand sinners in Hell, sapping motivation and imposing penalties on thought and Personality Trait rolls." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:WhispersThroughTheBlackGate a rpg:Spell ;
    rpg:name "Whispers Through the Black Gate" ;
    dc:description "An Intellego Corpus spell (Level 15) with a Mentem requisite that lets you speak through the barrier between living and dead to one undecayed corpse." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:WilliamMarshal a rpg:Character ;
    rpg:name "William Marshal" ;
    dc:description "The greatest knight in Europe (1147-1219), earl of Pembroke and regent of England after King John's death, who rose from a minor lord's younger son." ;
    skos:altLabel "William Marshal, earl of Pembroke", "the Marshal" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:WinterSIcyTouch a rpg:Spell ;
    rpg:name "Winter's Icy Touch" ;
    dc:description "A Perdo Ignem spell (Level 10) that causes the target to feel a chill and lose body heat, costing them a Fatigue level." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:WiseOne a rpg:Tag ;
    skos:prefLabel "Wise One" ;
    dc:description "A Minor Social Status Virtue for a member of a broad class of mystics, seers, and healers, well regarded in the community." ;
    rpg:hasTag amol:Virtue .
amol:WizardSBoost a rpg:Spell ;
    rpg:name "Wizard's Boost" ;
    dc:description "A Vim spell example that is not eligible for the Rebuttal Mastery special ability because it does not affect a spell used by another being." ;
    skos:altLabel "Wizard's Boost (Form)" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Aachen a schema:Place ;
    rpg:name "Aachen" ;
    dc:description "A city founded by Charlemagne over Roman thermal springs; its cathedral houses his tomb, holy relics, and the throne where the German king is crowned. Its Divine aura sapped a local forest spirit." ;
    skos:altLabel "Aix-la-Chapelle" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Abdkypris a rpg:Character ;
    rpg:name "Abdkypris" ;
    dc:description "A recent Criamon Primus who traveled through Muslim Iberia, North Africa, and the Levant, introducing Sufi wisdom and the Path of Walking Backwards into the House." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:AcademicConcentration a rpg:Tag ;
    skos:prefLabel "Academic Concentration" ;
    dc:description "A General, Minor Virtue: the character concentrates in one of the seven Artes Liberales subjects for +3 to that subject but -1 to the others; incompatible with Puissant Artes Liberales." ;
    skos:altLabel "Academic Concentration (Subject)", "Academic Concentration (subject)" ;
    rpg:hasTag amol:Virtue .
amol:AdranusTheSpiritOfMountEtna a rpg:Creature ;
    rpg:name "Adranus, the Spirit of Mount Etna" ;
    dc:description "A powerful Magic spirit (Might 50, Ignem) coterminous with Mount Etna, able to duplicate Creo/Rego/Muto/Perdo Ignem and Terram spells and grant Flaws such as Visions, Simple-Minded, and Wrathful." ;
    skos:altLabel "Adranus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:AlluringToBeings a rpg:Tag ;
    skos:prefLabel "Alluring to (Beings)" ;
    dc:description "A Minor General Virtue making animals, faeries, or magical beings strangely drawn to the character, granting +3 to Communication and Presence rolls to affect them." ;
    skos:altLabel "Alluring" ;
    rpg:hasTag amol:Virtue .
amol:AristotelianTraining a rpg:Tag ;
    skos:prefLabel "Aristotelian Training" ;
    dc:description "A General, Minor Virtue: the character was trained in the New Aristotle, gaining +1 to Artes Liberales rolls for grammar, logic, rhetoric, +1 to Disputatio Totals, and (for magi) +1 to relevant Lab Totals." ;
    rpg:hasTag amol:Virtue .
amol:Arliandus a rpg:Character ;
    rpg:name "Arliandus" ;
    dc:description "A magus of House Tremere whose intact sanctum beneath Trier, specialized in Mentem study, was protected by his enchanted Door of Deimos and held Hermetic treasures." ;
    skos:altLabel "Arliandus of Tremere" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Automata a rpg:Tag ;
    skos:prefLabel "Automata" ;
    dc:description "A Major House Mystery for constructing mechanized beasts and men of wood, stone, or metal, imbued with Magic Might and enchanted to perform tasks like servants." ;
    skos:altLabel "Automaton", "automaton" ;
    rpg:hasTag amol:Virtue .
amol:Avarret a rpg:Character ;
    rpg:name "Avarret" ;
    dc:description "Magus elevated to Primus of House Bonisagus in 1191, returning the House to conservative refinement of Hermetic theory; selected Murion as successor before Final Twilight." ;
    skos:altLabel "Avarret of Bonisagus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:AwakenTheSlumberingCorpse a rpg:Spell ;
    rpg:name "Awaken the Slumbering Corpse" ;
    dc:description "A Rego Corpus spell (Level 25) that causes a corpse to function at simple verbal commands; the corpse cannot have been buried by Church ceremony." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:BaneOfTheDecrepitBody a rpg:Spell ;
    rpg:name "Bane of the Decrepit Body" ;
    dc:description "A Perdo Corpus spell (Level 25) that ages the target 5 years; does not work on children younger than 16." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Banishing a rpg:Tag ;
    skos:prefLabel "Banishing" ;
    dc:description "A Major Supernatural Accelerated Ability of the Donatores that banishes any creature with a Might score from a designated area for a time; aligned with the Divine for the Donatores but possible with any realm." ;
    rpg:hasTag amol:Virtue .
amol:BeastMasters a rpg:Faction ;
    rpg:name "Beast Masters" ;
    dc:description "An Ex Miscellanea tradition whose apprentices are abandoned in the wilderness and develop the Summon Animals Virtue, Animal Ken, and a Minor Magical Focus with a specific group of animals." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:BenedictineOrder a rpg:Faction ;
    rpg:name "Benedictine Order" ;
    dc:description "The oldest and most important monastic order, founded on the rule of Benedict of Nursia, whose monks are known as black monks and number around 3,800 in England." ;
    skos:altLabel "Benedictines", "black monks" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Blackmail a rpg:Tag ;
    skos:prefLabel "Blackmail" ;
    dc:description "A Flaw used to represent coercion of an agent by a principal, such as a priest controlling a knight through blackmail or other leverage." ;
    rpg:hasTag amol:Flaw .
amol:BladeOfTheVirulentFlame a rpg:Spell ;
    rpg:name "Blade of the Virulent Flame" ;
    dc:description "A Creo Ignem spell (Level 15) that forms fire along a metal blade, doubling the weapon's damage (or adding +5) and starting fires; repeated castings can melt the blade." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Blind a rpg:Tag ;
    skos:prefLabel "Blind" ;
    dc:description "A Major General Flaw: the character has little or no sight, making missile weapons futile and reading impossible; blind magi cannot aim spells without magical aid." ;
    rpg:hasTag amol:Flaw .
amol:Bockman a rpg:Creature ;
    rpg:name "Bockman" ;
    dc:description "A horrible goat-headed faerie that lurks on Black Forest paths to ambush travelers using its Unease of the Still Forest and Fear powers; physically weak and cowardly, with Animal and Mentem vis in its horns." ;
    skos:altLabel "Bockmann", "Bockmänner", "bockmen", "man-goat" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:BreathOfTheOpenSky a rpg:Spell ;
    rpg:name "Breath of the Open Sky" ;
    dc:description "A Creo Auram Ritual spell (Level 40) that calls up a wind capable of devastating the countryside, toppling structures and trees." ;
    skos:altLabel "ReAu40" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:BrutalArtist a rpg:Tag ;
    skos:prefLabel "Brutal Artist" ;
    dc:description "A Minor Hermetic Flaw available only to magi of House Jerbiton: the magus makes ugly art, suffering -3 on social rolls with Jerbiton magi and unable to gain a positive Reputation in the House." ;
    rpg:hasTag amol:Flaw .
amol:Buliste a rpg:Character ;
    rpg:name "Buliste" ;
    dc:description "The ninth Prima of House Tytalus who entered a protracted Twilight, was declared dead, and on recovery in 1198 contested leadership with Harpax; her loyalists wear royal purple." ;
    skos:altLabel "the ninth Prima" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Burnham a rpg:Faction ;
    rpg:name "Burnham" ;
    dc:description "An aloof covenant in the far northeast of the tribunal, a motte-and-bailey castle holding a grant of immunity from the crown; rarely sends representatives to tribunal." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:CalmTheMotionOfTheHeart a rpg:Spell ;
    rpg:name "Calm the Motion of the Heart" ;
    dc:description "A spell that removes one emotion from the target until it appears again naturally, such as making an angry person stop being angry." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Canterbury a schema:Place ;
    rpg:name "Canterbury" ;
    dc:description "Capital of Kent and metropolitan see of the English church; site of Becket's martyrdom and his shrine, the fourth main pilgrimage site in Europe." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Cathars a rpg:Faction ;
    rpg:name "Cathars" ;
    dc:description "A heresy spreading in southern France (Languedoc) against which Brother Julian preaches and which the Church combats through the faculties of theology." ;
    skos:altLabel "Albigensians", "Cathar heretics" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Cercistum a rpg:Character ;
    rpg:name "Cercistum" ;
    dc:description "A Primus of House Tremere during the Schism War, quoted observing that the Tytali fought a different battle on the Plain of Wolves than the Tremere pretended to." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:ChamberOfSpringBreezes a rpg:Spell ;
    rpg:name "Chamber of Spring Breezes" ;
    dc:description "A Creo Auram spell (Level 5) that creates a breeze of fresh air keeping a room's air breathable even if airtight." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ChaosOfTheAngryWaves a rpg:Spell ;
    rpg:name "Chaos of the Angry Waves" ;
    dc:description "A Rego Aquam spell (Level 30) that causes water to churn wildly in a circular area, overturning small craft and penalizing Swim rolls." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ChaoticMagic a rpg:Tag ;
    skos:prefLabel "Chaotic Magic" ;
    dc:description "A Major Hermetic Flaw: the magus's spontaneous magic is wild, and if it falls short of or exceeds the desired level by more than one, the storyguide decides the uncontrolled results." ;
    rpg:hasTag amol:Flaw .
amol:ChargeOfTheAngryWinds a rpg:Spell ;
    rpg:name "Charge of the Angry Winds" ;
    dc:description "An Auram spell whose effect is duplicated by an air elemental power of the same name, adding the elemental's Strength to Ease Factors for acting within the wind." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ChargedItem a rpg:Item ;
    rpg:name "Charged Item" ;
    dc:description "An enchanted item costing no vis that can be used a limited number of times, gaining one charge per five points the Lab Total exceeds the effect level." ;
    skos:altLabel "Charged Items" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:Chimera a rpg:Creature ;
    rpg:name "Chimera" ;
    dc:description "A noble hybrid inner heartbeast combining features of two mundane creatures (such as a griffin, hippogriff, or unicorn), produced by the Mystery of the Chimera." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:CircleOfBeastWarding a rpg:Spell ;
    rpg:name "Circle of Beast Warding" ;
    dc:description "A Rego Animal spell (Level 5) in which the caster inscribes a circle that no normal beast will cross." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:CirclingWindsOfProtection a rpg:Spell ;
    rpg:name "Circling Winds of Protection" ;
    dc:description "A Creo Auram spell (Level 20) with a Rego requisite that surrounds the caster with fast-circling winds that obscure and penalize attacks against them." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:CistercianOrder a rpg:Faction ;
    rpg:name "Cistercian Order" ;
    dc:description "A monastic order founded by Robert of Molesme at Cîteaux and spread by Bernard of Clairvaux, the white monks who farm sheep in isolated areas and drive out inhabitants of acquired lands." ;
    skos:altLabel "Cistercians", "white monks" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:ClenchingGraspOfTheCrushedHeart a rpg:Spell ;
    rpg:name "Clenching Grasp of the Crushed Heart" ;
    dc:description "A Perdo Corpus spell (Level 40) that, with a clenching motion of the hand, causes the victim to double over and die at once." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Clerk a rpg:Tag ;
    skos:prefLabel "Clerk" ;
    dc:description "A Minor Social Status Virtue for a literate professional such as a scribe, accountant, lawyer, or functionary, possibly in minor or holy orders." ;
    rpg:hasTag amol:Virtue .
amol:CloudsOfRainAndThunder a rpg:Spell ;
    rpg:name "Clouds of Rain and Thunder" ;
    dc:description "A Creo Auram spell (Level 25) that creates a small but severe rainstorm with lightning and winds while the caster concentrates." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Clovis a rpg:Character ;
    rpg:name "Clovis" ;
    dc:description "A Gifted descendant of Merovech who rose to become the first Christian Frankish king and founder of the Merovingian dynasty, whose magical lineage endured after his death." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Clutch a rpg:Tag ;
    skos:prefLabel "Clutch" ;
    dc:description "A study group of the Criamon magi within a single Tribunal, originally living as a covenant following a single path; the Cave of Twisting Shadows holds the Central Clutch." ;
    skos:altLabel "Central Clutch", "clutches" ;
    rpg:hasTag amol:HermeticConcept .
amol:CoatOfFlame a rpg:Spell ;
    rpg:name "Coat of Flame" ;
    dc:description "A Creo Ignem spell (Level 25) with a Rego requisite that swathes the target in fire dealing +5 damage every round while the spell is in effect; the requisite keeps the fire from spreading." ;
    skos:altLabel "Coat of Flame, R: Touch" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:CommonSense a rpg:Tag ;
    skos:prefLabel "Common Sense" ;
    dc:description "A Virtue whose effects are granted by Familiarity with the Fae, but only in situations pertaining to faeries." ;
    rpg:hasTag amol:Virtue .
amol:Conciatta a rpg:Character ;
    rpg:name "Conciatta" ;
    dc:description "A brilliant tenth-century theorist of House Bonisagus who extended Hermetic magic to affect the Divine, Faerie, and Infernal realms and famously suffered from The Constant Expression Flaw." ;
    skos:altLabel "Conciatta of Bonisagus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:CorpseMagic a rpg:Proficiency ;
    rpg:name "Corpse Magic" ;
    dc:description "A Supernatural Ability allowing the character to temporarily revive and command a relatively intact, unburied corpse." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:CrippleTheHowlingWolf a rpg:Spell ;
    rpg:name "Cripple the Howling Wolf" ;
    dc:description "A Perdo Animal spell (Level 25) that cleanly breaks one of a target animal's legs, with damage healing as a Medium Wound." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:CurseOfTheDesert a rpg:Spell ;
    rpg:name "Curse of the Desert" ;
    dc:description "A Perdo Aquam spell that removes virtually all fluid from a target's body, dealing damage that armor does not protect against; the target must drink within minutes or die." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:CurseOfTheRhineGorge a rpg:Tag ;
    skos:prefLabel "Curse of the Rhine Gorge" ;
    dc:description "A purported long-term doom causing every covenant and noble dynasty of the Rhine Gorge to fail within roughly seven decades; attributed to one of four supernatural realm causes." ;
    skos:altLabel "The Curse" ;
    rpg:hasTag amol:HermeticConcept .
amol:Decrepitude a rpg:Tag ;
    skos:prefLabel "Decrepitude" ;
    dc:description "A score that increases like an Ability as a character accumulates Aging Points; at 4 the character is frail and must roll on the Crisis Table, and at 5 is bedridden." ;
    rpg:hasTag amol:HermeticConcept .
amol:DeftForm a rpg:Tag ;
    skos:prefLabel "Deft Form" ;
    dc:description "A Minor Hermetic Virtue removing Casting Total penalties for non-standard voice/gestures with one Form." ;
    skos:altLabel "Deft Form Virtue" ;
    rpg:hasTag amol:Virtue .
amol:Demetrius a rpg:Character ;
    rpg:name "Demetrius" ;
    dc:description "An alchemist Criamon magus, teacher of the current Prima Muscaria, whose carnal urges are embodied in the captured adulteration called the Carnal Wolf." ;
    skos:altLabel "the magician Demetrius" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:DiedneMagic a rpg:Tag ;
    skos:prefLabel "Diedne Magic" ;
    dc:description "A Major Hermetic Virtue from the druidic House Diedne lineage granting superior Spontaneous magic, requiring the lineage to be hidden via a Major Story Flaw." ;
    rpg:hasTag amol:Virtue .
amol:DifficultSpontaneousMagic a rpg:Tag ;
    skos:prefLabel "Difficult Spontaneous Magic" ;
    dc:description "A Hermetic Flaw referenced as combinable with Weak Spontaneous Magic to create a magus who cannot cast spontaneous magic at all." ;
    rpg:hasTag amol:Flaw .
amol:DisguiseOfTheNewVisage a rpg:Spell ;
    rpg:name "Disguise of the New Visage" ;
    dc:description "A Muto Corpus spell (Level 15) that transforms the target's facial features to any approximately human configuration the caster chooses." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Disputatio a rpg:Tag ;
    skos:prefLabel "Disputatio" ;
    dc:description "A formal academic debate resolved much like certamen, using paired totals (Attack, Defense, Weakening, Resistance) and symbolic Fatigue Levels to determine a winner across deliberative, epideictic, and forensic forms." ;
    skos:altLabel "Disputatio Total", "disputation", "disputationes" ;
    rpg:hasTag amol:HermeticConcept .
amol:Doissetep a rpg:Faction ;
    rpg:name "Doissetep" ;
    dc:description "A powerful covenant in the Provençal Tribunal where the dark Jerbiton magus Imanitos Mendax was apprenticed." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:Dwarf a rpg:Tag ;
    skos:prefLabel "Dwarf" ;
    dc:description "A Major General Flaw making the character the size of a child, with Size -2 and penalties to Strength and Stamina." ;
    rpg:hasTag amol:Flaw .
amol:EdgeOfTheRazor a rpg:Spell ;
    rpg:name "Edge of the Razor" ;
    dc:description "A spell that sharpens a weapon to improve attacks; disfavored by the School of Ramius because Magic Resistance can stop the enchanted weapon. Its damage bonus can combine with Hardness of Adamantine." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:EdwardOfMilton a rpg:Character ;
    rpg:name "Edward of Milton" ;
    dc:description "A Jerbiton archmagus and nominated head of the covenant Schola Pythagoranis in Cambridge, friend and former teacher of the scholar Robert Grosseteste." ;
    skos:altLabel "Archmagus Edward of Milton", "Edward of Milton, follower of Jerbiton" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Elemental a rpg:Creature ;
    rpg:name "Elemental" ;
    dc:description "Magical creatures composed of pure elemental matter (earth, water, air, or fire) formed through rarefication under a magical impetus; not truly alive, they do not age, eat, or reproduce and recover Might only slowly in a Magic aura." ;
    skos:altLabel "Elementals" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Elysium a schema:Place ;
    rpg:name "Elysium" ;
    dc:description "A place where magi have encountered Valkyries, who are no longer worshiped in Mythic Europe." ;
    skos:altLabel "the fields of Elysium" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Emir a rpg:Tag ;
    skos:prefLabel "Emir" ;
    dc:description "A Minor, Social Status Virtue equivalent to Knight but for Muslim emirs, who are skilled in hunting, religious teachings, and culture as well as martial pursuits." ;
    rpg:hasTag amol:Virtue .
amol:EnchantingAbility a rpg:Tag ;
    skos:prefLabel "Enchanting (Ability)" ;
    dc:description "A Minor Supernatural Ability Virtue applying to a particular artistic expression (dance, drawing, storytelling, craftwork) that in Faerie auras can control events through art." ;
    skos:altLabel "Enchanting (Storytelling)" ;
    rpg:hasTag amol:Virtue .
amol:EnchantmentOfTheScryingPool a rpg:Spell ;
    rpg:name "Enchantment of the Scrying Pool" ;
    dc:description "An Intellego Aquam Ritual spell (Level 30) with an Imaginem requisite that turns a body of water into a scrying pool; an old Mercurian ritual known throughout the Order." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:EndOfTheMightyCastle a rpg:Spell ;
    rpg:name "End of the Mighty Castle" ;
    dc:description "A Perdo Terram (PeTe 25) spell that collapses a building; since non-magical stone falls due to gravity, Magic Resistance does not protect against it." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:EnviedBeauty a rpg:Tag ;
    skos:prefLabel "Envied Beauty" ;
    dc:description "A Major Story Flaw whose character's beauty draws revulsion and jealousy, especially from vain persons of the character's gender." ;
    rpg:hasTag amol:Flaw .
amol:Eule a rpg:Character ;
    rpg:name "Eule" ;
    dc:description "An aged master of House Bjornaer at Fengheld with the heartbeast of an owl and the honorary rank of Quaesitor; she may have entered Final Twilight and her wisdom is faked by Gunther." ;
    skos:altLabel "Eule of Fengheld", "Eule, Follower of Bjornaer" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:ExoticCasting a rpg:Tag ;
    skos:prefLabel "Exotic Casting" ;
    dc:description "A Minor Hermetic Virtue allowing a magus to cast Hermetic spells using non-Hermetic methods, making it hard for others to recognize the spell being cast." ;
    rpg:hasTag amol:Virtue .
amol:Experimentation a rpg:Tag ;
    skos:prefLabel "Experimentation" ;
    dc:description "Risky laboratory practice of pushing beyond known limits, adding a simple die to the Lab Total but requiring a roll on the Extraordinary Results Chart each season." ;
    rpg:hasTag amol:HermeticConcept .
amol:EyesOfTheCat a rpg:Spell ;
    rpg:name "Eyes of the Cat" ;
    dc:description "A Muto Corpus spell (Level 5) with an Animal requisite that gives the target a cat's eyes, allowing sight in near darkness." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:EyesOfTheEagle a rpg:Spell ;
    rpg:name "Eyes of the Eagle" ;
    dc:description "An Intellego Imaginem spell (Level 25) that lets the caster see distant things clearly, making out details as if they were a foot away while still judging distance accurately." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:FaerieRaisedMagic a rpg:Tag ;
    skos:prefLabel "Faerie-Raised Magic" ;
    dc:description "A Major Hermetic Virtue conditioning a character to invent spells very quickly, allowing self-teaching of spells outside the lab; common in the Line of Quendalon." ;
    skos:altLabel "Faerie - Raised Magic" ;
    rpg:hasTag amol:Virtue .
amol:FeralScent a rpg:Tag ;
    skos:prefLabel "Feral Scent" ;
    dc:description "A Minor General Flaw giving a character the strong natural smell of a wild animal, imposing a social penalty and an Unclean Reputation but doubling Scent Target spell areas if Sensory Magic is Initiated." ;
    rpg:hasTag amol:Flaw .
amol:Feud a rpg:Tag ;
    skos:prefLabel "Feud" ;
    dc:description "A major Flaw representing an ongoing feud likely to inconvenience a principal, lowering an agent's Resistance Strength." ;
    rpg:hasTag amol:Flaw .
amol:FistOfShattering a rpg:Spell ;
    rpg:name "Fist of Shattering" ;
    dc:description "A Perdo Terram spell that breaks apart an object of stone or weaker material, cited as an example affected by the Harmless Magic Flaw." ;
    skos:altLabel "PeTe10" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:FlawedPowers a rpg:Tag ;
    skos:prefLabel "Flawed Powers" ;
    dc:description "A Minor Hermetic Flaw applying the effects of a Major Hermetic Flaw (such as Restriction or Necessary Condition) to a character's Supernatural Virtues rather than to Hermetic magic." ;
    rpg:hasTag amol:Flaw .
amol:FlexibleFormulaicMagic a rpg:Tag ;
    skos:prefLabel "Flexible Formulaic Magic" ;
    dc:description "A Major, Hermetic Virtue allowing slight variation of Formulaic spell parameters (Range, Duration, Target) while still casting known magic." ;
    rpg:hasTag amol:Virtue .
amol:ForgeCompanion a rpg:Tag ;
    skos:prefLabel "Forge-Companion" ;
    dc:description "A Minor, Social Status Virtue for an unGifted craftsman attached to a Verditius magus and working in his lab, with extra experience for Crafts." ;
    skos:altLabel "forge-companions" ;
    rpg:hasTag amol:Virtue .
amol:FreeStudy a rpg:Tag ;
    skos:prefLabel "Free Study" ;
    dc:description "A Minor, Hermetic Virtue adding +3 to Source Quality when studying from raw vis." ;
    rpg:hasTag amol:Virtue .
amol:GabrielTheArchangelOfProphecy a rpg:Creature ;
    rpg:name "Gabriel, the Archangel of Prophecy" ;
    dc:description "A Divine creature (Might 100, Mentem), the chief messenger of God known for teaching the prophet Daniel, announcing Christ's incarnation to Mary, and bringing the Qur'an to Muhammad." ;
    skos:altLabel "Gabriel", "Jabra'il", "Jibril", "archangel Gabriel", "the Archangel Gabriel" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:GatheringOfTwelveYears a rpg:Tag ;
    skos:prefLabel "Gathering of Twelve Years" ;
    dc:description "A periodic gathering of House Bjornaer (the Swan Clan performs a special ritual role at it); held in 1227 and figures in the Crintera Schism as each rival faction holds its own." ;
    skos:altLabel "Devil's Year", "Teufelsjahr", "the Gathering", "the gathering" ;
    rpg:hasTag amol:HermeticConcept .
amol:GenderNonconforming a rpg:Tag ;
    skos:prefLabel "Gender Nonconforming" ;
    dc:description "A Personality Flaw (Major or Minor) representing a character who does not conform to societal gender expectations; common among Faerie Doctors." ;
    rpg:hasTag amol:Flaw .
amol:Gentleman a rpg:Tag ;
    skos:prefLabel "Gentleman" ;
    dc:description "A Minor, Social Status Virtue for a minor member of a noble family treated as their own and addressed as Lord or Lady, though without inheritance." ;
    skos:altLabel "Gentlewoman" ;
    rpg:hasTag amol:Virtue .
amol:Goliard a rpg:Character ;
    rpg:name "Goliard" ;
    dc:description "The vigorous apparent leader of Blackthorn, nearly ninety, who controls a bound elemental spirit and seeks to restore the covenant's lost influence." ;
    skos:altLabel "Goliard filia Flumen" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Gossip a rpg:Tag ;
    skos:prefLabel "Gossip" ;
    dc:description "A minor general Virtue making a character a fount of rumor and information; listed as a resource increasing an agent's Resistance Strength." ;
    rpg:hasTag amol:Virtue .
amol:GrandSilesia a rpg:Faction ;
    rpg:name "Grand Silesia" ;
    dc:description "A covenant founded between the Oder and Warta rivers in Poland by magi from Rethra and Crintera (993-1009); it split to form the New Slavonic Tribunal and was destroyed in the Schism War." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:GreatBeast a rpg:Creature ;
    rpg:name "Great Beast" ;
    dc:description "Powerful ancestral beast-spirits of House Bjornaer who set quests and trials for magi seeking the Inner Heartbeast Mysteries and who act as Mystagogues during their Initiation." ;
    skos:altLabel "Great Beasts" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:GreatStrength a rpg:Tag ;
    skos:prefLabel "Great Strength" ;
    dc:description "A Virtue recommended for Line of Muj characters, representing their supernaturally great hereditary strength." ;
    rpg:hasTag amol:Virtue .
amol:GreatWeapon a rpg:Proficiency ;
    rpg:name "Great Weapon" ;
    dc:description "A combat Ability used for large two-handed weapons such as the cudgel, pole arm, great sword, long spear, and warhammer." ;
    skos:altLabel "Great" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:GuardiansOfTheForests a rpg:Tag ;
    skos:prefLabel "Guardians of the Forests" ;
    dc:description "A Rhine Tribunal ruling permitting protection of wildernesses, which the Hawthorn Gild and Crintera unsuccessfully sought to invoke against the Danish invasion of Rugen." ;
    skos:altLabel "Guardians of the Forests ruling" ;
    rpg:hasTag amol:HermeticConcept .
amol:Hephaestus a rpg:Character ;
    rpg:name "Hephaestus" ;
    dc:description "The lame Greek god of smiths and divine artificer, founder of the Cult of Hephaestus, who built sacred forges and crafted famous magical items for the gods." ;
    skos:altLabel "the divine artificer" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:HermeticBreakthrough a rpg:Tag ;
    skos:prefLabel "Hermetic Breakthrough" ;
    dc:description "The research achievement of expanding the limits of Hermetic Theory; minor or major breakthroughs (e.g. Aristotelian or Platonic Magic Theory) are accumulated via Breakthrough Points and disseminated in a tractatus." ;
    skos:altLabel "Breakthrough", "Breakthrough Points", "Breakthroughs" ;
    rpg:hasTag amol:HermeticConcept .
amol:HighCrime a rpg:Tag ;
    skos:prefLabel "High Crime" ;
    dc:description "A serious category of offense under the Code of Hermes, of which a Pralician obtaining excess scrying information could be convicted." ;
    rpg:hasTag amol:HermeticConcept .
amol:Hippogriff a rpg:Creature ;
    rpg:name "Hippogriff" ;
    dc:description "A faerie beast gifted by the queen Titania to the King of England, housed at the Tower of London, which is poisoned by the Divine aura of London's many churches." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:HolyVehm a rpg:Faction ;
    rpg:name "Holy Vehm" ;
    dc:description "An organization whose pious leader, the archbishop of Cologne, is murdered in 1225, which the demon Gymir is infiltrating and corrupting to use as a surrogate against Radegast's pagan followers." ;
    skos:altLabel "League of the Holy Court", "Vehmgericht", "Vehmgerichte", "the Vehm" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:HorseClan a rpg:Faction ;
    rpg:name "Horse Clan" ;
    dc:description "A Crintera clan that maintains the covenant's wild steeds, possesses the Animal Ken Virtue, provides provisioning, and acts as a messenger service." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:HousesOfHermesTrueLineages a rpg:Tag ;
    skos:prefLabel "Houses of Hermes: True Lineages" ;
    dc:description "An Ars Magica sourcebook referenced for fuller treatment of the use of magic to support the Redcap network." ;
    rpg:hasTag amol:HermeticConcept .
amol:Hubris a rpg:Tag ;
    skos:prefLabel "Hubris" ;
    dc:description "A Minor Personality Flaw inflicted on Verditius magi through Inner Mystery Ordeals; it grows like an Ability with success and is mystically coupled to a Verditius's Gift to boost enchantment Lab Totals." ;
    rpg:hasTag amol:Flaw .
amol:Hunchback a rpg:Tag ;
    skos:prefLabel "Hunchback" ;
    dc:description "A Minor General Flaw giving the character a deformed body with a grotesque appearance and penalties to agility, balance, and looks." ;
    rpg:hasTag amol:Flaw .
amol:HygwaldVeritas a rpg:Character ;
    rpg:name "Hygwald Veritas" ;
    dc:description "A devious magus of House Tremere and co-founder of Waddenzee, a specialist in Rego Mentem who is scrupulously honest with the Quaesitores and aspires to join them." ;
    skos:altLabel "Hygwald", "Hygwald Veritas of Waddenzee" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:HRisson a rpg:Character ;
    rpg:name "Hérisson" ;
    dc:description "A tenth-century Bjornaer magus who founded the Harmonist philosophy of living in harmony with nature, ridiculed in his own time." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:IgorRastvan a rpg:Character ;
    rpg:name "Igor Rastvan" ;
    dc:description "An archmage of House Ex Miscellanea and high priest of Radegast who leads Roznov's covenfolk in pagan worship and human sacrifice; his cursing magic draws on Slavic traditions and pagan ceremony, and his zeal may be unhinging him via Twilight." ;
    skos:altLabel "Igor", "Rastvan" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:ImanitosMendax a rpg:Character ;
    rpg:name "Imanitos Mendax" ;
    dc:description "A vain, treacherous magus of Oculus Septentrionalis with a focus in Mentem (and Imaginem for disguises); he runs a tavern, brothel, and extortion business in Lubeck and is secretly conspiring with the pirate covenant Waddenzee." ;
    skos:altLabel "Imanitos", "Imanitos Mendax of Oculus Septentrionalis", "Imanitos, Follower of Jerbiton", "the prophet of Radegast" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Immanola a rpg:Character ;
    rpg:name "Immanola" ;
    dc:description "The prima of House Ex Miscellanea and oldest maga in the tribunal, over 150 years old, gifted in prophecy; blocked from the praeco position by Blackthorn and now seen as Twilight-ridden." ;
    skos:altLabel "Immanola, prima of House Ex Miscellanea" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:IncantationOfTheMilkyEyes a rpg:Spell ;
    rpg:name "Incantation of the Milky Eyes" ;
    dc:description "A Perdo Corpus spell (Level 30) that blinds a target, leaving the eyes milky with cataracts; heals as a Heavy Wound." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:InoffensiveToBeings a rpg:Tag ;
    skos:prefLabel "Inoffensive to (Beings)" ;
    dc:description "A Minor General Virtue whereby the character's Gift does not bother a chosen class of beings (animals, faeries, or magical beings); known among Merinitae as the Bronze, Silver, and Golden Gifts." ;
    skos:altLabel "Inoffensive", "The Bronze Gift", "The Golden Gift", "The Silver Gift" ;
    rpg:hasTag amol:Virtue .
amol:InvisibilityOfTheStandingWizard a rpg:Spell ;
    rpg:name "Invisibility of the Standing Wizard" ;
    dc:description "A Perdo Imaginem spell (Level 15) that makes the target invisible, but the spell breaks if the target moves and the target still casts a shadow." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:InvisibleSlingOfVilano a rpg:Spell ;
    rpg:name "Invisible Sling of Vilano" ;
    dc:description "A popular indirect Rego Terram (ReTe 10) spell that hurls a stone as a projectile; bypasses Magic Resistance with a successful aiming roll, inflicting +5 damage." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Ioanna a rpg:Character ;
    rpg:name "Ioanna" ;
    dc:description "A Redcap follower of Mercere murdered in the city of Trier in 1151 AD, prompting a Quaesitorial investigation; she had earlier recorded directions to Treverorum and Rheinstein." ;
    skos:altLabel "the Redcap Ioanna" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Journeyman a rpg:Tag ;
    skos:prefLabel "Journeyman" ;
    dc:description "A Minor Social Status Virtue for a trained guild craftsman who may practice his trade in town under guild supervision and work for a master for a wage." ;
    rpg:hasTag amol:Virtue .
amol:Julia a rpg:Character ;
    rpg:name "Julia" ;
    dc:description "The de facto leader of Voluntas and one of the tribunal's best politicians, a mature Jerbiton maga specializing in Corpus and Mentem who orchestrated the breaking of Blackthorn's dominance at the 1201 tribunal." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:LegendaryArtist a rpg:Tag ;
    skos:prefLabel "Legendary Artist" ;
    dc:description "An artist whose Reputation reaches 11 and is taken by his muse into a supernatural realm, becoming an immortal being with a Might score and supernatural powers based on his Craft or Profession." ;
    skos:altLabel "Maestro", "Maestro (Special Free Virtue)", "maestro", "maestros", "mythic artist" ;
    rpg:hasTag amol:CharacterType .
amol:LeperMagi a rpg:Faction ;
    rpg:name "Leper Magi" ;
    dc:description "A small lineage within House Tytalus descended from Hariste and Epimetheus who draw magical strength from leprosy; powerful healers and longevity experts who are inevitably specialized in Corpus magics." ;
    skos:altLabel "lineage of Leper Magi", "magi aegroti", "magus aegrotus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:LesserMalediction a rpg:Tag ;
    skos:prefLabel "Lesser Malediction" ;
    dc:description "A Minor Supernatural Flaw in which the character has been cursed by a supernatural power, with effects about as bad as other Minor General Flaws." ;
    rpg:hasTag amol:Flaw .
amol:Libellus a rpg:Faction ;
    rpg:name "Libellus" ;
    dc:description "The newest and one of the largest covenants in the tribunal, founded and led by Stephen Eruditus of Jerbiton; an unknown quantity in tribunal politics." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:LifeLinkedSpontaneousMagic a rpg:Tag ;
    skos:prefLabel "Life-Linked Spontaneous Magic" ;
    dc:description "A Major, Hermetic Virtue letting a magus produce stronger spontaneous magic at the cost of declaring an effect level and spending Fatigue or taking wounds." ;
    rpg:hasTag amol:Virtue .
amol:LimitOfTheLunarSphere a rpg:Tag ;
    skos:prefLabel "Limit of the Lunar Sphere" ;
    dc:description "A boundary of Hermetic magic at the orbit of the moon; magic cannot affect the moon or the ethereal region beyond it, and it stunts spells reaching toward the heavens." ;
    skos:altLabel "Lunar Sphere limit" ;
    rpg:hasTag amol:HermeticConcept .
amol:LostLove a rpg:Tag ;
    skos:prefLabel "Lost Love" ;
    dc:description "A Flaw often developed by Path of Strife magi who lose the spouses they married in the ritual at the Station That Repels and Attracts Elements." ;
    skos:altLabel "Lost Love Flaw" ;
    rpg:hasTag amol:Flaw .
amol:LotharingianTribunal a rpg:Faction ;
    rpg:name "Lotharingian Tribunal" ;
    dc:description "A proposed separate Tribunal sought by members of the Apple Gild to cover the Low Countries in the north and west of the Rhine Tribunal, to be proposed at the Grand Tribunal of 1228." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Tribunal .
amol:MaddenhofenWoods a schema:Place ;
    rpg:name "Maddenhofen Woods" ;
    dc:description "A stretch of woods on the northwestern fringe of the Bohemian Forest protected by House Merinita; site of Tytalus's 807 AD disappearance and home of a powerful faerie who grants Heart's Desire at a price." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:MagisterInArtibus a rpg:Tag ;
    skos:prefLabel "Magister in Artibus" ;
    dc:description "A Major Social Status Virtue for one who has incepted Master of Arts at a European university and completed compulsory teaching, entitling them to teach anywhere in Europe." ;
    skos:altLabel "Magister" ;
    rpg:hasTag amol:Virtue .
amol:MarcusNavicularius a rpg:Character ;
    rpg:name "Marcus Navicularius" ;
    dc:description "A Follower of Verditius (age 58) and the foremost shipwright in Lübeck, a master of Terram who enchants extremely large items such as ships for sale to other covenants." ;
    skos:altLabel "Marcus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Mendalus a rpg:Character ;
    rpg:name "Mendalus" ;
    dc:description "A hierophant of the Huntress who in 1129 proclaimed at the Grand Tribunal that the Order should follow Merinita's true path; crazed by Twilight and believing himself the messiah, he was slain by fellow hierophants via Wizard's War." ;
    skos:altLabel "Mendalus of House Merinita" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Mentor a rpg:Tag ;
    skos:prefLabel "Mentor" ;
    dc:description "A useful minor Flaw representing a guiding patron; also noted as a relationship through which a character may be considered part of another's agency." ;
    rpg:hasTag amol:Flaw .
amol:MercenaryCaptain a rpg:Tag ;
    skos:prefLabel "Mercenary Captain" ;
    dc:description "A Social Status Virtue that grants a character an agency prior to play and appears as a minor social status example on the Resistance of Agents Table." ;
    rpg:hasTag amol:Virtue .
amol:Merchant a rpg:Tag ;
    skos:prefLabel "Merchant" ;
    dc:description "A Free Social Status Virtue for a character who lives by buying and selling goods, whether peddler, shopkeeper, or traveling merchant." ;
    skos:altLabel "Merchant Social Status Virtue" ;
    rpg:hasTag amol:Virtue .
amol:Merovech a rpg:Character ;
    rpg:name "Merovech" ;
    dc:description "A powerful 5th-century Frankish chieftain and wizard, namesake of the Merovingian dynasty, said to have two fathers and a magical bloodline; helped repel Attila at Chalons." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:MoratamisOfHouseGuernicus a rpg:Character ;
    rpg:name "Moratamis of House Guernicus" ;
    dc:description "A maga of House Guernicus who, suspicious of Carolus of Tytalus, challenges him to certamen but ultimately concedes; an Intellego and Mentem specialist in the certamen example." ;
    skos:altLabel "Moratamis", "Moratamis the Quaesitor" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:NaturalLeader a rpg:Tag ;
    skos:prefLabel "Natural Leader" ;
    dc:description "A Minor General Virtue giving a +3 bonus to social situations where the dominant character takes the lead, partly overcoming the social penalty of The Gift." ;
    skos:altLabel "Pack leader" ;
    rpg:hasTag amol:Virtue .
amol:NeptuneSWrath a rpg:Spell ;
    rpg:name "Neptune's Wrath" ;
    dc:description "A Rego Aquam Ritual spell (Level 40) that creates a gigantic wave up to a mile wide capable of capsizing ships and devastating coastlines." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:NicolaDeHay a rpg:Character ;
    rpg:name "Nicola de Hay" ;
    dc:description "The elderly hereditary constable of Lincoln castle and sheriff of the shire who held the castle through a siege and is locked in a conflict with the earl of Salisbury over her position." ;
    skos:altLabel "Nicola" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Nigrasaxa a rpg:Faction ;
    rpg:name "Nigrasaxa" ;
    dc:description "A relatively new, large covenant of two shining black towers, founded by Maximianus of Bonisagus to break the cycle of invalid tribunals." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:ObliterationOfTheMetallicBarrier a rpg:Spell ;
    rpg:name "Obliteration of the Metallic Barrier" ;
    dc:description "A Perdo Terram spell (with Rego requisite) that shatters a metal or stone barrier up to one foot thick, harming those on the far side." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:OpeningTheIntangibleTunnel a rpg:Spell ;
    rpg:name "Opening the Intangible Tunnel" ;
    dc:description "A Rego Vim spell that opens a magical channel from the caster to a target, allowing spells of greater than Personal range to be cast through it, subject to Penetration of Magic Resistance." ;
    skos:altLabel "the Opening spell", "the tunnel" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Outcast a rpg:Tag ;
    skos:prefLabel "Outcast" ;
    dc:description "A Minor Social Status Flaw in which normal society rejects the character and he is not attached to a covenant; he may not take the Wealthy Virtue." ;
    rpg:hasTag amol:Flaw .
amol:Outlaw a rpg:Tag ;
    skos:prefLabel "Outlaw" ;
    dc:description "A Major Social Status Flaw in which the character has been outlawed and must live by his wits outside society, with a Reputation at level 2 for whatever got him outlawed." ;
    rpg:hasTag amol:Flaw .
amol:Overconfident a rpg:Tag ;
    skos:prefLabel "Overconfident" ;
    dc:description "A Major or Minor Personality Flaw in which the character has unshakable faith in his own abilities and cannot imagine failure." ;
    rpg:hasTag amol:Flaw .
amol:Oversensitive a rpg:Tag ;
    skos:prefLabel "Oversensitive" ;
    dc:description "A Major or Minor Personality Flaw in which the character finds intolerable something others find merely unpleasant." ;
    rpg:hasTag amol:Flaw .
amol:Oxford a schema:Place ;
    rpg:name "Oxford" ;
    dc:description "A master-run English university closely modeled on Paris, with four faculties and two student nations, governed via a chancellor appointed by the Bishop of Lincoln." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Pagan a rpg:Tag ;
    skos:prefLabel "Pagan" ;
    dc:description "A Major or Minor Personality Flaw in which the character does not follow the Church and has never been baptized; may begin with Magic Lore or Faerie Lore." ;
    rpg:hasTag amol:Flaw .
amol:PaidRights a rpg:Tag ;
    skos:prefLabel "Paid Rights" ;
    dc:description "A Virtue that is a game-mechanical way to acknowledge that an exceptional woman who holds public power in Mythic Europe is genuinely exceptional." ;
    rpg:hasTag amol:Virtue .
amol:PainfulMagic a rpg:Tag ;
    skos:prefLabel "Painful Magic" ;
    dc:description "A Major Hermetic Flaw in which casting spells causes the equivalent of one Fatigue level in pain per spell, applying a cumulative penalty to actions." ;
    skos:altLabel "Painful Magic Flaw" ;
    rpg:hasTag amol:Flaw .
amol:PainsOfThePerpetualWorry a rpg:Spell ;
    rpg:name "Pains of the Perpetual Worry" ;
    dc:description "A Creo Mentem spell (Level 20) that gives someone a nagging, painful recurrent emotion of anxiety and fear; described as truly a curse." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:PalsiedHands a rpg:Tag ;
    skos:prefLabel "Palsied Hands" ;
    dc:description "A Minor General Flaw in which the character's hands shake uncontrollably, giving -2 to rolls involving holding or wielding objects and an extra botch die when casting." ;
    rpg:hasTag amol:Flaw .
amol:PeeringIntoTheMortalMind a rpg:Spell ;
    rpg:name "Peering into the Mortal Mind" ;
    dc:description "An Intellego Mentem spell (Level 30) that lets the caster thoroughly probe and understand the contents of the target's mind, including motives, strengths, and weaknesses." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Pendule a rpg:Character ;
    rpg:name "Pendule" ;
    dc:description "A legendary Provençal hedge wizard who evaded the Founder Flambeau, took four Hermetic followers (two from House Merinita), taught illusion Mysteries, and died in 854 AD." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Peregrinator a rpg:Tag ;
    skos:prefLabel "Peregrinator" ;
    dc:description "The wandering magi of the Rhine Tribunal, typically journeymen, who travel from covenant to covenant relying on the Laws of Hospitality; about a sixth of Rhine magi are peregrinatores." ;
    skos:altLabel "peregrinatores", "wandering magi" ;
    rpg:hasTag amol:CharacterType .
amol:PerformanceMagic a rpg:Tag ;
    skos:prefLabel "Performance Magic" ;
    dc:description "A Minor Hermetic Virtue letting a magus conceal spellcasting by substituting the actions or words of a specified Ability for normal Hermetic gestures and words." ;
    rpg:hasTag amol:Virtue .
amol:Perpetuity a rpg:Tag ;
    skos:prefLabel "Perpetuity" ;
    dc:description "A Major Illusion Mystery of House Merinita granting three potentially-permanent spell durations (Might, Aura, Hidden); Merinitae usually gain the Unnatural Magic Flaw." ;
    skos:altLabel "Inner Mystery of Perpetuity" ;
    rpg:hasTag amol:Virtue .
amol:PersonalVisSource a rpg:Tag ;
    skos:prefLabel "Personal Vis Source" ;
    dc:description "A Minor Hermetic Virtue granting exclusive access to a supply of raw vis yielding about one tenth of the player covenant's expected annual gathering." ;
    rpg:hasTag amol:Virtue .
amol:PhysicianOfSalerno a rpg:Tag ;
    skos:prefLabel "Physician of Salerno" ;
    dc:description "A Minor General Virtue indicating attendance at the famed School of Salerno, granting a Reputation, unique medical procedures like anesthetics, and 50 experience points." ;
    rpg:hasTag amol:Virtue .
amol:PhysicianSEye a rpg:Spell ;
    rpg:name "Physician's Eye" ;
    dc:description "An Intellego Corpus spell (Level 5) that determines the general health of a person, showing afflictions as yellow coloration on the body." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Pious a rpg:Tag ;
    skos:prefLabel "Pious" ;
    dc:description "A Major or Minor Personality Flaw in which the character is a fervent follower of his religion, avoiding what it prohibits and doing what it commands." ;
    skos:altLabel "Pious Flaw" ;
    rpg:hasTag amol:Flaw .
amol:Polandrus a rpg:Creature ;
    rpg:name "Polandrus" ;
    dc:description "A demon (Might 20, Animal) appearing as an extremely large jet-black wolf with red eyes who dominates wolves and targets livestock farmers, gradually coercing them into sin." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:PoorEyesight a rpg:Tag ;
    skos:prefLabel "Poor Eyesight" ;
    dc:description "A Minor General Flaw in which bleary vision gives -3 to rolls involving sight, including attack and defense; can combine with Missing Eye." ;
    rpg:hasTag amol:Flaw .
amol:PoorMemory a rpg:Tag ;
    skos:prefLabel "Poor Memory" ;
    dc:description "A Minor Personality Flaw in which the character has a very hard time recalling one type of thing such as names, faces, or places." ;
    skos:altLabel "Poor Memory (faces)" ;
    rpg:hasTag amol:Flaw .
amol:PopeHonoriusIII a rpg:Character ;
    rpg:name "Pope Honorius III" ;
    dc:description "The pope who banned civil law teaching at Paris, counseled Bologna's scholars to resist non-violently, and is petitioned over university licenses." ;
    skos:altLabel "Honorius", "Honorius III" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:PotentMagic a rpg:Tag ;
    skos:prefLabel "Potent Magic" ;
    dc:description "A Minor or Major Hermetic Virtue attuning magic to a narrow field, granting a Lab Total and Casting bonus and allowing design of Potent spells using Casting Items." ;
    rpg:hasTag amol:Virtue .
amol:Priest a rpg:Tag ;
    skos:prefLabel "Priest" ;
    dc:description "A Social Status Virtue for a medical character in holy orders, usually attached to a monastic house; compatible with Magister in Medicina." ;
    rpg:hasTag amol:Virtue .
amol:PripetMaior a rpg:Faction ;
    rpg:name "Pripet Maior" ;
    dc:description "A New Slavonic Tribunal covenant settled in 1052 by Bjornaer magi formerly of Grand Silesia; allied with Crintera." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:Profession a rpg:Proficiency ;
    rpg:name "Profession" ;
    dc:description "A Craft-like Ability for an artist's trade; performance maestros use Communication + Profession Ability + Form when instilling effects." ;
    skos:altLabel "Profession (Type)", "Profession Ability" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:Prudentum a rpg:Character ;
    rpg:name "Prudentum" ;
    dc:description "A Jerbiton magus and former leader of Oculus Septentrionalis who was slain in Wizard's War by Urgen of Bjornaer in 1179." ;
    skos:altLabel "Prudentum of Jerbiton" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:PuissantCraft a rpg:Tag ;
    skos:prefLabel "Puissant Craft" ;
    dc:description "A Virtue granting a bonus to a Craft Ability such as Painting or Baking, used by several covenfolk templates." ;
    skos:altLabel "Puissant Craft: Blacksmith" ;
    rpg:hasTag amol:Virtue .
amol:PuissantFinesse a rpg:Tag ;
    skos:prefLabel "Puissant Finesse" ;
    dc:description "A recommended Virtue for the School of Vilano that boosts the magus's effective Finesse Ability for aiming indirect attacks." ;
    skos:altLabel "Cautious With Ability (Finesse)" ;
    rpg:hasTag amol:Virtue .
amol:RapidConvalescence a rpg:Tag ;
    skos:prefLabel "Rapid Convalescence" ;
    dc:description "A Minor General Virtue letting a character's body heal quickly, granting +3 on all rolls to recover from wounds." ;
    rpg:hasTag amol:Virtue .
amol:Reclusive a rpg:Tag ;
    skos:prefLabel "Reclusive" ;
    dc:description "A Minor Personality Flaw in which the character dislikes being disturbed or interrupted and is reluctant to enter public places or group activities." ;
    rpg:hasTag amol:Flaw .
amol:RecollectionOfMemoriesNeverQuiteLived a rpg:Spell ;
    rpg:name "Recollection of Memories Never Quite Lived" ;
    dc:description "A Muto Mentem spell (Level 4) that changes the target's memory of a detail into a similar but different memory the target cannot distinguish from the authentic one." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Regin a rpg:Character ;
    rpg:name "Regin" ;
    dc:description "An evil-hearted dwarf who coveted the magic ring of the Nibelungs and under whom Wayland apprenticed; played a part in the life of Siegfried." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:ReservesOfStrength a rpg:Tag ;
    skos:prefLabel "Reserves of Strength" ;
    dc:description "A Minor General Virtue letting a character once per day add +3 to effective Strength for an action, requiring two Fatigue rolls afterward." ;
    rpg:hasTag amol:Virtue .
amol:RicardusCaespuus a rpg:Character ;
    rpg:name "Ricardus Caespuus" ;
    dc:description "A reclusive Follower of Bonisagus at Durenmar with a glass-walled laboratory specialized in Herbam, who cultivates many types of vis from exotic plants." ;
    skos:altLabel "Ricardus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:RichardTheLionheart a rpg:Character ;
    rpg:name "Richard the Lionheart" ;
    dc:description "King of England who spent most of his reign on Crusade and at war in France, repeatedly demanding money from England; died of an infected arrow wound in 1199." ;
    skos:altLabel "Richard" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:RitualOfTwelveYears a rpg:Tag ;
    skos:prefLabel "Ritual of Twelve Years" ;
    dc:description "A House Bjornaer rite of passage after which a magus gains the Heartbeast Ability; experiencing it early in apprenticeship can grant Self-Confident or the Uswaurpa reputation." ;
    rpg:hasTag amol:HermeticConcept .
amol:RowanGild a rpg:Faction ;
    rpg:name "Rowan Gild" ;
    dc:description "A secretive Rhine political gild formed by Diedne magi who split from the Hawthorn Gild, later joined by Waldherz Bonisagus; its members were exiled and largely destroyed in the Schism War." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:RustedDecayOfTenScoreYears a rpg:Spell ;
    rpg:name "Rusted Decay of Ten-Score Years" ;
    dc:description "A Perdo Terram spell that thoroughly rusts the metal of the target so it breaks under any demanding use and loses its sharpness." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ScentOfPeacefulSlumber a rpg:Spell ;
    rpg:name "Scent of Peaceful Slumber" ;
    dc:description "A spell that makes everyone in a room fall asleep over a few seconds, with the smell of lilacs in their nostrils." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:SchoolsOfSebastian a rpg:Tag ;
    skos:prefLabel "Schools of Sebastian" ;
    dc:description "A catch-all family of minor Flambeau combat schools that conjure harmful objects or substances using Forms other than Ignem; named for the hedge-wizard magus Sebastian." ;
    skos:altLabel "School of Sebastian" ;
    rpg:hasTag amol:HermeticConcept .
amol:Schwarzburg a rpg:Faction ;
    rpg:name "Schwarzburg" ;
    dc:description "A Rhine covenant in the Swabian Jura (857-885) that warred with neighboring Arae Flaviae, causing the Tribunal to abolish both covenants." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:Seirenes a rpg:Faction ;
    rpg:name "Seirenes" ;
    dc:description "A tradition of female magae in House Ex Miscellanea who practice lyrical Siren Song magic taught to their founder by the sirens of legend." ;
    skos:altLabel "Melusine bards", "Seirene" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:SelenaTibicena a rpg:Character ;
    rpg:name "Selena Tibicena" ;
    dc:description "A necromancer maga of Treverorum whose Trier sanctum, hidden beneath a graveyard, contained skeletons; her grave conceals a stairway to her former sanctum." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Semitae a rpg:Faction ;
    rpg:name "Semitae" ;
    dc:description "A covenant of traveling magi led by a Criamon, recorded at the 1151 tribunal; possibly the same wandering group recorded in Cad Gadu's records since the tribunal's founding." ;
    skos:altLabel "the wandering covenant" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:SensePassions a rpg:Tag ;
    skos:prefLabel "Sense Passions" ;
    dc:description "A Supernatural Ability to sense the personality and desires of an intelligent being by reading the tarnish on its soul, often a false power or Infernally associated." ;
    rpg:hasTag amol:Virtue .
amol:SensoryMagic a rpg:Tag ;
    skos:prefLabel "Sensory Magic" ;
    dc:description "A Hermetic Mystery, described in Houses of Hermes: Mystery Cults, whose Initiation lets a magus with Feral Scent double the area of effect of spells with a Scent Target." ;
    skos:altLabel "Sensory Magic Mystery" ;
    rpg:hasTag amol:Virtue .
amol:SevenLeagueStride a rpg:Spell ;
    rpg:name "Seven-League Stride" ;
    dc:description "A Rego Corpus spell (Level 30) that transports the caster to any place within seven leagues that they can see or have an Arcane Connection with." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:SightOfTheTransparentMotive a rpg:Spell ;
    rpg:name "Sight of the Transparent Motive" ;
    dc:description "An Intellego Mentem spell (Level 10) that detects the general motive most powerfully influencing the target at the moment, such as fear, anger, or greed." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:SkilledParens a rpg:Tag ;
    skos:prefLabel "Skilled Parens" ;
    dc:description "A Minor Hermetic Virtue reflecting a more powerful or better-teaching parens, granting 60 extra experience points and 30 spell levels during apprenticeship." ;
    rpg:hasTag amol:Virtue .
amol:SocialHandicap a rpg:Tag ;
    skos:prefLabel "Social Handicap" ;
    dc:description "A Minor General Flaw in which some trait keeps the character from interacting easily with people, causing -3 on appropriate rolls." ;
    rpg:hasTag amol:Flaw .
amol:Societates a rpg:Faction ;
    rpg:name "Societates" ;
    dc:description "One of the three groupings of Hermetic Houses; the fourth Societas, House Ex Miscellanea, is a special case in how its members gain House Virtues." ;
    skos:altLabel "Societas" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:SpecialCircumstances a rpg:Tag ;
    skos:prefLabel "Special Circumstances" ;
    dc:description "A Minor Virtue boosting magic under certain conditions; the Malocchi take it for eye contact and the Donatores' Minor Magical Focus relates similarly." ;
    rpg:hasTag amol:Virtue .
amol:StCuthbert a rpg:Character ;
    rpg:name "St. Cuthbert" ;
    dc:description "A saint whose shrine is at Durham cathedral; in a vision he told Godric to settle at Finchale near Durham, and pilgrims visit Godric's shrine as part of visiting Cuthbert's." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:StThomasBecket a rpg:Character ;
    rpg:name "St. Thomas Becket" ;
    dc:description "The martyred Archbishop of Canterbury whose shrine is the great pilgrimage site at Canterbury and whose death won benefit of clergy; killed in a dispute over jurisdictions." ;
    skos:altLabel "St. Thomas", "Thomas", "Thomas Becket" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:StagOfVirtue a rpg:Creature ;
    rpg:name "Stag of Virtue" ;
    dc:description "A noble Magical stag (Might 17, Animal) and great enemy of serpents that can heal its own wounds, neutralize poison, and live forever; its right antler has sought-after healing powers." ;
    skos:altLabel "Beast of Virtue", "Virtuous Beast", "virtuous inner heartbeast" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:SteedOfVengeance a rpg:Spell ;
    rpg:name "Steed of Vengeance" ;
    dc:description "A Muto Animal spell (Level 35) that turns a horse into a ferocious magical mount with a black coat, fiery eyes, fangs, and razor-sharp hooves." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:StellatusTheDragon a rpg:Creature ;
    rpg:name "Stellatus, the Dragon" ;
    dc:description "An ancient dragon (Might 50, Ignem) able to assume human form, instill loyalty, breathe fire, and control fire; he regards himself as superior to all Hermetic magi and once killed a Tytalus maga." ;
    skos:altLabel "Stellatus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:StrongAngelicHeritage a rpg:Tag ;
    skos:prefLabel "Strong Angelic Heritage" ;
    dc:description "A Major Supernatural Virtue requiring Blood of the Nephilim; it grants a Divine Might (Corpus) score, Magic Resistance, immunity to Warping, and levels of holy powers invoked by spending Might points." ;
    rpg:hasTag amol:Virtue .
amol:StrongWilled a rpg:Tag ;
    skos:prefLabel "Strong-Willed" ;
    dc:description "A Minor General Virtue giving +3 on any roll requiring strength of will; the character cannot easily be coerced into activities, beliefs, or feelings." ;
    rpg:hasTag amol:Virtue .
amol:SurgicalEmpiricus a rpg:Tag ;
    skos:prefLabel "Surgical Empiricus" ;
    dc:description "A Minor Social Status Flaw for a chirurgeon trained in only a single aspect of Chirurgy, granting the usual +1 to that surgery but halving Chirurgy for any other application." ;
    rpg:hasTag amol:Flaw .
amol:Swim a rpg:Proficiency ;
    rpg:name "Swim" ;
    dc:description "A General Ability for propelling oneself through water quickly and efficiently, with specialties in long distances, diving, and underwater maneuvering." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:SympatheticConnection a rpg:Tag ;
    skos:prefLabel "Sympathetic Connection" ;
    dc:description "A magical relationship drawn from symbolic correspondences, used in charms and Synthemata Magic; severed and invalidated against a magus by the Secret Name Mystery." ;
    skos:altLabel "Sympathetic Connections" ;
    rpg:hasTag amol:HermeticConcept .
amol:Tasgillia a rpg:Character ;
    rpg:name "Tasgillia" ;
    dc:description "The fourth Prima of House Tytalus, despised for her selfish nature and puissant in spirit magic; she was executed for diabolism in 961 AD after summoning demons using Guorna's lore." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:TheCallToSlumber a rpg:Spell ;
    rpg:name "The Call to Slumber" ;
    dc:description "A Hermetic spell, cited in Touch/Eye Range versions as a subtle urban spell and as a template for spells that manipulate mental states." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheCultOfOrpheus a rpg:Faction ;
    rpg:name "The Cult of Orpheus" ;
    dc:description "A Mystery-Cult-like tradition of magi (magoi) descended from worshippers of Orpheus and Hermes, who practice emotionally-connected magic and revere the legend of Orpheus." ;
    skos:altLabel "Orphic cult", "Orphics" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:TheEarthSplitAsunder a rpg:Spell ;
    rpg:name "The Earth Split Asunder" ;
    dc:description "A Rego Terram (ReTe 30) spell opening a chasm; Magic Resistance does not protect against falling in, but does against being crushed when it closes." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheGreatRot a rpg:Spell ;
    rpg:name "The Great Rot" ;
    dc:description "A Perdo Herbam spell (Level 25) that rots and destroys a large amount of dead wood, up to that found in a wooden house or small inn." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheHuntressInTheWood a rpg:Faction ;
    rpg:name "The Huntress in the Wood" ;
    dc:description "A secret society in the Order comprised mainly of followers of Bjornaer dedicated to preserving primal nature-oriented magic; unknowingly a pawn of Fenistal, guided toward seizing the Elder Gild and Irencillia." ;
    skos:altLabel "Esoteric Mystery Cult of the Huntress in the Wood", "the Huntress" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:TheLyceum a rpg:Faction ;
    rpg:name "The Lyceum" ;
    dc:description "A Hermetic societas of about eight rationalist magi led by Venatus Trianomae, named after Aristotle's school; they promote the New Aristotle and the seven liberal arts and reject the empiricist Collegium." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:TheMilites a rpg:Faction ;
    rpg:name "The Milites" ;
    dc:description "A Minor Story Flaw for a House Flambeau character who is a member of the milites, granting brotherhood and 5 House Acclaim points but binding the character to obey the Primus." ;
    skos:altLabel "Miles", "miles" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:ThePathOfTheBody a rpg:Tag ;
    skos:prefLabel "The Path of the Body" ;
    dc:description "A Criamon path focusing on the human form as a microcosm of the universe, with stations including the Perfect Tool, Spiritual Nourishment, Perfect Movement, the Microcosm, and Corporeal Repose." ;
    rpg:hasTag amol:HermeticConcept .
amol:TheologyIslam a rpg:Proficiency ;
    rpg:name "Theology: Islam" ;
    dc:description "An Ability a Mamluk character may take even without the Educated Virtue, reflecting his religious education in a military school." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:ThrownWeapon a rpg:Proficiency ;
    rpg:name "Thrown Weapon" ;
    dc:description "The missile-combat Ability used for thrown weapons such as the throwing axe, javelin, knife, and sling." ;
    skos:altLabel "Thrown" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:Tintagel a schema:Place ;
    rpg:name "Tintagel" ;
    dc:description "A near-island stronghold off the coast of Cornwall, the seat of Gorlois and later King Mark, and the site of Arthur's conception; it may be detached from the mundane world, with a chapel of St. Juliot helping keep it from reappearing." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TipOfTheTongue a rpg:Spell ;
    rpg:name "Tip of the Tongue" ;
    dc:description "A Perdo Mentem spell (Level 5) that causes the target to forget one word of the caster's choosing for the spell's duration." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Titanoi a rpg:Faction ;
    rpg:name "Titanoi" ;
    dc:description "A Mystery Cult lineage within House Tytalus, heirs to the goetic and spirit-summoning magical tradition of Guorna and Tytalus; nearly destroyed during the Betrayal and revived after the Schism War." ;
    skos:altLabel "Children of the Titans", "Titani", "Titanist", "Titanos" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Toledo a schema:Place ;
    rpg:name "Toledo" ;
    dc:description "A Spanish town whose charter requires a man's wife to live permanently in the town for him to gain citizenship, preventing itinerant merchants from claiming multiple citizenships." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TormentingMaster a rpg:Tag ;
    skos:prefLabel "Tormenting Master" ;
    dc:description "A Major Story Flaw in which the character's master does not believe he passed the apprentice's gauntlet and periodically troubles him with political moves; applicable to magi." ;
    skos:altLabel "Tormenting Master Flaw" ;
    rpg:hasTag amol:Flaw .
amol:TouchOfMidas a rpg:Spell ;
    rpg:name "Touch of Midas" ;
    dc:description "A ritual Creo Terram spell that creates a roughly spherical lump of gold about six inches across, enough wealth for a peasant family for centuries." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TowerOfLondon a schema:Place ;
    rpg:name "Tower of London" ;
    dc:description "A London fortress whose grounds contain the Royal Menagerie housing exotic animals gifted to the King of England, including the ailing faerie hippogriff." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TracklessStep a rpg:Spell ;
    rpg:name "Trackless Step" ;
    dc:description "A Rego Terram spell that leaves no tracks in the earth until the caster stops; draws on pre-Hermetic traditions." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TrapOfTheEntwiningVines a rpg:Spell ;
    rpg:name "Trap of the Entwining Vines" ;
    dc:description "A Creo Herbam (CrHe 15) indirect spell whose vines surround and prevent a maga from moving without completely immobilizing her." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Troubadours a rpg:Tag ;
    skos:prefLabel "Troubadours" ;
    dc:description "A type of minstrel from southern France whose courtly love poetry, inspired by Arabic neighbors, is being destroyed by the Albigensian Crusade." ;
    skos:altLabel "Trobairitz", "Troubadour", "Troubadour/Trobairitz", "trobairtz", "troubadour" ;
    rpg:hasTag amol:Virtue .
amol:TrueLineages a rpg:Faction ;
    rpg:name "True Lineages" ;
    dc:description "One of the three groups of Hermetic Houses (Bonisagus, Guernicus, Mercere, Tremere) made up entirely of those descended in training from a single Founder; cannot be joined later." ;
    skos:altLabel "True Lineage", "true lineage" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Ulf a rpg:Character ;
    rpg:name "Ulf" ;
    dc:description "An example Bjornaer magus with a wolf heartbeast who communicates with his Great Beast ancestor and is initiated into the Mystery of the Anima, gaining a shadow-wolf inner heartbeast." ;
    skos:altLabel "Ulf Bjornaer" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:UnaffectedByTheGift a rpg:Tag ;
    skos:prefLabel "Unaffected by The Gift" ;
    dc:description "A Minor General Virtue: the character is not affected by the negative effects of The Gift or Magical Air in others, even a Blatant Gift." ;
    rpg:hasTag amol:Virtue .
amol:Underworld a schema:Place ;
    rpg:name "Underworld" ;
    dc:description "The realm where the gods of the dead imprisoned the titans, the resentful spirits Tytalus sought out and forged pacts with to oppose Guorna." ;
    skos:altLabel "Hades" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Ungulus a rpg:Faction ;
    rpg:name "Ungulus" ;
    dc:description "A declining 'Winter' covenant in a carved tower in the Lake District, founded by House Flambeau and later home to a productive Verditius line; filled with magical treasures." ;
    skos:altLabel "The Claw" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:UnnaturalMagic a rpg:Tag ;
    skos:prefLabel "Unnatural Magic" ;
    dc:description "A Major Hermetic Flaw in which none of the character's Creo rituals have permanent effect due to the illusory nature of his magic, and he cannot extract vis with Creo." ;
    rpg:hasTag amol:Flaw .
amol:UnpredictableMagic a rpg:Tag ;
    skos:prefLabel "Unpredictable Magic" ;
    dc:description "A Minor Hermetic Flaw in which the character always rolls a stress die when using magic and must always roll at least one botch die, even with Mastered spells." ;
    rpg:hasTag amol:Flaw .
amol:UtherPendragon a rpg:Character ;
    rpg:name "Uther Pendragon" ;
    dc:description "Brother of King Aurelius who led fifteen thousand knights to Ireland with Merlin to fetch the stones of the Giant's Ring; he later fathered Arthur at Tintagel while magically disguised as Gorlois." ;
    skos:altLabel "King Uther Pendragon", "Uther" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:ValNegra a rpg:Faction ;
    rpg:name "Val Negra" ;
    dc:description "A lost covenant of the Provençal Tribunal, one of the first covenants of the Order founded by Flambeau himself, which suffered in the Schism War and whose location is now lost." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:ValNegra_2 a rpg:Faction ;
    rpg:name "Val-Negra" ;
    dc:description "The original domus magna of House Flambeau in the Pyrenees, founded by Flambeau against the sahirs; it has since sunk deep into Winter and lost Elaine's library." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:Vendetta a rpg:Tag ;
    skos:prefLabel "Vendetta" ;
    dc:description "A Major Story Flaw in which the magus is engaged in one of House Verditius' vendettas, often inherited from his parens, against another Verditius magus; restricted to Verditius magi." ;
    rpg:hasTag amol:Flaw .
amol:Venditor a rpg:Tag ;
    skos:prefLabel "Venditor" ;
    dc:description "A Major Social Status Virtue for a selling-agent who barters the goods of a Verditius maga to mundane parties, gaining bonus experience in social abilities." ;
    skos:altLabel "selling agents", "venditores" ;
    rpg:hasTag amol:Virtue .
amol:VerditiusCultLore a rpg:Proficiency ;
    rpg:name "Verditius Cult Lore" ;
    dc:description "Cult Lore texts of House Verditius; Infernal agents may arrange deliveries of these to propel young magi along their hubristic path." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:VisionOfTheHauntingSpirits a rpg:Spell ;
    rpg:name "Vision of the Haunting Spirits" ;
    dc:description "A Muto Mentem spell (Level 40) with an Imaginem requisite that makes all spirits within a target area visible, including the spirits of living people." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:VulnerableMagic a rpg:Tag ;
    skos:prefLabel "Vulnerable Magic" ;
    dc:description "A Major Hermetic Flaw whereby the character's magic is automatically dispelled in certain uncommon circumstances (e.g. touching iron, crossing running water); often taken as an Ordeal in Glamour Initiation." ;
    rpg:hasTag amol:Flaw .
amol:VulnerableToFolkTradition a rpg:Tag ;
    skos:prefLabel "Vulnerable to Folk Tradition" ;
    dc:description "A Minor Hermetic Flaw that makes a magus's magic susceptible to folk-remedies, granting aware targets Magic Resistance based on Magic Lore and allowing enchantments to be broken." ;
    rpg:hasTag amol:Flaw .
amol:WaitingSpell a rpg:Spell ;
    rpg:name "Waiting Spell" ;
    dc:description "A version of Watching Ward with target Room, well known in the Order, which can contain spells up to the level of the Waiting Spell minus 10 and is also a Ritual." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Waldherz a rpg:Faction ;
    rpg:name "Waldherz" ;
    dc:description "A Black Forest covenant founded as a chapter house of Durenmar by the lineage of Hercynius, dedicated to overcoming Hermetic limits with primal magic; destroyed in the Schism War." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:Wales a schema:Place ;
    rpg:name "Wales" ;
    dc:description "A poorer, more pastoral land west of England, split in 1220 between Anglo-Norman marcher lords in the south and native Welsh princes in the north." ;
    skos:altLabel "South Wales" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:WardAgainstFaeriesOfTheAir a rpg:Spell ;
    rpg:name "Ward Against Faeries of the Air" ;
    dc:description "A Rego Auram ward spell (General) protecting a magic circle against faeries of the air, who cannot break the circle or affect those within it." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:WatchingWard a rpg:Spell ;
    rpg:name "Watching Ward" ;
    dc:description "A Rego Vim ritual that holds another spell on a target in suspension until triggered by a specified condition; Flambeau and Tytalus magi commonly use it for vengeance spells." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Wayland a rpg:Character ;
    rpg:name "Wayland" ;
    dc:description "An invisible smith dwelling at Wayland's Smithy who will shoe a horse left with a penny overnight; legend credits him with forging magical weapons and armor for great heroes." ;
    skos:altLabel "Völand", "Wayland Smith" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:WeakSpontaneousMagic a rpg:Tag ;
    skos:prefLabel "Weak Spontaneous Magic" ;
    dc:description "The Major Hermetic Flaw of the Rusticani; they cannot fatigue themselves to boost spontaneous magic, making them dependent on formulaic spells." ;
    rpg:hasTag amol:Flaw .
amol:Weakness a rpg:Tag ;
    skos:prefLabel "Weakness" ;
    dc:description "A Personality Flaw giving a character an irresistible attraction to something (e.g. books or good food); held by the Spying Maid and Lord of the Manor." ;
    skos:altLabel "Weakness Flaw" ;
    rpg:hasTag amol:Flaw .
amol:Westerwald a schema:Place ;
    rpg:name "Westerwald" ;
    dc:description "A broad hilly forest stretching east from the Rhine north of Koblenz, home to the hamlet of Waldheim, the former covenant of Oakdell, and the faerie Court of Bright Winter." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:WhisperingWinds a rpg:Spell ;
    rpg:name "Whispering Winds" ;
    dc:description "An Intellego Auram unique spell (Level 15) letting the caster hear words spoken by any group within line of sight; an adaptation of an effect known to Bjornaer the Founder." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:WingsOfTheSoaringWind a rpg:Spell ;
    rpg:name "Wings of the Soaring Wind" ;
    dc:description "A Creo Auram spell (Level 30) with a Rego requisite that generates a gust supporting and propelling the caster through the air at up to 40 mph." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:WizardSSidestep a rpg:Spell ;
    rpg:name "Wizard's Sidestep" ;
    dc:description "A Rego Imaginem spell in which the caster's image appears up to a pace from their actual position so attacks miss; once the image is struck the caster gains a +9 bonus to Defense." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:WizardSVigil a rpg:Spell ;
    rpg:name "Wizard's Vigil" ;
    dc:description "A Ritual spell known free by Mercurian Magic magi at a level equal to their highest Ritual spell, enabling collaborative casting that raises effective spell level." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Woden a rpg:Character ;
    rpg:name "Woden" ;
    dc:description "The Norse god who oversaw trade and commerce under the title Farmagud (god of cargoes); a fickle god of magic whose symbols are the spear, raven, and wolf." ;
    skos:altLabel "Farmagud", "Vodans", "Wotan" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Worms a schema:Place ;
    rpg:name "Worms" ;
    dc:description "A famed Rhine city linked to the Nibelungenlied as the Royal Fortress of the Nibelung, ruled by its prince-bishop, with a great cathedral and the largest Jewish settlement in Germany." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:GildTrained a rpg:Tag ;
    skos:prefLabel "(Gild) Trained" ;
    dc:description "A Minor Hermetic Virtue representing training at Durenmar and induction into a Rhine political gild, granting extra experience points appropriate to the gild." ;
    skos:altLabel "Ash Gild Trained", "Elder Gild Trained", "Linden Gild Trained" ;
    rpg:hasTag amol:Virtue .
amol:Adulteration a rpg:Tag ;
    skos:prefLabel "Adulteration" ;
    dc:description "Impurities from magi's minds made solid by mystical forces, often created during Final Twilight, embodying unresolved psychological issues as creatures or places; the greatest are called malignancies." ;
    skos:altLabel "adulterations", "malignancies" ;
    rpg:hasTag amol:HermeticConcept .
amol:AestheticQuality a rpg:Tag ;
    skos:prefLabel "Aesthetic Quality" ;
    dc:description "A score determining how aesthetically pleasing a piece of artwork is, calculated from Dexterity + Craft or Communication + Profession plus bonuses, analogous to a book's Quality." ;
    rpg:hasTag amol:HermeticConcept .
amol:AffinityWithAuram a rpg:Tag ;
    skos:prefLabel "Affinity with Auram" ;
    dc:description "The Minor Hermetic Virtue of the Tempestaria tradition, granting an affinity with the Auram Art." ;
    rpg:hasTag amol:Virtue .
amol:AffinityWithHeartbeast a rpg:Tag ;
    skos:prefLabel "Affinity with Heartbeast" ;
    dc:description "A Virtue granting an affinity with the Heartbeast Ability, gained through Clan Midusulf's Trial of the Sacred Marriage at the cost of a Study Requirement." ;
    rpg:hasTag amol:Virtue .
amol:AffinityWithMedicine a rpg:Tag ;
    skos:prefLabel "Affinity with Medicine" ;
    dc:description "A Virtue improving learning in the Medicine Ability, possessed by the sample physician Gilles de Corbeil." ;
    rpg:hasTag amol:Virtue .
amol:AgeQuickly a rpg:Tag ;
    skos:prefLabel "Age Quickly" ;
    dc:description "A Major Supernatural Flaw: due to a curse or magical disaster, the character ages twice as fast as normal and makes two aging rolls each year." ;
    rpg:hasTag amol:Flaw .
amol:AgnesOfIrencillia a rpg:Character ;
    rpg:name "Agnes of Irencillia" ;
    dc:description "A maga of Irencillia who in 1158 announced a sighting of the Founder Merinita in Bohemia, though little credence was paid to her claim." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:AirElemental a rpg:Creature ;
    rpg:name "Air Elemental" ;
    dc:description "An elemental being associated with Auram that can be reduced in Might by Perdo Auram or completely controlled by Rego Auram." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Alberich a rpg:Character ;
    rpg:name "Alberich" ;
    dc:description "A faerie that, according to a Tytalan rumor, Bonisagus really was; the same one as in the Nibelungenlied." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:AlbertusMagnus a rpg:Character ;
    rpg:name "Albertus Magnus" ;
    dc:description "Born 1206 in Bavaria, the most talented natural magician and philosopher of his time and a Dominican; potentially recruitable into the Order of Hermes and a future saint." ;
    skos:altLabel "Albert of Cologne" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:AlexanderII a rpg:Character ;
    rpg:name "Alexander II" ;
    dc:description "The king of Scotland who fought on Louis's side and presses for reconsideration of Anglo-Scottish treaties; Louis promised him three northern English counties." ;
    skos:altLabel "Alexander", "Alexander II, king of Scotland" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Alsia a rpg:Character ;
    rpg:name "Alsia" ;
    dc:description "One of Merinita's first apprentices who later joined Quendalon and developed a spell allowing those with Faerie Magic to temporarily bind a familiar." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:AmbrosiusOfMerinita a rpg:Character ;
    rpg:name "Ambrosius of Merinita" ;
    dc:description "Son of the seer Emrys, adopted as Quendalon's apprentice; of strong faerie heritage, he became a master of symbolic prediction and founder of the Heirs to Merlin lineage." ;
    skos:altLabel "Ambrosius" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:AnalectsOfTytalus a rpg:Item ;
    rpg:name "Analects of Tytalus" ;
    dc:description "A book collating Tytalus's wisdom, speeches, and sayings, compiled by Hariste; every member of House Tytalus owns a copy and apprentices copy it during apprenticeship." ;
    skos:altLabel "the Analects" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:AneirinTheBard a rpg:Creature ;
    rpg:name "Aneirin the Bard" ;
    dc:description "A Daimon (Magic Might 15, Imaginem) of one of the five great Welsh poets, famous for the poem Y Gododdin, whose spirit wanders the Cambrian Mountains and can teach Names of Power." ;
    skos:altLabel "Aneirin" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Angel a rpg:Creature ;
    rpg:name "Angel" ;
    dc:description "Creatures of the Divine Might who act on behalf of God; genderless beings who can manifest in mortal flesh via their Angelic Mantle and are never bothered by The Gift." ;
    skos:altLabel "angels" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Aphrodite a rpg:Character ;
    rpg:name "Aphrodite" ;
    dc:description "A goddess of love, a variant of Aphrodite, said by Empedocles to be worshipped by the immortals; some Criamon claim to have met her." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:AptStudent a rpg:Tag ;
    skos:prefLabel "Apt Student" ;
    dc:description "A Minor General Virtue adding five to Source Quality when being taught or trained." ;
    rpg:hasTag amol:Virtue .
amol:AquilaOfBjornaer a rpg:Character ;
    rpg:name "Aquila of Bjornaer" ;
    dc:description "An ancient Bjornaer maga of Ungulus who spends most of her time in eagle Heartbeast form over the Lake District and is near Final Twilight." ;
    skos:altLabel "Aquila", "Aquila filia Orn" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:ArcaneLore a rpg:Tag ;
    skos:prefLabel "Arcane Lore" ;
    dc:description "A Minor General Virtue letting a character take Arcane Abilities and gain 50 experience points spent on them; required to learn lores like Infernal or Dominion Lore unless otherwise allowed." ;
    rpg:hasTag amol:Virtue .
amol:Archimagus a rpg:Tag ;
    skos:prefLabel "Archimagus" ;
    dc:description "An elite rank of Hermetic magus; a Tremere Archimagus invented the Lightning-Bringer as his greatest achievement." ;
    skos:altLabel "Archimaga", "Archimagi" ;
    rpg:hasTag amol:CharacterType .
amol:Ardea a rpg:Character ;
    rpg:name "Ardea" ;
    dc:description "A master maga of House Bjornaer holding the Seat of the Swan at Crintera, with a heron heartbeast; a quiet, contemplative seer famous for her foresight and divinatory powers." ;
    skos:altLabel "Ardea, Follower of Bjornaer", "the Swan Elder" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Arkona a schema:Place ;
    rpg:name "Arkona" ;
    dc:description "A ruined Slavic fortress-temple on the northernmost headland of Rugen, one of the holiest pagan Baltic sites where Svantovit was worshipped; destroyed by Bishop Absolon in 1169." ;
    skos:altLabel "Kap Arkona" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:ArsFlambonis a rpg:Item ;
    rpg:name "Ars Flambonis" ;
    dc:description "A Summa on Ignem (Level 14, Quality 12) written by Elaine as a tribute to her pater Flambeau, sprinkled with anecdotes about his teachings." ;
    skos:altLabel "Flambeau's Art" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:ArtistReputation a rpg:Tag ;
    skos:prefLabel "Artist Reputation" ;
    dc:description "A flexible Reputation named after an artist's Craft or Profession Ability that grows with the quality of his work and sponsors, conferring social and supernatural benefits as it rises toward 11." ;
    rpg:hasTag amol:HermeticConcept .
amol:ArtisticRenown a rpg:Tag ;
    skos:prefLabel "Artistic Renown" ;
    dc:description "A Minor General Virtue granting an Artist Reputation of 2 (takeable twice); also a Major Supernatural Virtue version letting a non-Gifted artist study one Hermetic Form." ;
    rpg:hasTag amol:Virtue .
amol:Ashenrise a rpg:Faction ;
    rpg:name "Ashenrise" ;
    dc:description "A covenant founded in the Hibernian Tribunal in 1062 by the survivors of Tagelyn after Blackthorn drove them from their caves." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:AuraOfChildlikeInnocence a rpg:Spell ;
    rpg:name "Aura of Childlike Innocence" ;
    dc:description "A MuIm 10 spell, a variant of Aura of Ennobled Presence, that makes the target appear more guileless and naive, granting bonuses to deflect suspicion and to Guile-based debate defenses." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Autocrat a rpg:Tag ;
    skos:prefLabel "Autocrat" ;
    dc:description "A single covenant official combining two specialist roles (commonly steward and chamberlain), contributing the loyalty points of both." ;
    rpg:hasTag amol:CharacterType .
amol:Avaricious a rpg:Tag ;
    skos:prefLabel "Avaricious" ;
    dc:description "A Major or Minor Personality Flaw: the character hoards money or physical things rather than spending or using them." ;
    rpg:hasTag amol:Flaw .
amol:AverseToRisk a rpg:Tag ;
    skos:prefLabel "Averse to Risk" ;
    dc:description "A Minor Ordeal Flaw making a Verditius magus reluctant to undertake risky laboratory activities, forbidding experimentation; incompatible with Prone to Chance." ;
    skos:altLabel "Adverse to Risk" ;
    rpg:hasTag amol:Flaw .
amol:Avicenna a rpg:Character ;
    rpg:name "Avicenna" ;
    dc:description "Author of The Canon of Medicine, quoted as the defining text on medicine as a science of the human body's dispositions." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Awakening a rpg:Tag ;
    skos:prefLabel "Awakening" ;
    dc:description "A Minor Nature Mystery letting nature magi awaken a natural intelligence and Magic Might within subjects of their region, basis for Merinita's familiar-binding ritual." ;
    rpg:hasTag amol:Virtue .
amol:AxisMagica a rpg:Tag ;
    skos:prefLabel "Axis Magica" ;
    dc:description "The great pole around which the world's tides of magical energy circle; it is the Founder Criamon himself transformed into a living bridge keeping open the Twilight Road." ;
    rpg:hasTag amol:HermeticConcept .
amol:BaalPeorLordOfFilth a rpg:Creature ;
    rpg:name "Baal-Peor, Lord of Filth" ;
    dc:description "A demon of wealth and filth (Might 30, Corpus) who creates discord by moving mortal riches disruptively, sprays noxious vomit, and was worshipped as an embodiment of the desire to consume and defile." ;
    skos:altLabel "Baal-Peor", "Belphegor", "Lord of the Openings", "Treasurer of Hell" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Baccalaureus a rpg:Tag ;
    skos:prefLabel "Baccalaureus" ;
    dc:description "A Minor Social Status Virtue for a character who completed a three-year university program earning a Bachelor of Arts, with 90 experience points in Latin and Artes Liberales." ;
    skos:altLabel "Baccalaureate" ;
    rpg:hasTag amol:Virtue .
amol:BaghlAnEarthJinni a rpg:Creature ;
    rpg:name "Baghl, an Earth Jinni" ;
    dc:description "An earth jinni (Magic Might 15, Terram) who haunts a dark cave in the Elbruz mountains, able to turn humans to stone and duplicate Perdo/Rego Terram spells; appears as an obese man with a mule's head." ;
    skos:altLabel "Baghl" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Bamberg a schema:Place ;
    rpg:name "Bamberg" ;
    dc:description "A bishopric city elevated by Henry II and built on seven hills to rival Rome; its main export is beer, with over a dozen breweries including the ancient Bierhaus." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:BanefulCircumstances a rpg:Tag ;
    skos:prefLabel "Baneful Circumstances" ;
    dc:description "A Minor Supernatural Flaw: the character's supernatural nature weakens him in common circumstances, preventing recovery of Fatigue, healing, or Might at those times." ;
    rpg:hasTag amol:Flaw .
amol:BaronJurgenSchonburg a rpg:Character ;
    rpg:name "Baron Jurgen Schonburg" ;
    dc:description "Baron of Sooneck/Oberwesel holding the Schonburg castle; father of the diabolist Robert and of Karlotte, descended from the fae of the Court of Dark Summer." ;
    skos:altLabel "Baron Schonburg", "Jurgen", "Jürgen" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Bartholomew a rpg:Creature ;
    rpg:name "Bartholomew" ;
    dc:description "A demon (Might 50, Mentem) appearing as a successful merchant who gives good business advice backed by blessings and curses, subtly leading merchants into sin while winning souls for Hell." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Basic a rpg:Tag ;
    skos:prefLabel "Basic" ;
    dc:description "A laboratory Flaw present after only the first season of a standard lab's setup, giving a –3 penalty to all Lab Totals until the second setup season removes it." ;
    skos:altLabel "Basic Flaw" ;
    rpg:hasTag amol:Flaw .
amol:Bavaria a schema:Place ;
    rpg:name "Bavaria" ;
    dc:description "A large duchy through which the Danube flows, ruled by Louis of Wittelsbach; only its smaller part north of the Danube belongs to the Rhine Tribunal." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Beadle a rpg:Tag ;
    skos:prefLabel "Beadle" ;
    dc:description "A Minor Social Status Virtue for a character employed as an assistant to a university dean who carries the university's insignia, collects dues, and announces disputationes." ;
    rpg:hasTag amol:Virtue .
amol:BeastOfMinusculeProportions a rpg:Spell ;
    rpg:name "Beast of Minuscule Proportions" ;
    dc:description "A Muto Animal spell that shrinks a creature; the appendix notes its description is slightly amended so Initiative is increased along with the listed effects." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:BeastOfOutlandishSize a rpg:Spell ;
    rpg:name "Beast of Outlandish Size" ;
    dc:description "A Muto Animal spell that enlarges a creature; the appendix notes its description is slightly amended so Initiative is reduced along with the listed effects." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Beechleaf a rpg:Character ;
    rpg:name "Beechleaf" ;
    dc:description "A green-skinned journeyman of House Merinita at Fengheld, apprenticed at Irencillia by Primus Handri, who was raised by a dryad and is strongly influenced by the fae." ;
    skos:altLabel "Beechleaf, Follower of Merinita" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Bigamist a rpg:Tag ;
    skos:prefLabel "Bigamist" ;
    dc:description "A major Story Flaw where a merchant lives two entirely separate lives with two spouses and households in two cities, raising annual business costs." ;
    rpg:hasTag amol:Flaw .
amol:BindCurse a rpg:Tag ;
    skos:prefLabel "Bind Curse" ;
    dc:description "A Major Inner House Mystery of Verditius developed by Himinis the Mad for instilling powerful curses into items, requiring the Sever the Ties That Bind Ordeal." ;
    skos:altLabel "Bind Curse Mystery", "Bind Curses" ;
    rpg:hasTag amol:Virtue .
amol:BindMagicalCreatures a rpg:Tag ;
    skos:prefLabel "Bind Magical Creatures" ;
    dc:description "A Major House Mystery developed in the Thebes Tribunal that binds a magical creature's life force to an enchanted device or binds one of its powers to the magus's Gift." ;
    skos:altLabel "Bind Magical Creature", "binding magical animals" ;
    rpg:hasTag amol:Virtue .
amol:Bingen a schema:Place ;
    rpg:name "Bingen" ;
    dc:description "A walled town at the southern edge of the Rhine Gorge where the Nahe meets the Rhine, guarded by Burg Klopp; near the Mouse Tower and home of Hildegard's Rupertsberg monastery." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:BingenHole a schema:Place ;
    rpg:name "Bingen Hole" ;
    dc:description "A hazardous stretch of the Rhine immediately downstream of Bingen, where rocks, accelerating flow, and treacherous eddies make navigation perilous." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:BishopHatto a rpg:Creature ;
    rpg:name "Bishop Hatto" ;
    dc:description "The demonic shade (Infernal Might 30, Mentem) of the greedy archbishop Hatto II of Mainz, who haunts the Mausturm island and attacks with a chilling touch and powers of fear." ;
    skos:altLabel "Hatto", "Hatto II" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:BlackDeath a rpg:Creature ;
    rpg:name "Black Death" ;
    dc:description "A demon appearing as a shrouded reaper, invisible to mundane senses, summoned by an Infernal ritual; it does not exist in 1220 Mythic Europe but arises in 1347 in Constantinople if the saga follows history." ;
    skos:altLabel "the plague", "the shrouded reaper" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:BlackSheep a rpg:Tag ;
    skos:prefLabel "Black Sheep" ;
    dc:description "A minor Flaw representing estrangement from one's family or social group, likely to inconvenience a principal and lower an agent's Resistance Strength." ;
    rpg:hasTag amol:Flaw .
amol:BlackWhisper a rpg:Spell ;
    rpg:name "Black Whisper" ;
    dc:description "A spell in which the caster whispers a magic sentence into the target's ear; if completed, the target must resist a Stamina roll or go completely insane." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:BloodOfTheNephilim a rpg:Tag ;
    skos:prefLabel "Blood of the Nephilim" ;
    dc:description "A Major Supernatural Virtue granting angelic descent, increased Size, very slow aging, and Dominion Lore, but heavy food requirements and many restrictions." ;
    skos:altLabel "Major Virtue Blood of the Nephilim" ;
    rpg:hasTag amol:Virtue .
amol:BluntTheViperSFangs a rpg:Spell ;
    rpg:name "Blunt the Viper's Fangs" ;
    dc:description "A Perdo Animal spell (Level 20) that blunts the natural weapons (claws, teeth, talons) of a beast, halving their damage." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Bohemia a schema:Place ;
    rpg:name "Bohemia" ;
    dc:description "A subject kingdom of the Rhine Tribunal's southeastern lands, ruled by the Premyslid dynasty; a land of forested plains crossed by the River Elbe with few great cities." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Bomburkhan a rpg:Creature ;
    rpg:name "Bomburkhan" ;
    dc:description "A minor imp demon (Might 5, Vim) appearing as a jet-black bat with a human face who punctures the egos of the prideful by granting talents that contradict boasts; released after the fall of Jerusalem." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:BordelonAPersonalTormentor a rpg:Creature ;
    rpg:name "Bordelon, a Personal Tormentor" ;
    dc:description "A demon (Might 15, Corpus) appearing as a stern governess who chooses a child as her personal tormentor, crushing ambition and meekness through punishment whenever the child distinguishes himself." ;
    skos:altLabel "Bordelon" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:BorisOfNovgorod a rpg:Character ;
    rpg:name "Boris of Novgorod" ;
    dc:description "A well-traveled Russian Redcap of Oculus Septentrionalis who poses as an itinerant merchant, runs the Novgorod Inn in Lubeck, and trades books, items, and vis with magi." ;
    skos:altLabel "Boris", "Boris of Novgorod, Follower of Mercere" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Botch a rpg:Tag ;
    skos:prefLabel "Botch" ;
    dc:description "A mistake on a spell roll cast under stress that produces unintended, usually detrimental effects and a Casting Total of zero; the number of zeros on the botch dice determines severity." ;
    skos:altLabel "Botch Dice", "Botches", "botch dice", "botches" ;
    rpg:hasTag amol:HermeticConcept .
amol:BoundCastingTools a rpg:Tag ;
    skos:prefLabel "Bound Casting Tools" ;
    dc:description "A Minor Hermetic Flaw: the magus's casting tools, as used by House Verditius, become lasting Arcane Connections to him." ;
    rpg:hasTag amol:Flaw .
amol:Bow a rpg:Proficiency ;
    rpg:name "Bow" ;
    dc:description "The missile-combat Ability used for ranged weapons such as the long bow and short bow." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:BranchesOfTheArts a rpg:Tag ;
    skos:prefLabel "Branches of the Arts" ;
    dc:description "The finest summae yet produced for eight of the Arts, given as gifts among covenants because their value cannot be met in kind; the Branch of Terram in 1220 is De Lapii." ;
    skos:altLabel "Branches", "Pillars", "Pillars of the Arts" ;
    rpg:hasTag amol:HermeticConcept .
amol:BreakTheOncomingWave a rpg:Spell ;
    rpg:name "Break the Oncoming Wave" ;
    dc:description "A Rego Aquam spell (Level 10) that breaks all waves and torrents of water, including magical ones, just before they touch the caster." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:BreathOfWinter a rpg:Spell ;
    rpg:name "Breath of Winter" ;
    dc:description "A Rego Aquam spell (Level 15) that turns a circle of water up to five paces across into snow that will not melt until the spell expires." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:BridgeOfWood a rpg:Spell ;
    rpg:name "Bridge of Wood" ;
    dc:description "A Creo Herbam spell (Level 15) that creates a bridge of living leaves, vines, and wood up to 20 paces long supporting creatures up to Size +4." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Brittany a schema:Place ;
    rpg:name "Brittany" ;
    dc:description "A region off whose coast lies the Isle of Ushant; Tytalus made his home there and was likely responsible for its annexation by the Frankish Empire." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:BrotherJulian a rpg:Character ;
    rpg:name "Brother Julian" ;
    dc:description "A deformed Benedictine-raised mendicant friar and companion-level character, member of the Order of Preachers, who preaches against the Cathar heresy in Languedoc and craves academic learning." ;
    skos:altLabel "Julian" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:BrNhild a rpg:Character ;
    rpg:name "Brünhild" ;
    dc:description "The legendarily strong queen of Iceland in the Nibelungenlied, won for Gunther through Siegfried's deception, whose humiliation leads her to conspire in Siegfried's murder." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:BuryStEdmundS a schema:Place ;
    rpg:name "Bury St. Edmund's" ;
    dc:description "A wealthy abbey town in West Suffolk wholly under the abbey's control, founded in 633 by King Sigebert and home to the tomb of St. Edmund, a major pilgrimage site." ;
    skos:altLabel "Abbey of St. Edmund", "St. Edmund's Abbey" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Byrek a rpg:Character ;
    rpg:name "Byrek" ;
    dc:description "A clumsy but tireless grog from the Horse Clan of Crintera who wears a magical horse-bone amulet said to make him as swift and tireless as a horse." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:ByrekSMagicalAmulet a rpg:Item ;
    rpg:name "Byrek's magical amulet" ;
    dc:description "A magical amulet carved of horse bone given to Byrek by his witch mother of the Horse Clan, said to make him as swift and tireless as a horse, though its true power is unknown." ;
    skos:altLabel "horse-bone amulet" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:Caladrius a rpg:Creature ;
    rpg:name "Caladrius" ;
    dc:description "A magnificent all-white mystical bird of the Magic Realm, sought by royal households, which can draw a non-fatal disease out of a sick person into itself and burn it away by flying toward the sun." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Caprea a rpg:Character ;
    rpg:name "Caprea" ;
    dc:description "A visiting Bjornaer maga who is a current guest at Crintera, working on a bestiary to present at the next Tribunal. She accidentally blinded the familiar of a visiting Jerbiton magus, Carolus." ;
    skos:altLabel "Caprea of Bjornaer" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Carmine a rpg:Character ;
    rpg:name "Carmine" ;
    dc:description "A maga of House Flambeau, wife of the Primus of Jerbiton, who prefers Creo Ignem effects and uses a ruby necklace and coral brooch as a ceremonial casting kit." ;
    skos:altLabel "Carmine filia Susannah", "Carmine of Flambeau" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Carolinus a rpg:Character ;
    rpg:name "Carolinus" ;
    dc:description "Charlemagne's mage-smith, several of whose apprentices were adopted by the Founder Jerbiton." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:CascadeOfRocks a rpg:Spell ;
    rpg:name "Cascade of Rocks" ;
    dc:description "A Perdo Terram (PeTe 40) spell that can do great damage only if an opponent is on a steep hillside or cliff base, used by the School of Vilano; bypasses Magic Resistance." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:CastingTools a rpg:Item ;
    rpg:name "Casting Tools" ;
    dc:description "Tools that Verditius magi must use to cast Formulaic and Ritual spells; they can be enchanted via an Inner House Mystery and become permanent Arcane Connections." ;
    skos:altLabel "casting tool" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:CastraSolis a rpg:Faction ;
    rpg:name "Castra Solis" ;
    dc:description "The domus magna of House Flambeau in the Provençal Tribunal, a modest manor-house covenant founded by Kaeso atop a cave once sacred to Mithras, south of Bordeaux." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:CastrumAntiquum a rpg:Faction ;
    rpg:name "Castrum Antiquum" ;
    dc:description "Covenant founded in 852 in the ruins of a Roman fort on Hadrian's Wall; vanished without trace around 1030/1; home of Agricola of Tytalus." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:CathedralSchoolMaster a rpg:Tag ;
    skos:prefLabel "Cathedral School Master" ;
    dc:description "A Major Social Status Virtue for a character who teaches at a cathedral school, requiring scores of 5 in Latin and Artes Liberales and granting 240 experience points." ;
    rpg:hasTag amol:Virtue .
amol:CathedralOfChartres a schema:Place ;
    rpg:name "Cathedral of Chartres" ;
    dc:description "A cathedral nearing completion in 1220 where the Dreux and Capetian families compete to fund the most beautiful south-transept window." ;
    skos:altLabel "Chartres" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:CaudelixTheGaul a rpg:Creature ;
    rpg:name "Caudelix the Gaul" ;
    dc:description "A ghostly gladiator (Magic Might 20) of the Trier amphitheater, a burly giant of a man wielding a long-handled great axe." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:CautiousSorcerer a rpg:Tag ;
    skos:prefLabel "Cautious Sorcerer" ;
    dc:description "A Minor Hermetic Virtue letting a magus roll three fewer botch dice when casting spells or working in the laboratory." ;
    rpg:hasTag amol:Virtue .
amol:CeremonialSpontaneousMagic a rpg:Tag ;
    skos:prefLabel "Ceremonial Spontaneous Magic" ;
    dc:description "A Minor Flaw possessed by all known members of the Mercurian lineage as part of the Mercurian Magic Virtue." ;
    rpg:hasTag amol:Flaw .
amol:Champagne a schema:Place ;
    rpg:name "Champagne" ;
    dc:description "The pre-eminent fair cycle of Mythic Europe and a financial center, comprising fairs at Lagny, Bar-sur-Aube, Provins, and Troyes, guaranteed safe by the counts of Champagne." ;
    skos:altLabel "Champagne cycle" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:CharmMagic a rpg:Tag ;
    skos:prefLabel "Charm Magic" ;
    dc:description "A Minor Folk Inner Mystery (Virtue) allowing a Merinita to incorporate charms into her spells, granting Casting Total and Penetration bonuses through sympathetic magic." ;
    rpg:hasTag amol:Virtue .
amol:CharterOfTheForest a rpg:Tag ;
    skos:prefLabel "Charter of the Forest" ;
    dc:description "A charter issued in 1217 alongside the Magna Carta reissue, restricting the king's forest rights and limiting forest officials from imposing penalties of life or limb." ;
    rpg:hasTag amol:HermeticConcept .
amol:ChildbedFeverDemon a rpg:Creature ;
    rpg:name "Childbed Fever Demon" ;
    dc:description "A demon with Might 10 (Corpus) that attempts to enter a woman's body during birth, causing fever and rotting of the reproductive organs; its magical attack can be resisted with Magic Resistance." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Chiron a rpg:Character ;
    rpg:name "Chiron" ;
    dc:description "The figure who warned Jason that the Argonauts would be lost unless Orpheus accompanied them, a prophecy fulfilled at the sirens' island." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Chirurgeon a rpg:Tag ;
    skos:prefLabel "Chirurgeon" ;
    dc:description "A practitioner of chirurgy (surgery, bone-setting, phlebotomy, cautery, midwifery), considered a craft; includes barber-surgeons who assist medici in therapeutic procedures." ;
    skos:altLabel "barber-surgeon" ;
    rpg:hasTag amol:CharacterType .
amol:ChnoubisTheSerpent a rpg:Creature ;
    rpg:name "Chnoubis the Serpent" ;
    dc:description "A lion-headed serpent Daimon (Magic Might 30, Mentem) summoned for his abilities to scry and ferret out secrets, claiming to be a native of the Nile." ;
    skos:altLabel "Chnoubis" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:ChurchOfSaintCyprian a schema:Place ;
    rpg:name "Church of Saint Cyprian" ;
    dc:description "A church within Valnastium valley whose presence creates a Divine aura up to 6 and has prevented the covenant's Magic aura from developing further." ;
    skos:altLabel "Saint Cyprian's" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:CityAndGuild a rpg:Item ;
    rpg:name "City and Guild" ;
    dc:description "An Ars Magica sourcebook covering craftsmen, guilds, and social statuses, referenced for rules on masons and on Social Status Virtues like Factor." ;
    skos:altLabel "City & Guild" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:ClanArelie a rpg:Faction ;
    rpg:name "Clan Arelie" ;
    dc:description "The 'Remember' clan of House Bjornaer, the most outward-looking and Harmonist (pacifist), preserving stories and teaching of the ancestors." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:ClanMaruhs a rpg:Faction ;
    rpg:name "Clan Maruhs" ;
    dc:description "The 'Strive' clan of House Bjornaer, romantic, passionate Wilderists known for wildness and as poets and heroes." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:ClanMidusulf a rpg:Faction ;
    rpg:name "Clan Midusulf" ;
    dc:description "The 'Lead' clan of House Bjornaer, arch-conservative Wilderists most opposed to the Harmonists, with the deepest understanding of the Mystery of the Heartbeast." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:ClanSirnas a rpg:Faction ;
    rpg:name "Clan Sirnas" ;
    dc:description "The 'Protect' clan of House Bjornaer, the most active Harmonist clan and protectors of all Bjornaer magi, which absorbed most ninth-century Merinita defectors." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:ClanWilkis a rpg:Faction ;
    rpg:name "Clan Wilkis" ;
    dc:description "The 'Nourish' clan of House Bjornaer, Harmonists who strengthen the House, enforce Council decisions, and hunt down those who endanger the House." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:CloakOfMist a rpg:Spell ;
    rpg:name "Cloak of Mist" ;
    dc:description "A Muto Corpus spell (Level 40) with an Auram requisite that turns the caster into a human-sized cohesive mist able to float and seep through cracks." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:CloudsOfSummerSnow a rpg:Spell ;
    rpg:name "Clouds of Summer Snow" ;
    dc:description "A Creo Auram spell (Level 25) that creates clouds dropping snow over an area about half a mile across without affecting temperature." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:CloudsOfThunderousMight a rpg:Spell ;
    rpg:name "Clouds of Thunderous Might" ;
    dc:description "A Rego Auram spell (Level 30) that gathers pre-existing clouds and winds into a small storm under the caster's control while they can see it." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Clumsy a rpg:Tag ;
    skos:prefLabel "Clumsy" ;
    dc:description "A Minor General Flaw: the character is ungraceful, at -3 on related rolls and rolling an extra botch die on Dexterity actions." ;
    rpg:hasTag amol:Flaw .
amol:CluniacOrder a rpg:Faction ;
    rpg:name "Cluniac Order" ;
    dc:description "A group within the Benedictines whose houses depend on the abbey of Cluny in France, placing great emphasis on the opus dei and building splendid churches." ;
    skos:altLabel "Cluniac", "Cluniacs" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Cluny a schema:Place ;
    rpg:name "Cluny" ;
    dc:description "An abbey in France that heads the Cluniac Order, a group of monasteries spread across Europe, and which is rich and powerful." ;
    skos:altLabel "abbey of Cluny" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:CodeOfGarus a rpg:Tag ;
    skos:prefLabel "Code of Garus" ;
    dc:description "The written code of chivalric conduct for the milites, devised by Primus Garus and loosely based on Charlemagne's code for his knights." ;
    rpg:hasTag amol:HermeticConcept .
amol:CoilsOfTheEntanglingPlants a rpg:Spell ;
    rpg:name "Coils of the Entangling Plants" ;
    dc:description "A Rego Herbam spell (Level 20) that animates grass and small plants in a field to grab and wrap around the people nearest them." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Cologne a schema:Place ;
    rpg:name "Cologne" ;
    dc:description "The largest city of the Holy Roman Empire north of the Alps and the most important trading city in Germany, ruled by its powerful archbishop, home to the relics of the Three Magi." ;
    skos:altLabel "Colonia Agrippensis", "Colonia Claudia Ara Agrippinensis" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Colomen a rpg:Character ;
    rpg:name "Colomen" ;
    dc:description "The leader of the Columbae tradition when it officially joined the Order, who with his wife Gwyndolen adapted their ward-powers to Hermetic magic and spread their spells." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:ComfortOfTheDrenchedTraveler a rpg:Spell ;
    rpg:name "Comfort of the Drenched Traveler" ;
    dc:description "A Perdo Aquam spell (Level 5) that dries a person and their clothes." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ComprehendMagic a rpg:Tag ;
    skos:prefLabel "Comprehend Magic" ;
    dc:description "A Major Supernatural Virtue and Ability (the defining power of the Lineage of Pralix) that lets a character see, analyze, and understand active magics without penalizing Magic Resistance." ;
    rpg:hasTag amol:Virtue .
amol:Compulsion a rpg:Tag ;
    skos:prefLabel "Compulsion" ;
    dc:description "A Personality Flaw driving a creature toward a behavior; wolves have Compulsion (killing) reflecting their bloodthirsty medieval perception." ;
    rpg:hasTag amol:Flaw .
amol:ConfusionOfTheNumbedWill a rpg:Spell ;
    rpg:name "Confusion of the Numbed Will" ;
    dc:description "A spell that confuses a person, who must make an Intelligence roll to take direct action and always strikes last in combat." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ConjurationOfTheIndubitableCold a rpg:Spell ;
    rpg:name "Conjuration of the Indubitable Cold" ;
    dc:description "A Perdo Ignem spell (Level 25) that cools the air within ten paces below freezing, chilling nonliving things thoroughly and costing living things a Fatigue level while shrinking fires." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ConsumedCastingTools a rpg:Tag ;
    skos:prefLabel "Consumed Casting Tools" ;
    dc:description "A Minor Hermetic Flaw, only for Verditius magi: the magus's casting tools are magically consumed after use, taking an hour to remake." ;
    rpg:hasTag amol:Flaw .
amol:CorruptBeast a rpg:Creature ;
    rpg:name "Corrupt Beast" ;
    dc:description "A compulsory Minor Supernatural Flaw for corrupt beasts granting Infernal Might 5, a sinful Personality Trait at +6, a repellent appearance, and the Tainted with Evil Flaw." ;
    skos:altLabel "Corrupt Beasts", "Corrupted Beast" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:CorvusOfBjornaer a rpg:Character ;
    rpg:name "Corvus of Bjornaer" ;
    dc:description "A mature Bjornaer magus of Voluntas with a raven Heartbeast, specializing in Intellego magic and suspected of scrying on other magi." ;
    skos:altLabel "Corvus", "Corvus filius Aquila" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:CouncilOfElders a rpg:Faction ;
    rpg:name "Council of Elders" ;
    dc:description "The six-magus governing body of House Bjornaer at Crintera, holding the Seats of the Bear, Wolf, Horse, Stag, Eagle, and Swan, with the Senior Elder holding the casting vote." ;
    skos:altLabel "Six Elders of Crintera", "the Bjornaer council" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:CourtOfBrightWinter a rpg:Faction ;
    rpg:name "Court of Bright Winter" ;
    dc:description "A Seelie faerie court associated with light, snow, cold, and the hunt, found in midwinter among the high hills of the Westerwald; rival to Dark Summer." ;
    skos:altLabel "Bright Winter", "Winter Court" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:CourtOfDarkSummer a rpg:Faction ;
    rpg:name "Court of Dark Summer" ;
    dc:description "An Unseelie faerie court associated with dark, fire, warmth, and agriculture, found in midsummer in the swampy Hunsruck forest west of the Rhine Gorge; rival to Bright Winter." ;
    skos:altLabel "Dark Summer" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:CovenantLore a rpg:Proficiency ;
    rpg:name "Covenant Lore" ;
    dc:description "An Ability concerning knowledge of a covenant; under the Stuck in Your Ways Flaw the character uses the lower of an Ability and his current Covenant Lore for certain Stress Rolls." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:CowAndCalfOath a rpg:Tag ;
    skos:prefLabel "Cow and Calf Oath" ;
    dc:description "An agreement, originating in a Hibernia Tribunal ruling, under which a book purchaser will not sell or freely give copies without the seller's permission." ;
    rpg:hasTag amol:HermeticConcept .
amol:CraftMagic a rpg:Tag ;
    skos:prefLabel "Craft Magic" ;
    dc:description "The Major Non-Hermetic Virtue of the Rusticani that lets a character build spells and enchanted devices through craft work rather than words and gestures." ;
    rpg:hasTag amol:Virtue .
amol:CralianOfTremere a rpg:Character ;
    rpg:name "Cralian of Tremere" ;
    dc:description "A magus of House Tremere whose version of Disguise of the New Visage always produces a visage as unassuming as possible." ;
    skos:altLabel "Cralian" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:CreativeBlock a rpg:Tag ;
    skos:prefLabel "Creative Block" ;
    dc:description "A Minor Hermetic Flaw: the magus has problems creating new things in the lab, taking -3 to Lab Totals unless using a Laboratory Text or being taught." ;
    rpg:hasTag amol:Flaw .
amol:CreepingChasm a rpg:Spell ;
    rpg:name "Creeping Chasm" ;
    dc:description "A Rego Terram spell that creates a chasm running from the caster's feet toward a target, growing wider as it travels." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Crucifixo a rpg:Character ;
    rpg:name "Crucifixo" ;
    dc:description "The current Jerbiton Primus's familiar, a cat of the Black Lineage who is not yet the King of the Cats but may become so when the current king (his mentor) dies." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:CulhwchExMiscellanea a rpg:Character ;
    rpg:name "Culhwch Ex Miscellanea" ;
    dc:description "A mature magus at Cad Gadu, Gwrhyr's former apprentice turned bully fond of tormenting mundanes; particularly skilled with Ignem." ;
    skos:altLabel "Culhwch" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:CultOfMithras a rpg:Faction ;
    rpg:name "Cult of Mithras" ;
    dc:description "An ancient Roman mystery cult worshiping the savior-god Mithras; a remnant magical lineage founded by Kaeso forms the Mithraic tradition within House Flambeau." ;
    skos:altLabel "Mithraians", "Mithraic tradition" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:CurseThrowing a rpg:Proficiency ;
    rpg:name "Curse-Throwing" ;
    dc:description "A Major Supernatural Virtue and Ability allowing a character to cure diseases and remove curses by transferring them to another person; called Sin-Eating in some cultures." ;
    skos:altLabel "Sin-Eating" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:CyrillusOfArgentoratum a rpg:Creature ;
    rpg:name "Cyrillus of Argentoratum" ;
    dc:description "A ghostly gladiator (Magic Might 20) of the Trier amphitheater, a wiry retetarius armed with trident and net and wearing a mask of Poseidon." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Damaged a rpg:Tag ;
    skos:prefLabel "Damaged" ;
    dc:description "A Free laboratory Outfittings Flaw: the lab is partially damaged, e.g. from an accident, taking one season to repair (-2 General Quality, -1 Safety, -1 Aesthetics)." ;
    skos:altLabel "Damaged Flaw" ;
    rpg:hasTag amol:Flaw .
amol:DamhadhDuidsan a rpg:Faction ;
    rpg:name "Damhadh-Duidsan" ;
    dc:description "A tradition of House Ex Miscellanea descended from Damhadh-Duidas who carve Ogam runes to curse, wound, and heal; they try to escape their Infernal past, with Giant Blood common." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:DaughtersOfFourFathers a rpg:Faction ;
    rpg:name "Daughters of Four Fathers" ;
    dc:description "An all-female magical tradition found in north Africa, particularly associated with the Skinchanger (Dove) Virtue." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:DavidBenDavid a rpg:Character ;
    rpg:name "David ben David" ;
    dc:description "A wealthy, devout Jewish merchant of Trier who manages a wine shop above the former covenant of Treverorum; suggested as a companion character." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:DavidOfDinant a rpg:Character ;
    rpg:name "David of Dinant" ;
    dc:description "A heretic Paris master whose pantheistic, infernal teachings were discovered in 1215; author of the Quaternuli describing the Infernal Virtue Incantation, who fled the city." ;
    skos:altLabel "David" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:DeathProphecy a rpg:Tag ;
    skos:prefLabel "Death Prophecy" ;
    dc:description "A Major General Virtue placing a supernatural condition on a character's death so that, until met, they cannot die of wounds or old age." ;
    rpg:hasTag amol:Virtue .
amol:Deficiency a rpg:Tag ;
    skos:prefLabel "Deficiency" ;
    dc:description "A Hermetic Flaw imposed when a master opens an apprentice's Arts while having a score below five in an Art; inflicting it is normally a Low Crime." ;
    skos:altLabel "Deficiency Flaw", "Hermetic Deficiency" ;
    rpg:hasTag amol:Flaw .
amol:Delusion a rpg:Tag ;
    skos:prefLabel "Delusion" ;
    dc:description "A Flaw representing false belief; Criamon magi do not have it because their cosmological errors cannot be demonstrated within the game setting." ;
    skos:altLabel "Delusion Flaw" ;
    rpg:hasTag amol:Flaw .
amol:DemonicSteed a rpg:Creature ;
    rpg:name "Demonic Steed" ;
    dc:description "A corrupt beast (Might 7, Animal) appearing as a fearsome black stallion with iron hooves, unimpeded by poor terrain; one of three created by an Infernalist magus using a tainted Steed of Vengeance spell." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Dependant a rpg:Tag ;
    skos:prefLabel "Dependant" ;
    dc:description "A minor Flaw representing someone who depends on the character; can be used as a hostage or leverage to dominate an agent." ;
    skos:altLabel "Dependent" ;
    rpg:hasTag amol:Flaw .
amol:DepictionOfTheWakingDream a rpg:Spell ;
    rpg:name "Depiction of the Waking Dream" ;
    dc:description "An InCrMeIm 35 enchanted effect in the Mirror of Dreams that makes a subject's thoughts visible as images around his head, aiding Mentem lab work." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:DevilChild a rpg:Tag ;
    skos:prefLabel "Devil Child" ;
    dc:description "A type of Mythic Companion created by powerful demons as weapons in the conflict between Heaven and Hell; tragic figures with Hellish powers but free will." ;
    skos:altLabel "Devil Children" ;
    rpg:hasTag amol:Virtue .
amol:DiabolicPast a rpg:Tag ;
    skos:prefLabel "Diabolic Past" ;
    dc:description "A Major Story Flaw in which the character was once associated with diabolists and is still haunted and watched by former associates." ;
    rpg:hasTag amol:Flaw .
amol:DifficultUnderlings a rpg:Tag ;
    skos:prefLabel "Difficult Underlings" ;
    dc:description "A Story Flaw representing a fractured relationship with one's agents; acquired when a non-magus principal recruits an agent of higher social standing, applying to dealings with that agent." ;
    rpg:hasTag amol:Flaw .
amol:Disceptator a rpg:Tag ;
    skos:prefLabel "Disceptator" ;
    dc:description "The chairman and spokesman of a covenant's Council of Members, a rotating mandatory office held by full members serving seven-year terms." ;
    rpg:hasTag amol:CharacterType .
amol:DiscernOwnIllusions a rpg:Spell ;
    rpg:name "Discern Own Illusions" ;
    dc:description "An Intellego Imaginem spell that makes the caster's own illusions appear largely transparent but still discernible." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Disenchant a rpg:Spell ;
    rpg:name "Disenchant" ;
    dc:description "A Perdo Vim ritual that permanently strips a Hermetic magic item of all its powers, destroying its enchantment and invested vis." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:DisguiseOfThePutridAroma a rpg:Spell ;
    rpg:name "Disguise of the Putrid Aroma" ;
    dc:description "A Rego Animal spell (Level 5) that makes a targeted animal take no interest in the caster as long as concentration is maintained." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Dorana a rpg:Character ;
    rpg:name "Dorana" ;
    dc:description "A master maga of House Bonisagus at Fengheld, foremost of the lineage of Irmele filia Trianoma in the Tribunal, who argues for rationality but cannot stand her prima Murion." ;
    skos:altLabel "Dorana of Fengheld", "Dorana, Follower of Bonisagus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:DoubletOfImpenetrableSilk a rpg:Spell ;
    rpg:name "Doublet of Impenetrable Silk" ;
    dc:description "A Muto Animal spell (Level 15) that changes an item of silk, wool, or leather so it cannot be cut or penetrated by weapons, granting a Soak bonus." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Drachenfels a schema:Place ;
    rpg:name "Drachenfels" ;
    dc:description "Dragon's Rock, a famous legendary site (Magic aura 3) with catacombs where the hero Siegfried slew the dragon Fafnir; crowned by Schloss Drachenfels owned by the archbishop of Cologne." ;
    skos:altLabel "Dragon's Rock" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Dripstone a rpg:Item ;
    rpg:name "Dripstone" ;
    dc:description "A brownish wax-feeling enchanted stone (chalcedonius) harvested from Pfalz Island; worn around the neck it lets the wearer perceive illusions, discern truth, and resist the Loreley's song, and is worth 1 pawn of Imaginem vis." ;
    skos:altLabel "Chalcedonius" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:DurenmarLore a rpg:Proficiency ;
    rpg:name "Durenmar Lore" ;
    dc:description "An Ability reflecting a magus' familiarity with the contents of the Great Library, addable to study rolls there with a cumulative penalty." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:Durham a schema:Place ;
    rpg:name "Durham" ;
    dc:description "The site of the cathedral of St. Cuthbert on a high hill in a loop of the river Wear; a palatinate center of pilgrimage and resistance to the Normans." ;
    skos:altLabel "County Durham" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:DustToDust a rpg:Spell ;
    rpg:name "Dust to Dust" ;
    dc:description "A Perdo Corpus spell (Level 15) that turns a dead body or mindless undead to dust in two rounds; does not affect undead possessed by spirits." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:EadricWilde a rpg:Character ;
    rpg:name "Eadric Wilde" ;
    dc:description "A lord who captured and married a faerie woman, becoming famous and being summoned to London by King William Rufus; he lost her when he reproached her about her sisters." ;
    skos:altLabel "Eadric" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:EarthElemental a rpg:Creature ;
    rpg:name "Earth Elemental" ;
    dc:description "An ancient elemental summoned by a now-fallen covenant to tend a cavern rock garden; mourning his lost water-elemental love, he yearly carries an engraved rock outside that yields Aquam and Terram vis." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:EarthShock a rpg:Spell ;
    rpg:name "Earth Shock" ;
    dc:description "A Terram spell that mimics an earthquake, cited as an example where the material cause (earth) determines the Hermetic Form." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:EarthThatBreaksNoMore a rpg:Spell ;
    rpg:name "Earth That Breaks No More" ;
    dc:description "A Muto Terram spell that turns a volume of packed dirt up to ten cubic paces into stone." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Ebroin a rpg:Character ;
    rpg:name "Ebroin" ;
    dc:description "The relatively young current Primus of House Ex Miscellanea, elected after Immanola entered Final Twilight, with ambitions to revitalize the House from Cad Gadu." ;
    skos:altLabel "Primus Ebroin" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:EdwardTheWhiteOfJerbiton a rpg:Character ;
    rpg:name "Edward the White of Jerbiton" ;
    dc:description "A magus skilled in the magic of the sea, famed for unsuccessful attempts to find Atlantis, who leads The Single Ocean league from his enchanted ship." ;
    skos:altLabel "Edward the White" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Elaine a rpg:Character ;
    rpg:name "Elaine" ;
    dc:description "Flambeau's second apprentice, a Frankish girl who became a Hoplite, Archmage, and scholar; she trained four apprentices and authored several enduring books." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:ElementalMagic a rpg:Tag ;
    skos:prefLabel "Elemental Magic" ;
    dc:description "A Major, Hermetic Virtue letting a magus manipulate the elemental Forms (Aquam, Auram, Ignem, Terram) as a connected whole, sharing experience among them." ;
    rpg:hasTag amol:Virtue .
amol:EmbraceOfBoethius a rpg:Spell ;
    rpg:name "Embrace of Boethius" ;
    dc:description "A Perdo Mentem 35 ritual spell that damages a magus's mind, heart, and Gift, forcing reliance on casting tools, used to initiate other Hermetic magi into House Verditius." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Empedocles a rpg:Character ;
    rpg:name "Empedocles" ;
    dc:description "An ancient philosopher whose teaching underlies Criamon thought; the Gorgiastics are named for a student who turned against him, and one Sufi school reveres him as a hierophant." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Empiricus a rpg:Tag ;
    skos:prefLabel "Empiricus" ;
    dc:description "A character specializing in one surgical or medical procedure, often itinerant; a derogatory term used by the literate medical profession for the unlearned." ;
    skos:altLabel "Empirici", "empiric", "empirici" ;
    rpg:hasTag amol:CharacterType .
amol:EmployedByCompany a rpg:Tag ;
    skos:prefLabel "Employed by Company" ;
    dc:description "A minor Story Flaw for salaried employees answerable to an employer but backed by the company's resources; suits characters working primarily for a salary." ;
    skos:altLabel "Employed by a Company" ;
    rpg:hasTag amol:Flaw .
amol:Empty a rpg:Tag ;
    skos:prefLabel "Empty" ;
    dc:description "A Free laboratory Structure Flaw: the lab has a large amount of unused space, costlier to maintain; taken per two points by which Size exceeds occupied Size." ;
    skos:altLabel "Empty Flaw" ;
    rpg:hasTag amol:Flaw .
amol:EnchantCastingTools a rpg:Tag ;
    skos:prefLabel "Enchant Casting Tools" ;
    dc:description "A Minor House Inner Mystery of Verditius allowing a magus to enchant his casting tools to mirror mastered spell effects and grant casting bonuses." ;
    skos:altLabel "Enchant Casting Tools — Minor House Mystery", "Enchanted Casting Tools" ;
    rpg:hasTag amol:Virtue .
amol:Envious a rpg:Tag ;
    skos:prefLabel "Envious" ;
    dc:description "A Major or Minor Personality Flaw in which the character believes others undeservedly have it better and tries to ruin their lives." ;
    rpg:hasTag amol:Flaw .
amol:Eric a rpg:Character ;
    rpg:name "Eric" ;
    dc:description "A reckless magus of House Tytalus and co-founder of Waddenzee, a Danish generalist who favors Aquam and Auram and embraces the pirate lifestyle." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Eunuch a rpg:Tag ;
    skos:prefLabel "Eunuch" ;
    dc:description "A Minor, Social Status Virtue for a sexually incapable male educated to serve Byzantine nobility as courtier, steward, scribe, or accountant." ;
    rpg:hasTag amol:Virtue .
amol:ExperimentalPhilosophy a rpg:Tag ;
    skos:prefLabel "Experimental Philosophy" ;
    dc:description "A system of 'natural' magic that produces wondrous effects through the intrinsic power of the subject rather than any arcane force, using contagion, affinity, similarity, hidden virtues, astrology, ligatures and formulae." ;
    skos:altLabel "empirica", "empiricae", "natural magic" ;
    rpg:hasTag amol:HermeticConcept .
amol:EyeOfHephaestus a rpg:Tag ;
    skos:prefLabel "Eye of Hephaestus" ;
    dc:description "A Minor Supernatural Virtue letting a craftsman innately tell the quality of a manufactured item by touch, including whether it is flawed or magical. Called the Eye of St Dunstan for Christian characters." ;
    skos:altLabel "Eye of St Dunstan", "Eye of St. Dunstan" ;
    rpg:hasTag amol:Virtue .
amol:EyesOfTheBat a rpg:Spell ;
    rpg:name "Eyes of the Bat" ;
    dc:description "A Hermetic spell whose vision is mimicked by the Eyes of the Bat creature Quality, letting a beast see as magi do under that spell." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:EyesOfTheTreacherousTerrain a rpg:Spell ;
    rpg:name "Eyes of the Treacherous Terrain" ;
    dc:description "An Intellego Terram spell that lets the caster intuitively tell if any natural terrain they see is treacherous, such as a rock field prone to sliding." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:FaerieHounds a rpg:Creature ;
    rpg:name "Faerie Hounds" ;
    dc:description "Huge faerie dogs (Might 5, Animal) that haunt the roads of Mythic Europe, terrifying and sometimes killing travelers, often with shining eyes and powers like Enthralling Sound and Fearful Flaming Eyes." ;
    skos:altLabel "faerie dogs" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:FaerieKnight a rpg:Creature ;
    rpg:name "Faerie Knight" ;
    dc:description "Faerie warriors (Might 10, Corpus or Terram) bound to the rules of chivalry, found on lonely roads and guarding bridges, who seek defeat by humans to gain additional combat Pretenses." ;
    skos:altLabel "faerie knights" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:FailedJourneyman a rpg:Tag ;
    skos:prefLabel "Failed Journeyman" ;
    dc:description "A Minor Social Status Flaw for a character expelled from his guild for illegal practices, unable to practice his trade legally, with a bad Reputation of 2 in town." ;
    rpg:hasTag amol:Flaw .
amol:FailedMaster a rpg:Tag ;
    skos:prefLabel "Failed Master" ;
    dc:description "A Minor Social Status Flaw for a character who ran his workshop into the ground and must work as a journeyman, with a bad Reputation of 4 in town." ;
    rpg:hasTag amol:Flaw .
amol:FailedStudent a rpg:Tag ;
    skos:prefLabel "Failed Student" ;
    dc:description "A Minor Story Flaw for a character who studied for a university license but failed the final examination, gaining a Bad Academic Reputation of 2." ;
    rpg:hasTag amol:Flaw .
amol:FalkesDeBreaute a rpg:Character ;
    rpg:name "Falkes de Breaute" ;
    dc:description "A powerful commoner-noble who professes loyalty to the king while disregarding central government; holds custody of the earl of Devon's lands and disputes manors with the earl of Pembroke." ;
    skos:altLabel "Falkes", "Falkes de Bréauté" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:FalsePower a rpg:Tag ;
    skos:prefLabel "False Power" ;
    dc:description "A Major (or repeatable Minor) Supernatural Tainted Flaw in which one of the character's Supernatural Virtues is also associated with the Infernal realm, making it appear unholy." ;
    skos:altLabel "False Power Flaw" ;
    rpg:hasTag amol:Flaw .
amol:FarragoBonisagi a rpg:Character ;
    rpg:name "Farrago Bonisagi" ;
    dc:description "A maga of House Bonisagus in the late 1000s who joined House Merinita to research faerie powers and discovered the three faerie cords (leaden, iron, and tin) for binding faerie familiars." ;
    skos:altLabel "Farrago" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Felicia a rpg:Character ;
    rpg:name "Felicia" ;
    dc:description "A freshly Gauntleted journeyman maga, filia of Dorana of Fengheld and a descendant of Trianoma in the lineage of Irmele, who works weather magic and travels the Tribunal." ;
    skos:altLabel "Felecia", "follower of Bonisagus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Fenicil a rpg:Character ;
    rpg:name "Fenicil" ;
    dc:description "The Primus of House Guernicus and the Order's most famous historian, who claimed the tradition of magic was eternal and reputedly rediscovered some lost Mercurian rituals." ;
    skos:altLabel "Primus Fenicil of Guernicus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Fenistour a rpg:Character ;
    rpg:name "Fenistour" ;
    dc:description "A figure who invented casting tools allowing Verditius magi to cast Formulaic spells; her filii later developed methods of enchanting those tools." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:FerramentumOfVerditius a rpg:Character ;
    rpg:name "Ferramentum of Verditius" ;
    dc:description "A magus of House Verditius whose wizard's sigil makes his spells very orderly, seen in his versions of The Cloudless Sky Returned and Curse of the Rotted Wood." ;
    skos:altLabel "Ferramentum" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:FickleNature a rpg:Tag ;
    skos:prefLabel "Fickle Nature" ;
    dc:description "A Minor Personality Flaw causing the character to swing between two directly opposite personality behaviors with no middle ground." ;
    rpg:hasTag amol:Flaw .
amol:FidaI a rpg:Tag ;
    skos:prefLabel "Fidaʾi" ;
    dc:description "A Minor, Social Status Virtue for an assassin of the Nizari Isma'ilis trained in daggers and disguise, prepared to die on the sect's orders." ;
    rpg:hasTag amol:Virtue .
amol:FimusWarriorDemon a rpg:Creature ;
    rpg:name "Fimus, Warrior Demon" ;
    dc:description "A warrior demon (Might 10, Terram) made of solid rock with one eye, controlling earth and exploding on death; one of many identical brother-demons used as foot-soldiers by other demons." ;
    skos:altLabel "Fimus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:FlashOfTheScarletFlames a rpg:Spell ;
    rpg:name "Flash of the Scarlet Flames" ;
    dc:description "A Creo Ignem spell that explodes a brilliant red flash in the air, able to temporarily or permanently blind a target who fails a Stamina roll; Rose of Jerbiton's version smells of roses." ;
    skos:altLabel "CrIg 15" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Florence a schema:Place ;
    rpg:name "Florence" ;
    dc:description "A great Italian city founded by Julius Caesar in 59 BC, with a developed cloth and banking industry, dominated by noble tower societies and the feud between the Guelphs and Ghibellines." ;
    skos:altLabel "Florentia" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:FluctuatingFortune a rpg:Tag ;
    skos:prefLabel "Fluctuating Fortune" ;
    dc:description "A Minor Supernatural Flaw in which the character alternates yearly between the Wealthy Virtue and the Poor Flaw in opposition to his needs." ;
    rpg:hasTag amol:Flaw .
amol:FocusPower a rpg:Tag ;
    skos:prefLabel "Focus Power" ;
    dc:description "A Major, Supernatural Virtue granting a supernatural power with a narrow range of effects, like a magical focus, with a 25-point pool for effect level and Penetration." ;
    rpg:hasTag amol:Virtue .
amol:FolkMagic a rpg:Tag ;
    skos:prefLabel "Folk Magic" ;
    dc:description "A Minor, Supernatural Virtue allowing minor magic via a chosen (Realm) Lore in one of four areas: Abjuration, Divination, Healing, or Evil Eye." ;
    rpg:hasTag amol:Virtue .
amol:FollowersOfPendule a rpg:Faction ;
    rpg:name "Followers of Pendule" ;
    dc:description "A House Merinita lineage and Mystery Cult descended from Pendule's followers who Initiate the illusion Mysteries of Spell Timing, Glamour, and Perpetuity." ;
    skos:altLabel "Pendule Merinitae", "Pendule's followers" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:FontOfKnowledge a rpg:Tag ;
    skos:prefLabel "Font of Knowledge" ;
    dc:description "A Supernatural Ability allowing a creature to attempt a task with any untrained ability as if it had a score of 2 by succeeding in an Ability check." ;
    rpg:hasTag amol:Virtue .
amol:FootstepsOfSlipperyOil a rpg:Spell ;
    rpg:name "Footsteps of Slippery Oil" ;
    dc:description "A Creo Aquam spell (Level 5) creating nonflammable grease from the caster's footsteps, leaving a slick area that forces Dexterity rolls." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ForeignUpbringing a rpg:Tag ;
    skos:prefLabel "Foreign Upbringing" ;
    dc:description "A Minor Personality Flaw marking the character as a foreigner from a remote corner of Mythic Europe with odd customs and a foreign Native Language." ;
    rpg:hasTag amol:Flaw .
amol:FountainsAbbey a schema:Place ;
    rpg:name "Fountains Abbey" ;
    dc:description "A great Cistercian abbey in Yorkshire, founded in 1132 by monks from York and a daughter house of Clairvaux, motherhouse of a wide filiation." ;
    skos:altLabel "Fountains" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Freiburg a schema:Place ;
    rpg:name "Freiburg" ;
    dc:description "The largest settlement around the Black Forest, founded in 1120 by Conrad Zähringen, lying in the valley of the River Dreisam with a cathedral under construction." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:FrightfulPresence a rpg:Tag ;
    skos:prefLabel "Frightful Presence" ;
    dc:description "A Minor, Supernatural Virtue letting a character instill dread or awe, forcing witnesses to make Brave Personality rolls." ;
    rpg:hasTag amol:Virtue .
amol:Galen a rpg:Character ;
    rpg:name "Galen" ;
    dc:description "The ancient authority on medicine since whom chirurgy has held a less prestigious position; quoted on the distinction between knowledge by experience and by reason." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Garus a rpg:Character ;
    rpg:name "Garus" ;
    dc:description "The current Primus of House Flambeau in 1220, an aging former soldier-of-fortune and tournament champion who leads the milites and authored the Code of Garus." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:GatherTheEssenceOfTheBeast a rpg:Spell ;
    rpg:name "Gather the Essence of the Beast" ;
    dc:description "A Touch-range, Momentary Vim spell that concentrates the raw vis in a corpse into one removable part, letting a magus gather vis without carrying entire corpses." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:GenderShift a rpg:Tag ;
    skos:prefLabel "Gender Shift" ;
    dc:description "A Minor, Supernatural Virtue letting a character change genders each midnight, with consistent male and female forms." ;
    rpg:hasTag amol:Virtue .
amol:Generous a rpg:Tag ;
    skos:prefLabel "Generous" ;
    dc:description "A Major or Minor Personality Flaw in which the character willingly gives away property to anyone who desires it." ;
    rpg:hasTag amol:Flaw .
amol:GeniusLocus a rpg:Tag ;
    skos:prefLabel "Genius Locus" ;
    dc:description "A spirit embodying and protecting a particular forest, formed from the fragmentation of the great Hercynian Forest spirit; each has a Might score, Personality Traits, and Special Powers." ;
    skos:altLabel "forest spirit", "forest spirits", "genii loci", "spirit of place", "the genius of the House" ;
    rpg:hasTag amol:HermeticConcept .
amol:Genoa a schema:Place ;
    rpg:name "Genoa" ;
    dc:description "A north Italian city-state whose merchants rival Venice's and who have seeded the East with trading colonies that act as resupply points and friendly wartime ports." ;
    skos:altLabel "Genoans", "Genoese" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:GentleTouchOfThePurifiedBody a rpg:Spell ;
    rpg:name "Gentle Touch of the Purified Body" ;
    dc:description "A Corpus spell that, under these rules, heals a Minor disease instead of a Light Wound caused by disease." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:GillesDeCorbeil a rpg:Character ;
    rpg:name "Gilles de Corbeil" ;
    dc:description "An 80-year-old master physician and archiater (chief physician) to King Philip Augustus of France, born in northern France in 1140, who trained at Salerno under Petrus Musandinus and wrote famous summae on urine and the pulse in hexameter verse." ;
    skos:altLabel "Aegidius Corboliensis" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Gorlois a rpg:Character ;
    rpg:name "Gorlois" ;
    dc:description "Lord whose stronghold was Tintagel and whose wife Ygerna Uther Pendragon desired; Uther was magically disguised as him to father Arthur." ;
    skos:altLabel "Duke Gorlois of Cornwall" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:GreatCommunication a rpg:Tag ;
    skos:prefLabel "Great Communication" ;
    dc:description "A Virtue held by Brogo giving him exceptional Communication, contributing to his songs' Aesthetic Quality." ;
    rpg:hasTag amol:Virtue .
amol:GreatLezi a rpg:Creature ;
    rpg:name "Great Lezi" ;
    dc:description "A powerful faerie (Might 40, Herbam) of Slavic lands appearing as a tall pale bearded man who commands woodland animals and can change into any plant or animal and vary its size enormously." ;
    skos:altLabel "Forest Lord", "Lezi" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:GreatPresence a rpg:Tag ;
    skos:prefLabel "Great Presence" ;
    dc:description "A Virtue boosting a character's Presence Characteristic; one of Falke's Virtues." ;
    rpg:hasTag amol:Virtue .
amol:GreaterBenediction a rpg:Tag ;
    skos:prefLabel "Greater Benediction" ;
    dc:description "A Major, Supernatural Virtue granting a major blessing from a supernatural power, with examples such as Flight, True Sight, and Universally Liked." ;
    rpg:hasTag amol:Virtue .
amol:GreaterPower a rpg:Tag ;
    skos:prefLabel "Greater Power" ;
    dc:description "A Major, Supernatural Virtue granting an at-will supernatural power equivalent to a Formulaic Hermetic spell of level 50 or lower." ;
    rpg:hasTag amol:Virtue .
amol:GreekFire a rpg:Item ;
    rpg:name "Greek Fire" ;
    dc:description "A sticky, flammable substance that cannot be extinguished by water, used by the Byzantine navy from siphons and catapult pots to incinerate enemy vessels; its manufacture is a closely guarded secret." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:Gremlins a rpg:Creature ;
    rpg:name "Gremlins" ;
    dc:description "A Minor laboratory Supernatural Flaw: the lab is home to deliberately disruptive creatures, spirits, or demons (-3 Safety, +1 Warping, -1 Aesthetics)." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Griffin a rpg:Creature ;
    rpg:name "Griffin" ;
    dc:description "A famous legendary chimera; also a Mythic Blood lineage granting the Panic of the Elephant's Mouse feat and a Focus in Courage." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:GripOfTheChokingHand a rpg:Spell ;
    rpg:name "Grip of the Choking Hand" ;
    dc:description "A Perdo Corpus spell (Level 25) that makes the target feel an invisible strangling hand on the throat, losing a Fatigue level each round." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Grudge a rpg:Tag ;
    skos:prefLabel "Grudge" ;
    dc:description "A Minor Personality Flaw in which the character holds a strong grudge against someone in his normal social circle and seeks to outdo them." ;
    rpg:hasTag amol:Flaw .
amol:GuardianAngel a rpg:Tag ;
    skos:prefLabel "Guardian Angel" ;
    dc:description "A Major, General Virtue giving a character a divine watcher who offers spiritual advice and can grant +5 Soak and Magic Resistance 15." ;
    rpg:hasTag amol:Virtue .
amol:GuardianOfNature a rpg:Tag ;
    skos:prefLabel "Guardian of Nature" ;
    dc:description "A Mystery (Virtue) a Vestal may learn at her second level of Initiation, joining her spirit with a Faerie aura while she remains a virgin to become a civic deity." ;
    rpg:hasTag amol:Virtue .
amol:GuardiansOfTheForestRuling a rpg:Tag ;
    skos:prefLabel "Guardians of the Forest ruling" ;
    dc:description "A landmark Rhine Tribunal ruling of 1053 permitting magi to actively defend wilderness areas; cited in disputes over Crintera's defense of Rugen." ;
    rpg:hasTag amol:HermeticConcept .
amol:Gubich a rpg:Creature ;
    rpg:name "Gubich" ;
    dc:description "A morose dwarflike spirit of the Harz who dwells in moss-covered caves, can control the weather, and sometimes leads travelers astray; possibly the dwarf king." ;
    skos:altLabel "Gübich" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:GudrunTigurina a rpg:Character ;
    rpg:name "Gudrun Tigurina" ;
    dc:description "A Verditius maga at Durenmar known as the inventor of the Crystal Custodian." ;
    skos:altLabel "Gudrun Tigurina of Verditius" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:GuestOfHouseCriamon a rpg:Tag ;
    skos:prefLabel "Guest of House Criamon" ;
    dc:description "A Minor, Hermetic Virtue making a magus a political member of House Criamon while being created with another House's rules." ;
    rpg:hasTag amol:Virtue .
amol:GuildApprentice a rpg:Tag ;
    skos:prefLabel "Guild Apprentice" ;
    dc:description "A Minor, Social Status Virtue for a youth aged 10 to 20 learning a trade from a guild master or journeyman under contract." ;
    rpg:hasTag amol:Virtue .
amol:GuildDean a rpg:Tag ;
    skos:prefLabel "Guild Dean" ;
    dc:description "A Major Social Status Virtue for the ultimate authority of a guild who decides important guild matters and represents it politically." ;
    rpg:hasTag amol:Virtue .
amol:GuildMaster a rpg:Tag ;
    skos:prefLabel "Guild Master" ;
    dc:description "A Minor Social Status Virtue for a guild master who may legally practice his trade, hire journeymen, and participate in guild activities." ;
    rpg:hasTag amol:Virtue .
amol:Gullible a rpg:Tag ;
    skos:prefLabel "Gullible" ;
    dc:description "A Minor Personality Flaw giving a -3 penalty on Guile or Perception rolls to determine truth, from the character's isolation and inexperience." ;
    rpg:hasTag amol:Flaw .
amol:Gunther a rpg:Character ;
    rpg:name "Gunther" ;
    dc:description "The Burgundian king of Worms in the Nibelungenlied, who marries Brünhild with Siegfried's help and is later beheaded by Kriemhild in Hungary." ;
    skos:altLabel "King Gunther" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:GuntherLupus a rpg:Character ;
    rpg:name "Gunther Lupus" ;
    dc:description "A magus of House Bjornaer, filius of Eule, with the heartbeast of a wolf; he perpetuates the fraud of Eule's wisdom and forms a team with the hoplite Indulius hunting oath-breakers." ;
    skos:altLabel "Günther", "Günther Lupus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:GwrhyrExMiscellanea a rpg:Character ;
    rpg:name "Gwrhyr Ex Miscellanea" ;
    dc:description "An old, blustering Columbine magus who owns the Cad Gadu island, holds a seat on the Council of Four, and whose death threatens the covenant's land tenure." ;
    skos:altLabel "Gwhyr", "Gwrhyr" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Gyongy a rpg:Character ;
    rpg:name "Gyongy" ;
    dc:description "A sorceress and former fellow of Bjornaer's shapeshifting tradition who condemned Bjornaer for joining the new Order of Hermes." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:HandsOfTheGraspingEarth a rpg:Spell ;
    rpg:name "Hands of the Grasping Earth" ;
    dc:description "A Rego Terram spell where earthen hands rise from the ground to grasp the target's ankles, requiring a Strength roll to break free." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:HeartbeastAbility a rpg:Proficiency ;
    rpg:name "Heartbeast (Ability)" ;
    dc:description "The Bjornaer Ability gained alongside the Heartbeast Virtue, scoring the strength of the transformation and added to Lab Totals for Sensory Magic." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:HeatOfTheSearingForge a rpg:Spell ;
    rpg:name "Heat of the Searing Forge" ;
    dc:description "A Creo Ignem spell (Level 10) that heats a piece of metal too hot to touch, doing decreasing damage over rounds to anyone in skin contact with it." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Hedyosmos a rpg:Faction ;
    rpg:name "Hedyosmos" ;
    dc:description "A covenant in the Theban Tribunal built in a labyrinth of caves of increasing Magic aura, rumored to hold a gateway to the Magic Realm or Underworld, whose magi are famed for magic of earth, the dead, and curses." ;
    skos:altLabel "Hedvosmos" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:Heir a rpg:Tag ;
    skos:prefLabel "Heir" ;
    dc:description "A Minor Story Flaw in which the character stands to inherit land and money, but others may try to remove him from the line of succession." ;
    rpg:hasTag amol:Virtue .
amol:Helvius a rpg:Character ;
    rpg:name "Helvius" ;
    dc:description "A paranoid magus of House Tremere specializing in ice magics who resides in an underground cavern lab by an underground lake." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:HenryII a rpg:Character ;
    rpg:name "Henry II" ;
    dc:description "A former king of England whose reign featured William Marshal's early career, the Henry of Essex duel, and afforestations later restricted by the Charter of the Forest." ;
    skos:altLabel "Henry Plantagenet" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:HenryTheLion a rpg:Character ;
    rpg:name "Henry the Lion" ;
    dc:description "The greatest Welf ruler in living memory, duke of both Saxony and Bavaria, stripped of most estates by Frederick Barbarossa; he beautified Brunswick." ;
    skos:altLabel "Heinrich der Löwe" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Hephaestion a rpg:Character ;
    rpg:name "Hephaestion" ;
    dc:description "An example Verditius magus, five years out of apprenticeship, used to illustrate enchanting casting tools for the spell The Crystal Dart." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Herbalism a rpg:Proficiency ;
    rpg:name "Herbalism" ;
    dc:description "A unique General Ability granted by the Herbalism Virtue that substitutes for Medicine in diagnosis, prognosis, and disease recovery, allowing cure of diseases without formal medical training." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:Herbwife a rpg:Tag ;
    skos:prefLabel "Herbwife" ;
    dc:description "The poor man's answer to the apothecary; usually a woman who maintains a village's health with preserved garden products and often acts as local midwife." ;
    skos:altLabel "herbalist", "herbman" ;
    rpg:hasTag amol:CharacterType .
amol:HercynianForest a schema:Place ;
    rpg:name "Hercynian Forest" ;
    dc:description "The vast primeval forest of Germany described by Caesar and Pliny; its single powerful spirit was fragmented by the Cult of Mercury and St. Boniface into many genii loci." ;
    skos:altLabel "Hercynian oak forest", "the Forest" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:HermeticArts a rpg:Tag ;
    skos:prefLabel "Hermetic Arts" ;
    dc:description "The fifteen Techniques and Forms of Hermetic magic, which can be opened in a character with The Gift and advanced through study from vis, books, or teaching but not by simple practice." ;
    skos:altLabel "Arts", "Hermetic Enchantments", "the Arts" ;
    rpg:hasTag amol:HermeticConcept .
amol:HermeticHaruspexes a rpg:Faction ;
    rpg:name "Hermetic Haruspexes" ;
    dc:description "An ancient Roman tradition of House Ex Miscellanea who reveal omens by inspecting entrails of sacrificed animals; produced Primi Basilicus and Immanola." ;
    skos:altLabel "Haruspexes", "The Etruscan Art" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:HermeticPrestige a rpg:Tag ;
    skos:prefLabel "Hermetic Prestige" ;
    dc:description "A Virtue granting a magus a Hermetic Reputation; the free benefit of House Guernicus and taken by Darius to reflect his standing in the Order." ;
    rpg:hasTag amol:Virtue .
amol:HiddenDefect a rpg:Tag ;
    skos:prefLabel "Hidden Defect" ;
    dc:description "A laboratory Flaw that may be gained on a botched Refinement roll or spotted and corrected on a sufficiently good roll while increasing Refinement." ;
    skos:altLabel "Hidden Defect Flaw" ;
    rpg:hasTag amol:Flaw .
amol:HiddenShape a rpg:Tag ;
    skos:prefLabel "Hidden Shape" ;
    dc:description "An aspect of the heartbeast whereby, due to the Limit of Essential Nature, a transformed Bjornaer appears as a mundane animal to magic." ;
    rpg:hasTag amol:HermeticConcept .
amol:HighlyOrganized a rpg:Tag ;
    skos:prefLabel "Highly Organized" ;
    dc:description "A Free laboratory Outfittings Virtue: the lab's contents are optimally arranged (+1 General Quality); gained by improving Refinement and lost in major accidents." ;
    skos:altLabel "Highly Organized Virtue" ;
    rpg:hasTag amol:Virtue .
amol:Hildesheim a schema:Place ;
    rpg:name "Hildesheim" ;
    dc:description "A splendid cathedral city of northern Germany famed for its civic buildings and churches, raised to greatness by St. Bernward, whose crypt lies in St. Michael's church." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:HiminisTheMad a rpg:Character ;
    rpg:name "Himinis the Mad" ;
    dc:description "An 11th-century Verditius magus who developed the Inner Mystery of making cursed items and founded the Confraternity of Himinis the Mad." ;
    skos:altLabel "Himinis" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Hippocrates a rpg:Character ;
    rpg:name "Hippocrates" ;
    dc:description "The ancient physician associated with naming epilepsy the 'sacred disease' (the Falling Evil)." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:HiptaTheNurse a rpg:Creature ;
    rpg:name "Hipta the Nurse" ;
    dc:description "A powerful shapechanger Daimon (Magic Might 15, Animal), the nurse of Dionysus, who favors the form of a dove and is invoked for forgiveness from curses and magical harm." ;
    skos:altLabel "Hipta" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:HolyMagic a rpg:Proficiency ;
    rpg:name "Holy Magic" ;
    dc:description "The Major non-Hermetic Virtue of the Karaites tradition, drawing power directly from the Divine." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:Holzfrau a rpg:Creature ;
    rpg:name "Holzfrau" ;
    dc:description "German wood-wife faeries with Faerie Might 20, spirits of vegetation usually beneficial to mankind, able to control plants and heal; associated with particular plants like dryads." ;
    skos:altLabel "Holzfrauen", "wood-wife", "wood-wives" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Honos a rpg:Creature ;
    rpg:name "Honos" ;
    dc:description "A Roman Daimon (Magic Might 30, Corpus) of morality and military honor, appearing as a young warrior with a lance and cornucopia, able to instill Leadership and produce a magical feast." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Horsingas a rpg:Faction ;
    rpg:name "Horsingas" ;
    dc:description "A covenant in the Loch Leglean Tribunal founded by Saxon magi determined to oppose the Normans, using Mentem magic to cover their tracks." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:Hospitallers a rpg:Faction ;
    rpg:name "Hospitallers" ;
    dc:description "A crusading military order referenced alongside the Templars whose brother knights wear white surcoats." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:HouseAcclaim a rpg:Tag ;
    skos:prefLabel "House Acclaim" ;
    dc:description "An informal Hermetic Reputation system by which Flambeau magi measure relative prestige, gained for deeds of valor and lost for ignoble acts or inactivity." ;
    rpg:hasTag amol:HermeticConcept .
amol:HouseBjornaerLore a rpg:Proficiency ;
    rpg:name "House Bjornaer Lore" ;
    dc:description "The Organization Lore Ability giving knowledge of House Bjornaer's legends, history, structure, magics, and its Exoteric Mystery and Cult of Ancestors; primarily orally transmitted." ;
    skos:altLabel "House Bjornaer Lore (Arcane)", "House Lore" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:HousesOfHermesMysteryCults a rpg:Tag ;
    skos:prefLabel "Houses of Hermes: Mystery Cults" ;
    dc:description "The sourcebook covering the four magical Houses built around specific Mysteries (Bjornaer, Criamon, Merinita, Verditius)." ;
    rpg:hasTag amol:HermeticConcept .
amol:HousesOfHermesSocietates a rpg:Item ;
    rpg:name "Houses of Hermes: Societates" ;
    dc:description "An Ars Magica sourcebook whose Tytalus chapter details House Tytalus' debate system." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:HubertDeBurgh a rpg:Character ;
    rpg:name "Hubert de Burgh" ;
    dc:description "The justiciar (since 1215) and third member of the regency, responsible for day-to-day administration; an astute politician and brave military leader who defended Dover and won the sea battle against Eustace." ;
    skos:altLabel "Hubert", "the Justiciar", "the justiciar" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:HuntForTheWildHerb a rpg:Spell ;
    rpg:name "Hunt for the Wild Herb" ;
    dc:description "An Intellego Herbam spell (Level 5) that lets you smell one sort of plant and follow its scent, requiring a sample of that plant." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Iacob a rpg:Character ;
    rpg:name "Iacob" ;
    dc:description "The most politically active magus of Irencillia, leader of the Elder Gild and apprentice of Handri; a master of Mentem magics running a secret project to establish a fae religion, identified as the Prophet of the God of Truth by his white crow caricature Nestor." ;
    skos:altLabel "Iacob filius Handri", "the Prophet Iacob" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:IberianTribunal a rpg:Faction ;
    rpg:name "Iberian Tribunal" ;
    dc:description "A Tribunal of the Order of Hermes where the Keepers of the Thousand Tales maintain dedicated covenants." ;
    skos:altLabel "Iberian" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Tribunal .
amol:IciliusTheTraitor a rpg:Character ;
    rpg:name "Icilius the Traitor" ;
    dc:description "A 12th-century Verditius magus of the Normandy Tribunal who released the Inner Mystery Automata to the Order of Hermes and was hunted down and slain by Wizard's War." ;
    skos:altLabel "Icilius" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:IllusionOfCoolFlames a rpg:Spell ;
    rpg:name "Illusion of Cool Flames" ;
    dc:description "A Perdo Imaginem spell (Level 10) that makes a source of heat seem to lose its heat and drop to surrounding temperature, while it still has its normal beneficial and harmful effects." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:IllusionOfTheMisplacedCastle a rpg:Spell ;
    rpg:name "Illusion of the Misplaced Castle" ;
    dc:description "A Rego Imaginem ritual (Level 50) that moves the image of any bounded structure the size of a castle or less up to one mile from its actual position." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:IllusionOfTheShiftedImage a rpg:Spell ;
    rpg:name "Illusion of the Shifted Image" ;
    dc:description "A Rego Imaginem spell (Level 10) that makes any person or object appear a pace away from its actual position; the spell ends as soon as the original or image moves." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ImagePhantom a rpg:Spell ;
    rpg:name "Image Phantom" ;
    dc:description "A Muto Imaginem spell (Level 20) that makes any one thing, including a living thing, appear as something else of approximately the same shape and size." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ImageOfTheBeast a rpg:Spell ;
    rpg:name "Image of the Beast" ;
    dc:description "An Intellego Animal spell (Level 5) that gives a hazy mental image of an animal to which the caster has an Arcane Connection, useful for identifying an attacker." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Incantation a rpg:Proficiency ;
    rpg:name "Incantation" ;
    dc:description "An Infernal Supernatural Ability granting the Unholy Method: Incantation, described in David of Dinant's heretical book Quaternuli with a Quality of 13." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:Incomprehensible a rpg:Tag ;
    skos:prefLabel "Incomprehensible" ;
    dc:description "A Minor General Flaw in which the character is almost unable to convey knowledge, halving the Advancement or Lab Total of anyone learning from him or his books." ;
    rpg:hasTag amol:Flaw .
amol:InconstantMagic a rpg:Tag ;
    skos:prefLabel "Inconstant Magic" ;
    dc:description "A Minor Hermetic Flaw making the character's magic easily distracted and unresponsive, interrupting constant magic-item effects at sunrise and sunset and imposing a Finesse penalty." ;
    rpg:hasTag amol:Flaw .
amol:IndependentStudy a rpg:Tag ;
    skos:prefLabel "Independent Study" ;
    dc:description "A Minor General Virtue letting a character develop new skills extremely quickly on his own, adding bonuses to Practice and Adventure Source Quality." ;
    rpg:hasTag amol:Virtue .
amol:Induction a rpg:Tag ;
    skos:prefLabel "Induction" ;
    dc:description "A Major, Supernatural Virtue granting the power to make people experience things that are not there, conferring the Induction Ability at 1." ;
    rpg:hasTag amol:Virtue .
amol:Indulius a rpg:Character ;
    rpg:name "Indulius" ;
    dc:description "A magus of Fengheld and master of Richenda Spinosa, whose bungling scarred her Gift and left her unable to use fire magic." ;
    skos:altLabel "Indulius follower of Flambeau", "Indulius of Fengheld", "Indulius of Flambeau" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Ingasia a rpg:Faction ;
    rpg:name "Ingasia" ;
    dc:description "A covenant in the Theban Tribunal of which Verditius Primus Stouritus is a member and which he would like to become the domus magna." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:InkOfHermes a rpg:Item ;
    rpg:name "Ink of Hermes" ;
    dc:description "An alchemical ink mentioned in many alchemical texts, made from myrrh, Karian figs, Nikolaus dates, pine cones, wormwood, wings of the Hermaic ibis, and spring water." ;
    skos:altLabel "Hermaic Ink" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:InscribedShadow a rpg:Tag ;
    skos:prefLabel "Inscribed Shadow" ;
    dc:description "A Minor Supernatural Flaw causing a character's stigmata to be reflected as glowing symbols in their shadow, alarming nonmagicians and easing stigma-reading." ;
    rpg:hasTag amol:Flaw .
amol:Inspirato a rpg:Tag ;
    skos:prefLabel "Inspirato" ;
    dc:description "The flux of harmony and strife from which spiritually nourished Criamon magi draw sustenance instead of food, and through which path-of-seeming magi swim to view distant places." ;
    skos:altLabel "the Inspirato's flux" ;
    rpg:hasTag amol:HermeticConcept .
amol:Intuition a rpg:Tag ;
    skos:prefLabel "Intuition" ;
    dc:description "A Minor, General Virtue giving a natural sensitivity to make the right luck-based decisions on a secret die roll of 6+." ;
    rpg:hasTag amol:Virtue .
amol:InventiveGenius a rpg:Tag ;
    skos:prefLabel "Inventive Genius" ;
    dc:description "A laboratory Virtue that, when held by an assistant or researcher, applies to the primary researcher's efforts; it also adds three to insight-investigation rolls." ;
    rpg:hasTag amol:Virtue .
amol:InvestedDevice a rpg:Item ;
    rpg:name "Invested Device" ;
    dc:description "An enchanted item prepared with Vim vis and then instilled with magical effects in the laboratory; variants include lesser enchanted devices and charged items, and an invested device lasts years as an Arcane Connection." ;
    skos:altLabel "Charged Items", "Invested Items", "Lesser Enchanted Device" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:Ipswich a schema:Place ;
    rpg:name "Ipswich" ;
    dc:description "The chief town of Suffolk with about 300 burgesses, granted a charter in 1200 by King John giving it a court, toll exemption, and a merchant guild monopoly on milling." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Irmele a rpg:Character ;
    rpg:name "Irmele" ;
    dc:description "The third filia of Trianoma, a tempestaria who recruited in German lands and founded the wandering weathermage lineage that still persists in the Rhine." ;
    skos:altLabel "Irmele filia Trianoma" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Isaac a rpg:Character ;
    rpg:name "Isaac" ;
    dc:description "A Jewish shopkeeper, nephew of David ben David, who runs the wine shop in Trier above the former Treverorum covenant and knows nothing of magi." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:ItemAttunement a rpg:Tag ;
    skos:prefLabel "Item Attunement" ;
    dc:description "A Major House Mystery letting a magus attune a greater enchanted item like a talisman, then sever the connection, leaving a Covet Device personality trait in the device." ;
    skos:altLabel "attuned items" ;
    rpg:hasTag amol:Virtue .
amol:JesusChrist a rpg:Character ;
    rpg:name "Jesus Christ" ;
    dc:description "The Son of God who became human, whose death (the Crucifixion) paid the penalty for all human sins and who rose from the dead in the Resurrection; in the Mass the bread and wine become His Body and Blood." ;
    skos:altLabel "Christ", "the Son" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:JohnOfSalisbury a rpg:Character ;
    rpg:name "John of Salisbury" ;
    dc:description "A clergyman and author of the Policraticus, the standout text on politics distinguishing a prince from a tyrant." ;
    skos:altLabel "John" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:JudgedUnfairly a rpg:Tag ;
    skos:prefLabel "Judged Unfairly" ;
    dc:description "A Minor General Flaw in which people universally distrust and underestimate the character, preventing him from gaining a positive Reputation." ;
    rpg:hasTag amol:Flaw .
amol:JuliastaFiliaCriamon a rpg:Character ;
    rpg:name "Juliasta filia Criamon" ;
    dc:description "Criamon's successor as Primus and the first follower of the Winding Path; she shared the House's knowledge with outsiders and prepared the House for its journey." ;
    skos:altLabel "Juliasta" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:JumaylAJinniGuide a rpg:Creature ;
    rpg:name "Jumayl, A Jinni Guide" ;
    dc:description "A faerie jinni of the jann (Might 15, Vim), a mercenary caravan guide wandering the Levant and beyond, able to change into a white Bactrian camel and susceptible to mundane alcohol." ;
    skos:altLabel "Jumayl", "little camel" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Jurist a rpg:Tag ;
    skos:prefLabel "Jurist" ;
    dc:description "A Minor Social Status Virtue for a character who is a judge, advocate, or procurator, able to purchase Latin, Artes Liberales, and Civil and Canon Law." ;
    rpg:hasTag amol:Virtue .
amol:Kalliste a rpg:Character ;
    rpg:name "Kalliste" ;
    dc:description "Filia of Tasgillia who exposed her mater's diabolism and became the fifth Prima of House Tytalus; Tytali regard her exposure of Tasgillia as the \"Betrayal\" of the Founder's principles." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Karaites a rpg:Faction ;
    rpg:name "Karaites" ;
    dc:description "A tradition of Karaite Jews with The Gift who practice Holy Magic and may join the Order so long as their magic comes directly from God." ;
    skos:altLabel "Karaism", "Karaite" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Karlotte a rpg:Character ;
    rpg:name "Karlotte" ;
    dc:description "Red-haired daughter and heir of Baron Schonburg with strong faerie blood; she lies in a coma after being attacked, and the fae of the Court of Dark Summer hold her cure." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:KlosterMariaLaach a schema:Place ;
    rpg:name "Kloster Maria Laach" ;
    dc:description "A Benedictine monastery beside Laach Lake founded in 1093, with a Divine aura of 4 and a paradise-like gardened courtyard re-creating the Garden of Eden." ;
    skos:altLabel "Maria Laach" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:KnightsOfTheSword a rpg:Faction ;
    rpg:name "Knights of the Sword" ;
    dc:description "A military order founded in 1202 by Albert von Buxhövden, bishop of Riga, to crusade against pagan tribes; based at Fellin in Livonia and active in Pomerania, they control the slave trade and are notoriously brutal." ;
    skos:altLabel "Livonian Order" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Koblenz a schema:Place ;
    rpg:name "Koblenz" ;
    dc:description "A fair-sized city where the Mosel joins the Rhine, owned by the archbishops of Trier; home to St. Kastor church and a Teutonic Knights chapter house." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:KolazontaTheChastiser a rpg:Creature ;
    rpg:name "Kolazonta, the Chastiser" ;
    dc:description "A Divine angel (Might 30, Ignem) tasked to chastise the faithful for their failings, appearing as a dark cloud or man of white fire; he brought the plague upon the Israelites for rebelling against Moses." ;
    skos:altLabel "Kolazonta" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Kolkrabus a rpg:Character ;
    rpg:name "Kolkrabus" ;
    dc:description "The devious raven familiar of Murion that spied at Crintera and taunts Stentorius, believing he has usurped Murion's role as leader of the Oak Gild." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Kriemhild a rpg:Character ;
    rpg:name "Kriemhild" ;
    dc:description "Sister of King Gunther and wife of Siegfried in the Nibelungenlied, who avenges Siegfried's murder by orchestrating the deaths of Gunther and Hagen." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Laborer a rpg:Tag ;
    skos:prefLabel "Laborer" ;
    dc:description "A free Social Status Virtue for a trained worker who provides a valuable service without producing a finished good, using a Profession Ability rather than a Craft." ;
    rpg:hasTag amol:Virtue .
amol:Larta a rpg:Tag ;
    skos:prefLabel "Larta" ;
    dc:description "A category of unGifted person afforded protection and tutelage by a Hermetic House; Hildegard of Bingen is cited as a Larta maga of House Jerbiton." ;
    rpg:hasTag amol:CharacterType .
amol:Lasiq a rpg:Tag ;
    skos:prefLabel "Lasiq" ;
    dc:description "A Major, Social Status Virtue for an experienced Nizari Isma'ili assassin who has completed seven murders and commands a small band of fida'is." ;
    skos:altLabel "lasig" ;
    rpg:hasTag amol:Virtue .
amol:LatentMagicAbility a rpg:Tag ;
    skos:prefLabel "Latent Magic Ability" ;
    dc:description "A Minor, General Virtue indicating an unmanifested magical quality, more limited than The Gift, that may appear spontaneously." ;
    rpg:hasTag amol:Virtue .
amol:LatentMagicalAbility a rpg:Tag ;
    skos:prefLabel "Latent Magical Ability" ;
    dc:description "A Virtue granting uncontrolled magical talent; Torven's Latent Magical Ability causes wolf packs to come to his aid in the forest." ;
    rpg:hasTag amol:Virtue .
amol:LatinEmpire a rpg:Faction ;
    rpg:name "Latin Empire" ;
    dc:description "The crusader-created state ruling Constantinople after the 1204 sack, the weakest of four powers feuding over the Balkans, whose Latin Emperor cares more for his home Flanders than the City." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:LeagueOfIconophiles a rpg:Faction ;
    rpg:name "League of Iconophiles" ;
    dc:description "The most powerful of the eastern Empire's transient magical leagues, formed to oppose Emperor Leo III's destruction of religious icons; its members are the ancestors of House Jerbiton." ;
    skos:altLabel "the Iconophiles" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:LeapOfTheFire a rpg:Spell ;
    rpg:name "Leap of the Fire" ;
    dc:description "A Rego Ignem spell (Level 10) that causes a bonfire to leap up to 10 paces in any direction, catching if there is fuel; a Targeting roll lets it deal +10 damage to a target." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Lecherous a rpg:Tag ;
    skos:prefLabel "Lecherous" ;
    dc:description "A Major or Minor Personality Flaw in which the character seeks sexual contact with as many people as possible." ;
    rpg:hasTag amol:Flaw .
amol:LegionOfMithras a rpg:Faction ;
    rpg:name "Legion of Mithras" ;
    dc:description "A 13th-century mystery cult reconstruction of the ancient Cult of Mithras that teaches additional powers via Initiation; Castra Solis's shield grogs may serve it as Auxiliaries." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:LeprosyHermetic a rpg:Creature ;
    rpg:name "Leprosy, Hermetic" ;
    dc:description "A Critical Melancholic Disease caused by Hermetic spells, a rapid hideous wasting disease with a pungent rotting smell." ;
    skos:altLabel "Hermetic leprosy" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:LesserBenediction a rpg:Tag ;
    skos:prefLabel "Lesser Benediction" ;
    dc:description "A Minor, Supernatural Virtue granting a minor blessing from a supernatural power, with examples like Gift of the Gab, Green Fingers, and Pricking Thumbs." ;
    rpg:hasTag amol:Virtue .
amol:LesserEnchantedItem a rpg:Item ;
    rpg:name "Lesser Enchanted Item" ;
    dc:description "A category of enchanted device requiring the Lab Total to be at least double the effect's modified level and to which Effect Expiry cannot be applied." ;
    skos:altLabel "Lesser Enchanted Items", "Lesser Enchantments", "lesser enchanted device", "lesser enchantment" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:LesserPower a rpg:Tag ;
    skos:prefLabel "Lesser Power" ;
    dc:description "A Minor, Supernatural Virtue granting one or more at-will supernatural powers equivalent to Formulaic Hermetic spells of total level 25 or lower." ;
    rpg:hasTag amol:Virtue .
amol:LiftingTheDanglingPuppet a rpg:Spell ;
    rpg:name "Lifting the Dangling Puppet" ;
    dc:description "A Rego Corpus spell (Level 15) that lifts a person of Size +1 or less vertically into the air." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:LightTouch a rpg:Tag ;
    skos:prefLabel "Light Touch" ;
    dc:description "A Virtue improving fine manual work; held by the Craftsman template and offered as an alternative for the Spying Maid." ;
    rpg:hasTag amol:Virtue .
amol:LimitOfArcaneConnections a rpg:Tag ;
    skos:prefLabel "Limit of Arcane Connections" ;
    dc:description "A Hermetic limit concerning the use of Arcane Connections; a Touch-range spell on a room does not violate it even when affecting unseen people within." ;
    rpg:hasTag amol:HermeticConcept .
amol:LimitsOfMagic a rpg:Tag ;
    skos:prefLabel "Limits of Magic" ;
    dc:description "The fundamental boundaries constraining Hermetic magic; Major Breakthroughs push them, Hermetic Breakthroughs break Lesser Limits such as the Limit of Magic Resistance." ;
    skos:altLabel "Hermetic Limit", "Laws of Magic", "Lesser Limits of Magic", "Limit of Arcane Connection", "Limit of Magic" ;
    rpg:hasTag amol:HermeticConcept .
amol:LivonianOrderOfTheKnightsOfTheSword a rpg:Faction ;
    rpg:name "Livonian Order of the Knights of the Sword" ;
    dc:description "A crusading military order formed in 1202 in Pomerania and Livonia to fight Baltic pagans; reprimanded and subsumed into the Teutonic Order in 1237." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:LordMarsyne a rpg:Creature ;
    rpg:name "Lord Marsyne" ;
    dc:description "A faerie lord (Might 50, Aquam) ruling an ice castle in the far north, who entombs people in ice, grants youth, and always takes a beautiful young human wife who must come of her own free will." ;
    skos:altLabel "Marsyne" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:LordRobertSchonburg a rpg:Character ;
    rpg:name "Lord Robert Schonburg" ;
    dc:description "Bastard son of Baron Schonburg and a diabolist who collects unjust tolls from Pfalz Island; an infernalist villain who casts ritual-like spells using Infernal Lore." ;
    skos:altLabel "Lord Robert", "Robert" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:LouisOfFrance a rpg:Character ;
    rpg:name "Louis of France" ;
    dc:description "The French prince who invaded England with an army in the civil war and controlled much of southern England before being driven out by William Marshal as regent." ;
    skos:altLabel "Louis" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:LowSelfEsteem a rpg:Tag ;
    skos:prefLabel "Low Self-Esteem" ;
    dc:description "A Flaw common among Bjornaer magi who were catuli (apprentices ordered around) for most of their apprenticeships." ;
    rpg:hasTag amol:Flaw .
amol:LowerLorraine a schema:Place ;
    rpg:name "Lower Lorraine" ;
    dc:description "The lower half of the ancient kingdom of Lotharingia, fractured into counties and duchies including the rival duchies of Brabant and Limburg, with forested uplands of the Ardennes and Eifel." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Lucca a schema:Place ;
    rpg:name "Lucca" ;
    dc:description "A city in northern Italy granted a charter by Henry IV in 1081, overthrown in a commune revolt in 1115, which has since conquered neighboring lands and rivals Pisa." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Lucian a rpg:Character ;
    rpg:name "Lucian" ;
    dc:description "An elder House Merinita magus of the covenant of Aegea in the Theban Tribunal, renowned for knowledge of Byzantine and ancient Greek literature and rumored initiated into story magic." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Luck a rpg:Tag ;
    skos:prefLabel "Luck" ;
    dc:description "A Minor General Virtue granting +1 to +3 on rolls in situations governed by luck rather than skill, making the character do well at games of chance." ;
    rpg:hasTag amol:Virtue .
amol:Ludold a rpg:Character ;
    rpg:name "Ludold" ;
    dc:description "The white-haired elder of Waldheim, a lesser hedge wizard and cunning man who creates minor potions and charms; father of Torven." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:LumenOfJerbiton a rpg:Character ;
    rpg:name "Lumen of Jerbiton" ;
    dc:description "A young Jerbiton maga and obsessive bibliophile responsible for Schola Pythagoranis's library, who owns a ring that makes her appear as a man." ;
    skos:altLabel "Lumen" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:LunarSphere a schema:Place ;
    rpg:name "Lunar Sphere" ;
    dc:description "The lowest of the celestial spheres carrying the heavenly bodies around the stationary Earth in Mythic Europe's medieval physics; it is also the limit of the power of Hermetic magic." ;
    skos:altLabel "the Sphere" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Lupersus a rpg:Creature ;
    rpg:name "Lupersus" ;
    dc:description "A Divine creature (Might 20, Animal) appearing as a noble silver-gray wolf sent by God to guard a holy hermit, provide food, and lead those in need to him; not an angel." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:LupusTheWolf a rpg:Tag ;
    skos:prefLabel "Lupus (the Wolf)" ;
    dc:description "A Minor Social Status Virtue for a character employed by a university to ensure students speak only Latin, holding keys to the students' housing." ;
    skos:altLabel "Lupus", "the Wolf" ;
    rpg:hasTag amol:Virtue .
amol:Lutisse a rpg:Character ;
    rpg:name "Lutisse" ;
    dc:description "A very slight (Size -1) maga of House Ex Miscellanea who resides in a faerie-glamour-shrouded treehouse at the edge of a faerie forest." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:MagiOfHermes a rpg:Tag ;
    skos:prefLabel "Magi of Hermes" ;
    dc:description "An Ars Magica supplement containing 15 fully statted magi at various ages, usable as NPCs or player characters." ;
    rpg:hasTag amol:HermeticConcept .
amol:MagianLineage a rpg:Tag ;
    skos:prefLabel "Magian Lineage" ;
    dc:description "A Minor or Major General Virtue making the character a true blood descendant of the Median tribe of Magians, the original priestly caste of Persia, granting bonuses to aging and disease resistance." ;
    rpg:hasTag amol:Virtue .
amol:MagnaCarta a rpg:Tag ;
    skos:prefLabel "Magna Carta" ;
    dc:description "The great written charter of English liberties, settled at Runnymede; its 1217 reissue is enforceable in court even against the king and constrains royal power." ;
    skos:altLabel "the Great Charter" ;
    rpg:hasTag amol:HermeticConcept .
amol:Magvillus a rpg:Faction ;
    rpg:name "Magvillus" ;
    dc:description "The domus magna of House Guernicus, in the Roman Tribunal, where Prima Bilera resides." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:MaintainTheDemandingSpell a rpg:Spell ;
    rpg:name "Maintain the Demanding Spell" ;
    dc:description "A Vim spell cited as not eligible for the Rebuttal Mastery special ability." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:MaintainingTheDemandingSpell a rpg:Spell ;
    rpg:name "Maintaining the Demanding Spell" ;
    dc:description "A Rego Vim spell that automatically maintains a concentration-requiring spell already cast for the duration of this spell, without the caster needing to concentrate." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:MaleGuildSponsor a rpg:Tag ;
    skos:prefLabel "Male Guild Sponsor" ;
    dc:description "A free General Virtue allowing a female character to participate in any guild by attaching to a male relative's name on the roster." ;
    rpg:hasTag amol:Virtue .
amol:Malocchi a rpg:Faction ;
    rpg:name "Malocchi" ;
    dc:description "A tradition of Italian magi within House Ex Miscellanea who practice the magic of Entrancement and are believed to bring terrible luck with their gaze." ;
    skos:altLabel "maloccha", "maloccho" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Mamluk a rpg:Tag ;
    skos:prefLabel "Mamluk" ;
    dc:description "A Minor Social Status Virtue for a former military slave bought as a child, trained at a military school and educated in Islam, then freed on adulthood." ;
    rpg:hasTag amol:Virtue .
amol:ManufacturedIgnorance a rpg:Tag ;
    skos:prefLabel "Manufactured Ignorance" ;
    dc:description "A Minor Story Tainted Flaw in which a group of minor demons sustains the tainted character's delusion by arranging supporting fortunate occurrences." ;
    rpg:hasTag amol:Flaw .
amol:ManyMarriageableDaughters a rpg:Tag ;
    skos:prefLabel "Many Marriageable Daughters" ;
    dc:description "A Major Story Flaw in which the character has many daughters and must participate in stories to marry them off suitably." ;
    rpg:hasTag amol:Flaw .
amol:MarcusTheValiant a rpg:Creature ;
    rpg:name "Marcus the Valiant" ;
    dc:description "The ghostly gladiator leader (Magic Might 20) who haunts the Trier amphitheater, equipped as a hoplomachus and challenging visitors to duels to the death." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:MariusOfTremere a rpg:Character ;
    rpg:name "Marius of Tremere" ;
    dc:description "A magus of House Tremere whose version of Ball of Abysmal Flame causes the ball to make a loud bang on impact; his magical sigil is a gaudiness in his spells." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:MasterBard a rpg:Tag ;
    skos:prefLabel "Master Bard" ;
    dc:description "A Major Social Status Virtue for a character who has spent at least nine years at an Irish bardic school and is a master of the trade, called an Anruth." ;
    skos:altLabel "Anruth" ;
    rpg:hasTag amol:Virtue .
amol:MasterOfFormCreatures a rpg:Tag ;
    skos:prefLabel "Master of (Form) Creatures" ;
    dc:description "A Minor Supernatural Virtue letting a character tame animals and unintelligent beings whose Magic Might is aligned with a particular Form." ;
    rpg:hasTag amol:Virtue .
amol:Masterpiece a rpg:Tag ;
    skos:prefLabel "Masterpiece" ;
    dc:description "A Minor Hermetic Virtue allowing a Verditius magus to keep the lesser enchanted item he made to pass his Gauntlet, with vis costs ignored." ;
    rpg:hasTag amol:Virtue .
amol:MateosTheFaerieButler a rpg:Creature ;
    rpg:name "Mateos, the Faerie Butler" ;
    dc:description "A child-sized faerie (Might 10, Herbam) who lives for drunken parties, serving intoxicating drinks from an endless barrel and encouraging people to embarrass themselves." ;
    skos:altLabel "Mateos" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Matilda a rpg:Character ;
    rpg:name "Matilda" ;
    dc:description "A noblewoman trained in warfare who championed the Pope during the Investiture Controversy and led armies that all but destroyed Imperial authority in Northern Italy; an example of political-success-based female power." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:MattieusOfCherson a rpg:Character ;
    rpg:name "Mattieus of Cherson" ;
    dc:description "A historically important twelfth-century Primus of House Jerbiton who believed Jerbiton magi should serve as ambassadors to the mundanes." ;
    skos:altLabel "Mattieus", "Mattieus the twelfth-century Primus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:MaximianusOfBonisagus a rpg:Character ;
    rpg:name "Maximianus of Bonisagus" ;
    dc:description "An ancient, widely respected Bonisagus master of Corpus magic and prolific author who founded Nigrasaxa to break the cycle of invalid tribunals." ;
    skos:altLabel "Maximianus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:MazdeanPriest a rpg:Tag ;
    skos:prefLabel "Mazdean Priest" ;
    dc:description "A Minor Social Status Virtue for an ordained Mazdean priest, initiated as a mobed, who performs Zoroastrian rituals and tends sacred fires." ;
    skos:altLabel "mobed" ;
    rpg:hasTag amol:Virtue .
amol:Meddler a rpg:Tag ;
    skos:prefLabel "Meddler" ;
    dc:description "A Major or Minor Personality Flaw in which the character wastes time and energy trying to fix other people's lives, who usually resent it." ;
    rpg:hasTag amol:Flaw .
amol:Medicus a rpg:Tag ;
    skos:prefLabel "Medicus" ;
    dc:description "A general term for a practitioner who may perform medicine or surgery but has no formal claim to the higher title of doctor; the majority of practicing physicians." ;
    rpg:hasTag amol:CharacterType .
amol:MentoredByDemons a rpg:Tag ;
    skos:prefLabel "Mentored by Demons" ;
    dc:description "A Minor General Tainted Virtue letting a character learn Abilities faster than possible with human teachers, though demons only teach what suits their plans." ;
    rpg:hasTag amol:Virtue .
amol:MerchantAdventurer a rpg:Tag ;
    skos:prefLabel "Merchant Adventurer" ;
    dc:description "A minor Social Status Virtue for a character in command of a ship and crew with sufficient capital for a cargo, though possibly with substantial debts." ;
    rpg:hasTag amol:Virtue .
amol:Merinugalaudabila a rpg:Character ;
    rpg:name "Merinugalaudabila" ;
    dc:description "A Novgorod maga leading a nomadic family of faerie Merinitae who delights in certamen as a sport and has fostered interest in magical competition and dueling styles within the House." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Merovingians a rpg:Faction ;
    rpg:name "Merovingians" ;
    dc:description "A dynasty of Christian wizard-kings descended from the Holy-Grail-bearing Merovech and the Gifted Clovis; their corruption within seven decades is one proposed Divine cause of the Curse." ;
    skos:altLabel "Merovingian dynasty" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:MethodCaster a rpg:Tag ;
    skos:prefLabel "Method Caster" ;
    dc:description "A Minor Hermetic Virtue granting a +3 bonus to the Casting Total of any Formulaic or Ritual spell, lost if the caster varies from his precise method." ;
    rpg:hasTag amol:Virtue .
amol:MightyTorrentOfWater a rpg:Spell ;
    rpg:name "Mighty Torrent of Water" ;
    dc:description "A Creo Aquam spell (Level 20) that sprays a jet of water at a target, dealing damage and potentially sending them flying back." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Milo a rpg:Character ;
    rpg:name "Milo" ;
    dc:description "Second apprentice of Verditius who combined Boethius's philosophy with Germanic runes to invent Verditius Runes and discovered Hephaestus's torture chair at Ravenna." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:MindOfTheBeast a rpg:Spell ;
    rpg:name "Mind of the Beast" ;
    dc:description "A Muto Mentem spell (Level 30) with an Animal requisite that turns the target's mind into that of an animal of the caster's choice, with the victim acting like that animal." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:MissingEye a rpg:Tag ;
    skos:prefLabel "Missing Eye" ;
    dc:description "A Minor General Flaw in which the character cannot judge close distances easily, penalizing missile, targeting, and melee attack rolls." ;
    rpg:hasTag amol:Flaw .
amol:MistakenIdentity a rpg:Tag ;
    skos:prefLabel "Mistaken Identity" ;
    dc:description "A Major Story Flaw in which someone who looks exactly like the character commits violent or embarrassing acts, forcing him to deal with the consequences." ;
    skos:altLabel "Mistaken Identity Flaw" ;
    rpg:hasTag amol:Flaw .
amol:Montverte a rpg:Faction ;
    rpg:name "Montverte" ;
    dc:description "A covenant in the Normandy Tribunal occupying a castle with curtain walls and mural towers, which it shares with its mundane lord and uses as a base for raiding permitted by that tribunal's Peripheral Code." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:Moonbeam a rpg:Spell ;
    rpg:name "Moonbeam" ;
    dc:description "A Creo Ignem spell (Level 3) that causes a gentle reading-bright light to shine down and illuminate the area encircled by the caster's arms." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:MountEtna a schema:Place ;
    rpg:name "Mount Etna" ;
    dc:description "A volcano on the island of Sicily beneath which the fire spirit Adranus slumbers; believed by the ancients to hold a gateway to the Underworld, it last erupted in 1194." ;
    skos:altLabel "Etna" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:MountRadhost a schema:Place ;
    rpg:name "Mount Radhost" ;
    dc:description "A 3700-foot summit in Moravia, site of a crude stone temple to Radegast with a Magic aura of 6 (secretly Infernal), where a great festival fuelled by human sacrifice yields vis for Roznov's magi." ;
    skos:altLabel "Mount Radegast" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Muqta a rpg:Tag ;
    skos:prefLabel "Muqta" ;
    dc:description "A Major Social Status Virtue for an important emir entrusted with an iqta', a feudal-like fief, following the Landed Noble rules." ;
    rpg:hasTag amol:Virtue .
amol:MustardPlaster a rpg:Item ;
    rpg:name "Mustard Plaster" ;
    dc:description "A Theriac of Level 5, Potency Moderate, a linen cloth with ground mustard seeds that grants +3 to Wound Recovery rolls for Medium and Light Wounds by drawing out choler." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:Mute a rpg:Tag ;
    skos:prefLabel "Mute" ;
    dc:description "A Major General Flaw in which the character cannot speak; magi with this Flaw take a -10 penalty to all spellcasting unless offset by the Quiet Magic Virtue." ;
    rpg:hasTag amol:Flaw .
amol:MythicHerbalism a rpg:Tag ;
    skos:prefLabel "Mythic Herbalism" ;
    dc:description "A Major Supernatural Virtue and Ability that lets a character create healing unguents, poultices, virulent poisons, and physical-bonus potions." ;
    rpg:hasTag amol:Virtue .
amol:Nasir a rpg:Creature ;
    rpg:name "Nasir" ;
    dc:description "A minor angel of the Divine realm (Divine Might 25, Corpus) charged with the safety of pious travellers, who aids those in need before vanishing. He has powers such as Calming Touch, Spirit Form, Steadying Hand, and Subtle Form." ;
    skos:altLabel "Nasir, the Delper" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Nibelungenlied a rpg:Tag ;
    skos:prefLabel "Nibelungenlied" ;
    dc:description "The great epic poem of the tragic fate of the Burgundian people, immortalizing Siegfried, Kriemhild, Gunther, and Hagen, treated as true history in Mythic Germany." ;
    skos:altLabel "Song of the Nibelungs" ;
    rpg:hasTag amol:HermeticConcept .
amol:NizariIsmaIlis a rpg:Faction ;
    rpg:name "Nizari Isma'ilis" ;
    dc:description "An order of assassins, far from whose home fida'is and lasiqs are sent on missions; fida'i and lasiq Social Statuses are drawn from this sect." ;
    skos:altLabel "Nizari", "Nizaris", "the sect" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:NotesOfADelightfulSound a rpg:Spell ;
    rpg:name "Notes of a Delightful Sound" ;
    dc:description "A Muto Imaginem spell (Level 10) that causes all sounds in a room, particularly music, to be especially clear and sonorous." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Nuntius a rpg:Tag ;
    skos:prefLabel "Nuntius" ;
    dc:description "A Free Social Status Virtue for a messenger charged with delivering messages, mail, and donations between students and families, employed by a university nation." ;
    rpg:hasTag amol:Virtue .
amol:Obese a rpg:Tag ;
    skos:prefLabel "Obese" ;
    dc:description "A Minor General Flaw in which the character is large due to fat, giving -1 to rolls involving quick or graceful movement and -3 to Fatigue rolls." ;
    rpg:hasTag amol:Flaw .
amol:ObjectOfIncreasedSize a rpg:Spell ;
    rpg:name "Object of Increased Size" ;
    dc:description "An enchanted item whose effect makes an object larger; a faculty's possession of one sparks a violent university debate over whether size is substance or quantity." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Obsession a rpg:Tag ;
    skos:prefLabel "Obsession" ;
    dc:description "A demonic power tied to a particular sin which the demon may impose upon a mortal indulging in a venial sin, granting the victim a sinful Personality Trait." ;
    skos:altLabel "Obsession Personality Trait", "Obsession Trait" ;
    rpg:hasTag amol:HermeticConcept .
amol:Odorpes a rpg:Character ;
    rpg:name "Odorpes" ;
    dc:description "A maga of House Bjornaer and filia of Urgen, sole inhabitant of Fengheld's Lusatia chapter, who spends most of her time as a bear and hibernates all winter." ;
    skos:altLabel "Odorpes filia Urgen" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:OffensiveToBeings a rpg:Tag ;
    skos:prefLabel "Offensive to (Beings)" ;
    dc:description "A Minor General Flaw causing a chosen class of beings (humans, demons, or divine beings) to react badly to the character; known among Merinitae as the Tin, Iron, and Leaden Gifts." ;
    skos:altLabel "The Iron Gift", "The Leaden Gift", "The Tin Gift" ;
    rpg:hasTag amol:Flaw .
amol:OrderOfSuleiman a rpg:Faction ;
    rpg:name "Order of Suleiman" ;
    dc:description "A legendary organization of Islamic magi, rivals in power to the Order of Hermes, said to be the association of the non-Hermetic sahirs with close ties to Levantine rulers." ;
    skos:altLabel "Order of Suleiman (Solomon)", "putative Order of Suleiman" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:OrderOfTheHospitalersOfStAnthony a rpg:Faction ;
    rpg:name "Order of the Hospitalers of St. Anthony" ;
    dc:description "An order established in 1095 and named after a fourth-century Egyptian hermit; it knows a ritual to exorcise the St. Anthony's Fire demon and maintains houses across Europe with a chapter house in London." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:OrphicMagic a rpg:Tag ;
    skos:prefLabel "Orphic Magic" ;
    dc:description "A Minor Hermetic Virtue granting Orphic magoi access to the additional Range Adelphixis, using emotional connections as Arcane Connections." ;
    rpg:hasTag amol:Virtue .
amol:Oswald a rpg:Character ;
    rpg:name "Oswald" ;
    dc:description "A most Christian king of the Northumbrians (633-642) who raised a cross before battle and won; many miracles and healings occurred at the cross and at the sites of his death and burial." ;
    skos:altLabel "Saint Oswald, King of the Northumbrians" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:OutlawLeader a rpg:Tag ;
    skos:prefLabel "Outlaw Leader" ;
    dc:description "A minor Social Status Flaw that grants a character an agency of criminal underlings prior to play; listed with a Resistance of -1 on the Resistance of Agents Table." ;
    rpg:hasTag amol:Flaw .
amol:PackMentalityFollower a rpg:Tag ;
    skos:prefLabel "Pack Mentality / Follower" ;
    dc:description "A Minor Personality Flaw making the character a follower rather than a leader who tends to stick with a decisive person." ;
    skos:altLabel "Follower", "Pack Mentality" ;
    rpg:hasTag amol:Flaw .
amol:Pallas a rpg:Character ;
    rpg:name "Pallas" ;
    dc:description "A maga whose death left her lover, a nymph of unmatched beauty, in inconsolable mourning, leaving a covenant tower unused for sixty years." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Pandulf a rpg:Character ;
    rpg:name "Pandulf" ;
    dc:description "The Papal Legate in England, elected bishop of Norwich in 1215 but not yet consecrated, who serves as regent for the young king and in theory outranks both king and archbishop." ;
    skos:altLabel "the papal legate" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:PanicOfTheElephantSMouse a rpg:Spell ;
    rpg:name "Panic of the Elephant's Mouse" ;
    dc:description "A Rego Animal spell (Level 15) that makes an animal afraid of the target, causing it to flee by the quickest means." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ParchingWind a rpg:Spell ;
    rpg:name "Parching Wind" ;
    dc:description "A Perdo Aquam spell (Level 20) that removes most water from an object, and with a Corpus or Animal requisite can damage humans or animals while making them thirsty." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:PartingTheWaves a rpg:Spell ;
    rpg:name "Parting the Waves" ;
    dc:description "A Rego Aquam spell (Level 30) that parts a body of water, revealing a dry path five paces wide along the bottom." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Partner a rpg:Tag ;
    skos:prefLabel "Partner" ;
    dc:description "A major Social Status Virtue for a character with a large financial stake in a wealthy company, providing minor-noble-level income and the ability to act in any company role except capo." ;
    rpg:hasTag amol:Virtue .
amol:PassionSLostFeeling a rpg:Spell ;
    rpg:name "Passion's Lost Feeling" ;
    dc:description "A spell that renders the target unable to feel any emotion, leaving them listless and without motivation." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:PastOfAnother a rpg:Spell ;
    rpg:name "Past of Another" ;
    dc:description "A Muto Mentem ritual (Level 35) that completely rewrites the target's memories so they cannot remember their actual life until the effect is dispelled or expires." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:PerceiveTheChange a rpg:Spell ;
    rpg:name "Perceive the Change" ;
    dc:description "An InAn 14 constant enchantment effect detecting whether an item touches an animal, used to trigger linked size/shape effects when a Bjornaer transforms." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:PerdoVim a rpg:Proficiency ;
    rpg:name "Perdo Vim" ;
    dc:description "A Hermetic Technique-Form combination of destruction and magical power; Perdo Vim spells that reduce Might can kill a legendary artist." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticArt .
amol:PerfectEyeForCommodity a rpg:Tag ;
    skos:prefLabel "Perfect Eye for (Commodity)" ;
    dc:description "A minor general Virtue letting a character always accurately assess the value of one commodity and products made from it, granting extra Labor Points when trading exclusively in it." ;
    skos:altLabel "Perfect Eye" ;
    rpg:hasTag amol:Virtue .
amol:Perfectus a rpg:Tag ;
    skos:prefLabel "Perfectus" ;
    dc:description "A Minor Social Status Virtue for one of the leaders of the Cathar heretics in southern France, sworn to preaching and ascetic abstinence." ;
    rpg:hasTag amol:Virtue .
amol:PersonalityTrait a rpg:Tag ;
    skos:prefLabel "Personality Trait" ;
    dc:description "Short descriptors of a character's personality with scores from -3 to +3 (e.g., Brave, Loyal), used as roleplaying guides and for some rolls." ;
    skos:altLabel "Loyal to Covenant", "Personality Traits" ;
    rpg:hasTag amol:HermeticConcept .
amol:PeterAbelard a rpg:Character ;
    rpg:name "Peter Abelard" ;
    dc:description "A famous scholastic logician who taught at the cathedral school of St Geneviève in Paris; held two heretical theories condemned by Bernard of Clairvaux and exemplifies both good and bad Academic Reputation." ;
    skos:altLabel "Abelard" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:PeterDesRoches a rpg:Character ;
    rpg:name "Peter des Roches" ;
    dc:description "The bishop of Winchester (since 1205) and member of the regency triumvirate, a wealthy French-born warrior-bishop and former tutor of the king, contemptuous of Magna Carta." ;
    skos:altLabel "Peter des Roches, Bishop of Winchester", "bishop of Winchester", "des Roches" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:PfalzIsland a schema:Place ;
    rpg:name "Pfalz Island" ;
    dc:description "An island in the center of the Rhine that formerly housed the covenant of Rheinstein (Magic aura 2), with a ruined castle, a dripstone-bearing rocky spine, and currently occupied by Lord Robert Schonburg." ;
    skos:altLabel "Burg Pfalz", "Burg Pfalz (island)" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:PhantasmOfTheHumanForm a rpg:Spell ;
    rpg:name "Phantasm of the Human Form" ;
    dc:description "A Creo Imaginem spell (Level 25) that makes an image of a clothed, equipped person that can move, speak, and behave as a human under the caster's unspoken command." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:PhantasmOfTheTalkingHead a rpg:Spell ;
    rpg:name "Phantasm of the Talking Head" ;
    dc:description "A Creo Imaginem spell (Level 10) that creates an illusory face on a wall or flat object that can speak during the spell's duration." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:PhantasmalAnimal a rpg:Spell ;
    rpg:name "Phantasmal Animal" ;
    dc:description "A Creo Imaginem spell (Level 20) that creates an image of any animal up to pony size that moves under mental command and makes appropriate noises and smells, but has no effect on touch." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:PhilipOfFrance a rpg:Character ;
    rpg:name "Philip of France" ;
    dc:description "The king of France who expelled John from Normandy in 1204 and besieged Ghent; forced to abandon plans to invade England after William de Longespee's naval action at Damme." ;
    skos:altLabel "Philip" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Phoenix a rpg:Creature ;
    rpg:name "Phoenix" ;
    dc:description "A legendary bird whose ashes provide a powerful Shape and Material bonus (+11) to rejuvenation and regeneration enchantments." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:PiercingShaftOfWood a rpg:Spell ;
    rpg:name "Piercing Shaft of Wood" ;
    dc:description "A Muto Herbam spell (Level 10) with a Rego requisite that turns a piece of wood into a barbed shaft that flies at a target and cannot miss but is resisted." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:PiercingTheFaerieVeil a rpg:Spell ;
    rpg:name "Piercing the Faerie Veil" ;
    dc:description "An Intellego Vim spell that lets the caster see through the boundaries of Faerie regiones and find the path to the next level." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:PlaguedByAngel a rpg:Tag ;
    skos:prefLabel "Plagued by Angel" ;
    dc:description "A Story Flaw in which a character is troubled by the attention of an angel; held by the Priest companion and possible for Devil Children." ;
    rpg:hasTag amol:Flaw .
amol:Plato a rpg:Character ;
    rpg:name "Plato" ;
    dc:description "The philosopher whose advocacy of training women for all duties of the state, including warfare, underlies the Order of Hermes's position of equity for women." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Plentarch a rpg:Character ;
    rpg:name "Plentarch" ;
    dc:description "An ancient Mercurian high priest who gathered 38 Mercurians at Pompeii and taught them a ritual allowing them to commune with their gods in concert." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Pomerania a schema:Place ;
    rpg:name "Pomerania" ;
    dc:description "A sparsely-populated realm of Slavic peoples between the Baltic Sea and Poland, bordering the Novgorod Tribunal; part of the Holy Roman Empire since 1181 and a region of contention with werewolves and the Knights of the Sword." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Pompeii a schema:Place ;
    rpg:name "Pompeii" ;
    dc:description "The Roman city where the high priest Plentarch gathered 38 Mercurians to teach them the ritual of concerted communion with their gods." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:PoorStrength a rpg:Tag ;
    skos:prefLabel "Poor Strength" ;
    dc:description "A Flaw possessed by Brother Julian reflecting weak physical strength." ;
    rpg:hasTag amol:Flaw .
amol:PortunesSpiritOfSafeHarbor a rpg:Creature ;
    rpg:name "Portunes, Spirit of Safe Harbor" ;
    dc:description "A Daimon spirit (Magic Might 25, Auram) charged with ports and harbors, keys and locks, worshipped as a god in Rome; summoned by throwing keys into a fire." ;
    skos:altLabel "Melicertes", "Palaemon", "Portunes", "Portunes, Spirit of Safe Narbor" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Possession a rpg:Tag ;
    skos:prefLabel "Possession" ;
    dc:description "A demonic power by which a demon places Might into a human host (an energumen), taking direct control of the victim and able to use powers through them." ;
    rpg:hasTag amol:HermeticConcept .
amol:PowerfulRelic a rpg:Tag ;
    skos:prefLabel "Powerful Relic" ;
    dc:description "A Major General Virtue granting ownership of an unusually powerful relic with a True Faith score of 3 and one agreed power." ;
    rpg:hasTag amol:Virtue .
amol:PoUdnica a rpg:Creature ;
    rpg:name "Południca" ;
    dc:description "A faerie (Might 10, Auram) appearing as a maiden, crone, or girl with a scythe who appears at noon on hot days, asking farmhands difficult questions and inflicting heatstroke if they fail to answer." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Preservative a rpg:Item ;
    rpg:name "Preservative" ;
    dc:description "A Level 10 alchemical Reagent, a tarry substance that when painted onto wood proofs it against rot, mold, and pests, making about two gallons." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:PrestigiousStudent a rpg:Tag ;
    skos:prefLabel "Prestigious Student" ;
    dc:description "A Minor General Virtue for the son of a nobleman or prosperous merchant matriculated at a university with retainers, trained in Artes Liberales and Latin by a private tutor." ;
    rpg:hasTag amol:Virtue .
amol:PrevailingLoyalty a rpg:Tag ;
    skos:prefLabel "Prevailing Loyalty" ;
    dc:description "A game measure of how loyal a covenant's covenfolk are overall, derived from a Base Loyalty (driven by the magi's Gifts) modified by living conditions, treatment, and events." ;
    skos:altLabel "Base Loyalty", "loyalty points" ;
    rpg:hasTag amol:HermeticConcept .
amol:PrimogenitureLineage a rpg:Tag ;
    skos:prefLabel "Primogeniture Lineage" ;
    dc:description "A Minor Story and Hermetic Flaw in which the character is in line for Primus of House Verditius, receiving undue attention and political enmity; only available to Verditius magi." ;
    rpg:hasTag amol:Flaw .
amol:ProfessionMerchant a rpg:Proficiency ;
    rpg:name "Profession (Merchant)" ;
    dc:description "A Profession Ability in which traders and factors are skilled, eligible for Affinity, Cautious, Puissant, and other modifiers." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:ProfessionBoating a rpg:Proficiency ;
    rpg:name "Profession: Boating" ;
    dc:description "A Profession Ability for navigating rivers; needed (Ease Factor 9) to safely pass the treacherous Loreley stretch of the Rhine." ;
    skos:altLabel "Profession: Boatman" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:ProfessionSteward a rpg:Proficiency ;
    rpg:name "Profession: Steward" ;
    dc:description "A Profession Ability for managing a household or manor; held by the Spying Maid, Lord of the Manor, and Lady of the Manor, and used to calculate a Steward specialist's loyalty bonus." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:Protection a rpg:Tag ;
    skos:prefLabel "Protection" ;
    dc:description "A Minor General Virtue placing the character under the aegis of a powerful noble or Church official, granting a Reputation of level 3." ;
    rpg:hasTag amol:Virtue .
amol:PuissantIntrigue a rpg:Tag ;
    skos:prefLabel "Puissant Intrigue" ;
    dc:description "A Virtue granting a bonus to the Intrigue Ability, taken by the Political Agent template." ;
    rpg:hasTag amol:Virtue .
amol:PukisDragonOfTheHearth a rpg:Creature ;
    rpg:name "Pukis, Dragon of the Hearth" ;
    dc:description "A lesser Daimon (Magic Might 10, Ignem) first summoned by Baltic wizards, taking the form of a small fire dragon that dwells in a hearth, leaving gifts but causing mischief if mistreated." ;
    skos:altLabel "Pukis" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:PullOfTheSkyboundWinds a rpg:Spell ;
    rpg:name "Pull of the Skybound Winds" ;
    dc:description "A Creo Auram spell (Level 30) that makes winds rise upward, pulling an object, creature, or person up to 50 feet into the sky before dropping it." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:PurificationOfTheFesteringWounds a rpg:Spell ;
    rpg:name "Purification of the Festering Wounds" ;
    dc:description "A Creo Corpus spell (Level 20) granting a +9 bonus to Recovery rolls if maintained throughout the recovery interval." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:QueenOfFaerie a rpg:Character ;
    rpg:name "Queen of Faerie" ;
    dc:description "A faerie ruler in the Maddenhofen Woods of Bohemia whom the Founder Tytalus entered to challenge, never to be seen again." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:QueenOfTheFaeries a rpg:Creature ;
    rpg:name "Queen of the Faeries" ;
    dc:description "A faerie ruler from whom Tytalus claimed he would win his \"heart's desire\" in the Maddenhofen Woods; rumors say Tytalus may one day win free from her and return." ;
    skos:altLabel "the Queen" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Rabbi a rpg:Tag ;
    skos:prefLabel "Rabbi" ;
    dc:description "A Minor Social Status Virtue for an ordained Rabbi, teacher and wise man of the Jewish community, who must take the Educated (Hebrew) Virtue." ;
    rpg:hasTag amol:Virtue .
amol:RabbinicLaw a rpg:Proficiency ;
    rpg:name "Rabbinic Law" ;
    dc:description "An Academic Ability, the Jewish version of Civil & Canon Law, drawn from the Talmud, the Oral Torah, and the Responsa of the Geonim." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:RainOfStones a rpg:Spell ;
    rpg:name "Rain of Stones" ;
    dc:description "A Muto Auram spell (Level 20) that turns falling rain into small stones causing minor damage; the stones revert to water when the spell expires." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:RealmsOfPowerMagic a rpg:Item ;
    rpg:name "Realms of Power: Magic" ;
    dc:description "An Ars Magica sourcebook containing rules for training magical animals and for creating magic-realm characters such as legendary artists." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:Rebuttal a rpg:Proficiency ;
    rpg:name "Rebuttal" ;
    dc:description "A Mastered Spell special ability applicable to Muto or Rego Vim spells affecting another being's magic, adding three times Mastery score to the spell's effective level." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:RecognizeYourMaster a rpg:Spell ;
    rpg:name "Recognize Your Master" ;
    dc:description "An InCo 5 enchanted effect in the Door of Deimos that checks whether a toucher matches an arcane connection and, if not, triggers the door's repelling effect." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:RectorProctor a rpg:Tag ;
    skos:prefLabel "Rector/Proctor" ;
    dc:description "A Major Story Flaw in which the character is the representative leader of his faculty or nation at a university and is responsible for his colleagues' behavior." ;
    rpg:hasTag amol:Flaw .
amol:RedHame a rpg:Creature ;
    rpg:name "Red-Hame" ;
    dc:description "A faerie wolf with Faerie Might 12 and a ruddy neck and back; the messenger of the Winter Court who accompanies Torven and conveys the court's wishes to Waldheim." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:RefrigerantSalt a rpg:Item ;
    rpg:name "Refrigerant Salt" ;
    dc:description "A Level 10 Alteration Reagent whose salt-like crystals freeze water when scattered on its surface, creating a sheet of ice up to six paces in diameter." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:RepelTheIntruder a rpg:Spell ;
    rpg:name "Repel the Intruder" ;
    dc:description "A CrMe 15 enchanted effect in the Door of Deimos that forces anyone who fails an Intelligence roll to flee in terror; has a high Penetration Total." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:RepelTheWoodenShafts a rpg:Spell ;
    rpg:name "Repel the Wooden Shafts" ;
    dc:description "A Rego Herbam spell (Level 10) that deflects a single blow of any wooden weapon up to the size of a two-handed club, making the attack automatically miss." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Repose a rpg:Tag ;
    skos:prefLabel "Repose" ;
    dc:description "House Criamon's alternative to death, a paradisaical state of blessedness reached at the end of each path of Initiation, often delayed by magi out of compassion." ;
    rpg:hasTag amol:HermeticConcept .
amol:Requisite a rpg:Tag ;
    skos:prefLabel "Requisite" ;
    dc:description "An additional Art required to cast certain spells, demanding greater knowledge of the caster and limiting the Arts usable; includes casting requisites." ;
    skos:altLabel "Requisites", "requisites" ;
    rpg:hasTag amol:HermeticConcept .
amol:RestorationOfTheDefiledBody a rpg:Spell ;
    rpg:name "Restoration of the Defiled Body" ;
    dc:description "A Corpus spell that can remove any Flaws resulting from a disease, with a higher guideline needed to negate Flaws caused by life-saving surgery." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:RestrictedPower a rpg:Tag ;
    skos:prefLabel "Restricted Power" ;
    dc:description "A Minor Supernatural Flaw limiting the use of a normally at-will supernatural power, requiring a ceremony or restricting it to certain targets or circumstances." ;
    rpg:hasTag amol:Flaw .
amol:Revenant a rpg:Creature ;
    rpg:name "Revenant" ;
    dc:description "A restless dead being whose only form is an animate material corpse, animated by a spirit and connected to the living world through an overwhelming personal need; difficult to harm with weapons and immune to Incapacitation." ;
    skos:altLabel "Revenants", "draug", "the Walking Dead" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:RhineLeague a rpg:Faction ;
    rpg:name "Rhine League" ;
    dc:description "An alliance founded by Mainz and Worms (and joined by cities, archbishops, and nobles) to suppress unjust tolls by trade sanctions and destruction of robber-baron castles along the Rhine." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:RhineLore a rpg:Proficiency ;
    rpg:name "Rhine Lore" ;
    dc:description "An Area Lore Ability covering the Rhine region; held by several characters including Lord Robert, Wolkan, and David ben David." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:RichardDeMarsh a rpg:Character ;
    rpg:name "Richard de Marsh" ;
    dc:description "The Bishop of Durham (elected 1217), chancellor and creature of King John, greedy and unscrupulous, embroiled in a quarrel with the monks of his cathedral priory." ;
    skos:altLabel "Richard", "Richard Marsh" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Ride a rpg:Proficiency ;
    rpg:name "Ride" ;
    dc:description "An Ability used when employing an animal as a mount, which can substitute for Animal Handling and adds to Attack and Defense in mounted combat." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:RigidMagic a rpg:Tag ;
    skos:prefLabel "Rigid Magic" ;
    dc:description "A Major Hermetic Flaw in which the character cannot use vis when casting spells, thus cannot boost spell rolls or cast Ritual magic, though vis can be used in the laboratory." ;
    rpg:hasTag amol:Flaw .
amol:RingOfWardingAgainstSpirits a rpg:Spell ;
    rpg:name "Ring of Warding Against Spirits" ;
    dc:description "A Rego Mentem spell creating a ring that only ghosts and spirits with Magic Might higher than the spell's level can enter." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:RingCircleMagic a rpg:Tag ;
    skos:prefLabel "Ring/Circle Magic" ;
    dc:description "The Minor Hermetic Virtue of the Columbae, letting them draw circles faster and treat any well-defined boundary as a Circle by marking it." ;
    rpg:hasTag amol:Virtue .
amol:RobertGrosseteste a rpg:Character ;
    rpg:name "Robert Grosseteste" ;
    dc:description "A brilliant scholar and official of the bishop of Hereford, born 1170, who is an unGifted natural magician acquainted with the magi of Schola Pythagoranis though he declined to join." ;
    skos:altLabel "Grosseteste", "Master Robert" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:RobertDeCourtenay a rpg:Character ;
    rpg:name "Robert de Courtenay" ;
    dc:description "Sheriff of Devon who refused to surrender the shrievalty to Falkes de Bréauté, claiming he should have had the wardship of the heir." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:RobesOfDustyDawn a rpg:Item ;
    rpg:name "Robes of Dusty Dawn" ;
    dc:description "Enchanted lavender-rose robes covered in chalk markings that protect against natural and supernatural threats; the symbol of the Primus Ex Miscellanea, given to Pralix by the Columbae." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:RockOfViscidClay a rpg:Spell ;
    rpg:name "Rock of Viscid Clay" ;
    dc:description "A Muto Terram spell that softens rock so it can be dug out, molded, and manipulated like hard river clay." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:RootsOfTheArts a rpg:Tag ;
    skos:prefLabel "Roots of the Arts" ;
    dc:description "Basic summae texts for nine of the Arts, accepted as the preferred primers for a magus seeking competence to train an apprentice, widely and cheaply available." ;
    skos:altLabel "Foundations", "Foundations of the Arts", "Roots" ;
    rpg:hasTag amol:HermeticConcept .
amol:RoseOfJerbiton a rpg:Character ;
    rpg:name "Rose of Jerbiton" ;
    dc:description "A magus of House Jerbiton credited with a version of Flash of the Scarlet Flames that leaves a faint odor of roses where the flash explodes." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:RoshBethDin a rpg:Tag ;
    skos:prefLabel "Rosh Beth Din" ;
    dc:description "A Major Social Status Virtue for the head who presides at the Beth Din rabbinic court, requiring high Hebrew, Rabbinic Law, and Theology: Judaism." ;
    skos:altLabel "Head of the Court" ;
    rpg:hasTag amol:Virtue .
amol:Rudesheim a schema:Place ;
    rpg:name "Rudesheim" ;
    dc:description "A Rhine town on the right bank opposite Bingen, site of the ruined covenant of Rudiaria and the Bromserburg castle; named after the covenant or archbishop Rudbrecht." ;
    skos:altLabel "Rüdesheim" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:SanguineHumorSBlessing a rpg:Tag ;
    skos:prefLabel "Sanguine Humor's Blessing" ;
    dc:description "A Major General Virtue granting bonuses to rolls based on a character's True Feeling Story Flaw, drawing on emotional bonds; the defining Virtue of Orphic magoi." ;
    skos:altLabel "Sanguine Humour's Blessing" ;
    rpg:hasTag amol:Virtue .
amol:Satan a rpg:Creature ;
    rpg:name "Satan" ;
    dc:description "The tempter who led Adam and Eve to sin in the Garden of Eden, bringing about Original Sin; the devil to whom an evil lord might sell his soul for infernal powers." ;
    skos:altLabel "the devil" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:SchoolOfApromor a rpg:Tag ;
    skos:prefLabel "School of Apromor" ;
    dc:description "A versatile school of magical combat within House Flambeau built on the Technique of Perdo, emphasizing destruction, indirect attacks, and multiple Forms; one of the most study-intensive schools." ;
    rpg:hasTag amol:HermeticConcept .
amol:SchoolOfBoreas a rpg:Tag ;
    skos:prefLabel "School of Boreas" ;
    dc:description "A narrowly defined Flambeau combat school relying on the single Perdo Ignem combination, using cold and darkness; developed by the magus Boreas to bridge the Flambeau and Apromor lineages." ;
    rpg:hasTag amol:HermeticConcept .
amol:SchoolOfRamius a rpg:Tag ;
    skos:prefLabel "School of Ramius" ;
    dc:description "A Flambeau combat school that ignores Magic Resistance by using mundane physical attacks supported by magical enhancements, emphasizing defense and Parma Magica; created by Ramius." ;
    rpg:hasTag amol:HermeticConcept .
amol:SchoolOfVilano a rpg:Tag ;
    skos:prefLabel "School of Vilano" ;
    dc:description "The most commonly used Flambeau combat school in the Order, relying on indirect attacks that bypass Magic Resistance; created by the magus Vilano and requiring no specific Arts." ;
    rpg:hasTag amol:HermeticConcept .
amol:SchoolOfTheFounder a rpg:Tag ;
    skos:prefLabel "School of the Founder" ;
    dc:description "A Flambeau combat school based on the magic of Flambeau himself, broader than Boreas and favoring the Form of Ignem, requiring penetration of Magic Resistance." ;
    rpg:hasTag amol:HermeticConcept .
amol:SchooledInCrime a rpg:Tag ;
    skos:prefLabel "Schooled in Crime" ;
    dc:description "A Minor General Virtue granting 50 extra experience to spend on Abilities related to thievery such as Stealth, Legerdemain, and Guile." ;
    rpg:hasTag amol:Virtue .
amol:Scinnfolk a rpg:Faction ;
    rpg:name "Scinnfolk" ;
    dc:description "Gifted Companions in the Order, herb-wives and faerie doctors with eclectic natural magic and faerie charms passed down orally; not a true systematic tradition." ;
    skos:altLabel "Scinnfolk (Gifted Companions)", "cunning folk", "faerie doctors", "herb-wives" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Scitalis a rpg:Creature ;
    rpg:name "Scitalis" ;
    dc:description "A large slow-moving Magical serpent (Might 5, Animal) with spectacularly colored scales that can stupefy onlookers with its Dazzling Appearance and whose fangs drip venom; its hot blood keeps it active in winter." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Scrying a rpg:Tag ;
    skos:prefLabel "Scrying" ;
    dc:description "Magical remote observation of others; the Haunt of the Living Ghost spell is noted as not constituting scrying by magic since others can see the caster." ;
    rpg:hasTag amol:HermeticConcept .
amol:SealTheEarth a rpg:Spell ;
    rpg:name "Seal the Earth" ;
    dc:description "A Creo Terram spell that creates enough dirt to fill in a pit up to 6 paces across and 3 paces deep." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:SecretName a rpg:Tag ;
    skos:prefLabel "Secret Name" ;
    dc:description "A Bjornaer Minor House Mystery that severs and reforges a magus's sympathetic name, expiring all old Arcane Connections and invalidating all Sympathetic Connections against him." ;
    skos:altLabel "Secret Name (Minor House Mystery)", "Secret Name Mystery" ;
    rpg:hasTag amol:Virtue .
amol:Secretive a rpg:Tag ;
    skos:prefLabel "Secretive" ;
    dc:description "A Minor Personality Flaw in which the character keeps secrets from his sodales, rarely explaining what he is doing or why." ;
    rpg:hasTag amol:Flaw .
amol:SeeInDarkness a rpg:Tag ;
    skos:prefLabel "See in Darkness" ;
    dc:description "A Minor Supernatural Virtue letting a character see in complete darkness, though without more acute or longer-range eyesight than normal." ;
    rpg:hasTag amol:Virtue .
amol:Seeker a rpg:Tag ;
    skos:prefLabel "Seeker" ;
    dc:description "A Minor Personality Flaw in which the character is a self-proclaimed member of the Seekers, a loose organization of competitive magi searching for ancient magic and arcane artifacts." ;
    rpg:hasTag amol:CharacterType .
amol:Seekers a rpg:Tag ;
    skos:prefLabel "Seekers" ;
    dc:description "A loose organization of competitive magi searching for ancient magic and arcane artifacts, detailed in Houses of Hermes: True Lineages." ;
    rpg:hasTag amol:CharacterType .
amol:SeelieCourt a rpg:Faction ;
    rpg:name "Seelie Court" ;
    dc:description "A faerie court of higher rank; a Seelie maid disdained the faerie Tulgank and her court caused him to meld with his cavern floor." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Seferiel a rpg:Creature ;
    rpg:name "Seferiel" ;
    dc:description "An angel of the Divine realm (Divine Might 50, Corpus) with special responsibility for Hermetic magi, sometimes drawing them closer to God and sometimes acting as the instrument of God's vengeance. He can duplicate any Hermetic effect and is the suggested antagonist for the Plagued by Angel Story Flaw." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:SelkieKing a rpg:Creature ;
    rpg:name "Selkie King" ;
    dc:description "A faerie figure whose drowned bride a sea mist may be the ghost of, and who comes ashore to find a bride." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:SeniorBard a rpg:Tag ;
    skos:prefLabel "Senior Bard" ;
    dc:description "A Minor Social Status Virtue for a character who spent five or six years at an Irish bardic school, ranked Cano or Cli, with a Local Reputation of 2." ;
    skos:altLabel "Cano", "Cli" ;
    rpg:hasTag amol:Virtue .
amol:SeniorClergy a rpg:Tag ;
    skos:prefLabel "Senior Clergy" ;
    dc:description "A Major Social Status Virtue for an archbishop, bishop, abbot, abbess, or other senior Church member with access to Church resources and a Reputation of level 4." ;
    rpg:hasTag amol:Virtue .
amol:SeniorMaster a rpg:Tag ;
    skos:prefLabel "Senior Master" ;
    dc:description "A Major Social Status Virtue for a prosperous, authoritative guild master who may own multiple workshops, serve as a guild official, and govern guild affairs." ;
    skos:altLabel "Senior Guild Master" ;
    rpg:hasTag amol:Virtue .
amol:SenseOfTheLingeringMagic a rpg:Spell ;
    rpg:name "Sense of the Lingering Magic" ;
    dc:description "An Intellego Vim spell that detects many magical residues, even from weak spells, and the presence and power of active spells." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:SerloLeMercer a rpg:Character ;
    rpg:name "Serlo Le Mercer" ;
    dc:description "The mayor of London in 1220, holding all judicial and fiscal authority within the city." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Shadchan a rpg:Tag ;
    skos:prefLabel "Shadchan" ;
    dc:description "A Minor Social Status Virtue for a marriage arranger trusted by parents to find the best matrimonial match for their children." ;
    rpg:hasTag amol:Virtue .
amol:Shamash a rpg:Tag ;
    skos:prefLabel "Shamash" ;
    dc:description "A Free Social Status Virtue for the servant of the synagogue responsible for its well-being, cleanliness, and announcements, requiring the Educated (Hebrew) Virtue." ;
    rpg:hasTag amol:Virtue .
amol:ShapeAndMaterialBonuses a rpg:Tag ;
    skos:prefLabel "Shape and Material Bonuses" ;
    dc:description "Bonuses to magical and philosophical lab work derived from natural principles of affinity, similarity and sympathy; provided by ingredients and used by both magi and philosophers." ;
    skos:altLabel "Material Bonus" ;
    rpg:hasTag amol:HermeticConcept .
amol:ShapeOfTheWoodlandProwler a rpg:Spell ;
    rpg:name "Shape of the Woodland Prowler" ;
    dc:description "A Muto Corpus spell (Level 25) with an Animal requisite that transforms the target into a wolf via a wolf skin; the target may change back at will." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ShortRangedMagic a rpg:Tag ;
    skos:prefLabel "Short-Ranged Magic" ;
    dc:description "A Major Hermetic Flaw halving Casting Totals when not touching the target and halving Lab Total for effects with range greater than Touch." ;
    rpg:hasTag amol:Flaw .
amol:ShriekOfTheImpendingShafts a rpg:Spell ;
    rpg:name "Shriek of the Impending Shafts" ;
    dc:description "An Intellego Herbam spell (Level 15) that warns of incoming wooden objects via a shriek, granting +9 Defense against wooden weapons." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Sicero a rpg:Character ;
    rpg:name "Sicero" ;
    dc:description "A recently Gauntletted 23-year-old Journeyman follower of House Tremere at Triamore, filius of Goliard, who secured membership on his mater's recommendations." ;
    skos:altLabel "Sicero filius Goliard" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Sicily a schema:Place ;
    rpg:name "Sicily" ;
    dc:description "The Mediterranean island beneath whose Mount Etna the fire spirit Adranus dwells, whose inhabitants once worshipped him as a god of fire." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:SightOfTheActiveMagics a rpg:Spell ;
    rpg:name "Sight of the Active Magics" ;
    dc:description "An Intellego Vim spell that lets the caster see spells as colored, shaped auras around things and people, indicating Form and Technique." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Sihr a rpg:Tag ;
    skos:prefLabel "Sihr" ;
    dc:description "The Major Non-Hermetic Virtue (an Accelerated Ability) of the sahirs used to summon jinn and empower bargains that bind them to service." ;
    rpg:hasTag amol:Virtue .
amol:SilenceOfTheSmotheredSound a rpg:Spell ;
    rpg:name "Silence of the Smothered Sound" ;
    dc:description "A Perdo Imaginem spell (Level 20) that makes one being or object incapable of producing sound; magi so affected suffer spellcasting penalties for being unable to speak their words." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:SimpleStudent a rpg:Tag ;
    skos:prefLabel "Simple Student" ;
    dc:description "A Minor Social Status Virtue for a university student who has not yet taken a degree, gaining 30 experience points per finished year toward Latin or Artes Liberales." ;
    rpg:hasTag amol:Virtue .
amol:SirGilesAGhostlyKnight a rpg:Creature ;
    rpg:name "Sir Giles, a Ghostly Knight" ;
    dc:description "A magical ghost (Magic Might 16, Mentem) of a prideful knight in black mail who haunts his former lands, able to materialize, turn invisible, and ride a phantom black destrier." ;
    skos:altLabel "Sir Giles" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Sirmium a rpg:Faction ;
    rpg:name "Sirmium" ;
    dc:description "The last Hermetic covenant in Meissen, destroyed in the 10th century by invading Magyars; its known vis sources were destroyed along with it." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:Slothful a rpg:Tag ;
    skos:prefLabel "Slothful" ;
    dc:description "A Minor Personality Flaw in which the character is lazy and indolent, constantly seeking excuses to avoid work." ;
    rpg:hasTag amol:Flaw .
amol:SnapOfAwakening a rpg:Spell ;
    rpg:name "Snap of Awakening" ;
    dc:description "A spell that instantly awakens the target from sleep to alert consciousness when the caster snaps their fingers." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Sofer a rpg:Tag ;
    skos:prefLabel "Sofer" ;
    dc:description "A Free Social Status Virtue for the scribe who creates or repairs a Sefer Torah, requiring the ability to read and write Hebrew and the Educated (Hebrew) Virtue." ;
    rpg:hasTag amol:Virtue .
amol:SoftHearted a rpg:Tag ;
    skos:prefLabel "Soft-Hearted" ;
    dc:description "A Minor Personality Flaw in which the character cannot bear to witness suffering and avoids danger, valuing life and health above important goals." ;
    rpg:hasTag amol:Flaw .
amol:SootheTheRagingFlames a rpg:Spell ;
    rpg:name "Soothe the Raging Flames" ;
    dc:description "A Perdo Ignem spell (Level 20) that eradicates the heat of a bonfire so the flames do not spread or harm anything beyond what they already burned." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:SpasmsOfTheUncontrolledHand a rpg:Spell ;
    rpg:name "Spasms of the Uncontrolled Hand" ;
    dc:description "A Rego Corpus spell (Level 5) that makes one of the target's hands spasm, causing them to drop whatever is held." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Species a rpg:Tag ;
    skos:prefLabel "Species" ;
    dc:description "The sensory emanations of objects manipulated by Imaginem magic; transforming species lets sounds be seen and changing species bouncing off a mirror changes mirror images." ;
    rpg:hasTag amol:HermeticConcept .
amol:SpellFoci a rpg:Tag ;
    skos:prefLabel "Spell Foci" ;
    dc:description "A Minor Hermetic Virtue letting a rustic magus incorporate a small casting tool into spells to add a shape/material bonus to the Casting Total." ;
    skos:altLabel "spell focus" ;
    rpg:hasTag amol:Virtue .
amol:SpellTiming a rpg:Tag ;
    skos:prefLabel "Spell Timing" ;
    dc:description "A Minor Illusion Mystery of the Followers of Pendule granting new spell Durations (Held, Midday/Midnight, Season, While/Not/If Condition) and recurring spell effects." ;
    skos:altLabel "Spell Timing (Minor Illusion Mystery)" ;
    rpg:hasTag amol:Virtue .
amol:Spharios a rpg:Tag ;
    skos:prefLabel "Spharios" ;
    dc:description "The conscious sphere/mind of the universe at the moment of complete harmony, to which followers of the Path of Walking Backwards may ascend and rejoin in repose." ;
    skos:altLabel "Spahrios" ;
    rpg:hasTag amol:HermeticConcept .
amol:SpiritVotary a rpg:Tag ;
    skos:prefLabel "Spirit Votary" ;
    dc:description "A Mythic Companion type: a devoted worshiper of a magical spirit who in pre-Christian days would have been a high priest forming a venerating cult, now typically a solitary pagan figure opposing the Dominion." ;
    skos:altLabel "Spirit Votaries" ;
    rpg:hasTag amol:CharacterType .
amol:SpiritualPact a rpg:Tag ;
    skos:prefLabel "Spiritual Pact" ;
    dc:description "A Major Supernatural Virtue for a character who has made a pact with a powerful Magical spirit, gaining access to a Might Pool from the spirit by spending Confidence." ;
    rpg:hasTag amol:Virtue .
amol:SpontaneousCastingTools a rpg:Tag ;
    skos:prefLabel "Spontaneous Casting Tools" ;
    dc:description "A Minor Hermetic Flaw in which the character must use casting tools to cast spontaneous spells, with 15 tools one for each Art; only available to Verditius magi." ;
    rpg:hasTag amol:Flaw .
amol:Spotless a rpg:Tag ;
    skos:prefLabel "Spotless" ;
    dc:description "A Free laboratory Outfittings Virtue: the lab is impeccably clean, requiring a season's work and maintenance (+1 Health, +1 Aesthetics, +1 Creo)." ;
    skos:altLabel "Spotless Virtue" ;
    rpg:hasTag amol:Virtue .
amol:StPaul a rpg:Character ;
    rpg:name "St Paul" ;
    dc:description "A grog used in the complex combat example, on patrol with Gerard and Ignatio into a faerie forest where faeries create duplicates of them." ;
    skos:altLabel "Apostle to the Gentiles", "Paul" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:StAlbans a schema:Place ;
    rpg:name "St. Albans" ;
    dc:description "An abbey whose immunities Falkes de Bréauté violated by killing a fleeing monk and extorting money, before later doing penance there." ;
    skos:altLabel "St. Albans abbey" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:StDunstan a rpg:Character ;
    rpg:name "St. Dunstan" ;
    dc:description "Patron saint of metalworkers, locksmiths, and embroiderers; a tenth-century English Benedictine monk, Abbot of Glastonbury and later Archbishop of Canterbury, and namesake of the Eye of St Dunstan." ;
    skos:altLabel "Dunstan" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:StFrancisOfAssisi a rpg:Character ;
    rpg:name "St. Francis of Assisi" ;
    dc:description "Founder of the Franciscan order of friars (the followers of St. Francis), founded in Italy in 1209; he visited Acre during the Crusades before departing for Venice in 1220." ;
    skos:altLabel "St Francis", "St. Francis" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Station a rpg:Tag ;
    skos:prefLabel "Station" ;
    dc:description "One of five grades of progress on a Criamon path - psychological states providing wisdom and supernatural Mystery Virtues, reached by following an avenue." ;
    skos:altLabel "stations" ;
    rpg:hasTag amol:HermeticConcept .
amol:StenchOfTheTwentyCorpses a rpg:Spell ;
    rpg:name "Stench of the Twenty Corpses" ;
    dc:description "A Creo Auram spell (Level 10) that creates a horrible stench of rotting corpses, penalizing and potentially incapacitating those nearby." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Stigmata a rpg:Tag ;
    skos:prefLabel "Stigmata" ;
    dc:description "Intricate skin markings of Criamon magi representing spiritual development and progress toward enlightenment; they appear and migrate as Enigmatic Wisdom grows and cannot be removed by magic." ;
    skos:altLabel "stigma" ;
    rpg:hasTag amol:HermeticConcept .
amol:StigmaticCatalyst a rpg:Tag ;
    skos:prefLabel "Stigmatic Catalyst" ;
    dc:description "A Minor Supernatural Flaw in which the character's presence causes symbolic marks to appear on nearby people lacking Magic Resistance; normally found among House Criamon magi." ;
    rpg:hasTag amol:Flaw .
amol:StoneTellOfTheMindThatSits a rpg:Spell ;
    rpg:name "Stone Tell of the Mind that Sits" ;
    dc:description "A spell that allows a magus to converse with a rock, invoked in debates over whether inanimate objects possess minds." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:StoneOfBacchus a schema:Place ;
    rpg:name "Stone of Bacchus" ;
    dc:description "A weathered finger of rock jutting from the Rhine near Baccharach on an island with a Magic aura of 2; locals believe touching it brings luck to the wine harvest, and its festival wine becomes hallucinogenic Muto vis." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:StoryFlaw a rpg:Tag ;
    skos:prefLabel "Story Flaw" ;
    dc:description "A category of Flaw that drives stories; factors may uncover a target's Story Flaws of varying obscurity through intrigue." ;
    skos:altLabel "Story Flaws" ;
    rpg:hasTag amol:Flaw .
amol:StoryMagic a rpg:Tag ;
    skos:prefLabel "Story Magic" ;
    dc:description "A Major Folk Mystery (Virtue) allowing a maga to influence the story of her own life through story charms that bring about myth-like circumstances." ;
    rpg:hasTag amol:Virtue .
amol:Stouritus a rpg:Character ;
    rpg:name "Stouritus" ;
    dc:description "The current Primus of House Verditius and member of the covenant of Ingasia in the Theban Tribunal, who does not live at the domus magna Verdi." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:StrikeOfTheAngeredBranch a rpg:Spell ;
    rpg:name "Strike of the Angered Branch" ;
    dc:description "A Rego Herbam spell (Level 15) that causes a large tree branch to swing at a target repeatedly for +10 damage." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:StringsOfTheUnwillingMarionette a rpg:Spell ;
    rpg:name "Strings of the Unwilling Marionette" ;
    dc:description "A Rego Corpus spell (Level 25) that lets the caster control the physical movements of a conscious person." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:StrongFaith a rpg:Tag ;
    skos:prefLabel "Strong Faith" ;
    dc:description "A Minor, Supernatural Virtue granting a +2 to social rolls with faeries and Common Sense in faerie-related situations." ;
    skos:altLabel "Familiarity with the Fae" ;
    rpg:hasTag amol:Virtue .
amol:StrongWilled_2 a rpg:Tag ;
    skos:prefLabel "Strong Willed" ;
    dc:description "A Virtue gained through Clan Sirnas's Trial of Self Control, alongside Deleterious Circumstances when hungry." ;
    rpg:hasTag amol:Virtue .
amol:StudentOfRealm a rpg:Tag ;
    skos:prefLabel "Student of (Realm)" ;
    dc:description "A Minor General Virtue giving training in the mystical aspects of one of the four realms of power, with a +2 bonus on uses of the appropriate Lore." ;
    rpg:hasTag amol:Virtue .
amol:Suffusio a rpg:Creature ;
    rpg:name "Suffusio" ;
    dc:description "A Serious Melancholic Disease, a congregation of humor between lens and pupil obstructing sight; treated by 'couching'." ;
    skos:altLabel "glaucosis", "suffusio nigra" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:SummoningTheDistantImage a rpg:Spell ;
    rpg:name "Summoning the Distant Image" ;
    dc:description "An Intellego Imaginem spell that lets the caster see and hear what is happening in a distant place via an Arcane Connection to the location or a person there." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Sursum a schema:Place ;
    rpg:name "Sursum" ;
    dc:description "Covenant founded in 875 on the north coast of Cornwall, destroyed during Athelstan's campaigns in 931 amid evidence of Tytalus diabolism." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:SusceptibilityToFaeriePower a rpg:Tag ;
    skos:prefLabel "Susceptibility to Faerie Power" ;
    dc:description "A Minor Hermetic Flaw in which the character is especially susceptible to the fay, becoming disoriented in Faerie auras and having Magic Resistance halved against faerie effects." ;
    rpg:hasTag amol:Flaw .
amol:SymbolicMagic a rpg:Tag ;
    skos:prefLabel "Symbolic Magic" ;
    dc:description "A Major Folk Mystery (Virtue) encompassing laboratory activities with charms and symbols, allowing charms in invested devices and talismans and new Symbol Range, Duration, and Target for ritual spells." ;
    rpg:hasTag amol:Virtue .
amol:SynthemataMagic a rpg:Tag ;
    skos:prefLabel "Synthemata Magic" ;
    dc:description "A Mystery whose practitioners, knowing a magus's secret name, gain an advantage when casting spells against him." ;
    rpg:hasTag amol:Virtue .
amol:Tabanus a rpg:Character ;
    rpg:name "Tabanus" ;
    dc:description "A Quaesitor of House Guernicus, trained at Magvillus, sent to police the Rhine; a strict, meddlesome peregrinator who recently occupied a sanctum at Triamore." ;
    skos:altLabel "Gadfly of the Rhine", "Tabanus filius Jart" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Tagelyn a rpg:Faction ;
    rpg:name "Tagelyn" ;
    dc:description "A covenant that, with Blackthorn, excavated caves in the Black Mountains over two centuries; its magi were driven out by Blackthorn and founded Ashenrise in Hibernia." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:TaintedTreasure a rpg:Tag ;
    skos:prefLabel "Tainted Treasure" ;
    dc:description "A Minor General Tainted Virtue: the character has inherited or acquired vast cursed treasure that brings harm and only allows itself to be spent sinfully." ;
    rpg:hasTag amol:Virtue .
amol:TalonsOfTheWinds a rpg:Spell ;
    rpg:name "Talons of the Winds" ;
    dc:description "A Muto Auram spell (Level 20) that transforms a wind into an abrasive medium that tears at everything in its path, inflicting +4 damage from cuts; requires an existing breeze." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TangentialMagi a rpg:Tag ;
    skos:prefLabel "Tangential Magi" ;
    dc:description "Criamon magi who have faded peacefully into Final Twilight and dwell in the Hypostasis outside time, sending visions through the Axis to their mortal successors." ;
    skos:altLabel "tangential immortal", "the tangential" ;
    rpg:hasTag amol:CharacterType .
amol:TangleOfWoodAndThorns a rpg:Spell ;
    rpg:name "Tangle of Wood and Thorns" ;
    dc:description "A Rego Herbam (ReHe 15) indirect spell that immobilizes a magus with wood without touching him, completely effective in bypassing Magic Resistance." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TarlanTheWolf a rpg:Creature ;
    rpg:name "Tarlan the Wolf" ;
    dc:description "A faerie wolf (Might 20, Animal) that exists to hunt people, marking them as quarry and harrying them to exhaustion; he cannot enter holy ground and never hunts children or the Gifted." ;
    skos:altLabel "Tarlan" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:TemplarCommander a rpg:Tag ;
    skos:prefLabel "Templar Commander" ;
    dc:description "A Major Social Status Virtue for a commander of the Poor Knights of the Temple of Solomon with authority over a province or preceptory, also granting Temporal Influence." ;
    rpg:hasTag amol:Virtue .
amol:TheAshOfNortorf a rpg:Creature ;
    rpg:name "The Ash of Nortorf" ;
    dc:description "An infernal entity (Infernal Might 15, potential 60) manifesting as an ash seedling in the churchyard of Nortorf; prophesied to grow into a tree that will bring a king with fell powers if a black horseman defeats the white horseman." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:TheBrocken a schema:Place ;
    rpg:name "The Brocken" ;
    dc:description "The highest peak of the Harz and one of Germany's most potent supernatural sites, topped by the Witches' Altar and a focus of Walpurgis Night witchcraft, with a Faerie aura." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheBuranOfYenghissar a rpg:Creature ;
    rpg:name "The Buran of Yenghissar" ;
    dc:description "An Infernal desert storm spirit and corrupt jinni (Might 25, Auram) that manifests as a vortex of black sand, plaguing the village of Yenghissar and now bound within a sahir's ancestral sword." ;
    skos:altLabel "Buran of Yenghissar, The", "buran" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:TheCaptiveVoice a rpg:Spell ;
    rpg:name "The Captive Voice" ;
    dc:description "An Imaginem spell that a magus can vary to collect a poet's spoken poem, the captured words acting as an Arcane Connection to the poet until the spell ends." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheCollegium a rpg:Faction ;
    rpg:name "The Collegium" ;
    dc:description "A Hermetic societas of about a dozen Platonist magi from different Houses, founded by Xenophon of Bonisagus, dedicated to investigating the nature of magic through experimentation and Philosophiae." ;
    skos:altLabel "Collegium magi" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:TheCrystalOfAHundredCandles a rpg:Item ;
    rpg:name "The Crystal of a Hundred Candles" ;
    dc:description "An enchanted crystal embedded in the ceiling of Arliandus's sanctum that blooms into light to illuminate the whole chamber when the door opens." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheDonarOak a rpg:Creature ;
    rpg:name "The Donar Oak" ;
    dc:description "A divine spirit (Divine Might 40) at Geismar, formerly the focal point of the pagan power of the Hercynian Forest; its acorns are worth Creo vis and can tame animals and forests." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:TheDoorOfDeimos a rpg:Item ;
    rpg:name "The Door of Deimos" ;
    dc:description "An enchanted iron door created by Arliandus and named after the son of Ares, embossed with faces and skulls and invested with effects that recognize and repel intruders." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheDrudenbaumOfHarberg a rpg:Creature ;
    rpg:name "The Drudenbaum of Harberg" ;
    dc:description "A mythical tree spirit (Magic Might 30) atop the Harberg near Nuremberg where wizards meet; its golden drops are Creo vis and its milk is Vim vis, and it possesses trees to assume its form." ;
    skos:altLabel "Drudenbaum" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:TheEarthSCarbuncle a rpg:Spell ;
    rpg:name "The Earth's Carbuncle" ;
    dc:description "A Rego Terram spell (with Muto requisite) that turns a 1-pace circle of ground into jagged stone that bursts upward, throwing those standing on it." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheEnigmaSGift a rpg:Spell ;
    rpg:name "The Enigma's Gift" ;
    dc:description "A Creo Vim spell that inflicts four Warping Points on a target and forces a Hermetic magus to check for Twilight." ;
    skos:altLabel "Enigma's Gift, The" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheFallingEvil a rpg:Creature ;
    rpg:name "The Falling Evil" ;
    dc:description "A Major General Flaw in which the character suffers random convulsions and blackouts, leaving him temporarily Incapacitated, often caused by demonic possession." ;
    skos:altLabel "epilepsy", "morbus caducus", "the sacred disease" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:TheFaneOfTheFounders a rpg:Item ;
    rpg:name "The Fane of the Founders" ;
    dc:description "A powerful artifact in a hidden Black Forest glade, a twelve-sided stone slab into which the Cult of Mercury bound much of the forest's magical essence; site of the secret seven-yearly rite renewing the Founders' vows." ;
    skos:altLabel "the Fane" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheForestBrothers a rpg:Creature ;
    rpg:name "The Forest Brothers" ;
    dc:description "Three pagan gods of Rugen, Rugevit, Porevit, and Porenitz, representing the Rowan, the Beech, and the Larch, still worshipped by male priests called volkhvy." ;
    skos:altLabel "Rugevit, Porevit, and Porenitz" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:TheForgivingEarth a rpg:Spell ;
    rpg:name "The Forgiving Earth" ;
    dc:description "A Rego Terram spell that loosens earth in a 15-by-15-pace area to a depth of one foot, making packed dirt as loose as plowed ground." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheForumOfHermes a schema:Place ;
    rpg:name "The Forum of Hermes" ;
    dc:description "An enclosed miniature amphitheater at Durenmar, built on a Roman temple and flanked by statues of the Twelve Founders, where Rhine and Grand Tribunals meet." ;
    skos:altLabel "Forum", "the Forum" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheGastronomers a rpg:Faction ;
    rpg:name "The Gastronomers" ;
    dc:description "A large Jerbiton league whose members take turns hosting annual lavish feasts and who organize the great feasts including the Tribunicals and Seculars." ;
    skos:altLabel "League of Gastronomers" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:TheGiftVirtue a rpg:Tag ;
    skos:prefLabel "The Gift (Virtue)" ;
    dc:description "Referenced as a Virtue covered later in the rules that allows characters to learn Supernatural Abilities and is the most important exception to Ability-use restrictions." ;
    rpg:hasTag amol:Virtue .
amol:TheGiftOfReason a rpg:Spell ;
    rpg:name "The Gift of Reason" ;
    dc:description "A Creo Mentem ritual (Level 35) that permanently increases the target's Intelligence by 1 point, to no higher than 0." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheGiftOfVigor a rpg:Spell ;
    rpg:name "The Gift of Vigor" ;
    dc:description "A spell whose variants a magus attempts to use to transfer vital faculty (bodily energy such as fatigue) from a living being into a dead one." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheGladeOfTheSevenWaterfalls a schema:Place ;
    rpg:name "The Glade of the Seven Waterfalls" ;
    dc:description "A magical glade deep in the Black Forest with Magic Might 80, the remnant of the forest's original genius locus, whose peaceful spirit allows only those who complete Quests to ascend each of its seven waterfalls (regio levels)." ;
    skos:altLabel "the Seven Waterfalls" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheHarzMountains a schema:Place ;
    rpg:name "The Harz Mountains" ;
    dc:description "A desolate fifty-mile granite mountain range in northern Germany with gloomy forests, caves, and dwarflike folk; home to many supernatural sites." ;
    skos:altLabel "the Harz" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheHeathenWitchReborn a rpg:Spell ;
    rpg:name "The Heathen Witch Reborn" ;
    dc:description "A general Perdo Vim spell invented by Philippus Niger that reverses any shapechanging spell or supernatural Ability if the spell level +10 beats the shapechange." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheHolmOakOfRomowe a rpg:Creature ;
    rpg:name "The Holm Oak of Romowe" ;
    dc:description "A malevolent magic spirit (Magic Might 45, currently 30 due to entrapment) bound within a massive evergreen oak in the sacred grove of Romowe; it can grant the Depression Flaw and possess those who take its branches." ;
    skos:altLabel "Romowe", "the malevolent spirit of Romowe" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:TheHolyGrail a rpg:Item ;
    rpg:name "The Holy Grail" ;
    dc:description "The sacred relic brought to Gaul by Mary Magdalene and revealed by Clovis to the Frankish kingdom, later lost when the Merovingian dynasty fell from grace." ;
    skos:altLabel "Grail" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheHumbleBrethren a rpg:Faction ;
    rpg:name "The Humble Brethren" ;
    dc:description "A Jerbiton league based in Rome that tries to influence the College of Cardinals to prevent an anti-magical Pope; includes mistresses of four Cardinals." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:TheLineageOfPralix a rpg:Faction ;
    rpg:name "The Lineage of Pralix" ;
    dc:description "An Ex Miscellanea tradition descended from Pralix that inducts hedge wizards into the Order, jointly trains apprentices, and grants the Comprehend Magic virtue." ;
    skos:altLabel "Children of Pralix", "Filii Pralicis", "Pralician", "Pralicians" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:TheLotharingians a rpg:Faction ;
    rpg:name "The Lotharingians" ;
    dc:description "A faction of northwestern Rhine covenants seeking to secede from the Rhine Tribunal to deal more freely with mundanes, forming the proposed Lotharingian Tribunal." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:TheMargravateOfBrandenburg a schema:Place ;
    rpg:name "The Margravate of Brandenburg" ;
    dc:description "The only notable city of the Margravate east of the Elbe, occupying an old Wendish settlement across three islands in the River Havel, with a cathedral and the first bishopric east of the Elbe." ;
    skos:altLabel "Brandenburg", "March of Brandenburg" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheMargravateOfMeissen a schema:Place ;
    rpg:name "The Margravate of Meissen" ;
    dc:description "The most civilized of the Eastern Marches, a rolling land ruled by the Wettin dynasty since 1089; the last Hermetic covenant here, Sirmium, was destroyed in the 10th century." ;
    skos:altLabel "Meissen" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheMiceOfTheMauseturm a rpg:Creature ;
    rpg:name "The Mice of the Mauseturm" ;
    dc:description "Demonic mouse swarms (Infernal Might 10) with fiery teeth, immune to fire, that infest the Mouse Tower island and are spontaneously generated by its Infernal aura." ;
    skos:altLabel "demonic mice" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:TheMinerSKeenEye a rpg:Spell ;
    rpg:name "The Miner's Keen Eye" ;
    dc:description "An Intellego Terram spell that lets the caster see a specified type of mineral through up to 3 paces of intervening material." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheMirrorOfDreams a rpg:Item ;
    rpg:name "The Mirror of Dreams" ;
    dc:description "An ornate gold-framed enchanted mirror in Arliandus's sanctum that visualizes a subject's thoughts to aid Mentem lab work, but causes Warping Points and disturbing dreams." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheMouseTower a schema:Place ;
    rpg:name "The Mouse Tower" ;
    dc:description "The Mauseturm, a half-ruined slender tower on a small island at the mouth of the Bingen Hole built by Hatto II, now haunted by his demonic shade and infested with demonic mice (Infernal aura 3)." ;
    skos:altLabel "Mauseturm", "Mäuseturm" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheNemthengacha a rpg:Faction ;
    rpg:name "The Nemthengacha" ;
    dc:description "A sect of Ex Miscellanea magi found among Celtic and Scandinavian sorcerers who use the Embitterment power to create animosity and turn people against allies." ;
    skos:altLabel "Nemthenga", "Nemthengacha, The", "bitter-tongues", "deceivers", "poisontongues" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:ThePathOfSeeming a rpg:Tag ;
    skos:prefLabel "The Path of Seeming" ;
    dc:description "A Criamon path drawing on the insight that the Enigma's secrets are hidden in the distracting details of the world, searching for weak points in the circle of time." ;
    rpg:hasTag amol:HermeticConcept .
amol:TheRusticani a rpg:Faction ;
    rpg:name "The Rusticani" ;
    dc:description "An obscure tradition of folk magicians in House Ex Miscellanea who build spells and enchanted devices from mundane objects and live among common people." ;
    skos:altLabel "Mechanicals", "Rustici", "rustic magi" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:TheSilentOnes a rpg:Faction ;
    rpg:name "The Silent Ones" ;
    dc:description "A Jerbiton league dedicated to integrating the Silent Magic and Subtle Magic Virtues into standard Hermetic practice, led by a Bonisagus magus." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:TheTeufelsloch a schema:Place ;
    rpg:name "The Teufelsloch" ;
    dc:description "A giant eroded hole in the hills west of Laach Lake with steep treacherous edges and an Infernal aura of 1, named the Devil's Hole by locals." ;
    skos:altLabel "Devil's Hole" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheTeutoburgerForest a schema:Place ;
    rpg:name "The Teutoburger Forest" ;
    dc:description "A forested hill region in Saxony with powerful tree guardians (Magic Might 50), site of a famous victory over Roman legions, who remain trapped in a regio at its heart." ;
    skos:altLabel "Battle of the Teutoburger Forest", "the Teutoburger" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheTitans a rpg:Creature ;
    rpg:name "The Titans" ;
    dc:description "Primordial spirits who, per House Tytalus belief, created the world and man before being imprisoned by the gods of Olympus; Tytalus contacted their shades and employed them against Guorna." ;
    skos:altLabel "Elder Titans", "Younger Titans" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:TheTravelsOfFedoso a rpg:Item ;
    rpg:name "The Travels of Fedoso" ;
    dc:description "An epic poem written by the Primus Verderis used by apprentices to learn Latin, claimed by many Criamon to be a prophetic map of the House's future." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheTreacherousSpear a rpg:Spell ;
    rpg:name "The Treacherous Spear" ;
    dc:description "A Rego Herbam spell (Level 25) that animates a wooden or wooden-hafted melee weapon in someone else's hand, making it attack its holder until the wielder dies or the weapon is destroyed." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheTrierAmphitheater a schema:Place ;
    rpg:name "The Trier Amphitheater" ;
    dc:description "A large oval Roman amphitheater outside Trier's walls (Magic aura 1-2) on the Hermesstrasse, haunted by three ghostly gladiators who challenge visitors to duels and where Mentem vis can be harvested." ;
    skos:altLabel "The Amphitheater" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheTrumpetOfGhostlySummoning a rpg:Item ;
    rpg:name "The Trumpet of Ghostly Summoning" ;
    dc:description "A small enchanted silver trumpet from Arliandus's sanctum that, when blown, summons forth and reveals ghosts or spirits in the area." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheUnseenPorter a rpg:Spell ;
    rpg:name "The Unseen Porter" ;
    dc:description "A Rego Terram spell like Unseen Arm that can carry large inanimate objects with the strength of a very strong person." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheWizardSMount a rpg:Spell ;
    rpg:name "The Wizard's Mount" ;
    dc:description "A Creo Animal spell (Level 35) that creates a horse normal in every way except that it is not disturbed by The Gift." ;
    skos:altLabel "Wizard's Mount, The" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheoderichOfAugsburg a rpg:Character ;
    rpg:name "Theoderich of Augsburg" ;
    dc:description "A journeyman of House Jerbiton at Heorot, formerly of Oculus Septentrionalis, a necromancer and historian who raises ghosts to interrogate them about the past." ;
    skos:altLabel "Theoderich", "Theoderich of Augsburg, Follower of Jerbiton" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:TheologyJudaism a rpg:Proficiency ;
    rpg:name "Theology: Judaism" ;
    dc:description "An Academic Ability that is the Jewish equivalent of Theology: Christian, drawing on the Torah, Nevi'im, and Kutuvim." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:Thessalonica a schema:Place ;
    rpg:name "Thessalonica" ;
    dc:description "Site of a great fair (the Demetria) rivaling Champagne in size and goods; its proximity to Constantinople makes eastern luxuries readily available." ;
    skos:altLabel "Demetria" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Tierent a rpg:Character ;
    rpg:name "Tierent" ;
    dc:description "A 12th-century Verditius magus who adapted the Bind Magical Creatures Mystery to affect creatures with Faerie Might." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:TolosaParatge a rpg:Faction ;
    rpg:name "Tolosa Paratge" ;
    dc:description "An ancient covenant in Toulouse in the Provencal Tribunal, completely split between two factions, the White and the Black, a rivalry that may bring it down." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:Torven a rpg:Character ;
    rpg:name "Torven" ;
    dc:description "A reclusive young hedge wizard of Waldheim with Latent Magical Ability who befriends forest creatures and is accompanied by the faerie wolf Red-Hame." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:TownMagistrate a rpg:Tag ;
    skos:prefLabel "Town Magistrate" ;
    dc:description "A Minor Social Status Virtue granting a position of judicial responsibility in a town with a small staff of officials, requiring citizenship and a score of 3 in Civil and Canon Law (or Common Law)." ;
    rpg:hasTag amol:Virtue .
amol:TracingTheTrailOfDeathSStench a rpg:Spell ;
    rpg:name "Tracing the Trail of Death's Stench" ;
    dc:description "A spell used by Donatores to locate the corporeal remains of a spirit from the location of its death or gravesite." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TragicLife a rpg:Tag ;
    skos:prefLabel "Tragic Life" ;
    dc:description "A Major Story Tainted Flaw in which the character's life has been manipulated by demons so that she will act to her own detriment at a pivotal moment of destiny." ;
    skos:altLabel "Tragic Life Flaw" ;
    rpg:hasTag amol:Flaw .
amol:TrainedAssassin a rpg:Tag ;
    skos:prefLabel "Trained Assassin" ;
    dc:description "A Minor General Virtue available only to characters with a Nizari Social Status Virtue, granting 50 experience points in Martial Abilities, Athletics, Guile, or Stealth." ;
    rpg:hasTag amol:Virtue .
amol:TransformToWater a rpg:Spell ;
    rpg:name "Transform to Water" ;
    dc:description "A spell whose constant effect is mimicked by the Water sample elemental form of a Bjornaer chimera or anima heartbeast." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TransformationOfTheRavenousBeastToTheTorpidToad a rpg:Spell ;
    rpg:name "Transformation of the Ravenous Beast to the Torpid Toad" ;
    dc:description "A Muto Animal (MuAn 25) spell known by the Bjornaer template magus that transforms an animal into a toad." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TransformationOfTheThornyStaff a rpg:Spell ;
    rpg:name "Transformation of the Thorny Staff" ;
    dc:description "A Muto Herbam spell (Level 10) that causes a length of wood to grow thick sharp thorns; adds +4 damage if cast on a staff." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TremulousVaultOfTheTorchSFlame a rpg:Spell ;
    rpg:name "Tremulous Vault of the Torch's Flame" ;
    dc:description "A Rego Ignem spell (Level 5) that causes a fire to quiver and then leap up to 10 feet in any direction; a Targeting roll is required to hit a specific target." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TribunalSummons a rpg:Tag ;
    skos:prefLabel "Tribunal Summons" ;
    dc:description "A formal summons to a Hermetic tribunal that Redcaps must deliver at least six months before the tribunal takes place; rigorously enforced." ;
    rpg:hasTag amol:HermeticConcept .
amol:TrueName a rpg:Tag ;
    skos:prefLabel "True Name" ;
    dc:description "A secret name expressing a being's spiritual essence, serving as an indefinite-duration Arcane Connection; demons, angels, jinn, and Daimons all have one, learned at a cost of 5 experience points." ;
    skos:altLabel "True Names", "magical True Name" ;
    rpg:hasTag amol:HermeticConcept .
amol:TwilightScar a rpg:Tag ;
    skos:prefLabel "Twilight Scar" ;
    dc:description "A lasting supernatural mark left on a magus by Twilight episodes; Philippus Niger bears many, including one that causes only male children to be born where he lives." ;
    rpg:hasTag amol:HermeticConcept .
amol:TwistOfTheTongue a rpg:Spell ;
    rpg:name "Twist of the Tongue" ;
    dc:description "A Perdo Corpus spell that twists the target's tongue into a spiral, destroying the ability to speak; a grave offense to a magus." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TwoHeadedHound a rpg:Creature ;
    rpg:name "Two-headed Hound" ;
    dc:description "A corrupt beast (Might 10, Animal) appearing as a huge two-headed dog whose heads hate each other; able to spit fire, created by a diabolist as a sanctum guard." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:TzadikNistar a rpg:Tag ;
    skos:prefLabel "Tzadik Nistar" ;
    dc:description "A Major Story Flaw in which the character is one of the Tzadikim Nistarim, the 36 hidden righteous on whom the world's continuation relies, destined to face a moment of moral decision." ;
    skos:altLabel "Tzadikim Nistarim" ;
    rpg:hasTag amol:Flaw .
amol:UnbearableToBeings a rpg:Tag ;
    skos:prefLabel "Unbearable to (Beings)" ;
    dc:description "A Minor Hermetic or General Flaw in which one of three classes of beings is extremely disturbed by the character, adding -3 to social interactions; only for characters with The Gift or Magical Air." ;
    rpg:hasTag amol:Flaw .
amol:UnboundTongue a rpg:Tag ;
    skos:prefLabel "Unbound Tongue" ;
    dc:description "A Minor Supernatural Virtue: when transformed into a non-human form, the character may speak any human languages he knows without impediment, and a magus may still cast spells with his voice." ;
    rpg:hasTag amol:Virtue .
amol:UnhappilyMarried a rpg:Tag ;
    skos:prefLabel "Unhappily Married" ;
    dc:description "A major Story Flaw where a merchant has married for money rather than love and seeks solace outside the marital bed, hiding affairs from spouse and family." ;
    rpg:hasTag amol:Flaw .
amol:Unicorn a rpg:Creature ;
    rpg:name "Unicorn" ;
    dc:description "A legendary horned beast whose horn provides Shape and Material bonuses to healing (+8), poison detection (+10), and fertility (+11)." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:UniversityDean a rpg:Tag ;
    skos:prefLabel "University Dean" ;
    dc:description "A Major Story Flaw in which the character is the head of a university overseeing internal and external affairs; requires the Doctor in (Faculty) Virtue and age 40+." ;
    rpg:hasTag amol:Flaw .
amol:UniversityGrammarTeacher a rpg:Tag ;
    skos:prefLabel "University Grammar Teacher" ;
    dc:description "A Minor Social Status Virtue for a character employed by a university to teach grammar to younger members, able to purchase Latin and Artes Liberales." ;
    rpg:hasTag amol:Virtue .
amol:UniversityOfNaples a schema:Place ;
    rpg:name "University of Naples" ;
    dc:description "A planted university to be instituted by Frederick II of Naples in 1224, drawing masters from Salerno." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:UniversityOfSalamanca a schema:Place ;
    rpg:name "University of Salamanca" ;
    dc:description "A royal Spanish university founded by Alfonso IX of León in 1218, notable for offering a music degree and admitting women scholars." ;
    skos:altLabel "Salamanca" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:UnrulyAir a rpg:Tag ;
    skos:prefLabel "Unruly Air" ;
    dc:description "A Minor Supernatural Flaw in which the character's presence subtly pushes others to extreme behavior in social situations; those with Magic Resistance are unaffected." ;
    rpg:hasTag amol:Flaw .
amol:Valkyrie a rpg:Creature ;
    rpg:name "Valkyrie" ;
    dc:description "Faerie minor goddesses of the Norse pantheon (Might 20) who ride wolves above battlefields to select the worthy dead for transformation into einherjar; they also serve as maids in Valhalla." ;
    skos:altLabel "Chooser of the Slain", "Shield maidens", "Valkyries" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Vederis a rpg:Character ;
    rpg:name "Vederis" ;
    dc:description "A famous magus of House Criamon who wrote The Travels of Fedoso, a classic work of esoteric lore." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:VenusBlessing a rpg:Tag ;
    skos:prefLabel "Venus' Blessing" ;
    dc:description "A Minor General Virtue giving +3 on Communication and Presence rolls with sexually compatible characters in appropriate situations." ;
    rpg:hasTag amol:Virtue .
amol:Vernus a rpg:Faction ;
    rpg:name "Vernus" ;
    dc:description "A weak, Struggling Spring covenant of six magi consisting of tents around a standing stone in a clearing within a faerie-forest magical regio, contesting its sole vis source with faeries." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:Viaticarus a rpg:Tag ;
    skos:prefLabel "Viaticarus" ;
    dc:description "A Minor Supernatural Flaw in which the character survived after receiving Extreme Unction, leaving him immune to demonic temptation but increasingly corpse-like and unable to cross certain wards." ;
    rpg:hasTag amol:Flaw .
amol:Viea a rpg:Character ;
    rpg:name "Viea" ;
    dc:description "Trianoma's jealous twin sister who interpreted her visions, then stole valuable texts and fled; her fate remains unknown." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:ViperSGaze a rpg:Spell ;
    rpg:name "Viper's Gaze" ;
    dc:description "A Rego Animal spell (Level 15) that holds an animal rigid as long as the caster maintains eye contact and concentrates." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:VoiceOfTheLake a rpg:Spell ;
    rpg:name "Voice of the Lake" ;
    dc:description "An Intellego Aquam spell (Level 25) that lets the caster hold a conversation with a body of water about things in contact with it." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Vortigern a rpg:Character ;
    rpg:name "Vortigern" ;
    dc:description "The usurper king who invited the Saxons under Hengist and Horsa into Britain and consulted Merlin about his collapsing tower." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:VulnerableCasting a rpg:Tag ;
    skos:prefLabel "Vulnerable Casting" ;
    dc:description "A Hermetic Flaw causing extra Fatigue loss when casting, gained from Ordeals or bad Twilight effects; cannot be started with alongside Withstand Casting." ;
    rpg:hasTag amol:Flaw .
amol:Waldheim a schema:Place ;
    rpg:name "Waldheim" ;
    dc:description "A tiny reclusive hamlet in a glade (Magic aura 2) deep in the Westerwald near the former covenant of Oakdell, inhabited by hedge wizards loyal to the Court of Bright Winter." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:WallOfProtectingStone a rpg:Spell ;
    rpg:name "Wall of Protecting Stone" ;
    dc:description "A Creo Terram spell that makes a wall of granite up to 25 paces wide, 4 paces high, and 1 pace thick." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Walpurga a rpg:Creature ;
    rpg:name "Walpurga" ;
    dc:description "A powerful beneficent faerie lady (Faerie Might 50) of the Seelie Court representing summer and growth, who appears at the Witches' Altar on Walpurgis Night to summon summer." ;
    skos:altLabel "Queen of the Holzfrau", "the goddess Walpurga" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:WandOfBestialAgony a rpg:Item ;
    rpg:name "Wand of Bestial Agony" ;
    dc:description "A lesser enchanted wand belonging to Mari Amwithig that Hephaestion reforges in an example, with a Rego Vim power of effect level 20." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:Wanderer a rpg:Tag ;
    skos:prefLabel "Wanderer" ;
    dc:description "A free Social Status Virtue recommended for performance artists and held by Brogo, marking an itinerant performer." ;
    rpg:hasTag amol:Virtue .
amol:WardAgainstFaeriesOfTheWood a rpg:Spell ;
    rpg:name "Ward Against Faeries of the Wood" ;
    dc:description "A Rego Herbam ward spell (General) protecting a magic circle against faeries of the wood, modeled on the Aquam version." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:WardAgainstRain a rpg:Spell ;
    rpg:name "Ward Against Rain" ;
    dc:description "A Rego Auram spell (Level 10) ensuring no rain falls on the caster regardless of the weather." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Warding a rpg:Proficiency ;
    rpg:name "Warding" ;
    dc:description "An Accelerated Supernatural Ability of the Columbae for warding away natural things and supernatural beings with Might by inscribing arcane symbols into a circle; predates and was integrated into Hermetic magic." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:WarpedMagic a rpg:Tag ;
    skos:prefLabel "Warped Magic" ;
    dc:description "A Hermetic Flaw causing a magus' magic to display an unusual side effect; Balastor's causes his features to take on a savage, feral cast." ;
    rpg:hasTag amol:Flaw .
amol:WavesOfDrowningAndSmashing a rpg:Spell ;
    rpg:name "Waves of Drowning and Smashing" ;
    dc:description "A Rego Aquam spell (Level 30) that raises a wave five feet high and thirty paces wide capable of submerging swimmers and overturning rowboats." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:WeakMagic a rpg:Tag ;
    skos:prefLabel "Weak Magic" ;
    dc:description "A Minor Hermetic Flaw in which a magus's magic is poor at penetrating Magic Resistance, halving the Penetration Total for all spells." ;
    rpg:hasTag amol:Flaw .
amol:WeaverSTrapOfWebs a rpg:Spell ;
    rpg:name "Weaver's Trap of Webs" ;
    dc:description "A Creo Animal (CrAn 35) indirect spell that surrounds and immobilizes a magus with webs without touching him, partly effective without penetrating Magic Resistance." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:WeirdMagic a rpg:Tag ;
    skos:prefLabel "Weird Magic" ;
    dc:description "A Minor Hermetic Flaw making a magus's control over magic loose, adding an extra strange botch die on stressed casting rolls." ;
    skos:altLabel "Weird Magic Flaw" ;
    rpg:hasTag amol:Flaw .
amol:WilhelmWeiss a rpg:Character ;
    rpg:name "Wilhelm Weiss" ;
    dc:description "A Gentle-Gifted Jerbiton magus and master of Fengheld at the Rheingasse chapter in Cologne who poses as a wealthy merchant and co-leads the Apple Gild." ;
    skos:altLabel "Wilhelm Weiss of House Jerbiton", "Wilhelm Weiss of Jerbiton", "Wilhem" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:WilliamDeLongespee a rpg:Character ;
    rpg:name "William de Longespee" ;
    dc:description "Earl of Salisbury since 1198 and a bastard son of Henry II; a close counselor of King John and a ruthless opportunist disputing Lincoln with Nicola de Hay." ;
    skos:altLabel "William", "William Longespee", "earl of Salisbury" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:WillowMaiden a rpg:Creature ;
    rpg:name "Willow Maiden" ;
    dc:description "The manipulative, uncaring faerie ruler of the eastern Willow Forest among the Courts of the Seasons, whose power waxes in autumn and who entraps the Alder Prince." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:WitchesOfThessaly a rpg:Faction ;
    rpg:name "Witches of Thessaly" ;
    dc:description "A tradition descended from reclusive Thessalian worshipers of underworld gods who practiced sorcery and necromancy; Trianoma was a member, and some remain in contact with the Daughters of Erictho." ;
    skos:altLabel "Thessalian", "Thessalians" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:WithstandCasting a rpg:Tag ;
    skos:prefLabel "Withstand Casting" ;
    dc:description "A Minor Hermetic Virtue letting a magus lose fewer Fatigue levels (minimum 1) when casting spells; can be taken multiple times for greater effect." ;
    rpg:hasTag amol:Virtue .
amol:WizardSIcyGrip a rpg:Spell ;
    rpg:name "Wizard's Icy Grip" ;
    dc:description "A Perdo Ignem spell (Level 30) that chills a single target for +20 damage, freezing it solid if killed; armor does not add to Soak against it." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:WolframVonEschenbach a rpg:Character ;
    rpg:name "Wolfram von Eschenbach" ;
    dc:description "A famous German minnesinger and poet at the court of Hermann I of Thuringia, author of Parzival; used as an example of a character with both Profession: Minnesinger and Craft: Poetry." ;
    skos:altLabel "Wolfram" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Wolkan a rpg:Character ;
    rpg:name "Wolkan" ;
    dc:description "A branded criminal freed by Lord Robert to help collect tolls on Pfalz Island; a skilled thief and boatman with criminal contacts up and down the Rhine." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:WordsOfTheFlickeringFlame a rpg:Spell ;
    rpg:name "Words of the Flickering Flame" ;
    dc:description "An Intellego Ignem spell (Level 35) that allows the caster to converse with a fire, which is commonly chaotic and distractible." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Wrathful a rpg:Tag ;
    skos:prefLabel "Wrathful" ;
    dc:description "A Personality Flaw making a character prone to anger; held by the Berserker grog and Flambeau template magus." ;
    rpg:hasTag amol:Flaw .
amol:Wrecked a rpg:Tag ;
    skos:prefLabel "Wrecked" ;
    dc:description "A Free laboratory Outfittings Flaw: the lab is very heavily damaged from a major accident, taking two seasons to repair (-5 General Quality, -2 Safety, -2 Aesthetics)." ;
    skos:altLabel "Wrecked Flaw" ;
    rpg:hasTag amol:Flaw .
amol:XavierOfHouseMercere a rpg:Character ;
    rpg:name "Xavier of House Mercere" ;
    dc:description "Archivist of the Rhine Tribunal, attributed as the source of an in-world quotation about the Bingen Hole." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Ygerna a rpg:Character ;
    rpg:name "Ygerna" ;
    dc:description "Gorlois's wife, sought by Uther; she received the disguised Uther into her bed at Tintagel and conceived Arthur." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Zelos a rpg:Creature ;
    rpg:name "Zelos" ;
    dc:description "The Daimon of rivalry, envy, and competition, appearing as a winged Greek youth with a laurel crown; he propagates contention but never helps resolve conflicts." ;
    skos:altLabel "Aspect of Zelos", "Rivalry" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Zeus a rpg:Character ;
    rpg:name "Zeus" ;
    dc:description "The god who raised Orpheus's lyre into the stars, taken by the Orphic cult as a sign of Orpheus's apotheosis." ;
    skos:altLabel "Lord of the Sky" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Zwergenstimme a rpg:Creature ;
    rpg:name "Zwergenstimme" ;
    dc:description "A Magic spirit of an echo (Might 15, Imaginem) that lurks in caves and ravines, can mimic sounds, hurl rocks, and collapse cave roofs; its name means 'dwarf voice' in German." ;
    skos:altLabel "dwarf voice", "echo spirit" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Alim a rpg:Tag ;
    skos:prefLabel "'Alim" ;
    dc:description "A Minor Social Status Virtue for a member of the Islamic religious elite, such as a muezzin, imam, mufti, or qadi." ;
    skos:altLabel "mufti", "qadi" ;
    rpg:hasTag amol:Virtue .
amol:DeadLanguage a rpg:Proficiency ;
    rpg:name "(Dead Language)" ;
    dc:description "An Academic Ability for speaking a language no longer used natively, such as Latin, available only to educated characters." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:FormMonstrosity a rpg:Tag ;
    skos:prefLabel "(Form) Monstrosity" ;
    dc:description "A Minor Supernatural Flaw, mainly for animal characters, giving a monstrous feature corresponding to a magical Form, from which Muto vis may be extracted." ;
    rpg:hasTag amol:Flaw .
amol:GildEnmity a rpg:Tag ;
    skos:prefLabel "(Gild) Enmity" ;
    dc:description "A Minor Hermetic Flaw representing the active enmity of one of the Rhine's political gilds, which seeks to thwart the character politically; Tabanus has Hawthorn Gild Enmity." ;
    skos:altLabel "Hawthorn Gild Enmity" ;
    rpg:hasTag amol:Flaw .
amol:LandRegioNetwork a rpg:Tag ;
    skos:prefLabel "(Land) Regio Network" ;
    dc:description "A Minor, Supernatural Virtue giving access to an extensive network of regiones (e.g. in lakes, sky, or caves) between which the character can travel quickly." ;
    rpg:hasTag amol:Virtue .
amol:LivingLanguage a rpg:Proficiency ;
    rpg:name "(Living Language)" ;
    dc:description "A General Ability representing fluency in a particular living language, measured on a fluency scale from point-and-grunt to elegant." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:MysteryCultLore a rpg:Proficiency ;
    rpg:name "(Mystery Cult) Lore" ;
    dc:description "An (Organization) Lore Ability for a particular Mystery Cult, covering its legends, history, structure, rites, secret passwords, and Initiation ceremonies." ;
    skos:altLabel "Cult Lore" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:RealmStigmatic a rpg:Tag ;
    skos:prefLabel "(Realm) Stigmatic" ;
    dc:description "A Minor Supernatural Flaw in which the character manifests physical phenomena and loses Fatigue when in a strong aura aligned to a chosen Realm of Power." ;
    rpg:hasTag amol:Flaw .
amol:ADealWithTheDevil a rpg:Tag ;
    skos:prefLabel "A Deal with the Devil" ;
    dc:description "A Major Story Flaw: the character has sold his soul to the devil and is destined for infernal damnation, with Hell's agents goading him; includes Plagued By Supernatural Entity." ;
    rpg:hasTag amol:Flaw .
amol:AFatherSConcern a rpg:Spell ;
    rpg:name "A Father's Concern" ;
    dc:description "An InCo 40 Orphic spell created by Anatol to periodically check on the physical condition of his daughters via the Adelphixis Range." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:AMomentSReflection a rpg:Spell ;
    rpg:name "A Moment's Reflection" ;
    dc:description "A Creo Mentem spell that sparks conscience to remove the Obsession Personality Trait imposed by a demon's obsession power." ;
    skos:altLabel "CrMe 20" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:APlagueOfFrogs a rpg:Spell ;
    rpg:name "A Plague of Frogs" ;
    dc:description "An Animal spell that spontaneously generates frogs, used as an example that the material cause (the frogs) determines its Form." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ASimpleCharmForTheRecoveryOfMisfiledBooks a rpg:Spell ;
    rpg:name "A Simple Charm for the Recovery of Misfiled Books" ;
    dc:description "A Rego Animal 10 spell that makes a misplaced book fly to its lectern, bookcase, or the caster's hand, using an arcane connection such as the library catalog or the book's voucher." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ASimpleTestForTheCompletenessOfBooks a rpg:Spell ;
    rpg:name "A Simple Test for the Completeness of Books" ;
    dc:description "An Intellego Animal 15 spell with Herbam requisite that checks a book's physical condition and history and tests the quality of its plant-based inks." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ASpellToKillWeeds a rpg:Spell ;
    rpg:name "A Spell to Kill Weeds" ;
    dc:description "A PeHe 20 spell (Touch, Momentary, Group) that weeds out a touched plant and all similar plants within a 15-pace range." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ASpellToMilkCattle a rpg:Spell ;
    rpg:name "A Spell to Milk Cattle" ;
    dc:description "A ReAn 15 spell (Touch, Concentration, Group) that magically milks cows into nearby milkpails, substituting a Perception + Finesse roll for Animal Handling." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:AUsefulInculcatorOfComments a rpg:Spell ;
    rpg:name "A Useful Inculcator of Comments" ;
    dc:description "A Rego Herbam 4 spell that lets librarians add catalog descriptions by sliding letters on a page aside to make space for new entries." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:AVisibleDemandForRepair a rpg:Spell ;
    rpg:name "A Visible Demand for Repair" ;
    dc:description "A MuIm 5 synaesthetic spell that transforms the groans and squeaks of damaged equipment into iconic species, granting +3 to Craft or Profession rolls to find flaws." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:AbandonedApprentice a rpg:Tag ;
    skos:prefLabel "Abandoned Apprentice" ;
    dc:description "A Major Story Flaw: the character was abandoned by his master midway through Hermetic training and is not a member of the Order of Hermes, though he knows Hermetic magic." ;
    rpg:hasTag amol:Flaw .
amol:AbbotThurstan a rpg:Character ;
    rpg:name "Abbot Thurstan" ;
    dc:description "A Norman abbot installed at Glastonbury by the Conqueror who tried to impose foreign customs and the chant of William of Fécamp, leading his soldiers to massacre monks in the church." ;
    skos:altLabel "Thurstan" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:AbdAlRaman a rpg:Character ;
    rpg:name "Abd Al Raman" ;
    dc:description "The Moorish emir whose invading army crossed the Pyrenees in 732 and whose outriders burned the young Flambeau's family estate." ;
    skos:altLabel "Emir abd Al Raman" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:AbluereMagica a rpg:Item ;
    rpg:name "Abluere Magica" ;
    dc:description "A Rego Herbam (Animal) 15 enchanted device of two hinged boards that cleans a soiled garment placed between them as a washerwoman would." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:Abyss a rpg:Tag ;
    skos:prefLabel "Abyss" ;
    dc:description "A Minor laboratory Supernatural Flaw: the lab contains a magical void such as a bottomless well, which can become a Void Feature (-2 Safety, +2 Perdo)." ;
    rpg:hasTag amol:Flaw .
amol:Accursius a rpg:Character ;
    rpg:name "Accursius" ;
    dc:description "A renowned legal commentator at Bologna and frontrunner to become rector of the Faculty of Law, racing his rival Odofredus to write a complete digest of civil law." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Acre a schema:Place ;
    rpg:name "Acre" ;
    dc:description "The major port in the Kingdom of Jerusalem and center of Christian activity in Outremer, a dangerous city contested by Muslim and Crusader forces and home to the military orders." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Adam a rpg:Character ;
    rpg:name "Adam" ;
    dc:description "The first man of biblical lore referenced in the Divine setting material." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Adder a rpg:Creature ;
    rpg:name "Adder" ;
    dc:description "A small venomous snake of Mythic Europe, about a foot and a half long with diamond-shaped markings, possessing a Venomous Bite power that can poison victims based on attack advantage versus armor." ;
    skos:altLabel "Viperis", "common adder" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Addled a rpg:Tag ;
    skos:prefLabel "Addled" ;
    dc:description "A non-standard laboratory routine in which a maga works two extra hours daily by eccentric anti-fatigue means, gaining +3 to Lab Total but risking Warping, addiction, and botches." ;
    rpg:hasTag amol:HermeticConcept .
amol:AdelheidInvigilix a rpg:Character ;
    rpg:name "Adelheid Invigilix" ;
    dc:description "The filia of Friderich Invigilor who now watches the Hohenstaufen dynasty for the Invigilor lineage of Tremere." ;
    skos:altLabel "Adelheid Invigilix filia Friderich" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Adelphixis a rpg:Tag ;
    skos:prefLabel "Adelphixis" ;
    dc:description "A spell Range granted by Orphic Magic that targets anyone connected to the magos by an emotional Story Flaw, equivalent to Arcane Connection for spell level." ;
    rpg:hasTag amol:HermeticConcept .
amol:AdeptLaboratoryStudent a rpg:Tag ;
    skos:prefLabel "Adept Laboratory Student" ;
    dc:description "A Minor Hermetic Virtue granting +6 to Lab Totals when working from others' lab texts." ;
    rpg:hasTag amol:Virtue .
amol:Adjuration a rpg:Tag ;
    skos:prefLabel "Adjuration" ;
    dc:description "A Virtue from Realms of Power: The Divine effective against demons, useful to a Flambeau demon-hunter's companion." ;
    rpg:hasTag amol:Virtue .
amol:AedesMercurii a rpg:Faction ;
    rpg:name "Aedes Mercurii" ;
    dc:description "A powerful covenant in the Provençal Tribunal with two sites, one centered on a majestic stone edifice known as the Temple (Templum) and another carved out of the Pic du Midi d'Ossau." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:Aegaea a rpg:Faction ;
    rpg:name "Aegaea" ;
    dc:description "A covenant in the Theban Tribunal located in a Faerie regio on the floor of the Aegean Sea, claimed by its members to be the palace of Poseidon and staffed largely by faerie tritones." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:Aegea a rpg:Faction ;
    rpg:name "Aegea" ;
    dc:description "A covenant on the floor of the Aegean Sea in the Theban Tribunal, home of the elder Merinita magus Lucian the Scholar." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:Aegir a rpg:Creature ;
    rpg:name "Aegir" ;
    dc:description "A long-tailed skua seabird that serves as the familiar of Eric Ribecus of Waddenzee." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:AegisOfUnbreakableWood a rpg:Spell ;
    rpg:name "Aegis of Unbreakable Wood" ;
    dc:description "A MuHe 15 spell that makes a wooden shield as strong as iron, increasing its Defense bonus by +1 while remaining susceptible to fire." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Aelfhere a rpg:Character ;
    rpg:name "Aelfhere" ;
    dc:description "A Friesian shipwright of Waddenzee whose shipbuilding ability is nothing short of magical; he secretly exchanges ideas with the Verditius shipwright Marcus." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Aelfric a rpg:Character ;
    rpg:name "Aelfric" ;
    dc:description "An example agent of Carolus, an Outlaw Leader who runs a small team of bandits preying on local merchants and owes Carolus loyalty for protection from the law." ;
    skos:altLabel "Aelfric: Outlaw Leader" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Aeolus a rpg:Creature ;
    rpg:name "Aeolus" ;
    dc:description "The vain magical horse that accompanies Victor of Mercere on his visits to the city, taking care not to soil his coat." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Aesculapius a rpg:Character ;
    rpg:name "Aesculapius" ;
    dc:description "The Greek god of healing, in whose temples (with snake nurseries and mineral springs) Crateuas may have hidden a copy of his herbal." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Aestas a rpg:Faction ;
    rpg:name "Aestas" ;
    dc:description "A Summer covenant of medium power occupying a large castle and serving as Mundane Lord of the local village, keeping a low profile in Hermetic politics and offering generous hospitality to visiting magi and Redcaps." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:Aethelbald a rpg:Character ;
    rpg:name "Aethelbald" ;
    dc:description "A deputy among Waddenzee's pirate covenfolk who claims to be the Saxon heir to the Crown of England." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Aether a rpg:Tag ;
    skos:prefLabel "Aether" ;
    dc:description "The fifth element posited by Aristotle that exists only above the Lunar Sphere, neither hot nor cold nor moist nor dry, composing the planetary spheres and planets." ;
    rpg:hasTag amol:HermeticConcept .
amol:Aetites a rpg:Item ;
    rpg:name "Aetites" ;
    dc:description "Rare eagle-stones mentioned by Pliny; the smaller pebble inside holds one pawn of Terram vis and gives a +5 Material bonus to fertility when used in an enchanted item or talisman." ;
    skos:altLabel "eagle-stones", "pregnant stones" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:AffinityWithCraftOrProfessionAbility a rpg:Tag ;
    skos:prefLabel "Affinity with Craft or Profession Ability" ;
    dc:description "A Minor Virtue a maestro may select at no cost, enhancing learning of a Craft or Profession Ability that is the artist's primary medium." ;
    rpg:hasTag amol:Virtue .
amol:AffinityWithEnchantingMusic a rpg:Tag ;
    skos:prefLabel "Affinity with Enchanting Music" ;
    dc:description "A Virtue held by Brogo that boosts his Enchanting Music supernatural ability." ;
    rpg:hasTag amol:Virtue .
amol:AffinityWithFinesse a rpg:Tag ;
    skos:prefLabel "Affinity with Finesse" ;
    dc:description "A Virtue granting Imanitos Mendax accelerated learning in Finesse, gained from Twilight." ;
    rpg:hasTag amol:Virtue .
amol:AffinityWithGuile a rpg:Tag ;
    skos:prefLabel "Affinity with Guile" ;
    dc:description "A Virtue granting Imanitos Mendax accelerated learning in the Guile Ability." ;
    rpg:hasTag amol:Virtue .
amol:AffinityWithIgnem a rpg:Tag ;
    skos:prefLabel "Affinity with Ignem" ;
    dc:description "A Minor Hermetic Virtue granting affinity with the Form of fire, imparted to Initiates of the Confraternity of Balento." ;
    rpg:hasTag amol:Virtue .
amol:AffinityWithIntellego a rpg:Tag ;
    skos:prefLabel "Affinity with Intellego" ;
    dc:description "The Minor Hermetic Virtue of the Hermetic Haruspexes tradition, granting an affinity with the Intellego Art." ;
    rpg:hasTag amol:Virtue .
amol:AffinityWithMentem a rpg:Tag ;
    skos:prefLabel "Affinity with Mentem" ;
    dc:description "A Virtue granting Imanitos Mendax accelerated learning in the Mentem Art." ;
    rpg:hasTag amol:Virtue .
amol:AffinityWithPenetration a rpg:Tag ;
    skos:prefLabel "Affinity with Penetration" ;
    dc:description "A Virtue giving Philippus Niger accelerated learning in the Penetration Ability." ;
    rpg:hasTag amol:Virtue .
amol:AffinityWithPerdo a rpg:Tag ;
    skos:prefLabel "Affinity with Perdo" ;
    dc:description "A Virtue giving Philippus Niger accelerated learning in the Perdo Art." ;
    rpg:hasTag amol:Virtue .
amol:AffinityWithVim a rpg:Tag ;
    skos:prefLabel "Affinity with Vim" ;
    dc:description "The Minor Hermetic Virtue of the Witches of Thessaly tradition, granting an affinity with the Vim Art." ;
    rpg:hasTag amol:Virtue .
amol:Afire a rpg:Tag ;
    skos:prefLabel "Afire" ;
    dc:description "A Minor laboratory Supernatural Flaw: the lab is engulfed in never-dying flames requiring protection, possibly blocking some lab work (+1 Upkeep, -3 Safety, +2 Warping, +2 Aesthetics, +3 Ignem)." ;
    rpg:hasTag amol:Flaw .
amol:Agency a rpg:Tag ;
    skos:prefLabel "Agency" ;
    dc:description "A network of mundane contacts (agents) that magi maintain to pursue goals without being implicated in meddling with mundane politics." ;
    skos:altLabel "agencies" ;
    rpg:hasTag amol:HermeticConcept .
amol:Agent a rpg:Tag ;
    skos:prefLabel "Agent" ;
    dc:description "A person bound to offer assistance to a principal through ties such as contracts, debts, or blackmail." ;
    skos:altLabel "agents" ;
    rpg:hasTag amol:CharacterType .
amol:AgingModifier a rpg:Tag ;
    skos:prefLabel "Aging Modifier" ;
    dc:description "A modifier reflecting living conditions' effect on aging; covenfolk living conditions translate into loyalty point modifiers via this aging modifier." ;
    rpg:hasTag amol:HermeticConcept .
amol:AgingRoll a rpg:Tag ;
    skos:prefLabel "Aging Roll" ;
    dc:description "A periodic roll determining a character's aging, modified by Healthy or Unhealthy environmental features at a covenant." ;
    skos:altLabel "Aging rolls" ;
    rpg:hasTag amol:HermeticConcept .
amol:Agnes a rpg:Character ;
    rpg:name "Agnes" ;
    dc:description "A Merinita apprentice who in 1158 claimed to have learned nature magic from a lady in green in Bohemia and was hailed as a True Merinitae having learned Nature Lore from the Founder." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Agnosia a rpg:Spell ;
    rpg:name "Agnosia" ;
    dc:description "A PeMe 10 spell that destroys familiarity with a category of object represented by a single noun, so the victim cannot recognize or use such things." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:AgricolaOfTytalus a rpg:Character ;
    rpg:name "Agricola of Tytalus" ;
    dc:description "A Tytalus magus of peasant stock at Castrum Antiquum who used Herbam, Auram and Animál magic to wring great harvests from poor northern land." ;
    skos:altLabel "Agricola" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:AindreadExMiscellanea a rpg:Character ;
    rpg:name "Aindread Ex Miscellanea" ;
    dc:description "A reclusive mature magus at Burnham who never answers letters and has left the covenant only once; parens of Caitlin." ;
    skos:altLabel "Aindread" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:AirSGhostlyForm a rpg:Spell ;
    rpg:name "Air's Ghostly Form" ;
    dc:description "A Creo Auram spell (Level 5) that forms a thick fog around the magus extending outward several paces." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Airborne a rpg:Tag ;
    skos:prefLabel "Airborne" ;
    dc:description "A Free laboratory Supernatural Virtue: the lab flies upon the winds or clouds, requiring very powerful magic, often taken with Unstable." ;
    rpg:hasTag amol:Virtue .
amol:Akrotiri a schema:Place ;
    rpg:name "Akrotiri" ;
    dc:description "An ancient city buried in volcanic ash on the island of Thera that Andru discovered; rich in magical and technological secrets but now infested with vampires." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Alam a rpg:Tag ;
    skos:prefLabel "Alam" ;
    dc:description "A Criamon term for a mystical state so divorced from the mundane world that its alignment to the four realms is debatable; key examples are the Hypostasis and the counter-cyclical alam." ;
    skos:altLabel "alam of Forms", "counter-cyclic alam", "counter-cyclical alam" ;
    rpg:hasTag amol:HermeticConcept .
amol:AlbertTheBear a rpg:Character ;
    rpg:name "Albert the Bear" ;
    dc:description "A Saxon who founded the March of Brandenburg in 1150 and adopted the title of margrave after campaigns against the Wends; he rebuilt a cathedral in the city of Brandenburg." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:AlbertVonBuxhVden a rpg:Character ;
    rpg:name "Albert von Buxhövden" ;
    dc:description "Bishop of Riga who founded the Knights of the Sword (Livonian Order) in 1202 and struggles in vain to control their excesses." ;
    skos:altLabel "Bishop Albert" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:AlbigensianCrusade a rpg:Tag ;
    skos:prefLabel "Albigensian Crusade" ;
    dc:description "A crusade aimed at the heretical Cathars in Languedoc that is effectively destroying the tradition of southern troubadours." ;
    rpg:hasTag amol:HermeticConcept .
amol:AlchemicalReagent a rpg:Item ;
    rpg:name "Alchemical Reagent" ;
    dc:description "An experimental-philosophy product learned via Philosophiae: a natural substance made in the lab from minerals, botanicals and animal components that imposes a natural alteration on matter." ;
    skos:altLabel "Reagent", "alchemical reagents" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:AlchemicalSteel a rpg:Item ;
    rpg:name "Alchemical Steel" ;
    dc:description "A Level 20 Alteration Reagent producing a purified, harder form of iron; blades made of it gain +2 damage and armor gains +2 Protection." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:AlchemistSRevenge a rpg:Spell ;
    rpg:name "Alchemist's Revenge" ;
    dc:description "A CrAq 25 spell that splashes a target with acid, inflicting +15 damage if it penetrates Magic Resistance and optionally damaging equipment." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:AlcuinOfYork a rpg:Character ;
    rpg:name "Alcuin of York" ;
    dc:description "The Englishman and most famous teacher of Charlemagne's Palatine School, whose ghost is said to haunt the Paris classrooms and whose lost works scholars seek at Aachen." ;
    skos:altLabel "Alcuin" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:AlexanderOfJerbiton a rpg:Character ;
    rpg:name "Alexander of Jerbiton" ;
    dc:description "A magus of House Jerbiton who walked the Path of Aging, plucking out his own eye, drinking from the Fountain of Youth, and disappearing into the forest after his mater's death." ;
    skos:altLabel "Alexander" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Alexandria a schema:Place ;
    rpg:name "Alexandria" ;
    dc:description "An Egyptian city whose lighthouse holds a source of fire from which an Initiate must steal a brand during the Automata Initiation." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:AlfredTheGreat a rpg:Character ;
    rpg:name "Alfred the Great" ;
    dc:description "King of Wessex from 871 who drove back the Danes, established defensive burhs, and was a learned translator; subject of the legend of the burnt cakes." ;
    skos:altLabel "Alfred" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:AllAccordingToPlan a rpg:Tag ;
    skos:prefLabel "All According to Plan" ;
    dc:description "A Minor General Virtue letting a player reroll a botch die once per session by describing a prepared contingency." ;
    rpg:hasTag amol:Virtue .
amol:Allessandro a rpg:Character ;
    rpg:name "Allessandro" ;
    dc:description "An example Donatore character with Banishing 18 who banishes the Infernal ghost of his former master from his covenant in a worked example." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Almogaten a rpg:Tag ;
    skos:prefLabel "Almogaten" ;
    dc:description "A Minor Social Status Virtue for the leader of a band of Almogavars in Iberia, commanding around a dozen men." ;
    rpg:hasTag amol:Virtue .
amol:Almogavar a rpg:Tag ;
    skos:prefLabel "Almogavar" ;
    dc:description "A Minor Social Status Virtue for a member of an Iberian band of mercenaries and raiders bound by a code of honor." ;
    rpg:hasTag amol:Virtue .
amol:Alnoth a rpg:Character ;
    rpg:name "Alnoth" ;
    dc:description "The son born to Eadric Wilde and his faerie wife, who grew up to be a good and holy man." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Alodia a schema:Place ;
    rpg:name "Alodia" ;
    dc:description "The most remote of the three Nubian kingdoms on the southern reaches of the Nile, where Kassala is located." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Altar a rpg:Tag ;
    skos:prefLabel "Altar" ;
    dc:description "A laboratory Feature: an ornamental place of ritual worship such as a raised dais, providing Technique and Vim Specializations." ;
    rpg:hasTag amol:HermeticConcept .
amol:AmabelTheLearned a rpg:Character ;
    rpg:name "Amabel the Learned" ;
    dc:description "A brilliant Natural Magician scholar at Schola Pythagoranis, nearly as powerful as the magi and treated as a member of the Order though she never joined." ;
    skos:altLabel "Amabel" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:AmauryDeBene a rpg:Character ;
    rpg:name "Amaury de Bene" ;
    dc:description "An unrepentant heretic and Paris master who taught a pantheistic philosophy with a substantial following; posthumously exhumed, excommunicated, and his bones cast into unhallowed ground." ;
    skos:altLabel "Amaury" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Ambrus a rpg:Character ;
    rpg:name "Ambrus" ;
    dc:description "A Bonisagus archmage who led the complex negotiations for the founding of three covenants in the Slavic lands in the late 10th century." ;
    skos:altLabel "Archmage Ambrus of Bonisagus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:AmbushOnTheDesertedRoad a rpg:Spell ;
    rpg:name "Ambush on the Deserted Road" ;
    dc:description "A PeIm 20 transparency spell that destroys the species a group emits in one direction, making a traveling party invisible from the direction of those they wish to ambush." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Amorphous a rpg:Tag ;
    skos:prefLabel "Amorphous" ;
    dc:description "A Major or Minor Supernatural Tainted Virtue letting a character take on any non-specific human form due to demon-touched flesh." ;
    rpg:hasTag amol:Virtue .
amol:AnEnemyAwashInThePureSigilOfTheMagus a rpg:Spell ;
    rpg:name "An Enemy Awash in the Pure Sigil of the Magus" ;
    dc:description "A CrIm 15 spell that washes a target's eyes with concentrated visible species based on the caster's sigil, blinding them for two minutes." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:AnalFistula a rpg:Creature ;
    rpg:name "Anal Fistula" ;
    dc:description "A Minor Melancholic Disease from excessive retention of melancholy on the fundament, requiring surgical removal of the fistula." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Ananke a rpg:Creature ;
    rpg:name "Ananke" ;
    dc:description "The Greek goddess of inevitability whose bound wrists were depicted in House Criamon's older symbol; she was never worshipped because she could not grant favors." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Anatol a rpg:Character ;
    rpg:name "Anatol" ;
    dc:description "A magos formerly of House Jerbiton who created the spell A Father's Concern to check on his six estranged daughters." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:AnchoredToTheLand a rpg:Tag ;
    skos:prefLabel "Anchored to the (Land)" ;
    dc:description "A Minor General Flaw: the character suffers loneliness and a -3 penalty when traveling through any environment other than a particular favored one." ;
    rpg:hasTag amol:Flaw .
amol:Andreas a rpg:Character ;
    rpg:name "Andreas" ;
    dc:description "A magus of House Bonisagus who devised The Resolute Mind of the Tireless Researcher to combat his constant lapses of concentration." ;
    skos:altLabel "Andreas of House Bonisagus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Andresina a schema:Place ;
    rpg:name "Andresina" ;
    dc:description "A ruined and abandoned Roman city southwest of Toul with a great temple to Apollo and a Magic aura of 2, a possible covenant site." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Andrilikes a rpg:Character ;
    rpg:name "Andrilikes" ;
    dc:description "A theurgist magus of the Novgorod Tribunal who wrote a Hermetic ritual for summoning the lesser Daimon Pukis to his sanctum." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:AngelicMovement a rpg:Tag ;
    skos:prefLabel "Angelic Movement" ;
    dc:description "A common automaton power (base effect 40, Creo Auram with Rego requisite) letting an automaton with a flight-capable form fly at the magus's direction." ;
    rpg:hasTag amol:HermeticConcept .
amol:Anglesey a schema:Place ;
    rpg:name "Anglesey" ;
    dc:description "The island site of an ancient druidic shrine that the Díedne incorporated as the Nameless Covenant in 817." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Animae a rpg:Creature ;
    rpg:name "Animae" ;
    dc:description "Temporary faeries created by Animae Magic from inanimate objects or summoned from Arcadia; they are intelligent, have Might-appropriate powers, and bargain for their aid." ;
    skos:altLabel "artificial souls" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:AnimaeMagic a rpg:Tag ;
    skos:prefLabel "Animae Magic" ;
    dc:description "A Major Arcadian Mystery (Virtue) that lets a maga transform inanimate objects into living faeries called animae or summon them, using new Creo/Muto spell guidelines." ;
    rpg:hasTag amol:Virtue .
amol:AnimalCompanion a rpg:Tag ;
    skos:prefLabel "Animal Companion" ;
    dc:description "A Minor Story Flaw: the character is accompanied by a loyal, intelligent but mundane animal with whom they share a very close relationship." ;
    rpg:hasTag amol:Flaw .
amol:AnimalKenAbility a rpg:Proficiency ;
    rpg:name "Animal Ken (Ability)" ;
    dc:description "The Supernatural Ability to communicate with animals, conferred by the Animal Ken Virtue at score 1." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:AnizyLeChTeau a schema:Place ;
    rpg:name "Anizy-le-Château" ;
    dc:description "A town of 300 dominating fourteen smaller towns in Laonnoise southwest of Laon in France, long in conflict with its lord the Bishop of Laon over taxation and charters." ;
    skos:altLabel "Ainzyle-Château" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:AnnaOfNaples a rpg:Character ;
    rpg:name "Anna of Naples" ;
    dc:description "A tenth-century Jerbiton Archmage whose decision to take her apprentice and others to Constantinople for immersion accidentally created the first Itinerarium." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Annwfn a schema:Place ;
    rpg:name "Annwfn" ;
    dc:description "The otherworld realm over which Gwynn ab Nudd reigns as king of the faeries." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:AntigoneOfCriamon a rpg:Character ;
    rpg:name "Antigone of Criamon" ;
    dc:description "An example Criamon maga (a follower of the Path of Seeming, skilled in Imaginem) who suffers Twilight incidents and adulterations such as a dragon embodying her violent temper." ;
    skos:altLabel "Antigone" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:AntimedesOfTytalus a rpg:Character ;
    rpg:name "Antimedes of Tytalus" ;
    dc:description "A magus of House Tytalus and member of the Lyceum who seeks to copy rare academic books and re-enter them into academic circles." ;
    skos:altLabel "Antimedes" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Antiphon a rpg:Character ;
    rpg:name "Antiphon" ;
    dc:description "A Sophist quoted in the Analects of Tytalus who proposed that man is better off escaping convention and taught a life of refined intellectual hedonism." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Apoplexy a rpg:Creature ;
    rpg:name "Apoplexy" ;
    dc:description "A Critical Sanguine Disease caused by a malicious faerie that damages the heart, causing immediate collapse." ;
    skos:altLabel "elfshot" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Apostate a rpg:Tag ;
    skos:prefLabel "Apostate" ;
    dc:description "A Minor General Flaw: the character has converted from one faith or belief system to another, gaining a bad Reputation of 4 among their previous faith." ;
    rpg:hasTag amol:Flaw .
amol:AppeaseTheQueenOfWinter a rpg:Spell ;
    rpg:name "Appease the Queen of Winter" ;
    dc:description "A Muto Aquam ritual spell (MuAq 60) learned by Falke with the volkhvy's aid, propitiating the Queen of Winter to thaw the Baltic Sea; gains a +10 bonus when cast at Arkona." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ApplesOfHesperides a rpg:Item ;
    rpg:name "Apples of Hesperides" ;
    dc:description "A golden-apple tree grown from a seed said to descend from Hera's wedding tree; it produces six golden apples a year, each containing Creo vis, whose flesh sustains a man and resists illness." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:Apprentices a rpg:Item ;
    rpg:name "Apprentices" ;
    dc:description "An Ars Magica supplement providing rules for playing child characters and how their Virtues and Flaws change as they age." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:Apprenticeship a rpg:Tag ;
    skos:prefLabel "Apprenticeship" ;
    dc:description "The period during which a future magus is trained by a master until passing the gauntlet; Agricola was taken for apprenticeship late." ;
    rpg:hasTag amol:HermeticConcept .
amol:AptitudeForSin a rpg:Tag ;
    skos:prefLabel "Aptitude for (Sin)" ;
    dc:description "A Minor General Tainted Virtue granting +3 in a narrow circumstance linked to a demon's Obsession, such as picking pockets." ;
    rpg:hasTag amol:Virtue .
amol:Aptness a rpg:Tag ;
    skos:prefLabel "Aptness" ;
    dc:description "Moral correctness in House Criamon belief; living aptly is thought to slow the universe's fall into chaos and is required for entering the Hypostasis." ;
    skos:altLabel "apt action", "apt life" ;
    rpg:hasTag amol:HermeticConcept .
amol:Aramin a rpg:Character ;
    rpg:name "Aramin" ;
    dc:description "An irascible magus, expert in Perdo and Corpus, whose vis source is a rare swamp plant (bitter cane) and who may have authored a plague." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:ArcadianPath a rpg:Tag ;
    skos:prefLabel "Arcadian Path" ;
    dc:description "A path mentioned in House Merinita usually leading into the faerie realm of Arcadia and granting the Mystery of Faerie Magic; Serrifuloria discovered a unique variant within Arcadia itself." ;
    rpg:hasTag amol:HermeticConcept .
amol:ArcadianTravel a rpg:Tag ;
    skos:prefLabel "Arcadian Travel" ;
    dc:description "A Minor Arcadian Mystery (Virtue) that lets a maga travel between Faerie and the mortal world via trods and open temporary gateways to Arcadia using charms." ;
    rpg:hasTag amol:Virtue .
amol:ArcaneDiscovery a rpg:Tag ;
    skos:prefLabel "Arcane Discovery" ;
    dc:description "The process by which magi expand Hermetic magic, accumulating breakthrough points toward Minor, Major, or Hermetic Breakthroughs through experimentation or integration." ;
    skos:altLabel "Breakthrough" ;
    rpg:hasTag amol:HermeticConcept .
amol:ArchbishopWichmannOfMagdeburg a rpg:Character ;
    rpg:name "Archbishop Wichmann of Magdeburg" ;
    dc:description "An archbishop who, following a vision of vast urban development, granted charters to many towns in Germany and Poland and used agents called locatores." ;
    skos:altLabel "Archbishop Wichmann" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Archieunuch a rpg:Tag ;
    skos:prefLabel "Archieunuch" ;
    dc:description "A Major Social Status Virtue for one of the most important eunuchs in the Byzantine empire, wielding significant influence and authority." ;
    rpg:hasTag amol:Virtue .
amol:ArchimagaTisiphone a rpg:Character ;
    rpg:name "Archimaga Tisiphone" ;
    dc:description "A renowned beauty and Archimaga able to evoke artistic talent in men, who lives within a regio and wears a red ribbon." ;
    skos:altLabel "Tisiphone" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:ArchimagusApollodarus a rpg:Character ;
    rpg:name "Archimagus Apollodarus" ;
    dc:description "An Archimagus of the Monkey's Reed covenant whose beloved died in a fire he created, whom Bonisagus magi hope will become High Priest of the forming Temple." ;
    skos:altLabel "Apollodarus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:ArchimagusTheoderic a rpg:Character ;
    rpg:name "Archimagus Theoderic" ;
    dc:description "The affable, encouraging Archimagus who governs the Devoted covenant dedicated to reaching the Lunar Sphere." ;
    skos:altLabel "Theoderic" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Arelie a rpg:Character ;
    rpg:name "Arelie" ;
    dc:description "One of Birna's six apprentices, told to 'Remember,' an eagle from a Prussian tribe; founder of Clan Arelie." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:AretaeusTheCappadocian a rpg:Character ;
    rpg:name "Aretaeus the Cappadocian" ;
    dc:description "The physician credited with naming diabetes after the Greek word for a siphon, due to its excessive discharge of urine." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Argantael a rpg:Character ;
    rpg:name "Argantael" ;
    dc:description "A vagabond faerie who assists the clothier Doolin, whispering to him about secret gatherings of wizards from across Mythic Europe." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Argonauts a rpg:Faction ;
    rpg:name "Argonauts" ;
    dc:description "Jason's crew aboard the Argo who were saved from the sirens by Orpheus's lyre during the quest for the Golden Fleece." ;
    skos:altLabel "the Argo" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:ArielOfFlambeau a rpg:Character ;
    rpg:name "Ariel of Flambeau" ;
    dc:description "A young Flambeau magus among the members recruited to Nigrasaxa." ;
    skos:altLabel "Ariel" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Aristaeus a rpg:Character ;
    rpg:name "Aristaeus" ;
    dc:description "A god who desired Eurydice and advanced on her, causing her to flee and step on the viper that killed her." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:ArmOfTheInfant a rpg:Spell ;
    rpg:name "Arm of the Infant" ;
    dc:description "A Muto Corpus spell (Level 20) that shrinks a person's arm to half its length and makes it pudgy like an infant's." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ArsGoetia a rpg:Tag ;
    skos:prefLabel "Ars Goetia" ;
    dc:description "A sorcerous tradition dealing with the summoning, binding, commanding, ablating, and punishment of spiritual entities of all realms except the Divine; practiced by Guorna and Tytalus and socially tainted." ;
    skos:altLabel "Goetic Arts", "Goetic Magic" ;
    rpg:hasTag amol:HermeticConcept .
amol:ArteDeiMercanti a rpg:Faction ;
    rpg:name "Arte dei Mercanti" ;
    dc:description "Merchant societies formed in Florence in 1182 in imitation of the noble tower societies, which spread to many other cities." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Artemis a rpg:Creature ;
    rpg:name "Artemis" ;
    dc:description "The deity to whom Ophia Sirnaus Isle-Warden's shrine on her Aegean island is dedicated." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Arthritis a rpg:Tag ;
    skos:prefLabel "Arthritis" ;
    dc:description "A Minor General Flaw: stiff, painful joints giving -3 to rolls involving repetitive sustained movement, with botches potentially locking up a limb." ;
    rpg:hasTag amol:Flaw .
amol:Artificer a rpg:Tag ;
    skos:prefLabel "Artificer" ;
    dc:description "An honorary Durenmar title for the magus, traditionally a Verditius, charged with crafting items for the covenant; currently held by Gudrun Tigurina." ;
    rpg:hasTag amol:CharacterType .
amol:Artist a rpg:Tag ;
    skos:prefLabel "Artist" ;
    dc:description "A covenfolk template for a fey, painter-craftsman in a highly magical environment, with Virtues like Free Expression and Second Sight." ;
    rpg:hasTag amol:CharacterType .
amol:AsaronOfFlambeau a rpg:Character ;
    rpg:name "Asaron of Flambeau" ;
    dc:description "A magus of House Flambeau who believes his mission is to repopulate the world for more to kill; he spends seasons healing, and his sigil is a symbolic flame." ;
    skos:altLabel "Asaron" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Aspect a rpg:Tag ;
    skos:prefLabel "Aspect" ;
    dc:description "An agent projected onto Earth by a Daimon, functioning as an independent spirit with its own Might pool that is dispelled when exhausted and returns to the parent Daimon." ;
    skos:altLabel "Aspects" ;
    rpg:hasTag amol:HermeticConcept .
amol:AssesEars a rpg:Tag ;
    skos:prefLabel "Asses' Ears" ;
    dc:description "A Minor Curse (Muto Corpus Animal effect) that turns the victim's ears into donkey ears, penalizing social interactions by -3." ;
    rpg:hasTag amol:Flaw .
amol:Assistant a rpg:Tag ;
    skos:prefLabel "Assistant" ;
    dc:description "A Free laboratory Outfittings Virtue: a Gifted assistant such as a Hermetic apprentice helps in the lab, adding their Intelligence + Magic Theory to General Quality." ;
    rpg:hasTag amol:Virtue .
amol:Astasians a rpg:Creature ;
    rpg:name "Astasians" ;
    dc:description "Tiny messenger-demons that Imanitos Mendax can use to communicate with his subordinates, easily mistaken for 'airy spirits.'" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:AstrolabeOfJerbiton a rpg:Character ;
    rpg:name "Astrolabe of Jerbiton" ;
    dc:description "Possibly the most brilliant magus in the tribunal, a Jerbiton at Schola Pythagoranis devoted to natural philosophy who critiques magic theory's physics." ;
    skos:altLabel "Astrolabe" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:AstrologicalInception a rpg:Tag ;
    skos:prefLabel "Astrological Inception" ;
    dc:description "An experimental-philosophy formula learned via Artes Liberales consisting of an astrological chart designed to answer a specific question about a person, object, or event." ;
    skos:altLabel "Inception", "astrological inceptions" ;
    rpg:hasTag amol:HermeticConcept .
amol:Astrology a rpg:Tag ;
    skos:prefLabel "Astrology" ;
    dc:description "The natural principle that the celestial figure of planets at a thing's creation determines its qualities; employed by magi in ceremonial casting and lab work ordering." ;
    rpg:hasTag amol:HermeticConcept .
amol:AstronomicalDevice a rpg:Item ;
    rpg:name "Astronomical Device" ;
    dc:description "A laboratory Feature: a tool for measuring the heavens such as an astrolabe or armillary sphere, providing Intellego and Vim Specializations." ;
    skos:altLabel "armillary sphere", "astrolabe" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:Atavism a rpg:Tag ;
    skos:prefLabel "Atavism" ;
    dc:description "The acquisition of ancestral characteristics by which a Bjornaer magus learns to adopt the form of a notable animal ancestor (the inner heartbeast)." ;
    rpg:hasTag amol:HermeticConcept .
amol:AtlanteanMagic a rpg:Tag ;
    skos:prefLabel "Atlantean Magic" ;
    dc:description "A Minor Hermetic Virtue from exiled Atlantean magic granting the special Range Water-way, Duration Storm, and Target Body-of-water." ;
    rpg:hasTag amol:Virtue .
amol:Atlanteans a rpg:Creature ;
    rpg:name "Atlanteans" ;
    dc:description "A people native to a magic regio; an exiled Atlantean tainted by the surface world cannot return, as detailed in Realms of Power: Magic." ;
    skos:altLabel "Atlantean" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Aufhocker a rpg:Creature ;
    rpg:name "Aufhocker" ;
    dc:description "A faerie hound variant found in German-speaking areas that acts as a kelpie and clings to foes while goring them, adding to their combat Load." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:AugustinianCanons a rpg:Faction ;
    rpg:name "Augustinian Canons" ;
    dc:description "Regular canons following the Rule of St. Augustine of Hippo who, unlike monks, are not sequestered from the world and undertake pastoral duties." ;
    skos:altLabel "Augustinians" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:AuraOfBeguilingAppearance a rpg:Spell ;
    rpg:name "Aura of Beguiling Appearance" ;
    dc:description "A Muto Imaginem spell (MuIm 10) variant of Aura of Ennobled Presence that makes the target appear more friendly and credible, granting +3 to win trust and to Charm-based Defense Totals." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:AuraOfRightfulAuthorityPendant a rpg:Item ;
    rpg:name "Aura of Rightful Authority Pendant" ;
    dc:description "A bejeweled golden pendant crafted by Stentorius and worn by his familiar Oswald, imbued with multiple uses of Aura of Rightful Authority and other effects." ;
    skos:altLabel "Oswald's pendant" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:AureliusAmbrosius a rpg:Character ;
    rpg:name "Aurelius Ambrosius" ;
    dc:description "Brother of Uther Pendragon who defeated Vortigern and the Saxons and had Merlin bring the Giant's Dance to Britain; slain by treachery." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Ausculator a rpg:Character ;
    rpg:name "Ausculator" ;
    dc:description "A famous living representative of House Guernicus's earth-magic tradition, leader of the covenant of Hedyosmos in the Theban Tribunal." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:AuspiciousShape a rpg:Tag ;
    skos:prefLabel "Auspicious Shape" ;
    dc:description "A Minor laboratory Structure Virtue: the lab is formed into a magically beneficial shape such as a hexagon or pentagram, granting +1 Aesthetics and +1 Vim." ;
    rpg:hasTag amol:Virtue .
amol:Autodictation a rpg:Spell ;
    rpg:name "Autodictation" ;
    dc:description "A Rego Terram 15 spell that lets a magus write by talking, inscribing a metal stylus across prepared wax boards as he speaks." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Autumnus a rpg:Faction ;
    rpg:name "Autumnus" ;
    dc:description "A powerful Autumn covenant housed in a single enormous magically warmed building atop a mountain peak, ruled by a council of its four oldest magi and protecting a smaller covenant in another Tribunal." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:Avalon a schema:Place ;
    rpg:name "Avalon" ;
    dc:description "The legendary isle identified with Glastonbury, burial place of King Arthur." ;
    skos:altLabel "isle of Avalon" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Avebury a schema:Place ;
    rpg:name "Avebury" ;
    dc:description "A village within the largest of many mysterious monuments, a stone circle about a thousand feet across with banks, ditches, inner circles and avenues said to lead somewhere not of this world on particular days." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Avenue a rpg:Tag ;
    skos:prefLabel "Avenue" ;
    dc:description "The process of spiritual awakening, purification, and testing by which a Criamon magus reaches a new station, requiring a Lore score, a trial or investiture, and insight from a story." ;
    skos:altLabel "avenues" ;
    rpg:hasTag amol:HermeticConcept .
amol:Averroes a rpg:Character ;
    rpg:name "Averroes" ;
    dc:description "A twelfth-century Islamic scholar who refuted al-Ghazali's claims in his book The Incoherence of the Incoherence." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:AwkwardShape a rpg:Tag ;
    skos:prefLabel "Awkward Shape" ;
    dc:description "A Minor laboratory Structure Flaw: the chamber is a difficult shape, long and thin or partitioned (-2 Safety, -1 Aesthetics)." ;
    rpg:hasTag amol:Flaw .
amol:Axior a rpg:Character ;
    rpg:name "Axior" ;
    dc:description "A martial magus of House Flambeau and founding member of Oculus Septentrionalis who disagreed over its site and founded Terschelling (later Waddenzee) instead; killed in a magical accident." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Baden a schema:Place ;
    rpg:name "Baden" ;
    dc:description "A Swabian town named Aquae by the Romans for its hot springs, whose ruined upper part retains a Magic aura of 2 and is owned by Durenmar, which harvests vis from the springs." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Baker a rpg:Tag ;
    skos:prefLabel "Baker" ;
    dc:description "A covenfolk template for a returned faerie changeling who bakes faerie-style, with Free Expression and Lesser Purifying Touch." ;
    rpg:hasTag amol:CharacterType .
amol:Balastor a rpg:Character ;
    rpg:name "Balastor" ;
    dc:description "A feral journeyman of House Criamon at Fengheld who seeks enlightenment by returning to a primal state; his Warped Magic gives him a savage cast, and his philosophy aligns with the Hawthorn Gild." ;
    skos:altLabel "Balastor, Follower of Criamon" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:BaldwinI a rpg:Character ;
    rpg:name "Baldwin I" ;
    dc:description "The first Count of Flanders, exiled in 862 for marrying Judith, who fought the magical bear at the site of Brugge." ;
    skos:altLabel "first Count of Flanders" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:BaldwinIX a rpg:Character ;
    rpg:name "Baldwin IX" ;
    dc:description "Count of Flanders crowned the first emperor of the Latin Empire of Constantinople in 1204, who mysteriously disappeared in 1205 during battle against King Ivan of Bulgaria." ;
    skos:altLabel "Baldwin IX, Count of Flanders" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Balento a rpg:Character ;
    rpg:name "Balento" ;
    dc:description "A ninth-century Verditius magus convinced he was a direct descendant of Vulcan, who focused on fire magic and founded the Confraternity of Balento." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:BallOfAbysmalMusic a rpg:Spell ;
    rpg:name "Ball of Abysmal Music" ;
    dc:description "A Muto Imaginem 20 spell, reputedly Pendule's favorite, that targets a formulaic Ignem spell mid-cast and turns its fire into a harmless burst of color and sound." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Balmung a rpg:Item ;
    rpg:name "Balmung" ;
    dc:description "Siegfried's sword, with which Kriemhild decapitates Hagen in the Nibelungenlied." ;
    skos:altLabel "Siegfried's sword" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:Banco a rpg:Character ;
    rpg:name "Banco" ;
    dc:description "Dean of the Goldsmith's Guild of Rome and member of the Savelli family, a skilled maker of wondrous goods who secretly seeks to learn how to make genuine Hermetic magic items." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Bard a rpg:Tag ;
    skos:prefLabel "Bard" ;
    dc:description "A Free Social Status Virtue for a graduate of a Hibernian bardic school at the rank of Dos, with a Local Reputation among the Irish." ;
    skos:altLabel "Rard", "fili" ;
    rpg:hasTag amol:Virtue .
amol:BardneyAbbey a schema:Place ;
    rpg:name "Bardney Abbey" ;
    dc:description "The abbey to which Saint Oswald's bones were transferred; a heavenly light over the cart at the gates showed the monks they should welcome the foreign king's relics." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Basajaun a rpg:Creature ;
    rpg:name "Basajaun" ;
    dc:description "A gigantic red-furred faun variant of the Great Lezi found in the Basque country of Iberia, acting as agricultural faeries; the name also refers to a large wild faun in surrounding folklore." ;
    skos:altLabel "Basajauns" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Basel a schema:Place ;
    rpg:name "Basel" ;
    dc:description "A city on the Upper Rhine, the highest navigable point of the river, where Redcaps make frequent use of the Copper Rooster Inn maintained by House Mercere." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Basilicus a rpg:Character ;
    rpg:name "Basilicus" ;
    dc:description "A Primus of House Ex Miscellanea, a Hermetic Haruspex with prophetic abilities, who seized control before the Schism War and re-instituted the Council of Four." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Basilisk a rpg:Creature ;
    rpg:name "Basilisk" ;
    dc:description "A magical lizard whose gaze can kill; Philippus Niger tracked a female basilisk and obtained one of her eggs to hatch his familiar Sordus." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Bassianus a rpg:Character ;
    rpg:name "Bassianus" ;
    dc:description "The rector of Montpellier striving to raise the reputation of its Faculty of Arts against the dominant Faculty of Medicine." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:BattleAbbey a schema:Place ;
    rpg:name "Battle Abbey" ;
    dc:description "A Benedictine abbey founded by William the Conqueror on the site of the Battle of Hastings, its high altar marking where Harold died." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:BattleOfTheFalseSun a rpg:Tag ;
    skos:prefLabel "Battle of the False Sun" ;
    dc:description "The final battle at Cad Gadu in Wales where Damhan-Allaidh and his allies were finally defeated by Pralix's army." ;
    rpg:hasTag amol:HermeticConcept .
amol:Baumesel a rpg:Creature ;
    rpg:name "Baumesel" ;
    dc:description "A malicious wood-spirit used to frighten children, which attacks lone travelers in the woods." ;
    skos:altLabel "Ass of the Trees" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Bautzen a schema:Place ;
    rpg:name "Bautzen" ;
    dc:description "The only place in Lusatia with real German influence, site of the 1018 Peace of Bautzen, where the Knights of the Sword maintain a fortification holding slaves before transport to Prague." ;
    skos:altLabel "Budysin" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:BearClan a rpg:Faction ;
    rpg:name "Bear Clan" ;
    dc:description "A clan of Crintera composed of its largest and fiercest warriors, traditionally berserkers who fight with maces; their leader Dietrich can sense shape-changers." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:BeastsOfVirtue a rpg:Creature ;
    rpg:name "Beasts of Virtue" ;
    dc:description "Magical animals that resemble fine specimens of mundane creatures but possess hidden or surprising abilities suited to their kind; the most obvious magical creatures." ;
    skos:altLabel "magical animals" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Becoming a rpg:Tag ;
    skos:prefLabel "Becoming" ;
    dc:description "A Major Arcadian Mystery (Virtue) teaching a maga how to irreversibly transform body, mind, and spirit to become a faerie, as Quendalon was reputed to have done." ;
    rpg:hasTag amol:Virtue .
amol:BeeKing a rpg:Tag ;
    skos:prefLabel "Bee King" ;
    dc:description "A Major Supernatural Virtue from faerie blood letting a character command and understand bees, never be stung, and not age, but die exactly a century after birth." ;
    skos:altLabel "Bee Kingship", "Bee Queen" ;
    rpg:hasTag amol:Virtue .
amol:BelasKnap a schema:Place ;
    rpg:name "Belas Knap" ;
    dc:description "A long barrow with a stone-blocked doorway that is said to open on significant nights, allowing access to a faerie palace from which no one returns." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Belin a rpg:Character ;
    rpg:name "Belin" ;
    dc:description "Mercere's last apprentice, renowned for her devotion to the Order and dedication to delivering messages despite having no Gift; held up as an ideal in House Mercere." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Belinda a rpg:Character ;
    rpg:name "Belinda" ;
    dc:description "A Redcap who has traveled further east than any other and reported a vast magical city ruled by wise old magi at the fringes of the Order." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Belinus a rpg:Character ;
    rpg:name "Belinus" ;
    dc:description "A legendary king of Britain who, with his brother Brennius, sacked Rome and brought back a hoard of treasure possibly including magical texts." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:BellsOfSpeyer a rpg:Tag ;
    skos:prefLabel "Bells of Speyer" ;
    dc:description "The bells of Speyer's cathedral that toll without mortal hand on the occasion of an imperial death; they refused to toll for the excommunicated Henry IV until his absolution." ;
    rpg:hasTag amol:HermeticConcept .
amol:BeltaneFireFestivals a rpg:Tag ;
    skos:prefLabel "Beltane Fire Festivals" ;
    dc:description "Irish fire festivals that dispel minor Hermetic enchantments and curse witches, forcing the Gifted behind the Aegis of the Hearth." ;
    skos:altLabel "Beltane" ;
    rpg:hasTag amol:HermeticConcept .
amol:Benefactor a rpg:Tag ;
    skos:prefLabel "Benefactor" ;
    dc:description "A sponsor who agrees to buy a single piece of artwork from an artist; gaining one grants 3 Artist Reputation experience points." ;
    rpg:hasTag amol:HermeticConcept .
amol:Beowulf a rpg:Character ;
    rpg:name "Beowulf" ;
    dc:description "The hero who slew the troll Grendel; Theoderich has been unable to find his remains." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:BerechiahBenNatronaiHaNakdan a rpg:Character ;
    rpg:name "Berechiah ben Natronai haNakdan" ;
    dc:description "A Jewish scribe and author of Oxford (born 1162), secretly a highly skilled natural magician considering contact with the Order to defend the Jews." ;
    skos:altLabel "Berechiah" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Berenger a rpg:Character ;
    rpg:name "Berenger" ;
    dc:description "An example fellow alchemist, less skilled than Martin, who learns the cement formula from Martin's Laboratory Text and tractatus." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Bern a schema:Place ;
    rpg:name "Bern" ;
    dc:description "The city of which Dietrich was boy-king after the fall of Rome; conquered by his uncle Ermenrik and later retaken by Dietrich." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:BernardOfClairvaux a rpg:Character ;
    rpg:name "Bernard of Clairvaux" ;
    dc:description "A churchman who condemned the heretical works of Peter Abelard to the flames." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:BerniceOfThessalonica a rpg:Character ;
    rpg:name "Bernice of Thessalonica" ;
    dc:description "The maga who was Flavius of Jerbiton's teacher, collected him from the Alps, and negotiated with Trianoma to bring Eastern Empire magi into the Order; she died in 763 before the First Tribunal." ;
    skos:altLabel "Bernice" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:BetrayingWhispersOfTheJealousMind a rpg:Spell ;
    rpg:name "Betraying Whispers of the Jealous Mind" ;
    dc:description "An InMe 30 spell that lets the caster hear, as muffled repeated whispers, the dominant emotions other people hold concerning him as they come within earshot." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Beuthen a schema:Place ;
    rpg:name "Beuthen" ;
    dc:description "A Polish town with a lead mine operated by the demon Szarlen in return for services under a demonic arrangement." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Bia a rpg:Creature ;
    rpg:name "Bia" ;
    dc:description "The Daimon of force, power, and compulsion, daughter of Styx and Pallas, who with her sister Peitho represents forceful inducement." ;
    skos:altLabel "Force" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:BielowezcaForest a schema:Place ;
    rpg:name "Bielowezca Forest" ;
    dc:description "A forest in Poland where Ulf's ancestor Lupercus haunts in the form of an immense wolf Great Beast." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Bielowiezca a schema:Place ;
    rpg:name "Bielowiezca" ;
    dc:description "A forest in whose region the example Bjornaer magus Ulf drives out a village of hunters and becomes leader of the largest wolf-packs as part of his Great Beast's trials." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Bilera a rpg:Character ;
    rpg:name "Bilera" ;
    dc:description "The Prima of House Guernicus, an Archmaga with a neutral stance on the Traditionalist/Transitionalist debate, residing at Magvillus." ;
    skos:altLabel "Archmaga Bilera" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:BindTheGift a rpg:Spell ;
    rpg:name "Bind The Gift" ;
    dc:description "A Rego Vim 30 enchanted effect in Philippus Niger's Wizard's Bridle that prevents the casting of any spells of level 25 or below as a constant effect." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:BindingTheGift a rpg:Tag ;
    skos:prefLabel "Binding the Gift" ;
    dc:description "A Minor House Mystery (Virtue) taught by Merinita that lets a magus share his Gift's social quality through the familiar cords, moderating the Gift's penalties via the Golden, Silver, Bronze Gifts and the three cords." ;
    skos:altLabel "Binding the Gift (Minor House Mystery)" ;
    rpg:hasTag amol:Virtue .
amol:BindingTheHermeticCodex a rpg:Spell ;
    rpg:name "Binding the Hermetic Codex" ;
    dc:description "A Rego Animal 20 ritual variant of Binding the Mundane Codex that incorporates resonant materials into book bindings." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:BindingTheMundaneCodex a rpg:Spell ;
    rpg:name "Binding the Mundane Codex" ;
    dc:description "A Rego Animal 5 spell that binds up to 1,000 prepared bifolds into books and grants readers the +1 quality bonus for sound binding." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:BishopSPlatter a rpg:Item ;
    rpg:name "Bishop's Platter" ;
    dc:description "A wondrous silver serving tray made by a silversmith that copies the spell Taste of the Spices and Herbs (Craft Level 13)." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:BjornIronside a rpg:Character ;
    rpg:name "Bjorn Ironside" ;
    dc:description "A deputy of Waddenzee who is the ship's master of the Nebelkönigin." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:BlackForestRoad a schema:Place ;
    rpg:name "Black Forest Road" ;
    dc:description "The only road across the Black Forest, built by the Roman 8th legion under Cornelius Clemens between Strassburg and Augsburg, with magical milestones warding away supernatural denizens." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:BlackLineage a rpg:Faction ;
    rpg:name "Black Lineage" ;
    dc:description "An intelligent lineage of cats descended from House Jerbiton's Founder's familiar that understand human language, often have Second Sight, live around 40 years, and have a parliament that elects a monarch (the King of the Cats)." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:BlackMountains a schema:Place ;
    rpg:name "Black Mountains" ;
    dc:description "Mountains in south Wales where the covenant Blackthorn is hidden in a warren of caves and where Goliard once subdued an elemental spirit causing rockslides." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:BlackSerpentOfTheBarrow a rpg:Creature ;
    rpg:name "Black Serpent of the Barrow" ;
    dc:description "A serpent dwelling in a barrow on the Mournful Mound that kills the sons of the King of Suffering daily and carries a wish-granting gold stone in its tail; slain by Peredur." ;
    skos:altLabel "Black Serpent" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:BlackberryGod a rpg:Creature ;
    rpg:name "Blackberry God" ;
    dc:description "A powerful faerie harvest deity worshipped in the Worshipful covenant's regio; the magi side with him as a Faerie Landlord and provide him vast amounts of beer." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Blackrose a rpg:Faction ;
    rpg:name "Blackrose" ;
    dc:description "Covenant founded by Blackthorn in 1104 on the North York Moors near Voluntas; recalled in 1107 after persistent mundane troubles." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:Bladud a rpg:Character ;
    rpg:name "Bladud" ;
    dc:description "A legendary king of Britain who founded the city of Bath, encouraged magic, gathered a secret library of magical lore, and died flying." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:BladudSLibrary a schema:Place ;
    rpg:name "Bladud's Library" ;
    dc:description "A secret cave library of magical lore gathered by Bladud, written in a lost language and invaluable to a covenant if found." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:BlatantMagicalAir a rpg:Tag ;
    skos:prefLabel "Blatant Magical Air" ;
    dc:description "A Major Supernatural Flaw for characters with a Magical Air or The Gift: a -6 penalty to social actions and being hated and feared by the mundane population." ;
    rpg:hasTag amol:Flaw .
amol:BlautopfPool a schema:Place ;
    rpg:name "Blautopf Pool" ;
    dc:description "A deep-blue round pool at the southern edge of the Swabian Jura, source of the River Blau, with a Faerie aura and home to the water faerie Schöne Lau." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:BlessedReliefOfTheBenightedReins a rpg:Spell ;
    rpg:name "Blessed Relief of the Benighted Reins" ;
    dc:description "A Rego Corpus 25 spell that magically removes a kidney stone from a patient's body into the caster's hand, requiring an Intelligence + Finesse roll." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:BloodOfHeroes a rpg:Tag ;
    skos:prefLabel "Blood of Heroes" ;
    dc:description "A heroic ancestral trait that runs through some Redcaps' veins, granting them unusual capabilities." ;
    skos:altLabel "heroic blood" ;
    rpg:hasTag amol:Virtue .
amol:BloodyFlux a rpg:Creature ;
    rpg:name "Bloody Flux" ;
    dc:description "A Serious Phlegmatic Disease (excess of phlegm) caused by cold, wet living conditions, common in towns and armies." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Blwchbardd a rpg:Character ;
    rpg:name "Blwchbardd" ;
    dc:description "One of the five great Welsh poets believed by the Order to have left Daimons behind after death." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Boaz a rpg:Item ;
    rpg:name "Boaz" ;
    dc:description "One of two great hollowed stone pillars (\"great strength\") of Solomon's temple legend that hold treasures of the ancient Hebrews." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:Boethius a rpg:Character ;
    rpg:name "Boethius" ;
    dc:description "A Roman statesman, philosopher, and inventor whose notebooks Milo recovered; his philosophical principles were used to refine Verditius Runes, and a ritual was named after him." ;
    skos:altLabel "Anicius Manlius Severinus Boethius" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Boglin a rpg:Creature ;
    rpg:name "Boglin" ;
    dc:description "A foul, tentacled, primeval swamp spirit (Magic Might 25, Aquam) of northern Germany that lurks underwater, drags prey to its maw, and yields Animal and Perdo vis." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:BoiiSprings a schema:Place ;
    rpg:name "Boii Springs" ;
    dc:description "Twelve hot mineral springs in western Bohemia near a Celtic settlement, including a 40-foot geyser; drinking the waters cures digestive disorders and the name derives from the Celtic Boii tribe." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Boncompagno a rpg:Character ;
    rpg:name "Boncompagno" ;
    dc:description "The rector of Bologna's Faculty of Arts, a famous rhetorician proposing to erect a dedicated building to house the university's learning." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:BookOfInstruction a rpg:Item ;
    rpg:name "Book of Instruction" ;
    dc:description "A text written by Tytalus laying down arbitrary rules and seemingly random punishments for apprentices; the most hated object of a Tytalan apprentice, governing how to treat rather than train him." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:BooksThatScreamInPain a rpg:Spell ;
    rpg:name "Books that Scream in Pain" ;
    dc:description "An Intellego Animal 25 spell with Herbam requisite that checks every book in a room for a physical or historical property; named for an early Durenmar librarian who made damaged books cry out." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Boons a rpg:Tag ;
    skos:prefLabel "Boons" ;
    dc:description "Features that make a covenant better, costing points (Major three, Minor one, or Free Choices) in covenant creation." ;
    skos:altLabel "Boon" ;
    rpg:hasTag amol:HermeticConcept .
amol:BoostedMagic a rpg:Tag ;
    skos:prefLabel "Boosted Magic" ;
    dc:description "A Minor Hermetic Virtue letting a magus spend vis to boost Range, Duration, Target, or size of Formulaic spells by a magnitude." ;
    rpg:hasTag amol:Virtue .
amol:BorbygusOfVerditius a rpg:Character ;
    rpg:name "Borbygus of Verditius" ;
    dc:description "A Verditius magus and Collegium member who secretly imprisons scholars to build a magical collection of 'realia' that serves as a living library on Intellego." ;
    skos:altLabel "Borbygus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Bordeaux a schema:Place ;
    rpg:name "Bordeaux" ;
    dc:description "A city in the Provençal Tribunal; Castra Solis is located several leagues south of it." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Boreas a rpg:Character ;
    rpg:name "Boreas" ;
    dc:description "A ninth-century Flambeau magus, descended from Flambeau through Apromor's line, who created the cold-based School of Boreas to appeal to both major lineages of his House." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:BorrowTheEyesOfAnother a rpg:Spell ;
    rpg:name "Borrow the Eyes of Another" ;
    dc:description "An Intellego Mentem spell letting the caster see through the eyes of a person to whom he has an Arcane Connection." ;
    skos:altLabel "InMe 30" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:BoundGhost a rpg:Tag ;
    skos:prefLabel "Bound Ghost" ;
    dc:description "A Flaw that magically binds a ghost so it cannot leave the covenant, taken by the Ghostly Warden." ;
    rpg:hasTag amol:Flaw .
amol:BoundMagic a rpg:Tag ;
    skos:prefLabel "Bound Magic" ;
    dc:description "A Minor Hermetic Flaw: when the magus dies, all his spells end and any magic items he created cease to function." ;
    rpg:hasTag amol:Flaw .
amol:BoundToRealm a rpg:Tag ;
    skos:prefLabel "Bound to (Realm)" ;
    dc:description "A Major Supernatural Flaw: the character cannot survive in the mundane world and must live in a supernatural aura of 5 or greater of a chosen realm to stay healthy." ;
    rpg:hasTag amol:Flaw .
amol:BoundToRole a rpg:Tag ;
    skos:prefLabel "Bound to (Role)" ;
    dc:description "A Minor Supernatural Flaw: the character is physically bonded to a device or place and suffers deprivation if separated from it; includes the effects of Unaging." ;
    skos:altLabel "Bound to (Role) Role" ;
    rpg:hasTag amol:Flaw .
amol:Boundless a rpg:Tag ;
    skos:prefLabel "Boundless" ;
    dc:description "A Free laboratory Supernatural Virtue: the lab interior has unlimited space despite mundane outer limits, of non-Hermetic or faerie origin (+2 Warping)." ;
    rpg:hasTag amol:Virtue .
amol:Branwen a rpg:Character ;
    rpg:name "Branwen" ;
    dc:description "A woman in her twenties at Cad Gadu, the only covenfolk member trying to reverse its decay by improving defenses and recruiting new magi." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:BreakingTheShacklesOfVulgarPerception a rpg:Spell ;
    rpg:name "Breaking the Shackles of Vulgar Perception" ;
    dc:description "A spell of at least 5th magnitude invented by Primus Handri of Merinita that allows the target to perceive the world as the faeries do." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Bremen a schema:Place ;
    rpg:name "Bremen" ;
    dc:description "A port city on the north bank of the River Weser whose bishopric was founded in the 8th century by Charlemagne's missionary Willehad." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:BrethrenOfTheFreeSpirit a rpg:Faction ;
    rpg:name "Brethren of the Free Spirit" ;
    dc:description "A heretical pantheistic cult emerging at the start of the 13th century from Paris theologians and spreading in Cologne, equating God to primary matter and holding that there is no sin." ;
    skos:altLabel "the Brethren" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:BrewTheHealingTonic a rpg:Spell ;
    rpg:name "Brew the Healing Tonic" ;
    dc:description "A Rego Herbam 10 spell that combines raw ingredients into a restorative theriac giving +3 to Wound Recovery rolls, provided the caster has the formula." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:BricriuMacCarbada a rpg:Character ;
    rpg:name "Bricriu mac Carbada" ;
    dc:description "An Irish poet/demigod claimed by some Ex Miscellanea as the progenitor of the Nemthengacha line of bitter-tongued sorcerers." ;
    skos:altLabel "Bricriu" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Bricstan a rpg:Character ;
    rpg:name "Bricstan" ;
    dc:description "A man of the Ely estate falsely accused of usury by Robert 'Malarteis', imprisoned in London, and miraculously freed by St. Benedict, St. Etheldreda, and St. Sexburga." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:BridgeOfFrost a rpg:Spell ;
    rpg:name "Bridge of Frost" ;
    dc:description "A Rego Aquam spell (Level 30) that forms a thick layer of frost firm enough to walk on across the surface of a body of water." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:BridleOfTheTalkingHorse a rpg:Item ;
    rpg:name "Bridle of the Talking Horse" ;
    dc:description "A wondrous bridle made by a leather maker that allows a horse's rider to talk to his steed (Craft Level 17)." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:BrillianceOfTheEagleSPlumage a rpg:Spell ;
    rpg:name "Brilliance of the Eagle's Plumage" ;
    dc:description "A CrIg 30 Spectacle-Target spell that blinds anyone looking directly at the caster with brilliant light." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Bristol a schema:Place ;
    rpg:name "Bristol" ;
    dc:description "A well-defended sea port surrounded by the rivers Frome and Avon and a royal castle, governed by a mayor and prospering chiefly on trade with Ireland." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:BrittleBones a rpg:Tag ;
    skos:prefLabel "Brittle Bones" ;
    dc:description "A Major Curse (Rego Corpus effect) making the victim's bones fragile, risking broken bones (treated as Heavy Wounds) during strenuous activity." ;
    rpg:hasTag amol:Flaw .
amol:BrogoTheDwarf a rpg:Character ;
    rpg:name "Brogo the Dwarf" ;
    dc:description "A dwarf trouvère from Tournai with the Curse of Venus and Death Prophecy, a wandering composer presented as a starting companion-level character who has visited Hermetic covenants." ;
    skos:altLabel "Brogo" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:BrokenVessel a rpg:Tag ;
    skos:prefLabel "Broken Vessel" ;
    dc:description "A Minor Supernatural Flaw: the character's supernatural powers may be temporary, and rolling a zero on Stress Rolls for them costs experience points." ;
    rpg:hasTag amol:Flaw .
amol:BrotherChaplain a rpg:Tag ;
    skos:prefLabel "Brother Chaplain" ;
    dc:description "A Minor Social Status Virtue for a priest of a crusading order, answerable only to the pope outside the order." ;
    rpg:hasTag amol:Virtue .
amol:BrotherKnight a rpg:Tag ;
    skos:prefLabel "Brother Knight" ;
    dc:description "A Minor Social Status Virtue for a knight in a holy crusading order, sworn to obedience, poverty, and chastity." ;
    rpg:hasTag amol:Virtue .
amol:BrotherPaulOfBolzano a rpg:Character ;
    rpg:name "Brother Paul of Bolzano" ;
    dc:description "An Augustinian canon, once a petty thief, who died at the hands of diabolists; his severed head weeps tears containing Mentem vis on the anniversary of his conversion." ;
    skos:altLabel "Brother Paul" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:BrotherSergeant a rpg:Tag ;
    skos:prefLabel "Brother Sergeant" ;
    dc:description "A Minor Social Status Virtue for a non-knightly member of a crusading order under vows of obedience, poverty, and chastity." ;
    rpg:hasTag amol:Virtue .
amol:BrotherKnight_2 a rpg:Tag ;
    skos:prefLabel "Brother-Knight" ;
    dc:description "A Templar Social Status Virtue for a knight of the Poor Knights of the Temple of Solomon; its effects are included in Templar Commander." ;
    skos:altLabel "Brother-Knight Virtue" ;
    rpg:hasTag amol:Virtue .
amol:BrotherPriest a rpg:Tag ;
    skos:prefLabel "Brother-Priest" ;
    dc:description "A Templar Status Virtue for a brother-priest of the Poor Knights of the Temple of Solomon, replaceable by Templar Administrator." ;
    rpg:hasTag amol:Virtue .
amol:BrotherSergeant_2 a rpg:Tag ;
    skos:prefLabel "Brother-Sergeant" ;
    dc:description "A Templar Status Virtue for a brother-sergeant of the Poor Knights of the Temple of Solomon, replaceable by Templar Administrator." ;
    rpg:hasTag amol:Virtue .
amol:BrotherhoodOfSaintLazarus a rpg:Faction ;
    rpg:name "Brotherhood of Saint Lazarus" ;
    dc:description "An order that, with House Jerbiton, maintains a leprosarium within an Immunity aura where covenfolk live long, healthy lives until they leave." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Bruges a schema:Place ;
    rpg:name "Bruges" ;
    dc:description "The greatest manufacturing center of the Flemish industrial region, where merchants may not buy land but may dress richly, noted for luxurious trousers." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Brugge a schema:Place ;
    rpg:name "Brugge" ;
    dc:description "A Flemish town and major power in the wool, weaving, and cloth industries, governed by elected officials and linked to the sea by the Zwin channel created by a sea dragon." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:BruggeBear a rpg:Creature ;
    rpg:name "Brugge Bear" ;
    dc:description "A ferocious bear that attacked Baldwin I at the site of Brugge, was magically transformed, joined his retinue, and became the first citizen of Brugge." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Brunhilda a rpg:Character ;
    rpg:name "Brunhilda" ;
    dc:description "Henri de Tours' Swedish wife, a magical folk practitioner with the power of divination who can send her spirit in animal shape; not formally a member of the Order." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Brunswick a schema:Place ;
    rpg:name "Brunswick" ;
    dc:description "A Saxon city beautified by Henry the Lion, centered on a bronze lion statue (the Burglowe) and a fortress-shaped cathedral beside Burg Dankwarderode." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Brutus a rpg:Character ;
    rpg:name "Brutus" ;
    dc:description "The Trojan founder of Britain who named the island after himself and built New Troy on the Thames after a prophecy from Diana." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:BrynCelliDdu a schema:Place ;
    rpg:name "Bryn-Celli-Ddu" ;
    dc:description "A mound on Anglesey with a chambered passage and a carved labyrinth warding stone; the place where Llewellyn, last primus of House Diedne, was last seen, and which Hermetic magi tend to avoid." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:BrNn a schema:Place ;
    rpg:name "Brünn" ;
    dc:description "A castle and town at the confluence of the Svitava and Svratka rivers, seat of the Premyslid rulers in Moravia; once tormented by the Dragon of Brünn." ;
    skos:altLabel "Brno" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:BuilderSHelper a rpg:Item ;
    rpg:name "Builder's Helper" ;
    dc:description "A wondrous miniature ladder that expands to 15 feet upon command and can be carried in a builder's pack (Craft Level 15)." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:Burchwen a rpg:Character ;
    rpg:name "Burchwen" ;
    dc:description "Saint Godric's sister, also a hermit, who according to Godric gave him his shortest hymn after she died." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Bureaucrat a rpg:Tag ;
    skos:prefLabel "Bureaucrat" ;
    dc:description "A Minor Social Status Virtue for a member of the Islamic civil administration, such as a scribe or legal-document writer." ;
    skos:altLabel "katib" ;
    rpg:hasTag amol:Virtue .
amol:BurgTrifels a schema:Place ;
    rpg:name "Burg Trifels" ;
    dc:description "An imperial fortress-palace atop the Sonnenberg at the edge of the Palatinate Forest, favored by Frederick Barbarossa, where Richard the Lionheart was imprisoned in 1193." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Burglar a rpg:Tag ;
    skos:prefLabel "Burglar" ;
    dc:description "A thematic covenfolk template thief with Great Dexterity x2 and high Legerdemain and Stealth, suited to covenants involved in Hermetic politics." ;
    rpg:hasTag amol:CharacterType .
amol:BurningFlesh a rpg:Tag ;
    skos:prefLabel "Burning Flesh" ;
    dc:description "A Major Curse (Rego Corpus effect) covering the victim in itching red splotches, requiring Stamina + Concentration rolls to do anything but scratch." ;
    rpg:hasTag amol:Flaw .
amol:BurningIssueOfTheDay a rpg:Spell ;
    rpg:name "Burning Issue of the Day" ;
    dc:description "A ReMe 30 spell that compels a target Group to repeat a piece of information (true or false) to everyone they meet for the spell's duration." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:BurstOfTheSweepingFlames a rpg:Spell ;
    rpg:name "Burst of the Sweeping Flames" ;
    dc:description "A Rego Ignem spell (Level 25) that causes a fire to explode outward along the ground as if blown, igniting anything in its path for +5 to +15 damage." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Buss a rpg:Item ;
    rpg:name "Buss" ;
    dc:description "A small, long, narrow seagoing ship descended from the Viking knarr, carrying around 20 tons and used for coastal trade and fishing." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:ByzantineEmpire a rpg:Faction ;
    rpg:name "Byzantine Empire" ;
    dc:description "The empire against which Sikelgaita of Sicily's husband fought; Norman conquests in Byzantium were lost after the war turned against her family." ;
    skos:altLabel "Byzantium" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Cabal a rpg:Tag ;
    skos:prefLabel "Cabal" ;
    dc:description "A coordinated group of House Tytalus followers who anonymously join to pursue a shared goal of changing society, using esoteric names and identifying symbols." ;
    skos:altLabel "cabals" ;
    rpg:hasTag amol:HermeticConcept .
amol:CabalLegacy a rpg:Tag ;
    skos:prefLabel "Cabal Legacy" ;
    dc:description "A Virtue suggested for Mithraic characters of House Flambeau." ;
    rpg:hasTag amol:Virtue .
amol:Caerwent a schema:Place ;
    rpg:name "Caerwent" ;
    dc:description "A place in Britain whose old lord imprisoned his young bride; the hawk-knight, father of Yonec, was killed there for love of the lady." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Cailleach a rpg:Creature ;
    rpg:name "Cailleach" ;
    dc:description "An evil faerie hag that plagues the covenant of Circulus Ruber, unable to breach its Aegis of the Hearth and taking out its frustration on travelers." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Caithlinn a rpg:Character ;
    rpg:name "Caithlinn" ;
    dc:description "A maga of House Diedne of Oakdell covenant against whom Severus Maximus declared Wizard War in 1004 AD." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:CaitlinExMiscellanea a rpg:Character ;
    rpg:name "Caitlin Ex Miscellanea" ;
    dc:description "Aindread's filia, a young polite maga who sometimes represents Burnham at tribunal and refuses all negotiations; has mismatched eyes." ;
    skos:altLabel "Caitlin" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:CallOfTheRushingWaters a rpg:Spell ;
    rpg:name "Call of the Rushing Waters" ;
    dc:description "An Intellego Aquam spell (Level 15) that lets the caster locate any natural body of water to which they have an Arcane Connection by hearing it." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:CallTheDream a rpg:Spell ;
    rpg:name "Call the Dream" ;
    dc:description "A Rego Mentem spell letting the caster determine the theme of a sleeping person's dream by touch." ;
    skos:altLabel "ReMe 20" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Calliclean a rpg:Tag ;
    skos:prefLabel "Calliclean" ;
    dc:description "One of the two ethical viewpoints of House Tytalus's Philosophy of Conflict, represented by clockwise spiral symbolism indicating growth and perception." ;
    skos:altLabel "Calliclean ethical viewpoint" ;
    rpg:hasTag amol:HermeticConcept .
amol:CallicleanEthics a rpg:Tag ;
    skos:prefLabel "Calliclean Ethics" ;
    dc:description "A branch of Tytalan philosophy named after the Sophist Callicles that champions physis over nomos, holding that the strong should throw off the restraints of custom; symbolized by a clockwise spiral." ;
    skos:altLabel "Calliclean view", "Callicleans" ;
    rpg:hasTag amol:HermeticConcept .
amol:Callicles a rpg:Character ;
    rpg:name "Callicles" ;
    dc:description "An ancient Greek Sophist quoted in the Analects of Tytalus who championed natural justice of the strong over the laws of weaklings; the Calliclean view is named after him." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:CallingTheCouncilOfTrees a rpg:Spell ;
    rpg:name "Calling the Council of Trees" ;
    dc:description "A Hermetic ritual many magi believe to be of druidical origin, though House Merinita claims it for their Founder." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:CallingTheCouncilOfTheTrees a rpg:Spell ;
    rpg:name "Calling the Council of the Trees" ;
    dc:description "A Rego Herbam ritual (Level 45) that compels all magical and potentially mobile trees within a woodland to gather to hold meetings and summon ancient powers; trees remain animated for a month." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:CallingTheOdiousDrought a rpg:Spell ;
    rpg:name "Calling the Odious Drought" ;
    dc:description "A Perdo Aquam Ritual spell (Level 50) with an Auram requisite that causes a drought over the surrounding area, drying streams and rivers." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:CalmingTouch a rpg:Spell ;
    rpg:name "Calming Touch" ;
    dc:description "A power of the angel Nasir (3 points, Animal/Mentem) that, by touching the target, calms their fears and reassures them in the face of dangerous terrain." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:CalorificStone a rpg:Item ;
    rpg:name "Calorific Stone" ;
    dc:description "A Level 10 Alteration Reagent that, when dropped into water, makes the water boil within seconds; a single dose can affect a bathtub of water." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:CaltisOfTremere a rpg:Character ;
    rpg:name "Caltis of Tremere" ;
    dc:description "A young Tremere magus among the members recruited to Nigrasaxa." ;
    skos:altLabel "Caltis" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Calum a rpg:Character ;
    rpg:name "Calum" ;
    dc:description "A lapsed priest among Waddenzee's covenfolk who provides a heretical form of spiritual sustenance to the pirates." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:CamargueDelta a schema:Place ;
    rpg:name "Camargue Delta" ;
    dc:description "The wild and inhospitable delta where the Rhone ends, home to a ghostly horse that keeps a larder of up to 100 wicked children." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:CambrianMountains a schema:Place ;
    rpg:name "Cambrian Mountains" ;
    dc:description "The mountain range in Wales where Aneirin's tomb lies and across which his spirit wanders, helping those who further his ideals and punishing those who oppose them." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:CambunianMountains a schema:Place ;
    rpg:name "Cambunian Mountains" ;
    dc:description "Mountains on the northern border of Thessaly where the Daughters of Erictho dwell in cliffside caves near Faerie regiones." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Cardiff a schema:Place ;
    rpg:name "Cardiff" ;
    dc:description "The most important town in Wales, in a country with few towns and a largely barter-based economy." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:CardinalRobertCaurOn a rpg:Character ;
    rpg:name "Cardinal Robert Caurçon" ;
    dc:description "The cardinal who discovered the heresy of David of Dinant in 1215 after reading his book Quaternuli." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:CarelessSorcerer a rpg:Tag ;
    skos:prefLabel "Careless Sorcerer" ;
    dc:description "A Minor Hermetic Flaw: the magus is slapdash with magical power and must roll two more botch dice than normal when casting spells." ;
    rpg:hasTag amol:Flaw .
amol:CarelessWithAbility a rpg:Tag ;
    skos:prefLabel "Careless with (Ability)" ;
    dc:description "A Minor General Flaw: the character is reckless with a particular Ability, treating any rolled zero as a botch when using it." ;
    rpg:hasTag amol:Flaw .
amol:Carles a schema:Place ;
    rpg:name "Carles" ;
    dc:description "A stone circle of forty-two stones about thirty meters across, surrounded by a bank, containing three round barrows and a rectangle of stones called the Porter's Lodge said to become a guarded house on certain nights." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Carouse a rpg:Proficiency ;
    rpg:name "Carouse" ;
    dc:description "A General Ability for enjoying oneself without adverse effects, such as consuming alcohol without passing out and gaining friends among the lower classes." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:Carthusians a rpg:Faction ;
    rpg:name "Carthusians" ;
    dc:description "A strictly cloistered monastic order, the extreme example of monastic insularity." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Castile a schema:Place ;
    rpg:name "Castile" ;
    dc:description "A region of Mythic Europe with distinctive inheritance customs, including an example of a bride continuing to rule her own land except for her dowry, and where a widow may guard her son's lands." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:CastingTotal a rpg:Tag ;
    skos:prefLabel "Casting Total" ;
    dc:description "The total (Stamina + Form + Technique + Aura + stress die) determining whether a spell is cast, used notably when casting from a Casting Tablet." ;
    skos:altLabel "Casting Score" ;
    rpg:hasTag amol:HermeticConcept .
amol:Castratus a rpg:Tag ;
    skos:prefLabel "Castratus" ;
    dc:description "A Minor General Flaw: the character was castrated before puberty, suffering -3 social rolls in Latin culture; only available to characters born with testicles." ;
    rpg:hasTag amol:Flaw .
amol:CataplasmOfMandrake a rpg:Item ;
    rpg:name "Cataplasm of Mandrake" ;
    dc:description "A Theriac of Level 5, Potency Moderate, a secret of the School of Salerno using mandrake and hyoscyamus; it numbs a body part and reduces Wound and Disease Penalties by 3." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:CatapultOfTheMightyWinds a rpg:Spell ;
    rpg:name "Catapult of the Mighty Winds" ;
    dc:description "A Cr(Re)Au 30 spell that uses strong winds to hurl an object on an arched trajectory; once airborne the projectile's motion is natural and bypasses Magic Resistance, doing about +10 damage." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Cataracts a rpg:Tag ;
    skos:prefLabel "Cataracts" ;
    dc:description "A Minor Curse (Perdo Corpus effect) clouding the victim's eyes white and penalizing vision-based rolls and reading advancement by -3." ;
    rpg:hasTag amol:Flaw .
amol:CathedralOfStPierreInBeauvais a schema:Place ;
    rpg:name "Cathedral of St. Pierre in Beauvais" ;
    dc:description "A new-style Gothic cathedral north of Paris standing over 150 feet tall, cited as an example of soaring cathedral architecture." ;
    skos:altLabel "St. Pierre" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:CatoOfBonisagus a rpg:Character ;
    rpg:name "Cato of Bonisagus" ;
    dc:description "A spectral Criamon Primus who was a Bonisagus magus before joining; he believes Criamon magi create the majority of all adulterations." ;
    skos:altLabel "Cato", "Primus Cato" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Catulus a rpg:Tag ;
    skos:prefLabel "Catulus" ;
    dc:description "A Bjornaer apprentice ('cub'), the common property of the sept during the sleeping years of training." ;
    skos:altLabel "catuli", "cub" ;
    rpg:hasTag amol:CharacterType .
amol:Causabon a rpg:Character ;
    rpg:name "Causabon" ;
    dc:description "A magus of House Bonisagus whose journal records his sense of the forests' primal power and his hope that the three domus magnae might share their secrets." ;
    skos:altLabel "Causabon of House Bonisagus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:CautiousWithAbility a rpg:Tag ;
    skos:prefLabel "Cautious with (Ability)" ;
    dc:description "A Minor General Virtue letting a character roll two fewer botch dice for a specific Ability." ;
    rpg:hasTag amol:Virtue .
amol:CautiousWithChirurgy a rpg:Tag ;
    skos:prefLabel "Cautious with Chirurgy" ;
    dc:description "A Virtue commonly taken by empirici that reduces botch risk when using the Chirurgy Ability." ;
    rpg:hasTag amol:Virtue .
amol:CautiousWithMedicine a rpg:Tag ;
    skos:prefLabel "Cautious with Medicine" ;
    dc:description "A Virtue that enhances medical skill, reducing the risk of botches when using the Medicine Ability." ;
    rpg:hasTag amol:Virtue .
amol:CementReagent a rpg:Item ;
    rpg:name "Cement (Reagent)" ;
    dc:description "A Level 5 alchemical Reagent, a dry powder that when sprinkled over loose earth or sand binds it as solid as granite, covering about three paces to six inches deep." ;
    skos:altLabel "Cement" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:CeremonialMagic a rpg:Tag ;
    skos:prefLabel "Ceremonial Magic" ;
    dc:description "A method of increasing spellcasting power using natural correspondences, props, and prepared spaces, with casting time reduced by prepared spaces and the Mystical Choreography Virtue." ;
    skos:altLabel "ceremonial casting" ;
    rpg:hasTag amol:HermeticConcept .
amol:Ceres a rpg:Creature ;
    rpg:name "Ceres" ;
    dc:description "A goddess one of whose priestesses always serves as a hierophant of the Huntress in the Wood." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:ChamberOfInvisibility a rpg:Spell ;
    rpg:name "Chamber of Invisibility" ;
    dc:description "A Perdo Imaginem spell (Level 25) that makes a Group of creatures invisible; any affected character who moves or is touched makes everyone visible, and all still cast shadows." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ChamberOfSummerBreezes a rpg:Spell ;
    rpg:name "Chamber of Summer Breezes" ;
    dc:description "A Creo Auram 10 spell with Ignem requisite creating a continual breeze of fresh, dry, warm air to keep a room's humidity and temperature constant, often cast on armarii and book chests." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Chancery a rpg:Faction ;
    rpg:name "Chancery" ;
    dc:description "A branch of the royal court headed by the chancellor Richard de Marsh, responsible for issuing documents under the Great Seal and keeping government records such as the Pipe Rolls." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:ChangeSize a rpg:Spell ;
    rpg:name "Change Size" ;
    dc:description "A Muto Terram effect (MuTe 10) enchanted into Falke's talisman that turns it into a leg-band, triggered by Perceive the Change." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Changeling a rpg:Creature ;
    rpg:name "Changeling" ;
    dc:description "A story-seed faerie who comes regularly to a market for human food to sustain a stolen human child raised by her group living in nearby woodland." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:ChaosOfTheAngryWave a rpg:Spell ;
    rpg:name "Chaos of the Angry Wave" ;
    dc:description "A Rego Aquam spell (ReAq 20) known by Felicia." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Chaotic a rpg:Tag ;
    skos:prefLabel "Chaotic" ;
    dc:description "A Minor laboratory Supernatural Flaw: the lab or its outfittings are in constant flux or motion (-2 Safety, +1 Warping, +2 Muto or Rego)." ;
    rpg:hasTag amol:Flaw .
amol:ChapelThatCannotSleep a schema:Place ;
    rpg:name "Chapel That Cannot Sleep" ;
    dc:description "A chapel raised on an ancient battlefield where mythic death-roads converge, disturbing the sleeping dead near an unfortunate covenant." ;
    skos:altLabel "the Chapel" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:ChapterHouse a rpg:Tag ;
    skos:prefLabel "Chapter House" ;
    dc:description "A small dependent covenant founded at a valuable site far from a covenant's main holding, tending to agitate for independence from its motherhouse." ;
    skos:altLabel "chapter houses" ;
    rpg:hasTag amol:HermeticConcept .
amol:CharacterTypeBjornaerMagus a rpg:Tag ;
    skos:prefLabel "CharacterType (Bjornaer Magus)" ;
    dc:description "A magus of House Bjornaer who possesses a heartbeast and belongs to a clan and sept within the ancestor cult." ;
    skos:altLabel "Bjornaer follower", "Bjornaer magus" ;
    rpg:hasTag amol:CharacterType .
amol:Characteristic a rpg:Tag ;
    skos:prefLabel "Characteristic" ;
    dc:description "The eight inborn attributes (Intelligence, Perception, Strength, Stamina, Presence, Communication, Dexterity, Quickness) defining a character's potential." ;
    skos:altLabel "Characteristics" ;
    rpg:hasTag amol:HermeticConcept .
amol:CharlemagneSEmpire a rpg:Faction ;
    rpg:name "Charlemagne's Empire" ;
    dc:description "The historical Frankish empire whose civilizing forces helped wipe out the Gothic witch-cult tradition." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:CharlemagneSLoaf a rpg:Item ;
    rpg:name "Charlemagne's Loaf" ;
    dc:description "A wondrous loaf of bread whose smallest nibble grants the eater incredible courage, giving a +3 on all Bravery rolls (Craft Level 17)." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:CharlesMartel a rpg:Character ;
    rpg:name "Charles Martel" ;
    dc:description "The Frankish King who repulsed the Moorish army at the Battle of Tours in 732, the historical event that destroyed Flambeau's family estate." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:CharmAgainstPutrefaction a rpg:Spell ;
    rpg:name "Charm against Putrefaction" ;
    dc:description "A Creo Corpus spell (Level 10) that prevents decay of a human corpse or severed body part; used by necromancers to preserve revived corpses." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:CharterDemon a rpg:Creature ;
    rpg:name "Charter Demon" ;
    dc:description "A typical demon with Infernal Might 15 (Mentem) that offers services such as disease relief or merchant bonuses to townsfolk in exchange for tithes or worship under a demonic charter." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Chasidim a rpg:Faction ;
    rpg:name "Chasidim" ;
    dc:description "German Jewish mystics who developed a cultural and religious renaissance after the First Crusade, emphasizing asceticism, martyrdom, and lifelong penitence." ;
    skos:altLabel "German mystics", "pietists" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Chaudepysse a rpg:Creature ;
    rpg:name "Chaudepysse" ;
    dc:description "A Minor Choleric Disease contracted from unclean women, notoriously difficult to cure, causing painful urination." ;
    skos:altLabel "the burning" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:ChavinOfTytalus a rpg:Character ;
    rpg:name "Chavin of Tytalus" ;
    dc:description "A magus of House Tytalus whose spells all promote or advocate war or violence per his sigil; his version of Voice of the Lake makes the lake sound arrogant." ;
    skos:altLabel "Chavin" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:CheatingTheReaper a rpg:Spell ;
    rpg:name "Cheating the Reaper" ;
    dc:description "A Creo Corpus ritual (Level 30) that resolves a major or lesser aging crisis; each application causes Warping." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Cheshire a schema:Place ;
    rpg:name "Cheshire" ;
    dc:description "One of the two English palatinates, where the Earl of Chester holds all the authority of the king." ;
    skos:altLabel "County of Cheshire" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Chester a schema:Place ;
    rpg:name "Chester" ;
    dc:description "A small walled city and capital of the palatine county of Cheshire where the earl of Chester is the highest authority, with a leather trade and a pagan shrine of Minerva carved into nearby rock." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:ChildbedFever a rpg:Creature ;
    rpg:name "Childbed Fever" ;
    dc:description "A Major Sanguine Disease afflicting women who have just given birth, caused by the childbed fever demon." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Christianity a rpg:Faction ;
    rpg:name "Christianity" ;
    dc:description "One of the three most important Divine religions in Mythic Europe; many magi are Christians and its relics are most common." ;
    skos:altLabel "Christian", "Christians" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:ChromaticFlames a rpg:Item ;
    rpg:name "Chromatic Flames" ;
    dc:description "A Level 4 alchemical Reagent that, when sprinkled over flames or mixed with fuel, causes them to burn a different hue chosen by the alchemist until extinguished." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:ChrTienOfTroyes a rpg:Character ;
    rpg:name "Chrétien of Troyes" ;
    dc:description "The most famous trouvère of northern France, whose Arthurian poems concentrate on Arthur and his peers." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:ChurchUpbringing a rpg:Tag ;
    skos:prefLabel "Church Upbringing" ;
    dc:description "A Minor Personality Flaw: the character was schooled and raised by the Church, leaving him less knowledgeable about society and requiring 25 experience points on Church-related Academic Abilities." ;
    rpg:hasTag amol:Flaw .
amol:ChurchOfTheHolySepulcher a schema:Place ;
    rpg:name "Church of the Holy Sepulcher" ;
    dc:description "A holy site in Jerusalem with an extremely strong Divine aura; casting a spell there incurs the maximum example of botch dice." ;
    skos:altLabel "church of the Holy Sepulcher in Jerusalem" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Cian a rpg:Character ;
    rpg:name "Cian" ;
    dc:description "One of the five great Welsh poets believed by the Order to have left Daimons behind after death." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Cindrallon a rpg:Character ;
    rpg:name "Cindrallon" ;
    dc:description "A Flambeau apprentice made a full maga after only seven years for single-handedly slaying a renounced magus in a Wizard's March using a spear." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:CircleOfEncompassingFlame a rpg:Spell ;
    rpg:name "Circle of Encompassing Flame" ;
    dc:description "A Creo Ignem (CrIg 35) fire spell known by the Flambeau template magus." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:CircleOfEncompassingFlames a rpg:Spell ;
    rpg:name "Circle of Encompassing Flames" ;
    dc:description "A Creo Ignem spell (Level 35) that creates a 6-foot-high circle of flames dealing +20 damage to anyone moving through; with a Rego requisite the circle can shrink or grow as the caster concentrates." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:CircleOfTime a rpg:Tag ;
    skos:prefLabel "Circle of Time" ;
    dc:description "House Criamon's core belief that time runs forever in identical cycles, an unguarded prison from which they seek to escape with all humanity." ;
    skos:altLabel "circular time", "cycle of time" ;
    rpg:hasTag amol:HermeticConcept .
amol:CircularWindsOfProtection a rpg:Spell ;
    rpg:name "Circular Winds of Protection" ;
    dc:description "A wind-based spell referenced as a strength level achievable by the Whistle Up the Wind Ability." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:CirculusRuber a rpg:Faction ;
    rpg:name "Circulus Ruber" ;
    dc:description "The oldest covenant in the Hibernian Tribunal, plagued by a Cailleach (an evil faerie hag) that cannot breach its Aegis of the Hearth." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:Cirion a rpg:Character ;
    rpg:name "Cirion" ;
    dc:description "A magus of House Tremere who declared Wizard War against Pietro of House Diedne of Oakdell covenant in 1004 AD." ;
    skos:altLabel "Cirion of Tremere" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Cistercian a rpg:Faction ;
    rpg:name "Cistercian" ;
    dc:description "A monastic tradition that balances its monastic offices with physical or mental labor." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:CityWatch a rpg:Faction ;
    rpg:name "City-Watch" ;
    dc:description "Patrols in large towns that enforce curfew and interrupt crimes in progress, but with no formal investigative function to solve past crimes." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:ClanMysteries a rpg:Tag ;
    skos:prefLabel "Clan Mysteries" ;
    dc:description "Minor-Virtue Mysteries unique to each Bjornaer clan, Initiated by elder clan members to help fulfill duties to their ancestors." ;
    rpg:hasTag amol:HermeticConcept .
amol:ClarionCallOfTheWarHorse a rpg:Spell ;
    rpg:name "Clarion Call of the War Horse" ;
    dc:description "A MuMe 15 Sound-Target spell that heartens anyone hearing the caster's battle cry, granting a +3 bonus to their Brave Personality Trait." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ClearBreathOfTheConsummateLiar a rpg:Spell ;
    rpg:name "Clear Breath of the Consummate Liar" ;
    dc:description "A Muto Vim (Mentem) 20 spell invented by Imanitos Mendax that lets him manipulate a Frosty Breath of the Spoken Lie cast on himself to appear truthful or lying as desired." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ClearSightOfTheNaiad a rpg:Spell ;
    rpg:name "Clear Sight of the Naiad" ;
    dc:description "An Intellego Aquam spell (Level 5) that lets the caster see as clearly through water as through air for a single moment." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Clemens a rpg:Character ;
    rpg:name "Clemens" ;
    dc:description "The most senior master of Fengheld of House Tremere, filius of Stentorius, who runs Fengheld's biggest chapter house." ;
    skos:altLabel "Clemens filius Stentorius", "Clemens of Tremere" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:CloakOfBlackFeathers a rpg:Spell ;
    rpg:name "Cloak of Black Feathers" ;
    dc:description "A Muto Corpus spell (Level 30) with an Animal requisite that transforms the caster into a raven via a cape of raven feathers." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:CloakOfTheDuckSFeathers a rpg:Spell ;
    rpg:name "Cloak of the Duck's Feathers" ;
    dc:description "A Rego Aquam spell (Level 5) that makes water run off an object or creature, protecting it from dampness unless submerged." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ClosedMouthOfTheNightwalker a rpg:Spell ;
    rpg:name "Closed Mouth of the Nightwalker" ;
    dc:description "A PeMe 40 Spectacle-Target spell that makes anyone who sees the caster instantly forget having done so." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ClosingTheEarthSGate a rpg:Spell ;
    rpg:name "Closing the Earth's Gate" ;
    dc:description "A Perdo Aquam spell (Level 25) that dries a single spring permanently so it never flows again." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ClumsyMagic a rpg:Tag ;
    skos:prefLabel "Clumsy Magic" ;
    dc:description "A Minor Hermetic Flaw: the magus has trouble targeting spells, with aiming rolls of 0 automatically botching and -3 to Finesse rolls." ;
    rpg:hasTag amol:Flaw .
amol:ClutchOfEbonyEggs a rpg:Faction ;
    rpg:name "Clutch of Ebony Eggs" ;
    dc:description "The Criamon clutch filled with the servants of the Path of Strife, the only clutch with no followers of other paths." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Co a rpg:Proficiency ;
    rpg:name "Co" ;
    dc:description "Reference to Corpus in spell shorthand (ReCo 65) for the Summoning the Champions effect of the Horn of Champions." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticArt .
amol:Coagulation a rpg:Tag ;
    skos:prefLabel "Coagulation" ;
    dc:description "A demonic power allowing demons to manufacture a solid body from ambient unformed matter; in Christian lands demons must abandon coagulated form on Holy Saturday." ;
    rpg:hasTag amol:HermeticConcept .
amol:CoenobiumRhodanien a rpg:Faction ;
    rpg:name "Coenobium Rhodanien" ;
    dc:description "A covenant in the Provençal Tribunal notorious for its involvement in Hermetic politics, preventing the foundation of any covenants it does not control over a large area of the tribunal." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:Coenwulf a rpg:Character ;
    rpg:name "Coenwulf" ;
    dc:description "A member of the Sept of Orn (Clan Wilkis) trained by Hosvir Goatlegs." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:CoerceTheSpiritOfAnger a rpg:Spell ;
    rpg:name "Coerce the Spirit of Anger" ;
    dc:description "A ReMe 20 spell that compels a spirit of anger to obey the caster through dramatic threats, with effectiveness determined by a Communication + Leadership roll." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:CoerceTheSpiritsOfTheNight a rpg:Spell ;
    rpg:name "Coerce the Spirits of the Night" ;
    dc:description "A spell that makes a ghost obey the caster as long as it can be coerced with threats such as defiling its grave or banishing it to Hell." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Cog a rpg:Item ;
    rpg:name "Cog" ;
    dc:description "The main clinker-built trade ship of the Atlantic, North Sea, and Baltic, usually carrying 20 tons but sometimes 100 to 140 tons." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:CoilsOfEntanglingPlants a rpg:Spell ;
    rpg:name "Coils of Entangling Plants" ;
    dc:description "A Rego Herbam spell (ReHe 20) known by Ioannes Acer with Mastery in Fast Casting." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ColensArcanorum a rpg:Tag ;
    skos:prefLabel "Colens Arcanorum" ;
    dc:description "A House Bonisagus office, held by Andrus, jointly responsible for disseminating the House's knowledge and research." ;
    rpg:hasTag amol:CharacterType .
amol:ColloquiCum a rpg:Item ;
    rpg:name "Colloqui Cum" ;
    dc:description "A magical power of the Virtuous Hound (Imaginem, 0 points) that lets it speak by creating sounds apparently from its mouth." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:CommandAnimals a rpg:Tag ;
    skos:prefLabel "Command Animals" ;
    dc:description "A Major Supernatural Tainted Virtue letting a character mentally command mundane animals of a species linked to the tainting demon." ;
    rpg:hasTag amol:Virtue .
amol:CommandingAura a rpg:Tag ;
    skos:prefLabel "Commanding Aura" ;
    dc:description "A Free Supernatural Virtue granted by the pope or the Divine, giving a Church officer a power like Aura of Rightful Authority plus Magic Resistance and Soak scaled by rank." ;
    rpg:hasTag amol:Virtue .
amol:CommandingTheHarnessedBeast a rpg:Spell ;
    rpg:name "Commanding the Harnessed Beast" ;
    dc:description "A Rego Animal spell (Level 30) that implants a complicated command into an animal, which it carries out to the best of its ability." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:CommonGiant a rpg:Creature ;
    rpg:name "Common Giant" ;
    dc:description "An enormous ugly man-like magical creature (Magic Might 12, Corpus) about 20 feet tall, found throughout the British Isles; unlike many magical creatures, giants eat, drink, breathe, and age." ;
    skos:altLabel "A Typical Giant" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:CompanionAnimal a rpg:Tag ;
    skos:prefLabel "Companion Animal" ;
    dc:description "A Minor Social Status Flaw (animals only): the character is the Animal Companion of another character and has little control over his own life." ;
    rpg:hasTag amol:Flaw .
amol:Compassionate a rpg:Tag ;
    skos:prefLabel "Compassionate" ;
    dc:description "A Major or Minor Personality Flaw: the character helps anyone wounded or in trouble and cannot bear to see suffering in others." ;
    rpg:hasTag amol:Flaw .
amol:CompressOfMallow a rpg:Item ;
    rpg:name "Compress of Mallow" ;
    dc:description "A Theriac of Level 15, Potency Mild, a cool bandage of mallow and cucumber that soothes burns and heals any Light Wound caused by fire over a week." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:CompulsionLies a rpg:Tag ;
    skos:prefLabel "Compulsion (Lies)" ;
    dc:description "A Flaw compelling Imanitos Mendax to lie." ;
    rpg:hasTag amol:Flaw .
amol:CompulsiveLying a rpg:Tag ;
    skos:prefLabel "Compulsive Lying" ;
    dc:description "A Major or Minor Personality Flaw: the character finds it hard to tell the truth and embellishes or invents stories whenever he won't be immediately caught." ;
    rpg:hasTag amol:Flaw .
amol:ConcoctionOfLithargeAndHenbane a rpg:Item ;
    rpg:name "Concoction of Litharge and Henbane" ;
    dc:description "A Theriac of Level 15, Potency Strong, a poison combining litharge, henbane, cinnabar and other ingredients that inflicts a Heavy Wound unless the imbiber succeeds at a Stamina roll." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:Concordia a rpg:Faction ;
    rpg:name "Concordia" ;
    dc:description "A short-lived covenant (821–823) in the Lake District that attempted to weld Ex Miscellanea traditions together but fell apart from internal tension." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:ConfidencePoint a rpg:Tag ;
    skos:prefLabel "Confidence Point" ;
    dc:description "A point a character can spend (for example) to walk away from a situation that would otherwise increase a Verditius magus's Hubris score." ;
    rpg:hasTag amol:HermeticConcept .
amol:ConfraternityMember a rpg:Tag ;
    skos:prefLabel "Confraternity Member" ;
    dc:description "A Minor Story Flaw marking membership in one of the smaller cults of magi in House Verditius, granting access to a confraternity's unique Inner Mystery." ;
    rpg:hasTag amol:Flaw .
amol:ConfraternityOfBalento a rpg:Faction ;
    rpg:name "Confraternity of Balento" ;
    dc:description "A confraternity of House Verditius founded by Balento that produces wood-carved devices imbued with fire spells, with members claiming descent from Vulcan." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:ConfraternityOfHiminisTheMad a rpg:Faction ;
    rpg:name "Confraternity of Himinis the Mad" ;
    dc:description "A confraternity of House Verditius founded by Himinis the Mad that produces cursed items and trick devices using the Bind Curse Mystery." ;
    skos:altLabel "Confraternity of Himinis" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:ConfraternityOfIreneTheYounger a rpg:Faction ;
    rpg:name "Confraternity of Irene the Younger" ;
    dc:description "A confraternity of House Verditius founded by the Byzantine princess Irene that creates magical paintings, statues, and mosaics affecting viewers and surroundings." ;
    skos:altLabel "Confraternity of Irene" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:ConfraternityOfRoland a rpg:Faction ;
    rpg:name "Confraternity of Roland" ;
    dc:description "A confraternity of House Verditius founded by Roscius that crafts magical swords engraved with an 'R', studying the sword Durendal." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:ConfusionOfTheInsaneVibrations a rpg:Spell ;
    rpg:name "Confusion of the Insane Vibrations" ;
    dc:description "A Rego Imaginem spell (Level 30) that makes the target see everything vibrate and hear displaced sounds, imposing -3 on Attack and Defense and extra botch dice." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ConjurationOfWildThyme a rpg:Spell ;
    rpg:name "Conjuration of Wild Thyme" ;
    dc:description "A Creo Herbam 20 Ritual spell that creates ten thousand doses of wild thyme, prepared and dried; a different spell is required for each herb." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ConjureTheSturdyVine a rpg:Spell ;
    rpg:name "Conjure the Sturdy Vine" ;
    dc:description "A Creo Herbam spell (Level 5) that grows 10 paces of strong, pliable vine suitable for use as rope from wood or fertile soil." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ConjuringTheHouseOfGod a rpg:Spell ;
    rpg:name "Conjuring the House of God" ;
    dc:description "A ritual Creo Terram spell (Level 45) that creates an unconsecrated church with vaulted ceilings, towers, and stained glass windows." ;
    skos:altLabel "CrTe Level 45" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ConradOfUrach a rpg:Character ;
    rpg:name "Conrad of Urach" ;
    dc:description "A cardinal legate present in Montpellier preparing to announce the pope's desired statutes that would make the Bishop of Maguelone the university's sole authority." ;
    skos:altLabel "Cardinal Legate Conrad of Urach" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:ConstantaTheTessellatrix a rpg:Character ;
    rpg:name "Constanta the Tessellatrix" ;
    dc:description "A student of the Jerbiton Primus Andru, extremely active in coordinating her fellow antigones." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:ConstantineV a rpg:Character ;
    rpg:name "Constantine V" ;
    dc:description "Byzantine Emperor, son of Leo III, against whom the League of Iconophiles was still intriguing at the time of the First Tribunal as monasteries were sacked and icons burned." ;
    skos:altLabel "Emperor Constantine V" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Contagion a rpg:Tag ;
    skos:prefLabel "Contagion" ;
    dc:description "A natural principle (pars pro toto) by which substances acquire second qualities through association or contact, underlying Arcane Connections." ;
    rpg:hasTag amol:HermeticConcept .
amol:Continence a rpg:Tag ;
    skos:prefLabel "Continence" ;
    dc:description "A Minor Personality Flaw: the character does not engage in sexual activity, due to a vow of celibacy or personal choice." ;
    rpg:hasTag amol:Flaw .
amol:ControlFertility a rpg:Proficiency ;
    rpg:name "Control Fertility" ;
    dc:description "A Supernatural Ability that enhances or withdraws the vegetative spirits in living things, affecting fertility, milk yield, conception, and disease; the defining Virtue of the Scinnfolk." ;
    skos:altLabel "Fertility" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:ConverseWithPlantAndTree a rpg:Spell ;
    rpg:name "Converse with Plant and Tree" ;
    dc:description "An Intellego Herbam spell (Level 25) that lets you speak with a plant for one conversation, with detail depending on the plant's type." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ConvolutedMind a rpg:Tag ;
    skos:prefLabel "Convoluted Mind" ;
    dc:description "A Minor General Tainted Virtue giving +3 on Infernal Lore rolls about demons and a common-sense-like warning when dealing with them." ;
    rpg:hasTag amol:Virtue .
amol:CopperRoosterInn a schema:Place ;
    rpg:name "Copper Rooster Inn" ;
    dc:description "An inn at Basel maintained by House Mercere, frequented by Redcaps traveling between the Alps, Rhine, and Normandy Tribunals." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:CorneliusClemens a rpg:Character ;
    rpg:name "Cornelius Clemens" ;
    dc:description "The Roman commander of the 8th legion who built the Black Forest Road during the rule of Vespasian, aided by Mercurian priests." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Corrguineach a rpg:Faction ;
    rpg:name "Corrguineach" ;
    dc:description "An Irish tradition of wizards controlling elemental spirits who were enemies of House Diedne and joined House Flambeau to exterminate them; a Hermetic Sahir variant." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:CorruptedAbilities a rpg:Tag ;
    skos:prefLabel "Corrupted Abilities" ;
    dc:description "A Minor Supernatural Tainted Flaw: one or more Abilities was taught by a demon, giving +3 for selfish use and -3 for selfless use, with use sensed by Divine Powers." ;
    rpg:hasTag amol:Flaw .
amol:CorruptedArts a rpg:Tag ;
    skos:prefLabel "Corrupted Arts" ;
    dc:description "A Minor Hermetic Tainted Flaw: a Hermetic Art was studied from a corrupted source, giving +3 to Casting Total for sinful use and -3 for selfless use; tainted magic appears unholy." ;
    rpg:hasTag amol:Flaw .
amol:CorruptedSpells a rpg:Tag ;
    skos:prefLabel "Corrupted Spells" ;
    dc:description "A Minor Hermetic Tainted Flaw: at least 30 levels of formulaic spells learned from a corrupted source, giving +3 to Casting and Penetration for sinful use and -3 for selfless use." ;
    rpg:hasTag amol:Flaw .
amol:Corsica a schema:Place ;
    rpg:name "Corsica" ;
    dc:description "The island where Verditius was born; site of his blood feud and capture, and where the Rings of Verditius were possibly lost." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Coryza a rpg:Creature ;
    rpg:name "Coryza" ;
    dc:description "A Minor Phlegmatic Disease caused by a cold, damp environment producing an excess of phlegm in the head." ;
    skos:altLabel "the common cold" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:CouncilOfFour a rpg:Tag ;
    skos:prefLabel "Council of Four" ;
    dc:description "The ruling council of House Ex Miscellanea representing different facets of the House's interests, instituted by Pralix and re-instated by later Primi." ;
    rpg:hasTag amol:HermeticConcept .
amol:CouncilOfMembers a rpg:Faction ;
    rpg:name "Council of Members" ;
    dc:description "The governing council of a covenant, comprising its probationary and full members, which holds covenant resources in common and decides matters by vote." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:CouncilOfTours a rpg:Tag ;
    skos:prefLabel "Council of Tours" ;
    dc:description "A Church council whose decree of 1163 forbade the participation of monks in commercial medical practice and non-monastic university education." ;
    rpg:hasTag amol:HermeticConcept .
amol:CountessJeanneOfFlanders a rpg:Character ;
    rpg:name "Countess Jeanne of Flanders" ;
    dc:description "The current lord of Brugge, married to Fernando of Portugal and living in Lille, who is without an heir." ;
    skos:altLabel "Countess Jeanne" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:CourtCoramRege a rpg:Tag ;
    skos:prefLabel "Court coram rege" ;
    dc:description "The highest court of the land, where the king himself sits in judgment wherever he is; only the most important cases reach it and there is no further appeal." ;
    rpg:hasTag amol:HermeticConcept .
amol:CourtOfPiepowder a rpg:Tag ;
    skos:prefLabel "Court of Piepowder" ;
    dc:description "The court that upholds justice during a fair, named from the French for the dusty feet of itinerant tradesmen; it handles trade-related prosecutions under merchant law." ;
    skos:altLabel "fair court", "pied poudre" ;
    rpg:hasTag amol:HermeticConcept .
amol:CourtOfTheAlderPrince a rpg:Faction ;
    rpg:name "Court of the Alder Prince" ;
    dc:description "A faerie court of the seasons, suggested to be sited in the Odenwald, paired with the Willow Maiden's court in the Swabian Forest." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:CourtOfTheBees a rpg:Faction ;
    rpg:name "Court of the Bees" ;
    dc:description "A faerie court with which the young Spring in the Woods covenant has developed good relations." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:CovenantCharter a rpg:Tag ;
    skos:prefLabel "Covenant Charter" ;
    dc:description "The written constitution of a covenant defining membership, governance, resources, rights, responsibilities, and censure; a sample based on Arae Flaviae is provided." ;
    skos:altLabel "charter" ;
    rpg:hasTag amol:HermeticConcept .
amol:CovenantOfCrispWinds a rpg:Faction ;
    rpg:name "Covenant of Crisp Winds" ;
    dc:description "A constantly mobile covenant living on a flotilla of ships that follows a route around the Mediterranean collecting vis and trade goods." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:CovenantOfTheCastleOfFees a rpg:Faction ;
    rpg:name "Covenant of the Castle of Fees" ;
    dc:description "A covenant where, by Unnatural Law, glass is as durable and hard as iron and used as building material and armament." ;
    skos:altLabel "Castle of Fees" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:CovenantOfTheMonkeySReed a rpg:Faction ;
    rpg:name "Covenant of the Monkey's Reed" ;
    dc:description "A covenant on a floating island whose aura, warping to a pattern, is slowly twisting its people and structures into an ancient Egyptian village." ;
    skos:altLabel "Monkey's Reed" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:CovenantOfTheRedbreastedWarriors a rpg:Faction ;
    rpg:name "Covenant of the Redbreasted Warriors" ;
    dc:description "A fallen covenant whose aura a faerie king is said to hold captive in a wine bottle." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:CovenantOfTheSolemnScholars a rpg:Faction ;
    rpg:name "Covenant of the Solemn Scholars" ;
    dc:description "A covenant where, by Unnatural Law, children are able to fly until they lose their virginity." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:Coventry a schema:Place ;
    rpg:name "Coventry" ;
    dc:description "An English town near which the Redcaps' base, Mercer House, is situated." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:CovetDevice a rpg:Tag ;
    skos:prefLabel "Covet Device" ;
    dc:description "A Personality Trait left in an attuned item that makes its owner crave the device, building up over seasons of ownership." ;
    rpg:hasTag amol:Flaw .
amol:CraftAmulets a rpg:Tag ;
    skos:prefLabel "Craft Amulets" ;
    dc:description "The Minor Hermetic Virtue of the Karaites tradition." ;
    rpg:hasTag amol:Virtue .
amol:CraftAutomata a rpg:Tag ;
    skos:prefLabel "Craft Automata" ;
    dc:description "A Major Hermetic Virtue and Ability (initial score 1) granted by the Automata Mystery, allowing a character to construct mechanical men and beasts." ;
    rpg:hasTag amol:Virtue .
amol:CraftGuildTraining a rpg:Tag ;
    skos:prefLabel "Craft Guild Training" ;
    dc:description "A Minor General Virtue granting 50 experience points in Craft, Profession, Bargain, or Guild Organization Lore from above-average apprenticeship." ;
    rpg:hasTag amol:Virtue .
amol:CraftGoldsmith a rpg:Proficiency ;
    rpg:name "Craft: Goldsmith" ;
    dc:description "A Craft Ability for goldsmithing whose higher scores represent more precise, time-consuming metalworking methods." ;
    skos:altLabel "Craft: Goldsmith Ability" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:CraftMason a rpg:Proficiency ;
    rpg:name "Craft: Mason" ;
    dc:description "A Craft Ability for masonry; Villard de Honnecourt's sketchbook tractatus can be studied as a quality-7 source for it." ;
    skos:altLabel "Craft: Mason Ability" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:CraftPercamenarius a rpg:Proficiency ;
    rpg:name "Craft: Percamenarius" ;
    dc:description "The craft of making parchment; a Perception + Finesse roll substitutes for it to determine the quality of vellum produced by the spell Hide to Parchment." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:CraftPoetry a rpg:Proficiency ;
    rpg:name "Craft: Poetry" ;
    dc:description "A Craft Ability for writing poems, increased by studying other poets' literature and used to determine a poem's Aesthetic Quality." ;
    skos:altLabel "Craft: Poetry Ability" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:CraftPotter a rpg:Proficiency ;
    rpg:name "Craft: Potter" ;
    dc:description "A Craft Ability governing pottery, used by Maker of Textured Vessels and Maker of Water Vessels to determine vessel shapes and bonuses." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:Cramped a rpg:Tag ;
    skos:prefLabel "Cramped" ;
    dc:description "A Minor laboratory Structure Flaw: equipment is packed too close together, hampering all but one specialized activity (-1 General Quality, -1 Upkeep, -2 Safety, -1 Aesthetics)." ;
    rpg:hasTag amol:Flaw .
amol:Crateuas a rpg:Character ;
    rpg:name "Crateuas" ;
    dc:description "The greatest herbalist of antiquity, author of the first pharmacopoeia and herbal, the original Root-Cutter, and ancestor of the Pharmacopoeians." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:CravingForTravel a rpg:Tag ;
    skos:prefLabel "Craving for Travel" ;
    dc:description "A Minor General Flaw: the character suffers loneliness and boredom penalties if he does not expose himself to new experiences, getting worse the longer he stays in one place." ;
    rpg:hasTag amol:Flaw .
amol:CreatingAnEmptyBookFromAFilledOne a rpg:Spell ;
    rpg:name "Creating an Empty Book From a Filled One" ;
    dc:description "A Perdo Animal 3 spell that creates a palimpsest from an existing book by flaking away a thin layer from each page." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:CreationOfAnUndeservedReputation a rpg:Spell ;
    rpg:name "Creation of an Undeserved Reputation" ;
    dc:description "A CrMe 20 spell that creates a false memory of a person confessing to an enjoyable evening of intercourse with another, damaging reputation." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:CreationOfTheSimile a rpg:Spell ;
    rpg:name "Creation of the Simile" ;
    dc:description "A CrMe 20 spell that creates a new category of thing in the viewer's mind, granting unconscious familiarity with a broad range of its instances." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:CreepingOil a rpg:Spell ;
    rpg:name "Creeping Oil" ;
    dc:description "A Creo Aquam spell (Level 15) that saturates a porous material with flammable oil which, if ignited, causes fire damage." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Cremona a schema:Place ;
    rpg:name "Cremona" ;
    dc:description "One of the famed southern schools of medicine with access to the corpus of Arabic medical texts, where many Greek and Roman texts were translated from Arabic." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:CrestOfTheEarthWave a rpg:Spell ;
    rpg:name "Crest of the Earth Wave" ;
    dc:description "A Rego Terram spell that creates a wave in the earth traveling outward, tossing aside those caught in its path for +10 damage." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Critias a rpg:Character ;
    rpg:name "Critias" ;
    dc:description "A Sophist and leading member of the Thirty Tyrants of Athens, quoted in the Analects of Tytalus; he held that virtue could be imposed by force and religion was a human invention to control the masses." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:CrossOfSaintOswald a rpg:Item ;
    rpg:name "Cross of Saint Oswald" ;
    dc:description "The wooden cross Saint Oswald raised before battle; its splinters and the moss growing on it have healing powers, as in the cure of the monk Bothelm." ;
    skos:altLabel "the holy cross" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:CrowSVoice a rpg:Tag ;
    skos:prefLabel "Crow's Voice" ;
    dc:description "A Minor Curse (Muto Corpus Animal effect) causing the victim to caw throughout speech, penalizing communication rolls and spell casting by -3." ;
    rpg:hasTag amol:Flaw .
amol:Cruel a rpg:Tag ;
    skos:prefLabel "Cruel" ;
    dc:description "A Minor Flaw making a character cruel, taken by the Familiar Cat as a species Flaw." ;
    skos:altLabel "Cruel (Minor)" ;
    rpg:hasTag amol:Flaw .
amol:CrystalCustodian a rpg:Item ;
    rpg:name "Crystal Custodian" ;
    dc:description "An invested magical item invented by Gudrun Tigurina of Verditius at Durenmar." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:Cuenca a schema:Place ;
    rpg:name "Cuenca" ;
    dc:description "An Iberian town whose fuero of one thousand clauses, granted by Alfonso VIII of Castile in 1190, regulates inheritance, criminal law, and Christian-Jewish relations." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:CultOfAncestors a rpg:Faction ;
    rpg:name "Cult of Ancestors" ;
    dc:description "House Bjornaer's tradition of revering ancestral spirits and Great Beasts, taught through House Bjornaer Lore alongside the House's Exoteric Mystery." ;
    skos:altLabel "ancestor cult of House Bjornaer" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:CultOfHephaestus a rpg:Faction ;
    rpg:name "Cult of Hephaestus" ;
    dc:description "An ancient Greek Mystery Cult of smiths and artificers founded by the god Hephaestus, ancestral to House Verditius." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:CultOfIsis a rpg:Faction ;
    rpg:name "Cult of Isis" ;
    dc:description "A Roman cult once centered on early Florence, with relics found in the Roman Temple of Isis in a magical regio in the city, occupied by a High Priestess and followers." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:CultOfVulcan a rpg:Faction ;
    rpg:name "Cult of Vulcan" ;
    dc:description "The Roman successor of the Cult of Hephaestus, renamed under the empire, which emphasized destructive fire magic and supplied enchanted items to Caesars and the Cult of Mercury." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:CultOfTheDead a rpg:Faction ;
    rpg:name "Cult of the Dead" ;
    dc:description "An alleged cult blamed by medieval writers for the rise of the restless dead; its existence, identity, and responsibility are left to the storyguide." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Cunning a rpg:Proficiency ;
    rpg:name "Cunning" ;
    dc:description "The animal equivalent of Intelligence; Animal spells may affect beasts with Cunning analogous to Mentem affecting human minds." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:CurseOfSlander a rpg:Tag ;
    skos:prefLabel "Curse of Slander" ;
    dc:description "A Minor General or Supernatural Flaw: unpleasant rumors about the character spread wherever he stays, building a bad Reputation centered on a section of mundane society." ;
    rpg:hasTag amol:Flaw .
amol:CurseOfTheEvilHumors a rpg:Spell ;
    rpg:name "Curse of the Evil Humors" ;
    dc:description "A MuAu 25 spell that converts clean air into a noxious cloud of foul humors that can cause malaria (a Medium Wound) on a failed Stamina roll." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:CurseOfTheHauntedForest a rpg:Spell ;
    rpg:name "Curse of the Haunted Forest" ;
    dc:description "A Muto Herbam ritual (Level 60) with a Perdo requisite that turns a normal small forest into a haunted, conscious, and cruel dangerous place." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:CurseOfTheRavenousSwarm a rpg:Spell ;
    rpg:name "Curse of the Ravenous Swarm" ;
    dc:description "A Creo Animal Ritual spell (Level 50) with a Rego requisite that calls a swarm of locusts or destructive insects to devastate an area's plant life and fields." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:CurseOfTheRottedWood a rpg:Spell ;
    rpg:name "Curse of the Rotted Wood" ;
    dc:description "A Perdo Herbam spell (Level 5) that causes a non-living wooden object up to the size of a door to rot and fall apart into dust." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:CurseOfTheUnrulyTongue a rpg:Spell ;
    rpg:name "Curse of the Unruly Tongue" ;
    dc:description "A Rego Corpus spell (Level 5) that causes the target to stutter and slur words, penalizing communication and spoken spellcasting." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Cursed a rpg:Tag ;
    skos:prefLabel "Cursed" ;
    dc:description "A Minor laboratory Supernatural Flaw: the lab suffers a supernatural curse with appropriate Characteristic penalties." ;
    rpg:hasTag amol:Flaw .
amol:CursedGuile a rpg:Tag ;
    skos:prefLabel "Cursed Guile" ;
    dc:description "A Minor Supernatural Flaw, the boy-who-cried-wolf curse likely from Infernal influence: three extra botch dice with Guile and rarely being believed even when honest." ;
    rpg:hasTag amol:Flaw .
amol:Cybelle a rpg:Creature ;
    rpg:name "Cybelle" ;
    dc:description "A goddess of the wilderness honored in a True Merinitae Initiation festival held from the 15th to 27th of March, with rites including ritual castration beneath a sacred pine." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:CyclicMagicNegative a rpg:Tag ;
    skos:prefLabel "Cyclic Magic (negative)" ;
    dc:description "A Minor Hermetic Flaw: the magus's magic is attuned to a cycle of nature and is less potent at specific times, giving -3 to Lab Totals and Casting Scores then." ;
    rpg:hasTag amol:Flaw .
amol:Czech a rpg:Character ;
    rpg:name "Czech" ;
    dc:description "One of the three legendary founding brothers of the Slavic peoples; ancestor who led his tribe, the Czechs, to settle in Bohemia, and from whom the Premyslid dynasty descends." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:CTeaux a schema:Place ;
    rpg:name "Cîteaux" ;
    dc:description "The mother house of the Cistercian Order in France where the abbots meet annually in September; founded by Robert of Molesme in 1098." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:DaggerOfIce a rpg:Spell ;
    rpg:name "Dagger of Ice" ;
    dc:description "A Cr(Re)Aq 10 spell that creates and hurls a foot-long icicle inflicting +5 damage if it penetrates Magic Resistance, then shatters." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Dama a rpg:Character ;
    rpg:name "Dama" ;
    dc:description "The Praeco of the Provençal Tribunal, a House Merinita maga born in 993 who fell into Twilight and emerged, and is rumored to lead a Mystery Cult not part of House Merinita." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:DamhadhDuidas a rpg:Character ;
    rpg:name "Damhadh-Duidas" ;
    dc:description "A Gaelic hedge wizard from the same magical tradition as Damhan-Allaidh who joined Pralix's crusade against the warlock; eponym of the Damhadh-Duidsan tradition." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Damietta a schema:Place ;
    rpg:name "Damietta" ;
    dc:description "A city whose fall to the Crusaders the previous year resulted in slaves purchased into Levantine and Theban Tribunal covenants." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Damp a rpg:Tag ;
    skos:prefLabel "Damp" ;
    dc:description "A Free laboratory Outfittings Flaw: the lab is waterlogged or moist, spoiling parchment and ingredients (+1 Upkeep, -1 Health, -1 Aesthetics, +1 Aquam)." ;
    rpg:hasTag amol:Flaw .
amol:DanceThatHeals a rpg:Tag ;
    skos:prefLabel "Dance That Heals" ;
    dc:description "A Major Supernatural Virtue from some Sufi traditions granting the ability to dance objects to wholeness, like Path of Walking Backward magi." ;
    rpg:hasTag amol:Virtue .
amol:DanceOfTheStaves a rpg:Spell ;
    rpg:name "Dance of the Staves" ;
    dc:description "A Rego Herbam spell (Level 5) that causes a long thin non-living wooden object to lash about wildly and strike its holder for +4 damage." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Danket a rpg:Creature ;
    rpg:name "Danket" ;
    dc:description "Gravis's faerie caricature, a grumpy, stick-thin dwarf with a perpetual scowl contrasting Gravis's sunny disposition." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Danu a rpg:Creature ;
    rpg:name "Danu" ;
    dc:description "A faerie elemental spirit of the River Danube, formerly worshiped as a goddess by many peoples before the Romans; her presence remains strong at the river's source." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Danube a schema:Place ;
    rpg:name "Danube" ;
    dc:description "A river embodied in ancient times as a faerie goddess whose nymphs guard treasure grottos and gateways to Arcadia." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:DariaLaGris a rpg:Character ;
    rpg:name "Daria la Gris" ;
    dc:description "Co-leader of the Apple Gild and princeps of Triamore, a follower of House Tremere who favors forming the Lotharingian Tribunal; a stern 67-year-old Master." ;
    skos:altLabel "Daria", "Daria la Gris of Triamore" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:DarkJerbiton a rpg:Faction ;
    rpg:name "Dark Jerbiton" ;
    dc:description "A group associated with the covenant of Oculus Septentrionalis that may be dovetailed with the demonic schemes of Radegast and Gymir." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:DaughtersOfErictho a rpg:Faction ;
    rpg:name "Daughters of Erictho" ;
    dc:description "Non-Hermetic Thessalian wizards who did not join the Order, dwelling in the Cambunian Mountains; suspected of diabolism and demon worship." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Dauphin a schema:Place ;
    rpg:name "Dauphiné" ;
    dc:description "The domain of Lord Guigues, who commissioned a mechanized magpie automaton." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:DavNalleous a rpg:Character ;
    rpg:name "Dav'nalleous" ;
    dc:description "The foe against whom Pralix waged war; her final battle with him was at the site where Cad Gadu was founded." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:DeLapii a rpg:Item ;
    rpg:name "De Lapii" ;
    dc:description "The Branch of Terram in 1220, a Summa on Terram of Level 17 and Quality 14, written by Jeremias filius Guernicus." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:DeMagiaSympathetica a rpg:Item ;
    rpg:name "De Magia Sympathetica" ;
    dc:description "A Tractatus on Magic Theory (Quality 11) by Elaine covering Arcane Connections and sympathetic connections." ;
    skos:altLabel "On Sympathetic Magic" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:DeOrdinisHermetici a rpg:Item ;
    rpg:name "De Ordinis Hermetici" ;
    dc:description "An encyclopedia by Quaertus of Bonisagus comprising five Quality 9 tractatus on the Code of Hermes and Order of Hermes Lore (history and geography)." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:DePotestateEtObligatione a rpg:Item ;
    rpg:name "De Potestate et Obligatione" ;
    dc:description "A Tractatus on Philosophiae (Quality 11) by Elaine discoursing on the responsible and ethical practice of magic, influenced by Saint Augustine's City of God." ;
    skos:altLabel "On Power and Responsibility" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:DeadLanguageGothic a rpg:Proficiency ;
    rpg:name "Dead Language: Gothic" ;
    dc:description "An Academic dead-language Ability used in all the rituals of House Bjornaer and essential to members of Clan Ilfetu, with little use outside ritual contexts." ;
    skos:altLabel "Gothic" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:Deaf a rpg:Tag ;
    skos:prefLabel "Deaf" ;
    dc:description "A Major General Flaw: the character cannot hear at all; magi with it roll two extra botch dice when casting spells with a spoken component." ;
    rpg:hasTag amol:Flaw .
amol:DecayFurAndHide a rpg:Spell ;
    rpg:name "Decay Fur and Hide" ;
    dc:description "A Perdo Animal spell (Level 10) that destroys an object made of animal fur or hide, including wool and leather." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Decaying a rpg:Tag ;
    skos:prefLabel "Decaying" ;
    dc:description "A Free laboratory Outfittings Flaw: the lab's equipment, furnishings, and materials are neglected or gone bad (-1 General Quality, -1 Upkeep, -1 Safety, -1 Aesthetics)." ;
    rpg:hasTag amol:Flaw .
amol:Decimus a rpg:Tag ;
    skos:prefLabel "Decimus" ;
    dc:description "A House Tytalus faction member who supports Harpax, the tenth Primus; Decimi wear revolutionary green as their badge." ;
    skos:altLabel "Decimi" ;
    rpg:hasTag amol:CharacterType .
amol:DedicatedBuilding a rpg:Tag ;
    skos:prefLabel "Dedicated Building" ;
    dc:description "A Free laboratory Structure Virtue: the lab is in its own building shared with no one else, reducing distractions (+1 Upkeep, +1 Aesthetics, +1 Rego)." ;
    rpg:hasTag amol:Virtue .
amol:DefectiveHeating a rpg:Tag ;
    skos:prefLabel "Defective Heating" ;
    dc:description "A Minor laboratory Outfittings Flaw: the lab has inadequate or missing heating and is too cold in winter (-1 General Quality, -1 Upkeep, -1 Health, -1 Aesthetics)." ;
    rpg:hasTag amol:Flaw .
amol:DefectiveLighting a rpg:Tag ;
    skos:prefLabel "Defective Lighting" ;
    dc:description "A Minor laboratory Outfittings Flaw: the lab is poorly lit, dingy and gloomy (-1 General Quality, -1 Upkeep, -1 Safety, -1 Aesthetics)." ;
    rpg:hasTag amol:Flaw .
amol:Defenses a rpg:Tag ;
    skos:prefLabel "Defenses" ;
    dc:description "A Free laboratory Structure Virtue: the lab has a sturdy defense such as a portcullis or battlements (+1 Aesthetics)." ;
    rpg:hasTag amol:Virtue .
amol:DeficientArts a rpg:Tag ;
    skos:prefLabel "Deficient Arts" ;
    dc:description "A Hermetic Flaw afflicting Sebastian, who learned Hermetic magic despite several Deficient Arts, leading him to fight using his one strong Form, Aquam." ;
    skos:altLabel "Deficient Art" ;
    rpg:hasTag amol:Flaw .
amol:Deformed a rpg:Tag ;
    skos:prefLabel "Deformed" ;
    dc:description "A Free laboratory Structure Flaw: part of the structure has subsided or warped, e.g. a partially collapsed wall (-1 Safety, -1 Aesthetics)." ;
    rpg:hasTag amol:Flaw .
amol:DeftArt a rpg:Tag ;
    skos:prefLabel "Deft Art" ;
    dc:description "A Virtue, here Deft Art (Herbam), possessed by Ioannes Acer." ;
    skos:altLabel "Deft Art (Herbam)" ;
    rpg:hasTag amol:Virtue .
amol:Degenerative a rpg:Tag ;
    skos:prefLabel "Degenerative" ;
    dc:description "A Minor laboratory Supernatural Flaw: the equipment and ingredients decay unnaturally quickly (+2 Upkeep, -1 Safety, +1 Warping, -2 Health, -1 Aesthetics, +2 Perdo)." ;
    rpg:hasTag amol:Flaw .
amol:Deheubarth a schema:Place ;
    rpg:name "Deheubarth" ;
    dc:description "An ancient Welsh principality in the south, centered on the fort of Dinefwr; once nearly unified under Lord Rhys." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:DelugeOfRushingAndDashing a rpg:Spell ;
    rpg:name "Deluge of Rushing and Dashing" ;
    dc:description "A Creo Aquam spell that causes a stream to flood into a raging torrent, sweeping along and damaging anyone caught nearby." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Demeter a rpg:Creature ;
    rpg:name "Demeter" ;
    dc:description "A powerful nature-oriented Greek deity whose name eumolpids of the Huntress may learn through the Mysteries of Names of Power and Invocation Magic." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:DemonOfScrofula a rpg:Creature ;
    rpg:name "Demon of Scrofula" ;
    dc:description "A demon with Infernal Might that uses the Diseased Possession power to inflict the disease scrofula on a possessed victim." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:DemonSVisage a rpg:Tag ;
    skos:prefLabel "Demon's Visage" ;
    dc:description "A Major Curse (Muto Corpus Animal effect) transforming the victim's head into a demon-like beast shape, penalizing communication, social rolls, and spell casting by -6." ;
    rpg:hasTag amol:Flaw .
amol:DemonicBlood a rpg:Tag ;
    skos:prefLabel "Demonic Blood" ;
    dc:description "A Major Supernatural Tainted Virtue making a character a half-demon with Infernal Might, Infernal Powers, no need to eat, immunity to Warping, and a drastically shortened lifespan." ;
    rpg:hasTag amol:Virtue .
amol:DemonicFamiliar a rpg:Tag ;
    skos:prefLabel "Demonic Familiar" ;
    dc:description "A Minor Story Flaw binding the character to a famulus, a familiar demon possessing an animal, which is not loyal and pursues its own goals." ;
    rpg:hasTag amol:Flaw .
amol:DemonicMight a rpg:Tag ;
    skos:prefLabel "Demonic Might" ;
    dc:description "A Minor Supernatural Virtue (requires Demonic Blood) increasing a character's Infernal Might by 2 points." ;
    rpg:hasTag amol:Virtue .
amol:DemonicPowers a rpg:Tag ;
    skos:prefLabel "Demonic Powers" ;
    dc:description "A Minor Supernatural Virtue (requires Demonic Blood) granting an extra 20 levels of Infernal Powers." ;
    rpg:hasTag amol:Virtue .
amol:Depraved a rpg:Tag ;
    skos:prefLabel "Depraved" ;
    dc:description "A Major or Minor Personality Flaw where the character seeks to undermine religion and avoid the Dominion whenever possible." ;
    rpg:hasTag amol:Flaw .
amol:Depressed a rpg:Tag ;
    skos:prefLabel "Depressed" ;
    dc:description "A Minor Personality Flaw giving the character a dark outlook on life, seeing little point in acting and taking no pleasure in events." ;
    rpg:hasTag amol:Flaw .
amol:DesideriusOfVerditius a rpg:Character ;
    rpg:name "Desiderius of Verditius" ;
    dc:description "An old Verditius magus of Voluntas who is a necromancer, smelling of rotting flesh, lately becoming sociable despite poor social skills." ;
    skos:altLabel "Desiderius" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:DespairOfTheQuiveringManacles a rpg:Spell ;
    rpg:name "Despair of the Quivering Manacles" ;
    dc:description "A Rego Corpus spell (Level 15) that makes the target shake vigorously side to side, penalizing physical movement and other rolls." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:DeterioratingPower a rpg:Tag ;
    skos:prefLabel "Deteriorating Power" ;
    dc:description "A Minor Supernatural Flaw that reduces the effectiveness of one of the character's powers over time, linked to age, Might, or Warping Score." ;
    skos:altLabel "Deteriorating Powers" ;
    rpg:hasTag amol:Flaw .
amol:DetermineTheLocationOfTheAbsentVolume a rpg:Spell ;
    rpg:name "Determine the Location of the Absent Volume" ;
    dc:description "An Intellego Animal 25 spell (based on The Inexorable Search) that locates a missing book by showing the magus's sigil on a map, with an optional Creo requisite to project the location on a mirror." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Deventer a schema:Place ;
    rpg:name "Deventer" ;
    dc:description "A modest-sized city and early missionary-bishopric on the right bank of the Rhine, surrounded by marshland, with a church named after St. Lebuinus and at the center of a struggle against pirates." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:DevotedParentChild a rpg:Tag ;
    skos:prefLabel "Devoted Parent/Child" ;
    dc:description "A Minor General Flaw in which the character is extremely attached to a parent or child, suffering anxiety and penalties when separated." ;
    rpg:hasTag amol:Flaw .
amol:Dhimmi a rpg:Tag ;
    skos:prefLabel "Dhimmi" ;
    dc:description "A Minor General Flaw marking a non-Muslim living under Muslim rule, who must pay the jizya head tax and abide by social restrictions in return for tolerance and protection." ;
    rpg:hasTag amol:Flaw .
amol:Diabetes a rpg:Creature ;
    rpg:name "Diabetes" ;
    dc:description "A Minor Sanguine, Lifelong Disease from rich food and gluttony, named by Aretaeus after the Greek word for a siphon." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:DiamondMinesOfSolomon a schema:Place ;
    rpg:name "Diamond Mines of Solomon" ;
    dc:description "A legendary treasure-site the Expedition covenant was founded to discover, following a map used by two prior expeditions that never returned." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:DianaOfTremere a rpg:Character ;
    rpg:name "Diana of Tremere" ;
    dc:description "A Tremere maga of Blackthorn who declared a Wizards' War in 873 against William of Jerbiton of Rosalba." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Dictionarius a rpg:Item ;
    rpg:name "Dictionarius" ;
    dc:description "A famous 13th-century craft manual by John de Garlande about various trades that adds +4 to a craftsman's Workshop Total." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:Didyma a rpg:Faction ;
    rpg:name "Didyma" ;
    dc:description "A covenant in the Theban Tribunal linked to the city of Miletos by the Sacred Way, a mundane road that is also a major route from the faerie realm to the mundane world." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:DietrichIII a rpg:Character ;
    rpg:name "Dietrich III" ;
    dc:description "The duke of Upper Lorraine who dies in 1220 and is succeeded by Matthew II." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:DifficultLongevityRitual a rpg:Tag ;
    skos:prefLabel "Difficult Longevity Ritual" ;
    dc:description "A Major Hermetic Flaw making it difficult to create an effective Longevity Ritual for the character, halving the Lab Total of anyone who tries." ;
    rpg:hasTag amol:Flaw .
amol:Dimicatio a rpg:Tag ;
    skos:prefLabel "Dimicatio" ;
    dc:description "A dangerous Flambeau tournament event where competitors cast real spells using forceless casting and fast-cast defenses, the first to reach the opponent's Parma winning." ;
    rpg:hasTag amol:HermeticConcept .
amol:Diminutive a rpg:Tag ;
    skos:prefLabel "Diminutive" ;
    dc:description "A Minor laboratory Structure Flaw: the lab is configured for an especially small magus, causing difficulty for normal-sized users." ;
    rpg:hasTag amol:Flaw .
amol:Dionysus a rpg:Character ;
    rpg:name "Dionysus" ;
    dc:description "A god originally worshipped alongside Hermes by Orpheus's society but who fell out of favor after Orpheus's death; the Maenads who killed Orpheus were devoted to him." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:DirneWeibl a rpg:Creature ;
    rpg:name "Dirne-Weibl" ;
    dc:description "A wood-wife who dresses in a red frock and carries a basket of apples that turn to gold if she is treated courteously; her apples are Creo vis sought by magi." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Dirty a rpg:Tag ;
    skos:prefLabel "Dirty" ;
    dc:description "A Free laboratory Outfittings Flaw: the lab is not kept to basic cleanliness, leaving the owner smelly (-1 Health, -2 Aesthetics, +1 Perdo)." ;
    rpg:hasTag amol:Flaw .
amol:DiseasedPossession a rpg:Tag ;
    skos:prefLabel "Diseased Possession" ;
    dc:description "An infernal power, a variety of Possession, by which a demon enters a victim and spends Might to inflict a disease's contagion." ;
    rpg:hasTag amol:HermeticConcept .
amol:DisguiseOfTheTransformedWizard a rpg:Spell ;
    rpg:name "Disguise of the Transformed Wizard" ;
    dc:description "A Muto Imaginem 15 spell known by Imanitos Mendax." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Disguised a rpg:Tag ;
    skos:prefLabel "Disguised" ;
    dc:description "A Free laboratory Structure Flaw: the lab or its entrance is concealed mundanely, such as by a hidden door (-1 Aesthetics)." ;
    rpg:hasTag amol:Flaw .
amol:DisjointedMagic a rpg:Tag ;
    skos:prefLabel "Disjointed Magic" ;
    dc:description "A Minor Hermetic Flaw preventing the magus from using prior knowledge of similar spells or enchantment bonuses to aid his magic." ;
    rpg:hasTag amol:Flaw .
amol:Disorganized a rpg:Tag ;
    skos:prefLabel "Disorganized" ;
    dc:description "A Free laboratory Outfittings Flaw: the lab is organized haphazardly, though some magi prefer it (-1 Safety, -1 Aesthetics, +1 Muto or Experimentation)." ;
    rpg:hasTag amol:Flaw .
amol:DisorientatingMagic a rpg:Tag ;
    skos:prefLabel "Disorientating Magic" ;
    dc:description "A Minor Hermetic Flaw requiring the magus to spend a round recovering his mental faculties after casting a spell." ;
    rpg:hasTag amol:Flaw .
amol:Dispassionate a rpg:Tag ;
    skos:prefLabel "Dispassionate" ;
    dc:description "A new Minor Personality Flaw making one unable to express strong emotions; the first Sacrifice on the Arcadian Path." ;
    rpg:hasTag amol:Flaw .
amol:DispelThePhantomImage a rpg:Spell ;
    rpg:name "Dispel the Phantom Image" ;
    dc:description "A Perdo Imaginem (General) spell that destroys the image from any one Creo Imaginem spell whose level the caster matches or exceeds on a stress die plus spell level." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:DissolvingTheWallOfShields a rpg:Spell ;
    rpg:name "Dissolving the Wall of Shields" ;
    dc:description "A PeMe 20 spell that removes the procedural memories letting a group of soldiers fight as a unit, or destroys other simple group skills." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:DistillationOfThePurestStream a rpg:Spell ;
    rpg:name "Distillation of the Purest Stream" ;
    dc:description "A Rego Vim 15 spell (R: Touch, D: Mom, T: Ind) that concentrates the essence of exceptionally pure stream water into a pawn of Aquam vis." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:DistractionOfTheMagpie a rpg:Spell ;
    rpg:name "Distraction of the Magpie" ;
    dc:description "A Muto Mentem spell that alters the target's estimation so shiny objects become highly desirable and distracting." ;
    skos:altLabel "MuMe 10" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:DivinationAugury a rpg:Tag ;
    skos:prefLabel "Divination & Augury" ;
    dc:description "A supernatural Virtue allowing the performance of auguries; Chnoubis' Augury power functions as this Virtue, granting ten levels of success per Might point." ;
    skos:altLabel "Augury" ;
    rpg:hasTag amol:Virtue .
amol:DivinationAndAugury a rpg:Proficiency ;
    rpg:name "Divination and Augury" ;
    dc:description "The Major non-Hermetic Virtue of the Hermetic Haruspexes tradition." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:Doctor a rpg:Tag ;
    skos:prefLabel "Doctor" ;
    dc:description "The title held only by graduates of a university faculty of medicine (or those with Clerk and Medicine 3+), the only physicians with formal claim to it." ;
    rpg:hasTag amol:HermeticConcept .
amol:Doge a rpg:Tag ;
    skos:prefLabel "Doge" ;
    dc:description "The leader of the city of Venice, who annually casts a vis-bearing engagement ring into the sea to symbolize the city's espousal to and dominance over the waters." ;
    rpg:hasTag amol:CharacterType .
amol:DogroseSchool a rpg:Faction ;
    rpg:name "Dogrose School" ;
    dc:description "A regio covenant claimed by House Bonisagus that draws Gifted children via their possessed toys and teaches them before sending them to masters." ;
    skos:altLabel "The School" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:DomesticAnimal a rpg:Tag ;
    skos:prefLabel "Domestic Animal" ;
    dc:description "A Free Social Status Virtue (animals only) for an animal that is the property of a covenant or character." ;
    rpg:hasTag amol:Virtue .
amol:Dominican a rpg:Faction ;
    rpg:name "Dominican" ;
    dc:description "One of the two major new mendicant friar orders of the early thirteenth century, growing rapidly in popularity." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Dominicus a rpg:Character ;
    rpg:name "Dominicus" ;
    dc:description "A magus of House Jerbiton exonerated by the Normandy Tribunal of 898 for using Wizard's War to avenge a slain amicus, establishing legal precedent for avenger pledges." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:DonningTheMaskOfAnother a rpg:Spell ;
    rpg:name "Donning the Mask of Another" ;
    dc:description "A Tytalan MuMe 35 Ritual spell that creates a persona from the identity of a donor, granting the caster the donor's memories and personality as a deep cover disguise; it can also steal or transfer a persona." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Doolin a rpg:Character ;
    rpg:name "Doolin" ;
    dc:description "A guild master clothier living in Paris, a man of inexhaustible energy who makes excellent quality clothing and dreams of monopolizing the formal attire of wizards." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Doubt a rpg:Tag ;
    skos:prefLabel "Doubt" ;
    dc:description "A Major Curse (Rego Mentem effect) filling the victim with doubt, requiring Intelligence rolls before undertaking any activity." ;
    rpg:hasTag amol:Flaw .
amol:DoverCastle a schema:Place ;
    rpg:name "Dover Castle" ;
    dc:description "Castle whose octagonal three-story archery Bell Tower (built 1189) exemplifies the archery-tower extreme of mural-tower design." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:DownTor a schema:Place ;
    rpg:name "Down Tor" ;
    dc:description "A group of stones on Dartmoor with a circle around a barrow and a long line of stones said to bind and channel a powerful ghost that can be summoned along the line by those who know the rituals." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:DragonHill a schema:Place ;
    rpg:name "Dragon Hill" ;
    dc:description "A small hill near the White Horse of Uffington with a flat top on which nothing will grow." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:DragonOfTheSauerland a rpg:Creature ;
    rpg:name "Dragon of the Sauerland" ;
    dc:description "A dragon that must be conquered and its heart eaten as the second Quest of the Path of Energy." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:DrawingUpTheSiegeLadder a rpg:Spell ;
    rpg:name "Drawing Up the Siege Ladder" ;
    dc:description "A Rego Herbam 15 spell originally for hauling siege ladders over castle walls, used by librarians to rearrange wooden furniture and move groups of wooden objects." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:DreadfulBaneOfTheFae a rpg:Spell ;
    rpg:name "Dreadful Bane of the Fae" ;
    dc:description "A general Perdo Vim spell invented by Philippus Niger, like Demon's Eternal Oblivion but working on creatures with Faerie Might." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:DreamMagic a rpg:Tag ;
    skos:prefLabel "Dream Magic" ;
    dc:description "A Virtue gained through Clan Maruhs's Deed of Emulation and spread within the clan by the Sept of Gyöngy." ;
    rpg:hasTag amol:Virtue .
amol:DreamOfTheMindThatSits a rpg:Spell ;
    rpg:name "Dream of the Mind That Sits" ;
    dc:description "An Intellego Terram spell (with Creo requisite) that lets the caster probe and perfect the memories of a spirit within a natural stone object." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:DrogoInvigilor a rpg:Character ;
    rpg:name "Drogo Invigilor" ;
    dc:description "A Tremere magus of Fengheld closely associated with the Welfs, investigated by House Guernicus over suspicions he arranged accidents for the emperor's heirs." ;
    skos:altLabel "Drogo Invigilor of Tremere" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:DruidsCircle a schema:Place ;
    rpg:name "Druids' Circle" ;
    dc:description "A stone circle on a moor overlooking the Irish Sea whose entrance stones are sensitive to oaths and move nearer to swearers; dark tales say druids practiced human sacrifice there." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Dunoding a schema:Place ;
    rpg:name "Dunoding" ;
    dc:description "A region of Wales near an island where the swynwyr established Pralix's military headquarters, later renamed Cad Gadu." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Durendal a rpg:Item ;
    rpg:name "Durendal" ;
    dc:description "Roland's magic sword, forged by Wayland Smith with Verditius as apprentice, later stolen by Roscius and studied by the Confraternity of Roland; used in their Initiations." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:DustDevil a rpg:Tag ;
    skos:prefLabel "Dust Devil" ;
    dc:description "A Minor Supernatural Skinchanger variant letting a character become a Size +1 dust devil whirlwind, focused through a glass amulet of Magic-aura sand." ;
    skos:altLabel "tamzawit" ;
    rpg:hasTag amol:Virtue .
amol:DutifulMovement a rpg:Tag ;
    skos:prefLabel "Dutiful Movement" ;
    dc:description "A common automaton power (base effect 20) letting the automaton walk and follow its creator around." ;
    rpg:hasTag amol:HermeticConcept .
amol:Dyscrasia a rpg:Tag ;
    skos:prefLabel "Dyscrasia" ;
    dc:description "The imbalanced state of humors producing a patient's symptoms, which a physician must understand to bring the humors back into balance." ;
    rpg:hasTag amol:HermeticConcept .
amol:EagleClan a rpg:Faction ;
    rpg:name "Eagle Clan" ;
    dc:description "A Crintera clan of the nimblest, keen-eyed grogs who are expert archers, acting as spies, hunters, and an informant network across Europe." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Ealwynn a rpg:Character ;
    rpg:name "Ealwynn" ;
    dc:description "A member of the Sept of Orn (Clan Wilkis) trained by Hosvir Goatlegs." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:EasternChristendom a schema:Place ;
    rpg:name "Eastern Christendom" ;
    dc:description "A cultural society of Mythic Europe centered on the Byzantine empire and Constantinople, defining its own Social Statuses." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:EasternRomanEmpire a schema:Place ;
    rpg:name "Eastern Roman Empire" ;
    dc:description "The cosmopolitan eastern realm ('Romania') whose Greek-cultured cities produced House Jerbiton's founding members and the League of Iconophiles." ;
    skos:altLabel "Eastern Empire", "Imperial East", "Romania", "the Empire" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Eden a schema:Place ;
    rpg:name "Eden" ;
    dc:description "The biblical paradise from which man was expelled; noxious plants are said to have acquired harmful qualities after the expulsion." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Edgar a rpg:Character ;
    rpg:name "Edgar" ;
    dc:description "The newest Redcap of the Stonehenge Tribunal, in his early twenties, good-looking with light brown hair and gray eyes, with no magical items yet." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:EdificeBoon a rpg:Tag ;
    skos:prefLabel "Edifice Boon" ;
    dc:description "A covenant Boon that troupes may select instead of paying Build Points for a Great Work." ;
    rpg:hasTag amol:HermeticConcept .
amol:EducatedBardic a rpg:Tag ;
    skos:prefLabel "Educated (Bardic)" ;
    dc:description "A Minor General Virtue for attending a Hibernian bardic school, granting 50 experience points in storytelling and lore Abilities." ;
    rpg:hasTag amol:Virtue .
amol:EducatedIslamic a rpg:Tag ;
    skos:prefLabel "Educated (Islamic)" ;
    dc:description "A Minor General Virtue for education in a mosque or Qur'an school, granting Academic Abilities and 50 experience points in languages and Islamic studies." ;
    rpg:hasTag amol:Virtue .
amol:EducatedVernacular a rpg:Tag ;
    skos:prefLabel "Educated (Vernacular)" ;
    dc:description "A Minor, General Virtue representing secular instruction given by tutors to scions of merchant houses, granting Academic Abilities and 50 extra experience points for practical business skills." ;
    rpg:hasTag amol:Virtue .
amol:Efnisien a rpg:Character ;
    rpg:name "Efnisien" ;
    dc:description "A Welsh hero claimed by some as the first of the Nemthengacha, the bitter-tongued Ex Miscellanea tradition." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Eginolf a rpg:Character ;
    rpg:name "Eginolf" ;
    dc:description "A magus of House Flambeau of Rudiaria covenant against whom charges of diabolism were brought (unproven) in 962 AD." ;
    skos:altLabel "Eginolf of House Flambeau" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Egypt a schema:Place ;
    rpg:name "Egypt" ;
    dc:description "A region of Mythic Europe near the Pyramids and the great Sphinx where magi established a desert laboratory." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Einherjar a rpg:Creature ;
    rpg:name "Einherjar" ;
    dc:description "Spiritual warriors awaiting Ragnarok, into whom Valkyries transform the worthy dead chosen from battle." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Elbe a schema:Place ;
    rpg:name "Elbe" ;
    dc:description "A river haunted by a Wild Hunt led by Frau Wode and by shadowy boatmen carrying invisible passengers." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:ElbruzMountains a schema:Place ;
    rpg:name "Elbruz Mountains" ;
    dc:description "The mountains where Baghl the earth jinni haunts a dark cave formerly used as a quarry." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:EleanorSworder a rpg:Character ;
    rpg:name "Eleanor Sworder" ;
    dc:description "The woman who has led Nigrasaxa's turb for five years and aspires to be a knight; bears an ugly scar on her left cheek." ;
    skos:altLabel "Eleanor" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:EleanorOfAquitaine a rpg:Character ;
    rpg:name "Eleanor of Aquitaine" ;
    dc:description "Overlord of Aquitaine who attended the Second Crusade with a guard of female knights dressed as Amazons; her scandalous behavior led to a Papal Bull barring women from the Third Crusade. An example of inheritance-based female power." ;
    skos:altLabel "Eleanor" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:ElementalKings a rpg:Creature ;
    rpg:name "Elemental kings" ;
    dc:description "Powerful spirits of the Magic realm whose favor Archmage Vinaria of Merinita must win for her archmage challenge." ;
    skos:altLabel "four elemental kings" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:ElementalSpirit a rpg:Creature ;
    rpg:name "Elemental spirit" ;
    dc:description "A spirit that broke free of an ancient binding and caused rockslides in the Black Mountains in revenge on humanity; Goliard restored its binding and took control of it." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Elementalist a rpg:Tag ;
    skos:prefLabel "Elementalist" ;
    dc:description "A Virtue common among Hermetic Sahirs reflecting their facility with the elemental Forms." ;
    skos:altLabel "Elementalists" ;
    rpg:hasTag amol:Virtue .
amol:Elementary a rpg:Tag ;
    skos:prefLabel "Elementary" ;
    dc:description "A Major laboratory Outfittings Flaw: a cut-down lab with extremely limited equipment allowing only one category of lab activity, cheap to maintain (-2 General Quality, -3 Upkeep)." ;
    rpg:hasTag amol:Flaw .
amol:Elevated a rpg:Tag ;
    skos:prefLabel "Elevated" ;
    dc:description "A Free laboratory Structure Virtue: the lab is at least four floors up or atop a tower, commanding a view (+1 Aesthetics, +1 Auram)." ;
    rpg:hasTag amol:Virtue .
amol:Elsa a rpg:Character ;
    rpg:name "Elsa" ;
    dc:description "The young widowed duchess of Brabant rescued by the Knight of the Swan Lohengrin, whom she wedded and lost when she broke her vow not to ask his name." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Ely a schema:Place ;
    rpg:name "Ely" ;
    dc:description "An abbey and bishopric, site of the tomb of St. Etheldreda and a pilgrimage destination; setting of Bricstan's miraculous deliverance." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:EmotionTheft a rpg:Proficiency ;
    rpg:name "Emotion Theft" ;
    dc:description "A Supernatural Ability granted by the Thief of Emotions Virtue, allowing one to steal an emotion from a person and transfer it to another by touch." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:Emrys a rpg:Character ;
    rpg:name "Emrys" ;
    dc:description "A Welsh seer who made a pact with faeries to trade his life for his son Ambrosius's, serving as magical advisor to a faerie court; his spirit could be seen watching over the boy." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:EnchantedBirthingChair a rpg:Item ;
    rpg:name "Enchanted birthing chair" ;
    dc:description "An enchanted chair at Voluntas's village that ensures almost all mothers and children survive childbirth, giving Wilton unusually high life expectancy." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:Enchantment a rpg:Tag ;
    skos:prefLabel "Enchantment" ;
    dc:description "A Free laboratory Supernatural Virtue: the lab itself has been enchanted as a magic item, granting Virtues, Flaws, or Specialization changes." ;
    rpg:hasTag amol:Virtue .
amol:EnchantmentOfDetachment a rpg:Spell ;
    rpg:name "Enchantment of Detachment" ;
    dc:description "A spell that calms and greatly lowers the intensity of the target's current emotions." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:EnchantmentOfThePedestrianPigeon a rpg:Spell ;
    rpg:name "Enchantment of the Pedestrian Pigeon" ;
    dc:description "A MuMe 15 spell that occludes a person's memory of told information until a key phrase unlocks it, used for secure transfer of information between conspirators." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Encumbrance a rpg:Tag ;
    skos:prefLabel "Encumbrance" ;
    dc:description "A penalty derived from the Load of carried equipment, calculated through Burden and offset by Strength, that subtracts from athletic and spellcasting rolls." ;
    skos:altLabel "Burden", "Load" ;
    rpg:hasTag amol:HermeticConcept .
amol:EnduringMagic a rpg:Tag ;
    skos:prefLabel "Enduring Magic" ;
    dc:description "A Minor, Hermetic Virtue causing the magus's spells to last longer than usual, with the storyguide secretly multiplying durations by a die roll." ;
    rpg:hasTag amol:Virtue .
amol:EngelbertI a rpg:Character ;
    rpg:name "Engelbert I" ;
    dc:description "The current archbishop of Cologne, a tall, fair, and just man holding the status of Archchancellor of Italy, martyred in 1225 if the saga follows real history." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:EnslaveTheMortalMind a rpg:Spell ;
    rpg:name "Enslave the Mortal Mind" ;
    dc:description "A spell that lets the caster completely control the loyalty, emotions, desires, and activities of any person." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:EnticerOfMultitudes a rpg:Tag ;
    skos:prefLabel "Enticer of Multitudes" ;
    dc:description "A Minor, General, Tainted Virtue giving a corrupt version of Inspirational usable only to manipulate people toward evil acts." ;
    rpg:hasTag amol:Virtue .
amol:Entisimon a rpg:Character ;
    rpg:name "Entisimon" ;
    dc:description "A Primus of House Flambeau who rallied the House during the Schism War but was disgraced and forced to resign during the Normandy Crisis." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Enumerus a rpg:Character ;
    rpg:name "Enumerus" ;
    dc:description "A renowned Jerbiton magus who wrote a treatise on covenant economics held in the Great Library of Durenmar; he gave his name to the Pound of Enumerus, the unaccountable yearly petty expenditure." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:EnvironmentalMagicCondition a rpg:Tag ;
    skos:prefLabel "Environmental Magic Condition" ;
    dc:description "A Major Hermetic Flaw halving all of the character's Casting and Lab Totals in certain common environmental conditions." ;
    rpg:hasTag amol:Flaw .
amol:EnvironmentalSensitivity a rpg:Tag ;
    skos:prefLabel "Environmental Sensitivity" ;
    dc:description "A Minor General Flaw in which the character is unusually sensitive to an uncommon environmental feature, suffering a Stamina penalty when exposed." ;
    rpg:hasTag amol:Flaw .
amol:Ephesus a schema:Place ;
    rpg:name "Ephesus" ;
    dc:description "A site in the Theban Tribunal holding a statue of Diana that Huntress initiates may anoint with sacred oil during the Eumolpid initiation." ;
    skos:altLabel "Epheseus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Epimetheus a rpg:Character ;
    rpg:name "Epimetheus" ;
    dc:description "Hariste's devoted pupil who contracted leprosy while consoling her after Tytalus's disappearance, thereby founding the leper magi lineage." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Erfurt a schema:Place ;
    rpg:name "Erfurt" ;
    dc:description "The oldest and largest settlement in Thuringia, an episcopal city under the archbishopric of Mainz, deriving wealth from the export of woad." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:ErikVonRibe a rpg:Character ;
    rpg:name "Erik von Ribe" ;
    dc:description "A magus of House Tytalus, filius of Tasgillia, quoted remarking that a magus lacking a disgraced ancestor shows a distinct lack of enterprise." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:EristicMoot a rpg:Tag ;
    skos:prefLabel "Eristic Moot" ;
    dc:description "A public dispute between competing speakers used by House Tytalus to settle differences, announced by Redcap; includes special forms such as the Apprentice's Gauntlet and the contest for Primus." ;
    skos:altLabel "eristic moots", "moot" ;
    rpg:hasTag amol:HermeticConcept .
amol:Erysipelas a rpg:Creature ;
    rpg:name "Erysipelas" ;
    dc:description "A Minor Choleric Disease of morbid choler from excessive heat and dryness, causing a maddening rash on the extremities." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Erythravis a rpg:Character ;
    rpg:name "Erythravis" ;
    dc:description "An Archmage of House Guernicus who executed Tasgillia for diabolism in 961 AD." ;
    skos:altLabel "Archmage Erythravis" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Eschenfrau a rpg:Creature ;
    rpg:name "Eschenfrau" ;
    dc:description "A very evil wood-spirit who must be appeased with a sacrifice on Ash Wednesday by those unfortunate enough to live near one." ;
    skos:altLabel "Wife of the Ash" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:EsperaOfMerinita a rpg:Character ;
    rpg:name "Espera of Merinita" ;
    dc:description "A Merinita maga of Ungulus who offended a faerie lord and devotes herself to survival, never leaving the Aegis and wearing enchanted iron items against faeries." ;
    skos:altLabel "Espera" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:EssentialNature a rpg:Tag ;
    skos:prefLabel "Essential Nature" ;
    dc:description "A character's intrinsic, magically defining nature, which can make certain Flaws impossible to remove even with Hermetic magic." ;
    rpg:hasTag amol:HermeticConcept .
amol:EssentialTraits a rpg:Tag ;
    skos:prefLabel "Essential Traits" ;
    dc:description "Traits possessed by some creatures of the Magic Realm that are part of their essential nature, marked with an asterisk; magic cannot make such creatures act against them." ;
    rpg:hasTag amol:HermeticConcept .
amol:EstridDanesson a rpg:Character ;
    rpg:name "Estrid Danesson" ;
    dc:description "A magus Ex Miscellanea (age 36) of Oculus Septentrionalis, a Danish former hedge wizard specializing in sailing and weather magics who gathers vis around the Baltic; cousin and enemy of Eric Ribecus." ;
    skos:altLabel "Estrid" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:EternalRepetitionInABottomlessPool a rpg:Spell ;
    rpg:name "Eternal Repetition in a Bottomless Pool" ;
    dc:description "A Creo Imaginem 35 spell that uses enchanted mirrors to display the text of a book the magus has an arcane connection to, navigable by vocal command." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Ethelwald a rpg:Character ;
    rpg:name "Ethelwald" ;
    dc:description "The seneschal and autocrat of Voluntas who plays lord of the manor to the outside world and avoids becoming a knight to escape military service." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Ethiopia a schema:Place ;
    rpg:name "Ethiopia" ;
    dc:description "The location of a cave complex that is the perfect site for the Microcosm ritual on the Path of the Body, discovered in North Africa." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Etzel a rpg:Character ;
    rpg:name "Etzel" ;
    dc:description "The king of the Huns in the Nibelungenlied, who marries Kriemhild; historically Attila, the dreaded chieftain checked at the Battle of Chalons." ;
    skos:altLabel "Attila", "Attila the Hun" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Eucrasia a rpg:Tag ;
    skos:prefLabel "Eucrasia" ;
    dc:description "The state of perfect balance of the humors that prolongs life and negates bodily suffering, the goal of a medical regimen, represented as a Living Conditions Modifier." ;
    rpg:hasTag amol:HermeticConcept .
amol:Eudokia a schema:Place ;
    rpg:name "Eudokia" ;
    dc:description "One of the three regions of the Faerie Realm; the land of tales that teach a lesson." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:EuleSWisdomItem a rpg:Item ;
    rpg:name "Eule's Wisdom Item" ;
    dc:description "A low-level but very high-Penetration Perdo Mentem magic item hidden in the floor of Eule's receiving room that calms minds and removes emotion, used by Gunther to fake her wisdom." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:Eurydice a rpg:Character ;
    rpg:name "Eurydice" ;
    dc:description "Orpheus's beloved wife who died of a viper's bite and whom he tried to recover from the Underworld." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Eurynome a rpg:Character ;
    rpg:name "Eurynome" ;
    dc:description "A sea nymph who, with Thetis, rescued and raised Hephaestus after Zeus cast him into the sea." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:EustaceDeFaukenberg a rpg:Character ;
    rpg:name "Eustace de Faukenberg" ;
    dc:description "The treasurer of England, who heads the Exchequer." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:EustaceTheMonk a rpg:Character ;
    rpg:name "Eustace the Monk" ;
    dc:description "The leader of the French reinforcement fleet of eighty ships; defeated by Hubert de Burgh's fleet and beheaded against the rail of his own ship." ;
    skos:altLabel "Eustace" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:EustaceAbbotOfFlay a rpg:Character ;
    rpg:name "Eustace, Abbot of Flay" ;
    dc:description "An abbot sent by the Pope in 1200 to lead a mission against Sunday trading in England, whose preaching and miracles caused many Sunday markets to close or move." ;
    skos:altLabel "Eustace" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Eve a rpg:Character ;
    rpg:name "Eve" ;
    dc:description "The first woman of biblical lore referenced in the Divine setting material." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:EverstorfForest a schema:Place ;
    rpg:name "Everstorf Forest" ;
    dc:description "A forest north of Schwerin in which the Giant's Grave lies." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:EvilDestiny a rpg:Tag ;
    skos:prefLabel "Evil Destiny" ;
    dc:description "A Major Story Flaw in which the Infernal realm has taken an unexplained interest in the character, who must guard against dark forces." ;
    rpg:hasTag amol:Flaw .
amol:EvilEye a rpg:Tag ;
    skos:prefLabel "Evil Eye" ;
    dc:description "A Minor Supernatural Flaw in which the character bears the uncontrolled potential to harm those around her, adding a botch die to stress rolls made in her presence." ;
    rpg:hasTag amol:Flaw .
amol:EviscerationOfTenThousandKnives a rpg:Spell ;
    rpg:name "Evisceration of Ten Thousand Knives" ;
    dc:description "A Perdo Corpus 35 enchanted-item effect in Philippus Niger's talisman, a Group-targeted version of his Evisceration of a Thousand Knives." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:EviscerationOfAThousandKnives a rpg:Spell ;
    rpg:name "Evisceration of a Thousand Knives" ;
    dc:description "A Perdo Corpus 30 spell invented by Philippus Niger that inflicts an Incapacitating wound on one target." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ExcessiveHeating a rpg:Tag ;
    skos:prefLabel "Excessive Heating" ;
    dc:description "A Minor laboratory Outfittings Virtue: the lab is kept far warmer than necessary with extensive facilities (+2 Upkeep, -1 Safety, +2 Ignem)." ;
    rpg:hasTag amol:Virtue .
amol:ExcessiveLighting a rpg:Tag ;
    skos:prefLabel "Excessive Lighting" ;
    dc:description "A Minor laboratory Outfittings Virtue: the lab is lit far more than necessary with hundreds of candles or lamps (+2 Upkeep, +2 Imaginem)." ;
    rpg:hasTag amol:Virtue .
amol:ExchangeOfTheTwoMinds a rpg:Spell ;
    rpg:name "Exchange of the Two Minds" ;
    dc:description "A ritual spell that switches the minds (but not the souls) of two creatures." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Exchequer a rpg:Faction ;
    rpg:name "Exchequer" ;
    dc:description "A branch of the royal court headed by the treasurer Eustace de Faukenberg, responsible for checking and receipting all moneys owed to the crown; staffed by Barons of the Exchequer." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:ExcitingExperimentation a rpg:Tag ;
    skos:prefLabel "Exciting Experimentation" ;
    dc:description "A Minor Hermetic Flaw causing the character's experiments to have dramatic flair, rolling two dice on experimentation tables with the storyguide choosing the more amusing result." ;
    rpg:hasTag amol:Flaw .
amol:Excommunicate a rpg:Tag ;
    skos:prefLabel "Excommunicate" ;
    dc:description "A Major Story Flaw in which the character has been cast out of the Church for crimes against God, gaining a bad reputation and losing access to the sacraments." ;
    rpg:hasTag amol:Flaw .
amol:Exeter a schema:Place ;
    rpg:name "Exeter" ;
    dc:description "The seat of a bishop and the most important town of southwest England, a sea-port on the river Exe with a Norman cathedral dedicated to St. Peter and a wine trade with Gascony." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:ExiledAtlantean a rpg:Tag ;
    skos:prefLabel "Exiled Atlantean" ;
    dc:description "A Minor Supernatural Flaw marking the character as an Atlantean tainted by contact with the surface world and unable to return to her native magic regio." ;
    rpg:hasTag amol:Flaw .
amol:Exposed a rpg:Tag ;
    skos:prefLabel "Exposed" ;
    dc:description "A Free laboratory Structure Flaw: the building is partially exposed to the elements, e.g. unroofed or wind-cracked (-1 Safety, +1 Upkeep, -2 Health, -1 Aesthetics, +1 Auram)." ;
    rpg:hasTag amol:Flaw .
amol:ExtensiveStores a rpg:Tag ;
    skos:prefLabel "Extensive Stores" ;
    dc:description "A Minor laboratory Structure Virtue: large stores let the lab withstand shortages and store vis and dangerous materials more safely (+2 Safety)." ;
    rpg:hasTag amol:Virtue .
amol:ExtractorOfFormVis a rpg:Tag ;
    skos:prefLabel "Extractor of (Form) Vis" ;
    dc:description "A Minor, Hermetic Virtue allowing a magus to extract vis of a chosen Form from a Magic aura whose features exemplify that Form." ;
    rpg:hasTag amol:Virtue .
amol:EyeOfTheEons a rpg:Spell ;
    rpg:name "Eye of the Eons" ;
    dc:description "An Intellego Terram spell (InTe 5) known by Tabanus." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:EyesOfTheEons a rpg:Spell ;
    rpg:name "Eyes of the Eons" ;
    dc:description "An Intellego Terram spell that determines the age of any nonliving target to within 10% of its actual age." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:EyesOfTheFlame a rpg:Spell ;
    rpg:name "Eyes of the Flame" ;
    dc:description "An Intellego Ignem spell (Level 35) that lets the caster see a fire to which they have an Arcane Connection, plus all things the fire illuminates." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:FabricRipper a rpg:Tag ;
    skos:prefLabel "Fabric Ripper" ;
    dc:description "A Minor, Supernatural Virtue granting the power to tear any manufactured object made from plant or animal fibers, as a PeAn(He) 25 effect." ;
    rpg:hasTag amol:Virtue .
amol:FabricorOfVerditius a rpg:Character ;
    rpg:name "Fabricor of Verditius" ;
    dc:description "A young Verditius magus, one of the newly arrived members of Libellus." ;
    skos:altLabel "Fabricor" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:FacilitateTheStifledFormSpell a rpg:Spell ;
    rpg:name "Facilitate the Stifled (Form) Spell" ;
    dc:description "A Muto Vim general spell cast alongside a formulaic spell to remove the casting penalty from reduced or absent gestures and voice; has ten versions, one per Hermetic Form." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:FaerieChainsOfTheFamiliarSlave a rpg:Spell ;
    rpg:name "Faerie Chains of the Familiar Slave" ;
    dc:description "A CrVi ritual spell (R: Touch, D: Until) that binds a supernatural creature as a temporary familiar to the caster until an incorporated condition comes to pass." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:FaerieDoctorVirtue a rpg:Tag ;
    skos:prefLabel "Faerie Doctor (Virtue)" ;
    dc:description "The Free Mythic Companion Virtue defining a character as a faerie doctor, required of all faerie doctors." ;
    rpg:hasTag amol:Virtue .
amol:FaerieEnmity a rpg:Tag ;
    skos:prefLabel "Faerie Enmity" ;
    dc:description "A Flaw cursing the exsules's line, stemming from Quendalon's ancient curse, causing faeries to instinctively hate them." ;
    skos:altLabel "Faerie Enmity Flaw" ;
    rpg:hasTag amol:Flaw .
amol:FaerieFamiliar a rpg:Tag ;
    skos:prefLabel "Faerie Familiar" ;
    dc:description "A faerie bound as a magus's familiar; at Irencillia magi such as Glesig make their caricatures (e.g., the troll Humnel) into faerie familiars." ;
    rpg:hasTag amol:HermeticConcept .
amol:FaerieIngredients a rpg:Tag ;
    skos:prefLabel "Faerie Ingredients" ;
    dc:description "A Free laboratory Supernatural Virtue: some lab stores are supplied by faeries with beneficial if unpredictable properties, e.g. faerie silver." ;
    rpg:hasTag amol:Virtue .
amol:FaerieQueenOfIrencillia a rpg:Creature ;
    rpg:name "Faerie Queen of Irencillia" ;
    dc:description "A faerie queen used as an example target in the Symbolic Magic ritual, affected at Symbol Range via 'queen,' 'winter,' and 'faerie' charms." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:FaerieSight a rpg:Tag ;
    skos:prefLabel "Faerie Sight" ;
    dc:description "The ability to read glamour, allowing the holder to see magical things and tell what other faeries want simply by looking at them." ;
    rpg:hasTag amol:Virtue .
amol:FaerieSpeech a rpg:Tag ;
    skos:prefLabel "Faerie Speech" ;
    dc:description "A faerie ability to converse in the language of one's audience, speaking any language someone has used to speak to them without needing to Penetrate." ;
    rpg:hasTag amol:Virtue .
amol:FaerieSpider a rpg:Creature ;
    rpg:name "Faerie Spider" ;
    dc:description "A poisonous faerie spider befriended by Lutisse that protects her treehouse lab, though its cobwebs infest the dwelling." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:FaerieTarantula a rpg:Creature ;
    rpg:name "Faerie Tarantula" ;
    dc:description "A faerie creature whose bite afflicts victims with tarantism, an excess of yellow bile causing an irresistible urge to dance." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:FailedMonk a rpg:Tag ;
    skos:prefLabel "Failed Monk" ;
    dc:description "A Minor Social Status Flaw in which the character was cast out of a cloistered order, gaining a poor reputation but freedom from monastic vows." ;
    skos:altLabel "Failed Nun" ;
    rpg:hasTag amol:Flaw .
amol:Falconer a rpg:Tag ;
    skos:prefLabel "Falconer" ;
    dc:description "A Minor, Social Status Virtue for a character who trains hawks and falcons for a noble patron, granting Profession: Falconer and extra experience points." ;
    rpg:hasTag amol:Virtue .
amol:FallsLikeACat a rpg:Tag ;
    skos:prefLabel "Falls Like a Cat" ;
    dc:description "A Minor, General Virtue protecting a character from injury when falling up to three (or six) times his height." ;
    rpg:hasTag amol:Virtue .
amol:FalseWindow a rpg:Spell ;
    rpg:name "False Window" ;
    dc:description "A CrIm 5 miniature spell that traces a door or window frame to create an illusion of something beyond it, requiring a Perception + Finesse roll." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:FamiliarBond a rpg:Tag ;
    skos:prefLabel "Familiar Bond" ;
    dc:description "A Hermetic enchantment binding a magus to a familiar; it can be dispelled by Perdo Vim and is automatically re-sustained when a magus enters an Aegis." ;
    skos:altLabel "Familiar Bonds", "Familiars" ;
    rpg:hasTag amol:HermeticConcept .
amol:FastCaster a rpg:Tag ;
    skos:prefLabel "Fast Caster" ;
    dc:description "A Minor, Hermetic Virtue granting +3 to Initiative for casting spells in combat and +3 to fast-casting speed rolls." ;
    rpg:hasTag amol:Virtue .
amol:FastRunner a rpg:Tag ;
    skos:prefLabel "Fast Runner" ;
    dc:description "A heartbeast Quality example that, applied via Theriomorphy, gives the magus the legs of his heartbeast." ;
    rpg:hasTag amol:Virtue .
amol:FatalRegister a rpg:Spell ;
    rpg:name "Fatal Register" ;
    dc:description "A Muto Animal 20 spell that changes a book's bookmark ribbon into a venomous serpent (traditionally a cobra), typically vested in a single-use charged object activated when a book is stolen." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Fatigue a rpg:Tag ;
    skos:prefLabel "Fatigue" ;
    dc:description "A measure of tiredness with six named levels (Fresh, Winded, Weary, Tired, Dazed, Unconscious), lost through strenuous activity and recovered with rest." ;
    skos:altLabel "Fatigue levels", "Long-Term Fatigue", "Short-Term Fatigue" ;
    rpg:hasTag amol:HermeticConcept .
amol:Fauho a rpg:Character ;
    rpg:name "Fauho" ;
    dc:description "The filius of Midusulf and second primus of House Bjornaer, with a fox heartbeast; the Seat of the Fox is named after him." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Faun a rpg:Creature ;
    rpg:name "Faun" ;
    dc:description "A common woodland faerie creature; the common lezi is a form of faun, and gigantic fauns are found in the Basque country." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:FauxFeudalism a rpg:Tag ;
    skos:prefLabel "Faux Feudalism" ;
    dc:description "A Free covenant governance choice modeling hierarchical, feudal-style rule over residents." ;
    rpg:hasTag amol:HermeticConcept .
amol:FeatherMessenger a rpg:Tag ;
    skos:prefLabel "Feather Messenger" ;
    dc:description "A Minor, Supernatural Virtue for a bird-shifter who can separate a feather and telepathically control it as a self-inking quill, associated with the Daughters of Four Fathers." ;
    rpg:hasTag amol:Virtue .
amol:FebrisSemitertiana a rpg:Creature ;
    rpg:name "Febris Semitertiana" ;
    dc:description "A Major Choleric Disease (Severity 18) from water corrupted by Saturn and Mars, capable of killing thousands in summer." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Fedoso a rpg:Character ;
    rpg:name "Fedoso" ;
    dc:description "The protagonist of Verderis's epic poem The Travels of Fedoso, a young man who travels a strange landscape facing mystical obstacles, believed by some Criamon to be a map of the House's future." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Feldberg a schema:Place ;
    rpg:name "Feldberg" ;
    dc:description "The highest peak of the Black Forest, the bare-topped seat of the King of the Black Mountain, reached only via the haunted Höllental, with a multi-level regio of Faerie aura 3 to 8." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:FetteredMagic a rpg:Tag ;
    skos:prefLabel "Fettered Magic" ;
    dc:description "A Minor Hermetic Flaw making all of the character's spells and activated magic item effects Arcane Connections to him." ;
    rpg:hasTag amol:Flaw .
amol:Fidelus a rpg:Tag ;
    skos:prefLabel "Fidelus" ;
    dc:description "A House Tytalus faction member who is a loyalist of Buliste, the ninth Prima; Fideli wear royal purple as their badge." ;
    skos:altLabel "Fideli" ;
    rpg:hasTag amol:CharacterType .
amol:FindabairExMiscellanea a rpg:Character ;
    rpg:name "Findabair Ex Miscellanea" ;
    dc:description "A young, stunningly beautiful maga at Cad Gadu who uses magic to preserve her looks and dresses to seduce, while whining about the covenant's decay." ;
    skos:altLabel "Findabair" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:FindingHiddenLoot a rpg:Tag ;
    skos:prefLabel "Finding Hidden Loot" ;
    dc:description "A Minor, General Virtue granting +9 to Awareness rolls when searching a confined space for hidden items." ;
    rpg:hasTag amol:Virtue .
amol:FinesseRoll a rpg:Tag ;
    skos:prefLabel "Finesse roll" ;
    dc:description "A roll using the Finesse Ability that controls the quality of craft magic and substitutes for mundane Craft rolls when using craft spells or devices." ;
    rpg:hasTag amol:HermeticConcept .
amol:FinzWeibl a rpg:Creature ;
    rpg:name "Finz-Weibl" ;
    dc:description "A wood-wife who wears a wide-brimmed hat and is very hairy." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:FireDamp a rpg:Item ;
    rpg:name "Fire Damp" ;
    dc:description "A Level 10 Alteration Reagent kept in a stoppered flask that releases a heavy gas which dampens the intensity of flames, removing 10 points of fire damage." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:FireElemental a rpg:Creature ;
    rpg:name "Fire Elemental" ;
    dc:description "An elemental being of fire that can be created from elemental matter via a Creo Ignem ritual and controlled, transformed, or destroyed via Ignem magic by reducing its Might." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Fireheart a rpg:Item ;
    rpg:name "Fireheart" ;
    dc:description "Flambeau's lost talisman, an oval-cut flawless fire opal the size of a walnut into which he invested several fire and mind effects; serves as an Arcane Connection to its creator." ;
    skos:altLabel "The Lost Talisman of the Founder" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:FirstFlautist a rpg:Tag ;
    skos:prefLabel "First Flautist" ;
    dc:description "A leadership title of the Seirenes won at a grand competition every 12 years, treated equally to the other Firsts." ;
    rpg:hasTag amol:CharacterType .
amol:FirstLyrist a rpg:Tag ;
    skos:prefLabel "First Lyrist" ;
    dc:description "A leadership title of the Seirenes won at a grand competition every 12 years, treated equally to the other Firsts." ;
    rpg:hasTag amol:CharacterType .
amol:FirstSinger a rpg:Tag ;
    skos:prefLabel "First Singer" ;
    dc:description "A leadership title of the Seirenes won at a grand competition every 12 years, hosting the next competition at her covenant." ;
    rpg:hasTag amol:CharacterType .
amol:FishOutOfWaterTerrain a rpg:Tag ;
    skos:prefLabel "Fish Out of Water (Terrain)" ;
    dc:description "A Minor General Flaw giving the character an affinity for one terrain type and penalties when away from it." ;
    rpg:hasTag amol:Flaw .
amol:FiveFairsOfFlanders a schema:Place ;
    rpg:name "Five Fairs of Flanders" ;
    dc:description "A fair cycle of Lille, Mesen, Ypres, Torout, and Bruges held between February and November, built on the fine woolen and linen cloth trade." ;
    skos:altLabel "Flanders cycle" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:FlabbergastTheImpertinent a rpg:Spell ;
    rpg:name "Flabbergast the Impertinent" ;
    dc:description "A sample relic power (2 points, Init +3, Mentem) that curses the target into a deep, snoring sleep for the night from which no magic can prematurely wake them." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Flamen a rpg:Tag ;
    skos:prefLabel "Flamen" ;
    dc:description "The title ('priest') for a Mercurian magus, who performs ceremonial duties such as leading ritual magic, reading omens, and officiating Hermetic events." ;
    skos:altLabel "flamines" ;
    rpg:hasTag amol:CharacterType .
amol:FlamesOfSculptedIce a rpg:Spell ;
    rpg:name "Flames of Sculpted Ice" ;
    dc:description "A Muto Ignem spell (Level 35) with an Aquam requisite that turns a fire up to the size of a small house into ice sculptures of leaping flame; the flames return as the ice melts." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Flashbacks a rpg:Tag ;
    skos:prefLabel "Flashbacks" ;
    dc:description "A Minor General Flaw in which combat or tense situations may trigger hallucinatory flashbacks to past battles, causing panic." ;
    rpg:hasTag amol:Flaw .
amol:FlaviaOfJerbiton a rpg:Character ;
    rpg:name "Flavia of Jerbiton" ;
    dc:description "A Jerbiton maga trained by Jerbiton himself who founded Rosalba in 820 and wrote philosophical tractatus before her mysterious Final Twilight in 890." ;
    skos:altLabel "Flavia" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:FlaviusExMiscellanea a rpg:Character ;
    rpg:name "Flavius Ex Miscellanea" ;
    dc:description "A frustrated old magus of Ungulus, trained there in its glory days, who clings to the failing covenant and hopes to rebuild it with young magi after the others pass." ;
    skos:altLabel "Flavius" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:FlawlessEquipment a rpg:Tag ;
    skos:prefLabel "Flawless Equipment" ;
    dc:description "A Free laboratory Supernatural Virtue: the lab's outfittings are flawless, perhaps too perfect for mortal hands (+2 General Quality, +2 Vis Extraction)." ;
    rpg:hasTag amol:Virtue .
amol:FlawlessTools a rpg:Tag ;
    skos:prefLabel "Flawless Tools" ;
    dc:description "A Free laboratory Supernatural Virtue: the lab's tools are legendarily perfect (+2 Items)." ;
    rpg:hasTag amol:Virtue .
amol:FlawsOfTheWeaponsmith a rpg:Spell ;
    rpg:name "Flaws of the Weaponsmith" ;
    dc:description "A Perdo Terram 25 spell invented by Philippus Niger that rusts away up to 100 metal objects, such as the arms and armor of 30 men." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:FleetsOfVenice a rpg:Tag ;
    skos:prefLabel "Fleets of Venice" ;
    dc:description "Heavily oversubscribed Venetian trading-fleet investments assumed unable to fail, whose occasional loss of ships to weather or piracy can cascade into an unraveling city economy." ;
    skos:altLabel "the fleets" ;
    rpg:hasTag amol:HermeticConcept .
amol:Florilegium a rpg:Tag ;
    skos:prefLabel "Florilegium" ;
    dc:description "A category of compiled Hermetic book noted by dedicated students of a subject, rarer than the Roots and Branches and found in libraries specializing in its theme." ;
    skos:altLabel "florilegia" ;
    rpg:hasTag amol:HermeticConcept .
amol:FlumenOfTremere a rpg:Character ;
    rpg:name "Flumen of Tremere" ;
    dc:description "A Tremere magus, parens of Goliard and former leader of Blackthorn, who captured the Wild Hunt in 1154 and passed into Final Twilight in 1187." ;
    skos:altLabel "Flumen" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:FocusOfFlambeau a rpg:Character ;
    rpg:name "Focus of Flambeau" ;
    dc:description "A Flambeau magus at Burnham, Scintilla's filius, about whom little else is known." ;
    skos:altLabel "Focus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:FogOfConfusion a rpg:Spell ;
    rpg:name "Fog of Confusion" ;
    dc:description "A Muto Auram ritual (Level 45) that turns a bank of fog into a silvery mist too thick to see through, harassing and confusing those within it." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:FoolingTheEye a rpg:Spell ;
    rpg:name "Fooling the Eye" ;
    dc:description "A CrIm 10 miniature spell creating species of a swift bright object that makes the target's eyes track toward the magus, enabling Eye Range spellcasting." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ForcelessCasting a rpg:Tag ;
    skos:prefLabel "Forceless Casting" ;
    dc:description "A technique of deliberately casting a spell with Penetration Total of 0 so it cannot affect a magus's Magic Resistance, used in tournaments and group spellcasting." ;
    rpg:hasTag amol:HermeticConcept .
amol:ForestLaw a rpg:Tag ;
    skos:prefLabel "Forest Law" ;
    dc:description "A separate legal system applying in royal forests, prohibiting hunting, wood-cutting, and fires, enforced by foresters and forest eyres." ;
    rpg:hasTag amol:HermeticConcept .
amol:ForestPaths a rpg:Tag ;
    skos:prefLabel "Forest Paths" ;
    dc:description "Mystical paths through the forests of the Rhine Tribunal that a magus may explore; ascending the Glade of the Seven Waterfalls grants deeper understanding of the Forest." ;
    rpg:hasTag amol:HermeticConcept .
amol:ForestOfShiningStone a schema:Place ;
    rpg:name "Forest of Shining Stone" ;
    dc:description "A Great Work at Durenmar where Bonisagus's epitome The Art of Magic has been etched into 36 clear crystals each six feet high." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:ForgeOfHephaestus a schema:Place ;
    rpg:name "Forge of Hephaestus" ;
    dc:description "Sacred forges built by Hephaestus, the three Hermetic ones located at Verdi (Sardinia), Lemnos, and Mount Olympus, serving as Verditius Initiation chambers." ;
    skos:altLabel "Forge of Hephaestus at Sardinia", "Forges of Hephaestus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:ForgettableFace a rpg:Tag ;
    skos:prefLabel "Forgettable Face" ;
    dc:description "A Minor, General Virtue making a character hard to notice or describe, imposing -3 on rolls to identify him but incompatible with great beauty or charisma." ;
    rpg:hasTag amol:Virtue .
amol:FormOfTheTemperamentHeartbeast a rpg:Spell ;
    rpg:name "Form of the (Temperament) Heartbeast" ;
    dc:description "A Muto Animal 20 spell with four temperament versions (sanguine, choleric, melancholic, phlegmatic) that enhances an animal form's humoral correspondences; modeled from Birna's innate abilities." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Formula a rpg:Tag ;
    skos:prefLabel "Formula" ;
    dc:description "A researched recipe of experimental philosophy, like a Laboratory Text, describing how to make astrological inceptions, alchemical reagents, or pharmaceutical theriacs." ;
    skos:altLabel "Formulae" ;
    rpg:hasTag amol:HermeticConcept .
amol:FornaxOfTremere a rpg:Character ;
    rpg:name "Fornax of Tremere" ;
    dc:description "Goliard's filia at Blackthorn, an ugly and rude mature maga rumored to specialize in Rego and Mentem to make people entertain her." ;
    skos:altLabel "Fornax" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:FortunataOfJerbiton a rpg:Character ;
    rpg:name "Fortunata of Jerbiton" ;
    dc:description "A powerful eleventh-century spirit master of House Jerbiton who defeated many non-Hermetic enemies but was forced into exile and disappeared into Final Twilight after 1120." ;
    skos:altLabel "Fortunata" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:FortunatusOfJerbiton a rpg:Character ;
    rpg:name "Fortunatus of Jerbiton" ;
    dc:description "A magus of House Jerbiton whose Creo Imaginem illusions often have a small religious icon worked into their structure due to how he invents his spells." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:FoundingOfTheOrder a rpg:Tag ;
    skos:prefLabel "Founding of the Order" ;
    dc:description "The historical establishment of the Order of Hermes, predating which some traditions held antipathies against House Diedne." ;
    skos:altLabel "the Founding" ;
    rpg:hasTag amol:HermeticConcept .
amol:FountainOfYouth a schema:Place ;
    rpg:name "Fountain of Youth" ;
    dc:description "A magical fountain deep in the forest sought by Alexander of Jerbiton; drinking from it infused his blood with the power of youth, enhancing his longevity rituals." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:FourthCrusade a rpg:Tag ;
    skos:prefLabel "Fourth Crusade" ;
    dc:description "A late-12th-century crusade for which the Venetians built a fleet; unable to pay, the Crusaders were forced to sack Constantinople in 1204, and many cycled-out Venetian warships later mysteriously disappeared." ;
    rpg:hasTag amol:HermeticConcept .
amol:FourthLateranCouncil a rpg:Tag ;
    skos:prefLabel "Fourth Lateran Council" ;
    dc:description "A Church council of 1215 that forbade clergy from cautery or surgical incision and obliged physicians to require patients to summon a confessor before treatment." ;
    rpg:hasTag amol:HermeticConcept .
amol:Frail a rpg:Tag ;
    skos:prefLabel "Frail" ;
    dc:description "A Minor General Flaw making the character weak of build with a -3 penalty to Soak score." ;
    rpg:hasTag amol:Flaw .
amol:France a schema:Place ;
    rpg:name "France" ;
    dc:description "A kingdom of Mythic Europe whose king the king of England owes fealty for mainland possessions; home to Cluny, the Champagne fairs, and Laon, and which can be saved from demons in a saga." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Franciscan a rpg:Faction ;
    rpg:name "Franciscan" ;
    dc:description "One of the two major new mendicant friar orders of the early thirteenth century, whose members take vows of poverty, chastity, and obedience and travel preaching." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Franconia a schema:Place ;
    rpg:name "Franconia" ;
    dc:description "A large and important region of the Rhine Tribunal containing some of the greatest German cities, with no single ruler; land shared between emperor and church." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Frankfurt a schema:Place ;
    rpg:name "Frankfurt" ;
    dc:description "A trading city founded by Charlemagne at the 'Ford of the Franks' on the River Main, home to about 10,000 citizens and host of imperial elections." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:FrauHolle a rpg:Creature ;
    rpg:name "Frau Holle" ;
    dc:description "A modest Holzfrau who in the nine days before Walpurgis Night travels the land on a rickety wagon, pursued by the Wild Hunt, before ascending the Brocken and revealing herself as the goddess Walpurga." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:FrauWacholder a rpg:Creature ;
    rpg:name "Frau Wacholder" ;
    dc:description "A wood-wife who is the genius of the juniper tree, invoked to make thieves give up their booty." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:FrauWode a rpg:Creature ;
    rpg:name "Frau Wode" ;
    dc:description "The female leader of a Wild Hunt that haunts the Elbe river, accompanied by shadowy boatmen carrying invisible passengers." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:FredegisaTheQuaesitor a rpg:Character ;
    rpg:name "Fredegisa the Quaesitor" ;
    dc:description "A reforming idealist quaesitor at Schola Pythagoranis, a brilliant young student of all laws who devises new structures of Hermetic law." ;
    skos:altLabel "Fredegisa" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:FreedomOfMovement a rpg:Tag ;
    skos:prefLabel "Freedom of Movement" ;
    dc:description "A common automaton power (base effect 25, Mentem requisite) letting the automaton walk toward areas pointed out to it." ;
    rpg:hasTag amol:HermeticConcept .
amol:FreeingTheStridingTree a rpg:Spell ;
    rpg:name "Freeing the Striding Tree" ;
    dc:description "A Rego Herbam spell (Level 30) like Lord of the Trees but enabling the tree to walk half as fast as a human; a botched Concentration roll causes the tree to attack the caster." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Freiberg a schema:Place ;
    rpg:name "Freiberg" ;
    dc:description "The biggest of the mining towns in the Ore Mountains, founded in 1186 after silver and tin were discovered." ;
    skos:altLabel "Free Mountain" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Fria a rpg:Character ;
    rpg:name "Fria" ;
    dc:description "The goddess worshiped by the old Germanic tribes alongside Woden, Thunor, and Tius." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:FriderichInvigilor a rpg:Character ;
    rpg:name "Friderich Invigilor" ;
    dc:description "The filius of Drogo Invigilor, similarly investigated by House Guernicus for his association with the Salian dynasty." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Friesland a schema:Place ;
    rpg:name "Friesland" ;
    dc:description "A broad, flat, swampy territory bordering the North Sea, sparsely populated and home to the independent Friesian people and the Friesian Islands." ;
    skos:altLabel "Friesia" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Fulda a schema:Place ;
    rpg:name "Fulda" ;
    dc:description "An important pilgrimage site and home to a wealthy monastery, burial place of the martyred English monk St. Boniface." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Fulmonious a rpg:Character ;
    rpg:name "Fulmonious" ;
    dc:description "A magus of House Tytalus who, with Schwall of Bjornaer, founded the covenant of Rheinstein in the Rhine Gorge in 1123 AD." ;
    skos:altLabel "Fulmonious of Tytalus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Furioso a rpg:Character ;
    rpg:name "Furioso" ;
    dc:description "A Sorcerous Musician who lacks Subtle Magic, used as a contrasting example to Orlando in Performance Magic." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Fury a rpg:Tag ;
    skos:prefLabel "Fury" ;
    dc:description "A Major Story Flaw in which a violent temper overwhelms the character, sending him into uncontrollable rage." ;
    rpg:hasTag amol:Flaw .
amol:FuryOfTheChargingBull a rpg:Spell ;
    rpg:name "Fury of the Charging Bull" ;
    dc:description "A ReAn 20 spell that enrages a target animal (up to Size +3), sometimes used by School of Vilano followers to make animals attack enemies, though unpredictably." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Gabai a rpg:Tag ;
    skos:prefLabel "Gabai" ;
    dc:description "A Minor Social Status Flaw marking the character as the local Jewish tax collector appointed by the community council, with a negative Tax Collector Reputation." ;
    rpg:hasTag amol:Flaw .
amol:Gallery a rpg:Tag ;
    skos:prefLabel "Gallery" ;
    dc:description "A Minor laboratory Structure Virtue: an interior gallery or platform lets someone view the whole lab without disturbing it (+1 Safety, +1 Aesthetics, +1 Teaching)." ;
    rpg:hasTag amol:Virtue .
amol:Galley a rpg:Item ;
    rpg:name "Galley" ;
    dc:description "An oar-propelled single-masted vessel popular with Italian maritime powers and Byzantine states, designed to ram enemies and discourage piracy." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:Galli a rpg:Faction ;
    rpg:name "Galli" ;
    dc:description "A sect of nature worshippers once associated with the wild lands beyond the Roman Empire, later integrated into the Cult of Diana, said to be the origin of a True Merinitae Initiation Script." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Ganelon a rpg:Character ;
    rpg:name "Ganelon" ;
    dc:description "A leading magus of the Ash Gild who declared Wizard War on Aschlaranda and Schadrit and pursued them into the Black Forest, never to be heard from again." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Gangrene a rpg:Creature ;
    rpg:name "Gangrene" ;
    dc:description "A Minor Sanguine Disease in which evil spirits in an improperly cleaned wound putrefy the blood; common after a botched Wound Recovery roll." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:GardenOfEden a schema:Place ;
    rpg:name "Garden of Eden" ;
    dc:description "The biblical paradise referenced in the Divine material of the setting." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Garotillo a rpg:Creature ;
    rpg:name "Garotillo" ;
    dc:description "A Serious Choleric Disease from excessive exercise inflaming the choler; its second stage spreads to the windpipe causing suffocation." ;
    skos:altLabel "morbus suffocans" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Garrinchus a rpg:Character ;
    rpg:name "Garrinchus" ;
    dc:description "A newly apprenticed magus of House Ex Miscellanea at Fengheld's Rheingasse chapter, companion of Wilhelm Weiss and a member of the Apple Gild; his master was an expert in physick." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Gascony a schema:Place ;
    rpg:name "Gascony" ;
    dc:description "A region of southwestern France, the probable birthplace of Flambeau the Founder around 715 AD." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Gateway a rpg:Tag ;
    skos:prefLabel "Gateway" ;
    dc:description "A Minor laboratory Supernatural Virtue: the lab sits at a supernatural gateway such as a regio entrance, faerie realm, or Mercere Portal." ;
    rpg:hasTag amol:Virtue .
amol:GatheringOfTheStormyMight a rpg:Spell ;
    rpg:name "Gathering of the Stormy Might" ;
    dc:description "A Rego Auram spell (Level 40) like Clouds of Thunderous Might but producing a larger storm that can cover the entire visible sky." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Gaudy a rpg:Tag ;
    skos:prefLabel "Gaudy" ;
    dc:description "A Free laboratory Outfittings Flaw: the lab's decoration is tasteless and excessive (+1 Upkeep, -1 Aesthetics, +1 Imaginem)." ;
    rpg:hasTag amol:Flaw .
amol:GazeOfDeath a rpg:Spell ;
    rpg:name "Gaze of Death" ;
    dc:description "A Corpus power of the basilisk Sordus (8 points) that inflicts an incapacitating wound on anyone his gaze rests upon." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Geirlaug a rpg:Character ;
    rpg:name "Geirlaug" ;
    dc:description "A notable contemporary House Flambeau Archmaga of Montverte covenant in the Normandy Tribunal, renowned for her great age, power, and mastery of Ignem." ;
    skos:altLabel "Archmaga Geirlaug of Montverte" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Gelon a rpg:Character ;
    rpg:name "Gelon" ;
    dc:description "Verditius's first apprentice and the first Primus of House Verditius; he attended the original Grand Tribunal, won the first Contest, and perpetuated the Corsican blood feud." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Genomi a rpg:Creature ;
    rpg:name "Genomi" ;
    dc:description "Earth elementals known to the Order as genomi, rarefied from unworked earth, rock, or metal; long-lived, patient predators that crave the moisture of living beings and make excellent guards." ;
    skos:altLabel "Earth Elementals", "genomus", "gnomes", "pygmaei", "telluri" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:GentleCaressOfAesclepius a rpg:Spell ;
    rpg:name "Gentle Caress of Aesclepius" ;
    dc:description "A CrCo 30 Ritual spell that improves all of the target's wounds by one level of severity and instantly heals Light Wounds." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:GeoffreyDeMandeville a rpg:Character ;
    rpg:name "Geoffrey de Mandeville" ;
    dc:description "A treacherous noble who, charged with treason in 1143, ravaged the East Anglian fens and destroyed the covenant of Natura Antiqua before being killed in 1144." ;
    skos:altLabel "Mandeville" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:GeoffreyDeMarsh a rpg:Character ;
    rpg:name "Geoffrey de Marsh" ;
    dc:description "The justiciar of Ireland refusing to come to England to account for his office's revenues, possibly seeking to form a palatinate with vice-regal authority." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:GeoffreyDeNevile a rpg:Character ;
    rpg:name "Geoffrey de Nevile" ;
    dc:description "The seneschal of Poitou who returned to England to resign his office, claiming he lacked the resources to carry out his role." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:GeraldOfWales a rpg:Character ;
    rpg:name "Gerald of Wales" ;
    dc:description "A churchman who campaigned much of his life to make St. Davids an archbishopric over the Welsh sees, author of The Journey Through Wales." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Gerard a rpg:Character ;
    rpg:name "Gerard" ;
    dc:description "A grog used in the complex combat example, with combat statistics and skills Single Weapon 6 and Leadership 2, who fights his faerie duplicate." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:GerbertOfAurillac a rpg:Character ;
    rpg:name "Gerbert of Aurillac" ;
    dc:description "A scholar said in legend to have stolen a book of magic from a Saracen wizard and made a golden oracular head; Hermetic seekers covet his rumored treasures." ;
    skos:altLabel "Gerbert", "Pope Sylvester II" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:GerfallonOfCriamon a rpg:Character ;
    rpg:name "Gerfallon of Criamon" ;
    dc:description "The tattooed, shape-shifting Criamon leader of Semitae since 1151 who maps the covenant's wanderings and pursues the Enigma; shows no signs of aging." ;
    skos:altLabel "Gerfallon" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:GerfallonOfSemitae a rpg:Character ;
    rpg:name "Gerfallon of Semitae" ;
    dc:description "A magus of the tribunal whom some magi believe carved the strange cup-and-ring markings at Roughting Linn, though he will not confirm it." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Gerontocracy a rpg:Tag ;
    skos:prefLabel "Gerontocracy" ;
    dc:description "A Free covenant governance choice in which the oldest members rule." ;
    rpg:hasTag amol:HermeticConcept .
amol:GharadExMiscellanea a rpg:Character ;
    rpg:name "Gharad Ex Miscellanea" ;
    dc:description "The second oldest maga at Cad Gadu, nearly blind and beset by Twilight delusions; rarely leaves her sanctum." ;
    skos:altLabel "Gharad" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Ghent a schema:Place ;
    rpg:name "Ghent" ;
    dc:description "A place near which the Spinnen Blood family line of the Faerie Blood Virtue originated." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Ghibellines a rpg:Faction ;
    rpg:name "Ghibellines" ;
    dc:description "One of the two factions feuding over Florence since 1216, splitting the city along with the Guelphs." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Ghost a rpg:Creature ;
    rpg:name "Ghost" ;
    dc:description "The disembodied spirit of a dead person, associated with Mentem; ghosts can be warded against, summoned, coerced, or controlled by Mentem magic." ;
    skos:altLabel "disembodied spirit", "ghosts" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Giant a rpg:Creature ;
    rpg:name "Giant" ;
    dc:description "Large Magic-realm Corpus creatures detailed in the bestiary." ;
    skos:altLabel "Giants", "Typical Giant" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:GiantBlooded a rpg:Tag ;
    skos:prefLabel "Giant Blooded" ;
    dc:description "A Virtue making a character larger than a normal human, so that a wound that would be Medium for a normal human is only Light for them." ;
    rpg:hasTag amol:Virtue .
amol:GiantSDance a schema:Place ;
    rpg:name "Giant's Dance" ;
    dc:description "The great stone circle Merlin magically moved from Mount Killaraus in Ireland to Britain, erecting it around the tomb of those slain at Ambrius (Stonehenge)." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:GiantsBlood a rpg:Tag ;
    skos:prefLabel "Giants' Blood" ;
    dc:description "A heritage that makes its bearer unusually large and strong; Great William has giants' blood and stands just under eight feet tall." ;
    rpg:hasTag amol:Virtue .
amol:GiftOfTheFrogSLegs a rpg:Spell ;
    rpg:name "Gift of the Frog's Legs" ;
    dc:description "A Rego Corpus spell (Level 15) that allows the target to leap up to 15 feet vertically or 25 feet horizontally." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:GiftOfTheTorturedBowels a rpg:Spell ;
    rpg:name "Gift of the Tortured Bowels" ;
    dc:description "A Rego Corpus 10 spell that inflicts a sudden intestinal cramp and bout of diarrhea, used therapeutically by medically inclined magi to purge putrefied humors." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:GiftedCompanion a rpg:Tag ;
    skos:prefLabel "Gifted Companion" ;
    dc:description "A character type a hedge wizard may become if the opening of his Arts fails or he declines the risk, joining the Order without full magus status." ;
    rpg:hasTag amol:CharacterType .
amol:GiftedCompanions a rpg:Tag ;
    skos:prefLabel "Gifted Companions" ;
    dc:description "Hedge wizards new to the Order, or those resisting conversion to Hermetic magic, who have The Gift and one or more Supernatural Abilities but do not open their Arts; the Scinnfolk are an example." ;
    rpg:hasTag amol:CharacterType .
amol:GilbertineOrder a rpg:Faction ;
    rpg:name "Gilbertine Order" ;
    dc:description "The order of St. Gilbert of Sempringham, confined to eastern England and unique in having both male (Augustinian canons) and female (Benedictine nuns) members." ;
    skos:altLabel "Gilbertines" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Gillomaur a rpg:Character ;
    rpg:name "Gillomaur" ;
    dc:description "The king of Ireland who swore the Britons would take no stone from his kingdom; his naked army was defeated and he was slain in a wood while fleeing." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Gilpatrick a rpg:Character ;
    rpg:name "Gilpatrick" ;
    dc:description "An Irish-born baccalaureate student at the University of Paris and companion-level character with the Entrancement Ability and Latent Magic Ability, indebted to the bishop of Dublin." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Glam a rpg:Character ;
    rpg:name "Glam" ;
    dc:description "A revenant of the walking dead from The Saga of Grettir the Strong who rode on house-tops by night and terrorized a district after his death." ;
    skos:altLabel "Glamr" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:GlassBlower a rpg:Tag ;
    skos:prefLabel "Glass-blower" ;
    dc:description "A covenfolk template for a dwarf-blooded glassblower craftsman with Faerie Blood and Great Dexterity, able to make clear glass." ;
    rpg:hasTag amol:CharacterType .
amol:GlastonburyTor a schema:Place ;
    rpg:name "Glastonbury Tor" ;
    dc:description "A commanding hill near Glastonbury where St. Collen confronted Gwynn ab Nudd's faerie castle." ;
    skos:altLabel "the Tor" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:GleamOfTheFreshlyPolishedGlass a rpg:Spell ;
    rpg:name "Gleam of the Freshly-Polished Glass" ;
    dc:description "A Perdo Terram 25 spell that keeps a lab's equipment immaculately clean, granting the Spotless Virtue while cast monthly but raising Warping by one." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Gleemen a rpg:Faction ;
    rpg:name "Gleemen" ;
    dc:description "A group of jugglers warned of by northern clerics as tainted by the infernal, accused of diabolical powers, robbery, and sacrificing stolen children to a demon patron." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Glesig a rpg:Character ;
    rpg:name "Glesig" ;
    dc:description "A master maga of House Merinita at Irencillia, most versed in the subterranean fae and specializing in Terram magics; her copper hair is a Twilight effect and her familiar is the troll caricature Humnel." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:GloomOfEvening a rpg:Spell ;
    rpg:name "Gloom of Evening" ;
    dc:description "A Perdo Ignem spell (Level 10) that substantially drops the level of light in a target room, making it gloomy with deep shadows." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:GlowingFootprintsOfTheThief a rpg:Spell ;
    rpg:name "Glowing Footprints of the Thief" ;
    dc:description "A MuIm 20 synaesthetic spell that makes a person's sweat traces visible by transforming olfactory species into iconic species." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:GmNd a schema:Place ;
    rpg:name "Gmünd" ;
    dc:description "A town in the Stauferland founded by Conrad III in the 12th century, named after the Hohenstaufen dynasty; it lies on the ancient Roman limes and specializes in luxuries." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:God a rpg:Character ;
    rpg:name "God" ;
    dc:description "The supreme being of the Divine Realm in Mythic Europe." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Godfroi a rpg:Character ;
    rpg:name "Godfroi" ;
    dc:description "An example agent of Carolus, a merchant who handles stolen goods and is influential in local government and the Merchant Guild; held by Fear of Carolus." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:GoeticArtOfBinding a rpg:Proficiency ;
    rpg:name "Goetic Art of Binding" ;
    dc:description "A Goetic Art used by a sahir to bind the Buran of Yenghissar; an Infernal supernatural ability for trapping spirits." ;
    skos:altLabel "Binding" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:GoldenCider a rpg:Tag ;
    skos:prefLabel "Golden Cider" ;
    dc:description "The power gained at the Avenue of Death on the Path of Strife, which makes mystical things mundane; many followers use it upon themselves near death to relinquish The Gift." ;
    skos:altLabel "Station of Golden Cider" ;
    rpg:hasTag amol:HermeticConcept .
amol:GoldenFleece a rpg:Item ;
    rpg:name "Golden Fleece" ;
    dc:description "The treasure the Argonauts voyaged to retrieve, during which Orpheus saved them from the sirens." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:GoldenHeadOfGerbert a rpg:Item ;
    rpg:name "Golden Head of Gerbert" ;
    dc:description "A legendary golden head crafted by Gerbert of Aurillac said to answer yes or no to any question; rumored to be used in Verditius Mystery Cult initiations." ;
    skos:altLabel "golden head" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:GoldenMaidenOfHephaestus a rpg:Item ;
    rpg:name "Golden Maiden of Hephaestus" ;
    dc:description "An ancient automaton created by Hephaestus and left in his forge; Verditius alone could understand it and made it function for seven days." ;
    skos:altLabel "golden maiden", "twelve golden mechanical women" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:GoldenMap a rpg:Item ;
    rpg:name "Golden Map" ;
    dc:description "A solid-gold, gemstone-marked copy of an ancient Roman map given to Augustus Caesar; coveted as an enchantment shape and possible Arcane Connection, and rumored by some pagans to sustain the Dominion." ;
    skos:altLabel "Mappa Mundi", "the gold map" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:GoliardicTradition a rpg:Faction ;
    rpg:name "Goliardic tradition" ;
    dc:description "A tradition of wandering, irreverent student-poets famously led by the Archpoet, spreading debauchery and satire across Germany and Italy." ;
    skos:altLabel "Goliardic" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:GoliasOfTytalus a rpg:Character ;
    rpg:name "Golias of Tytalus" ;
    dc:description "An old Tytalus magus at Blackthorn who feigns being newly gauntleted; the covenant's best political dealer, with unknown magical interests." ;
    skos:altLabel "Golias" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Gorgias a rpg:Character ;
    rpg:name "Gorgias" ;
    dc:description "A Sophist and pupil of Empedocles quoted in the Analects of Tytalus who taught the arts of persuasion and deceit, illustrating the corrupting power of words." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Goslar a schema:Place ;
    rpg:name "Goslar" ;
    dc:description "A Free Imperial City on the northern edge of the Harz Mountains, famed for the silver mines of the Rammelsberg, which are flooding due to spiteful gnomes." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:GossipOfTheMarketplace a rpg:Spell ;
    rpg:name "Gossip of the Marketplace" ;
    dc:description "A Creo(Rego) Mentem 20 spell invented by Imanitos Mendax that implants information in a target who is then compelled to pass it on to friends." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:GothicShapeshifters a rpg:Faction ;
    rpg:name "Gothic shapeshifters" ;
    dc:description "An Infernal Gothic witch-cult that enslaved ancestor-spirits to shapeshift; Birna's former tradition, surviving in secret in the forests of Pomerania and reviling Birna." ;
    skos:altLabel "Gothic witch-cult", "Pomeranian witches", "witch-women" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Granada a schema:Place ;
    rpg:name "Granada" ;
    dc:description "A region whose harried magi monitor the largest uncontrolled portal at the Pillars of Hercules for creatures that might harm Europe." ;
    skos:altLabel "magi of Granada" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:GrandEntrance a rpg:Tag ;
    skos:prefLabel "Grand Entrance" ;
    dc:description "A Free laboratory Structure Virtue: an elaborate entranceway leads to the lab, impressing observers (+2 Aesthetics)." ;
    rpg:hasTag amol:Virtue .
amol:GrantFlaw a rpg:Tag ;
    skos:prefLabel "Grant Flaw" ;
    dc:description "A special power of the Holm Oak of Romowe that inflicts the Depression Flaw upon anyone who breaks a branch or kills an animal in its grove." ;
    skos:altLabel "Grant Flaw (Depression)" ;
    rpg:hasTag amol:HermeticConcept .
amol:Gratian a rpg:Character ;
    rpg:name "Gratian" ;
    dc:description "A Benedictine monk at Bologna who completed the Decretum, a collection of ecclesiastical laws, contributing to Bologna's legal reputation." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Gravis a rpg:Character ;
    rpg:name "Gravis" ;
    dc:description "A journeyman magus of House Bonisagus at Irencillia pursuing a fascination with the fae; despite great Faerie Lore he cannot grasp Faerie Magic, and his caricature is the grumpy dwarf Danket." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:GreatCharacteristics a rpg:Tag ;
    skos:prefLabel "Great Characteristics" ;
    dc:description "A Virtue boosting a character's physical or mental Characteristics; held by the Blacksmith template." ;
    rpg:hasTag amol:Virtue .
amol:GreatDexterity a rpg:Tag ;
    skos:prefLabel "Great Dexterity" ;
    dc:description "A Virtue providing an exceptionally high Dexterity Characteristic, taken by the glass-blower and burglar templates." ;
    rpg:hasTag amol:Virtue .
amol:GreatStamina a rpg:Tag ;
    skos:prefLabel "Great Stamina" ;
    dc:description "A Minor General Virtue boosting the Stamina Characteristic; required of Nephilim." ;
    rpg:hasTag amol:Virtue .
amol:GreatWilliam a rpg:Character ;
    rpg:name "Great William" ;
    dc:description "A Redcap with giants' blood standing just under eight feet tall; interested in magical theory, with boots of swiftness and an enchanted accurate axe." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:GreatWork a rpg:Tag ;
    skos:prefLabel "Great Work" ;
    dc:description "Beautiful learning structures created as alternatives to books that embody their creators' values, studied as summae or tractatus, costing at least 100 Mythic Pounds to build." ;
    skos:altLabel "Great Works" ;
    rpg:hasTag amol:HermeticConcept .
amol:GreaterCollection a rpg:Tag ;
    skos:prefLabel "Greater Collection" ;
    dc:description "The sum of all Hermetic libraries, which great libraries coordinate to build by specializing in areas of weakness; Durenmar aids its construction as a spare copy of its own collection." ;
    rpg:hasTag amol:HermeticConcept .
amol:GreaterExpansion a rpg:Tag ;
    skos:prefLabel "Greater Expansion" ;
    dc:description "A Major laboratory Outfittings Virtue: the lab is greatly enlarged with at least double the usual equipment for specialized tasks." ;
    rpg:hasTag amol:Virtue .
amol:GreaterFeature a rpg:Tag ;
    skos:prefLabel "Greater Feature" ;
    dc:description "A Major laboratory Structure Virtue: the lab prominently features a unique extensive structure aiding certain lab work, granting +2 Aesthetics and 3 Specialization points." ;
    rpg:hasTag amol:Virtue .
amol:GreaterFocus a rpg:Tag ;
    skos:prefLabel "Greater Focus" ;
    dc:description "A Major laboratory Structure Flaw: an existing Greater Feature is the overwhelming focus of the lab, enhancing it but hindering unrelated activities (-2 General Quality)." ;
    rpg:hasTag amol:Flaw .
amol:GreaterGuardian a rpg:Tag ;
    skos:prefLabel "Greater Guardian" ;
    dc:description "A Major laboratory Supernatural Virtue: a powerful supernatural creature (Might 20+) that is not the owner's familiar resides in and protects the lab." ;
    rpg:hasTag amol:Virtue .
amol:GreaterHorde a rpg:Tag ;
    skos:prefLabel "Greater Horde" ;
    dc:description "A Major laboratory Supernatural Virtue: a large community of minor supernatural creatures serves and protects the lab and assists with simple tasks." ;
    rpg:hasTag amol:Virtue .
amol:GreaterIllusion a rpg:Tag ;
    skos:prefLabel "Greater Illusion" ;
    dc:description "A Major laboratory Supernatural Flaw: a major aspect of the lab is merely an illusion; a balancing Major Virtue is taken but its effects are negated." ;
    rpg:hasTag amol:Flaw .
amol:GreaterInfernalPower a rpg:Tag ;
    skos:prefLabel "Greater Infernal Power" ;
    dc:description "A Major Supernatural Virtue for corrupted beasts adding 5 to Infernal Might and granting an Infernal Power requiring a Penetration total." ;
    rpg:hasTag amol:Virtue .
amol:GreenDragonOfLabin a rpg:Creature ;
    rpg:name "Green Dragon of Labin" ;
    dc:description "A dragon famously slain by the Flambeau magus Vilano, who crushed it with two falling trees using only indirect spells." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:GregoriusOfBonisagus a rpg:Character ;
    rpg:name "Gregorius of Bonisagus" ;
    dc:description "A young Bonisagus magus, one of the newly arrived members of Libellus." ;
    skos:altLabel "Gregorius" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Grendel a rpg:Creature ;
    rpg:name "Grendel" ;
    dc:description "A troll that terrorized King Hrothgar's hall until slain by Beowulf; its kin still haunt the bogs of Zealand and plague the covenant Heorot." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Grifo a rpg:Character ;
    rpg:name "Grifo" ;
    dc:description "An example famous maestro affiliated with the Divine realm, commissioned to paint a wall mural for the bishop of Milan." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Grim a rpg:Character ;
    rpg:name "Grim" ;
    dc:description "An example grog used to illustrate disease and demonic possession rules, who is assailed by a Demon of Scrofula." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:GrimeSGraves a schema:Place ;
    rpg:name "Grime's Graves" ;
    dc:description "About a dozen large pits with tunnels in a Norfolk chalk hill, believed to be inhabited by faerie folk; those who wander too close at night tend to vanish, and strange lights are seen." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Grimgroth a rpg:Character ;
    rpg:name "Grimgroth" ;
    dc:description "A figure of the Order named as a trademark in the book's front matter." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:GrowthOfTheCreepingThings a rpg:Spell ;
    rpg:name "Growth of the Creeping Things" ;
    dc:description "A Muto Animal spell (Level 15) causing a small creature like an insect, mouse, or toad to grow to four times its normal size, increasing any venom." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:GruffydApLlewelyn a rpg:Character ;
    rpg:name "Gruffyd ap Llewelyn" ;
    dc:description "A Welsh king who attacked England, besieged Blackthorn and sacked Cad Gadu; magi suspected him of being a returned Díedne magus due to his name." ;
    skos:altLabel "Gruffyd" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Guard a rpg:Tag ;
    skos:prefLabel "Guard" ;
    dc:description "A Free laboratory Outfittings Virtue: a shield grog stands permanent duty at the lab's entrance to dissuade intruders (+1 Aesthetics)." ;
    rpg:hasTag amol:Virtue .
amol:GuardianOfTheForest a rpg:Tag ;
    skos:prefLabel "Guardian of the Forest" ;
    dc:description "A self-declared role, usually taken by a Bjornaer magus, claiming a forest or wilderness as personal Hermetic territory; treated as the Oath of Fealty Sacrifice rather than a Quest." ;
    skos:altLabel "Guardian" ;
    rpg:hasTag amol:CharacterType .
amol:GudrutyKomTheGiant a rpg:Creature ;
    rpg:name "Gudruty-kom the Giant" ;
    dc:description "A giant Daimon (Magic Might 40, Auram), master of hail who can stretch his mouth from the ground to the clouds and swallow storms and spells; once revered in the lands of the Albanians." ;
    skos:altLabel "Gudruty-kom", "Gydryty-kom" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Guelphs a rpg:Faction ;
    rpg:name "Guelphs" ;
    dc:description "One of the two factions feuding over Florence since 1216, splitting the city along with the Ghibellines." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:GuestOfTheHouse a rpg:Tag ;
    skos:prefLabel "Guest of the House" ;
    dc:description "A Minor General Virtue making a magus politically a member of House Criamon while built using another House's rules." ;
    rpg:hasTag amol:Virtue .
amol:GuglielmoDePusterla a rpg:Character ;
    rpg:name "Guglielmo de Pusterla" ;
    dc:description "The podesta of Bologna who forbade the Oath of Matriculation, demanding masters swear loyalty to the city rather than to non-city organizations." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:GuildLore a rpg:Proficiency ;
    rpg:name "Guild Lore" ;
    dc:description "An Organization Lore Ability covering the rules and bylaws of a guild, required at increasing scores for journeymen, masters, senior masters, and deans." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:GuildOfWatermen a rpg:Faction ;
    rpg:name "Guild of Watermen" ;
    dc:description "A particularly powerful guild in large cities lacking sufficient bridges, such as Paris and Venice; watermen ship goods and passengers along rivers, coasts, and fords." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Gunhilda a rpg:Character ;
    rpg:name "Gunhilda" ;
    dc:description "A member of the covenfolk of Oculus Septentrionalis whose elder sister Matilda serves as autocrat and Henri's housekeeper." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:GunhildaHenrasdottir a rpg:Character ;
    rpg:name "Gunhilda Henrasdottir" ;
    dc:description "A Follower of Jerbiton (age 31), daughter and filia of Henri de Tours, a young maga specializing in housecraft who is married to Estrid." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Gunter a rpg:Character ;
    rpg:name "Gunter" ;
    dc:description "Klaus's apprentice in the worked example, a storyguide character with Strength +1 and Swordsmith 3 who is trained over the course of the example." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:GuySonOfPerceval a rpg:Character ;
    rpg:name "Guy (son of Perceval)" ;
    dc:description "The ten-year-old eldest child of the Redcap Perceval and Lucy." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Gwawrieir a rpg:Character ;
    rpg:name "Gwawrieir" ;
    dc:description "The eldest swynwraig and effective leader of the Columbae who opposed joining Pralix; found strangled within her own protective circle while wearing the enchanted robes that became the Robes of Dusty Dawn." ;
    skos:altLabel "Gwawrier" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:GwennTheWhiteMantle a rpg:Item ;
    rpg:name "Gwenn (the white mantle)" ;
    dc:description "King Arthur's white mantle in the Dream of Rhonabwy; anyone wrapped in it can see everyone while remaining invisible." ;
    skos:altLabel "Gwenn", "the white mantle" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:Gwenwynwyn a rpg:Character ;
    rpg:name "Gwenwynwyn" ;
    dc:description "A persistent Welsh foe of Llywelyn, lord of Powys who repeatedly switched allegiance between Llywelyn and King John." ;
    skos:altLabel "Gwenwynwyn of Powys" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Gwydyon a rpg:Character ;
    rpg:name "Gwydyon" ;
    dc:description "The librarian and autocrat of Cad Gadu, a large, resigned man in his fifties who keeps the neglected library from outright ruin." ;
    skos:altLabel "Gwydyon the librarian" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Gwyndolen a rpg:Character ;
    rpg:name "Gwyndolen" ;
    dc:description "The wife of Colomen who, with him, adapted the Columbae's ward-powers to Hermetic magic and spread their ward-spells through the Order." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Gwynedd a schema:Place ;
    rpg:name "Gwynedd" ;
    dc:description "An ancient Welsh principality in the north, centered on the fort of Aberffro; ruled by Llywelyn the Great." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:GwynnAbNudd a rpg:Character ;
    rpg:name "Gwynn ab Nudd" ;
    dc:description "The king of the faeries and of Annwfn, who dwells in a faerie castle on Glastonbury Tor; St. Collen banished him and his castle with holy water." ;
    skos:altLabel "Gwynn" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:GydrytyKomTheGiant a rpg:Creature ;
    rpg:name "Gydryty-kom the Giant" ;
    dc:description "A Magic-realm Auram giant of Might 40 in the bestiary." ;
    skos:altLabel "Gydryty-kom" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Gymir a rpg:Creature ;
    rpg:name "Gymir" ;
    dc:description "A powerful demon whose earthly fief is Scandinavia, warring against Radegast and against the Dominion's incursion into the Northlands; he uses natural catastrophes, the Norse people, and the corrupted Holy Vehm as weapons." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:GyNgy a rpg:Character ;
    rpg:name "Gyöngy" ;
    dc:description "A sorceress who never joined the Order but whose magpie-heartbeast descendants founded the Sept of Gyöngy during the Schism War." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:HachimAlKhalejj a rpg:Character ;
    rpg:name "Hachim al'Khalejj" ;
    dc:description "A quiet Muslim magus of House Criamon at Waddenzee (age 36), filius of Hassan of Fengheld, whose knowledge of astrology aids the pirates' raids." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Hagen a rpg:Character ;
    rpg:name "Hagen" ;
    dc:description "Gunther's powerful and treacherous vassal in the Nibelungenlied who murders Siegfried, steals and sinks the Nibelung treasure, and is finally decapitated by Kriemhild." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Halfgrim a rpg:Character ;
    rpg:name "Halfgrim" ;
    dc:description "An example grog who suffers Light and Medium wounds in combat and is treated with First Aid and Palliative Care at a covenant." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Hallucinations a rpg:Tag ;
    skos:prefLabel "Hallucinations" ;
    dc:description "A Minor General Flaw in which the character is afflicted by vivid hallucinations that seem like true visions but are figments of imagination." ;
    rpg:hasTag amol:Flaw .
amol:Hamburg a schema:Place ;
    rpg:name "Hamburg" ;
    dc:description "A Free Imperial City and trading port on the River Elbe with a violent history of Viking and Wendish raids, occupied by Valdemar II in 1216; once home to St. Ansgar before the see moved to Bremen." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Hans a rpg:Character ;
    rpg:name "Hans" ;
    dc:description "Klaus's journeyman employee in the worked example, a storyguide character with Strength +2 and Swordsmith 5." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:HardnessOfAdamantine a rpg:Spell ;
    rpg:name "Hardness of Adamantine" ;
    dc:description "A MuTe 25 spell that instills a metal object with supernatural hardness, making it nearly unbreakable and boosting armor Protection by +2 or weapon damage by +1." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Harmony a rpg:Tag ;
    skos:prefLabel "Harmony" ;
    dc:description "In Criamon cosmology, the force that attracts and promotes cohesion; one of the two great forces of the universe, reflected by the Art of Creo." ;
    rpg:hasTag amol:HermeticConcept .
amol:HarnessedMagic a rpg:Tag ;
    skos:prefLabel "Harnessed Magic" ;
    dc:description "A Minor, Hermetic Virtue giving great control over one's spells, allowing the magus to cancel his own spells and magic items by concentrating." ;
    rpg:hasTag amol:Virtue .
amol:Harold a rpg:Character ;
    rpg:name "Harold" ;
    dc:description "An example character who knows Performance Magic (Hunt) and casts Hunter's Tracks of the Faerie Glow while hunting." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:HaroldSVengeance a rpg:Faction ;
    rpg:name "Harold's Vengeance" ;
    dc:description "A covenant founded in 1066 in the East Anglian fens by Saxon magi seeking to drive William the Conqueror from England; Marched and destroyed by 1068 for repeated Code violations." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:Harut a rpg:Creature ;
    rpg:name "Harut" ;
    dc:description "One of two fallen angels who, per the Qur'an, taught sihr (magic) to mankind to tempt them from Islam." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:HassanElMegrayhi a rpg:Character ;
    rpg:name "Hassan El-Megrayhi" ;
    dc:description "A master of Fengheld of House Criamon who maintains a lone tower (Turris Acontiarum) in the Kyffhauser Mountains studying the stars with a single mute companion." ;
    skos:altLabel "Hassan El-Megrayhi of Criamon" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:HassanOfFengheld a rpg:Character ;
    rpg:name "Hassan of Fengheld" ;
    dc:description "A magus of Fengheld who is the Hermetic parens of Hachim al'Khalejj of Waddenzee." ;
    skos:altLabel "Hassan" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Hatred a rpg:Tag ;
    skos:prefLabel "Hatred" ;
    dc:description "A Major or Minor Personality Flaw in which the character hates someone or some group so much that hurting them dominates his life." ;
    rpg:hasTag amol:Flaw .
amol:HatredForSeekers a rpg:Tag ;
    skos:prefLabel "Hatred for Seekers" ;
    dc:description "A Minor Ordeal Flaw from the Bind Curse Initiation, a burning loathing for other magi not of the House who seek Hephaestus-made items." ;
    rpg:hasTag amol:Flaw .
amol:HauberkOfSublimeLightness a rpg:Spell ;
    rpg:name "Hauberk of Sublime Lightness" ;
    dc:description "A PeTe 30 spell that renders a suit of metal armor nearly weightless, reducing its Load while leaving its bulk unchanged." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:HauntOfTheLivingGhost a rpg:Spell ;
    rpg:name "Haunt of the Living Ghost" ;
    dc:description "A Creo Imaginem spell (Level 35) with an Intellego requisite that projects the caster's image and voice to a place to which they have an Arcane Connection, often used to attend inter-covenant councils remotely." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Haunted a rpg:Tag ;
    skos:prefLabel "Haunted" ;
    dc:description "A Minor laboratory Supernatural Flaw: the lab is home to a haunting spirit that occasionally disturbs the owner (+1 Warping, -1 Aesthetics, +2 Mentem)." ;
    rpg:hasTag amol:Flaw .
amol:HearingTheSilentChorus a rpg:Spell ;
    rpg:name "Hearing the Silent Chorus" ;
    dc:description "An Intellego Imaginem 15 spell invented by academic magi that lets the recipient barely hear the unheard sounds of planetary orbits (musica mundana), granting a bonus to astrology or song composition." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:HeartOfTheLion a rpg:Spell ;
    rpg:name "Heart of the Lion" ;
    dc:description "A CrMe 15 spell that instills indomitable courage, raising the target's Brave Personality Trait by +3, sometimes leading to recklessness." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:HeartbeastTemperament a rpg:Tag ;
    skos:prefLabel "Heartbeast Temperament" ;
    dc:description "The classification of heartbeasts into four classical temperaments (sanguine, choleric, melancholic, phlegmatic), which may be pure or aspected." ;
    skos:altLabel "choleric", "melancholic", "phlegmatic", "sanguine" ;
    rpg:hasTag amol:HermeticConcept .
amol:Hecate a rpg:Character ;
    rpg:name "Hecate" ;
    dc:description "A powerful faerie goddess who once saved Byzantium from Phillip of Macedon and lives in a regio coincident with Constantinople, entered only via a ritual path lit by a crescent moon." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:HeinousArchitecture a rpg:Tag ;
    skos:prefLabel "Heinous Architecture" ;
    dc:description "A Minor laboratory Structure Flaw: the chamber is deliberately inauspicious or perverse (-1 General Quality, -2 Safety, +1 Warping, -2 Aesthetics)." ;
    rpg:hasTag amol:Flaw .
amol:HeirsToMerlin a rpg:Faction ;
    rpg:name "Heirs to Merlin" ;
    dc:description "A Hermetic lineage within House Merinita descended from Ambrosius, who practice Charm, Story, and Symbolic Magic and serve as advisors to faerie courts." ;
    skos:altLabel "the Heirs" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Hekate a rpg:Creature ;
    rpg:name "Hekate" ;
    dc:description "A spirit named among the Daimons, the Witch; Tytalus claimed his black dog familiar was a son of Hekate and brother to Kerberos." ;
    skos:altLabel "Hekate the Witch" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Helios a rpg:Creature ;
    rpg:name "Helios" ;
    dc:description "A famous Younger Titan, the Sun, named among the offspring of the Titans." ;
    skos:altLabel "Helios the Sun" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Hellequin a rpg:Creature ;
    rpg:name "Hellequin" ;
    dc:description "A cursed spirit at the center of a mobile regio (Hellequin's Hunt, a host of the dead), tasked with guiding souls unable to reach Heaven onto their resting place." ;
    skos:altLabel "Hellequin's Hunt" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:HelmOfInvisibility a rpg:Item ;
    rpg:name "Helm of Invisibility" ;
    dc:description "A wondrous helmet made by an armorer that makes the wearer invisible (Craft Level 16)." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:Hengest a rpg:Character ;
    rpg:name "Hengest" ;
    dc:description "Leader of the treacherous Saxons who murdered the flower of Britain as they ate, prompting King Aurelius to build a monument." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:HenryIV a rpg:Character ;
    rpg:name "Henry IV" ;
    dc:description "An emperor who died in Liege after excommunication and forced abdication; the bells of Speyer would not toll for him until his excommunication was posthumously revoked." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:HenryMurdac a rpg:Character ;
    rpg:name "Henry Murdac" ;
    dc:description "An abbot sent from France in 1144 to bring Fountains Abbey into line with Cistercian practice, later contentiously elected archbishop of York, after which a mob sacked and burned Fountains." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:HenryV a rpg:Character ;
    rpg:name "Henry V" ;
    dc:description "An emperor who deposed his father Henry IV, later sought his posthumous absolution, and was tormented on his deathbed by his betrayed father's apparition." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:HenryVI a rpg:Character ;
    rpg:name "Henry VI" ;
    dc:description "An emperor who imprisoned Richard the Lionheart at Burg Trifels in 1193." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:HenryFitzAilwyn a rpg:Character ;
    rpg:name "Henry fitz Ailwyn" ;
    dc:description "The first Lord Mayor of London, who served for 23 years from 1193 and oversaw the city's first modern charter in 1204." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:HenryFitzCount a rpg:Character ;
    rpg:name "Henry fitz Count" ;
    dc:description "The son of the old earl of Cornwall and sheriff of that county, who withholds receipts from the treasury and usurps royal prerogative while trying to claim the earldom." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:HenryOfEssex a rpg:Character ;
    rpg:name "Henry of Essex" ;
    dc:description "One of Henry II's constables who deprived St. Edmund of his rights; defeated in a 1163 trial by combat after seeing the vengeful vision of St. Edmund, he became a monk at Reading." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:HenryTheFowler a rpg:Character ;
    rpg:name "Henry the Fowler" ;
    dc:description "Duke of the Saxons who received the German crown in 919 and defeated the Magyar hordes at Riade in 933." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Hera a rpg:Character ;
    rpg:name "Hera" ;
    dc:description "Greek goddess and parthenogenetic mother of Hephaestus, who retrieved him to Olympus and was tortured by Zeus in a mechanized chair." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:HerbalismVirtue a rpg:Tag ;
    skos:prefLabel "Herbalism (Virtue)" ;
    dc:description "A Minor General Virtue granting skill in folk remedies and natural magic via the unique Herbalism Ability, plus 50 experience points and the ability to make theriacs and ligatures." ;
    rpg:hasTag amol:Virtue .
amol:Herculaneum a schema:Place ;
    rpg:name "Herculaneum" ;
    dc:description "Ancient ruins destroyed (with Pompeii) by a volcanic eruption, traditionally used as the strife-saturated investiture site for the Station of Blood and Bronze on the Path of Strife." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Hercules a rpg:Creature ;
    rpg:name "Hercules" ;
    dc:description "A god and hero of legendary strength, identified by the Romans with the Gaulish Ogmios and worshiped as protector of the magical springs at the Sanctuary of Hercules." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Hermann a rpg:Character ;
    rpg:name "Hermann" ;
    dc:description "The chief of the Cheruski, trained in Roman service, who rallied the German tribes and destroyed Varus's legions at the Battle of the Teutoburger Forest in 9 AD." ;
    skos:altLabel "Arminius" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:HermesTrismegistus a rpg:Character ;
    rpg:name "Hermes Trismegistus" ;
    dc:description "The legendary sage to whom magi attribute the maxim 'As above, so below,' cited regarding astrology and the Stone of Death." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:HermeticExperience a rpg:Tag ;
    skos:prefLabel "Hermetic Experience" ;
    dc:description "A Minor, General Virtue for a character with experience among the magi of the Order of Hermes, granting 50 extra experience points for relevant Lore or Latin." ;
    rpg:hasTag amol:Virtue .
amol:HermeticFair a rpg:Tag ;
    skos:prefLabel "Hermetic Fair" ;
    dc:description "A gathering of the Order held in a vast twelve-sided quartz-walled hall in the Alps, supported by impossible ivory trees." ;
    skos:altLabel "Hermetic fairs" ;
    rpg:hasTag amol:HermeticConcept .
amol:HermeticInclination a rpg:Tag ;
    skos:prefLabel "Hermetic Inclination" ;
    dc:description "A maestro Virtue allowing a score in a specific Hermetic Form, used to instill spell-like effects into artwork while creating it." ;
    skos:altLabel "Hermetic Inclination in (Form)", "Hermetic Inclination: Imaginem" ;
    rpg:hasTag amol:Virtue .
amol:HermeticMidSummerFair a rpg:Tag ;
    skos:prefLabel "Hermetic Mid-Summer Fair" ;
    dc:description "A fair held by a covenant in the Tribunal of the Greater Alps each early June, lasting up to eight days, where magi trade vis, books, and enchanted devices; an auction is run by the Quaesitores on the fourth day." ;
    rpg:hasTag amol:HermeticConcept .
amol:HermeticPatron a rpg:Tag ;
    skos:prefLabel "Hermetic Patron" ;
    dc:description "A Minor Story Flaw, available to Redcaps or magi, in which an older magus or established Redcap watches over and aids the character in exchange for service." ;
    rpg:hasTag amol:Flaw .
amol:HermeticSahir a rpg:Faction ;
    rpg:name "Hermetic Sahir" ;
    dc:description "A tradition referenced as the model for relocating the Corrguineach; wizards who command spirits." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:HeroicVirtues a rpg:Tag ;
    skos:prefLabel "Heroic Virtues" ;
    dc:description "A category of Virtues (with associated Flaws) from Houses of Hermes: True Lineages that maestros may also choose." ;
    skos:altLabel "Heroic Virtues and Flaws" ;
    rpg:hasTag amol:Virtue .
amol:HeronOfAlexandria a rpg:Character ;
    rpg:name "Heron of Alexandria" ;
    dc:description "Ancient inventor whose works inspired the wonderful steam-rotator machines powering an Unnatural Law covenant." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:HerritOfTytalus a rpg:Character ;
    rpg:name "Herrit of Tytalus" ;
    dc:description "A young Tytalus magus among the members recruited to Nigrasaxa." ;
    skos:altLabel "Herrit" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:HerrodOfHohenbourg a rpg:Character ;
    rpg:name "Herrod of Hohenbourg" ;
    dc:description "The most famous woman painter of 1220, recently deceased, whose book Hortus deliciarum showcases her illuminations." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Hersfeld a schema:Place ;
    rpg:name "Hersfeld" ;
    dc:description "A town dominated by a large imperial Benedictine abbey, whose springs are known for magical restorative powers." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Hertha a rpg:Creature ;
    rpg:name "Hertha" ;
    dc:description "A powerful faerie goddess who bathes in Hertha Lake each Walpurgis Night, drowning a chosen mortal in return for blessing local farmers with good harvests; served by the priestess Zora." ;
    skos:altLabel "the goddess Hertha" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:HerthaLake a schema:Place ;
    rpg:name "Hertha Lake" ;
    dc:description "A mysterious dark lake in the Stubnitz Forest near Crintera where the goddess Hertha bathes every Walpurgis Night and then drowns a chosen mortal in exchange for good harvests." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Hespera a rpg:Character ;
    rpg:name "Hespera" ;
    dc:description "The namesake of the enchanted lab item The Bookstand of Hespera." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Hexentanzplatz a schema:Place ;
    rpg:name "Hexentanzplatz" ;
    dc:description "A rocky crag in the northeastern Harz with a Faerie aura of 2 where the witches of the Harz gather every April before proceeding to the Brocken." ;
    skos:altLabel "Witches' Dancing Ground" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:HibernationOfTheSlumberingTurb a rpg:Spell ;
    rpg:name "Hibernation of the Slumbering Turb" ;
    dc:description "A ReMe 35 ritual Texture-Target spell, invented by Odorpes, that puts anyone touching the caster to sleep until the Spring Equinox." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:HiddenVirtues a rpg:Tag ;
    skos:prefLabel "Hidden Virtues" ;
    dc:description "Fixed, occult qualities of objects granted by astral influences and ordained by God that cannot be explained by their substance." ;
    skos:altLabel "Occult Virtues", "virtutes occultes" ;
    rpg:hasTag amol:HermeticConcept .
amol:HideToParchment a rpg:Spell ;
    rpg:name "Hide to Parchment" ;
    dc:description "A Rego Animal 10 spell that stretches, shaves, and dries animal hides into writing-ready vellum as if a percamenarius had worked them." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:HidingInTheCrowd a rpg:Spell ;
    rpg:name "Hiding in the Crowd" ;
    dc:description "A PeIm 10 transparency spell that makes the caster selectively invisible to a single person by destroying a thin cone of emitted species, useful in city crowds." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Hiems a rpg:Faction ;
    rpg:name "Hiems" ;
    dc:description "A Winter covenant of medium power, declined to six magi, occupying a largely uninhabited complex of caves, tunnels, and towers in a magical forest now haunted by a returned dragon." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:HighCrimes a rpg:Tag ;
    skos:prefLabel "High Crimes" ;
    dc:description "Serious Hermetic charges that the pirates of Waddenzee would face if the mundane authorities moved against them with no Tribunal support." ;
    rpg:hasTag amol:HermeticConcept .
amol:HighlyCognizant a rpg:Tag ;
    skos:prefLabel "Highly Cognizant" ;
    dc:description "A Virtue held by the most dangerous faeries, allowing them to adapt and change their roles to feed on human emotional energy." ;
    rpg:hasTag amol:Virtue .
amol:Hilda a rpg:Character ;
    rpg:name "Hilda" ;
    dc:description "An immense female covenant grog (custos) born and bred at Fengheld, a skilled mace-and-shield warrior with Great Strength and prime leadership material, given as a gift to young magi." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Hildebrand a rpg:Character ;
    rpg:name "Hildebrand" ;
    dc:description "Dietrich of Bern's man-at-arms who kills Kriemhild after discovering the bodies of Gunther and Hagen." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:HinderTheGift a rpg:Spell ;
    rpg:name "Hinder the Gift" ;
    dc:description "A Perdo Vim 55 enchanted effect in the Wizard's Bridle that reduces the Casting Total of any spells by 25 points as a constant effect." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Hippian a rpg:Tag ;
    skos:prefLabel "Hippian" ;
    dc:description "One of the two ethical viewpoints of House Tytalus's Philosophy of Conflict, represented by anticlockwise spiral symbolism indicating introspection." ;
    skos:altLabel "Hippian ethical viewpoint" ;
    rpg:hasTag amol:HermeticConcept .
amol:HippianEthics a rpg:Tag ;
    skos:prefLabel "Hippian Ethics" ;
    dc:description "A branch of Tytalan philosophy named after the Sophist Hippias that holds some unwritten divine laws are intrinsic to nature and necessary curbs on selfish physis; symbolized by an anticlockwise spiral." ;
    skos:altLabel "Hippian view", "Hippians" ;
    rpg:hasTag amol:HermeticConcept .
amol:Hippias a rpg:Character ;
    rpg:name "Hippias" ;
    dc:description "A Sophist quoted in the Analects of Tytalus who believed in the fundamental unity of mankind through unwritten laws of divine provenance; the Hippian view is named after him." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Hirsau a schema:Place ;
    rpg:name "Hirsau" ;
    dc:description "The most powerful Benedictine monastery in Germany, founded 1059 with the relics of St. Aurelius and modeled on Cluny; with a Divine aura of 5, it has been immune to the faerie attacks beset other Black Forest monasteries." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Holstein a schema:Place ;
    rpg:name "Holstein" ;
    dc:description "A territory between the North Sea and Baltic under the control of the Danish king Valdemar II, where new port towns are springing up." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:HolyLand a schema:Place ;
    rpg:name "Holy Land" ;
    dc:description "The region of the Crusades where Saracen wizards practice and some Flambeau magi fight non-Hermetic wizards." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:HolySepulcher a schema:Place ;
    rpg:name "Holy Sepulcher" ;
    dc:description "The place where Christ was buried, an example of a site with a Divine aura of 10 arising where God directly intervened." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:HomingInstinct a rpg:Tag ;
    skos:prefLabel "Homing Instinct" ;
    dc:description "A Minor, Supernatural Virtue letting a character always know the way to a number of known locations and have fixed Arcane Connections to them." ;
    rpg:hasTag amol:Virtue .
amol:Homobonus a rpg:Character ;
    rpg:name "Homobonus" ;
    dc:description "A patron saint of merchants and of cloth and tailoring; a citizen of Cremona who died in 1197 and was canonized in 1199." ;
    skos:altLabel "St. Homobonus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Hooks a rpg:Tag ;
    skos:prefLabel "Hooks" ;
    dc:description "Features of a covenant that lead to stories and provide points to spend on Boons; come in Major, Minor, and Unknown forms." ;
    skos:altLabel "Hook" ;
    rpg:hasTag amol:HermeticConcept .
amol:HornOfTheChampions a rpg:Item ;
    rpg:name "Horn of the Champions" ;
    dc:description "An invested magical horn kept at Castra Solis that can alert and instantly summon senior Flambeau magi from anywhere in Mythic Europe via Arcane Connections." ;
    skos:altLabel "Horn of Champions" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:HornetFire a rpg:Spell ;
    rpg:name "Hornet Fire" ;
    dc:description "A Muto Ignem spell (Level 10) with a Rego requisite that turns a fire into a swarm of insect-sized fireballs that harass a target, imposing a penalty and extra botch dice without dealing real damage." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:HorridWilting a rpg:Spell ;
    rpg:name "Horrid Wilting" ;
    dc:description "A Herbam power of the basilisk Sordus that kills every living plant within 5 paces and rots vegetable matter; he cannot control it." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:HorrifyingAppearance a rpg:Tag ;
    skos:prefLabel "Horrifying Appearance" ;
    dc:description "A Major Supernatural Flaw for corrupted beasts making the creature hideously deformed and unable to pass as a member of its original species." ;
    rpg:hasTag amol:Flaw .
amol:HorrifyingAppearanceSnakeLegs a rpg:Tag ;
    skos:prefLabel "Horrifying Appearance – Snake Legs" ;
    dc:description "A Major Supernatural Flaw in which the character has snake-like tails instead of legs, a deformity that can be hidden under clothing but not while moving." ;
    rpg:hasTag amol:Flaw .
amol:HospitallerKnightsOfStJohn a rpg:Faction ;
    rpg:name "Hospitaller Knights of St. John" ;
    dc:description "A military order present in Acre that controls its own section of the city." ;
    skos:altLabel "Hospitaller Knights" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:HosvirGoatlegs a rpg:Character ;
    rpg:name "Hosvir Goatlegs" ;
    dc:description "A Clan Wilkis magus of the Sept of Orn obsessed with rebelling against the Norman nobility of England; trained Ealwynn and Coenwulf." ;
    skos:altLabel "Hosvir", "Hosvir Goatlegs filius Orn" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:HoundsOfAnwyn a rpg:Creature ;
    rpg:name "Hounds of Anwyn" ;
    dc:description "Faerie hounds said to leave the faerie court to chase the dead across Wales by night." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:HouseCriamonLore a rpg:Proficiency ;
    rpg:name "House Criamon Lore" ;
    dc:description "An Ability quantifying a magus's understanding of House Criamon's task, strategy, paths, stations, and clutches; required at increasing scores to reach higher stations." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:HouseMerinitaLore a rpg:Proficiency ;
    rpg:name "House Merinita Lore" ;
    dc:description "The Ability Merinitae use to Initiate their House Mysteries, representing knowledge of all the House's secret rites, mysteries, and legends; common to all members." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:HouseMysteries a rpg:Tag ;
    skos:prefLabel "House Mysteries" ;
    dc:description "The Bjornaer Mysteries (Heartbeast, Secret Name, Sensory Magic, Theriomorphy) Initiated by Clan Ilfetu that allow magi to emulate their ancestors." ;
    rpg:hasTag amol:HermeticConcept .
amol:HouseTytalusLore a rpg:Proficiency ;
    rpg:name "House Tytalus Lore" ;
    dc:description "A Hermetic lore Ability concerning the history and customs of House Tytalus, exemplified by the Analects of Tytalus summa." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:HouseOfFlambeau a rpg:Faction ;
    rpg:name "House of Flambeau" ;
    dc:description "(Not present)" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:HermeticHouse .
amol:HouseOfWisdom a schema:Place ;
    rpg:name "House of Wisdom" ;
    dc:description "The most famous madrasah, in Baghdad, a center for translating Syriac, Persian, and Greek texts into Arabic; historically destroyed by Mongols in 1258." ;
    skos:altLabel "Bayt al-Hikma" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:HousesOfHermes a rpg:Tag ;
    skos:prefLabel "Houses of Hermes" ;
    dc:description "The twelve Houses that organize the Order of Hermes, now split into three groups of four: Mystery Cults, True Lineages, and Societates. They remain the same Houses as in earlier editions." ;
    skos:altLabel "Houses", "the twelve Houses of Hermes" ;
    rpg:hasTag amol:HermeticConcept .
amol:Hovel a rpg:Tag ;
    skos:prefLabel "Hovel" ;
    dc:description "A Major laboratory Outfittings Flaw: the lab is cramped, neglected, and filthy, little more than a stinking dump (-1 General Quality, -2 Upkeep, -2 Safety, -3 Health, -4 Aesthetics)." ;
    rpg:hasTag amol:Flaw .
amol:Hrools a rpg:Creature ;
    rpg:name "Hrools" ;
    dc:description "Intelligent ferret-like creatures dwelling in warrens near the ruined Calebais laboratory of Ierimyra, who still protect the lab." ;
    skos:altLabel "hrool" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Hrothgar a rpg:Character ;
    rpg:name "Hrothgar" ;
    dc:description "Former king of the Danes whose hall site is now occupied by the covenant Heorot; he was terrorized by the troll Grendel until the hero Beowulf slew it." ;
    skos:altLabel "King Hrothgar" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Huarwar a rpg:Creature ;
    rpg:name "Huarwar" ;
    dc:description "A Welsh faerie who helped complete Offa's Dyke in 787 in exchange for cattle; now eats parts of the dyke and villages when not paid." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:HughFoliot a rpg:Character ;
    rpg:name "Hugh Foliot" ;
    dc:description "The archdeacon of Shropshire who became bishop of Hereford in 1219 and was an employer of Robert Grosseteste." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:HughDeLusignan a rpg:Character ;
    rpg:name "Hugh de Lusignan" ;
    dc:description "The count of Marche, a powerful vassal of the king in Poitou and husband of Queen Isabella." ;
    skos:altLabel "count of Marche" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:HughOfLincoln a rpg:Character ;
    rpg:name "Hugh of Lincoln" ;
    dc:description "A former bishop of Lincoln who began the rebuilding of the minster in 1192 and is being considered for canonization; associated with the miracle of St. Hugh's Swan at Stow." ;
    skos:altLabel "Bishop Hugh", "St. Hugh" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:HumanFigmentOfTheWakingMind a rpg:Spell ;
    rpg:name "Human Figment of the Waking Mind" ;
    dc:description "A Creo Mentem spell that places a hallucinatory person, seen and heard only by the target, into the target's common sense." ;
    skos:altLabel "CrMe 25" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Humble a rpg:Tag ;
    skos:prefLabel "Humble" ;
    dc:description "A Minor Personality Flaw in which the character always believes others are more skilled and better than himself." ;
    rpg:hasTag amol:Flaw .
amol:Humnel a rpg:Creature ;
    rpg:name "Humnel" ;
    dc:description "Glesig's faerie caricature, which has taken the seeming of an immense troll and become her faerie familiar, very protective of his mistress." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:HungerForFormMagic a rpg:Tag ;
    skos:prefLabel "Hunger for (Form) Magic" ;
    dc:description "A Major Supernatural Flaw in which the character has become dependent on consuming 1 pawn of vis of a particular Form each season or lose Fatigue Levels." ;
    rpg:hasTag amol:Flaw .
amol:HunterSSense a rpg:Spell ;
    rpg:name "Hunter's Sense" ;
    dc:description "An Intellego Animal spell (Level 30) letting the caster sense the shapes and primary motivations of all animals above a chosen size that can be heard." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:HuntressInTheWoodLore a rpg:Proficiency ;
    rpg:name "Huntress in the Wood Lore" ;
    dc:description "The Ability required to Initiate the grades of the Huntress in the Wood cult, with set thresholds for advancing from kerykes to eumolpids." ;
    skos:altLabel "Huntress Lore" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:Hydra a rpg:Creature ;
    rpg:name "Hydra" ;
    dc:description "A many-headed monster whose teeth provide Shape and Material bonuses of +6 Creo and +8 regeneration." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Hypernestoria a schema:Place ;
    rpg:name "Hypernestoria" ;
    dc:description "Mysterious lands reached via the regio where the Axis Magica emerges from the other side of the Earth's sphere, few of whose contents are known to Criamon magi." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:HywelDda a rpg:Character ;
    rpg:name "Hywel Dda" ;
    dc:description "The legendary lawgiver who created the laws of Wales many centuries ago, laws still known by wise men across Wales." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:HLlental a schema:Place ;
    rpg:name "Höllental" ;
    dc:description "A tortuous and haunted valley winding up from the center of the Black Forest, the only route to the Feldberg and the King of the Black Mountain." ;
    skos:altLabel "Hell Valley" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:IbnWahshiya a rpg:Character ;
    rpg:name "Ibn Wahshiya" ;
    dc:description "Author of The Book of Poisons, quoted for a recipe combining mouse, hellebore and other ingredients to make a fatal poison." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:IceCavern a rpg:Tag ;
    skos:prefLabel "Ice Cavern" ;
    dc:description "A Free laboratory Supernatural Virtue: the lab is built of never-melting ice in the far north or atop a mountain (+1 Upkeep, +1 Warping, +2 Aesthetics, +2 Rego or Terram)." ;
    rpg:hasTag amol:Virtue .
amol:IceOfDrowning a rpg:Spell ;
    rpg:name "Ice of Drowning" ;
    dc:description "A Rego Aquam spell (Level 35) that turns part of a body of water into jagged ice chunks that pound against anything on the surface, damaging swimmers and small boats." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:IddawgSonOfMynyo a rpg:Character ;
    rpg:name "Iddawg son of Mynyo" ;
    dc:description "A horseman who captured Rhonabwy and led him across the sea to King Arthur's court in the dream." ;
    skos:altLabel "Iddawg" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Idris a rpg:Creature ;
    rpg:name "Idris" ;
    dc:description "A powerful faerie giant who controls all the land around the Welsh mountain that bears his name, able to call mist and ruin crops, with fox servants." ;
    skos:altLabel "giant Idris" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:IdyllicSurroundings a rpg:Tag ;
    skos:prefLabel "Idyllic Surroundings" ;
    dc:description "A Free laboratory Structure Virtue: the lab sits in a charming peaceful location such as a vale or garden (+2 Health, +1 Aesthetics)." ;
    rpg:hasTag amol:Virtue .
amol:Ierimyra a rpg:Character ;
    rpg:name "Ierimyra" ;
    dc:description "A maga of the former covenant of Calebais whose ruined laboratory remains haunted by her ghost." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Ignatio a rpg:Character ;
    rpg:name "Ignatio" ;
    dc:description "A grog used in combat examples, fighting with a shortsword and round shield, who defeats the Infernal wolf Polandrus and later fights his faerie duplicate." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Ilfetu a rpg:Character ;
    rpg:name "Ilfetu" ;
    dc:description "One of Birna's six apprentices, told to 'Teach,' a swan from ancient Frisia, the only one to learn the Ritual of Twelve Years from Birna; founder of Clan Ilfetu." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Ilium a schema:Place ;
    rpg:name "Ilium" ;
    dc:description "A port town on the Aegean coast south of Constantinople, located in a faerie regio enterable only by ships with faerie pilots, ruled by the faerie lord Priam who claims descent from Zeus; possibly the legendary Troy or a faerie imitation." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:ImageFromTheWizardTorn a rpg:Spell ;
    rpg:name "Image from the Wizard Torn" ;
    dc:description "A Rego Imaginem spell (Level 35) with an Intellego requisite that separates the caster's image from their body so it can speak and be seen through, leaving the caster invisible and silent." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ImaginedFolkTraditionVulnerability a rpg:Tag ;
    skos:prefLabel "Imagined Folk Tradition Vulnerability" ;
    dc:description "A Minor Personality Flaw in which the character sincerely believes he is vulnerable to traditional wards and folk magic like the fey, and sabotages such wards." ;
    rpg:hasTag amol:Flaw .
amol:Imanitosi a rpg:Character ;
    rpg:name "Imanitosi" ;
    dc:description "Prima of House Verditius who succumbed to Final Twilight in September 1219 while experimenting in her laboratory." ;
    skos:altLabel "Prima Imanitosi" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:ImbuedWithTheSpiritOfForm a rpg:Tag ;
    skos:prefLabel "Imbued with the Spirit of (Form)" ;
    dc:description "A Minor, Hermetic Virtue letting a magus who absorbed an elemental's powers substitute Long-Term Fatigue for vis of the chosen Form." ;
    rpg:hasTag amol:Virtue .
amol:ImmortalityOfTheForest a rpg:Tag ;
    skos:prefLabel "Immortality of the Forest" ;
    dc:description "A new Major General Virtue linking one's life force to a forest, so that while remaining within its supernatural aura one makes no Aging roll but gains a Warping Point each year." ;
    rpg:hasTag amol:Virtue .
amol:Immortals a rpg:Creature ;
    rpg:name "Immortals" ;
    dc:description "In House Criamon's cosmology, a perfect race of spiritual beings that fell into the material world; magi (or all people) are reincarnated immortals." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:ImmuneToDisease a rpg:Tag ;
    skos:prefLabel "Immune to Disease" ;
    dc:description "A Major, Supernatural, Tainted Virtue marking a character as a powerful demon's property so lesser disease demons refuse to harm him." ;
    rpg:hasTag amol:Virtue .
amol:Immunity a rpg:Tag ;
    skos:prefLabel "Immunity" ;
    dc:description "A Virtue rendering people and objects within a covenant's aura immune to a specified form of damage, influence, or Flaw." ;
    rpg:hasTag amol:Virtue .
amol:ImmunityToCold a rpg:Tag ;
    skos:prefLabel "Immunity to Cold" ;
    dc:description "A Minor, Supernatural Virtue making normal cold harmless to the character, though extreme magical cold still affects him." ;
    rpg:hasTag amol:Virtue .
amol:ImpiousFriend a rpg:Tag ;
    skos:prefLabel "Impious Friend" ;
    dc:description "A Minor Story Tainted Flaw in which a minor demon poses as a friend of the character to guide him toward a tragic destiny." ;
    rpg:hasTag amol:Flaw .
amol:Impregnable a rpg:Tag ;
    skos:prefLabel "Impregnable" ;
    dc:description "A Minor laboratory Supernatural Flaw: the lab is completely inaccessible except through powerful magic, e.g. requiring a Muto Terram spell (-2 Aesthetics)." ;
    rpg:hasTag amol:Flaw .
amol:InChristSFootsteps a rpg:Spell ;
    rpg:name "In Christ's Footsteps" ;
    dc:description "A Rego Corpus spell (ReCo 5) created by Falke that allows the caster to walk on water." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:IncantationOfPutridWine a rpg:Spell ;
    rpg:name "Incantation of Putrid Wine" ;
    dc:description "A Muto Aquam spell (Level 15) that makes all liquids within a target room vile and malodorous for weeks or months." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:IncantationOfSummoningTheDead a rpg:Spell ;
    rpg:name "Incantation of Summoning the Dead" ;
    dc:description "A ritual Rego Mentem spell that calls up a person's ghost, requiring the place of death, the corpse, or knowledge of the ghost's full name." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:IncantationOfTheBodyMadeWhole a rpg:Spell ;
    rpg:name "Incantation of the Body Made Whole" ;
    dc:description "A Creo Corpus ritual (Level 40) that heals all wounds to a human body, but not missing limbs, diseases, or poison damage." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:IncendiorHomines a rpg:Item ;
    rpg:name "Incendior Homines" ;
    dc:description "A Creo Ignem 30 enchanted weapon (wand, ring, or brooch) providing heavy firepower that envelops a target in flame for +15 damage with +8 Penetration, usable by unskilled grogs." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:Incognizant a rpg:Tag ;
    skos:prefLabel "Incognizant" ;
    dc:description "A faerie trait indicating it does not even know it is a faerie, following its role because it has no potential to understand any other option." ;
    rpg:hasTag amol:Flaw .
amol:IncreasedHubris a rpg:Tag ;
    skos:prefLabel "Increased Hubris" ;
    dc:description "A Minor Ordeal Flaw making a Verditius magus more proud and self-centered, granting experience to increase his Hubris score by one level." ;
    rpg:hasTag amol:Flaw .
amol:IndependentCraftsman a rpg:Tag ;
    skos:prefLabel "Independent Craftsman" ;
    dc:description "A Minor General Flaw in which the character works poorly with others, treating his Leadership and Craft or Profession Abilities as three levels lower when collaborating." ;
    rpg:hasTag amol:Flaw .
amol:IndescribableFace a rpg:Tag ;
    skos:prefLabel "Indescribable Face" ;
    dc:description "A Minor, General Virtue making a character hard to describe and separate from others, either by being unremarkable or by a distracting striking feature." ;
    rpg:hasTag amol:Virtue .
amol:Indiscreet a rpg:Tag ;
    skos:prefLabel "Indiscreet" ;
    dc:description "A Major Story Flaw in which the character is unable to keep a secret, compelled to tell all unless he succeeds on an Intelligence-based stress roll." ;
    rpg:hasTag amol:Flaw .
amol:Ineslemen a rpg:Tag ;
    skos:prefLabel "Ineslemen" ;
    dc:description "A Minor, Social Status Virtue for a member of one of the religious tribes of the Tuareg, with authority over disputes and immunity from feudal demands; exists only in North Africa." ;
    rpg:hasTag amol:Virtue .
amol:InexhaustibleSupplies a rpg:Tag ;
    skos:prefLabel "Inexhaustible Supplies" ;
    dc:description "A Free laboratory Supernatural Virtue: the lab is blessed with magically replenishing ingredients that never run out (-3 Upkeep, +1 Warping)." ;
    rpg:hasTag amol:Virtue .
amol:InfamousMaster a rpg:Tag ;
    skos:prefLabel "Infamous Master" ;
    dc:description "A Minor Hermetic Flaw in which the character's master was a diabolist or fool, causing other magi to treat the character with contempt." ;
    rpg:hasTag amol:Flaw .
amol:InferiorEquipment a rpg:Tag ;
    skos:prefLabel "Inferior Equipment" ;
    dc:description "A Free laboratory Outfittings Flaw: the lab is outfitted with shoddy wares (-1 General Quality, -1 Upkeep)." ;
    rpg:hasTag amol:Flaw .
amol:InferiorTools a rpg:Tag ;
    skos:prefLabel "Inferior Tools" ;
    dc:description "A Free laboratory Outfittings Flaw: the lab's tools are crudely crafted and prone to breakage (-1 Upkeep, -1 Safety)." ;
    rpg:hasTag amol:Flaw .
amol:InfernalHeirloom a rpg:Tag ;
    skos:prefLabel "Infernal Heirloom" ;
    dc:description "A Minor, Supernatural, Tainted Virtue giving the character a magical item inherited from a diabolist, useful but drawing its owner toward a demon." ;
    rpg:hasTag amol:Virtue .
amol:InfernalSmokeOfDeath a rpg:Spell ;
    rpg:name "Infernal Smoke of Death" ;
    dc:description "A Muto Auram spell (Level 40) that turns fire smoke into a thick corrosive cloud inflicting +25 corrosion damage to anyone immersed in it." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Infested a rpg:Tag ;
    skos:prefLabel "Infested" ;
    dc:description "A Free laboratory Outfittings Flaw: the lab has an animal or plant infestation, e.g. mice, a vine, or fungi (-1 Safety, -1 Aesthetics, +1 Animal or Herbam)." ;
    rpg:hasTag amol:Flaw .
amol:Inhabitants a rpg:Tag ;
    skos:prefLabel "Inhabitants" ;
    dc:description "A Minor laboratory Supernatural Flaw: the lab is shared with other creatures who consider it their home (-1 Safety, -1 Aesthetics)." ;
    rpg:hasTag amol:Flaw .
amol:InitiationOrdeal a rpg:Tag ;
    skos:prefLabel "Initiation Ordeal" ;
    dc:description "A price of Initiation involving acquiring a Flaw, losing a Virtue, or increasing a Minor Flaw to Major, reducing future Initiation Target Levels." ;
    skos:altLabel "Ordeal" ;
    rpg:hasTag amol:HermeticConcept .
amol:InitiationQuest a rpg:Tag ;
    skos:prefLabel "Initiation Quest" ;
    dc:description "A component of an Initiation Script consisting of a lengthy journey with a series of challenges." ;
    skos:altLabel "Quest" ;
    rpg:hasTag amol:HermeticConcept .
amol:InitiationSacrifice a rpg:Tag ;
    skos:prefLabel "Initiation Sacrifice" ;
    dc:description "A component of an Initiation Script in which the Initiate gives up time, wealth, knowledge, or power." ;
    skos:altLabel "Sacrifice" ;
    rpg:hasTag amol:HermeticConcept .
amol:InkOfNoblestMetals a rpg:Spell ;
    rpg:name "Ink of Noblest Metals" ;
    dc:description "A Muto Terram 20 spell with Aquam requisite that transforms gold into a liquid applied as ink, reverting to solid metal when it expires." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:InmostCompanion a rpg:Spell ;
    rpg:name "Inmost Companion" ;
    dc:description "A Muto Mentem spell (Level 40) with an Animal requisite that makes the target's mind physical as a bird; if the bird is killed the target dies, as their mind has been killed." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:InnerMysteriesOfHouseBjornaer a rpg:Tag ;
    skos:prefLabel "Inner Mysteries of House Bjornaer" ;
    dc:description "Mysteries by which a Bjornaer magus, through atavism, gains an inner heartbeast (epitome, chimera, or anima) modeled on a Great Beast ancestor." ;
    skos:altLabel "Inner Mysteries", "Mysteries of the Inner Heartbeast" ;
    rpg:hasTag amol:HermeticConcept .
amol:Insatella a rpg:Character ;
    rpg:name "Insatella" ;
    dc:description "The Prima of House Mercere, an unGifted Redcap who inherited the role from her father and manages the House from Harco in the Roman Tribunal." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:InscriptionOnTheSoul a rpg:Tag ;
    skos:prefLabel "Inscription on the Soul" ;
    dc:description "A Minor Virtue allowing a magus to craft his own body into a talisman via tattoos, learned mainly by Criamon magi of the Path of the Body." ;
    rpg:hasTag amol:Virtue .
amol:InstantLoyaltyOfTheRebelliousTurb a rpg:Spell ;
    rpg:name "Instant Loyalty of the Rebellious Turb" ;
    dc:description "A CrMe 50 ritual cast at a midwinter gathering that grants up to 100 people a 'Loyal to Covenant' score of +4 while inflicting Warping Points each year." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:IntuitionOfTheForest a rpg:Spell ;
    rpg:name "Intuition of the Forest" ;
    dc:description "An Intellego Herbam spell (Level 10) giving an intuitive sense of how to get along in a forest, granting +3 to nature-oriented rolls there." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Invisible a rpg:Tag ;
    skos:prefLabel "Invisible" ;
    dc:description "A Free laboratory Supernatural Virtue: the lab interior and outfittings are invisible, requiring magical means to see them (+1 Warping, halve Aesthetics, +2 Imaginem)." ;
    rpg:hasTag amol:Virtue .
amol:InvocationMagic a rpg:Tag ;
    skos:prefLabel "Invocation Magic" ;
    dc:description "A Mystery Virtue the Titanoi cult can Initiate." ;
    rpg:hasTag amol:Virtue .
amol:InvocationOfWeariness a rpg:Spell ;
    rpg:name "Invocation of Weariness" ;
    dc:description "A Perdo Corpus spell (Level 20) that causes the target to lose a Fatigue level, often via singsong melodies that lull the victim into drowsiness." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:InvokeThePactOfZelos a rpg:Spell ;
    rpg:name "Invoke the Pact of Zelos" ;
    dc:description "A ReVi general-level Ritual spell that forms a pact with the Daimon Zelos by targeting one of his Aspects to perform a specific service." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:IoannesAcer a rpg:Character ;
    rpg:name "Ioannes Acer" ;
    dc:description "A young journeyman follower of Merinita at Irencillia, a knight with the Gift and Flawless Magic who specializes in Herbam and rides his stag caricature Kervus; youngest apprentice of Archmage Vinaria." ;
    skos:altLabel "Ioannes" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:IreneTheYounger a rpg:Character ;
    rpg:name "Irene the Younger" ;
    dc:description "A Byzantine princess who became a Verditius maga and famous inventor of magical paintings and figurines, founding her confraternity." ;
    skos:altLabel "Irene" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Irnerius a rpg:Character ;
    rpg:name "Irnerius" ;
    dc:description "A charismatic jurist at Bologna, the first to teach the Corpus Iuris Civilis, who put the university on the map through the study of Roman law." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Islam a rpg:Faction ;
    rpg:name "Islam" ;
    dc:description "One of the three Divine religions in Mythic Europe; Muslims live within a Dominion aura indistinguishable from the Church's, and a significant number of magi are Muslims." ;
    skos:altLabel "Islamic", "Muslim", "Muslims" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:IslamicLaw a rpg:Proficiency ;
    rpg:name "Islamic Law" ;
    dc:description "An Academic Ability, the Muslim version of Civil & Canon Law, drawn from the Qur'an and the Sunna." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:IsleOfArran a schema:Place ;
    rpg:name "Isle of Arran" ;
    dc:description "An island where the eldest magus of the Path of Beacons lives in a regio of his own creation." ;
    skos:altLabel "Arran" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:IsleOfUshant a schema:Place ;
    rpg:name "Isle of Ushant" ;
    dc:description "A flat-topped island off Brittany with vertical cliffs and treacherous reefs, on which the Tytalus Domus Magna Fudarus is built." ;
    skos:altLabel "Ushant" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Istria a schema:Place ;
    rpg:name "Istria" ;
    dc:description "The region in the Transylvanian Tribunal from which the Flambeau magus Vilano hailed." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:IstvanPadas a rpg:Character ;
    rpg:name "Istvan Padas" ;
    dc:description "A master of House Bjornaer holding the Seat of the Horse at Crintera, with a stallion heartbeast; the youngest and most willful Elder, a Wilderist descended from Magyars and lover of Zora." ;
    skos:altLabel "Istvan Padas, Follower of Bjornaer" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:ItemsOfQuality a rpg:Tag ;
    skos:prefLabel "Items of Quality" ;
    dc:description "A Minor House Inner Mystery of Verditius for creating non-enchanted items whose latent magical bonus is drawn to the surface via runes, not resisted by Magic Resistance." ;
    rpg:hasTag amol:Virtue .
amol:Itinerarium a rpg:Tag ;
    skos:prefLabel "Itinerarium" ;
    dc:description "A House Jerbiton tradition of a sponsored tour undertaken by apprentices near the end of training, mirroring young Romans' tour of Greece, Ephesus, Troy, and Egypt; originated accidentally with Anna of Naples." ;
    rpg:hasTag amol:HermeticConcept .
amol:IudiciumOfGuernicus a rpg:Character ;
    rpg:name "Iudicium of Guernicus" ;
    dc:description "The ancient senior quaesitor of the tribunal who presides at meetings from Blackthorn; bears a tattoo of a scarlet serpent and favors Intellego and Mentem magic." ;
    skos:altLabel "Iudicium", "Iudicium of Blackthorn" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:JackOfAllTrades a rpg:Tag ;
    skos:prefLabel "Jack-of-All-Trades" ;
    dc:description "A Minor, General Virtue letting a character attempt Ability rolls without a score and without extra botch dice." ;
    rpg:hasTag amol:Virtue .
amol:Jakin a rpg:Item ;
    rpg:name "Jakin" ;
    dc:description "One of two great hollowed stone pillars (\"he establishes\") of Solomon's temple legend that hold treasures of the ancient Hebrews." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:JamiAtAlQarawiyyin a schema:Place ;
    rpg:name "Jami'at al-Qarawiyyin" ;
    dc:description "A madrasah in Morocco described as the oldest madrasah in existence." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Janis a rpg:Character ;
    rpg:name "Janis" ;
    dc:description "Leader of Crintera's Swan Clan and volkv (priest) of the Forest Brothers, the covenant's contact among the pagan people of Rügen, often consulted by the magi on island matters." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Janus a rpg:Creature ;
    rpg:name "Janus" ;
    dc:description "A dead titanic god of doorways whose ghost pours wisdom into the ears of those who sleep on his grave, near a Merinita portal to Arcadia." ;
    skos:altLabel "god of doorways" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Jart a rpg:Character ;
    rpg:name "Jart" ;
    dc:description "The master of Tabanus and the leading Traditionalist within House Guernicus, favoring a strict interpretation of the Code." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Jason a rpg:Character ;
    rpg:name "Jason" ;
    dc:description "The leader of the Argonauts who, on Chiron's advice, brought Orpheus on the voyage to retrieve the Golden Fleece." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Jennis a rpg:Creature ;
    rpg:name "Jennis" ;
    dc:description "Richenda Spinosa's faerie caricature, a male version of the Polish maga who is helping her come to terms with her fae side." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:JeremiasFiliusGuernicus a rpg:Character ;
    rpg:name "Jeremias filius Guernicus" ;
    dc:description "A magus, author of De Lapii, the Branch of Terram summa, in 1220." ;
    skos:altLabel "Jeremias" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:JeromeTheScribe a rpg:Character ;
    rpg:name "Jerome the Scribe" ;
    dc:description "A scribe for whom Victor of Mercere is tasked with purchasing particular pigments in town." ;
    skos:altLabel "Jerome" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:JerusalemHospital a schema:Place ;
    rpg:name "Jerusalem Hospital" ;
    dc:description "The most famous hospital instituted for those injured on Crusade, built by the Order of St. John." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:JewishTempleInJerusalem a schema:Place ;
    rpg:name "Jewish Temple in Jerusalem" ;
    dc:description "The remnants of the Jewish temple in Jerusalem, cited as an example of a place with a Divine aura of 10." ;
    skos:altLabel "the last remnants of the Jewish temple in Jerusalem" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Jinxed a rpg:Tag ;
    skos:prefLabel "Jinxed" ;
    dc:description "A Minor General Flaw in which the character is a magnet for bad luck, being biased to be the one affected whenever chance determines misfortune." ;
    rpg:hasTag amol:Flaw .
amol:Jiphella a rpg:Character ;
    rpg:name "Jiphella" ;
    dc:description "An immense Ex Miscellanea maga of Dankmar (age 73), biological daughter of Schadrit and master of Mentem magics who keeps the covenfolk under her spell." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Jocelin a rpg:Character ;
    rpg:name "Jocelin" ;
    dc:description "A Redcap in his late twenties with brown hair and green eyes; favors new covenants and carries a ring of magic resistance and an enchanted shield." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:JohnScottus a rpg:Character ;
    rpg:name "John Scottus" ;
    dc:description "A scholar who in the ninth century corrected the error of two predeterminations, one good and one evil." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:JohnDeGarlande a rpg:Character ;
    rpg:name "John de Garlande" ;
    dc:description "Author of the famous 13th-century craft manual Dictionarius, covering moneychangers, clasp makers, cup makers, jewelers, and harness makers." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:JonArnsson a rpg:Character ;
    rpg:name "Jon Arnsson" ;
    dc:description "A 98-year-old master of House Bjornaer holding the Seat of the Stag (protector) at Crintera, with a lion heartbeast; a devout Christian Harmonist with divided loyalties." ;
    skos:altLabel "Jon", "Jon Arnsson, Follower of Bjornaer" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:JonaquilOfMerinita a rpg:Character ;
    rpg:name "Jonaquil of Merinita" ;
    dc:description "A young Merinita magus, one of the newly arrived members of Libellus." ;
    skos:altLabel "Jonaquil" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:JonathanTweet a rpg:Character ;
    rpg:name "Jonathan Tweet" ;
    dc:description "Ars Magica co-creator who wrote the game's preface; an in-world author note rather than a setting figure." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:JosceFilIsaacOfLondon a rpg:Character ;
    rpg:name "Josce fil' Isaac of London" ;
    dc:description "An important London usurer who currently holds the office of archpresbyter, the crown-appointed Jewish representative." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:JosephOfArimathea a rpg:Character ;
    rpg:name "Joseph of Arimathea" ;
    dc:description "The companion who came to Britain with Christ and later carried Christ's blood in a vessel, traveling west with eleven companions to found the first church at Glastonbury." ;
    skos:altLabel "Joseph" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Jove a rpg:Creature ;
    rpg:name "Jove" ;
    dc:description "A pagan deity cited as an example of an earth-shakingly important figure with a Might score in the 51-60 range." ;
    skos:altLabel "Jove himself" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:JudaicLore a rpg:Proficiency ;
    rpg:name "Judaic Lore" ;
    dc:description "A General Ability covering knowledge of Jewish cultural practice such as poetry, folklore, and songs." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:Judaism a rpg:Faction ;
    rpg:name "Judaism" ;
    dc:description "One of the three Divine religions in Mythic Europe; Jews live within a Dominion aura, and a scattering of magi are Jewish." ;
    skos:altLabel "Jewish", "Jews" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:JulianOfFlambeau a rpg:Character ;
    rpg:name "Julian of Flambeau" ;
    dc:description "A magus of House Flambeau whose version of The Beast Remade gives transformed beasts bright red hair in their new form." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:JuniusOfVerditius a rpg:Character ;
    rpg:name "Junius of Verditius" ;
    dc:description "An old, powerful Verditius magus of Semitae who makes the covenant's enchanted wagons and works secretly on an unrevealed project." ;
    skos:altLabel "Junius" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:JustAnInstant a rpg:Tag ;
    skos:prefLabel "Just an Instant" ;
    dc:description "A Minor, General Virtue letting a character who briefly looks about a room detect and remember anything of interest without Awareness checks." ;
    rpg:hasTag amol:Virtue .
amol:JustinOfTremere a rpg:Character ;
    rpg:name "Justin of Tremere" ;
    dc:description "A young Tremere magus, one of the newly arrived members of Libellus." ;
    skos:altLabel "Justin" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Justinian a rpg:Character ;
    rpg:name "Justinian" ;
    dc:description "Roman emperor referenced in connection with civil law in the setting." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:KaAba a schema:Place ;
    rpg:name "Ka'aba" ;
    dc:description "A holy site in Mecca cited as an example of a place with a Divine aura of 10 where God intervened directly." ;
    skos:altLabel "ka'aba in Mecca" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Kaeso a rpg:Character ;
    rpg:name "Kaeso" ;
    dc:description "Founder of the Mithraic tradition within House Flambeau; a hedge wizard of the Cult of Mithras recruited by Apromor who founded the covenant of Castra Solis." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:KaraiteMagic a rpg:Tag ;
    skos:prefLabel "Karaite Magic" ;
    dc:description "The Major Hermetic Flaw of the Karaites tradition, reflecting their religious restrictions on magic." ;
    rpg:hasTag amol:Flaw .
amol:Kassala a schema:Place ;
    rpg:name "Kassala" ;
    dc:description "A location in Alodia, the most remote of the three Nubian kingdoms on the southern reaches of the Nile, home to the Mortuary Society that practices Kassalan Exorcism." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:KassalanDust a rpg:Item ;
    rpg:name "Kassalan Dust" ;
    dc:description "A dust of powdered gold, myrrh, and spices made by the Mortuary Society of Kassala, required for Kassalan Exorcism and granting a +3 Shape & Material bonus against the dead." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:KassalanExorcism a rpg:Tag ;
    skos:prefLabel "Kassalan Exorcism" ;
    dc:description "A Minor, Supernatural Virtue allowing minor exorcism spells via the rites of the Mortuary Society of Kassala, aligned to the Magic Realm and using Kassalan Dust." ;
    rpg:hasTag amol:Virtue .
amol:Katzenveit a rpg:Creature ;
    rpg:name "Katzenveit" ;
    dc:description "A Waldgeist (wood-spirit) who haunts the forests of the Fichtelgebirge (Spruce Mountains)." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:KeeperOfThePath a rpg:Tag ;
    skos:prefLabel "Keeper of the Path" ;
    dc:description "The figure who tests aspirants at the Path of Strife's Initiation site, requiring them to negotiate the Labyrinth of Strife." ;
    rpg:hasTag amol:CharacterType .
amol:Kerberos a rpg:Creature ;
    rpg:name "Kerberos" ;
    dc:description "A figure to whom Tytalus claimed his black dog familiar was brother, alongside being a son of Hekate." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:KerryMountainsPool a schema:Place ;
    rpg:name "Kerry Mountains Pool" ;
    dc:description "A deep black pool in the Kerry Mountains of Hibernia where the ancient Irish cast votive offerings to their ancestors; a Bjornaer ancestor site." ;
    skos:altLabel "Kerry Mountains" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Kervus a rpg:Creature ;
    rpg:name "Kervus" ;
    dc:description "Ioannes Acer's faerie caricature, which has taken the form of a huge stag capable of bearing his weight, which he rides everywhere." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:KingAurelius a rpg:Character ;
    rpg:name "King Aurelius" ;
    dc:description "A king of Britain who sought to build a monument to his murdered people and was advised by Merlin to bring the Giant's Ring from Ireland." ;
    skos:altLabel "Aurelius" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:KingBaldwinIOfJerusalem a rpg:Character ;
    rpg:name "King Baldwin I of Jerusalem" ;
    dc:description "King of Jerusalem; an encounter with him led the pirate-merchant Godric to repentance and pilgrimage." ;
    skos:altLabel "King Baldwin I" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:KingDagobert a rpg:Character ;
    rpg:name "King Dagobert" ;
    dc:description "Seventh-century king who founded Saint Denis's Lendit Fair near Paris, once the most important fair in France." ;
    skos:altLabel "Dagobert" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:KingHolly a rpg:Creature ;
    rpg:name "King Holly" ;
    dc:description "The faerie ruler of the northern Holly Forest among the Courts of the Seasons, a tyrannical and cold-hearted Winter King who battles King Oak; possibly linked to the leader of the Wild Hunt." ;
    skos:altLabel "King of Winter", "Winter King" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:KingMarkOfCornwall a rpg:Character ;
    rpg:name "King Mark of Cornwall" ;
    dc:description "One of Arthur's under-kings who later held Tintagel as his seat." ;
    skos:altLabel "King Mark" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:KingOak a rpg:Creature ;
    rpg:name "King Oak" ;
    dc:description "The faerie ruler of the southern Oak Forest among the Courts of the Seasons, a regal and generous Summer King who battles King Holly; touchy of honor and takes words literally." ;
    skos:altLabel "King of Summer", "Summer King" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:KingRichardSRing a rpg:Item ;
    rpg:name "King Richard's Ring" ;
    dc:description "A wondrous gold ring that protects the wearer from fire (+5 Soak), named after Richard the Lionhearted and the legendary ring he wore on crusade (Craft Level 16)." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:KingSel a rpg:Character ;
    rpg:name "King Sel" ;
    dc:description "A king said to be buried on horseback with his treasury within Silbury Hill near Avebury, his tomb protected by a curse that strikes dead would-be robbers." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:KingSigebert a rpg:Character ;
    rpg:name "King Sigebert" ;
    dc:description "The king who founded the abbey at Bury St. Edmund's in 633." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:KingStone a rpg:Item ;
    rpg:name "King Stone" ;
    dc:description "A large stone standing apart from the Rollright Stones circle, the most magical of the lot, whose chips are supposed to ward against demons." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:KingValdemarIOfDenmark a rpg:Character ;
    rpg:name "King Valdemar I of Denmark" ;
    dc:description "Danish king who invaded the island of Rügen in 1168, threatening Crintera's pagan aura." ;
    skos:altLabel "King of Denmark" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:KingWilliamRufus a rpg:Character ;
    rpg:name "King William Rufus" ;
    dc:description "A king of England who summoned Eadric Wilde and his faerie wife to London out of a wish to look upon them." ;
    skos:altLabel "William Rufus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:KingSBench a rpg:Faction ;
    rpg:name "King's Bench" ;
    dc:description "One of the highest English courts of appeal, fixed at Westminster by Magna Carta, trying important civil and treason cases and issuing writs; its senior justice is Martin of Pattishall." ;
    skos:altLabel "court of the King's Bench" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:KingdomOfAsturias a schema:Place ;
    rpg:name "Kingdom of Asturias" ;
    dc:description "A kingdom in northern Spain where Laberius served as court magician and fought the Moors during the early Reconquista." ;
    skos:altLabel "Asturias" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:KingdomOfDenmark a rpg:Faction ;
    rpg:name "Kingdom of Denmark" ;
    dc:description "The kingdom that constrains travel in the Baltic Sea." ;
    skos:altLabel "Denmark" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:KingdomOfJerusalem a schema:Place ;
    rpg:name "Kingdom of Jerusalem" ;
    dc:description "The Crusader state of the Holy Land whose major port and nominal capital is Acre, constantly at risk from Muslim forces." ;
    skos:altLabel "Outremer", "the Holy Lands" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:KiristOfFlambeau a rpg:Character ;
    rpg:name "Kirist of Flambeau" ;
    dc:description "A young, fiery-tempered Flambeau magus of Voluntas specializing in Ignem who is committed to the greater good of the Order." ;
    skos:altLabel "Kirist" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Klaus a rpg:Character ;
    rpg:name "Klaus" ;
    dc:description "A companion-level craftsman example character, master of the Swordsmiths' Guild, with the Virtue Touched by the Divine Realm, who makes greatswords and a wondrous flaming greatsword." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:KleonOfCriamon a rpg:Character ;
    rpg:name "Kleon of Criamon" ;
    dc:description "A magus of House Criamon who spent years in the Thuringian Forest performing dangerous experiments with raw vis, became riddled with Warping, and likely perished in a Twilight episode." ;
    skos:altLabel "Kleon" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Kludie a rpg:Creature ;
    rpg:name "Kludie" ;
    dc:description "The most powerful faerie hound variant, from Belgium, able to take large forms of dog, cat, bat, horse or frog, walking on its back legs and preceded by supernatural blue flames." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Klynoites a rpg:Character ;
    rpg:name "Klynoites" ;
    dc:description "Pater of the magus who assassinated Prima Kalliste; he Marched his own filius and became the next Primus of House Tytalus, denouncing House Flambeau at Tribunal." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:KnifeOfHumanBone a rpg:Item ;
    rpg:name "Knife of Human Bone" ;
    dc:description "Philippus Niger's talisman, a wickedly curved dagger of human bone enchanted to stay razor-sharp, with attunements for Precise Destruction, Destroy Body, and Destroying Minds." ;
    skos:altLabel "bone dagger" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:KnightsHospitaller a rpg:Faction ;
    rpg:name "Knights Hospitaller" ;
    dc:description "A military order of monk-knights holding land across Christendom whose English houses gather funds and supplies for the Levant." ;
    skos:altLabel "Knights of the Hospital of St. John of Jerusalem" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:KnightsOfBlanik a rpg:Creature ;
    rpg:name "Knights of Blanik" ;
    dc:description "The sleeping army of St. Wenceslaus, knights seated motionless in stone chairs in an underground hall within the Divine regio of Mount Blanik, awaiting their call to arise." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:KnowsPeople a rpg:Tag ;
    skos:prefLabel "Knows People" ;
    dc:description "A Minor, General Virtue letting a character act as a social middleman, requesting a 'bait' once per story to gain aid from a non-player character." ;
    rpg:hasTag amol:Virtue .
amol:Kolding a schema:Place ;
    rpg:name "Kolding" ;
    dc:description "A small trading town at the head of Kolding Fjørd on the border between the Kingdom of Denmark and the Duchy of Schleswig, with about 200 inhabitants relying on fishing and a weekly farm market." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Koldun a rpg:Faction ;
    rpg:name "Koldun" ;
    dc:description "Shamanic wizards from the Novgorod Tribunal who abandoned their pagan priesthood for sorcery; a Witches of Thessaly variant tradition." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Kore a rpg:Creature ;
    rpg:name "Kore" ;
    dc:description "A nature-oriented deity whose name eumolpids of the Huntress may learn through the Mysteries of Names of Power and Invocation Magic." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:KrakDesChevaliers a schema:Place ;
    rpg:name "Krak des Chevaliers" ;
    dc:description "A real fortress cited as a forebear of the Superior Engineering concentric-castle style." ;
    skos:altLabel "Krak de Chevaliers" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Kratos a rpg:Creature ;
    rpg:name "Kratos" ;
    dc:description "The Daimon of might, bodily strength, and sovereign rule, son of Styx and Pallas, referenced in the Analects of Tytalus as a constant companion of the Founder." ;
    skos:altLabel "Strength" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Krios a rpg:Creature ;
    rpg:name "Krios" ;
    dc:description "An Elder Titan of leadership and father of Pallas the Titan of war-craft." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Kronos a rpg:Creature ;
    rpg:name "Kronos" ;
    dc:description "The Greek representation of time in serpent form, whose coils appear as scaly marks on the wrists of some Criamon ghosts." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Kropel a rpg:Creature ;
    rpg:name "Kropel" ;
    dc:description "A good-natured dwarflike creature of the Harz who travels abroad hidden by his hat of fog." ;
    skos:altLabel "Kröpel" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Kupala a rpg:Creature ;
    rpg:name "Kupala" ;
    dc:description "A faerie lord who guards the Fire Flower in Slavic lands and from whom Richenda Spinosa is descended, source of her secret faerie blood." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:KutnaMine a schema:Place ;
    rpg:name "Kutna Mine" ;
    dc:description "A fantastically rich silver mine opened by the Cistercian monks of Sedlec, where a monk named Anton found silver rods sprouting; site of a story seed about a magus secretly mining silver with magic." ;
    skos:altLabel "Kutna" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:KyffhauserMountains a schema:Place ;
    rpg:name "Kyffhauser Mountains" ;
    dc:description "A double line of hills on the Saxony-Thuringia border, legendary resting place of famous kings (notably Frederick Barbarossa) and site of Fengheld's Turris Acontiarum chapter." ;
    skos:altLabel "Kyffhauser", "the Kyffhäuser" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Laberius a rpg:Character ;
    rpg:name "Laberius" ;
    dc:description "A hermit-wizard of the ancient Roman cult of Mithras who healed and trained the young Flambeau, later killed by sahirs in Iberia." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Laboratory a rpg:Tag ;
    skos:prefLabel "Laboratory" ;
    dc:description "A magus's workshop for magical experimentation; one standard laboratory exists per magus in the baseline covenant." ;
    skos:altLabel "lab", "laboratories" ;
    rpg:hasTag amol:HermeticConcept .
amol:Labyrinth a rpg:Tag ;
    skos:prefLabel "Labyrinth" ;
    dc:description "A Minor laboratory Supernatural Flaw: the lab's exterior is a maze or structural puzzle, favored by some Criamon magi (-1 Safety, -1 Health, -2 Aesthetics, +2 Mentem or Vim)." ;
    rpg:hasTag amol:Flaw .
amol:LabyrinthMeditation a rpg:Tag ;
    skos:prefLabel "Labyrinth Meditation" ;
    dc:description "A non-magical Criamon ritual of walking a maze while contemplating a problem to improve concentration, granting a bonus to a single subsequent roll." ;
    skos:altLabel "labyrinth meditations", "labyrinth rituals" ;
    rpg:hasTag amol:HermeticConcept .
amol:LabyrinthOfStrife a schema:Place ;
    rpg:name "Labyrinth of Strife" ;
    dc:description "A tangled structure of tunnels at the Path of Strife's Initiation site that magi can only escape by performing feats violating Criamon tenets of apt action." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Lacerta a rpg:Character ;
    rpg:name "Lacerta" ;
    dc:description "A Clan Arelie magus of an Iberian sept, parens of Natrix." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Lacuna a rpg:Tag ;
    skos:prefLabel "Lacuna" ;
    dc:description "A 'hole' within an urban environment where the Dominion does not dominate, allowing magi to cast spells without realm interaction penalties; may carry other auras." ;
    skos:altLabel "Lacunae" ;
    rpg:hasTag amol:HermeticConcept .
amol:Ladislaus a rpg:Character ;
    rpg:name "Ladislaus" ;
    dc:description "A trusted companion of Roznov covenant who haunts the Prague slave market using his Magic Sensitivity to identify and filter out Gifted children among the slaves for delivery to Coeris." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:LadyGodgifu a rpg:Character ;
    rpg:name "Lady Godgifu" ;
    dc:description "The legendary noblewoman of a story seed whose lord promised to reduce taxes if she rode naked through the marketplace." ;
    skos:altLabel "Godgifu" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Lair a rpg:Tag ;
    skos:prefLabel "Lair" ;
    dc:description "A Minor laboratory Supernatural Flaw: a creature hides or hibernates in the lab, known or unknown (-1 Safety, +1 Warping)." ;
    rpg:hasTag amol:Flaw .
amol:LakeDistrict a schema:Place ;
    rpg:name "Lake District" ;
    dc:description "The region where the covenant Ungulus sits in a carved tower on a ridge, and where Aquila rides the thermals in eagle form." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:LakeNemi a schema:Place ;
    rpg:name "Lake Nemi" ;
    dc:description "A sacred lake in the Roman Tribunal in whose waters Huntress initiates may bathe on the Ides of August during the Eumolpid initiation." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Lammergeyer a rpg:Creature ;
    rpg:name "Lammergeyer" ;
    dc:description "The bearded vulture deemed by House Jerbiton the correct falconry raptor for magi; its bones make particularly good magical flutes and it has deep orange iron-rubbed plumage." ;
    skos:altLabel "bearded vulture" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Languedoc a schema:Place ;
    rpg:name "Languedoc" ;
    dc:description "A region of central southern France where Brother Julian wanders and preaches against the spread of the Cathar heresy." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:LapisMaior a rpg:Item ;
    rpg:name "Lapis Maior" ;
    dc:description "The legendary Greater Stone long sought by alchemists, said to convert pure base metals into gold." ;
    skos:altLabel "Greater Stone" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:LapisMinor a rpg:Item ;
    rpg:name "Lapis Minor" ;
    dc:description "A Level 20 Alteration Reagent creating a reddish waxy stone whose touch purifies a precious metal from its alloy; called the Lesser Stone, distinct from the sought-after Greater Stone." ;
    skos:altLabel "Lesser Stone" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:LaresLore a rpg:Proficiency ;
    rpg:name "Lares Lore" ;
    dc:description "An Ability used by Vestals to interact with lares (household spirits, also called penates), domestic faeries of the home and community." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:Large a rpg:Tag ;
    skos:prefLabel "Large" ;
    dc:description "A Minor, General Virtue setting Size to +1 so the character is six to seven feet tall, with wounds in six-point intervals." ;
    rpg:hasTag amol:Virtue .
amol:Larinda a rpg:Character ;
    rpg:name "Larinda" ;
    dc:description "A young Ex Miscellanea maga of Dankmar (age 20), daughter and filia of Jiphella, with a sunny disposition and affinities for Animal, Herbam, Aquam, and Auram." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:LarusEggThief a rpg:Character ;
    rpg:name "Larus Egg-Thief" ;
    dc:description "Clan Chief of Clan Maruhs, a wandering magus with a skua (seabird) heartbeast who haunts the coasts of western Europe." ;
    skos:altLabel "Larus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:LastFlightOfThePhoenix a rpg:Spell ;
    rpg:name "Last Flight of the Phoenix" ;
    dc:description "A CrIg 50 spell in which the caster immolates himself in a white-hot blast doing +45 damage; an early version was found in Flambeau's own lab notes, used by magi with Greater Immunity to fire." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:LatinQuarter a schema:Place ;
    rpg:name "Latin Quarter" ;
    dc:description "The left-bank Paris district of jumbled houses where masters and students live, a lawless place of books, learning, drinking, and gambling." ;
    skos:altLabel "Rue de Fouarre" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:LawOfNames a rpg:Tag ;
    skos:prefLabel "Law of Names" ;
    dc:description "A magical principle by which knowing a ghost's full name allows it to be summoned, as used in the Incantation of Summoning the Dead." ;
    rpg:hasTag amol:HermeticConcept .
amol:LawsOfEdwardTheConfessor a rpg:Item ;
    rpg:name "Laws of Edward the Confessor" ;
    dc:description "12th-century English laws under which the King owns all Jews and their property, relevant to a Minority Boon covenant in England." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:LawsOfHospitality a rpg:Tag ;
    skos:prefLabel "Laws of Hospitality" ;
    dc:description "The Rhine Peripheral Code rules, derived from German guest-laws, governing the duties of guests and hosts and entitling a magus to request hospitality at any legal covenant for a vis fee." ;
    skos:altLabel "conditions of hospitality", "guest-laws" ;
    rpg:hasTag amol:HermeticConcept .
amol:LearnAbilityFromMistakes a rpg:Tag ;
    skos:prefLabel "Learn (Ability) From Mistakes" ;
    dc:description "A Minor, General Virtue granting experience points in a chosen Ability the first time per session the character botches or narrowly fails a roll." ;
    rpg:hasTag amol:Virtue .
amol:LearnChirurgyFromMistakes a rpg:Tag ;
    skos:prefLabel "Learn Chirurgy from Mistakes" ;
    dc:description "A Virtue commonly taken by empirici allowing them to learn the Chirurgy Ability from their failures." ;
    rpg:hasTag amol:Virtue .
amol:LeatherRipper a rpg:Tag ;
    skos:prefLabel "Leather Ripper" ;
    dc:description "A Minor, Supernatural Virtue granting the power to destroy a group of leather objects, as a PeAn(He) 30 effect." ;
    rpg:hasTag amol:Virtue .
amol:Leccacorvo a rpg:Faction ;
    rpg:name "Leccacorvo" ;
    dc:description "The Genoese bank cited as a legendary money/banking income example." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Lech a rpg:Character ;
    rpg:name "Lech" ;
    dc:description "One of the three legendary founding brothers of the Slavic peoples, who continued on to settle in Poland." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Leczyca a rpg:Faction ;
    rpg:name "Leczyca" ;
    dc:description "A covenant established in Poland in 1052 by refugees from Grand Silesia to reinforce the New Slavonic Tribunal's authority over the Slavic lands." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:LegatusALatere a rpg:Tag ;
    skos:prefLabel "Legatus a latere" ;
    dc:description "A cleric authorized to act on behalf of the Pope with his full power; granted Divine Magic Resistance of 20." ;
    skos:altLabel "Cardinal" ;
    rpg:hasTag amol:CharacterType .
amol:LegatusMissus a rpg:Tag ;
    skos:prefLabel "Legatus missus" ;
    dc:description "A cleric with papal authorization for a single purpose; granted Divine Magic Resistance of 15." ;
    rpg:hasTag amol:CharacterType .
amol:Lemnos a schema:Place ;
    rpg:name "Lemnos" ;
    dc:description "The island where Hephaestus settled and took twelve forge-companions; site of a Forge of Hephaestus, a Verditius covenant (Ingasia), and an all-Verditius community." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:LeoIII a rpg:Character ;
    rpg:name "Leo III" ;
    dc:description "The Byzantine Emperor who in 729 ordered the destruction of images of Christ and the saints and forbade crosses in worship, prompting the formation of the League of Iconophiles." ;
    skos:altLabel "Emperor Leo III" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:LeonardoFibonacciOfPisa a rpg:Character ;
    rpg:name "Leonardo Fibonacci of Pisa" ;
    dc:description "A reclusive Pisan mathematical genius (Int +4, Com +5) who discovered the golden section / Fibonacci sequence and wrote the tractatus Liber abbaci; his work can aid Aristotelian Magic Theory and Herbam research." ;
    skos:altLabel "Fibonacci", "Leonardo", "Leonardo of Pisa" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:LeprosyFlaw a rpg:Tag ;
    skos:prefLabel "Leprosy (Flaw)" ;
    dc:description "A Major Flaw gained by the victim of the leprosy disease, imposing a Living Condition penalty and reputation effects." ;
    skos:altLabel "Leprosy Major Flaw" ;
    rpg:hasTag amol:Flaw .
amol:LesserExpansion a rpg:Tag ;
    skos:prefLabel "Lesser Expansion" ;
    dc:description "A Minor laboratory Outfittings Virtue: the lab is enlarged with some specialized equipment (+1 General Quality, +2 Upkeep, 1 Specialization point)." ;
    rpg:hasTag amol:Virtue .
amol:LesserFeature a rpg:Tag ;
    skos:prefLabel "Lesser Feature" ;
    dc:description "A Minor laboratory Structure Virtue: the lab features a unique structure aiding certain lab work, granting +1 Aesthetics and 1 Specialization point." ;
    rpg:hasTag amol:Virtue .
amol:LesserFocus a rpg:Tag ;
    skos:prefLabel "Lesser Focus" ;
    dc:description "A Minor laboratory Structure Flaw: an existing Lesser Feature is the central focus of the lab, enhancing it but hindering unrelated activities." ;
    rpg:hasTag amol:Flaw .
amol:LesserGuardian a rpg:Tag ;
    skos:prefLabel "Lesser Guardian" ;
    dc:description "A Minor laboratory Supernatural Virtue: a supernatural creature (less than Might 20) not the owner's familiar resides in and protects the lab (+1 Safety)." ;
    rpg:hasTag amol:Virtue .
amol:LesserHorde a rpg:Tag ;
    skos:prefLabel "Lesser Horde" ;
    dc:description "A Minor laboratory Supernatural Virtue: a small group of semi-intelligent creatures helps in the lab (+1 General Quality, +1 Upkeep, +1 Safety, +1 Aesthetics)." ;
    rpg:hasTag amol:Virtue .
amol:LesserIllusion a rpg:Tag ;
    skos:prefLabel "Lesser Illusion" ;
    dc:description "A Minor laboratory Supernatural Flaw: one apparent merit of the lab is merely an illusion; a balancing Minor Virtue is taken but its effects are negated." ;
    rpg:hasTag amol:Flaw .
amol:LesserInfernalPower a rpg:Tag ;
    skos:prefLabel "Lesser Infernal Power" ;
    dc:description "A Minor Supernatural Virtue for corrupted beasts adding 2 to Infernal Might and granting an Infernal Power that cannot have a Penetration total." ;
    rpg:hasTag amol:Virtue .
amol:LessiniMountains a schema:Place ;
    rpg:name "Lessini Mountains" ;
    dc:description "The mountains where the Alps cross into Italy, site of Dietrich Von Bern's ornate tomb filled with dragon-blood-enchanted arms." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Leucrota a rpg:Creature ;
    rpg:name "Leucrota" ;
    dc:description "A mythical beast whose tongue provides a Shape and Material bonus of +6 to mimicking human voices." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:LiberAbbaci a rpg:Item ;
    rpg:name "Liber abbaci" ;
    dc:description "Leonardo of Pisa's book (1202), a Quality 14 tractatus on Artes Liberales (arithmetic) covering interest, square roots, alloy percentages, and the golden section; reading it aids Herbam research and Aristotelian Magic Theory." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:LiberDeLumine a rpg:Item ;
    rpg:name "Liber de Lumine" ;
    dc:description "A Tractatus on Ignem (Quality 11) by Elaine concentrating on light as an aspect of the Form of Ignem." ;
    skos:altLabel "Book of Light" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:Libuse a rpg:Character ;
    rpg:name "Libuse" ;
    dc:description "The Gifted granddaughter of Czech who had a great vision at Vysehrad Rock foretelling her husband Premysl, founder of Bohemia's ruling dynasty." ;
    skos:altLabel "Princess Libuse" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:LicenseOfAbsence a rpg:Tag ;
    skos:prefLabel "License of Absence" ;
    dc:description "A Major, General Virtue for a priest relieved of some duties, giving an extra free season each year; only available to Priest Social Status." ;
    rpg:hasTag amol:Virtue .
amol:Liege a schema:Place ;
    rpg:name "Liege" ;
    dc:description "A prince-bishopric and market city where the River Legia joins the Meuse, grown from the martyrdom site of St. Lambert; its most famous bishop was Notger." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:LifeLinkedArt a rpg:Tag ;
    skos:prefLabel "Life-Linked Art" ;
    dc:description "A Major Supernatural Virtue letting an artist wound himself while working to increase artwork's Aesthetic Quality, making the piece a permanent Arcane Connection." ;
    rpg:hasTag amol:Virtue .
amol:Ligature a rpg:Item ;
    rpg:name "Ligature" ;
    dc:description "A small charm of parchment, stones, or herbs worn around the neck containing an Arcane or Sympathetic Connection, employing natural principles to grant a bonus to a single die roll." ;
    skos:altLabel "Ligatures" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:LightShaftOfTheNight a rpg:Spell ;
    rpg:name "Light Shaft of the Night" ;
    dc:description "A Rego Ignem spell (Level 20) that collects moonbeams and starlight into a controllable vertical shaft of soft silvery light, castable only under the night sky." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Lightless a rpg:Tag ;
    skos:prefLabel "Lightless" ;
    dc:description "A Minor laboratory Supernatural Flaw: the lab is totally dark and its contents cannot be seen, requiring other means of spatial perception (-1 Upkeep, +1 Warping)." ;
    rpg:hasTag amol:Flaw .
amol:Limes a schema:Place ;
    rpg:name "Limes" ;
    dc:description "A line of defensive forts reinforced by magic built by the Roman legions under Mercurian guidance, delineating the empire's northern extent and first fracturing the Hercynian Forest." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Lincoln a schema:Place ;
    rpg:name "Lincoln" ;
    dc:description "An important town and seat of a powerful bishop, left in poor material state by the battle of Lincoln in 1217; its castle is held by Nicola de Hay." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:LineOfMuj a rpg:Faction ;
    rpg:name "Line of Muj" ;
    dc:description "A mythic lineage from the Balkans whose ancestor made a pact with a magical guardian spirit, blessing his descendants with great strength and power over storms; surviving members live in the Transylvanian Tribunal and belong to House Tremere." ;
    skos:altLabel "the Muj" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:LineageOfHercynius a rpg:Faction ;
    rpg:name "Lineage of Hercynius" ;
    dc:description "A Bonisagus lineage descended from Hercynius, the penultimate apprentice of Bonisagus, which founded Waldherz to pursue primal forest magic and was largely destroyed in the Schism War." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:LineageOfIrmele a rpg:Faction ;
    rpg:name "Lineage of Irmele" ;
    dc:description "A line of wandering, weather-working magi within House Bonisagus founded by Irmele filia Trianoma, prominent among the peregrinatores and the Linden Gild." ;
    skos:altLabel "traveling tradition" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:LingeringInjury a rpg:Tag ;
    skos:prefLabel "Lingering Injury" ;
    dc:description "A Minor General Flaw in which an old injury won't heal, penalizing physical rolls and worsening with age." ;
    rpg:hasTag amol:Flaw .
amol:Linguist a rpg:Tag ;
    skos:prefLabel "Linguist" ;
    dc:description "A Minor, General Virtue increasing all Language Advancement Totals and character-generation language experience by a quarter." ;
    rpg:hasTag amol:Virtue .
amol:LionOfTheNorth a rpg:Item ;
    rpg:name "Lion of the North" ;
    dc:description "An Ars Magica sourcebook describing Pralix's war against Dav'nalleous, referenced in-text." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:LittleWilliam a rpg:Character ;
    rpg:name "Little William" ;
    dc:description "A Redcap over six feet tall and heavily built who obtained a longevity potion; the only Redcap to wear armor (enchanted lighter chainmail) and a skilled fighter." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Living a rpg:Tag ;
    skos:prefLabel "Living" ;
    dc:description "A Minor laboratory Supernatural Flaw: the lab's structure is alive, e.g. inside a faerie tree or the belly of a slumbering beast (-2 Safety, +2 Warping)." ;
    rpg:hasTag amol:Flaw .
amol:LivingQuarters a rpg:Tag ;
    skos:prefLabel "Living Quarters" ;
    dc:description "A Minor laboratory Outfittings Virtue: the lab contains furniture so the owner can live and sleep in it, a small benefit to lab work but bad for health." ;
    rpg:hasTag amol:Virtue .
amol:Llewellyn a rpg:Character ;
    rpg:name "Llewellyn" ;
    dc:description "The last primus of House Diedne, last seen at Bryn-Celli-Ddu, whose parting words (Llewellyn's Curse) are carved into the passage wall there." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:LlewellynSCurse a rpg:Tag ;
    skos:prefLabel "Llewellyn's Curse" ;
    dc:description "The carved parting words of Llewellyn, last primus of House Diedne, vowing that the House will last and return to haunt its enemies as long as nature endures." ;
    rpg:hasTag amol:HermeticConcept .
amol:Llewelyn a rpg:Character ;
    rpg:name "Llewelyn" ;
    dc:description "The last primus of House Díedne, whose name fueled magi's belief that Gruffyd ap Llewelyn was a returned Díedne magus." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Llywelyn a rpg:Character ;
    rpg:name "Llywelyn" ;
    dc:description "The prince of Wales who nominally acknowledges Henry as lord but controls south Wales and wages low-level war on the Anglo-Norman Marcher barons." ;
    skos:altLabel "Prince Llywelyn of Wales" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:LlywelynAbIorwerth a rpg:Character ;
    rpg:name "Llywelyn ab Iorwerth" ;
    dc:description "Prince of Gwynedd since 1194, a great warrior and politician who has come nearer than anyone since the Romans to unifying Wales." ;
    skos:altLabel "Llywelyn ab Iorweth", "Llywelyn ab Iorweth ab Owain", "Llywelyn the Great" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:LochochOfFoxLungs a rpg:Item ;
    rpg:name "Lochoch of Fox Lungs" ;
    dc:description "A Theriac of Level 20, Potency Strong, a syrupy medicine made from boiled honey that cures phthisis, a Major phlegmatic disease, over a month." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:LocksmithsGuild a rpg:Faction ;
    rpg:name "Locksmiths' Guild" ;
    dc:description "The guild of locksmiths, which historically did not develop until the late 14th and early 15th centuries; in the 13th century locks are made by specialist smiths." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Lohengrin a rpg:Character ;
    rpg:name "Lohengrin" ;
    dc:description "The golden-haired knight drawn by a swan who defeated Telramund and wedded Elsa on condition she never ask his name; he departed when she finally did. His legend forms part of Wolfram von Eschenbach's Parzival." ;
    skos:altLabel "Knight of the Swan" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Loire a schema:Place ;
    rpg:name "Loire" ;
    dc:description "A river near whose mouth an island was a college for Druidic priestesses in the years before the formation of the Order." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Loki a rpg:Character ;
    rpg:name "Loki" ;
    dc:description "The multi-faceted and often malevolent Norse god from whom some Ex Miscellanea claim the Nemthengacha tradition descends." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:LongMegAndHerDaughters a schema:Place ;
    rpg:name "Long Meg and Her Daughters" ;
    dc:description "A roughly hundred-meter stone circle in the Lake District whose stones cannot be reliably counted and are thought to be the petrified bodies of a witch and her daughters; Long Meg is a sandstone pillar that bleeds if chipped." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:LongWinded_2 a rpg:Tag ;
    skos:prefLabel "Long Winded" ;
    dc:description "A Virtue possessed by all Rottweiler grogs." ;
    rpg:hasTag amol:Virtue .
amol:LookAtMe a rpg:Spell ;
    rpg:name "Look at Me" ;
    dc:description "A Creo Mentem spell that creates a thought in a target's imagination, causing him to look directly at the caster and make eye contact." ;
    skos:altLabel "CrMe 15" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:LooseMagic a rpg:Tag ;
    skos:prefLabel "Loose Magic" ;
    dc:description "A Minor Hermetic Flaw that halves the magus's Advancement Total whenever he tries to Master spells." ;
    rpg:hasTag amol:Flaw .
amol:LordGuiguesOfDauphin a rpg:Character ;
    rpg:name "Lord Guigues of Dauphiné" ;
    dc:description "A noble who commissioned Hephaestion to build a mechanized tin magpie automaton for his bedchamber." ;
    skos:altLabel "Guigues", "Lord Guigues" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:LordOfTheTrees a rpg:Spell ;
    rpg:name "Lord of the Trees" ;
    dc:description "A Rego Herbam spell (Level 25) that causes a tree to move its branches and bend its trunk as mentally directed; a large tree gains Initiative, Attack, and Damage scores." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:LoreMaster a rpg:Tag ;
    skos:prefLabel "Lore-master" ;
    dc:description "A covenfolk template scholar versed in many Lore Abilities including Arcane Lores such as Dominion, Faerie, Infernal, Magic, and Order of Hermes Lore." ;
    rpg:hasTag amol:CharacterType .
amol:Lorelei a rpg:Creature ;
    rpg:name "Lorelei" ;
    dc:description "A nymph that haunts the Rhine and sings men to their doom." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Lorris a schema:Place ;
    rpg:name "Lorris" ;
    dc:description "A small town in France first granted customary rights by King Louis VI, later confirmed by Louis VII in 1155, whose generous customs included freeman status after a year and a day." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:LostInTheMemory a rpg:Spell ;
    rpg:name "Lost in the Memory" ;
    dc:description "A Muto Mentem spell that fills the target's mind with memory, causing him to relive past scenes while neglecting all but basic urges." ;
    skos:altLabel "MuMe 35" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Lotharingia a schema:Place ;
    rpg:name "Lotharingia" ;
    dc:description "The middle kingdom of the divided Carolingian empire that belonged to Lothar, later reabsorbed into Germany and divided into Upper and Lower Lorraine." ;
    skos:altLabel "Lorraine" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:LousyIngredients a rpg:Tag ;
    skos:prefLabel "Lousy Ingredients" ;
    dc:description "A Free laboratory Outfittings Flaw: the lab is supplied with dirty, impure, or poor-quality ingredients (-1 General Quality, -1 Upkeep)." ;
    rpg:hasTag amol:Flaw .
amol:LowCeiling a rpg:Tag ;
    skos:prefLabel "Low Ceiling" ;
    dc:description "A Free laboratory Structure Flaw: the ceiling is below the requisite ten feet, hampering some magical activities (-1 General Quality, -1 Safety, -1 Aesthetics)." ;
    rpg:hasTag amol:Flaw .
amol:LowTolerance a rpg:Tag ;
    skos:prefLabel "Low Tolerance" ;
    dc:description "A Minor General Flaw in which the character cannot easily withstand pain and fatigue, increasing related penalties." ;
    rpg:hasTag amol:Flaw .
amol:Lucas a rpg:Character ;
    rpg:name "Lucas" ;
    dc:description "A magus of the Waddenzee covenant whom Imanitos got on well with during his stay there." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:LucasVonBeck a rpg:Character ;
    rpg:name "Lucas von Beck" ;
    dc:description "An aggressive Follower of Flambeau at Waddenzee (age 45), son of a German altgraf and expert in Perdo magics who has begun studying necromancy using bodies from his pirate raids." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:LucidiaOfFlambeau a rpg:Character ;
    rpg:name "Lucidia of Flambeau" ;
    dc:description "A young Flambeau maga, one of the newly arrived members of Libellus." ;
    skos:altLabel "Lucidia" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Luctatio a rpg:Faction ;
    rpg:name "Luctatio" ;
    dc:description "A covenant in the Roman Tribunal between Milan and Verona, founded in 1172, heavily involved in Lombard politics; its Tytalus magi aided Milan against Barbarossa." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:Lucy a rpg:Character ;
    rpg:name "Lucy" ;
    dc:description "The wife of the Redcap Perceval, living at Mercer House with their children; she believes their daughter Maud has the Gift." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Lug a rpg:Character ;
    rpg:name "Lug" ;
    dc:description "The Celtic and Gallic god of trade and commerce, also a sun deity associated with war, crafts, poetry, music, and magic, known as Lleu, Lugh, and Lugus." ;
    skos:altLabel "Lleu", "Lugh", "Lugus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:LumenSRing a rpg:Item ;
    rpg:name "Lumen's ring" ;
    dc:description "A ring possessed by Lumen of Jerbiton that makes her appear as a man, allowing her to travel to monasteries in disguise." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:Luneburg a schema:Place ;
    rpg:name "Luneburg" ;
    dc:description "A wealthy city built on extensive salt mines, where subsidence causes houses to tilt over rickety streets." ;
    skos:altLabel "Lüneburg" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:LungsOfTheFish a rpg:Spell ;
    rpg:name "Lungs of the Fish" ;
    dc:description "A Muto Aquam spell (Level 20) with an Auram requisite that turns water into air as it enters the lungs, allowing the caster to breathe water." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Lupercus a rpg:Creature ;
    rpg:name "Lupercus" ;
    dc:description "Ulf's ancestor who haunts the Bielowezca Forest as an immense wolf Great Beast and may impart the secret of the Inner Heartbeast." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:LustForLife a rpg:Tag ;
    skos:prefLabel "Lust for Life" ;
    dc:description "A Major Curse (Creo Mentem effect) making the victim obsessed with sensual pleasure, requiring rolls to do anything besides follow compulsions." ;
    rpg:hasTag amol:Flaw .
amol:LuxDraconis a rpg:Faction ;
    rpg:name "Lux Draconis" ;
    dc:description "An undistinguished covenant founded in 915 in the Pennines; barely clinging to survival, it died out by 1100 and Blackthorn claimed its property." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:Lymphae a rpg:Creature ;
    rpg:name "Lymphae" ;
    dc:description "Water elementals (the 'pure waters') rarefied only from naturally occurring liquids; the best learners among elementals, they collect and mix substances and attack by pulling foes down to smother them." ;
    skos:altLabel "Water Elementals", "aquacolae", "lympha", "ondines", "undena", "undines" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Lyonesse a schema:Place ;
    rpg:name "Lyonesse" ;
    dc:description "A drowned land that once stretched from Cornwall to the Scilly Isles, Tristan's birthplace, sunk by the anger of the Fair Folk; its town was called Lyon and its remains can be seen at low tide." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Madrasah a schema:Place ;
    rpg:name "Madrasah" ;
    dc:description "An Islamic higher-education school attached to a mosque and run by religious leaders, privately endowed and supported by student tuition." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Maenads a rpg:Creature ;
    rpg:name "Maenads" ;
    dc:description "Women devoted to Dionysus who tore Orpheus limb from limb in a wild rampage." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Magdeburg a schema:Place ;
    rpg:name "Magdeburg" ;
    dc:description "A city on the Elbe favored by Otto the Great, seat of an archbishopric and center of missionary activity over the Eastern Marches; origin of the Magdeburg Law." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:MagiOrbi a rpg:Tag ;
    skos:prefLabel "Magi Orbi" ;
    dc:description "Magi who began in a different House but were exiled and found refuge in House Ex Miscellanea; they retain their former House's rules but lose its privileges and secrets." ;
    skos:altLabel "Orba", "Orbi", "Orbus", "orbus" ;
    rpg:hasTag amol:CharacterType .
amol:Magians a rpg:Faction ;
    rpg:name "Magians" ;
    dc:description "The original priestly caste of Persia, of which the Median tribe of Magians were the true blood ancestors granting the Magian Lineage Virtue." ;
    skos:altLabel "Median tribe of Magians" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:MagicAddiction a rpg:Tag ;
    skos:prefLabel "Magic Addiction" ;
    dc:description "A Major Hermetic Flaw in which the magus craves casting magic and struggles to stop casting spells until he drops from exhaustion." ;
    rpg:hasTag amol:Flaw .
amol:MagicItemVirtue a rpg:Tag ;
    skos:prefLabel "Magic Item (Virtue)" ;
    dc:description "A Free laboratory Supernatural Virtue: a magic item is installed in the lab, granting Virtues, Flaws, or Specialization changes; treated as Minor if very large." ;
    skos:altLabel "Magic Item" ;
    rpg:hasTag amol:Virtue .
amol:MagicItems a rpg:Tag ;
    skos:prefLabel "Magic Items" ;
    dc:description "A Minor General Virtue granting a Redcap 25 extra starting levels of magic items plus accelerated improvement, reflecting devotion to the House." ;
    rpg:hasTag amol:Virtue .
amol:MagicTheoryRoll a rpg:Tag ;
    skos:prefLabel "Magic Theory roll" ;
    dc:description "Library trap mechanic: a magus following uncorrected deliberate-error lab notes who fails an Intelligence + Magic Theory roll against Ease Factor 12 rolls as if he botched an experiment." ;
    rpg:hasTag amol:HermeticConcept .
amol:MagicalBeingCompanion a rpg:Tag ;
    skos:prefLabel "Magical (Being) Companion" ;
    dc:description "A Minor Story Flaw in which the character is accompanied by an intelligent magical being he must regularly look after." ;
    rpg:hasTag amol:Flaw .
amol:MagicalAnimalCompanion a rpg:Tag ;
    skos:prefLabel "Magical Animal Companion" ;
    dc:description "A useful minor Flaw giving a character a magical animal companion; listed as a resource increasing an agent's Resistance Strength." ;
    rpg:hasTag amol:Flaw .
amol:MagicalBeast a rpg:Creature ;
    rpg:name "Magical Beast" ;
    dc:description "A creature of magic with Magic Might that can be created at high levels of Creo Animal, requiring requisites for its powers and a Vim requisite for its magical nature." ;
    skos:altLabel "magical creature" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:MagicalFascination a rpg:Tag ;
    skos:prefLabel "Magical Fascination" ;
    dc:description "A Minor Personality Flaw in which the character is intensely interested in supernatural and magical phenomena to the exclusion of other motivations." ;
    rpg:hasTag amol:Flaw .
amol:MagicalHeating a rpg:Tag ;
    skos:prefLabel "Magical Heating" ;
    dc:description "A Free laboratory Supernatural Virtue: heating is provided magically, functioning as Superior or Excessive Heating without space and Upkeep cost." ;
    rpg:hasTag amol:Virtue .
amol:MagicalLighting a rpg:Tag ;
    skos:prefLabel "Magical Lighting" ;
    dc:description "A Free laboratory Supernatural Virtue: lighting is provided magically, functioning as Superior or Excessive Lighting without space and Upkeep cost." ;
    rpg:hasTag amol:Virtue .
amol:MagicalMemory a rpg:Tag ;
    skos:prefLabel "Magical Memory" ;
    dc:description "A Minor Hermetic Virtue allowing a magus to reproduce magical creations without keeping laboratory texts, getting the benefit of a Lab Text from memory." ;
    rpg:hasTag amol:Virtue .
amol:MagicalMount a rpg:Tag ;
    skos:prefLabel "Magical Mount" ;
    dc:description "A Minor General Virtue granting a mount or beast-of-burden with Cunning and a Magic Might Score up to 25 that obeys simple verbal commands." ;
    rpg:hasTag amol:Virtue .
amol:MagicalOven a rpg:Item ;
    rpg:name "Magical Oven" ;
    dc:description "A Creo Ignem 20 enchanted device shaped as an iron box encased in fire-brick whose interior becomes red-hot on command to cook food." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:MagicalWolf a rpg:Creature ;
    rpg:name "Magical Wolf" ;
    dc:description "A magical creature (Magic Might 20, Animal) resembling a slightly large gray wolf that watches over all wolves in its range, can split into a pack of duplicates, and instantly slay any wolf it strikes." ;
    skos:altLabel "A Magical Wolf", "Wolf Lord" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:MagicalConstructs a rpg:Creature ;
    rpg:name "Magical constructs" ;
    dc:description "Non-human servants at Ungulus, including human-form constructs, self-working animated brooms, knives and pans, warning bells, and invisible bound spirits serving as guards and messengers." ;
    skos:altLabel "animated brooms and brushes", "bound spirits" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:MagisterEtArtibus a rpg:Tag ;
    skos:prefLabel "Magister et Artibus" ;
    dc:description "A Major Social Virtue (university master of arts) listed as a high-Resistance social status on the Resistance of Agents Table." ;
    rpg:hasTag amol:Virtue .
amol:Magnantrum a rpg:Faction ;
    rpg:name "Magnantrum" ;
    dc:description "Covenant founded around 1111 in a cave under Salisbury Plain; disintegrated in 1187 due to internal disputes." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:MaidenCastle a schema:Place ;
    rpg:name "Maiden Castle" ;
    dc:description "A large set of hilltop earthworks south of Dorchester in Dorset, seemingly deserted but said in local tales to be a faerie stronghold where the fay may be met on the correct night." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Maimonides a rpg:Character ;
    rpg:name "Maimonides" ;
    dc:description "A Jewish philosopher who wrote The Guide for the Perplexed in 1190, a great summa on Jewish philosophy infused with Aristotelian ideas, sparking the Maimonidean Controversy." ;
    skos:altLabel "Rabbi Moses ben Maimon" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Mainz a schema:Place ;
    rpg:name "Mainz" ;
    dc:description "Formerly the Roman city Moguntiacum, raised to an archbishopric by St. Boniface; its archbishop is Archchancellor of the Empire and primas germaniae, and its see is a Holy See with a Divine aura of 7." ;
    skos:altLabel "Moguntiacum" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:MajorBreakthrough a rpg:Tag ;
    skos:prefLabel "Major Breakthrough" ;
    dc:description "A significant advance in Hermetic theory; the Aegis of the Hearth was a Major Breakthrough, while inventing variant parameters of it would require at least a Minor Breakthrough." ;
    skos:altLabel "Minor Breakthrough", "breakthrough" ;
    rpg:hasTag amol:HermeticConcept .
amol:MajorMagicalFocusInSpirits a rpg:Tag ;
    skos:prefLabel "Major Magical Focus in Spirits" ;
    dc:description "A Major Magical Focus developed by Titanoi magi during apprenticeship, applying to all supernatural entities with a naturally insubstantial form including ghosts." ;
    skos:altLabel "Magical Focus in Spirits" ;
    rpg:hasTag amol:Virtue .
amol:MakerOfTexturedVessels a rpg:Tag ;
    skos:prefLabel "Maker of Textured Vessels" ;
    dc:description "A Minor Supernatural Virtue allowing a character to craft vessels with impressed mystical patterns that grant a +3 bonus in a single Ability to their owner." ;
    rpg:hasTag amol:Virtue .
amol:MakerOfWaterVessels a rpg:Tag ;
    skos:prefLabel "Maker of Water Vessels" ;
    dc:description "A Minor Supernatural Virtue allowing a character to make magical water vessels whose drinker may swap an Ability score for the crafter's Craft: Potter score." ;
    rpg:hasTag amol:Virtue .
amol:Malediction a rpg:Tag ;
    skos:prefLabel "Malediction" ;
    dc:description "A Flaw a sahir might acquire from botched dealings with jinn during apprenticeship." ;
    skos:altLabel "Malediction (Greater or Lesser)" ;
    rpg:hasTag amol:Flaw .
amol:MalignantMagus a rpg:Tag ;
    skos:prefLabel "Malignant Magus" ;
    dc:description "A Minor Story Supernatural Flaw where a Twilight-loosed piece of the magus's psyche manifests as an adulteration that attacks his enemies without his consent." ;
    rpg:hasTag amol:Flaw .
amol:ManifestSin a rpg:Tag ;
    skos:prefLabel "Manifest Sin" ;
    dc:description "A Minor Supernatural Flaw in which a past sin stains the character's spirit and is manifest to those who can perceive hidden things, penalizing social interactions." ;
    rpg:hasTag amol:Flaw .
amol:Mannus a rpg:Character ;
    rpg:name "Mannus" ;
    dc:description "Son of the god Tuisto, from whom the word 'man' derives, who sired the fathers of the three German tribal groups." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:MarbaidOfFlambeau a rpg:Character ;
    rpg:name "Marbaid of Flambeau" ;
    dc:description "A magus of House Flambeau whose wizard's sigil is connected to an obsession with blood, turning his water spells into gushes of blood." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:MarcherLords a rpg:Faction ;
    rpg:name "Marcher Lords" ;
    dc:description "Anglo-Norman lords holding land in or along the borders of Wales, including the Marshals, de Braoses, Mortimers, and Bohuns, whose lordships function much like palatinates." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Marco a rpg:Character ;
    rpg:name "Marco" ;
    dc:description "A disreputable Redcap, frequently described as a liar and charlatan, who reports many strange tales of covenants." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:MargaretOfBeverley a rpg:Character ;
    rpg:name "Margaret of Beverley" ;
    dc:description "An English-born pilgrim who disguised herself as a man and helped defend the wall when Jerusalem fell to Saladin in 1187, later becoming a nun at Laon; an example of a woman warrior dressing as a man." ;
    skos:altLabel "Margaret" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:MargueriteOfFlambeau a rpg:Character ;
    rpg:name "Marguerite of Flambeau" ;
    dc:description "A beautiful but rude maga of House Flambeau, sole inhabitant of Fengheld's Fengheld House chapter in Cherbourg, who considers mundanes beneath her." ;
    skos:altLabel "Marguerite" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Maria a rpg:Character ;
    rpg:name "Maria" ;
    dc:description "A young woman near Mount Etna who has the Visions Flaw, feeling an empathy for fire and able to predict the volcano's eruptions through her dreams." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:MarieDeFrance a rpg:Character ;
    rpg:name "Marie de France" ;
    dc:description "A twelfth-century poet whose twelve lais are the best-known examples of that form of courtly-love poem." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:MarkingTheTerritory a rpg:Spell ;
    rpg:name "Marking the Territory" ;
    dc:description "A ReCo 15 Scent-Target spell that bars Corpus-associated intruders from a warded area marked by the caster's scent." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:MartialOfTytalus a rpg:Character ;
    rpg:name "Martial of Tytalus" ;
    dc:description "A magus of House Tytalus who collects turtle shells inscribed with bellicose Latin quotations." ;
    skos:altLabel "Martial" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:MartinOfPattishall a rpg:Character ;
    rpg:name "Martin of Pattishall" ;
    dc:description "The senior professional justice at the court of the King's Bench." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:MartinTheAlchemist a rpg:Character ;
    rpg:name "Martin the Alchemist" ;
    dc:description "An example philosopher and alchemist with Philosophiae 5 who learns and concocts the Cement reagent and writes Laboratory Texts for fellow alchemists." ;
    skos:altLabel "Martin" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Maruhs a rpg:Character ;
    rpg:name "Maruhs" ;
    dc:description "One of Birna's six apprentices, told to 'Strive,' from her own tribe, whose name means 'stallion' in Old Gothic; founder of Clan Maruhs." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Marut a rpg:Creature ;
    rpg:name "Marut" ;
    dc:description "One of two fallen angels who, per the Qur'an, taught sihr (magic) to mankind to tempt them from Islam." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:MaskTheOdorOfMagic a rpg:Spell ;
    rpg:name "Mask the Odor of Magic" ;
    dc:description "A spell used in conjunction with a magically maintained persona enchantment to hide magical traces." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:MasonsGuild a rpg:Faction ;
    rpg:name "Masons' Guild" ;
    dc:description "The only craft guild that operates internationally, whose members travel across Mythic Europe in army-like groups to build cathedrals, churches, and castles." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:MasterVirtue a rpg:Tag ;
    skos:prefLabel "Master (Virtue)" ;
    dc:description "A free Social Status Virtue specific to the Rhine, granting the rank of magister, the right to train apprentices, and the use of a retired magus's voting sigil." ;
    skos:altLabel "Master" ;
    rpg:hasTag amol:Virtue .
amol:MasterOfKennels a rpg:Tag ;
    skos:prefLabel "Master of Kennels" ;
    dc:description "A Minor Social Status Virtue for a character who manages the kennels of a noble patron, responsible for training, breeding, and health of the dogs." ;
    rpg:hasTag amol:Virtue .
amol:MasterOfNone a rpg:Tag ;
    skos:prefLabel "Master of None" ;
    dc:description "A Minor General Flaw in which the character cannot stick at a task for longer than a season, preventing reapplication of experience points to the same Ability or Art in a year." ;
    rpg:hasTag amol:Flaw .
amol:MasteringTheUnrulyBeast a rpg:Spell ;
    rpg:name "Mastering the Unruly Beast" ;
    dc:description "A Rego Animal spell (Level 25) allowing the caster to command an animal to perform any act it is capable of by touching it." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:MathieusOfConstantinople a rpg:Character ;
    rpg:name "Mathieus of Constantinople" ;
    dc:description "A contemporary House Jerbiton Archmagus trained in Constantinople but long resident in Paris, who gave up the study of magic but grew more active after Constantinople's fall." ;
    skos:altLabel "Archmagus Mathieus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:MatthewII a rpg:Character ;
    rpg:name "Matthew II" ;
    dc:description "The duke who succeeds Dietrich III as duke of Upper Lorraine in 1220." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:MaudDaughterOfPerceval a rpg:Character ;
    rpg:name "Maud (daughter of Perceval)" ;
    dc:description "The two-year-old daughter of the Redcap Perceval and Lucy, suspected of having the Gift." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:MausoleumOfHerlicarnasus a schema:Place ;
    rpg:name "Mausoleum of Herlicarnasus" ;
    dc:description "An epic site chosen as the headquarters of the example league The Singers in Hollow Rooms." ;
    skos:altLabel "Mausoleum of Halicarnassus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Mecklenburg a schema:Place ;
    rpg:name "Mecklenburg" ;
    dc:description "A region whose nobility still secretly come to Rethra to honor their god; its Slavic princes are drawn into the schemes of Radegast." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:MedievalUniversities a rpg:Tag ;
    skos:prefLabel "Medieval Universities" ;
    dc:description "Autonomous corporations of masters and scholars seeking independence from ecclesiastical and secular authority; in 1220 there are nine, organized into faculties, nations, and hospices." ;
    skos:altLabel "studium generale", "universitas" ;
    rpg:hasTag amol:HermeticConcept .
amol:MelesOfBjornaer a rpg:Character ;
    rpg:name "Meles of Bjornaer" ;
    dc:description "A young Bjornaer magus, one of the newly arrived members of Libellus." ;
    skos:altLabel "Meles" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Melusine a rpg:Creature ;
    rpg:name "Melusine" ;
    dc:description "A water faerie whose blood is borne by the Breton Seirenes bards." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:MemoryOfTheDistantDream a rpg:Spell ;
    rpg:name "Memory of the Distant Dream" ;
    dc:description "A Creo Mentem spell (Level 20) that inserts a full false memory into a person's mind, revealed as false on a successful Intelligence roll; the memory vanishes when the duration expires." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:MenAnTol a schema:Place ;
    rpg:name "Men-an-Tol" ;
    dc:description "A holed round stone with two pillars in a Cornish field, said to have healing powers (crawling through the hole) and divinatory powers (placing a gift and asking a question)." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Menagerie a rpg:Tag ;
    skos:prefLabel "Menagerie" ;
    dc:description "A Minor laboratory Outfittings Virtue: the lab contains a collection of live animals (+1 Upkeep, -1 Safety, -1 Aesthetics, +2 Animal)." ;
    rpg:hasTag amol:Virtue .
amol:MentalConstruct a rpg:Tag ;
    skos:prefLabel "Mental Construct" ;
    dc:description "A Major laboratory Supernatural Flaw: the lab exists entirely in the magus's mind via a powerful Creo Mentem ritual, limited by his Intelligence and unable to support familiar-bonding, item enchantment, or teaching." ;
    rpg:hasTag amol:Flaw .
amol:MerchantGuild a rpg:Faction ;
    rpg:name "Merchant Guild" ;
    dc:description "A guild of merchants granted by charter, holding monopolies (such as Ipswich's monopoly on milling) and operating a court for resolving disputes in towns like Freiburg." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:MerchantVenturer a rpg:Tag ;
    skos:prefLabel "Merchant Venturer" ;
    dc:description "A Social Status Virtue used to purchase the Typical merchant income band." ;
    rpg:hasTag amol:Virtue .
amol:MercurianCults a rpg:Faction ;
    rpg:name "Mercurian cults" ;
    dc:description "Cults among the Hermetic magi whose members often succumb to the Vulnerable Casting Flaw." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:MercurianLineage a rpg:Faction ;
    rpg:name "Mercurian lineage" ;
    dc:description "A Hermetic magical lineage descended from the Roman priests of Mercury, granting Mercurian Magic and predating the Order of Hermes." ;
    skos:altLabel "Roman priests of Mercury" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:MeririmTheMeridianDevil a rpg:Creature ;
    rpg:name "Meririm the Meridian Devil" ;
    dc:description "A demon who commands the demons haunting the meridian region between the poles and rules an Order of Aerial Powers." ;
    skos:altLabel "Meririm" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:MerlinSWell a schema:Place ;
    rpg:name "Merlin's Well" ;
    dc:description "A spring on the escarpment of Alderley Edge in Cheshire, marked by an inscription and a carved face said to represent Merlin, where Arthur and his knights are said to sleep beneath the Edge." ;
    skos:altLabel "Alderley Edge" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:MerryMaidens a schema:Place ;
    rpg:name "Merry Maidens" ;
    dc:description "A stone circle of nineteen granite boulders at Land's End, said to be girls turned to stone for dancing on Sunday to the music of the Pipers, who were demons." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Metz a schema:Place ;
    rpg:name "Metz" ;
    dc:description "The largest and most important city of Upper Lorraine, originally Roman Divodurum, a wealthy Free Imperial City since 1143 and former capital of Austrasia and Lotharingia." ;
    skos:altLabel "Divodurum" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:MicrocosmicStation a rpg:Tag ;
    skos:prefLabel "Microcosmic Station" ;
    dc:description "An advanced Station on the Criamon Path of the Body; Primi who achieve it are active administrators coordinating the House's ventures." ;
    rpg:hasTag amol:HermeticConcept .
amol:Midusulf a rpg:Character ;
    rpg:name "Midusulf" ;
    dc:description "One of Birna's six apprentices, told to 'Lead,' founder of Clan Midusulf, whose name means 'mead-wolf' (bear) in Old Gothic." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Midwife a rpg:Tag ;
    skos:prefLabel "Midwife" ;
    dc:description "An almost exclusively female practitioner whose Chirurgy skills are employed throughout pregnancy and childbirth, sometimes having her thumbs surgically removed to assist births." ;
    rpg:hasTag amol:CharacterType .
amol:Milan a schema:Place ;
    rpg:name "Milan" ;
    dc:description "A north Italian city near the iron mines of the southern Alps, famous for armaments and its capacity to produce enormous numbers of weapons to order." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:MildAging a rpg:Tag ;
    skos:prefLabel "Mild Aging" ;
    dc:description "A Minor General Virtue granting a +1 bonus to the Living Conditions Modifier on aging rolls and a +3 bonus to survive an aging crisis." ;
    rpg:hasTag amol:Virtue .
amol:MiloOfBonisagus a rpg:Character ;
    rpg:name "Milo of Bonisagus" ;
    dc:description "An Archmage of House Bonisagus who prepared for his archmage contest while a member of Schola Pythagoranis, then joined Durenmar." ;
    skos:altLabel "Archmage Milo" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:MimerTheOld a rpg:Character ;
    rpg:name "Mimer the Old" ;
    dc:description "A minor deity in the Scandinavian pantheon from whom Wayland learned smith-craft techniques." ;
    skos:altLabel "Mimer" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Mimizan a rpg:Faction ;
    rpg:name "Mimizan" ;
    dc:description "A covenant in the Provençal Tribunal with only two members, one of whom is the Praeco Dama." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:Minerva a rpg:Creature ;
    rpg:name "Minerva" ;
    dc:description "A pagan goddess whose image in high relief is carved into rock just south of Chester and is said to continue to watch over the city." ;
    skos:altLabel "the pagan goddess Minerva" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Minnesingers a rpg:Tag ;
    skos:prefLabel "Minnesingers" ;
    dc:description "A type of German minstrel copying the northern French style with emphasis on knightly combat and sensual love, exemplified by Walther and Wolfram." ;
    skos:altLabel "minnesinger" ;
    rpg:hasTag amol:CharacterType .
amol:MinorEnchantments a rpg:Tag ;
    skos:prefLabel "Minor Enchantments" ;
    dc:description "A Minor Supernatural Virtue giving the character items with magical powers designed as Hermetic enchantments totaling 25 levels or less." ;
    rpg:hasTag amol:Virtue .
amol:MinorPotency a rpg:Tag ;
    skos:prefLabel "Minor Potency" ;
    dc:description "A Virtue granted at the first Station of the Criamon Path of the Body, conferring potency in an aspect of the Art of Corpus." ;
    rpg:hasTag amol:Virtue .
amol:MinorSupernaturalAbility a rpg:Tag ;
    skos:prefLabel "Minor Supernatural Ability" ;
    dc:description "A Virtue granting a minor supernatural power, gained by long-lived Durenmar covenfolk in their seventh decade." ;
    rpg:hasTag amol:Virtue .
amol:Miracles a rpg:Tag ;
    skos:prefLabel "Miracles" ;
    dc:description "The direct intervention of God in the world, which can do anything, cannot fail, and cannot be resisted by any other power including creature Magic Resistance." ;
    skos:altLabel "Divine miracles" ;
    rpg:hasTag amol:HermeticConcept .
amol:Miriam a rpg:Character ;
    rpg:name "Miriam" ;
    dc:description "Flavius of Jerbiton's wife, of unclear cultural group and magical tradition; she attended the First Tribunal in an undescribed capacity and is buried beside Jerbiton." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:MissingEar a rpg:Tag ;
    skos:prefLabel "Missing Ear" ;
    dc:description "A Minor General Flaw in which the character cannot accurately locate the direction of sounds, suffering a penalty to hearing rolls." ;
    rpg:hasTag amol:Flaw .
amol:MissingEquipment a rpg:Tag ;
    skos:prefLabel "Missing Equipment" ;
    dc:description "A Minor laboratory Outfittings Flaw: a lack of equipment makes one or two activity types totally impossible (-1 Upkeep)." ;
    rpg:hasTag amol:Flaw .
amol:MissingHand a rpg:Tag ;
    skos:prefLabel "Missing Hand" ;
    dc:description "A Minor General Flaw in which the character has lost a hand, penalizing climbing, combat, and activities requiring both hands." ;
    rpg:hasTag amol:Flaw .
amol:MissingIngredients a rpg:Tag ;
    skos:prefLabel "Missing Ingredients" ;
    dc:description "A Free laboratory Outfittings Flaw: a lack of certain ingredients severely hampers one Technique or two Forms, halving relevant Lab Totals (-1 Upkeep)." ;
    rpg:hasTag amol:Flaw .
amol:MissingSanctumMarker a rpg:Tag ;
    skos:prefLabel "Missing Sanctum Marker" ;
    dc:description "A Free laboratory Outfittings Flaw: the sanctum marker is not prominently displayed or is missing, inviting Hermetic intrusion (-1 Aesthetics)." ;
    rpg:hasTag amol:Flaw .
amol:MistsOfChange a rpg:Spell ;
    rpg:name "Mists of Change" ;
    dc:description "A Muto Corpus ritual (Level 60) with an Animal requisite in which patches of mist transform anyone remaining in the target area into a random creature for a Year." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Mithras a rpg:Creature ;
    rpg:name "Mithras" ;
    dc:description "A luminous Persian-origin sun god worshiped by the Cult of Mithras as savior of Creation and divine Bull-Slayer; Castra Solis is named for his sun-god aspect." ;
    skos:altLabel "Bull-Slayer" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:MithridatesVI a rpg:Character ;
    rpg:name "Mithridates VI" ;
    dc:description "King of Pontus and enemy of Rome who employed Crateuas as court physician; his potions let him survive poison and torture." ;
    skos:altLabel "Mithridates" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:MoatMonster a rpg:Creature ;
    rpg:name "Moat Monster" ;
    dc:description "A creature serving as a Local Ally for the Military Camp covenant situation, also referenced as a covenant Boon." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Mobile a rpg:Tag ;
    skos:prefLabel "Mobile" ;
    dc:description "A Free laboratory Structure Virtue: the entire lab can be readily moved, e.g. on a ship or cart, usually taken with the Unstable Flaw (+1 Experimentation)." ;
    rpg:hasTag amol:Virtue .
amol:MonasticVowsHermetic a rpg:Tag ;
    skos:prefLabel "Monastic Vows (Hermetic)" ;
    dc:description "A Major Hermetic Flaw in which the magus has taken vows of poverty, chastity, and obedience, forbidding him from owning vis and limiting him to functional magic devices." ;
    rpg:hasTag amol:Flaw .
amol:MonicaIerne a rpg:Character ;
    rpg:name "Monica Ierne" ;
    dc:description "The second-in-command of House Tremere, an Archmaga and master of combat magic originally from the Stonehenge Tribunal who serves as an excellent field commander." ;
    skos:altLabel "Archmaga Monica Ierne" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:MonstrousBlood a rpg:Tag ;
    skos:prefLabel "Monstrous Blood" ;
    dc:description "A Minor Supernatural Flaw in which the character's essential nature has been changed through exposure to the Magic realm, giving her true form unfortunate supernatural properties and a visible deformity, while granting a -1 bonus to Aging rolls." ;
    rpg:hasTag amol:Flaw .
amol:Morag a rpg:Character ;
    rpg:name "Morag" ;
    dc:description "A giant driven from his mountain home by diabolists who has taken to robbery near a covenant, holding a captured knight hostage in a cave; he craves revenge against the diabolists." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Moravia a schema:Place ;
    rpg:name "Moravia" ;
    dc:description "The eastern March of Bohemia bordered by the Carpathian Mountains and Hungary, through which flows the River Morava; home of the covenant of Roznov." ;
    skos:altLabel "Margravate of Moravia" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:MorlenOfMerinita a rpg:Character ;
    rpg:name "Morlen of Merinita" ;
    dc:description "A young Merinita magus among the members recruited to Nigrasaxa." ;
    skos:altLabel "Morlen" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:MortuarySocietyOfKassala a rpg:Faction ;
    rpg:name "Mortuary Society of Kassala" ;
    dc:description "A society in Kassala, Alodia that makes Kassalan Dust and practices Kassalan Exorcism rites against ghosts and the physical dead." ;
    skos:altLabel "Kassalan Mortuary Society", "Mortuary Society" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Moses a rpg:Character ;
    rpg:name "Moses" ;
    dc:description "Biblical prophet referenced in the Divine setting material." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:MotionSickness a rpg:Tag ;
    skos:prefLabel "Motion Sickness" ;
    dc:description "A Minor General Flaw causing the character to become violently ill when riding a horse, in a cart, or sailing, doubling fatigue loss on long journeys." ;
    rpg:hasTag amol:Flaw .
amol:MountBlanik a schema:Place ;
    rpg:name "Mount Blanik" ;
    dc:description "A mountain covered by a Divine regio, with an underground cavern holding the sleeping army of St. Wenceslaus, the Knights of Blanik, awaiting Bohemia's direst need." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:MountOlympus a schema:Place ;
    rpg:name "Mount Olympus" ;
    dc:description "The mountain home of the Greek gods from which Hephaestus was twice cast out; also the location of an all-Verditius covenant and a Forge of Hephaestus." ;
    skos:altLabel "Olympus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:MountPilatus a schema:Place ;
    rpg:name "Mount Pilatus" ;
    dc:description "A mountain in the Alps where climbing can generate terrible storms, cited as an example of a Site of Weakness Hook." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:MountPurgatory a schema:Place ;
    rpg:name "Mount Purgatory" ;
    dc:description "A mountain commonly believed to sit at the center of the antipodal region directly opposite Jerusalem, atop Hell, a place of contrition and repentance." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:MountSaintOdile a schema:Place ;
    rpg:name "Mount Saint Odile" ;
    dc:description "A mountain in the northern Vosges housing the convent of St. Odile and a holy spring with a Divine aura of 4, a place of pilgrimage especially for those with eye diseases." ;
    skos:altLabel "Hohenburg" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Mountaintop a rpg:Tag ;
    skos:prefLabel "Mountaintop" ;
    dc:description "A Free laboratory Structure Virtue: the lab sits at a mountain peak, a dramatic remote setting prone to winds and snows (-1 Safety, +1 Upkeep, +2 Aesthetics, +2 Auram)." ;
    rpg:hasTag amol:Virtue .
amol:MournfulMound a schema:Place ;
    rpg:name "Mournful Mound" ;
    dc:description "A hill containing the barrow of the Black Serpent, reached beyond the court of the sons of the King of Suffering, where Peredur slew the serpent." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Muirgheal a rpg:Character ;
    rpg:name "Muirgheal" ;
    dc:description "A Quaesitor who led the Order's investigation into the Normandy restless-dead crisis and invited the Gifted Donatores to join the Order en masse." ;
    skos:altLabel "Murigheal" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:MummelLake a schema:Place ;
    rpg:name "Mummel Lake" ;
    dc:description "An enchanted isolated lake near Seebach in the Black Forest, home to a Nixe (water-nymph) whose jealous elemental spirits may slay the mortals she bewitches." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Munster a schema:Place ;
    rpg:name "Munster" ;
    dc:description "A prosperous market and episcopal city on the Munsterland plain, founded as a monastery in 805 to convert the Saxons." ;
    skos:altLabel "Münster" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:MyNewBestFriend a rpg:Spell ;
    rpg:name "My New Best Friend" ;
    dc:description "A Creo Mentem 25 spell of Henri de Tours that makes a target believe the caster is an old friend by substituting the caster for one of the target's real friends." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Myrmecoleon a rpg:Creature ;
    rpg:name "Myrmecoleon" ;
    dc:description "A mythical creature whose exoskeleton provides a Shape and Material bonus of +6 to deprivation and starvation effects." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:MysteryOfAscendancyToTheHallOfHeroes a rpg:Tag ;
    skos:prefLabel "Mystery of Ascendancy to the Hall of Heroes" ;
    dc:description "The innermost Mystery of the Huntress, Initiated as the Chosen of Diana via a Quest to find and slay Quendalon in Arcadia, a great Sacrifice, and ritual blinding." ;
    skos:altLabel "Ascendancy to the Hall of Heroes" ;
    rpg:hasTag amol:Virtue .
amol:MysteryOfDivination a rpg:Tag ;
    skos:prefLabel "Mystery of Divination" ;
    dc:description "A Major Virtue acquired through Clan Ilfetu's Trial and Oath of the Prophet, alongside the Visions Flaw." ;
    skos:altLabel "Divination" ;
    rpg:hasTag amol:Virtue .
amol:MysteryOfDivinationAndAugury a rpg:Tag ;
    skos:prefLabel "Mystery of Divination and Augury" ;
    dc:description "An Esoteric Mystery into which Clan Ilfetu members may be Initiated, teaching the haemagmomancy divination method." ;
    skos:altLabel "Esoteric Mystery of Divination and Augury" ;
    rpg:hasTag amol:Virtue .
amol:MysteryOfHermeticSynthemata a rpg:Tag ;
    skos:prefLabel "Mystery of Hermetic Synthemata" ;
    dc:description "The Mystery into which a new hierophant of the Huntress is Initiated, vital to controlling the pagan messiah they hope to create." ;
    skos:altLabel "Hermetic Synthemata" ;
    rpg:hasTag amol:Virtue .
amol:MysteryOfTheAnima a rpg:Tag ;
    skos:prefLabel "Mystery of the Anima" ;
    dc:description "A Major House Mystery of House Bjornaer that transforms the heartbeast into a spiritual or elemental form composed of an element such as earth, fire, air, water, smoke, or shadow." ;
    skos:altLabel "Anima" ;
    rpg:hasTag amol:Virtue .
amol:MysteryOfTheEpitome a rpg:Tag ;
    skos:prefLabel "Mystery of the Epitome" ;
    dc:description "A Major House Mystery of House Bjornaer that perfects the heartbeast into a Beast of Virtue, granting Characteristic bonuses, Mythic Feats, and immunity to physical Flaws in inner form." ;
    skos:altLabel "Epitome" ;
    rpg:hasTag amol:Virtue .
amol:MythicFeat a rpg:Tag ;
    skos:prefLabel "Mythic Feat" ;
    dc:description "An automatically successful incredible action a Beast of Virtue may perform at the cost of a confidence Point, covering feats of Perception, Presence, Strength, and other Characteristics." ;
    skos:altLabel "Sample Mythic Feats" ;
    rpg:hasTag amol:HermeticConcept .
amol:MythicGermany a schema:Place ;
    rpg:name "Mythic Germany" ;
    dc:description "The magic-soaked lands of medieval Germany within the Holy Roman Empire, birthplace of the Order of Hermes and setting of the Rhine Tribunal." ;
    skos:altLabel "Germania", "Germany" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:NamelessCovenant a rpg:Faction ;
    rpg:name "Nameless Covenant" ;
    dc:description "A Díedne covenant established on an ancient druidic shrine on Anglesey in 817, destroyed in 1011 and stricken from the records by the quaesitores after the Schism War." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:NamesOfPower a rpg:Tag ;
    skos:prefLabel "Names of Power" ;
    dc:description "A Mystery Virtue the Titanoi cult can Initiate." ;
    rpg:hasTag amol:Virtue .
amol:Naples a schema:Place ;
    rpg:name "Naples" ;
    dc:description "A city whose catacombs harbored the necromancer Guorna the Fetid and her tradition, which Tytalus and Tremere destroyed." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:NarrowlyCognizant a rpg:Tag ;
    skos:prefLabel "Narrowly Cognizant" ;
    dc:description "A Free Virtue indicating a faerie is aware of its faerie nature in a limited way; it tries to play its role accurately and cannot break role even unto death." ;
    rpg:hasTag amol:Virtue .
amol:Natrix a rpg:Character ;
    rpg:name "Natrix" ;
    dc:description "The filius of Lacerta in a Clan Arelie sept in Iberia." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:NaturaAntiqua a rpg:Faction ;
    rpg:name "Natura Antiqua" ;
    dc:description "A covenant of nature magi founded in the East Anglian fens in 1133, destroyed by Geoffrey de Mandeville during the Civil War in 1143." ;
    skos:altLabel "Natura" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:NaturalEnvironment a rpg:Tag ;
    skos:prefLabel "Natural Environment" ;
    dc:description "A Major laboratory Structure Virtue: natural scenery such as forest, desert, or river is in or around the lab, granting Aesthetics and terrain-appropriate Specializations." ;
    rpg:hasTag amol:Virtue .
amol:NaturalMagician a rpg:Tag ;
    skos:prefLabel "Natural Magician" ;
    dc:description "A practitioner of non-Hermetic natural magic; Amabel the Learned is one, as powerful as many Hermetic magi, and some churchmen have begun employing such magicians." ;
    skos:altLabel "natural magicians" ;
    rpg:hasTag amol:CharacterType .
amol:Naumburg a schema:Place ;
    rpg:name "Naumburg" ;
    dc:description "A well-fortified town high above the River Saale with its own bishop, beginning construction of a cathedral dedicated to St. Peter and St. Paul." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:NebelkNigin a rpg:Item ;
    rpg:name "Nebelkönigin" ;
    dc:description "A magically enhanced ship, pride of Waddenzee's pirate fleet, stolen from Oculus Septentrionalis (built by the Verditius shipwright Marcus) while it carried vis and magical books." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:NecessaryRealmAuraForAbility a rpg:Tag ;
    skos:prefLabel "Necessary (Realm) Aura for (Ability)" ;
    dc:description "A Minor Supernatural Flaw giving a -3 penalty to a particular Ability when the character is not in the appropriate supernatural aura." ;
    rpg:hasTag amol:Flaw .
amol:Necessity a rpg:Tag ;
    skos:prefLabel "Necessity" ;
    dc:description "The underlying laws of the universe in Criamon cosmology that forced the immortals into the cycle of time for three eternities." ;
    rpg:hasTag amol:HermeticConcept .
amol:Nef a rpg:Item ;
    rpg:name "Nef" ;
    dc:description "The main carvel-built trade ship of the Mediterranean, following a Roman design with lateen rigging borrowed from the Arabs and up to three masts." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:NeoMercurians a rpg:Faction ;
    rpg:name "Neo-Mercurians" ;
    dc:description "A Hermetic Mystery Cult interested in Roman ceremonies and culture, said to be related to the Cult of Mercury." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:NephilimVirtue a rpg:Tag ;
    skos:prefLabel "Nephilim (Virtue)" ;
    dc:description "The Free Mythic Companion Virtue defining a character as a Nephilim." ;
    rpg:hasTag amol:Virtue .
amol:NeptuneSBrooch a rpg:Item ;
    rpg:name "Neptune's Brooch" ;
    dc:description "A wondrous carved precious stone made by a jeweler that prevents the wearer from drowning by letting him float on water (Craft Level 14)." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:NeptuneSImprisoningArms a rpg:Spell ;
    rpg:name "Neptune's Imprisoning Arms" ;
    dc:description "A Muto Aquam spell (MuAq 25) created by Falke that forms semi-solid 'vines' of water that can hold a small boat or up to six people, operating like Trap of the Entwining Vines." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Nestor a rpg:Creature ;
    rpg:name "Nestor" ;
    dc:description "Iacob's faerie caricature, a white (albino) crow that accompanies him on his travels and identifies him as the Prophet of the God of Truth." ;
    skos:altLabel "albino crow" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:NestorOfTremere a rpg:Character ;
    rpg:name "Nestor of Tremere" ;
    dc:description "The current curator (head) of the oppidum of Tablinum, who holds a collection of Arcane Connections used to enter its regiones." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:NewAristotle a rpg:Item ;
    rpg:name "New Aristotle" ;
    dc:description "The body of newly translated works of Aristotle dubbed by scholastic leaders, central to the twelfth-century recovery of philosophical knowledge." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:NewForest a schema:Place ;
    rpg:name "New Forest" ;
    dc:description "A royal forest in England cited as a legendary forestry income example." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Niall a rpg:Character ;
    rpg:name "Niall" ;
    dc:description "The example player who creates the magus Darius of Flambeau throughout the Detailed Character Creation worked example." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Nibelungs a rpg:Faction ;
    rpg:name "Nibelungs" ;
    dc:description "A legendary race of men from the Lower Rhine who collaborated with dwarves and giants to conquer the wild river; their lost treasure is the Rhinegold." ;
    skos:altLabel "Nibelung" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:NightTerrors a rpg:Tag ;
    skos:prefLabel "Night Terrors" ;
    dc:description "A Minor General Flaw in which the character is plagued by horrible nightmares, requiring a Stress Roll against Ease Factor 9 to avoid terrors and Long Term Fatigue loss." ;
    rpg:hasTag amol:Flaw .
amol:Nike a rpg:Creature ;
    rpg:name "Nike" ;
    dc:description "The Daimon of victory in both battle and peaceful competition, daughter of Styx and Pallas, invoked in an Orphic Hymn used in eristic moots." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Niobe a rpg:Character ;
    rpg:name "Niobe" ;
    dc:description "A Criamon maga who longed to be Prima but was never selected; her perfect transmission created a study pond as she faded into Twilight." ;
    skos:altLabel "Maga Niobe" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Nixe a rpg:Creature ;
    rpg:name "Nixe" ;
    dc:description "A water-nymph faerie dwelling in the enchanted Mummel Lake who bewitches young men with her beauty, drawing the jealousy of the lake's elemental spirits." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:NoHands a rpg:Tag ;
    skos:prefLabel "No Hands" ;
    dc:description "A Major General Flaw in which the character has no hands; magi take a -5 penalty to all Casting Scores, offset by the Subtle Magic Virtue or Still Casting." ;
    rpg:hasTag amol:Flaw .
amol:NoSenseOfDirection a rpg:Tag ;
    skos:prefLabel "No Sense of Direction" ;
    dc:description "A Minor General Flaw in which the character is completely unable to follow directions and frequently gets lost; incompatible with the Well Traveled Virtue." ;
    rpg:hasTag amol:Flaw .
amol:NoStores a rpg:Tag ;
    skos:prefLabel "No Stores" ;
    dc:description "A Minor laboratory Structure Flaw: the lab has nowhere to store supplies and cannot withstand shortages (-2 Safety)." ;
    rpg:hasTag amol:Flaw .
amol:Nomos a rpg:Tag ;
    skos:prefLabel "Nomos" ;
    dc:description "In Tytalan philosophy, the abstract force of law, convention, or custom—a human invention that glues society together but is changeable and thus open to challenge." ;
    skos:altLabel "convention", "custom", "law", "nomoi" ;
    rpg:hasTag amol:HermeticConcept .
amol:Nortorf a schema:Place ;
    rpg:name "Nortorf" ;
    dc:description "A small town in Holstein at the meeting of roads to Schleswig, Lübeck, and Hamburg, site of the prophesied infernal ash seedling cut down each New Year's Night by a white horseman." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Notary a rpg:Tag ;
    skos:prefLabel "Notary" ;
    dc:description "A Minor Social Status Virtue for a legal official employed by lords or towns who draws up contracts, witnesses charters, and affixes a seal." ;
    rpg:hasTag amol:Virtue .
amol:Notger a rpg:Character ;
    rpg:name "Notger" ;
    dc:description "Liege's most famous bishop, granted the diocese as a fiefdom by Otto II, responsible for many of Liege's grandest buildings, after whom it became a prince-bishopric." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:NotreDameDeParis a schema:Place ;
    rpg:name "Notre Dame de Paris" ;
    dc:description "The Paris cathedral whose recently completed nave is 112 feet tall, with its chancellor wielding power over the university." ;
    skos:altLabel "Notre Dame" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Nottingwood a schema:Place ;
    rpg:name "Nottingwood" ;
    dc:description "A town in a story seed that entered a charter agreement with a faerie king, electing a council of seven aldermen and hosting faerie merchants and knights." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Nuremberg a schema:Place ;
    rpg:name "Nuremberg" ;
    dc:description "An important Franconian trading city at a crossroads of trade routes, home to the Kaiserburg imperial castle and an unofficial capital of the empire." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:OathOfFealty a rpg:Tag ;
    skos:prefLabel "Oath of Fealty" ;
    dc:description "A Major Story Flaw in which the character has sworn loyalty and support to someone outside the covenant; magi are forbidden from such oaths by the Hermetic Code." ;
    rpg:hasTag amol:Flaw .
amol:Obano a rpg:Character ;
    rpg:name "Obano" ;
    dc:description "A 25-year-old journeyman swordsmith originally from Aragon, strong and scarred, who holds evidence of his former master's illegal dealings." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Obsessed a rpg:Tag ;
    skos:prefLabel "Obsessed" ;
    dc:description "A Major or Minor Personality Flaw in which the character is fixated on a prized object, action, or ideal that interferes with more immediate tasks." ;
    rpg:hasTag amol:Flaw .
amol:Occulta a rpg:Faction ;
    rpg:name "Occulta" ;
    dc:description "A covenant founded in the East Anglian fens in 893 by newly gauntleted magi; it failed to establish resources and collapsed in 897." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:Odofredus a rpg:Character ;
    rpg:name "Odofredus" ;
    dc:description "A great debater at Bologna and frontrunner for rector of the Faculty of Law, rival of Accursius in completing a legal digest." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Odysseus a rpg:Character ;
    rpg:name "Odysseus" ;
    dc:description "The legendary hero whose famous tale of resisting the sirens illustrates how the Seirenes' magic could be defeated." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:OffaSDyke a schema:Place ;
    rpg:name "Offa's Dyke" ;
    dc:description "A great earthwork of more than seventy miles marking the England-Wales boundary, completed in 787 with the faerie Huarwar's aid." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Ogam a rpg:Tag ;
    skos:prefLabel "Ogam" ;
    dc:description "Runes carved into trees and stones or written in ashes by the Damhadh-Duidsan to curse, steal life, inflict wounds, and heal." ;
    skos:altLabel "Ogam runes" ;
    rpg:hasTag amol:HermeticConcept .
amol:Ogmios a rpg:Creature ;
    rpg:name "Ogmios" ;
    dc:description "A Gaulish god of strength, eloquence, and poetry worshiped at the western Vosges springs, identified by the Romans as Hercules." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:OintmentForCongealingBlood a rpg:Item ;
    rpg:name "Ointment for Congealing Blood" ;
    dc:description "A Theriac of Level 20, Potency Moderate, a compress of tormentil and comfrey that stays bleeding and cures a Medium Wound from a slashing weapon over a month." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:OminousLevitationOfTheWeightyStone a rpg:Spell ;
    rpg:name "Ominous Levitation of the Weighty Stone" ;
    dc:description "A ReTe 15 spell that moves a stone through the air; when released it falls naturally and bypasses Magic Resistance, dealing damage based on the stone's size with a successful aiming roll." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:OnDiversArts a rpg:Item ;
    rpg:name "On Divers Arts" ;
    dc:description "A famous craft manual by the monk Theophilus about painters, glass makers, and metalworkers that adds +4 to a craftsman's Workshop Total." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:OpeningTheTomeOfTheAnimalSMind a rpg:Spell ;
    rpg:name "Opening the Tome of the Animal's Mind" ;
    dc:description "An Intellego Animal spell (Level 25) that lets the caster read an animal's memories of the past day by touching its head." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:OphiaSirnausIsleWarden a rpg:Character ;
    rpg:name "Ophia Sirnaus Isle-Warden" ;
    dc:description "Clan Chief of Clan Sirnas, a serpent-heartbeast maga who lives on an uninhabited Aegean island with a shrine to Artemis." ;
    skos:altLabel "Ophia" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Opulent a rpg:Tag ;
    skos:prefLabel "Opulent" ;
    dc:description "A Minor laboratory Outfittings Virtue: the lab is comfortable and well furnished (+1 Upkeep, +1 Health, +2 Aesthetics, +1 Teaching)." ;
    rpg:hasTag amol:Virtue .
amol:OrderOfMontjoie a rpg:Faction ;
    rpg:name "Order of Montjoie" ;
    dc:description "The oldest of three monastic orders dedicated to ransoming slaves, now failing and negotiating to be absorbed by another order." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:OrderOfStJohn a rpg:Faction ;
    rpg:name "Order of St. John" ;
    dc:description "A religious order that built the Jerusalem Hospital for those injured on Crusade." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:OrderOfTheGreenCockerel a rpg:Faction ;
    rpg:name "Order of the Green Cockerel" ;
    dc:description "A Hermetic group described in The Mysteries, Revised Edition, likely to include at least one member of the Collegium." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:OrderOfTheLadyOfMercy a rpg:Faction ;
    rpg:name "Order of the Lady of Mercy" ;
    dc:description "An order of monks founded in 1218 dedicated to ransoming slaves." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:OriginalResearch a rpg:Tag ;
    skos:prefLabel "Original Research" ;
    dc:description "The pursuit of advancing Hermetic theory through novel investigation, which Pralicians are especially likely to undertake." ;
    rpg:hasTag amol:HermeticConcept .
amol:Orlando a rpg:Character ;
    rpg:name "Orlando" ;
    dc:description "A musician and magus who knows Sorcerous Music and Subtle Magic, used as an example of casting spells while singing or playing his lute." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Orn a rpg:Character ;
    rpg:name "Orn" ;
    dc:description "The ancestor after whom the Clan Wilkis Sept of Orn is named." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Orphedra a rpg:Character ;
    rpg:name "Orphedra" ;
    dc:description "A cruel Follower of Merinita at Dankmar (age 139), the covenant's link to the dark fae who specializes in illusions, cold, darkness, and fear; she taught Schadrit Faerie Magic." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Orpheus a rpg:Character ;
    rpg:name "Orpheus" ;
    dc:description "The legendary Thracian poet, musician, and magician taught by Hermes, regarded by his cult as the first user of Hermetic magic and who descended to the Underworld for Eurydice." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:OssiumOfBjornaer a rpg:Character ;
    rpg:name "Ossium of Bjornaer" ;
    dc:description "A magus of House Bjornaer whose version of Talons of the Winds produces an eerie keening sound; his wizard's sigil makes many of his spells eerie or frightening." ;
    skos:altLabel "Ossium" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:OttoI a rpg:Character ;
    rpg:name "Otto I" ;
    dc:description "Son of Henry the Fowler, crowned at Aachen in 936, who defeated the Magyars at the Battle of the Lech (Lechfeld) in 955 and was crowned emperor in Rome in 962." ;
    skos:altLabel "Otto" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Outdoors a rpg:Tag ;
    skos:prefLabel "Outdoors" ;
    dc:description "A Major laboratory Structure Flaw: the lab is not housed in a building and is fully exposed to the elements, taken with the Natural Environment Virtue." ;
    rpg:hasTag amol:Flaw .
amol:OweinSonOfUryen a rpg:Character ;
    rpg:name "Owein son of Uryen" ;
    dc:description "A figure at Arthur's court in the Dream of Rhonabwy who played gwyddbwyll with Arthur while his magical ravens battled Arthur's men." ;
    skos:altLabel "Owein" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:OwlOfVirtue a rpg:Creature ;
    rpg:name "Owl of Virtue" ;
    dc:description "A Great Beast Mythic Blood lineage granting the Silence of the Smothered Sound feat, a Focus in Ghosts, and the Nocturnal flaw." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Paderborn a schema:Place ;
    rpg:name "Paderborn" ;
    dc:description "A town at the source of the River Pader, famous as the site of the 799 meeting of Charlemagne and Pope Leo III that agreed the establishment of the Holy Roman Empire." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:PaganTheology a rpg:Proficiency ;
    rpg:name "Pagan Theology" ;
    dc:description "An Ability covering non-Christian religious doctrine; the second book of Aristotle's Metaphysics is a tractatus on it." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:Painting a rpg:Proficiency ;
    rpg:name "Painting" ;
    dc:description "A Craft/Profession Ability representing skill at painting, used in the example maestro Grifo's Aesthetic Quality calculations." ;
    skos:altLabel "Painter", "Painter Ability" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:Palatial a rpg:Tag ;
    skos:prefLabel "Palatial" ;
    dc:description "A Major laboratory Outfittings Virtue: the lab is lavishly outfitted with the best comforts and decoration (+1 General Quality, +3 Upkeep, +2 Health, +4 Aesthetics)." ;
    rpg:hasTag amol:Virtue .
amol:Pancrestis a rpg:Character ;
    rpg:name "Pancrestis" ;
    dc:description "A young journeyman of House Bonisagus at Heorot, filius of Occultes and mentored by Philippus Niger, keen to learn Norse magic but deeply fearful of the wilderness." ;
    skos:altLabel "Pancrestis filius Occultes", "Pancrestis filius Occultes, Follower of Bonisagus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Pandora a rpg:Item ;
    rpg:name "Pandora" ;
    dc:description "A clay woman that Hephaestus made for Zeus, listed among his famous treasures." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:PantherOfVirtue a rpg:Creature ;
    rpg:name "Panther of Virtue" ;
    dc:description "A symbolic beast whose hide provides a Shape and Material bonus of +6 to song and melodious sounds." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:ParalyzeAManAtREye a rpg:Spell ;
    rpg:name "Paralyze a Man at R: Eye" ;
    dc:description "The magical feat granted to magi of the Wolf of Virtue Mythic Blood lineage." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ParisSonOfPriam a rpg:Character ;
    rpg:name "Paris (son of Priam)" ;
    dc:description "Son of the faerie lord Priam of Ilium, who holds a beauty contest during Ilium's mid-summer fair." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Parsirus a rpg:Character ;
    rpg:name "Parsirus" ;
    dc:description "A Verditius magus of Ungulus, beloved of Sinead, who was killed by the dragon." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Parzival a rpg:Item ;
    rpg:name "Parzival" ;
    dc:description "A poem by Wolfram von Eschenbach of which the legend of the swan knight Lohengrin forms part." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:PassTheUnyieldingPortal a rpg:Spell ;
    rpg:name "Pass the Unyielding Portal" ;
    dc:description "A Muto Herbam spell (Level 5) that makes the wood of a door pliable, allowing the magus to bend it open regardless of most locks or bars." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Path a rpg:Tag ;
    skos:prefLabel "Path" ;
    dc:description "A House Criamon tradition combining a field of study, set of values, and lifestyle, each granting different Mystery Virtues; clutches originally followed a single path." ;
    skos:altLabel "mystery path", "paths" ;
    rpg:hasTag amol:HermeticConcept .
amol:PathOfAging a rpg:Tag ;
    skos:prefLabel "Path of Aging" ;
    dc:description "A forest path through which Alexander of Jerbiton sought to reverse aging, requiring sacrifices and a quest to drink from the Fountain of Youth, yielding the Immortality of the Forest Virtue." ;
    rpg:hasTag amol:HermeticConcept .
amol:PathOfEnergy a rpg:Tag ;
    skos:prefLabel "Path of Energy" ;
    dc:description "A forest path discovered by Terious of Flambeau to replenish spent spellcasting energy from the forest, yielding the Life Boost and Mythic Blood Virtues." ;
    rpg:hasTag amol:HermeticConcept .
amol:PathOfWarping a rpg:Tag ;
    skos:prefLabel "Path of Warping" ;
    dc:description "A forest path walked by Kleon of Criamon to influence the effect of Wizard's Twilight on his Gift, yielding the Puissant Enigmatic Wisdom and Twilight Mastery Virtues." ;
    rpg:hasTag amol:HermeticConcept .
amol:PathsThroughTheForest a rpg:Tag ;
    skos:prefLabel "Paths through the Forest" ;
    dc:description "A tradition of nature magic inherited from Merinita, walked by many exsules, which may let them overcome one or more of the Lesser Limits of Hermetic magic." ;
    rpg:hasTag amol:HermeticConcept .
amol:Patron a rpg:Tag ;
    skos:prefLabel "Patron" ;
    dc:description "A sponsor who agrees to support an artist for an undetermined length of time, funding all of his work; losing one costs 12 Artist Reputation experience points." ;
    rpg:hasTag amol:HermeticConcept .
amol:Peasant a rpg:Tag ;
    skos:prefLabel "Peasant" ;
    dc:description "A Free Social Status Virtue for a free (non-serf) character who lives by working the land, possibly controlling and hiring labor if wealthy." ;
    rpg:hasTag amol:Virtue .
amol:Peitho a rpg:Creature ;
    rpg:name "Peitho" ;
    dc:description "The Daimon of persuasion and charming speech, daughter of Styx and Pallas, who with her sister Bia represents forceful inducement." ;
    skos:altLabel "Persuasion" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Pelagius a rpg:Character ;
    rpg:name "Pelagius" ;
    dc:description "One of Jerbiton's allies who traveled Europe seeking further recruits for the expanding House." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:PelicanOfVirtue a rpg:Creature ;
    rpg:name "Pelican of Virtue" ;
    dc:description "A symbolic bird whose beak provides a Shape and Material bonus of +8 to healing and nurturing." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:PenetrationAbility a rpg:Proficiency ;
    rpg:name "Penetration Ability" ;
    dc:description "An Ability that provides a Penetration bonus; creatures and characters without it have a Penetration bonus of zero." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:Penteli a schema:Place ;
    rpg:name "Penteli" ;
    dc:description "The marble quarries near Athens, cited as a legendary mining income example." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:PerceiveMotives a rpg:Spell ;
    rpg:name "Perceive Motives" ;
    dc:description "An Intellego Mentem effect (InMe 10) enchanted into Falke's talisman, like Sight of the Transparent Motive but with zero Penetration to avoid affecting Hermetic magi." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:PerceiveTheEyesOfKnives a rpg:Spell ;
    rpg:name "Perceive the Eyes of Knives" ;
    dc:description "A new Intellego Mentem spell (InMe 20) invented for Tabanus that indicates whether anyone in the target room has hostile thoughts toward the caster." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:PerceptionOfConflictingMotives a rpg:Spell ;
    rpg:name "Perception of Conflicting Motives" ;
    dc:description "An Intellego Mentem 15 spell known by Imanitos Mendax." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:PerceptionOfTheConflictingMotives a rpg:Spell ;
    rpg:name "Perception of the Conflicting Motives" ;
    dc:description "An Intellego Mentem spell (Level 15) that detects the conflicting motives behind a target's actions, often cast before a Muto or Rego spell to change emotions." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Perceval a rpg:Character ;
    rpg:name "Perceval" ;
    dc:description "A Redcap in his late forties contemplating retirement; tall, thin, balding, married to Lucy, with a brooch that makes him and his horse invisible." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Peredur a rpg:Character ;
    rpg:name "Peredur" ;
    dc:description "A knight-hero of a Mabinogion tale who slew the Black Oppressor and the Black Serpent of the Barrow with the aid of a magic stone given by a mysterious lady." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:PeredurSConcealmentStone a rpg:Item ;
    rpg:name "Peredur's concealment stone" ;
    dc:description "A magic stone given to Peredur by a mysterious lady that hid him from the seeing stone pillar guarding the Black Serpent's cave, letting him slay the serpent unseen." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:PerformanceArtist a rpg:Tag ;
    skos:prefLabel "Performance Artist" ;
    dc:description "An artist who performs art using a Profession Ability, such as jugglers, musicians, and minstrels, taking the Social Status Virtue Wanderer." ;
    skos:altLabel "Performers", "performance artists" ;
    rpg:hasTag amol:CharacterType .
amol:Persephone a rpg:Character ;
    rpg:name "Persephone" ;
    dc:description "The queen of the Greek Underworld who, with Hades, was moved by Orpheus's song; the sirens felt guilt at failing to save her from Hades." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Persia a schema:Place ;
    rpg:name "Persia" ;
    dc:description "The land of the Magians, original priestly caste, and home to most Mazdean communities, lying east of Mythic Europe." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Person a rpg:Tag ;
    skos:prefLabel "Person" ;
    dc:description "A Free laboratory Outfittings Virtue: another person, such as a family member or maid, frequents the lab (-1 Safety, +1 Corpus or Mentem)." ;
    rpg:hasTag amol:Virtue .
amol:PersonalPower a rpg:Tag ;
    skos:prefLabel "Personal Power" ;
    dc:description "A Minor Supernatural Virtue giving the character an at-will supernatural power equivalent to a Formulaic Hermetic spell of level 25 or lower." ;
    rpg:hasTag amol:Virtue .
amol:PersonalityFlaw a rpg:Tag ;
    skos:prefLabel "Personality Flaw" ;
    dc:description "A category of Flaw reflected by an extreme Personality Trait that shapes how a character behaves." ;
    skos:altLabel "Major Personality Flaw", "Minor Personality Flaw" ;
    rpg:hasTag amol:Flaw .
amol:Pessimistic a rpg:Tag ;
    skos:prefLabel "Pessimistic" ;
    dc:description "A Minor Personality Flaw in which the character always expects the worst." ;
    rpg:hasTag amol:Flaw .
amol:PeterLombard a rpg:Character ;
    rpg:name "Peter Lombard" ;
    dc:description "A scholar who taught at pre-university Bologna and Paris and wrote the Sentences and biblical glosses, compared in a story seed to the works of a Hermetic writer." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:PeterTheLombard a rpg:Character ;
    rpg:name "Peter the Lombard" ;
    dc:description "Author of the Sententiae (Sentences), one of the authoritative sources for the Academic Ability Theology: Christian." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:PeterVonWurzburg a rpg:Character ;
    rpg:name "Peter von Wurzburg" ;
    dc:description "A master of House Verditius at Fengheld, a famed grower of grapes and maker of wine who cultivates special varieties into wine as Charged Items." ;
    skos:altLabel "Peter", "Peter von Würzburg", "Peter von Würzburg of Verditius" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:PetronillaOfLeicester a rpg:Character ;
    rpg:name "Petronilla of Leicester" ;
    dc:description "A woman recorded as having armed herself as a knight and fought in battles during the reign of Henry II; a namesake later haggled the right to choose her own husband. An example of absence-based female power." ;
    skos:altLabel "Petronilla" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:PetrusMusandinus a rpg:Character ;
    rpg:name "Petrus Musandinus" ;
    dc:description "A great Salernitan master under whom Gilles de Corbeil trained in medicine." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Phaeton a rpg:Character ;
    rpg:name "Phaeton" ;
    dc:description "A young sun god of folklore who, in river myth, drowned in the Po after falling from the solar chariot, his body never recovered." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:PhantasmalFire a rpg:Spell ;
    rpg:name "Phantasmal Fire" ;
    dc:description "A Creo Imaginem spell with an Ignem requisite that makes an image of a fire that dances, illuminates, crackles, and apparently warms but does not actually burn; popular at gatherings of House Flambeau." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:PharmaceuticalTheriac a rpg:Item ;
    rpg:name "Pharmaceutical Theriac" ;
    dc:description "An experimental-philosophy product forming part of the corpus of Medicine; a medicinal cure-all preparation, often a restorative, that some empirici sell genuinely and others fake." ;
    skos:altLabel "Theriacs", "theriac" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:Pharmocopoeians a rpg:Faction ;
    rpg:name "Pharmocopoeians" ;
    dc:description "A tradition referenced as the model for the Taltos, focused on herbcraft and pharmacology." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:PhessalliaOfMerinita a rpg:Character ;
    rpg:name "Phessallia of Merinita" ;
    dc:description "An old, cold Merinita maga of Voluntas connected with the faeries of winter, skilled in Perdo, who possesses faerie items obtainable only as gifts." ;
    skos:altLabel "Phessallia" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:PhilipAugustus a rpg:Character ;
    rpg:name "Philip Augustus" ;
    dc:description "King of France for whom Gilles de Corbeil serves as archiater (chief physician)." ;
    skos:altLabel "King Philip Augustus of France" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:PhilipOfOldcoates a rpg:Character ;
    rpg:name "Philip of Oldcoates" ;
    dc:description "The sheriff of Northumbria who holds Mitford castle and refuses to surrender it to Roger Bertram despite royal summons." ;
    skos:altLabel "Philip" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:PhillipusDeGrevia a rpg:Character ;
    rpg:name "Phillipus de Grevia" ;
    dc:description "The chancellor of Notre Dame at Paris, who holds power to confer degrees and excommunicate university members and uses these rights to dominate the masters." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Phimosis a rpg:Creature ;
    rpg:name "Phimosis" ;
    dc:description "A Minor Choleric Disease afflicting promiscuous men, caused by excess lust, usually clearing on its own." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Phlegethi a rpg:Creature ;
    rpg:name "Phlegethi" ;
    dc:description "Fire elementals ('burners') that rarefy only from naturally occurring flame; short-lived, fast-moving creatures driven to burn and consume cold, that can beguile those who stare into their flames." ;
    skos:altLabel "Fire Elementals", "aethnici", "ignigena", "phlegethus", "salamanders", "vulcans" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Phthisis a rpg:Creature ;
    rpg:name "Phthisis" ;
    dc:description "A Major Phlegmatic, epidemic Disease that pollutes the vital faculty with phlegm and spreads via putrid breath." ;
    skos:altLabel "consumption" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Phyllia a rpg:Character ;
    rpg:name "Phyllia" ;
    dc:description "A master maga of House Bjornaer, the Eagle Elder at Crintera with a polecat heartbeast; a widely-traveled Harmonist and notorious gossip." ;
    skos:altLabel "Phyllia, Follower of Bjornaer" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Physicus a rpg:Tag ;
    skos:prefLabel "Physicus" ;
    dc:description "A term applied to anyone with advanced education in both medicine and natural philosophy, distinguishing educated medics from educated chirurgeons." ;
    rpg:hasTag amol:CharacterType .
amol:Physis a rpg:Tag ;
    skos:prefLabel "Physis" ;
    dc:description "In Tytalan philosophy, the abstract force of nature or self encompassing instincts, ambition, and competition, derived from a higher divine authority and thus permanent and unquestionable." ;
    skos:altLabel "nature", "the self" ;
    rpg:hasTag amol:HermeticConcept .
amol:PiercingTheMagicalVeil a rpg:Spell ;
    rpg:name "Piercing the Magical Veil" ;
    dc:description "An Intellego Vim (InVi 20) spell that detects and analyzes magical power." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Pietro a rpg:Character ;
    rpg:name "Pietro" ;
    dc:description "A magus of House Diedne of Oakdell covenant against whom Cirion of Tremere declared Wizard War in 1004 AD." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:PillarsOfHercules a schema:Place ;
    rpg:name "Pillars of Hercules" ;
    dc:description "Islands at the western edge of the known world near Granada, thought to contain uncontrolled gateways to Arcadia and the Magical realm." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Pisa a schema:Place ;
    rpg:name "Pisa" ;
    dc:description "A north Italian city of famed merchants, favored by the Holy Roman Emperor, which acts as the port for landlocked Florence." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:PlagueOfFrogs a rpg:Spell ;
    rpg:name "Plague of Frogs" ;
    dc:description "A Rego Animal spell that spontaneously generates a swarm of up to thousands of frogs in a touched pool of water." ;
    skos:altLabel "Rego Animal 20" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:PlaguedByDemon a rpg:Tag ;
    skos:prefLabel "Plagued by Demon" ;
    dc:description "A Flaw involving demonic persecution that cannot be taken if the saga excludes demons." ;
    rpg:hasTag amol:Flaw .
amol:PlaguedByADemon a rpg:Tag ;
    skos:prefLabel "Plagued by a Demon" ;
    dc:description "A Story Flaw granted to a child chosen by the demon Bordelon as her personal tormentor." ;
    rpg:hasTag amol:Flaw .
amol:PlainOfWolves a schema:Place ;
    rpg:name "Plain of Wolves" ;
    dc:description "A battlefield of the Schism War where the Tytali fought alongside Houses Tremere and Flambeau, referenced by the Tremere Primus Cercistum." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:PlantSWitheringBane a rpg:Spell ;
    rpg:name "Plant's Withering Bane" ;
    dc:description "A Perdo Herbam spell (Level 20) that withers and destroys one living plant up to the size of a small tree." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Pliny a rpg:Character ;
    rpg:name "Pliny" ;
    dc:description "The Roman author cited as mentioning an ancient mariner who circumnavigated Africa and found the place where much of Europe's gold originates." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Pneumonia a rpg:Creature ;
    rpg:name "Pneumonia" ;
    dc:description "A Serious Phlegmatic Disease, an inflammation of the lungs caused by polluted air, prone to a Crisis on the seventh day." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Po a schema:Place ;
    rpg:name "Po" ;
    dc:description "A river in which the young sun god Phaeton is said to have drowned after falling from the solar chariot." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Poena a rpg:Character ;
    rpg:name "Poena" ;
    dc:description "The Prima of House Tremere at the domus magna Coeris in the Transylvanian Tribunal, said to know the names and strengths of every member of her House." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:PoisoningTheWill a rpg:Spell ;
    rpg:name "Poisoning the Will" ;
    dc:description "A ritual spell that curses a place such as a valley, town, city, or covenant, gradually sapping the will and vitality from the people there." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:PoliticalAgent a rpg:Tag ;
    skos:prefLabel "Political Agent" ;
    dc:description "A thematic covenfolk template skilled in Intrigue, Guile, and Order of Hermes Lore, employed by covenants involved in Hermetic politics." ;
    rpg:hasTag amol:CharacterType .
amol:PolluteWater a rpg:Spell ;
    rpg:name "Pollute Water" ;
    dc:description "An Aquam power of the basilisk Sordus that turns all standing water within 5 paces stagnant and putrefies other liquids; he cannot control it." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:PomeranianForest a schema:Place ;
    rpg:name "Pomeranian Forest" ;
    dc:description "One of Germany's most oppressive forests, dominated by pine, fir, holly, and evergreen oak; reputedly a stronghold of witches and werewolves and home to the sacred grove of Romowe." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:PomeranianTradition a rpg:Faction ;
    rpg:name "Pomeranian tradition" ;
    dc:description "A surviving pre-Hermetic magical tradition with which some of Bjornaer's descendants seek détente, fearing their Founder left it before learning all its rites." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:PoorCharacteristic a rpg:Tag ;
    skos:prefLabel "Poor (Characteristic)" ;
    dc:description "A Minor General Flaw lowering a Characteristic already at -3 or lower by one further point." ;
    rpg:hasTag amol:Flaw .
amol:PoorConcentration a rpg:Tag ;
    skos:prefLabel "Poor Concentration" ;
    dc:description "A Minor General Flaw giving the character a -3 penalty to Concentration rolls due to a short attention span." ;
    rpg:hasTag amol:Flaw .
amol:PoorDisputer a rpg:Tag ;
    skos:prefLabel "Poor Disputer" ;
    dc:description "A Minor General Flaw causing a character to suffer a -3 penalty on disputatio die rolls." ;
    rpg:hasTag amol:Flaw .
amol:PoorFormulaicMagic a rpg:Tag ;
    skos:prefLabel "Poor Formulaic Magic" ;
    dc:description "A Minor Hermetic Flaw subtracting 5 from every roll to cast Formulaic spells, though not Ritual spells." ;
    rpg:hasTag amol:Flaw .
amol:PoorLivingConditions a rpg:Tag ;
    skos:prefLabel "Poor Living Conditions" ;
    dc:description "A Minor General Flaw giving an additional -1 Living Conditions Modifier, cumulative with the base modifier." ;
    rpg:hasTag amol:Flaw .
amol:PoorReader a rpg:Tag ;
    skos:prefLabel "Poor Reader" ;
    dc:description "A common Flaw among the exsules, most of whom have studied from vis for their entire careers." ;
    skos:altLabel "Poor Reader Flaw" ;
    rpg:hasTag amol:Flaw .
amol:PoorStudent a rpg:Tag ;
    skos:prefLabel "Poor Student" ;
    dc:description "A Minor General Flaw subtracting 3 from Advancement Totals derived from teaching and books." ;
    rpg:hasTag amol:Flaw .
amol:PoorlyInsulated a rpg:Tag ;
    skos:prefLabel "Poorly Insulated" ;
    dc:description "A Minor laboratory Structure Flaw: the lab is poorly shielded from the outside, easily overheard and a nuisance to neighbors (-1 Safety, -1 Aesthetics)." ;
    rpg:hasTag amol:Flaw .
amol:Pope a rpg:Tag ;
    skos:prefLabel "Pope" ;
    dc:description "The head of the Church, granted by the Divine a Magic Resistance of 25 (the highest among listed leaders) and an Aura of Rightful Authority, lost upon excommunication." ;
    rpg:hasTag amol:CharacterType .
amol:PopeAlexanderIII a rpg:Character ;
    rpg:name "Pope Alexander III" ;
    dc:description "Pope who issued an 1179 decree, followed by most communities, requiring the expulsion of lepers." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:PopeGregoryVII a rpg:Character ;
    rpg:name "Pope Gregory VII" ;
    dc:description "A church reformer who decreed in 1079 that all cathedrals must make schooling compulsory for priests." ;
    skos:altLabel "Pope Gregory" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:PopeGregoryTheGreat a rpg:Character ;
    rpg:name "Pope Gregory the Great" ;
    dc:description "A pope, later a saint, at whose earnest request God allowed the Roman Emperor Trajan to be saved after death, with a warning not to ask such things again." ;
    skos:altLabel "Pope Gregory" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:PopeInnocentIII a rpg:Character ;
    rpg:name "Pope Innocent III" ;
    dc:description "The pope who established Dominic's Order in 1216, sanctioned the Franciscans, recognized subdeacons as a major order, and was himself a university man." ;
    skos:altLabel "Innocent III" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:PotPlants a rpg:Tag ;
    skos:prefLabel "Pot Plants" ;
    dc:description "A Minor laboratory Outfittings Virtue: the lab contains dozens of potted plants (+1 Upkeep, +1 Aesthetics, +1 Herbam)." ;
    rpg:hasTag amol:Virtue .
amol:PotentSpells a rpg:Tag ;
    skos:prefLabel "Potent Spells" ;
    dc:description "Spells that gain a Potency bonus to Casting Score derived from Casting Items combined into the spell's design." ;
    skos:altLabel "Potent spell" ;
    rpg:hasTag amol:HermeticConcept .
amol:PoundOfEnumerus a rpg:Tag ;
    skos:prefLabel "Pound of Enumerus" ;
    dc:description "A Hermetic accounting concept named after the magus Enumerus: at least one pound of covenant spending each year that can never be fully accounted for." ;
    rpg:hasTag amol:HermeticConcept .
amol:Powys a schema:Place ;
    rpg:name "Powys" ;
    dc:description "An ancient Welsh principality in the central regions, centered on the fort of Mathrafal; home of Gwenwynwyn and the abbey of Strata Florida." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:PraefactusOfBonisagus a rpg:Character ;
    rpg:name "Praefactus of Bonisagus" ;
    dc:description "A magus of House Bonisagus whose wizard's sigil makes him appear as dignified as possible; his version of Seven-league Stride always lets him arrive in a safe place." ;
    skos:altLabel "Praefactus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Prague a schema:Place ;
    rpg:name "Prague" ;
    dc:description "Bohemia's principal settlement, straddling the River Vltava, with Prague Castle, the Basilicas of St. George and St. Vitus, and a large slave market controlled by the Knights of the Sword." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Preaching a rpg:Proficiency ;
    rpg:name "Preaching" ;
    dc:description "A Profession-type Ability used to emotionally influence an audience or teach Theology; in 1220 almost exclusively practiced by Dominican friars." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:Precarious a rpg:Tag ;
    skos:prefLabel "Precarious" ;
    dc:description "A Minor laboratory Supernatural Flaw: the lab sits in a supernaturally dangerous place such as inside a volcano (-1 Safety)." ;
    rpg:hasTag amol:Flaw .
amol:PreciousIngredients a rpg:Tag ;
    skos:prefLabel "Precious Ingredients" ;
    dc:description "A Free laboratory Outfittings Virtue: the lab is supplied with more expensive ingredients than typical (+1 General Quality, +2 Upkeep, +1 Longevity Rituals)." ;
    rpg:hasTag amol:Virtue .
amol:Predecessor a rpg:Tag ;
    skos:prefLabel "Predecessor" ;
    dc:description "A Minor laboratory Supernatural Flaw: the lab retains foibles of its notable previous owner (-1 Safety, +1 Warping, +1 Experimentation)." ;
    rpg:hasTag amol:Flaw .
amol:PredictiveStigmata a rpg:Tag ;
    skos:prefLabel "Predictive Stigmata" ;
    dc:description "A Minor Story Supernatural Flaw whose stigmata predict future challenges symbolically and may flee the body to become adulterations if ignored." ;
    rpg:hasTag amol:Flaw .
amol:PrelumOfTremere a rpg:Character ;
    rpg:name "Prelum of Tremere" ;
    dc:description "Goliard's filia at Blackthorn, a polite young maga with a remarkable talent for Vim, contrasting with her sister Fornax." ;
    skos:altLabel "Prelum" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Premonstratensians a rpg:Faction ;
    rpg:name "Premonstratensians" ;
    dc:description "An order of regular canons relying on the Rule of St. Augustine." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Premysl a rpg:Character ;
    rpg:name "Premysl" ;
    dc:description "A farmer found plowing with two oxen who became Libuse's husband and the founder of Bohemia's ruling Premyslid dynasty." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Preserved a rpg:Tag ;
    skos:prefLabel "Preserved" ;
    dc:description "A Free laboratory Supernatural Virtue: the lab or its contents are immune to natural decay (-1 Upkeep, +1 Warping, +2 Health, +1 Aesthetics, +1 Creo)." ;
    rpg:hasTag amol:Virtue .
amol:Pretense a rpg:Tag ;
    skos:prefLabel "Pretense" ;
    dc:description "A faerie's skill in mimicking a particular human Ability through glamour; not quite the same as an Ability, a skilled observer may detect its use to reveal a faerie's nature." ;
    rpg:hasTag amol:HermeticConcept .
amol:PreternaturalGrowthAndShrinking a rpg:Spell ;
    rpg:name "Preternatural Growth and Shrinking" ;
    dc:description "A Muto Corpus spell (Level 15) that adds +1 to the target's Size or decreases it by up to 2 points." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:PrevailingDiscipline a rpg:Tag ;
    skos:prefLabel "Prevailing Discipline" ;
    dc:description "An optional measure, tracked like Prevailing Loyalty, of how disciplined a covenant's covenfolk are, modifying rolls related to their duties." ;
    rpg:hasTag amol:HermeticConcept .
amol:Priam a rpg:Character ;
    rpg:name "Priam" ;
    dc:description "The elderly faerie lord of Ilium who claims descent from Zeus and granted the town its charter; his son Paris hosts a beauty contest at the mid-summer fair." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Priamitus a rpg:Character ;
    rpg:name "Priamitus" ;
    dc:description "Son of Mercere who sought out hedge wizards of the Cult of Mercury and worked to reconstruct the Roman cult, bringing the Mercurians into House Flambeau." ;
    skos:altLabel "Mercere's son", "Priamatus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:PricelessIngredients a rpg:Tag ;
    skos:prefLabel "Priceless Ingredients" ;
    dc:description "A Free laboratory Outfittings Virtue: the lab is supplied with copious gold and gems (+2 General Quality, +4 Upkeep, +2 Longevity Rituals)." ;
    rpg:hasTag amol:Virtue .
amol:PrimeQualities a rpg:Tag ;
    skos:prefLabel "Prime Qualities" ;
    dc:description "Properties of a thing derived from its matter and essential form, including the elemental mixture of hot, cold, moisture and dryness, readily discerned with the senses." ;
    rpg:hasTag amol:HermeticConcept .
amol:PrimitiveEquipment a rpg:Tag ;
    skos:prefLabel "Primitive Equipment" ;
    dc:description "A Minor General Flaw in which the character can use only the simplest tools and equipment, suffering penalties when forced to use anything beyond Inexpensive weapons and armor." ;
    rpg:hasTag amol:Flaw .
amol:PrimusJohannes a rpg:Character ;
    rpg:name "Primus Johannes" ;
    dc:description "A non-magus notary who unexpectedly claimed Criamon Primacy; his ghost is the House expert in Hermetic legal precedent and he secured the Privileges of Criamon." ;
    skos:altLabel "Johannes" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:PrinceOfGwynedd a rpg:Character ;
    rpg:name "Prince of Gwynedd" ;
    dc:description "A Welsh noble who has expressed interest in examining the seemingly immortal Gwrhyr; a court date has been set in the Fate of Cad Gadu story." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Principal a rpg:Tag ;
    skos:prefLabel "Principal" ;
    dc:description "A character (often a magus) who controls an agency of agents." ;
    rpg:hasTag amol:CharacterType .
amol:PrincipiaMagica a rpg:Item ;
    rpg:name "Principia Magica" ;
    dc:description "The authoritative summa on Magic Theory written by Bonisagus; the Great Library holds three copies." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:PripetMajor a rpg:Faction ;
    rpg:name "Pripet Major" ;
    dc:description "A covenant in the Novgorod Tribunal near the terminus of the one-way faerie trod from the Ziegensteine on Rugen." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:PripetMarshes a schema:Place ;
    rpg:name "Pripet Marshes" ;
    dc:description "A wilderness ancestor site in the Novgorod Tribunal, the supposed origin of all the Slavic people, protected by the covenant Pripet Maior." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:PrisonOfFlames a rpg:Spell ;
    rpg:name "Prison of Flames" ;
    dc:description "A Muto Ignem spell (Level 20) that turns a bonfire into a prison shaped like a miniature castle; a person inside is unburned but takes +15 damage trying to escape." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:PrivilegesOfCriamon a rpg:Tag ;
    skos:prefLabel "Privileges of Criamon" ;
    dc:description "A Grand Tribunal ruling that allows for House Criamon customs such as the ceremonial slaying of a willing Primus." ;
    rpg:hasTag amol:HermeticConcept .
amol:ProbeNatureSHiddenLore a rpg:Spell ;
    rpg:name "Probe Nature's Hidden Lore" ;
    dc:description "An Intellego Herbam spell (Level 4) that tells you what kind of plant you are touching and gives an image of it in its natural habitat." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ProbeForPureSilver a rpg:Spell ;
    rpg:name "Probe for Pure Silver" ;
    dc:description "An Intellego Terram spell that lets the caster smell silver and follow the scent." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ProductionArtist a rpg:Tag ;
    skos:prefLabel "Production Artist" ;
    dc:description "An artist who produces tangible artwork using a Craft Ability, akin to a craftsman, taking the Social Status Virtue Craftsman." ;
    skos:altLabel "Producers", "production artists" ;
    rpg:hasTag amol:CharacterType .
amol:ProfessionChamberlain a rpg:Proficiency ;
    rpg:name "Profession: Chamberlain" ;
    dc:description "A Profession Ability used (with Presence) to compute the loyalty bonus contributed by a Chamberlain specialist." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:ProfessionMarshal a rpg:Proficiency ;
    rpg:name "Profession: Marshal" ;
    dc:description "A Profession Ability dealing with understanding, purchasing, and caring for horses, functioning like Medicine for veterinary treatment." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:ProfessionMasterOfKennels a rpg:Proficiency ;
    rpg:name "Profession: Master of Kennels" ;
    dc:description "A Profession Ability governing the care of dogs, treatment of their diseases, and acquisition and breeding of hounds." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:ProfessionMinnesinger a rpg:Proficiency ;
    rpg:name "Profession: Minnesinger" ;
    dc:description "A Profession Ability for the German minstrel art; Wolfram von Eschenbach uses it to determine his songs' Aesthetic Quality." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:ProfessionTrouvRe a rpg:Proficiency ;
    rpg:name "Profession: Trouvère" ;
    dc:description "A Profession Ability for the northern French minstrel art; Brogo uses it to compose and perform songs with a high Aesthetic Quality." ;
    skos:altLabel "Performance: Trouvère" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:PrognosisTotal a rpg:Tag ;
    skos:prefLabel "Prognosis Total" ;
    dc:description "A medical total (Intelligence + Medicine + modifiers) compared against a disease's severity to determine whether a physician is skilled enough to plan therapy." ;
    rpg:hasTag amol:HermeticConcept .
amol:Prohibition a rpg:Tag ;
    skos:prefLabel "Prohibition" ;
    dc:description "A Minor Supernatural Flaw in which the character has had a Conditional Curse (Geas) cast upon him and must obey its restrictions or suffer the curse in full." ;
    skos:altLabel "Conditional Curse", "Geas" ;
    rpg:hasTag amol:Flaw .
amol:ProlificArtist a rpg:Tag ;
    skos:prefLabel "Prolific Artist" ;
    dc:description "A Minor Supernatural Virtue that reduces the time to create a piece of artwork by one quarter, but prevents the use of assistants." ;
    rpg:hasTag amol:Virtue .
amol:ProneToChance a rpg:Tag ;
    skos:prefLabel "Prone to Chance" ;
    dc:description "A Minor Ordeal Flaw making a Verditius magus keen on risk-taking, forcing experimentation on every applicable laboratory activity; incompatible with Averse to Risk." ;
    rpg:hasTag amol:Flaw .
amol:Protagoras a rpg:Character ;
    rpg:name "Protagoras" ;
    dc:description "A Sophist quoted in the Analects of Tytalus who taught that humans are the yardstick for deciding what is real, and that there is no independent truth." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:ProtectedGuest a rpg:Tag ;
    skos:prefLabel "Protected Guest" ;
    dc:description "A covenant membership status extended to visitors by a single full member, affording basic rights but no vote or council obligation." ;
    rpg:hasTag amol:CharacterType .
amol:Protector a rpg:Tag ;
    skos:prefLabel "Protector" ;
    dc:description "An honorary Durenmar title for the magus responsible for the covenant's martial defense, traditionally a Flambeau; currently held by Philippus Niger." ;
    rpg:hasTag amol:CharacterType .
amol:Psychodrama a rpg:Tag ;
    skos:prefLabel "Psychodrama" ;
    dc:description "An allegorical story taking place in the mind of a meditating Criamon magus, amounting to spiritual combat against the self, used to dramatize introspective avenues." ;
    skos:altLabel "psychodramatic story" ;
    rpg:hasTag amol:HermeticConcept .
amol:PuissantArtesLiberales a rpg:Tag ;
    skos:prefLabel "Puissant Artes Liberales" ;
    dc:description "A Virtue making a character particularly adept with all seven liberal arts; the Sons of the Peters receive an Infernally tainted version from demonic tempters." ;
    rpg:hasTag amol:Virtue .
amol:PuissantAwareness a rpg:Tag ;
    skos:prefLabel "Puissant Awareness" ;
    dc:description "A species Virtue of the Familiar Cat granting a bonus to the Awareness Ability." ;
    rpg:hasTag amol:Virtue .
amol:PuissantCorpus a rpg:Tag ;
    skos:prefLabel "Puissant Corpus" ;
    dc:description "The Minor Hermetic Virtue of the Damhadh-Duidsan tradition, granting bonus effective Corpus." ;
    rpg:hasTag amol:Virtue .
amol:PuissantCraftOrProfessionAbility a rpg:Tag ;
    skos:prefLabel "Puissant Craft or Profession Ability" ;
    dc:description "A Minor Virtue a maestro may select at no cost, granting a bonus to a Craft or Profession Ability such as Painting." ;
    skos:altLabel "Puissant Painter", "Puissant Painting" ;
    rpg:hasTag amol:Virtue .
amol:PuissantEnchantingMusic a rpg:Tag ;
    skos:prefLabel "Puissant Enchanting Music" ;
    dc:description "A Virtue adding a bonus to the Enchanting Music Ability; held by the Minstrel template." ;
    rpg:hasTag amol:Virtue .
amol:PuissantEnigmaticWisdom a rpg:Tag ;
    skos:prefLabel "Puissant Enigmatic Wisdom" ;
    dc:description "A Hermetic Virtue gained as the first Fruit of the Path of Warping." ;
    rpg:hasTag amol:Virtue .
amol:PuissantHeartbeast a rpg:Tag ;
    skos:prefLabel "Puissant Heartbeast" ;
    dc:description "A common Virtue for Bjornaer magi giving a bonus to the Heartbeast Ability." ;
    rpg:hasTag amol:Virtue .
amol:PuissantImaginem a rpg:Tag ;
    skos:prefLabel "Puissant Imaginem" ;
    dc:description "A Minor Hermetic Virtue boosting the Imaginem Art, available to Confraternity of Irene Initiates." ;
    rpg:hasTag amol:Virtue .
amol:PuissantIntellego a rpg:Tag ;
    skos:prefLabel "Puissant Intellego" ;
    dc:description "A Hermetic Virtue granting a bonus to the Intellego Technique; possessed by Tabanus." ;
    rpg:hasTag amol:Virtue .
amol:PuissantMedicine a rpg:Tag ;
    skos:prefLabel "Puissant Medicine" ;
    dc:description "A Virtue that enhances a character's effective Medicine Ability score." ;
    rpg:hasTag amol:Virtue .
amol:PuissantMentem a rpg:Tag ;
    skos:prefLabel "Puissant Mentem" ;
    dc:description "A Minor Hermetic Virtue boosting the Mentem Art, available to Confraternity of Irene Initiates." ;
    rpg:hasTag amol:Virtue .
amol:PuissantSwordsmith a rpg:Tag ;
    skos:prefLabel "Puissant Swordsmith" ;
    dc:description "A Virtue providing a bonus to the Swordsmith Craft Ability, held by the example craftsman Klaus." ;
    rpg:hasTag amol:Virtue .
amol:Pulch a rpg:Character ;
    rpg:name "Pulch" ;
    dc:description "A magus of House Merinita who haunts the Kammerforst posing as a Waldgeist, chastising those who steal wood, and skirts close to the edge of Hermetic Law." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:PullOfTheWateryGrave a rpg:Spell ;
    rpg:name "Pull of the Watery Grave" ;
    dc:description "A Rego Aquam spell (Level 35) that creates a strong undertow pulling objects smaller than a rowboat 25 fathoms into the depths." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Purgatory a rpg:Tag ;
    skos:prefLabel "Purgatory" ;
    dc:description "A realm beyond Mythic Europe; summoning a spirit residing there requires a Ritual spell." ;
    rpg:hasTag amol:Realm .
amol:PurificationOfTheFesteringWound a rpg:Spell ;
    rpg:name "Purification of the Festering Wound" ;
    dc:description "A Creo Corpus spell that provides a bonus to a wound Recovery roll, adding to any bonus from medical attention." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:PushOfTheGentleWave a rpg:Spell ;
    rpg:name "Push of the Gentle Wave" ;
    dc:description "A Rego Aquam spell (Level 15) that forms a low wave to propel a small boat slowly through the water." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Pyramids a schema:Place ;
    rpg:name "Pyramids" ;
    dc:description "Monuments in Egypt near which magi established a covenant and a desert laboratory beside the great Sphinx." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Pyrenees a schema:Place ;
    rpg:name "Pyrenees" ;
    dc:description "The mountain range between France and Spain where Flambeau hid in a cave, founded Val-Negra, and where his lost talisman is thought to lie." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:QuaertusOfBonisagus a rpg:Character ;
    rpg:name "Quaertus of Bonisagus" ;
    dc:description "A magus of House Bonisagus credited as author of the encyclopedia De Ordinis Hermetici, covering the Code of Hermes and Order of Hermes Lore." ;
    skos:altLabel "Quaertus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:QuarterDays a rpg:Tag ;
    skos:prefLabel "Quarter Days" ;
    dc:description "The four festival days marking the mid-points of the Hermetic stellar seasons, cited as good days for covenant meetings." ;
    skos:altLabel "All Hallows Day", "Candlemas", "Lammas", "May Day" ;
    rpg:hasTag amol:HermeticConcept .
amol:Quaternuli a rpg:Item ;
    rpg:name "Quaternuli" ;
    dc:description "David of Dinant's confiscated book of 'little note-books'; a tractatus describing the Infernal Virtue Incantation with a Quality of 13." ;
    skos:altLabel "Quaternui" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:Quedlinburg a schema:Place ;
    rpg:name "Quedlinburg" ;
    dc:description "A Saxon town that was briefly the German capital under Henry the Fowler, later ruled by abbesses of a collegiate foundation; the lair of the Boglin lies near it." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:QueenIsabella a rpg:Character ;
    rpg:name "Queen Isabella" ;
    dc:description "The king's mother and countess of Angoulême, wife of Hugh de Lusignan, threatening to withdraw her support unless she receives more aid." ;
    skos:altLabel "countess of Angoulême" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:QueenOfSnowflakes a rpg:Creature ;
    rpg:name "Queen of Snowflakes" ;
    dc:description "A powerful faerie, former lover of the Blackberry God, who controls the land above the tree-line and obstructs the Worshipful covenant's vis collection." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:QueenOfWinter a rpg:Creature ;
    rpg:name "Queen of Winter" ;
    dc:description "A powerful supernatural being who holds the Baltic Sea in ice each winter; she is propitiated by the ritual spell Appease the Queen of Winter and opposed by the sun-god Svantovit." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:QuenchTheRagingConflagration a rpg:Spell ;
    rpg:name "Quench the Raging Conflagration" ;
    dc:description "A PeIg 20 spell that extinguishes any fire up to the size of a house fire, learned by many Flambeau magi to control accidental Creo Ignem fires." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:QuietTheCursingTongue a rpg:Spell ;
    rpg:name "Quiet the Cursing Tongue" ;
    dc:description "A ReVi spell of the Lineage of Pralix that prevents a target from using lower-level curse magic." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:QuietTheRagingWinds a rpg:Spell ;
    rpg:name "Quiet the Raging Winds" ;
    dc:description "A Perdo Auram spell (Level 20) that stops all wind from blowing on the caster, leaving only calm air." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Quinotaur a rpg:Creature ;
    rpg:name "Quinotaur" ;
    dc:description "A creature of Neptune that, in legend, seduced and impregnated Merovech's mother in the sea, giving Merovech two fathers and a magical bloodline." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Quinsy a rpg:Creature ;
    rpg:name "Quinsy" ;
    dc:description "A Serious Phlegmatic Disease contracted from swallowing worms that live in and swell the tonsils." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Quintus a rpg:Character ;
    rpg:name "Quintus" ;
    dc:description "A magus used as an example for writing books, with Ignem 24, Communication -1, and Language 5, who writes an Ignem summa." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Rabies a rpg:Creature ;
    rpg:name "Rabies" ;
    dc:description "A Serious Choleric Disease caused by the bite of a mad dog, inflaming the choler and reducing the sufferer's mind to that of a furious beast." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:RainOfOil a rpg:Spell ;
    rpg:name "Rain of Oil" ;
    dc:description "A Muto Auram ritual (Level 50) that turns rain into droplets of flammable oil, drenching the landscape; can be ignited with Creo Ignem magic." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:RaisedFromTheDead a rpg:Tag ;
    skos:prefLabel "Raised from the Dead" ;
    dc:description "A Major Story Supernatural Flaw in which the character died and was brought back through a holy miracle, beginning with at least three Warping points plus more over time." ;
    rpg:hasTag amol:Flaw .
amol:RaisedInTheGutter a rpg:Tag ;
    skos:prefLabel "Raised in the Gutter" ;
    dc:description "A Minor General Flaw in which the character was raised on the margins of society and suffers -3 when using social Abilities among her betters." ;
    rpg:hasTag amol:Flaw .
amol:RalphDeNeville a rpg:Character ;
    rpg:name "Ralph de Neville" ;
    dc:description "The vice-chancellor of England, a bastard son of a baronial family and royal clerk who does almost all the chancellor's work in the absence of the Great Seal." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Ramius a rpg:Character ;
    rpg:name "Ramius" ;
    dc:description "A mid-rank House Tremere magus who defected to House Flambeau after the Sundering of Tremere in 848 AD; skilled in mundane arms, he created the School of Ramius and fought Moorish wizards in Iberia." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:RanulfDeBlundeville a rpg:Character ;
    rpg:name "Ranulf de Blundeville" ;
    dc:description "Earl of Chester since 1180, an elder statesman of England and head of the palatinate of Cheshire, on Crusade in the Holy Land in 1220." ;
    skos:altLabel "Earl of Chester", "Ranulf", "Ranulf, earl of Chester" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Rarefication a rpg:Tag ;
    skos:prefLabel "Rarefication" ;
    dc:description "The magical process by which pure physical matter takes on pseudo-life and self-organizes into an elemental, catalyzed by spells, botches, or spontaneous Warping in a Magic aura." ;
    skos:altLabel "rarefied", "rarefy" ;
    rpg:hasTag amol:HermeticConcept .
amol:RatUpADrainpipe a rpg:Tag ;
    skos:prefLabel "Rat Up a Drainpipe" ;
    dc:description "A Minor General Virtue letting a character run through urban areas unobstructed using acrobatics, climbing, and dodging, aiding opposed Athletics rolls when chased." ;
    rpg:hasTag amol:Virtue .
amol:Realia a rpg:Tag ;
    skos:prefLabel "Realia" ;
    dc:description "Collections of mundane or magical objects (preserved animals, minerals, gemstones, bones) that magi study as a tractatus and use as clues for Intellego magic." ;
    rpg:hasTag amol:HermeticConcept .
amol:RealmInteractionTable a rpg:Tag ;
    skos:prefLabel "Realm Interaction Table" ;
    dc:description "A rules table modifying how the prevailing Aura affects power recovery; Jumayl recovers Might per hour equal to the prevailing Aura as modified by it." ;
    rpg:hasTag amol:HermeticConcept .
amol:RealmsOfPowerFaerie a rpg:Item ;
    rpg:name "Realms of Power: Faerie" ;
    dc:description "An Ars Magica sourcebook whose character creation and advancement rules can handle faerie-realm legendary artists." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:RealmsOfPowerTheInfernal a rpg:Tag ;
    skos:prefLabel "Realms of Power: The Infernal" ;
    dc:description "An Ars Magica sourcebook cited for rules on Infernal Ceremonies and infernalist abilities relevant to the False Power Flaw." ;
    rpg:hasTag amol:HermeticConcept .
amol:Rebellious a rpg:Tag ;
    skos:prefLabel "Rebellious" ;
    dc:description "A Major or Minor Personality Flaw in which the character reacts adversely to any attempt to impose authority and works against those in command." ;
    rpg:hasTag amol:Flaw .
amol:RectorMaris a rpg:Faction ;
    rpg:name "Rector Maris" ;
    dc:description "A covenant founded on the Isle of Man in 866 and destroyed within six months." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:RectorNovus a rpg:Faction ;
    rpg:name "Rector Novus" ;
    dc:description "A covenant founded on the Isle of Man in 938 and destroyed within a year." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:Refinement a rpg:Tag ;
    skos:prefLabel "Refinement" ;
    dc:description "A laboratory Characteristic representing its sophistication; together with Size it sets the space for Virtues, and is improved through seasons of work requiring Magic Theory." ;
    rpg:hasTag amol:HermeticConcept .
amol:ReforgingEnchantedItems a rpg:Tag ;
    skos:prefLabel "Reforging Enchanted Items" ;
    dc:description "A Minor House Mystery of Verditius allowing a magus to repair, smelt, and reforge enchanted items to enhance their magical potential or extract vis." ;
    skos:altLabel "Reforging", "Reforging Enchanted Devices" ;
    rpg:hasTag amol:HermeticConcept .
amol:ReforgingItems a rpg:Tag ;
    skos:prefLabel "Reforging Items" ;
    dc:description "A Minor House Inner Mystery of Verditius for re-forging or repairing items, part of the Confraternity of Roland's mystery path." ;
    skos:altLabel "Reforging" ;
    rpg:hasTag amol:Virtue .
amol:Regimen a rpg:Tag ;
    skos:prefLabel "Regimen" ;
    dc:description "A tailor-made recipe of diet, exercise and bloodletting prescribed by a physician to control the non-naturals and ensure eucrasia, providing a Living Conditions bonus." ;
    rpg:hasTag amol:HermeticConcept .
amol:Reginald a rpg:Character ;
    rpg:name "Reginald" ;
    dc:description "A wandering minstrel who plays a rebec of exceptional quality inherited from his minstrel father; his playing causes Imaginem vis to accumulate in the instrument's bowstrings." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:ReginaldSRebec a rpg:Item ;
    rpg:name "Reginald's Rebec" ;
    dc:description "A three-stringed fiddle of exceptional quality played by the minstrel Reginald; it grants a +3 bonus to Music rolls and accumulates Imaginem vis in its horsehair bowstrings when played well." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:RegoMentem a rpg:Tag ;
    skos:prefLabel "Rego Mentem" ;
    dc:description "A Hermetic Technique-and-Form combination (Control Mind) used to make disloyal covenfolk loyal or to compel obedience regardless of emotion." ;
    rpg:hasTag amol:HermeticConcept .
amol:RegoVim a rpg:Proficiency ;
    rpg:name "Rego Vim" ;
    dc:description "A Hermetic combination governing control of magic; Rego Vim spells and wards can dampen a legendary artist's powers and bar him from areas." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticArt .
amol:Regular a rpg:Tag ;
    skos:prefLabel "Regular" ;
    dc:description "A Minor General Flaw in which the character lives according to a strict religious rule and must spend one free season on worship; suitable for monks and canons." ;
    rpg:hasTag amol:Flaw .
amol:ReismannExMiscellanea a rpg:Character ;
    rpg:name "Reismann Ex Miscellanea" ;
    dc:description "The probable founder of the Rusticani tradition, a hedge wizard who swore the Oath at the Rhine Tribunal of 963 and wrote a summa on Craft Masonry." ;
    skos:altLabel "Reismann" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:RelicsOfTheThreeMagi a rpg:Item ;
    rpg:name "Relics of the Three Magi" ;
    dc:description "A fabulous golden casket in Cologne's cathedral containing the bones of the three wise men who visited the infant Jesus, taken from Milan by Frederick Barbarossa in 1164." ;
    skos:altLabel "Three Kings", "relics of the three wise men" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:Religious a rpg:Tag ;
    skos:prefLabel "Religious" ;
    dc:description "A Minor Social Status Virtue for a monk, nun, beguine, anchoress, anchorite, holy hermit, or similar religious figure." ;
    rpg:hasTag amol:Virtue .
amol:Relisius a rpg:Character ;
    rpg:name "Relisius" ;
    dc:description "A contemporary House Bonisagus magus well known for his Christian faith and advocacy of harmony between Magic and the Divine." ;
    skos:altLabel "Archmagus Relisius" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Relocation a rpg:Tag ;
    skos:prefLabel "Relocation" ;
    dc:description "A Free laboratory Supernatural Virtue: the lab's physical-world location can be magically adjusted, e.g. via a powerful Rego Terram effect." ;
    rpg:hasTag amol:Virtue .
amol:RemiOfMuseau a rpg:Character ;
    rpg:name "Remi of Museau" ;
    dc:description "A friendly, effusive 48-year-old Master magus of House Jerbiton at Triamore, a veritable polymath accomplished in mundane tasks and magic alike." ;
    skos:altLabel "Remi" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:RemoraOfVirtue a rpg:Creature ;
    rpg:name "Remora of Virtue" ;
    dc:description "A symbolic fish whose fins provide a Shape and Material bonus of +7 to slowing or halting a moving object." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:RemovalOfTheConspicuousSigil a rpg:Spell ;
    rpg:name "Removal of the Conspicuous Sigil" ;
    dc:description "A Perdo Imaginem spell (Level 20) that obscures grooves, runes, and writings so they are not visible while the overall shape of the medium remains, e.g. hiding runes on a sword blade." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ReorderTheContentsOfTheArmarius a rpg:Spell ;
    rpg:name "Reorder the Contents of the Armarius" ;
    dc:description "A Rego Animal 10 spell with Intellego requisite that sorts books in a chest or closet into a chosen sequence; an optional Mentem requisite raises it to level 15 for emotional or read-status sorting." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:RepairCracksAndTears a rpg:Spell ;
    rpg:name "Repair Cracks and Tears" ;
    dc:description "A Creo Animal 20 ritual that heals cracks and tears in the parchment and leather of a book, used for historically significant works like Bonisagus's diaries." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Repellent a rpg:Tag ;
    skos:prefLabel "Repellent" ;
    dc:description "A Major General Tainted Flaw in which the character has a physical characteristic of his demonic creator, causing -6 to rolls requiring trust but granting a minor advantage." ;
    rpg:hasTag amol:Flaw .
amol:ReplenishingTheFountOfTheMagus a rpg:Spell ;
    rpg:name "Replenishing the Fount of the Magus" ;
    dc:description "A CrCo 30 spell created by Terious of Flambeau allowing a magus on the Path of Energy to restore lost Fatigue levels from the forest; recorded in the Great Library but never successfully cast." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Resonance a rpg:Tag ;
    skos:prefLabel "Resonance" ;
    dc:description "The sympathetic link between a Hermetic book's construction materials and its subject; resonant materials add quality points to a book studied by magi." ;
    skos:altLabel "Resonances", "mystical resonance" ;
    rpg:hasTag amol:HermeticConcept .
amol:RestlessDead a rpg:Creature ;
    rpg:name "Restless Dead" ;
    dc:description "Corporeal dead rising from graves and ghostly visitations that terrorize Mythic Europe; the Donatores combat or quiet them, distinguishing Infernal from Magic or Faerie origins." ;
    skos:altLabel "walking dead" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:RestoreTheFadedThreads a rpg:Spell ;
    rpg:name "Restore the Faded Threads" ;
    dc:description "A Creo Vim spell that temporarily restores faded spell traces to a fresh state so they can be examined." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:RestoreTheMovedImage a rpg:Spell ;
    rpg:name "Restore the Moved Image" ;
    dc:description "A Rego Imaginem (General) spell that cancels a Rego Imaginem spell which moved an image, putting the image back where it belongs if the caster matches the spell's level." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:RestrictedLearning a rpg:Tag ;
    skos:prefLabel "Restricted Learning" ;
    dc:description "A Minor General Flaw in which the character can only apply experience points to five chosen Abilities and cannot learn new Abilities without Teaching or Training; required of all mundane animals." ;
    rpg:hasTag amol:Flaw .
amol:RestrictionTrueFeeling a rpg:Tag ;
    skos:prefLabel "Restriction (True Feeling)" ;
    dc:description "A Major Hermetic Flaw of the Cult of Orpheus." ;
    rpg:hasTag amol:Flaw .
amol:RetetariusBjornaer a rpg:Character ;
    rpg:name "Retetarius Bjornaer" ;
    dc:description "Deputy chief of Clan Wilkis appointed by the prima, with a salmon heartbeast, dwelling in the River Danube." ;
    skos:altLabel "Retetarius" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:RevealTheHiddenWords a rpg:Spell ;
    rpg:name "Reveal the Hidden Words" ;
    dc:description "A MuAq 5 charged-item effect that makes any group of words written in the enchanted colorless liquid visible for a Diameter duration." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:RevealTheLurkingWatchers a rpg:Spell ;
    rpg:name "Reveal the Lurking Watchers" ;
    dc:description "An InVi 30 spell that allows the caster to see creatures of the Magic realm within his field of view and identify them as possessing Magic Might." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:RevealTheMagicalDeception a rpg:Spell ;
    rpg:name "Reveal the Magical Deception" ;
    dc:description "A new Intellego Vim spell (InVi 25) invented for Tabanus, designed to overcome spells that hide traces of magic such as Masking the Odor of Magic." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:RevealedFlawsOfMortalFlesh a rpg:Spell ;
    rpg:name "Revealed Flaws of Mortal Flesh" ;
    dc:description "An Intellego Corpus spell (Level 10) that finds any medical defects in a person or being touched, more specific than Physician's Eye." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:RevealedFlawsOfTheMortalFlesh a rpg:Spell ;
    rpg:name "Revealed Flaws of the Mortal Flesh" ;
    dc:description "A spell that instantly diagnoses a disease's cause and effect and adds +3 to the Prognosis total if the character designs the follow-up treatment." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:RevengeOfTheBittenToad a rpg:Spell ;
    rpg:name "Revenge of the Bitten Toad" ;
    dc:description "A PeAn 20 Flavor-Target spell inflicting a Heavy Wound on any creature that bites or tastes the caster." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:RewritingTheMind a rpg:Spell ;
    rpg:name "Rewriting the Mind" ;
    dc:description "A Muto Mentem Ritual that utterly changes the target's cognitive goals, hopes and desires to an agenda dictated by the magus." ;
    skos:altLabel "MuMe 45" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Rhiannon a rpg:Character ;
    rpg:name "Rhiannon" ;
    dc:description "A timid maga named Prima of House Merinita at the Grand Tribunal of 997, four generations descended from Quendalon; she defended House Diedne during the Schism War and died of old age." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:RhineMainDanubeCanal a schema:Place ;
    rpg:name "Rhine-Main-Danube Canal" ;
    dc:description "A proposed canal connecting the Main (a Rhine tributary) and the Danube to create a trade corridor across the continent, around which a saga could be designed." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Rhinegold a rpg:Item ;
    rpg:name "Rhinegold" ;
    dc:description "The lost treasure of the Nibelungs, possibly located at the Rhinefalls and jealously guarded by the powerful Rhine elemental in revenge for his entrapment." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:Rhonabwy a rpg:Character ;
    rpg:name "Rhonabwy" ;
    dc:description "A warrior of Powys who, sleeping on an ox-skin in a foul hall, dreamed of being taken by Iddawg to King Arthur's court where ravens battled Arthur's men." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Rhone a schema:Place ;
    rpg:name "Rhone" ;
    dc:description "A river that ends at the wild, inhospitable Camargue Delta where a ghostly horse keeps a larder of wicked children." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:RichardRufusTheDeacon a rpg:Character ;
    rpg:name "Richard Rufus the Deacon" ;
    dc:description "A learned theologian scholar at Schola Pythagoranis who writes tracts justifying the use of magic for virtuous ends, risking trouble with church authorities." ;
    skos:altLabel "Richard Rufus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:RichendaSpinosa a rpg:Character ;
    rpg:name "Richenda Spinosa" ;
    dc:description "An atypical journeyman maga of House Flambeau at Irencillia of secret faerie heritage descended from Kupala; her scarred Gift left her unable to use fire magic, so she turned to Herbam thorn magic and seeks vengeance on her master Indulius." ;
    skos:altLabel "Richenda" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:RingsOfVerditius a rpg:Item ;
    rpg:name "Rings of Verditius" ;
    dc:description "Five magic rings, one for each finger and thumb, that Verditius forged from all he had learned, perhaps the most powerful magic rings in Hermetic history." ;
    skos:altLabel "five rings", "the rings" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:Ripper a rpg:Tag ;
    skos:prefLabel "Ripper" ;
    dc:description "A Minor Supernatural Virtue with two inflexible powers: destroying cloth or disemboweling an animal at Sight range without words or gestures." ;
    rpg:hasTag amol:Virtue .
amol:RiseOfTheFeatheryBody a rpg:Spell ;
    rpg:name "Rise of the Feathery Body" ;
    dc:description "A Rego Corpus spell (Level 10) that allows the target to float vertically to any height carrying up to 50 pounds, but not move horizontally." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:RisingPassion a rpg:Spell ;
    rpg:name "Rising Passion" ;
    dc:description "A Creo Mentem 15 spell invented by Imanitos Mendax that raises uncontrollable carnal lust in a target." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:RitualPower a rpg:Tag ;
    skos:prefLabel "Ritual Power" ;
    dc:description "A Major Supernatural Virtue giving an at-will supernatural power equivalent to a Ritual Hermetic spell of level 25 or lower, costing Fatigue and Confidence." ;
    rpg:hasTag amol:Virtue .
amol:RobertWood a rpg:Character ;
    rpg:name "Robert Wood" ;
    dc:description "An outlaw of Yorkshire in the late 1100s, presumed a rustic-magic hedge wizard and exceptional archer/bowyer/fletcher with magic in his craft, registered as a vis source by Voluntas covenant." ;
    skos:altLabel "Robert" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:RobinHood a rpg:Character ;
    rpg:name "Robin Hood" ;
    dc:description "Cited as a legendary example of crime income, operating with demonic assistance." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Roland a rpg:Character ;
    rpg:name "Roland" ;
    dc:description "A great Frankish knight, one of Charlemagne's 12 peers, slain at the Battle of Roncesvals in 778, who wielded the magic sword Durendal forged by Wayland with Verditius as apprentice." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:RollingStone a rpg:Tag ;
    skos:prefLabel "Rolling Stone" ;
    dc:description "A Minor General Flaw in which the character has moved so often that she finds it hard to form community attachments, giving -1 to social rolls within a community." ;
    rpg:hasTag amol:Flaw .
amol:RollrightStones a schema:Place ;
    rpg:name "Rollright Stones" ;
    dc:description "A thirty-meter stone circle of twenty-five stones in Oxfordshire, said to be a petrified army and its king; includes the King Stone whose chips ward against demons, watched over by a witch in the form of an elder tree." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:RomaNova a rpg:Faction ;
    rpg:name "Roma Nova" ;
    dc:description "A covenant of traditionalist Latin magi founded in Kent in 946, unpopular with Bjornaer, Díedne, and Ex Miscellanea; destroyed by the Díedne in 1008." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:RomanEmperorTrajan a rpg:Character ;
    rpg:name "Roman Emperor Trajan" ;
    dc:description "A Roman emperor whom God allowed to be saved after death at the request of Pope Gregory the Great." ;
    skos:altLabel "Trajan" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Romer a rpg:Creature ;
    rpg:name "Romer" ;
    dc:description "A young giant of Romerstein castle who fell in love with and secretly married Ruma, daughter of the dwarf king." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:RomoweOak a schema:Place ;
    rpg:name "Romowe Oak" ;
    dc:description "A surviving magical forest spirit of Pomerania in the Eastern Marches; it is likely to possess seekers who attempt communion with it." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:RoomOfStaleAir a rpg:Spell ;
    rpg:name "Room of Stale Air" ;
    dc:description "A Perdo Auram spell (Level 15) that makes the air in a room stuffy and uncomfortable, penalizing physical exertion of breathing creatures." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:RopeOfBronze a rpg:Spell ;
    rpg:name "Rope of Bronze" ;
    dc:description "A Muto Herbam spell (Level 15) with a Terram requisite that turns a piece of plant-fiber rope into superior bronze that does not break under normal circumstances." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Rosalba a rpg:Faction ;
    rpg:name "Rosalba" ;
    dc:description "Covenant founded by Flavia of Jerbiton in 820 in the Yorkshire Dales; destroyed in 899 when all its magi were killed in a Wizards' War with Blackthorn." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:Roscius a rpg:Character ;
    rpg:name "Roscius" ;
    dc:description "Filius of Verditius who stole the sword Durendal and took it to Verdi; by studying it he and his filii became famous makers of magical swords, founding the Confraternity of Roland." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Rosmert a rpg:Character ;
    rpg:name "Rosmert" ;
    dc:description "Handri's faerie caricature, the imperious-looking Queen of Irencillia's fae and monarch of the Faerie Court." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Rostock a schema:Place ;
    rpg:name "Rostock" ;
    dc:description "An expanding Baltic trading town and port, chief town of the Mecklenburg dynasty of Sorbian princes, overshadowed by neighboring Lubeck." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Rottweil a schema:Place ;
    rpg:name "Rottweil" ;
    dc:description "A town of Roman origin (Arae Flaviae) on the eastern edge of the Black Forest, overlooking the upper River Neckar, where butchers trained Rottweilers to pull carts." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:RoughtingLinn a schema:Place ;
    rpg:name "Roughting Linn" ;
    dc:description "A rock face in Northumberland carved with over sixty cup-and-ring markings, thought to be maps or faerie memorials and possibly carved by Gerfallon of Semitae." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:RoundTable a rpg:Item ;
    rpg:name "Round Table" ;
    dc:description "The Arthurian Round Table that rises from a bog each midsummer near Tintagel, which a king might seek to seize." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:RoyalPrise a rpg:Tag ;
    skos:prefLabel "Royal Prise" ;
    dc:description "A special low price that royalty expects when buying at fairs, effectively a tax on the seller; King Henry III's Westminster fair promised to drop these prises." ;
    skos:altLabel "king's prise" ;
    rpg:hasTag amol:HermeticConcept .
amol:RoznovCastle a schema:Place ;
    rpg:name "Roznov Castle" ;
    dc:description "The castle housing the Rhine covenant of Roznov on the side of Mount Radhost, with Igor Rastvan's great-hall laboratory at one end." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Ruach a rpg:Creature ;
    rpg:name "Ruach" ;
    dc:description "A minor demon in spiritual form that attends a Demonic Blooded character, using its Misfortune Power to blight her enemies and reporting to her demon parent." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:RudolphOfBonisagus a rpg:Character ;
    rpg:name "Rudolph of Bonisagus" ;
    dc:description "A magus of House Bonisagus and the brainchild behind plans to establish a Fengheld chapter at Durenmar." ;
    skos:altLabel "Rudolph" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Ruma a rpg:Creature ;
    rpg:name "Ruma" ;
    dc:description "Daughter of the dwarf king and a mermaid, able to transform into a stream of water; she surfaced to create the Rumaquelle while searching for her husband Romer." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:RunningWaterWeakness a rpg:Tag ;
    skos:prefLabel "Running Water Weakness" ;
    dc:description "A demonic weakness preventing the demon from crossing running fresh water deriving directly from the earth." ;
    skos:altLabel "Running Water" ;
    rpg:hasTag amol:HermeticConcept .
amol:Rus a rpg:Character ;
    rpg:name "Rus" ;
    dc:description "One of the three legendary founding brothers of the Slavic peoples, who settled at the River Dnieper with his tribe, the Russians." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:RBezahl a rpg:Creature ;
    rpg:name "Rübezahl" ;
    dc:description "A Waldgeist who haunts the forests of the Riesengebirge (Giant Mountains)." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:SabinaOfTheSeine a rpg:Character ;
    rpg:name "Sabina of the Seine" ;
    dc:description "A relatively young maga who leads the Viticulturalists league and keeps its collection of casting tablets for agricultural rituals." ;
    skos:altLabel "Sabina" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:SachikoOfMerinita a rpg:Character ;
    rpg:name "Sachiko of Merinita" ;
    dc:description "A probably-female Merinita magus of Burnham whose sigil appears at tribunals but who is otherwise unknown to the tribunal." ;
    skos:altLabel "Sachiko" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Sacrifices a rpg:Tag ;
    skos:prefLabel "Sacrifices" ;
    dc:description "A Minor laboratory Supernatural Flaw: animal sacrifices are needed for the lab to function (+2 Upkeep, -1 Safety, +1 Warping, -1 Health, -3 Aesthetics)." ;
    rpg:hasTag amol:Flaw .
amol:SagitarOfTremere a rpg:Character ;
    rpg:name "Sagitar of Tremere" ;
    dc:description "A Tremere magus who falsely claimed the Criamon Primacy, discovering it was voluntary mystical slavery; his contrite ghost haunts the Cave of Twisting Shadows." ;
    skos:altLabel "Sagitar" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:SailorSForetasteOfTheMorrow a rpg:Spell ;
    rpg:name "Sailor's Foretaste of the Morrow" ;
    dc:description "An Intellego Auram spell (Level 15) that tells the caster precisely tomorrow's weather and gives a general impression of the week ahead at the casting location." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:SaintAndrew a rpg:Character ;
    rpg:name "Saint Andrew" ;
    dc:description "A saint whose relics were stolen from Constantinople by the bishop of Amalfi in 1210, prompting Andru's personal grudge." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:SaintAnthonySFire a rpg:Creature ;
    rpg:name "Saint Anthony's Fire" ;
    dc:description "A Minor Sanguine Disease from possession by a minor demon in the intestines; cured by exorcism." ;
    skos:altLabel "St. Anthony's fire" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:SaintBarbara a rpg:Character ;
    rpg:name "Saint Barbara" ;
    dc:description "A patron saint of French masons, whose feast day is December 4." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:SaintBartholomew a rpg:Character ;
    rpg:name "Saint Bartholomew" ;
    dc:description "The patron saint of tanners, whose feast day is August 24." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:SaintCrispin a rpg:Character ;
    rpg:name "Saint Crispin" ;
    dc:description "One of the patron saints of shoemakers, a third-century Roman preacher who made shoes; feast day October 25." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:SaintCrispinian a rpg:Character ;
    rpg:name "Saint Crispinian" ;
    dc:description "One of the patron saints of shoemakers, a third-century Roman preacher who made shoes; feast day October 25." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:SaintDenisSLenditFair a schema:Place ;
    rpg:name "Saint Denis's Lendit Fair" ;
    dc:description "A fair near Paris founded by King Dagobert in the seventh century for the benefit of the Abbey of St. Denis; once the most important fair in France until the Champagne cycle took over." ;
    skos:altLabel "Lendit Fair" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:SaintDominic a rpg:Character ;
    rpg:name "Saint Dominic" ;
    dc:description "Founder of the Order of Preachers (Dominicans), a trained scholastic from the cathedral school of Palencia preaching against heresy in Lombardy; historically dies 6 August 1221." ;
    skos:altLabel "Dominic", "St. Dominic" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:SaintDunstan a rpg:Character ;
    rpg:name "Saint Dunstan" ;
    dc:description "The patron saint of blacksmiths, whose feast day is May 19." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:SaintEligius a rpg:Character ;
    rpg:name "Saint Eligius" ;
    dc:description "The patron saint of armorers, whose feast day is December 1." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:SaintElisabeth a rpg:Character ;
    rpg:name "Saint Elisabeth" ;
    dc:description "Daughter of the king of Hungary and wife of the landgrave Louis IV of Thuringia, who devotes her life to the needy; subject of the miracle of roses and later canonized as patron of Marburg's poor." ;
    skos:altLabel "Elisabeth", "St. Elisabeth" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:SaintElizabethOfHungary a rpg:Character ;
    rpg:name "Saint Elizabeth of Hungary" ;
    dc:description "A saint to be adopted as patron of bakers, who will die in 1231 and be canonized four years later; feast day November 17." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:SaintFrancis a rpg:Character ;
    rpg:name "Saint Francis" ;
    dc:description "Founder of the Franciscan Order, living near Assisi and growing his newly formed mendicant order." ;
    skos:altLabel "Francis", "St. Francis" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:SaintGertrudeOfNivelles a rpg:Character ;
    rpg:name "Saint Gertrude of Nivelles" ;
    dc:description "The patroness of the recently dead who appeared in visions to many (often unGifted) Donatores, with souls in her care for their first night after death." ;
    skos:altLabel "Gertrude" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:SaintGodric a rpg:Character ;
    rpg:name "Saint Godric" ;
    dc:description "A historical peddler, merchant, pirate, hermit, and saint of northeastern England who settled at Finchale near Durham; renowned for austerity, hymns, and prophecy, he died in 1170 at age 105." ;
    skos:altLabel "Godric", "St. Godric" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:SaintHomobonus a rpg:Character ;
    rpg:name "Saint Homobonus" ;
    dc:description "The recently canonized patron saint of clothiers, a tailor from Cremona who gave free clothes to the poor; his feast day is November 13." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:SaintHonoratusOfArles a rpg:Character ;
    rpg:name "Saint Honoratus of Arles" ;
    dc:description "The patron saint of bakers, whose feast day is January 16." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:SaintLuke a rpg:Character ;
    rpg:name "Saint Luke" ;
    dc:description "One of the patron saints of glassmakers, whose feast day is October 18." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:SaintMarinaTheMonk a rpg:Character ;
    rpg:name "Saint Marina the Monk" ;
    dc:description "A medieval saint, used as a character-concept example, who lived disguised as a monk, accepted false blame for a pregnancy, and was revealed to be a woman only after death." ;
    skos:altLabel "Marina" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:SaintMark a rpg:Character ;
    rpg:name "Saint Mark" ;
    dc:description "One of the patron saints of glassmakers, whose feast day is April 25." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:SaintNicholas a rpg:Character ;
    rpg:name "Saint Nicholas" ;
    dc:description "A saint venerated in northwestern Mythic Europe for miraculously resuscitating three children murdered and pickled by an innkeeper; the planned Kolding church is dedicated to him." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:SaintOdilo a rpg:Character ;
    rpg:name "Saint Odilo" ;
    dc:description "The Abbot at Cluny who created the Feast of All Soul's Day and promoted the Truce of God; patron saint of souls in Purgatory who appeared to Donatores in holy orders." ;
    skos:altLabel "Odilo" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:SaintPaul a rpg:Character ;
    rpg:name "Saint Paul" ;
    dc:description "An apostle cited regarding slavery, counseling slaves to obey their masters while requiring masters not to abuse them." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:SaintStephen a rpg:Character ;
    rpg:name "Saint Stephen" ;
    dc:description "The first Christian martyr and patron saint of masons, whose feast day is December 26." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Saladin a rpg:Character ;
    rpg:name "Saladin" ;
    dc:description "The conqueror to whom Jerusalem fell in 1187, during which Margaret of Beverley helped defend the city." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Salamander a rpg:Creature ;
    rpg:name "Salamander" ;
    dc:description "A fire-dwelling creature whose skin provides a Shape and Material bonus of +8 to extinguishing fire." ;
    skos:altLabel "Salamander of Virtue" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:SalgfrUlein a rpg:Creature ;
    rpg:name "Salgfräulein" ;
    dc:description "A wood-wife who dresses in white and sits under old larch trees, singing." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Salmo a rpg:Character ;
    rpg:name "Salmo" ;
    dc:description "A descendent of Ilfetu who became primus after the Schism War and refocused House Bjornaer toward a more traditional Hermetic mould." ;
    skos:altLabel "Primus Salmo" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:SamuelIbnTibbon a rpg:Character ;
    rpg:name "Samuel ibn Tibbon" ;
    dc:description "The translator who rendered Maimonides' Guide for the Perplexed from Arabic into Hebrew." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:SapTheGriffinSStrength a rpg:Spell ;
    rpg:name "Sap the Griffin's Strength" ;
    dc:description "A general Perdo Vim spell invented by Philippus Niger, like Demon's Eternal Oblivion but working on creatures with Magic Might." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Sardinia a schema:Place ;
    rpg:name "Sardinia" ;
    dc:description "The Mediterranean island, dotted with nuraghi and magic auras, where Hephaestus built his famous forge and House Verditius's domus magna Verdi stands." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Savantism a rpg:Tag ;
    skos:prefLabel "Savantism" ;
    dc:description "A Minor General Flaw in which the character is simpleminded with halved experience but exceptionally gifted in one favored Ability with a +3 specialization bonus." ;
    rpg:hasTag amol:Flaw .
amol:Saxony a schema:Place ;
    rpg:name "Saxony" ;
    dc:description "A large and important duchy of fertile lowlands and cities in the Rhine Tribunal, ancestral home of the Welf family and rival to the Hohenstaufens." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:ScalesOfTheMagicalWeight a rpg:Spell ;
    rpg:name "Scales of the Magical Weight" ;
    dc:description "An Intellego Vim spell used to weigh an unknown amount of vis against a known amount to determine the number of pawns present." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ScarfOfHealing a rpg:Item ;
    rpg:name "Scarf of Healing" ;
    dc:description "A wondrous scarf that copies the effects of the spell Bind Wound (Craft Level 14)." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:ScatteringLikeLight a rpg:Spell ;
    rpg:name "Scattering Like Light" ;
    dc:description "A MuTe(Im) Level 30 spell that changes metal in an object into iconic species carried off by passing light, disintegrating objects; originally created for metal plating." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ScentOfThePredator a rpg:Spell ;
    rpg:name "Scent of the Predator" ;
    dc:description "A CrMe 20 Scent-Target spell that fills anyone smelling the caster with a sensation of menace, cowing or intimidating targets." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Schleswig a schema:Place ;
    rpg:name "Schleswig" ;
    dc:description "A Holstein town by the fjord of the River Schlei, grown next to a Benedictine cloister of St. Johannis near the ruins of the old Viking city of Haithabu." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Scholastus a rpg:Character ;
    rpg:name "Scholastus" ;
    dc:description "A magus of House Jerbiton, the sole surviving member of Treverorum, who announced his covenant's abolition in 1172 AD and departed for the Greater Alps, held liable for its unpaid fine." ;
    skos:altLabel "Scholastus of House Jerbiton" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Scholomance a rpg:Faction ;
    rpg:name "Scholomance" ;
    dc:description "A covenant in the Transylvanian Tribunal that is a school for future apprentices, agents, and companions, set in an intermittently accessible regio and reputed to be a school for sorcerers run by the devil." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:SchoolOfChartres a rpg:Faction ;
    rpg:name "School of Chartres" ;
    dc:description "A medieval cathedral school whose writers (Thierry the Breton, William of Conches, Bernard Silvestris) produced foundational works on cosmology and natural philosophy still taught in Mythic Europe's universities." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:SchoolOfEbroin a rpg:Tag ;
    skos:prefLabel "School of Ebroin" ;
    dc:description "A minor combat school within the Schools of Sebastian family, based on conjuring animals." ;
    rpg:hasTag amol:HermeticConcept .
amol:SchoolOfMarosa a rpg:Tag ;
    skos:prefLabel "School of Marosa" ;
    dc:description "A minor combat school within the Schools of Sebastian family, based on Herbam attacks." ;
    rpg:hasTag amol:HermeticConcept .
amol:SchoolOfStGeneviVe a schema:Place ;
    rpg:name "School of St Geneviève" ;
    dc:description "A cathedral school in Paris where the scholastic luminary Peter Abelard taught." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:SchoolsOfMagicalCombat a rpg:Tag ;
    skos:prefLabel "Schools of Magical Combat" ;
    dc:description "Informal styles of fighting magic recognized within House Flambeau, each named after the pioneering magus who invented it, used to classify combative approaches." ;
    rpg:hasTag amol:HermeticConcept .
amol:SchNeLau a rpg:Creature ;
    rpg:name "Schöne Lau" ;
    dc:description "A beautiful reclusive water faerie of Blautopf Pool with webbed feet and powers of divination, banished there by her faerie-king husband because she could not laugh; she foretells visitors' futures." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:ScillyIsles a schema:Place ;
    rpg:name "Scilly Isles" ;
    dc:description "Islands southwest of Land's End said to be the last sinking remnants of the drowned land of Lyonesse, settled by those who fled to the high ground." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:ScintillaOfFlambeau a rpg:Character ;
    rpg:name "Scintilla of Flambeau" ;
    dc:description "A Flambeau maga who came to Burnham from eastern Europe, rumored to be a powerful fire maga but has done nothing noteworthy in Stonehenge." ;
    skos:altLabel "Scintilla" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:ScribesGuild a rpg:Faction ;
    rpg:name "Scribes' Guild" ;
    dc:description "The guild responsible for producing parchment for books, referenced in the seasonal production chart." ;
    skos:altLabel "percamenarius" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Scrofula a rpg:Creature ;
    rpg:name "Scrofula" ;
    dc:description "A Serious Melancholic Disease from cold dry city winds; said to be cured by the touch of the Kings of England or France." ;
    skos:altLabel "morbus regius", "struma", "the King's Evil" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:SculptTheLivingWater a rpg:Spell ;
    rpg:name "Sculpt the Living Water" ;
    dc:description "A Muto Aquam spell (MuAq 20) created by Falke that allows the caster to mentally mold water as if it were clay for Sun duration." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:SearchingTheHaystackForANeedle a rpg:Spell ;
    rpg:name "Searching the Haystack for a Needle" ;
    dc:description "A Rego Mentem spell granting +3 to sight-based Perception rolls for a specific object or quality, often used to locate vis." ;
    skos:altLabel "ReMe 20" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Sebastian a rpg:Character ;
    rpg:name "Sebastian" ;
    dc:description "An eighth-century hedge wizard who joined the Order as a Flambeau magus despite Deficient Arts, developing a combat method based on his only strength, the Form of Aquam; namesake of the Schools of Sebastian." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:SecondaryInsight a rpg:Tag ;
    skos:prefLabel "Secondary Insight" ;
    dc:description "A Minor Hermetic Virtue making magical study versatile, granting bonus experience in several Forms when studying a Technique, and in Techniques when studying a Form." ;
    rpg:hasTag amol:Virtue .
amol:SeedOfBetrayal a rpg:Spell ;
    rpg:name "Seed of Betrayal" ;
    dc:description "A Muto Mentem 15 spell invented by Imanitos Mendax that turns a target's emotions toward his masters into contempt, making him readily betray them." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Selene a rpg:Creature ;
    rpg:name "Selene" ;
    dc:description "A famous Younger Titan, the Moon, named among the offspring of the Titans." ;
    skos:altLabel "Selene the Moon" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:SemitaeSHorses a rpg:Creature ;
    rpg:name "Semitae's horses" ;
    dc:description "A breeding line of horses raised by Semitae that are not frightened of magi; traded to other covenants but no one else has managed to breed them true." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Sempringham a schema:Place ;
    rpg:name "Sempringham" ;
    dc:description "The first and most important house of the Gilbertine order in eastern England." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Seneca a rpg:Character ;
    rpg:name "Seneca" ;
    dc:description "A crazed Durenmar magus obsessed with building the tallest tower in the world; his magical botch sent him into Final Twilight and collapsed his half-built tower, now Seneca's Folly." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:SenecaSFolly a schema:Place ;
    rpg:name "Seneca's Folly" ;
    dc:description "A jumble of ancient overgrown timber beams at Durenmar, the ruins of a giant tower whose builder Seneca was sent into Final Twilight by a botch." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:SenseHolinessUnholiness a rpg:Proficiency ;
    rpg:name "Sense Holiness & Unholiness" ;
    dc:description "A Supernatural Power allowing perception of holy and unholy qualities, such as the Manifest Sin Flaw, through one or more senses." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:SenseOfMagicalPower a rpg:Spell ;
    rpg:name "Sense of Magical Power" ;
    dc:description "An Intellego Vim spell that tells the caster whether he is currently in a Magic aura." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:SenseTheFeetThatThreadTheEarth a rpg:Spell ;
    rpg:name "Sense the Feet That Thread the Earth" ;
    dc:description "An Intellego Terram spell that feels what is moving along the ground within a mile; derived from the Terram tradition from which Guernicus the Founder came." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:SenseTheLingeringMagic a rpg:Spell ;
    rpg:name "Sense the Lingering Magic" ;
    dc:description "The Hermetic effect (Target: Smell) underlying Philippus Niger's Sniff Out the Witch power for detecting magical residue." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:SenseTheNatureOfVis a rpg:Spell ;
    rpg:name "Sense the Nature of Vis" ;
    dc:description "An Intellego Vim spell that reveals which Art a supply of raw vis is connected to, shown by a color-coded aura." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Sentences a rpg:Item ;
    rpg:name "Sentences" ;
    dc:description "A work by Peter Lombard whose reading might lead to a breakthrough regarding the Divine realm's suppression of magic, per a story seed." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:Sentient a rpg:Tag ;
    skos:prefLabel "Sentient" ;
    dc:description "A Free laboratory Supernatural Virtue: the lab has developed an independent mind, likely from long exposure to a high-level magic or faerie aura." ;
    rpg:hasTag amol:Virtue .
amol:Sept a rpg:Tag ;
    skos:prefLabel "Sept" ;
    dc:description "A local grouping within House Bjornaer to which a magus may belong; sept members typically Initiate a magus into cults and provide mentorship." ;
    rpg:hasTag amol:HermeticConcept .
amol:Serica a schema:Place ;
    rpg:name "Serica" ;
    dc:description "A distant eastern land the Romans called the source of the finest silks and spices, from which Europe imports luxuries by paying tons of silver through Arabic intermediaries." ;
    skos:altLabel "Land of the Silk People", "Sercia" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Sericans a rpg:Creature ;
    rpg:name "Sericans" ;
    dc:description "The people of Serica, whom no European merchant has ever met; some Hermetic scholars believe they are monsters who eat silver, given their insatiable demand for it." ;
    skos:altLabel "Serican" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:SerrifuloriaOfMerinita a rpg:Character ;
    rpg:name "Serrifuloria of Merinita" ;
    dc:description "A magus of House Merinita believed to have discovered a unique path within the Arcadian forest, stripping herself of emotions as magical jewels to partially overcome the Limit of True Feeling." ;
    skos:altLabel "Serrifuloria" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Servant a rpg:Tag ;
    skos:prefLabel "Servant" ;
    dc:description "A Free laboratory Outfittings Virtue: a full-time mundane lab servant from the covenfolk performs the most menial tasks (Safety bonus from servant's Intelligence, +1 Aesthetics, +1 Mentem)." ;
    rpg:hasTag amol:Virtue .
amol:ServantOfTheLand a rpg:Tag ;
    skos:prefLabel "Servant of the (Land)" ;
    dc:description "A Major Story Flaw in which a powerful magical creature has saved the character and set him a difficult task, imposing a Prohibition until the task is complete." ;
    rpg:hasTag amol:Flaw .
amol:ServusMaris a rpg:Faction ;
    rpg:name "Servus Maris" ;
    dc:description "An attempt to found a Manx covenant in 1160, destroyed by a dragon within six months; one magus was sent back with the message 'Don't come back.'" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:SeverTheTiesThatBind a rpg:Tag ;
    skos:prefLabel "Sever the Ties That Bind" ;
    dc:description "A Major or Minor Ordeal Flaw causing a Verditius magus to lose emotional bonds with family and friends, appropriate for learning Bind Curse." ;
    skos:altLabel "Severe the Ties that Bind" ;
    rpg:hasTag amol:Flaw .
amol:SeverTheUnwantedLimb a rpg:Spell ;
    rpg:name "Sever the Unwanted Limb" ;
    dc:description "A Rego Corpus 25 spell that cleanly and painlessly amputates one of the target's limbs without bleeding, leaving the Lame or Missing Hand Flaw." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Severicus a rpg:Character ;
    rpg:name "Severicus" ;
    dc:description "A master of House Tremere at Roznov Fort, a tall, bald, Terram-specialist magus who detests change; one of only two Tremere in the Rhine to hold his own sigil and controls about two-fifths of the Tremere sigils." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:SeverusMaximus a rpg:Character ;
    rpg:name "Severus Maximus" ;
    dc:description "A magus of House Flambeau who declared Wizard War against Caithlinn of House Diedne of Oakdell covenant in 1004 AD." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:ShacklesOfTheFrozenIce a rpg:Spell ;
    rpg:name "Shackles of the Frozen Ice" ;
    dc:description "A ReAq 10 spell that freezes a circular portion of water into ice, trapping anyone in it; the ice holds fast regardless of Magic Resistance but only inflicts cold damage if it penetrates." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ShadowsOfTheFiresPast a rpg:Spell ;
    rpg:name "Shadows of the Fires past" ;
    dc:description "An Intellego Ignem spell (Level 15) that reveals where fires have been in the past lunar month as a light red flickering haze, with an intuitive sense of when." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Shamir a rpg:Item ;
    rpg:name "Shamir" ;
    dc:description "A magical stone said to be held within the pillars of Solomon's temple that could cut other stones." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:Shapechanging a rpg:Proficiency ;
    rpg:name "Shapechanging" ;
    dc:description "A non-Hermetic Major Virtue option for the Damhadh-Duidsan tradition." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:ShatteringTheMaliciousRune a rpg:Spell ;
    rpg:name "Shattering the Malicious Rune" ;
    dc:description "A general Perdo Vim spell invented by Philippus Niger, like Unraveling the Fabric of (Form) but targeted specifically at rune-magic." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ShellOfFalseDeterminations a rpg:Spell ;
    rpg:name "Shell of False Determinations" ;
    dc:description "A Creo Vim ritual that creates a shell of magic on an item, giving false information to magi who investigate its powers." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ShellOfOpaqueMysteries a rpg:Spell ;
    rpg:name "Shell of Opaque Mysteries" ;
    dc:description "A Creo Vim ritual similar to Shell of False Determinations that causes all attempts to investigate a magic item to fail unless the magus's roll exceeds the ritual's level." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ShelteredUpbringing a rpg:Tag ;
    skos:prefLabel "Sheltered Upbringing" ;
    dc:description "A Minor Personality Flaw in which the character grew up isolated from society and cannot understand most human customs, barring several social Abilities at start." ;
    rpg:hasTag amol:Flaw .
amol:ShiverOfTheLycanthrope a rpg:Spell ;
    rpg:name "Shiver of the Lycanthrope" ;
    dc:description "An Intellego Animal spell (Level 10) that makes the caster feel a shiver when touching a person or beast that is a lycanthrope." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ShoesOfTheZephyr a rpg:Item ;
    rpg:name "Shoes of the Zephyr" ;
    dc:description "Wondrous horseshoes that allow a horse to fly, running across the sky as if it were land (Craft Level 19)." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:ShortOfBreath a rpg:Tag ;
    skos:prefLabel "Short of Breath" ;
    dc:description "A Minor General Flaw in which the character quickly tires during extended physical activity, receiving -3 to Stamina rolls to avoid fatigue." ;
    rpg:hasTag amol:Flaw .
amol:ShortLivedMagic a rpg:Tag ;
    skos:prefLabel "Short-Lived Magic" ;
    dc:description "A Minor Hermetic Flaw in which the character's spells do not last as long as they should, with each duration category reduced." ;
    rpg:hasTag amol:Flaw .
amol:ShowOfTheFlamesAndSmoke a rpg:Spell ;
    rpg:name "Show of the Flames and Smoke" ;
    dc:description "A Muto Ignem spell (Level 10) that makes a fire produce colored smoke, streams of flame, and strange noises, entrancing or horrifying onlookers and potentially igniting nearby objects." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ShroudMagic a rpg:Spell ;
    rpg:name "Shroud Magic" ;
    dc:description "A Muto Vim spell that lets a magus suppress or alter the sigil in a spell currently being cast." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Shrouded a rpg:Tag ;
    skos:prefLabel "Shrouded" ;
    dc:description "A Free laboratory Supernatural Virtue: the lab is hidden or protected by a supernatural effect such as The Shrouded Glen (+1 Warping, halve Aesthetics)." ;
    rpg:hasTag amol:Virtue .
amol:SideEffect a rpg:Tag ;
    skos:prefLabel "Side Effect" ;
    dc:description "A Minor Hermetic Virtue giving a magus's magic an incidental, generally useful feature whose intensity scales with spell level, such as a temporary Presence bonus after casting." ;
    rpg:hasTag amol:Virtue .
amol:Siena a schema:Place ;
    rpg:name "Siena" ;
    dc:description "A north Italian city whose goldsmiths are renowned throughout Europe." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:SiffedOfCriamon a rpg:Character ;
    rpg:name "Siffed of Criamon" ;
    dc:description "A young Criamon magus among the members recruited to Nigrasaxa." ;
    skos:altLabel "Siffed" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:SightOfTheWarmSurface a rpg:Spell ;
    rpg:name "Sight of the Warm Surface" ;
    dc:description "A MuIm 20 synaesthetic spell that transforms the species of warm surfaces, normally sensed by touch, into species the eye can perceive." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:SignLanguage a rpg:Proficiency ;
    rpg:name "Sign Language" ;
    dc:description "An Ability equivalent to a Living Language, developed by monks to communicate during times of silence, understood only by monks of a particular monastery." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:Significato a rpg:Tag ;
    skos:prefLabel "Significato" ;
    dc:description "Magically occurring phenomena that illuminate truth and let magi generate study totals through mystical experiences instead of studying from vis." ;
    skos:altLabel "Significatos" ;
    rpg:hasTag amol:HermeticConcept .
amol:SignumIrruptus a rpg:Character ;
    rpg:name "Signum Irruptus" ;
    dc:description "A master of House Criamon and leader of the covenant Heorot, obsessed with the trolls (whom he believes descended from degenerate gods), having lost his left arm and 14 grogs to his studies." ;
    skos:altLabel "Signum Irruptus, Follower of Criamon" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:SikelgaitaOfSicily a rpg:Character ;
    rpg:name "Sikelgaita of Sicily" ;
    dc:description "A Lombard princess and wife of the Duke of Apulia and Sicily who fought dressed as a knight, rallying troops at the Battle of Dyrrachium against the Byzantine Empire; an example of conquest-based female power." ;
    skos:altLabel "Sikelgaita" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:SilburyHill a schema:Place ;
    rpg:name "Silbury Hill" ;
    dc:description "An artificial mound 500 feet in diameter and 120 feet high south of Avebury, said to be the cursed burial place of King Sel, entombed on horseback with his treasury." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:SilentShout a rpg:Spell ;
    rpg:name "Silent Shout" ;
    dc:description "A CrIm 10 miniature spell that creates a burst of species matching the caster's voice striking the target's head, used on battlefields or to instruct apprentices." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:SilvaOfMerinita a rpg:Character ;
    rpg:name "Silva of Merinita" ;
    dc:description "A maga of House Merinita whose spell variants have whimsical qualities, such as comical coloration on created toads or a happy, playful wave." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:SilveryScalesOfTheKnight a rpg:Spell ;
    rpg:name "Silvery Scales of the Knight" ;
    dc:description "A CrTe(An) 30 spell that conjures a suit of full chain mail armor styled after the caster's Wizard's Sigil; being magical, the wearer cannot grapple a magic-resistant creature while wearing the gauntlets." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Similarity a rpg:Tag ;
    skos:prefLabel "Similarity" ;
    dc:description "A natural principle stating an effect resembles its cause, imbuing objects with Shape and Material bonuses; apothecaries call it the doctrine of signatures." ;
    skos:altLabel "doctrine of signatures", "similia similibus" ;
    rpg:hasTag amol:HermeticConcept .
amol:Simile a rpg:Tag ;
    skos:prefLabel "Simile" ;
    dc:description "The pattern underlying the natural range of variance in a class of objects, distinct from the Platonic form; familiarity with it adjusts Finesse rolls for crafting." ;
    rpg:hasTag amol:HermeticConcept .
amol:SimpleMinded_2 a rpg:Tag ;
    skos:prefLabel "Simple Minded" ;
    dc:description "A Flaw possessed by all Rottweiler grogs reflecting limited intellect." ;
    rpg:hasTag amol:Flaw .
amol:SimprimOfGuernicus a rpg:Character ;
    rpg:name "Simprim of Guernicus" ;
    dc:description "The mid-twelfth-century House Guernicus magus who started the Transitionalist movement seeking greater legal powers for the Quaesitores." ;
    skos:altLabel "Simprim" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Simulacra a rpg:Tag ;
    skos:prefLabel "Simulacra" ;
    dc:description "A common automaton power (base effect 15, Creo Imaginem) making the automaton look, smell, and sound real rather than a facsimile." ;
    rpg:hasTag amol:HermeticConcept .
amol:SineadExMiscellanea a rpg:Character ;
    rpg:name "Sinead Ex Miscellanea" ;
    dc:description "An ancient maga of Ungulus, focused on combat against magical beasts, who burns for revenge on the dragon that killed her beloved Parsirus but is magically pushed away from it." ;
    skos:altLabel "Sinead" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:SineadSEnchantedIronItems a rpg:Item ;
    rpg:name "Sinead's enchanted iron items" ;
    dc:description "A number of iron items worn by Espera of Merinita, all enchanted to defend against faeries, against the faerie lord she offended." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:SinewsOfKnowledge a rpg:Faction ;
    rpg:name "Sinews of Knowledge" ;
    dc:description "A covenant that has close and friendly relations with Durenmar, lying along a well-traveled Redcap route south toward the Greater Alps Tribunal." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:SinglemindednessOfTheConcentratingWizard a rpg:Spell ;
    rpg:name "Singlemindedness of the Concentrating Wizard" ;
    dc:description "A Rego Mentem spell granting +3 to Concentration rolls while automatically failing non-Concentration Intelligence rolls." ;
    skos:altLabel "ReMe 25" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:SinusWodinis a rpg:Faction ;
    rpg:name "Sinus Wodinis" ;
    dc:description "A second covenant of Bjornaer magi on the southeast coast of Norway, presumed part of the Novgorod Tribunal, whose existence is known only to Crintera." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:SirRobertTheDragonslayer a rpg:Character ;
    rpg:name "Sir Robert the Dragonslayer" ;
    dc:description "An example character cited to illustrate how a high Reputation can make people doubt a character's identity." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:SirenSong a rpg:Tag ;
    skos:prefLabel "Siren Song" ;
    dc:description "The Major Non-Hermetic Virtue of the Seirenes that empowers a character's music to command those who hear it." ;
    rpg:hasTag amol:Virtue .
amol:Sirens a rpg:Creature ;
    rpg:name "Sirens" ;
    dc:description "Powerful magical creatures whose magical song lured sailors to drown; they taught Thelxiope their magic and turned to stone after Orpheus defeated them." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Sirnas a rpg:Character ;
    rpg:name "Sirnas" ;
    dc:description "One of Birna's six apprentices, told to 'Protect,' with a stag heartbeast, who originated among the Wends of the Baltic Coast and founded Clan Sirnas." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:SiteOfLegend a rpg:Tag ;
    skos:prefLabel "Site of Legend" ;
    dc:description "A Free laboratory Supernatural Virtue: stories and legends are associated with the lab, granting appropriate Characteristic and Specialization adjustments." ;
    rpg:hasTag amol:Virtue .
amol:SkilledSmuggler a rpg:Tag ;
    skos:prefLabel "Skilled Smuggler" ;
    dc:description "A Minor General Virtue letting a character hide one dagger-sized item, imposing -9 on Awareness rolls to find it." ;
    rpg:hasTag amol:Virtue .
amol:SkinchangerDove a rpg:Tag ;
    skos:prefLabel "Skinchanger (Dove)" ;
    dc:description "A Major Supernatural variant of Skinchanger using prepared feathers or feather-engraved stones to become a dove, associated with the Daughters of Four Fathers tradition." ;
    rpg:hasTag amol:Virtue .
amol:Slave a rpg:Tag ;
    skos:prefLabel "Slave" ;
    dc:description "A new Major Status Flaw for a character of likely Slavic origin who has been sold into captivity and is wholly beholden to a master's will." ;
    skos:altLabel "Major Status Flaw: Slave" ;
    rpg:hasTag amol:Flaw .
amol:SlaveOwner a rpg:Tag ;
    skos:prefLabel "Slave-Owner" ;
    dc:description "A new Minor General Virtue making a character the legal owner of one (largely unskilled) slave, lost if the slave is freed or killed." ;
    skos:altLabel "Minor General Virtue: Slave-Owner" ;
    rpg:hasTag amol:Virtue .
amol:SlaversGuild a rpg:Faction ;
    rpg:name "Slavers' Guild" ;
    dc:description "A small guild occupying a grey area between craft and service guilds, dealing in the sale of non-Christian slaves; its members are skilled in Sailing and Leadership." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Slaves a rpg:Tag ;
    skos:prefLabel "Slaves" ;
    dc:description "A Minor laboratory Outfittings Virtue: human slaves are employed in the lab as labor or experimental subjects (+1 Upkeep, -1 Safety, -1 Aesthetics)." ;
    rpg:hasTag amol:Virtue .
amol:SlayTheInnocent a rpg:Spell ;
    rpg:name "Slay the Innocent" ;
    dc:description "A Perdo Corpus (Animal) spell (PeCo[An]30) that Mari Amwithig modified to include an 'enemy' charm in the Charm Magic example." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:SleepDisorder a rpg:Tag ;
    skos:prefLabel "Sleep Disorder" ;
    dc:description "A Minor General Flaw in which the character cannot sleep soundly and risks nodding off during quiet periods, losing Long Term Fatigue; incompatible with Night Terrors." ;
    rpg:hasTag amol:Flaw .
amol:SlowPower a rpg:Tag ;
    skos:prefLabel "Slow Power" ;
    dc:description "A Minor Supernatural Flaw in which one of the character's supernatural powers requires an additional round of preparation to activate." ;
    rpg:hasTag amol:Flaw .
amol:SlowReflexes a rpg:Tag ;
    skos:prefLabel "Slow Reflexes" ;
    dc:description "A Minor General Flaw in which the character does not react well to surprises, receiving -3 to Initiative in situations warranting a quick response." ;
    rpg:hasTag amol:Flaw .
amol:SmokeOil a rpg:Item ;
    rpg:name "Smoke Oil" ;
    dc:description "A Level 10 Alteration Reagent that evaporates into a thick gray fog filling about a hundred cubic paces when its sealed container is opened." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:SniffOutTheWitch a rpg:Spell ;
    rpg:name "Sniff Out the Witch" ;
    dc:description "A 0-point Vim power of Philippus Niger that lets him smell the residue of magic on those with magical powers, with a Penetration of 5." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:SnowAndWind a rpg:Creature ;
    rpg:name "Snow and Wind" ;
    dc:description "Spirits of winter that descend each year to frolic in mountain lakes and bring the change of seasons; water collected as their favored lake freezes is a source of Muto vis." ;
    skos:altLabel "Winter Spirits", "spirits of Snow and Wind" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Snowdonia a schema:Place ;
    rpg:name "Snowdonia" ;
    dc:description "The mountainous region of North Wales where Cad Gadu's island lies and where Cad Gadu magi once encountered Gerfallon etching a map into a mountainside." ;
    skos:altLabel "Snowdonian mountains" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:SolInvicti a rpg:Faction ;
    rpg:name "Sol Invicti" ;
    dc:description "A holy Hermetic societas connected to the late Roman sun-cult of Sol Invictus, mentioned as related to the Cult of Mercury." ;
    skos:altLabel "Sol Invictus", "societas Sol Invicti" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Solomon a rpg:Character ;
    rpg:name "Solomon" ;
    dc:description "The legendary king whose encoded words of command sahirs chant to summon jinn, and a book in whose hand is a coveted item." ;
    skos:altLabel "Suleiman" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:SonsOfThePeters a rpg:Faction ;
    rpg:name "Sons of the Peters" ;
    dc:description "A small, argumentative group of northern speculative grammarians basing their method on Peter Helias and Peter of Spain; secretly aided in their disputationes by demonic tempters granting an Infernally tainted Puissant Artes Liberales." ;
    skos:altLabel "filii petrorum" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:SoothePainsOfTheBeast a rpg:Spell ;
    rpg:name "Soothe Pains of the Beast" ;
    dc:description "A Creo Animal Ritual spell (Level 20) that cures one Light Wound suffered by an animal, resembling a ritualistic laying-on of hands." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:SootheTheFerociousBear a rpg:Spell ;
    rpg:name "Soothe the Ferocious Bear" ;
    dc:description "A Rego Animal spell (Level 10) that calms an animal until it is threatened or aroused again, requiring soothing speech." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:SootheTheFerociousBoar a rpg:Spell ;
    rpg:name "Soothe the Ferocious Boar" ;
    dc:description "A Rego Animal spell (ReAn 10) known by Ioannes Acer with Mastery in Fast Casting." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Sophists a rpg:Faction ;
    rpg:name "Sophists" ;
    dc:description "An antagonistic group of ancient Greek scholars and teachers of rhetoric whose teachings on the rivalry between nature and custom heavily influenced Tytalus's philosophy." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:SoporificSponge a rpg:Item ;
    rpg:name "Soporific Sponge" ;
    dc:description "A Theriac of Level 15, Potency Mighty, a precious secret of the School of Salerno combining opium, mandrake, hemlock and hyoscyamus into a hypnotic aid that induces deep slumber." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:SorcererSFlower a rpg:Item ;
    rpg:name "Sorcerer's Flower" ;
    dc:description "A pale violet anemone growing on the slopes of the Brocken, reputed to be a source of vis." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:Sordello a rpg:Character ;
    rpg:name "Sordello" ;
    dc:description "A practicing Italian poet living in Florence who has begun to write poetry in the spreading troubadour style." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Sordus a rpg:Creature ;
    rpg:name "Sordus" ;
    dc:description "A basilisk with Magic Might 30 that serves as Philippus Niger's familiar; a knee-height gray lizard with a Gaze of Death and powers that wither plants and pollute water." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:SovereignWard a rpg:Tag ;
    skos:prefLabel "Sovereign Ward" ;
    dc:description "A powerful taboo: a faerie cannot harm someone carrying its sovereign ward, and direct contact with it destroys the faerie's body." ;
    rpg:hasTag amol:Flaw .
amol:Spacious a rpg:Tag ;
    skos:prefLabel "Spacious" ;
    dc:description "A Minor laboratory Structure Virtue: the lab has spare room so outfittings can be spread out (+2 Safety, +1 Aesthetics)." ;
    rpg:hasTag amol:Virtue .
amol:SpeakWithTheLivingFlame a rpg:Spell ;
    rpg:name "Speak with the Living Flame" ;
    dc:description "A spell whose Bjornaer version is a Range Personal, Target Hearing effect with a free Mentem requisite that interprets the sound of fire into thoughts." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Specimens a rpg:Tag ;
    skos:prefLabel "Specimens" ;
    dc:description "A Minor laboratory Outfittings Virtue: the lab has a large collection of related things stored in visible containers (+1 Upkeep, +1 Aesthetics, 1 Form Specialization point)." ;
    rpg:hasTag amol:Virtue .
amol:SpeechWithTheSilent a rpg:Tag ;
    skos:prefLabel "Speech with the Silent" ;
    dc:description "A Major Supernatural Virtue granting the ability to charm elemental objects into assisting, as Path of Strife magi do." ;
    rpg:hasTag amol:Virtue .
amol:Speyer a schema:Place ;
    rpg:name "Speyer" ;
    dc:description "A Rhine city originating as a Roman military camp, favored seat of the Salian dynasty, with a great cathedral whose bells mysteriously toll on imperial deaths." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:SpiritForm a rpg:Spell ;
    rpg:name "Spirit Form" ;
    dc:description "A power (Vim) of the angels Nasir and Seferiel that lets them become a creature of pure spirit, unable to affect or be affected physically." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:SpiritVotaryVirtue a rpg:Tag ;
    skos:prefLabel "Spirit Votary (Virtue)" ;
    dc:description "The Free Mythic Companion Virtue defining a character as a spirit votary." ;
    rpg:hasTag amol:Virtue .
amol:SpiritOfAPersonSAnger a rpg:Creature ;
    rpg:name "Spirit of a Person's Anger" ;
    dc:description "An incorporeal Mentem spirit of Might 20 with the Wrathful Flaw and a Fury power that drives targets into uncontrollable rage; appears to Second Sight as a furious red-faced man." ;
    skos:altLabel "spirit of anger", "spirit of wrath" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:SpiritOfTheRhine a rpg:Creature ;
    rpg:name "Spirit of the Rhine" ;
    dc:description "A powerful water elemental spirit of the Rhine, pinioned at the Rhinefalls by a giant's rock; Schwall has served it through Quests and plots to release it." ;
    skos:altLabel "Rhine elemental", "Rhine spirit", "watery spirit" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:SproutingOutOfSeason a rpg:Spell ;
    rpg:name "Sprouting Out of Season" ;
    dc:description "A Creo Herbam 20 spell (R: Touch, D: Sun, T: Ind) that causes the seed of any plant to sprout in a single day or night." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:StNerius a rpg:Character ;
    rpg:name "St Nerius" ;
    dc:description "A magus famous for his Christian devotion and sanctity, generally said to have been a member of House Criamon." ;
    skos:altLabel "Saint Nerius" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:StPeter a rpg:Character ;
    rpg:name "St Peter" ;
    dc:description "One of the twelve Apostles, the first Bishop of Rome and the rock on which the Church was built." ;
    skos:altLabel "Peter" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:StAdalbertOfPrague a rpg:Character ;
    rpg:name "St. Adalbert of Prague" ;
    dc:description "A saint who defeated the spirit of Romowe, drove it back into the Holm Oak, and lit the fire that keeps it trapped; his relics are housed at the Basilica of St. Vitus in Prague." ;
    skos:altLabel "St. Adalbert" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:StAnthonySFireDemon a rpg:Creature ;
    rpg:name "St. Anthony's Fire Demon" ;
    dc:description "A minor disease demon with Might 10 (Corpus) that lodges in a victim's intestines causing escalating wounds, exorcisable by a ritual of the Order of the Hospitalers of St. Anthony." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:StAugustineOfCanterbury a rpg:Character ;
    rpg:name "St. Augustine of Canterbury" ;
    dc:description "The Benedictine monk who came to convert the Saxons and founded the monastery and abbey at Canterbury that bears his name." ;
    skos:altLabel "St. Augustine" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:StBenedict a rpg:Character ;
    rpg:name "St. Benedict" ;
    dc:description "The saint under whose monastic rule Bricstan wished to live; he appeared in a blaze of light and broke Bricstan's fetters in prison." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:StBoniface a rpg:Character ;
    rpg:name "St. Boniface" ;
    dc:description "An 8th-century missionary saint who miraculously felled the Donar Oak, fragmenting the primeval forest, and raised Mainz to an archbishopric, becoming its first archbishop." ;
    skos:altLabel "Boniface", "Saint Boniface" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:StCollen a rpg:Character ;
    rpg:name "St. Collen" ;
    dc:description "A hermit living on the side of Glastonbury Tor who confronted Gwynn ab Nudd, banishing the faerie king and his castle with holy water." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:StCrispianian a rpg:Character ;
    rpg:name "St. Crispianian" ;
    dc:description "Patron saint of leatherworkers and cobblers (with St. Crispin); brother of St. Crispin who preached in Gaul." ;
    skos:altLabel "Crispianian" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:StCrispin a rpg:Character ;
    rpg:name "St. Crispin" ;
    dc:description "Patron saint of leatherworkers and cobblers (with St. Crispianian); one of two brothers of a noble Roman family who preached in Gaul in the third century." ;
    skos:altLabel "Crispin" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:StCurig a rpg:Character ;
    rpg:name "St. Curig" ;
    dc:description "A Welsh saint whose gold-and-silver-encased staff, kept in the church of St. Germanus, miraculously cures tumors in exchange for an offering." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:StDavid a rpg:Character ;
    rpg:name "St. David" ;
    dc:description "A saint who came from Wales to Glastonbury to rededicate the old church but was told in a dream that God had already dedicated it; he was wounded then healed as a sign." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:StDavids a schema:Place ;
    rpg:name "St. Davids" ;
    dc:description "A Welsh cathedral and see; Gerald of Wales campaigned to make it an archbishopric over the Welsh sees, without success." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:StEdmund a rpg:Character ;
    rpg:name "St. Edmund" ;
    dc:description "A king of East Anglia martyred by the Danes and beheaded, his head guarded by a wolf; his shrine is at Bury St. Edmund's and he appeared in armor to condemn Henry of Essex." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:StEloi a rpg:Character ;
    rpg:name "St. Eloi" ;
    dc:description "Patron saint of goldsmiths and jewelers; a preacher who became Bishop of Noyon in seventh-century France." ;
    skos:altLabel "Eloi" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:StErhard a rpg:Character ;
    rpg:name "St. Erhard" ;
    dc:description "The uncle of St. Odile who baptized her, upon which she miraculously recovered her sight." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:StErkenwald a rpg:Character ;
    rpg:name "St. Erkenwald" ;
    dc:description "A seventh-century bishop of London and patron saint of the city; the blasphemer Eustace who mocked his shrine was struck down by divine judgment." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:StEtheldreda a rpg:Character ;
    rpg:name "St. Etheldreda" ;
    dc:description "A saint whose tomb at Ely is a major pilgrimage site; she appeared with St. Benedict and St. Sexburga to miraculously free the prisoner Bricstan." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:StGeorgen a schema:Place ;
    rpg:name "St. Georgen" ;
    dc:description "A Benedictine monastery founded 1084 as a daughter house of Hirsau, finally destroyed in 1208 by strange dark vines that killed its monks; suspected to be the work of Dankmar or the forest itself." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:StGildas a rpg:Character ;
    rpg:name "St. Gildas" ;
    dc:description "A saint and monk at Glastonbury Abbey who reconciled King Arthur with his brother Hueil, a king in Scotland who fought against Arthur." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:StGilesFairWinchester a schema:Place ;
    rpg:name "St. Giles' Fair, Winchester" ;
    dc:description "The most important fair in England, the only one where Redcaps are always in attendance, sited around the church of St. Giles outside Winchester's walls; tin from Cornwall and gold from Wales are obtained there." ;
    skos:altLabel "St. Giles' Hill", "Winchester fair" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:StHubert a rpg:Character ;
    rpg:name "St. Hubert" ;
    dc:description "The successor of St. Lambert who raised a grand tomb over the site of Lambert's martyrdom at Liege." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:StJoseph a rpg:Character ;
    rpg:name "St. Joseph" ;
    dc:description "Patron saint of woodworkers; the foster father of the Son of God who lived in Judaea and died in the first century." ;
    skos:altLabel "Joseph" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:StLambert a rpg:Character ;
    rpg:name "St. Lambert" ;
    dc:description "A 7th-century bishop of Tongeren martyred at the site of Liege amid a Merovingian feud; his tomb drew pilgrims and the cathedral of St. Lambert was erected over it." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:StLebuinus a rpg:Character ;
    rpg:name "St. Lebuinus" ;
    dc:description "A saint who was the first to erect a chapel on the site of Deventer in 768; the present church of Deventer is named after him." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:StLiudger a rpg:Character ;
    rpg:name "St. Liudger" ;
    dc:description "A saint who rebuilt the chapel at Deventer in 776 after it was destroyed by Saxon heathens." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:StLivier a rpg:Character ;
    rpg:name "St. Livier" ;
    dc:description "A local lord and saint beheaded by Attila when the Huns sacked Metz, who afterward picked up his head and walked to his burial place on a nearby hilltop." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:StMarySAbbeyYork a schema:Place ;
    rpg:name "St. Mary's Abbey, York" ;
    dc:description "A large Benedictine monastery in York founded in 1080 whose dissatisfied monks went on to found the Cistercian Fountains Abbey; led in 1220 by Abbot Robert of Longchamp." ;
    skos:altLabel "St. Mary's Abbey" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:StMaurice a rpg:Character ;
    rpg:name "St. Maurice" ;
    dc:description "Patron saint of dyers and weavers; an Egyptian soldier and principal officer of the Theban legion in the third-century Roman army." ;
    skos:altLabel "Maurice" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:StMichaelSMount a schema:Place ;
    rpg:name "St. Michael's Mount" ;
    dc:description "The place where the flood drowning Lyonesse finally stopped and where the first Trevelyan landed on his white horse." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:StNicholas a rpg:Character ;
    rpg:name "St. Nicholas" ;
    dc:description "A patron saint of merchants in general; the fourth-century Bishop of Myra in Turkey." ;
    skos:altLabel "Nicholas" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:StOdile a rpg:Character ;
    rpg:name "St. Odile" ;
    dc:description "A 7th-century saint born blind to duke Adalric, who miraculously recovered her sight upon baptism, established a convent at the Hohenburg, and brought forth a curative spring." ;
    skos:altLabel "Odile" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:StPatrick a rpg:Character ;
    rpg:name "St. Patrick" ;
    dc:description "A holy man who came from Ireland to Glastonbury and was made abbot, bringing the monks under a rule of life just before the time of Arthur." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:StSwithinSSoupbowl a rpg:Item ;
    rpg:name "St. Swithin's Soupbowl" ;
    dc:description "An ancient stone column topped by a stone bowl, set there by Viking raiders; water left in the bowl by sunrise on St. Swithin's Day becomes Aquam vis by sunset." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:StSwithun a rpg:Character ;
    rpg:name "St. Swithun" ;
    dc:description "A saint to whom the cathedral priory (Oldminster) of Winchester and a church over Kingsgate are dedicated." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:StUrsula a rpg:Character ;
    rpg:name "St. Ursula" ;
    dc:description "A British princess who undertook a pilgrimage with 11,010 virginal handmaidens and was martyred with them at Cologne by the Huns; a church in Cologne marks their burial." ;
    skos:altLabel "Ursula" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:StVincent a rpg:Character ;
    rpg:name "St. Vincent" ;
    dc:description "Patron saint of wine; a deacon of Saragossa in northern Iberia who was martyred in 304." ;
    skos:altLabel "Vincent" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:StWenceslaus a rpg:Character ;
    rpg:name "St. Wenceslaus" ;
    dc:description "Bohemia's patron saint and former duke, murdered by his pagan brother Boleslav; it is foretold he will rise from the dead, take the sword of Bruncvik, and call forth his sleeping army at Mount Blanik." ;
    skos:altLabel "Wenceslaus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:StWerburg a rpg:Character ;
    rpg:name "St. Werburg" ;
    dc:description "A saint whose Benedictine abbey lies in Chester; in legend she resurrected an eaten goose and forbade geese from entering a particular field forever." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:StWulfstan a rpg:Character ;
    rpg:name "St. Wulfstan" ;
    dc:description "A bishop of Worcester before and after the Norman Conquest, credited with miraculously saving Bristol merchants at sea and abolishing the Bristol slave trade." ;
    skos:altLabel "Wulfstan" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:StaffOfStCurig a rpg:Item ;
    rpg:name "Staff of St. Curig" ;
    dc:description "A relic staff encased in gold and silver with a cross-shaped top, kept in the church of St. Germanus, that miraculously removes tumors when pressed against them with an offering of a penny." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:StagClan a rpg:Faction ;
    rpg:name "Stag Clan" ;
    dc:description "A Crintera clan that oversees the covenant's defense; its members are the most skilled soldiers, fighting with swords, and its leader serves as turb captain." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:StanceOfThePatientTree a rpg:Spell ;
    rpg:name "Stance of the Patient Tree" ;
    dc:description "A Muto Corpus spell (Level 35) with a Herbam requisite that turns the caster into a tree about 12 feet high; a tree branch lets the caster change back." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:StationOfThePerfectTool a rpg:Tag ;
    skos:prefLabel "Station of the Perfect Tool" ;
    dc:description "The first Station of the Criamon Path of the Body, reached via the Avenue of Subduing the Meat, where the magus realizes the body is the perfect tool for Hermetic magic." ;
    skos:altLabel "The Avenue of Subduing the Meat" ;
    rpg:hasTag amol:HermeticConcept .
amol:Stationer a rpg:Tag ;
    skos:prefLabel "Stationer" ;
    dc:description "A covenant staff member employed in the book trade to coordinate production, purchase scribal supplies, and dispatch books, often dealing with Redcaps." ;
    rpg:hasTag amol:CharacterType .
amol:StatutesOfLBeck a rpg:Tag ;
    skos:prefLabel "Statutes of Lübeck" ;
    dc:description "Special privileges granted to Lübeck by Henry the Lion that let it govern itself independently under a merchant council led by the Älderman." ;
    rpg:hasTag amol:HermeticConcept .
amol:SteadyingHand a rpg:Spell ;
    rpg:name "Steadying Hand" ;
    dc:description "A power of the angel Nasir (5 points, Animal/Corpus) that, by touching a target, ensures their footing is firm so they will not slip or fall while contact is maintained." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Stellapser a schema:Place ;
    rpg:name "Stellapser" ;
    dc:description "A ruin in the West Country near which the region is suitable for magical colonization." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Stellasper a rpg:Faction ;
    rpg:name "Stellasper" ;
    dc:description "Covenant founded by Criamon magi in 1025 in the Scilly Isles southwest of Cornwall; destroyed in a great storm in 1163." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:StephenEruditus a rpg:Character ;
    rpg:name "Stephen Eruditus" ;
    dc:description "The Jerbiton magus who founded and leads Libellus; trained in the Rhine Tribunal, around seventy but looks mid-thirties, with a reputation for risk-taking." ;
    skos:altLabel "Stephen Eruditus of Jerbiton" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:StephenLangton a rpg:Character ;
    rpg:name "Stephen Langton" ;
    dc:description "The Archbishop of Canterbury (born 1165, archbishop since 1207), a noted Paris theologian who helped draft Magna Carta and seeks to establish the archbishop as the highest ecclesiastical authority in England." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Stettin a schema:Place ;
    rpg:name "Stettin" ;
    dc:description "A small port city on the River Oder overlooked by an old Wendish fortress, the ancestral home of the Pomeranian rulers, with the church of St. Jakob completed in 1187." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:StewardOfTheHouse a rpg:Tag ;
    skos:prefLabel "Steward of the House" ;
    dc:description "The administrator of House Jerbiton between primacies, resident at Valnastium and appointed at the Primus's whim, who organizes elections." ;
    skos:altLabel "Steward" ;
    rpg:hasTag amol:CharacterType .
amol:StillCasting a rpg:Tag ;
    skos:prefLabel "Still Casting" ;
    dc:description "A Mastered Spell special ability allowing a maga to cast a spell without gestures at no penalty." ;
    rpg:hasTag amol:HermeticConcept .
amol:StillTheRagingWaters a rpg:Spell ;
    rpg:name "Still the Raging Waters" ;
    dc:description "A Rego Aquam spell (ReAq 15) created by Falke that stills the waves on a small body of water to mirror-smoothness." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:StirTheSlumberingTree a rpg:Spell ;
    rpg:name "Stir the Slumbering Tree" ;
    dc:description "A Muto Herbam spell (Level 25) with a Mentem requisite that raises a tree to human-like consciousness, able to see, hear, and rearrange its branches." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:StockadeParmaMagica a rpg:Tag ;
    skos:prefLabel "Stockade Parma Magica" ;
    dc:description "A Minor Hermetic Flaw in which the character cannot suppress his Parma Magica once erected, so friendly spells must penetrate it as if hostile." ;
    rpg:hasTag amol:Flaw .
amol:StoneOfTheBlackSerpent a rpg:Item ;
    rpg:name "Stone of the Black Serpent" ;
    dc:description "A wish-granting stone in the Black Serpent's tail that gives its holder as much gold as desired; Peredur took only this from his victory." ;
    skos:altLabel "the stone in the serpent's tail" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:StoneToFallingDust a rpg:Spell ;
    rpg:name "Stone to Falling Dust" ;
    dc:description "A Perdo Terram spell that turns one solid non-living object of base Individual size or smaller into a pile of dust." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:StoneCuttingKnife a rpg:Item ;
    rpg:name "Stone-Cutting Knife" ;
    dc:description "A Rego Terram 15 enchanted chisel that shapes and forms stone as a stonemason would, usable to carve blocks from a quarry; can boost quarry productivity." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:Stones a rpg:Creature ;
    rpg:name "Stones" ;
    dc:description "A Serious Choleric or Phlegmatic Disease in which coagulated bile or phlegm forms hard stones in the gallbladder, kidney, or bladder." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Strassburg a schema:Place ;
    rpg:name "Strassburg" ;
    dc:description "A Rhine trade city at the confluence of the Ill and the Rhine, originally the Roman Argentoratum, whose powerful boater's gild controls much of the Upper Rhine trade." ;
    skos:altLabel "Argentoratum" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:StrataFlorida a schema:Place ;
    rpg:name "Strata Florida" ;
    dc:description "A particularly important Cistercian monastery in Powys, Wales, serving as a repository of history and mausoleum of princely dynasties." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Strife a rpg:Tag ;
    skos:prefLabel "Strife" ;
    dc:description "In Criamon cosmology, the force that divides and promotes separation; one of the two great forces of the universe, reflected by the Art of Perdo and the source of magic's power." ;
    rpg:hasTag amol:HermeticConcept .
amol:StubnitzForest a schema:Place ;
    rpg:name "Stubnitz Forest" ;
    dc:description "The largest forest on Rugen, on the Jasmund peninsula, deep within which the covenant Crintera lies; also containing the mysterious Hertha Lake." ;
    skos:altLabel "Stubnitz" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:StuckInYourWays a rpg:Tag ;
    skos:prefLabel "Stuck in Your Ways" ;
    dc:description "A Minor General Flaw in which the character insists on doing things his old covenant's way, using the lower of an Ability and his current Covenant Lore for certain Stress Rolls." ;
    rpg:hasTag amol:Flaw .
amol:StudentOfFaerie a rpg:Tag ;
    skos:prefLabel "Student of Faerie" ;
    dc:description "A Virtue representing study of faeries; very common among Faerie Doctors." ;
    rpg:hasTag amol:Virtue .
amol:StudentOfMagic a rpg:Tag ;
    skos:prefLabel "Student of Magic" ;
    dc:description "A Virtue suggested as appropriate for Mercurian characters." ;
    rpg:hasTag amol:Virtue .
amol:StudentOfMagicRealm a rpg:Tag ;
    skos:prefLabel "Student of Magic Realm" ;
    dc:description "A Mystery Virtue the Titanoi cult can Initiate." ;
    rpg:hasTag amol:Virtue .
amol:Studio a rpg:Tag ;
    skos:prefLabel "Studio" ;
    dc:description "A Free laboratory Structure Virtue: an ornate room outside the lab displays the owner's prized possessions to guests, commonly built by Verditius magi." ;
    rpg:hasTag amol:Virtue .
amol:Styx a rpg:Creature ;
    rpg:name "Styx" ;
    dc:description "The wife of Pallas, representing the underworld river upon which solemn oaths are sworn; her name means \"hatred\" and she bore the Daimons Zelos, Kratos, Peitho, Nike, and Bia." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Subterranean a rpg:Tag ;
    skos:prefLabel "Subterranean" ;
    dc:description "A Free laboratory Structure Flaw: the lab is underground, lacking natural light and requiring more candles (+1 Upkeep, -1 Health, -1 Aesthetics, +1 Terram)." ;
    rpg:hasTag amol:Flaw .
amol:SubtleForm a rpg:Spell ;
    rpg:name "Subtle Form" ;
    dc:description "A power (Corpus) of the angels Nasir and Seferiel that lets them change their appearance to look like any human being without changing their statistics." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:SubtleTasteOfPoisonAndPurity a rpg:Spell ;
    rpg:name "Subtle Taste of Poison and Purity" ;
    dc:description "An Intellego Aquam spell (Level 5) that lets the caster taste all properties of any liquid or mixture of liquids tasted." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Succubus a rpg:Creature ;
    rpg:name "Succubus" ;
    dc:description "An Infernal entity that sometimes poses as a faerie partner, making intercourse with it worse than the mortal sin of faerie bestiality." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Sula a rpg:Character ;
    rpg:name "Sula" ;
    dc:description "The autocrat of Durenmar, a wrinkled and gentle woman over ninety who arranges accommodation for visitors with uncanny ease." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:SuleimanSWrathOnTheOathForsakenJinni a rpg:Spell ;
    rpg:name "Suleiman's Wrath on the Oath-Forsaken Jinni" ;
    dc:description "A PeVi spell that weakens and possibly destroys a creature with Magic Might, permanently destroying one reduced to zero Might." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Summoning a rpg:Proficiency ;
    rpg:name "Summoning" ;
    dc:description "The Major non-Hermetic Virtue of the Witches of Thessaly tradition, described in Realms of Power: The Infernal." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:SummoningCircle a rpg:Tag ;
    skos:prefLabel "Summoning Circle" ;
    dc:description "A laboratory Feature: an elaborate pentagram marked on the floor into which things are summoned, providing Experimentation, Spells, Creo, Rego, Animal, and Vim Specializations." ;
    rpg:hasTag amol:HermeticConcept .
amol:SummoningTheCreepingDeath a rpg:Spell ;
    rpg:name "Summoning the Creeping Death" ;
    dc:description "A Cr(Re)An 25 spell that conjures an obedient asp with deadly venom but no Might; sometimes used by School of Sebastian followers but disdained by other Flambeau magi as ignoble." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:SummoningTheSpiritOfAnger a rpg:Spell ;
    rpg:name "Summoning the Spirit of Anger" ;
    dc:description "A ReMe 40 spell that calls a spirit of wrath to the magus's location via an Arcane Connection or its full name, inflicting a Warping Point on the source of the anger." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:SunderingOfTremere a rpg:Tag ;
    skos:prefLabel "Sundering of Tremere" ;
    dc:description "An event that reduced House Tremere's power, after which Blackthorn's influence in the tribunal was diminished." ;
    rpg:hasTag amol:HermeticConcept .
amol:SuperiorConstruction a rpg:Tag ;
    skos:prefLabel "Superior Construction" ;
    dc:description "A Free laboratory Structure Virtue: the lab benefits from distinguished construction techniques or materials (+1 Safety, +1 Aesthetics)." ;
    rpg:hasTag amol:Virtue .
amol:SuperiorDecoration a rpg:Tag ;
    skos:prefLabel "Superior Decoration" ;
    dc:description "A Minor laboratory Outfittings Virtue: the lab is luxuriantly decorated, e.g. with fine tapestries (+1 Upkeep, +2 Aesthetics, +1 Imaginem)." ;
    rpg:hasTag amol:Virtue .
amol:SuperiorEquipment a rpg:Tag ;
    skos:prefLabel "Superior Equipment" ;
    dc:description "A Free laboratory Outfittings Virtue: the lab has higher-quality equipment such as Venetian glassware (+1 General Quality, +2 Upkeep, +1 Safety, +1 Vis Extraction)." ;
    rpg:hasTag amol:Virtue .
amol:SuperiorHeating a rpg:Tag ;
    skos:prefLabel "Superior Heating" ;
    dc:description "A Minor laboratory Outfittings Virtue: the lab has superior heating facilities so the occupant is never chilly (+1 Upkeep, +1 Health, +1 Aesthetics, +1 Ignem)." ;
    rpg:hasTag amol:Virtue .
amol:SuperiorLighting a rpg:Tag ;
    skos:prefLabel "Superior Lighting" ;
    dc:description "A Minor laboratory Outfittings Virtue: the lab is very well lit so things are easy to find and books easy to read (+1 Upkeep, +1 Aesthetics, +1 Texts, +1 Imaginem)." ;
    rpg:hasTag amol:Virtue .
amol:SuperiorTools a rpg:Tag ;
    skos:prefLabel "Superior Tools" ;
    dc:description "A Free laboratory Outfittings Virtue: the lab's tools were produced by master craftsmen (+1 Upkeep, +1 Safety, +1 Items)." ;
    rpg:hasTag amol:Virtue .
amol:SupernaturalAbility a rpg:Tag ;
    skos:prefLabel "Supernatural Ability" ;
    dc:description "A non-Hermetic supernatural skill that an apprentice may possess; whether it is retained, converted into a Hermetic Virtue, or lost depends on the master's Intellego Vim Lab Total." ;
    rpg:hasTag amol:HermeticConcept .
amol:SuppleIronAndRigidRope a rpg:Spell ;
    rpg:name "Supple Iron and Rigid Rope" ;
    dc:description "A Muto Terram spell that makes a flexible object stiff or a stiff object flexible, with appropriate Form requisites." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:SuppressedGift a rpg:Tag ;
    skos:prefLabel "Suppressed Gift" ;
    dc:description "A Major Hermetic Story Flaw in which the character has The Gift but cannot access its power, temporarily unable to perform Hermetic magic, improve Arts, or use Parma Magica." ;
    rpg:hasTag amol:Flaw .
amol:SuppressingTheWizardSHandiwork a rpg:Spell ;
    rpg:name "Suppressing the Wizard's Handiwork" ;
    dc:description "A Rego Vim spell that cancels one of the caster's own active spells for as long as concentration is maintained, with effects returning when concentration breaks." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Susanna a rpg:Character ;
    rpg:name "Susanna" ;
    dc:description "The liberal-minded mater of Petrus Virilis, who researched fertility and the Gift and has since entered Final Twilight." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:SusceptibilityToMagic a rpg:Tag ;
    skos:prefLabel "Susceptibility to Magic" ;
    dc:description "A Minor Curse (Rego Vim effect) that strips a victim's natural resistance to magic, imposing a -3 to resist spells and supernatural effects." ;
    rpg:hasTag amol:Flaw .
amol:SusceptibilityToSunlight a rpg:Tag ;
    skos:prefLabel "Susceptibility to Sunlight" ;
    dc:description "A Minor Supernatural Flaw in which direct bright sunlight causes the character pain and exhaustion, giving -2 to sight rolls in bright environments and Fatigue loss outdoors." ;
    rpg:hasTag amol:Flaw .
amol:SusceptibilityToWarping a rpg:Tag ;
    skos:prefLabel "Susceptibility to Warping" ;
    dc:description "A Minor Supernatural Flaw in which the character gains an additional Warping Point from each Realm whenever he gains one in a year, without contributing to Twilight." ;
    rpg:hasTag amol:Flaw .
amol:Suspirium a rpg:Character ;
    rpg:name "Suspirium" ;
    dc:description "A ninth-century Bjornaer magus, the most recent common ancestor of Stellatus and Lacerta, after whom their sept was renamed." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Svantovit a rpg:Creature ;
    rpg:name "Svantovit" ;
    dc:description "A four-faced Slavic sun- and war-god worshipped at Arkona, whose Faerie aura lingers despite the temple's destruction; opposed to the Queen of Winter, granting Falke's ritual a bonus." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Swabia a schema:Place ;
    rpg:name "Swabia" ;
    dc:description "The duchy surrounding the Black Forest, extending to Bavaria and the Alps, whose recent history is dominated by the rival Zähringen and Hohenstaufen families." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:SwanClan a rpg:Faction ;
    rpg:name "Swan Clan" ;
    dc:description "The smallest Crintera clan, comprising crafts-folk and companions with non-shapechanging magical powers; led by Janis, contact with the pagan Forest Brothers of Rügen." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:SwiftKnivesInvisible a rpg:Spell ;
    rpg:name "Swift Knives, Invisible" ;
    dc:description "A Perdo Animal 40 spell with Rego requisite that reduces a dead animal to its components, such as wool, hide, meat, organs, and skeleton." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:SwordFromTheUnseenScabbard a rpg:Spell ;
    rpg:name "Sword from the Unseen Scabbard" ;
    dc:description "A CrTe 15 spell that conjures a steel longsword lasting about two minutes; it must penetrate Magic Resistance to harm magic-resistant opponents." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:SwordOfBruncvik a rpg:Item ;
    rpg:name "Sword of Bruncvik" ;
    dc:description "The legendary sword that St. Wenceslaus is foretold to take up when he rises from the dead to lead his army." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:SwordsmithsGuild a rpg:Faction ;
    rpg:name "Swordsmiths' Guild" ;
    dc:description "The craftsmen's guild of swordsmiths; Klaus the example craftsman is a master of it." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Sympathy a rpg:Tag ;
    skos:prefLabel "Sympathy" ;
    dc:description "A combined natural principle of affinity and similarity through which objects resonate, e.g. a bloodstone resonating with wounds; basis of many Shape and Material bonuses." ;
    rpg:hasTag amol:HermeticConcept .
amol:Synthemata a rpg:Tag ;
    skos:prefLabel "Synthemata" ;
    dc:description "Signs, symbols, or passwords that link a magician to a supernatural creature, used in theurgic incantations; any being with a Might score has them." ;
    rpg:hasTag amol:HermeticConcept .
amol:Szarlen a rpg:Character ;
    rpg:name "Szarlen" ;
    dc:description "A demon who operates a lead mine for the Polish town of Beuthen in return for services such as appropriating the Church's tithe or requiring worship." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Tablinum a rpg:Faction ;
    rpg:name "Tablinum" ;
    dc:description "A storehouse of information and artefacts in the Transylvanian Tribunal under the control of House Tremere, existing across numerous regiones entered only via spells requiring Arcane Connections held by its curator." ;
    skos:altLabel "the oppidum of Tablinum" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:TaintedOffspring a rpg:Tag ;
    skos:prefLabel "Tainted Offspring" ;
    dc:description "A Major Story Tainted Flaw in which the character has a child marked for great but unpleasant things by a powerful demon, requiring struggle against the demon's servants." ;
    rpg:hasTag amol:Flaw .
amol:TaintedVirtuesAndFlaws a rpg:Tag ;
    skos:prefLabel "Tainted Virtues and Flaws" ;
    dc:description "A category of Virtues and Flaws associated with the Infernal realm, gained through demonic corruption; Supernatural abilities they grant are always Infernal powers." ;
    rpg:hasTag amol:HermeticConcept .
amol:TaklamakanDesert a schema:Place ;
    rpg:name "Taklamakan Desert" ;
    dc:description "A desert where Infernal storm spirits such as the Buran of Yenghissar are likely to be found." ;
    skos:altLabel "Taklamakan" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TalesOfTheAshes a rpg:Spell ;
    rpg:name "Tales of the Ashes" ;
    dc:description "An Intellego Ignem spell (Level 5) that lets the caster see what touched ashes originally were and how and when the object was burned." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TalhaearnTadAwen a rpg:Character ;
    rpg:name "Talhaearn Tad Awen" ;
    dc:description "One of the five great Welsh poets believed by the Order to have left Daimons behind after death." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Taliesin a rpg:Character ;
    rpg:name "Taliesin" ;
    dc:description "One of the five great Welsh poets believed by the Order to have left Daimons behind after death." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:TalionOfFlambeau a rpg:Character ;
    rpg:name "Talion of Flambeau" ;
    dc:description "An ancient Flambeau magus, second oldest in the tribunal, who became praeco after Immanola was disqualified; renowned for mastery of Perdo." ;
    skos:altLabel "Talion", "Talion of Blackthorn" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Talos a rpg:Creature ;
    rpg:name "Talos" ;
    dc:description "A bull-headed bronze statue (automaton) made by Hephaestus that guarded Crete." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Taltos a rpg:Faction ;
    rpg:name "Taltos" ;
    dc:description "Wizards among the Magyar people of Hungary who use herbcraft to boost their physical characteristics and martial skills and to heal; many have Skinchanger; a Pharmocopoeian variant." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Tandaline a rpg:Character ;
    rpg:name "Tandaline" ;
    dc:description "A Follower of Bonisagus of Trianoma's lineage, a master of Muto and Auram, closest confidante of Murion and a Tenens Occultorum who maintains the House's correspondence." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:TannhUser a rpg:Character ;
    rpg:name "Tannhäuser" ;
    dc:description "A young 13th-century knight and poet of legend who discovered Venus's subterranean home, the Venusberg, and later sought absolution from the Pope." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Tarantism a rpg:Creature ;
    rpg:name "Tarantism" ;
    dc:description "A condition that works wholly differently from a disease, stemming from a faerie curse." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Tarnkappe a rpg:Item ;
    rpg:name "Tarnkappe" ;
    dc:description "A magical cloak of darkness taken by Siegfried from the dwarf Alberich, used to render him invisible and substitute for Gunther in the contests with Brünhild." ;
    skos:altLabel "cloak of darkness" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TasteOfTheDulledTongue a rpg:Spell ;
    rpg:name "Taste of the Dulled Tongue" ;
    dc:description "A Perdo Imaginem spell (Level 5) that hides the taste of any substance, liquid or solid." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TeethOfTheEarthMother a rpg:Spell ;
    rpg:name "Teeth of the Earth Mother" ;
    dc:description "A Muto Terram spell that springs twenty sharp white marble pillars from the ground in a circle, able to cage, wall, or skewer enemies for +25 damage." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Tello a rpg:Character ;
    rpg:name "Tello" ;
    dc:description "The Bishop of Palencia who works with the king to stabilize the university, allowing the masters an advisory council under the chancellor." ;
    skos:altLabel "Bishop Tello" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Telramund a rpg:Character ;
    rpg:name "Telramund" ;
    dc:description "A rebellious vassal of the late duke of Brabant who sought the dukedom and Elsa's hand and was defeated by Lohengrin in single combat." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:TemplarAdministrator a rpg:Tag ;
    skos:prefLabel "Templar Administrator" ;
    dc:description "A Minor Social Status Virtue for a brother of the Poor Knights of the Temple of Solomon who administers the order's holdings rather than fighting; available only to male characters." ;
    rpg:hasTag amol:Virtue .
amol:TemplarConfrereOrConsoeur a rpg:Tag ;
    skos:prefLabel "Templar Confrere or Consoeur" ;
    dc:description "A Free Social Status Virtue for an associate member of the Poor Knights of the Temple of Solomon who has taken one or two Templar vows." ;
    rpg:hasTag amol:Virtue .
amol:TemplarOfficeHolder a rpg:Tag ;
    skos:prefLabel "Templar Office Holder" ;
    dc:description "A Minor Social Status Virtue for a character holding a position in the local hierarchy of the Poor Knights of the Temple of Solomon, such as deputy commander or marshal." ;
    rpg:hasTag amol:Virtue .
amol:TemplarPrestige a rpg:Tag ;
    skos:prefLabel "Templar Prestige" ;
    dc:description "A Minor General Virtue: a member of the Poor Knights of the Temple of Solomon who enjoys great respect among fellow brothers, starting with a Reputation of level 4 within the Templars." ;
    rpg:hasTag amol:Virtue .
amol:TemplarServant a rpg:Tag ;
    skos:prefLabel "Templar Servant" ;
    dc:description "A Free Social Status Virtue for a servant working at a Templar commandery, supported and protected by the order's papal bull." ;
    rpg:hasTag amol:Virtue .
amol:TemplarSpecialist a rpg:Tag ;
    skos:prefLabel "Templar Specialist" ;
    dc:description "A Minor Social Status Virtue for a skilled employee of the Poor Knights of the Temple of Solomon filling a crucial role such as craftsman or translator." ;
    rpg:hasTag amol:Virtue .
amol:TempleOfIsis a schema:Place ;
    rpg:name "Temple of Isis" ;
    dc:description "An abandoned but well-repaired Roman temple within a magical regio in Florence's Piazza San Firenze, a potential covenant site holding relics of the Cults of Isis and Mercury." ;
    skos:altLabel "Roman Temple of Isis" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TenensOccultorum a rpg:Tag ;
    skos:prefLabel "Tenens Occultorum" ;
    dc:description "A House Bonisagus office held by Tandaline, appointed by Murion, involving keeping written contact across the House." ;
    rpg:hasTag amol:CharacterType .
amol:TeriousOfFlambeau a rpg:Character ;
    rpg:name "Terious of Flambeau" ;
    dc:description "A magus of House Flambeau who walked the Path of Energy, became a living embodiment of the genius locus, and contributed the spell Replenishing the Fount of the Magus to the Great Library." ;
    skos:altLabel "Terious" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:TerschellingIsland a schema:Place ;
    rpg:name "Terschelling (island)" ;
    dc:description "A Friesian island on a deserted coastline that is home to the Waddenzee covenant and thousands of seabirds." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TestOfFastnessAndFading a rpg:Spell ;
    rpg:name "Test of Fastness and Fading" ;
    dc:description "An Intellego Aquam 5 spell that confirms the quality of a container of ink, dye, or paint, verifying it will not fade, flake, or eat through parchment." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TestOfTheFlames a rpg:Spell ;
    rpg:name "Test of the Flames" ;
    dc:description "A CrIg 15 spell filling a circle with waist-high flames doing +5 damage per round; of ancient Cult of Mithras origin, once used by Flambeau magi as an endurance test alternative to certamen." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TetheredMagic a rpg:Tag ;
    skos:prefLabel "Tethered Magic" ;
    dc:description "A Minor Hermetic Virtue letting a magus pass control of non-Ritual spells to others or tether them to objects, at the cost that all his spells become Arcane Connections to him." ;
    rpg:hasTag amol:Virtue .
amol:ThamikOfVerditius a rpg:Character ;
    rpg:name "Thamik of Verditius" ;
    dc:description "A young Verditius magus among the members recruited to Nigrasaxa." ;
    skos:altLabel "Thamik" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:ThannChapel a schema:Place ;
    rpg:name "Thann Chapel" ;
    dc:description "A chapel west of Mulhouse in the southern Vosges, built over a miraculous holy staff containing the ring and thumb of Theobald of Gubbio; has a Divine aura of 3 and is a place of pilgrimage." ;
    skos:altLabel "chapel of Thann" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:ThaumaturgicalTransformationOfPlantsToIron a rpg:Spell ;
    rpg:name "Thaumaturgical Transformation of Plants to Iron" ;
    dc:description "A Muto Herbam spell (Level 20) with a Terram requisite that makes any plant as hard as iron, up to the size of a small tree." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheOverFamiliarCat a rpg:Creature ;
    rpg:name "The (Over) Familiar Cat" ;
    dc:description "A magical familiar cat with Magic Might 10 (Imaginem) bonded to a magus, with powers of night-vision and invisible movement and shared-senses bond effects." ;
    skos:altLabel "Familiar Cat" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:TheAgue a rpg:Creature ;
    rpg:name "The Ague" ;
    dc:description "A Major Phlegmatic Disease (Severity 14) caused by bad air around sewage and tanneries, marked by continuous fever with chills." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:TheAlderPrince a rpg:Creature ;
    rpg:name "The Alder Prince" ;
    dc:description "The compassionate, secretive faerie ruler of the western Alder Forest among the Courts of the Seasons, strongest in spring, who woos and is repeatedly entrapped by the Willow Maiden." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:TheAmbulatoryLaboratory a rpg:Spell ;
    rpg:name "The Ambulatory Laboratory" ;
    dc:description "A Rego Terram 30 spell that transports a chamber's movable contents to another room via Arcane Connection, used by magi to move their labs without mundane effort." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheAnimalPowers a rpg:Creature ;
    rpg:name "The Animal Powers" ;
    dc:description "Ancient mysterious entities that ruled the Stubnitz region before the Bjornaer; revered at Crintera as animal-shaped fetishes said to house primordial spirits of nature." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:TheAntigones a rpg:Faction ;
    rpg:name "The Antigones" ;
    dc:description "A new generation of interventionist Jerbiton magi ('those like their ancestors'), trained after the fall of Constantinople, who favor political engagement, aggression, and large House covenants." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:TheAppleThatEtches a rpg:Spell ;
    rpg:name "The Apple That Etches" ;
    dc:description "A Creo Herbam 20 ritual that creates 100,000 oak galls used for ink, useful to covenants closed off from the mortal world with abundant Herbam vis." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheAppleOfTheKyffhauser a rpg:Creature ;
    rpg:name "The Apple of the Kyffhauser" ;
    dc:description "A magic spirit (Magic Might 70) manifesting as a withered apple tree at the base of the Kyffhauser, guarded by men-at-arms, that grants victory and lordship to whoever hangs their shield on it." ;
    skos:altLabel "the tree at Kyffhauser", "the withered apple tree" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:TheArchpoet a rpg:Character ;
    rpg:name "The Archpoet" ;
    dc:description "An anonymous bawdy twelfth-century Latin poet and famed leader of the Goliardic tradition, rumored to have been a magus, whose poems a Bonisagus magus claims encode Mentem lore." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:TheArtOfMagic a rpg:Item ;
    rpg:name "The Art of Magic" ;
    dc:description "Bonisagus's epitome concerning Magic Theory, etched by later magi into 36 six-foot clear crystals at the Forest of Shining Stone, Durenmar." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheAuberge a schema:Place ;
    rpg:name "The Auberge" ;
    dc:description "A long-forgotten Mercere way station on a river island, accessible only through a Roman ruin's doorway into a Magical regio; its three spirit guardians give departing magi food containing Vim vis." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheAvariciousnessOfThePtolemies a rpg:Spell ;
    rpg:name "The Avariciousness of the Ptolemies" ;
    dc:description "A Rego Animal 4 ward that prevents those lacking Magic Resistance from removing a book across an inscribed circle or doorway." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheBalticSea a schema:Place ;
    rpg:name "The Baltic Sea" ;
    dc:description "The sea across which Baltic trade ceases each winter when the Queen of Winter freezes it; a ritual at Arkona must be performed to thaw the ice." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheBearsCave a schema:Place ;
    rpg:name "The Bears' Cave" ;
    dc:description "A hidden primeval cave in the northern Harz (Magic aura 3) strewn with ancient bear bones that may be harvested for Animal vis; secret vis source of a Bjornaer bear lineage." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheBeastRemade a rpg:Spell ;
    rpg:name "The Beast Remade" ;
    dc:description "A Muto Animal spell (Level 25) with a Corpus requisite that gives a land beast a human form while retaining its intellect and some animal feature." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheBetrayal a rpg:Tag ;
    skos:prefLabel "The Betrayal" ;
    dc:description "The event in 961 AD when Kalliste exposed Tasgillia's diabolism publicly, shaming House Tytalus; Tytali view it as Kalliste betraying the Founder's principle of putting nature before custom." ;
    skos:altLabel "the Corruption" ;
    rpg:hasTag amol:HermeticConcept .
amol:TheBlackFir a rpg:Creature ;
    rpg:name "The Black Fir" ;
    dc:description "A sinister magical fir tree near Durenmar's Great Library, key to a faerie revenge plot; it slowly inches toward the Tower of Bonisagus as part of the King of the Black Mountain's scheme." ;
    skos:altLabel "the fir" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:TheBlackHorseOfBusha a rpg:Creature ;
    rpg:name "The Black Horse of Busha" ;
    dc:description "A proud black stallion seen as a figure in black shale in the Howgill Fells, said to travel the mundane world under cover of storms with purposes that bode no good." ;
    skos:altLabel "Black Horse" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:TheBlindedSentry a rpg:Spell ;
    rpg:name "The Blinded Sentry" ;
    dc:description "A Perdo Mentem 5 spell invented by Imanitos Mendax that renders a target insensate for a moment, registering only the initial touch." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheBohemianForest a schema:Place ;
    rpg:name "The Bohemian Forest" ;
    dc:description "A massive forest, safe from man due to harsh climate and peat bogs, haunt of lynx, wolves, deer, and giants; home to Irencillia and (in its south) Fenistal." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheBookOfMundaneBeasts a rpg:Tag ;
    skos:prefLabel "The Book of Mundane Beasts" ;
    dc:description "A free Atlas Games supplement describing beasts of Mythic Europe, on which the Virtuous Hound, Familiar Cat, and skinchanger's raven form are based." ;
    rpg:hasTag amol:HermeticConcept .
amol:TheBookOfOneThousandAndOneNights a rpg:Item ;
    rpg:name "The Book of One Thousand and One Nights" ;
    dc:description "A collection of stories begun in the ninth century around which the Keepers of the Thousand Tales formed; they believe several of its characters are magi who have passed into Arcadia." ;
    skos:altLabel "the Thousand Tales" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheBookOfPoisons a rpg:Item ;
    rpg:name "The Book of Poisons" ;
    dc:description "A book by Ibn Wahshiya, quoted for a recipe to make a poison from a scorpion-stung mouse, hellebore, and other ingredients." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheBookstandOfHespera a rpg:Item ;
    rpg:name "The Bookstand of Hespera" ;
    dc:description "A wooden lectern enchanted (ReHe 15) to follow the magus around the lab, holding a Lab Text and adding two points to a Texts Specialization." ;
    skos:altLabel "The Bookstand" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheBoxOfUnguardedThoughts a rpg:Item ;
    rpg:name "The Box of Unguarded Thoughts" ;
    dc:description "A small silver coffer inlaid with mother-of-pearl that collects nearby stray thoughts and distills them into silver coins containing Mentem vis, potentially serving as Arcane Connections." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheBrushstrokesRevealed a rpg:Spell ;
    rpg:name "The Brushstrokes Revealed" ;
    dc:description "An InIm 10 spell that makes species cast by an object within a circle more vivid, revealing tiny details otherwise invisible, used to investigate artworks and creation." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheBuskam a schema:Place ;
    rpg:name "The Buskam" ;
    dc:description "The largest of Rugen's mysterious findlinge boulders, partially submerged off the Monchgut peninsula and a site of Slavic worship; said to be left by giants from an epic battle." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheCabalOfErigone a rpg:Faction ;
    rpg:name "The Cabal of Erigone" ;
    dc:description "A House Tytalus cabal, symbolized by a triangular clavicula, determined to prevent Caecilius of Durenmar from becoming praeco of the Rhine Tribunal." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:TheCabalOfTheBrokenOcean a rpg:Faction ;
    rpg:name "The Cabal of the Broken Ocean" ;
    dc:description "A House Tytalus cabal, symbolized by a clockwise turbo of four lines, that provides covert support to the pagans of Lithuania against the Teutonic Knights." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:TheCabalOfTheLance a rpg:Faction ;
    rpg:name "The Cabal of the Lance" ;
    dc:description "A House Tytalus cabal, symbolized by a helix made from chain, covertly shielding a newly formed covenant from the intrigue of its Tribunal for an unclear purpose." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:TheCabalOfTheShiningEye a rpg:Faction ;
    rpg:name "The Cabal of the Shining Eye" ;
    dc:description "A House Tytalus cabal, symbolized by a concha with an eagle at the center, dedicated to maneuvering the Roman Tribunal into colonization of North Africa." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:TheCarnalWolf a rpg:Creature ;
    rpg:name "The Carnal Wolf" ;
    dc:description "An adulteration caged within the Cave of Twisting Shadows, a great wolf with jaws too large to close, embodying the carnal urges of Demetrius; used to teach apprentices about spiritual impurity." ;
    skos:altLabel "the Wolf" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:TheCarpenterSKeenEye a rpg:Spell ;
    rpg:name "The Carpenter's Keen Eye" ;
    dc:description "An InHe 15 spell (Voice, Momentary, Group) by which a magus learns whether wood is suitable for carpentry and what treatment it needs." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheCerneGiant a rpg:Creature ;
    rpg:name "The Cerne Giant" ;
    dc:description "A blatantly phallic figure carved on a Dorset hillside, said to be the lingering presence of a giant who terrorized the area before being slain; barren women who sleep on the phallus may conceive." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:TheClandestineMask a rpg:Spell ;
    rpg:name "The Clandestine Mask" ;
    dc:description "A MuIm 4 spell that blurs the caster's face and distorts her voice so she cannot be recognized; the disguise's form is determined by the caster's sigil." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheCleanSlate a rpg:Spell ;
    rpg:name "The Clean Slate" ;
    dc:description "A Perdo Mentem spell that wipes the target's memory clean, removing identity, Academic/Arcane/Martial/Supernatural Abilities, and all Arts." ;
    skos:altLabel "PeMe 50" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheCloudlessSkyReturned a rpg:Spell ;
    rpg:name "The Cloudless Sky Returned" ;
    dc:description "A Perdo Auram spell (Level 45) that clears the sky within the caster's vision of clouds and meteorological activity short of a hurricane or tornado." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheConstantExpression a rpg:Tag ;
    skos:prefLabel "The Constant Expression" ;
    dc:description "A Major Hermetic Flaw: the maga perpetually casts non-fatiguing Spontaneous magic effects, losing a permanent long-term Fatigue level and making laboratory work risky." ;
    rpg:hasTag amol:Flaw .
amol:TheCourtsOfTheSeasons a rpg:Faction ;
    rpg:name "The Courts of the Seasons" ;
    dc:description "Four intrinsically linked faerie woodland courts (Holly, Alder, Oak, Willow) tied to the passage of the seasons, formed when one forest spirit splintered into four and each allied with a faerie lord." ;
    skos:altLabel "Four Seasonal Courts" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:TheCrinteraSchism a rpg:Tag ;
    skos:prefLabel "The Crintera Schism" ;
    dc:description "A saga concept revolving around the troubles within Crintera: the shapeshifter feud, the Harmonist-Wilderist split, and the Rügen crisis, culminating in the covenant being sundered and warring domus magnae." ;
    rpg:hasTag amol:HermeticConcept .
amol:TheCrone a rpg:Character ;
    rpg:name "The Crone" ;
    dc:description "An aged, respected village woman with the Unaging Virtue whose menstrual blood contains Creo vis; though not Gifted, she knows something of magic and serves as a vis source near a covenant." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:TheCrownOfHermes a rpg:Item ;
    rpg:name "The Crown of Hermes" ;
    dc:description "An elaborate jewel-encrusted golden crown (Cr(In,Mu,Re)Me 50) whose creator is lost to memory; it lets its wearer enter a trance to create and work in an imaginary laboratory, inflicting Warping points." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheCultOfVesta a rpg:Faction ;
    rpg:name "The Cult of Vesta" ;
    dc:description "A Merinita cult founded by magae of Brittany who venerate faeries as household gods (lares), adopt Vesta as patron, and take vows of chastity in exchange for faerie powers." ;
    skos:altLabel "the Vestals" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:TheDaughtersOfEcho a rpg:Faction ;
    rpg:name "The Daughters of Echo" ;
    dc:description "A Jerbiton league interested in magical methods of recording and reproducing events, led by a Merinita maga near Burnfoot in Hibernia." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:TheDeadOfAscalon a rpg:Creature ;
    rpg:name "The Dead of Ascalon" ;
    dc:description "The cursed corpses of a Muslim fleet defeated off Ascalon in 1123; their skulls, smuggled aboard rival ships by a merchant house, cause every cursed voyage to end tragically." ;
    skos:altLabel "skulls of Ascalon" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:TheDeathOfVermin a rpg:Item ;
    rpg:name "The Death of Vermin" ;
    dc:description "A Rego Animal 20 enchanted box that fills specific vermin with a desire to enter it, gathering them to be destroyed." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheDemandOfTheFrustratedScholarSoothed a rpg:Spell ;
    rpg:name "The Demand of the Frustrated Scholar Soothed" ;
    dc:description "A Rego Animal 40 spell that teleports a book within 500 paces to the caster's hand via an arcane connection; higher-level versions reach up to seven leagues." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheDragonOfBrNn a rpg:Creature ;
    rpg:name "The Dragon of Brünn" ;
    dc:description "A dragon that lived in a cave by the River Svratka near Brünn and devoured townsfolk, until a travelling butcher killed it with a lime-stuffed ox pelt; its stuffed carcass hangs in Brünn's town hall." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:TheDumbWaiter a rpg:Item ;
    rpg:name "The Dumb Waiter" ;
    dc:description "A Rego Terram level 35 enchanted device that instantly transports food and dishes from the kitchen to specified places in the covenant within 50 paces." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheEarForDistantVoices a rpg:Spell ;
    rpg:name "The Ear for Distant Voices" ;
    dc:description "An Intellego Imaginem spell (Level 20) that lets the caster hear what is happening in a designated place to which they have an Arcane Connection." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheEasternMarches a schema:Place ;
    rpg:name "The Eastern Marches" ;
    dc:description "The wild northeastern reaches of Germany between the Elbe and Oder, roamed by werewolves, witches, and giants, where pagan Slavic beliefs linger; claimed by the Rhine Tribunal." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheEdgesOfTheWorld a schema:Place ;
    rpg:name "The Edges of the World" ;
    dc:description "Four regiones corresponding to the four elements and humors to which a spirit-traveling Criamon magus is sequentially drawn, and from which he must escape back to his body." ;
    skos:altLabel "four Edges of the World" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheEnchantedChef a rpg:Item ;
    rpg:name "The Enchanted Chef" ;
    dc:description "A Rego Herbam (Animal, Aquam, Ignem) 45 enchanted pot that processes and transforms food into a described dish as if cooked, substituting Communication + Finesse for Craft: Cook." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheEnchantedPorter a rpg:Item ;
    rpg:name "The Enchanted Porter" ;
    dc:description "A Rego Terram 15 enchanted glove that lifts and pushes an inanimate object while the user holds and moves it; based on The Unseen Porter." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheEndOfHatred a rpg:Spell ;
    rpg:name "The End of Hatred" ;
    dc:description "A PeCo 50 Orphic spell that instantly slays a target against whom the caster has the Enemies Flaw; used only once in the Cult's history." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheEverWatchfulTurb a rpg:Spell ;
    rpg:name "The Ever-Watchful Turb" ;
    dc:description "A Perdo Mentem spell that prevents a target group from falling asleep by quelling the inclination to rest." ;
    skos:altLabel "PeMe 35" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheExsules a rpg:Faction ;
    rpg:name "The Exsules" ;
    dc:description "A small band of fewer than a dozen renegade House Merinita wizards based at Fenistal who rejected the Order; they know imperfect Hermetic magic and Parma Magica and prefer to turn nature against their enemies." ;
    skos:altLabel "the renegades" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:TheExternsteine a schema:Place ;
    rpg:name "The Externsteine" ;
    dc:description "An array of thirteen tall sandstone rocks on the southeastern edge of the Teutoburger Forest, a former pagan site now bearing a consecrated chapel with a Divine aura of 4." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheEyeOfTheSage a rpg:Spell ;
    rpg:name "The Eye of the Sage" ;
    dc:description "An Intellego Corpus spell (Level 30) with an Imaginem requisite that lets you see a specific person and what is within one pace of them, clearly enough to read." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheFaithfulMadeWhole a rpg:Spell ;
    rpg:name "The Faithful Made Whole" ;
    dc:description "A sample relic power (4 points, Init +15, Corpus) that cures the recipient of all disease and heals all physical wounds." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheFalconSHood a rpg:Spell ;
    rpg:name "The Falcon's Hood" ;
    dc:description "A Perdo Animal spell that destroys an animal's vision, with the blindness healing as a Medium Wound; also referenced earlier as PeAn 20." ;
    skos:altLabel "PeAn 20" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheFallenTempleOfMercury a schema:Place ;
    rpg:name "The Fallen Temple of Mercury" ;
    dc:description "A fallen temple of Mercury still containing details of some of the powerful rituals of the Cult of Mercury, referenced as a place/treasure (via the supplement Mythic Locations)." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheFarSpeakingVoice a rpg:Spell ;
    rpg:name "The Far-Speaking Voice" ;
    dc:description "A CrMe 20 spell that delivers two minutes of one-way conversation into the mind of a target to whom the caster holds an Arcane Connection." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheFeengrotten a schema:Place ;
    rpg:name "The Feengrotten" ;
    dc:description "Hidden crystal caves (Magic aura 1) on the eastern edge of the Thuringian Forest whose shifting passages cover explorers in glittering dust that is Imaginem vis for those genuinely lost." ;
    skos:altLabel "Faerie Grottoes" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheFirstFurrowGuidesTheSecond a rpg:Spell ;
    rpg:name "The First Furrow Guides the Second" ;
    dc:description "A Creo Imaginem 25 spell with Intellego requisite that lays a book page's image over a blank sheet so a scribe can trace it, creating identical copies and avoiding the scribing penalty." ;
    skos:altLabel "The Principal Aide to the Forger's Art" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheFlyingCastleOfThomae a schema:Place ;
    rpg:name "The Flying Castle of Thomae" ;
    dc:description "A flying castle crafted by a follower of Tytalus decades ago that simply vanished from Hermetic knowledge, referenced as a treasure to hunt (via the supplement Legends of Hermes)." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheGenethlialogicalInvestigation a rpg:Spell ;
    rpg:name "The Genethlialogical Investigation" ;
    dc:description "An Intellego Corpus 15 spell by which the caster learns a target's place and time of birth; casting it on a magus is tantamount to declaring Wizard's War." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheGentleBeast a rpg:Spell ;
    rpg:name "The Gentle Beast" ;
    dc:description "A Rego Animal spell (Level 25) that calms an animal, making it nearly fearless and tolerant of being ridden or handled." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheGentleHerd a rpg:Spell ;
    rpg:name "The Gentle Herd" ;
    dc:description "A ReAn 20 spell (Touch, Concentration, Group) that renders a group of animals calm and placid even while unusual events occur, ideal for soothing cattle being magically milked." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheGeographica a rpg:Item ;
    rpg:name "The Geographica" ;
    dc:description "A lost work by Ptolemy giving exact longitude and latitude for hundreds of legendary sites, many containing vis; House Mercere offers great quantities of vis for a complete copy." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheGiantSGrave a schema:Place ;
    rpg:name "The Giant's Grave" ;
    dc:description "A rectangular bed of large stones in the Everstorf Forest north of Schwerin, said to be the grave of a giant trapped and buried by villagers of Naschendorf." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheGiantSRing a schema:Place ;
    rpg:name "The Giant's Ring" ;
    dc:description "The ring of great healing stones standing on a hilltop in Ireland that Merlin transported by his art to become Stonehenge in England." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheGiantsCastle a schema:Place ;
    rpg:name "The Giants' Castle" ;
    dc:description "The remains of a primeval Celtic fortress on the edge of the Bohemian Forest, with a Magic aura of 3, where large fractured rocks were originally gathered by giants who may still visit." ;
    skos:altLabel "Obri Hrad" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheGiftChildStorySeed a rpg:Tag ;
    skos:prefLabel "The Gift (child story seed)" ;
    dc:description "Not an entity; placeholder removed." ;
    rpg:hasTag amol:HermeticConcept .
amol:TheGodOfLaw a rpg:Tag ;
    skos:prefLabel "The God of Law" ;
    dc:description "In the new dualist faith near the Bohemian Forest, the stern god who created and rules the material world but cares not for its inhabitants, falsely worshipped (the faith claims) by the Church." ;
    rpg:hasTag amol:HermeticConcept .
amol:TheGodOfTruth a rpg:Tag ;
    skos:prefLabel "The God of Truth" ;
    dc:description "The creator deity of a new dualist faith in the villages near the Bohemian Forest, said to be immaterial and found only in wild places, opposed to the God of Law; his angels are said to be faeries, and his prophet is Iacob." ;
    rpg:hasTag amol:HermeticConcept .
amol:TheGreatPlay a rpg:Tag ;
    skos:prefLabel "The Great Play" ;
    dc:description "A tournament hosted every few years by the Shadow-Masters in which a built labyrinth or setting filled with illusions challenges participants; succeeding wins the responsibility to host the next event." ;
    rpg:hasTag amol:HermeticConcept .
amol:TheGuideForThePerplexed a rpg:Item ;
    rpg:name "The Guide for the Perplexed" ;
    dc:description "A great summa on Jewish philosophy and theology written by Maimonides in 1190, infused with Aristotelian ideas, that sparked controversy among Jewish scholars." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheHalfShell a rpg:Item ;
    rpg:name "The Half Shell" ;
    dc:description "A large ship serving as the mobile site (an Edifice Boon) of the Swashbuckling covenant." ;
    skos:altLabel "The Large Ship The Half Shell" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheHerbalOfCrateuas a rpg:Item ;
    rpg:name "The Herbal of Crateuas" ;
    dc:description "Crateuas's catalog of herbs and their powers, written in ancient Greek; a summa for several Abilities and rumored source of Insight into the Root-Cutter Virtue." ;
    skos:altLabel "Crateuas's herbal" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheHorsemen a rpg:Creature ;
    rpg:name "The Horsemen" ;
    dc:description "Ghostly faerie riders of the Wild Hunt (Faerie Might 20) embodying icy winter storms, who can spread fear, control winds, and inflict cold; they can produce spells like Broom of the Winds." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:TheHounds a rpg:Creature ;
    rpg:name "The Hounds" ;
    dc:description "Immense insubstantial grey dogs of the Wild Hunt (Faerie Might 10) whose howls are arctic winds and whose bites inflict an effect similar to Talons of the Winds." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:TheIncoherenceOfTheIncoherence a rpg:Item ;
    rpg:name "The Incoherence of the Incoherence" ;
    dc:description "A book by Averroes refuting al-Ghazali's The Incoherence of the Philosophers." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheIncoherenceOfThePhilosophers a rpg:Item ;
    rpg:name "The Incoherence of the Philosophers" ;
    dc:description "A book by al-Ghazali rejecting the ideas of Aristotle, Plato, and Socrates as harmful to the faithful." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheIncubusSTrick a rpg:Spell ;
    rpg:name "The Incubus's Trick" ;
    dc:description "A spell that turns a male caster into a woman, the counterpart of The Succubus's Trick." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheInexorableHunter a rpg:Item ;
    rpg:name "The Inexorable Hunter" ;
    dc:description "A magical power of the Virtuous Hound (Animal, 2 points) allowing it to flawlessly follow a creature's scent until it is located, despite the prey's ruses." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheInvisibleGlassWorker a rpg:Spell ;
    rpg:name "The Invisible Glass-worker" ;
    dc:description "A ReTe 4 spell (Touch, Momentary, Individual) that transforms a piece of glass into a finished form as if shaped by a glassworker." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheKeepersOfThePearlOfGreatPrice a rpg:Faction ;
    rpg:name "The Keepers of the Pearl of Great Price" ;
    dc:description "A Jerbiton league whose members surreptitiously stave off poverty in large cities; leaderless since crusaders sacked their Constantinople headquarters." ;
    skos:altLabel "The Keepers" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:TheKeepersOfTheThousandTales a rpg:Faction ;
    rpg:name "The Keepers of the Thousand Tales" ;
    dc:description "A group of Merinita magi and companions formed in the Holy Land to collect, catalog, and spread the greatest stories, believing faerie immortality is ensured through legend; they have covenants in the Levant and Iberian Tribunals." ;
    skos:altLabel "the Keepers" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:TheKeyOfTheodorus a rpg:Spell ;
    rpg:name "The Key of Theodorus" ;
    dc:description "A ReTe 5 Hermetic spell (R: Touch, D: Mom, T: Part) that magically opens any single lock regardless of complexity, named for Theodorus of Samos." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheKingSGoblet a rpg:Item ;
    rpg:name "The King's Goblet" ;
    dc:description "A wondrous gold cup that trembles in the holder's hand if a poisoned beverage is poured into it (Craft Level 13)." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheKissOfDeath a rpg:Spell ;
    rpg:name "The Kiss of Death" ;
    dc:description "A Perdo Corpus spell (Level 45) by which the person kissed dies suddenly, leaving only the black imprint of the caster's lips; requires no spoken words." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheKonigstuhl a schema:Place ;
    rpg:name "The Konigstuhl" ;
    dc:description "A 380-foot chalk cliff on Rugen; legend says whoever climbs it from the sea becomes king of Rugen, as Valdemar I did, and cheaters fail." ;
    skos:altLabel "Königstuhl", "The King's Seat" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheLaboratoryOfBonisagus a rpg:Spell ;
    rpg:name "The Laboratory of Bonisagus" ;
    dc:description "A Creo Terram 45 ritual that furnishes an empty chamber with a fully equipped standard Hermetic laboratory better than normal, granting Flawless Equipment, Flawless Tools, and Spotless." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheLensOfWisdom a rpg:Item ;
    rpg:name "The Lens of Wisdom" ;
    dc:description "A crystal lens bound in brass that, focusing the summer-solstice noon sun on a blank parchment, burns indecipherable glyphs into the page, each page containing Intellego vis." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheLightningBringer a rpg:Item ;
    rpg:name "The Lightning-Bringer" ;
    dc:description "A highly magical device of copper spheres, gold rods, and enchanted glass vessels invented by a Tremere Archimagus; on each new moon it summons a thunderstorm and accumulates its lightning as Auram vis." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheLimitOfAging a rpg:Tag ;
    skos:prefLabel "The Limit of Aging" ;
    dc:description "A lesser limit of Hermetic magic: it cannot halt or reverse natural aging or remove Decrepitude, only slow it." ;
    rpg:hasTag amol:HermeticConcept .
amol:TheLimitOfCreation a rpg:Tag ;
    skos:prefLabel "The Limit of Creation" ;
    dc:description "A lesser limit of Hermetic magic: it cannot create anything permanently without raw vis." ;
    rpg:hasTag amol:HermeticConcept .
amol:TheLimitOfEnergy a rpg:Tag ;
    skos:prefLabel "The Limit of Energy" ;
    dc:description "A lesser limit of Hermetic magic: it cannot restore physical energy (Fatigue levels) or Confidence." ;
    rpg:hasTag amol:HermeticConcept .
amol:TheLimitOfExperience a rpg:Tag ;
    skos:prefLabel "The Limit of Experience" ;
    dc:description "A lesser limit of Hermetic magic: it cannot create or transfer skills, knowledge, or Abilities in a person." ;
    rpg:hasTag amol:HermeticConcept .
amol:TheLimitOfMagicResistance a rpg:Tag ;
    skos:prefLabel "The Limit of Magic Resistance" ;
    dc:description "A limit noting that non-Hermetic magic (and Faerie powers) cannot grant general Magic Resistance, though Hermetic magic can." ;
    rpg:hasTag amol:HermeticConcept .
amol:TheLimitOfTime a rpg:Tag ;
    skos:prefLabel "The Limit of Time" ;
    dc:description "A lesser limit of Hermetic magic: it cannot alter the passage of time, affect the past, or scry on past or future." ;
    rpg:hasTag amol:HermeticConcept .
amol:TheLimitOfVis a rpg:Tag ;
    skos:prefLabel "The Limit of Vis" ;
    dc:description "A lesser limit of Hermetic magic: it cannot change the Art to which raw vis is attuned." ;
    rpg:hasTag amol:HermeticConcept .
amol:TheLimitOfWarping a rpg:Tag ;
    skos:prefLabel "The Limit of Warping" ;
    dc:description "A lesser limit of Hermetic magic: it cannot affect warping changes once they have happened; Wizard's Twilight is one manifestation." ;
    rpg:hasTag amol:HermeticConcept .
amol:TheLimitOfTheInfernal a rpg:Tag ;
    skos:prefLabel "The Limit of the Infernal" ;
    dc:description "A lesser limit of Hermetic magic: Intellego magic is almost useless against the Infernal, revealing only what demons want believed." ;
    rpg:hasTag amol:HermeticConcept .
amol:TheLimitOfTheSoul a rpg:Tag ;
    skos:prefLabel "The Limit of the Soul" ;
    dc:description "A lesser limit of Hermetic magic: it cannot create an immortal soul, true human life, or restore the dead to life." ;
    rpg:hasTag amol:HermeticConcept .
amol:TheLindenOfNeustadt a rpg:Creature ;
    rpg:name "The Linden of Neustadt" ;
    dc:description "A protective Forest spirit (Magic Might 30) manifesting as a great lime tree that has adopted the town of Neustadt as its realm and grants victory and virtues to the town's defenders." ;
    skos:altLabel "Linden", "the great Lime" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:TheLineOfQuendalon a rpg:Faction ;
    rpg:name "The Line of Quendalon" ;
    dc:description "The lineage of magi descended from Quendalon who Initiate the three Arcadian Mysteries; many are Seekers devoted to experimental research, sometimes called 'The Last Commission' for Bonisagus's reputed charge." ;
    skos:altLabel "The Last Commission" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:TheLongManOfWilmington a schema:Place ;
    rpg:name "The Long Man of Wilmington" ;
    dc:description "A figure about 240 feet tall picked out by trenches on a Sussex hillside, grasping two staves; said variously to represent St. Paul or the keeper of the gates of dawn who may open them for travelers." ;
    skos:altLabel "The Long Man" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheLuneburgHeath a schema:Place ;
    rpg:name "The Luneburg Heath" ;
    dc:description "A wild heathland south of Luneburg where shepherds tend flocks of Heidschnucken, goat-sheep crossbreeds descended from Corsican mouflon." ;
    skos:altLabel "Lüneburg Heath" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheMagestonesOfVerditius a rpg:Item ;
    rpg:name "The Magestones of Verditius" ;
    dc:description "Onyx-pebble enchanted devices crafted by Verditius, each bearing a powerful Creo Vim effect that manifests a Magic aura of 3; three were secretly gifted to Oculus Septentrionalis, the rest guarded by Durenmar, and their technique was never replicated." ;
    skos:altLabel "magestones" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheMagicFountain a schema:Place ;
    rpg:name "The Magic Fountain" ;
    dc:description "A spring near the Brocken that grants visions to those who drink from it." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheManyHuedConflagration a rpg:Spell ;
    rpg:name "The Many-hued Conflagration" ;
    dc:description "A Muto Ignem spell (Level 5) that makes a fire burn brightly in shifting colors, potentially blinding onlookers for a round if they fail a Stamina roll." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheMargravateOfLusatia a schema:Place ;
    rpg:name "The Margravate of Lusatia" ;
    dc:description "A mainly forest-wilderness margravate east of the Elbe bordering Silesia, populated by Sorbs and ruled by the margraves of Meissen." ;
    skos:altLabel "Lusatia", "Luzica" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheMarvelousHound a rpg:Item ;
    rpg:name "The Marvelous Hound" ;
    dc:description "A Muto Animal (Corpus, Mentem) 34 enchanted collar that transforms a normal hound into an erect, handed servant with a grog's intellect while retaining hound loyalty." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheMasterOfNaumburg a rpg:Character ;
    rpg:name "The Master of Naumburg" ;
    dc:description "A young, enigmatic architect and sculptor of German origin who travels Germany working on great churches; some claim his unmatched work is aided by sorcery." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:TheMazeOfSingingMirrors a schema:Place ;
    rpg:name "The Maze of Singing Mirrors" ;
    dc:description "A repository where copies of all recordings made by the Daughters of Echo are kept and sold to Jerbiton magi unable to attend performances." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheMiniatureOfImmortality a rpg:Spell ;
    rpg:name "The Miniature of Immortality" ;
    dc:description "A ritual Creo Herbam spell (Level 20) that creates a painted miniature of a person or scene on a wooden panel within voice range." ;
    skos:altLabel "CrHe(An)(Te) Level 20" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheMotivatedPlow a rpg:Item ;
    rpg:name "The Motivated Plow" ;
    dc:description "A Rego Terram 15 enchanted plow-shaped device that transforms hard-packed earth into well-plowed soil in a circle; based on The Forgiving Earth and doing the work of about three laborers." ;
    skos:altLabel "Motivated Plough" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheMundane a rpg:Tag ;
    skos:prefLabel "The Mundane" ;
    dc:description "That which is not supernatural; areas not occupied by another realm, having no aura rating, consisting of ordinary people and places." ;
    skos:altLabel "the mundane realm" ;
    rpg:hasTag amol:Realm .
amol:TheMysticalCarpenter a rpg:Spell ;
    rpg:name "The Mystical Carpenter" ;
    dc:description "A ReHe 25 spell (Touch, Momentary, Group) that cuts, splits, carves, and joins a pile of wood into a desired form, substituting Perception + Finesse for Craft: Carpenter." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheNewIconophiles a rpg:Faction ;
    rpg:name "The New Iconophiles" ;
    dc:description "A Jerbiton league, led ideologically by the Primus, attempting to recover the artistic treasures of Constantinople; based in Valnastium." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:TheObedientFire a rpg:Spell ;
    rpg:name "The Obedient Fire" ;
    dc:description "A ReIg 20 spell that controls the rate and direction a fire spreads, able to make it move as fast as a man walks; the fire's heat is non-magical and bypasses Magic Resistance." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheOdenwald a schema:Place ;
    rpg:name "The Odenwald" ;
    dc:description "A German forest that comes into bloom earliest and most spectacularly, an ideal site for the Court of the Alder Prince, with bandits lurking on its western edge." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheOldOnes a rpg:Creature ;
    rpg:name "The Old Ones" ;
    dc:description "Powerful magical creatures who died or fell asleep millennia ago; finding the resting place of one of them is listed as a possible object of a quest." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:TheOreMountains a schema:Place ;
    rpg:name "The Ore Mountains" ;
    dc:description "A bleak, unsettled range covered with evergreen forest adjoining the Spruce Mountains in Franconia, where silver and tin have recently been discovered, giving rise to mining towns like Freiberg." ;
    skos:altLabel "Erzgebirge" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:ThePathOfBeacons a rpg:Tag ;
    skos:prefLabel "The Path of Beacons" ;
    dc:description "A Criamon path lacking a clutch that teaches Mysteries allowing each magus to create a sanctuary from the strife of the world; its eldest magus lives in a regio on the Isle of Arran." ;
    rpg:hasTag amol:HermeticConcept .
amol:ThePathOfOrpheus a rpg:Spell ;
    rpg:name "The Path of Orpheus" ;
    dc:description "A rumored great ritual following Orpheus's trek into the Underworld to restore a beloved to the living world, requiring vast vis and Wizard's Communion." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ThePathOfStrife a rpg:Tag ;
    skos:prefLabel "The Path of Strife" ;
    dc:description "The Criamon path of worldly magic that transgresses House morality; its servants kill, lie, and destroy demons to prolong the universe, and they cannot enter Final Twilight." ;
    rpg:hasTag amol:HermeticConcept .
amol:ThePathOfWalkingBackwards a rpg:Tag ;
    skos:prefLabel "The Path of Walking Backwards" ;
    dc:description "A newer Criamon path brought by Abdkypris from the Sufi, involving complete surrender to the harmonic force to flee back to the Spharios; uses dancing/spinning meditation." ;
    skos:altLabel "Path of Walking Backward" ;
    rpg:hasTag amol:HermeticConcept .
amol:ThePathOfTheMirror a rpg:Tag ;
    skos:prefLabel "The Path of the Mirror" ;
    dc:description "The Criamon path followed only by living Primi under instruction of their predecessors, a series of Initiations for those who choose to serve the worldly House." ;
    rpg:hasTag amol:HermeticConcept .
amol:ThePhantomBlacksmith a rpg:Spell ;
    rpg:name "The Phantom Blacksmith" ;
    dc:description "A ReTe 20 spell (Touch, Momentary, Group) that transforms ready iron into a crafted result as if worked by a blacksmith to the magus's instructions." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ThePhantomGift a rpg:Spell ;
    rpg:name "The Phantom Gift" ;
    dc:description "A Creo Vim spell that makes the target appear tainted with magic as most magi are, causing beasts and people to react to him as a magus." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ThePipers a schema:Place ;
    rpg:name "The Pipers" ;
    dc:description "Two immense standing stones near the Merry Maidens, said to be demons sent to tempt the dancing girls who were unable to flee divine justice and turned to stone." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:ThePiratesGraveyards a schema:Place ;
    rpg:name "The Pirates' Graveyards" ;
    dc:description "A haunted region in Drenthe near the River Ems where pirates of Friesia bury their dead under standing stones; Lucas von Beck harvests vis and bodies there for necromancy, though its power may not be magical." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:ThePlacesIVeBeenYouWouldnTBelieveMe a rpg:Item ;
    rpg:name "The Places I've Been - You Wouldn't Believe Me" ;
    dc:description "A book describing a Greek Isles covenant whose soldiers ride gigantic terrapins into naval battle." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:ThePlunderOfTwentyGeese a rpg:Spell ;
    rpg:name "The Plunder of Twenty Geese" ;
    dc:description "A Muto Animal 15 spell that transforms up to 100 feathers into goose wing feathers preferred for pens; a Rego variant at level 20 strips and tempers the pens." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ThePoetSBust a rpg:Spell ;
    rpg:name "The Poet's Bust" ;
    dc:description "A Rego Terram spell (Level 5) that changes a block of stone into a carved bust of a person the caster touches." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ThePonderersOfWeightAndDistance a rpg:Faction ;
    rpg:name "The Ponderers of Weight and Distance" ;
    dc:description "A Jerbiton league of merchant magi interested in gaining money through mundane trade and manipulating economies, seemingly based in the Rhineland." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:ThePrivateSpeechOfErosAndPsyche a rpg:Spell ;
    rpg:name "The Private Speech of Eros and Psyche" ;
    dc:description "An In(Cr)Me 60 ritual Orphic spell allowing the magos and a target to speak mentally at will, regardless of distance, for one year." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheProdigiousPlantPot a rpg:Item ;
    rpg:name "The Prodigious Plant Pot" ;
    dc:description "A large clay pot enchanted (CrHe 30) that grows a seed into a mature plant in a day, adding to a lab's Experimentation and Herbam Specializations; made by Ricardus Caespuus." ;
    skos:altLabel "the Plant Pot" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheRemoteEntrancePortal a rpg:Item ;
    rpg:name "The Remote Entrance Portal" ;
    dc:description "A Rego Corpus 50 enchanted device acting as a magical transporter activated only from within a covenant, moving seen targets up to 500 paces inside without arcane connections." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheResoluteMindOfTheTirelessResearcher a rpg:Spell ;
    rpg:name "The Resolute Mind of the Tireless Researcher" ;
    dc:description "A Rego Mentem Level 20 spell devised by Andreas of House Bonisagus that fixes a magus's mind on lab work for a day; daily use warps the mind and requires the Addled lab routine." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheRhinefalls a schema:Place ;
    rpg:name "The Rhinefalls" ;
    dc:description "The greatest waterfalls in Europe near the southeastern edge of the Black Forest, with a central rocky island holding a Magic aura and a regio leading to the Rhine spirit's realm." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheRichesThatAreRightfullyMineD a rpg:Spell ;
    rpg:name "The Riches That are Rightfully Mine(d)" ;
    dc:description "A CrTe 35 ritual spell (Touch, Momentary, Individual) that fills a chest with up to ten cubic feet of silver pennies, worth about 2000 Mythic Pounds; a copy resides in the Great Library of Durenmar." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheRiesenstein a schema:Place ;
    rpg:name "The Riesenstein" ;
    dc:description "A great stone near Zuschen hurled by the Devil at the village of Neueburg; it bears three red stains that weep bloody tears worth Ignem vis every All Hallow's Eve." ;
    skos:altLabel "Giant's Stone" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheRoosterSCrow a rpg:Spell ;
    rpg:name "The Rooster's Crow" ;
    dc:description "A PeVi Sound-Target spell that strips Might from demons who hear the caster's shout if it penetrates their Magic Resistance." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheRosstrappe a schema:Place ;
    rpg:name "The Rosstrappe" ;
    dc:description "A rock across a ravine from the Hexentanzplatz bearing a giant horse's hoofprint, from the legendary leap of Princess Brunhilde fleeing the knight Bodo." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheRottweiler a rpg:Creature ;
    rpg:name "The Rottweiler" ;
    dc:description "A characteristic black-and-tan dog breed of the Black Forest, bred from Roman dogs and wild dark faerie species; some have faerie blood granting longevity and Second Sight, and at least one Rhine magus uses them instead of grogs." ;
    skos:altLabel "Metzgerhund", "Rottweilers" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:TheRumaquelle a schema:Place ;
    rpg:name "The Rumaquelle" ;
    dc:description "A magical green-watered spring in the southern Harz, said to be where Ruma, daughter of the dwarf king, surfaced as a stream to reunite with the giant Romer." ;
    skos:altLabel "Ruma's spring" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheSalernitarianWomen a rpg:Faction ;
    rpg:name "The Salernitarian Women" ;
    dc:description "A famous group of women at Salerno studying medicine, renowned as obstetricians and surgeons, legendarily credited with curing the Duke of Normandy." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:TheSanctuaryOfHercules a schema:Place ;
    rpg:name "The Sanctuary of Hercules" ;
    dc:description "A hidden cave of magical springs on the western Vosges, with a Magic aura of 3, where the Gauls worshiped Ogmios and the Romans Hercules, ringed with ancient altars." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheSchwanenburg a schema:Place ;
    rpg:name "The Schwanenburg" ;
    dc:description "An old castle on a hill overlooking Cleves by the Rhine, named after the Knight of the Swan, Lohengrin." ;
    skos:altLabel "Swan Castle" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheScribeSTouch a rpg:Spell ;
    rpg:name "The Scribe's Touch" ;
    dc:description "A Perdo Animal 3 spell that trims the magus's quill with the flick of a finger." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheSeveredLimbMadeWhole a rpg:Spell ;
    rpg:name "The Severed Limb Made Whole" ;
    dc:description "A Creo Corpus ritual (Level 25) that reattaches a detached limb, though decay on the severed limb persists after reattachment." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheShadowOfHumanLife a rpg:Spell ;
    rpg:name "The Shadow of Human Life" ;
    dc:description "A Creo Imaginem spell (Level 40) with a Mentem requisite that gives a human image (as in Phantasm of the Human Form) limited freedom and simulated intellect, functioning as a stupid independent human." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheShadowOfLifeRenewed a rpg:Spell ;
    rpg:name "The Shadow of Life Renewed" ;
    dc:description "A Creo Corpus ritual (Level 75) with a Mentem requisite that brings the semblance of life to a corpse; the closest the Order of Hermes has come to raising the dead." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheShadowMasters a rpg:Faction ;
    rpg:name "The Shadow-Masters" ;
    dc:description "A troupe of Merinita magi who, using Plato's cave allegory, fashion illusory figures and stories to reinforce belief in the imaginary; they host the Great Play and Initiate Glamour, Animae Magic, and Perpetuity." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:TheSilentVigil a rpg:Spell ;
    rpg:name "The Silent Vigil" ;
    dc:description "A Muto Corpus spell (Level 45) with a Terram requisite that lets the caster move into and become part of a rock formation at least twice their size." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheSingersInHollowRooms a rpg:Faction ;
    rpg:name "The Singers in Hollow Rooms" ;
    dc:description "An example Jerbiton league that calls up the ghosts of ancient artists; its homages involve constructing or searching for tombs." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:TheSingleOcean a rpg:Faction ;
    rpg:name "The Single Ocean" ;
    dc:description "A Jerbiton league exploring the cities of the Levant and North Africa, seeking peaceful relationships with Jewish and Muslim sorcerers, led by Edward the White." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:TheSorcererSFork a rpg:Spell ;
    rpg:name "The Sorcerer's Fork" ;
    dc:description "A Muto Vim spell that splits another spell into two or more identical spells of reduced power against separate targets." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheSourceOfTheDanube a schema:Place ;
    rpg:name "The Source of the Danube" ;
    dc:description "An enchanted spring in the eastern Black Forest, source of the River Danube, with a Faerie aura and a regio whose top level holds a gateway into Arcadia and abundant Aquam vis; presided over by the faerie Danu." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheSpellOfWroughtIron a rpg:Spell ;
    rpg:name "The Spell of Wrought Iron" ;
    dc:description "A ReTe 15 spell (Touch, Momentary, Group) that transforms raw pig-iron into plain bars of wrought iron, separating out the slag." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheSphinx a schema:Place ;
    rpg:name "The Sphinx" ;
    dc:description "A legendary monument near the Pyramids in Egypt studied by magi who erected an open-desert laboratory beside it." ;
    skos:altLabel "the great Sphinx" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheSpider a rpg:Creature ;
    rpg:name "The Spider" ;
    dc:description "A character from The Travels of Fedoso who may assist player characters in a faerie wood; possibly a spirit or faerie said to have predicted the depredations of an evil magus." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:TheStoneOfDeath a rpg:Item ;
    rpg:name "The Stone of Death" ;
    dc:description "An ancient stone aligned to the winter-solstice sunset; during the third decan of Gemini, daily animal sacrifices made at the rising of Saturn cause Perdo vis to form from the blood." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheStultifiedPeasant a rpg:Spell ;
    rpg:name "The Stultified Peasant" ;
    dc:description "A Perdo Mentem spell that destroys a target's imagination, removing his ability to think and leaving him standing mouth open." ;
    skos:altLabel "PeMe 30" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheSubtleChain a rpg:Item ;
    rpg:name "The Subtle Chain" ;
    dc:description "Philippus Niger's enchanted silver chain that forms a 3-pace circle and creates a variety of once-per-day warding effects against demons, spirits, beasts, and faeries." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheSuccubusSTrick a rpg:Spell ;
    rpg:name "The Succubus's Trick" ;
    dc:description "A MuCo 5 spell that causes a female caster to adopt male physical characteristics; named after gender-changing demons of lust." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheSwabianJura a schema:Place ;
    rpg:name "The Swabian Jura" ;
    dc:description "A series of harsh limestone hills separating the Danube and Neckar valleys, dotted with stalactite grottos such as the Nebelhöhle and Wimsener Höhle." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheTeufelskuche a schema:Place ;
    rpg:name "The Teufelskuche" ;
    dc:description "A forgotten stone circle and altar in the Haldensleben Forest near Magdeburg where the pagan god Woden was worshipped; it is the origin of the Wild Hunt." ;
    skos:altLabel "Devil's Kitchen", "Teufelsküche" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheTeufelsmoor a schema:Place ;
    rpg:name "The Teufelsmoor" ;
    dc:description "An extensive swampy peat wasteland northeast of Bremen with an ill reputation, almost always mist-covered and shunned by locals; a possible covenant location." ;
    skos:altLabel "Devil's Bog" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheThreeFaerieCords a rpg:Tag ;
    skos:prefLabel "The Three Faerie Cords" ;
    dc:description "Three additional negative cords (leaden, iron, tin) discovered by Farrago Bonisagi that permanently bind a faerie familiar by hindering the maga's mind, body, and spirit to offset cord decay." ;
    skos:altLabel "iron cord", "leaden cord", "tin cord" ;
    rpg:hasTag amol:HermeticConcept .
amol:TheThuringianForest a schema:Place ;
    rpg:name "The Thuringian Forest" ;
    dc:description "One of Germany's largest forests, covering nearly a hundred miles of the Thuringia-Franconia border, the traditional boundary between northern and southern Germany." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheTirelessServant a rpg:Item ;
    rpg:name "The Tireless Servant" ;
    dc:description "An animated skeleton automaton (ReCo 25/40) that fetches and holds objects on verbal command, adding to a lab's General Quality and Safety." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheTwiceGiftedCoin a rpg:Spell ;
    rpg:name "The Twice-Gifted Coin" ;
    dc:description "A PeMe 15 spell (Touch, Momentary, Individual) that erases the target's memory of having paid a coin, so he pays again; sometimes enchanted into a toll-gate." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheUnbiddenTask a rpg:Spell ;
    rpg:name "The Unbidden Task" ;
    dc:description "A MuMe 25 spell that creates a recurring prospective memory in a target, prompting them to infer and act on a reason for it." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheUnnamedCabal a rpg:Faction ;
    rpg:name "The Unnamed Cabal" ;
    dc:description "A House Tytalus cabal, symbolized by a counterclockwise swirl of five lines, whose goal is to keep the other cabals in conflict; supposedly composed of the most powerful Tytalus Archmagi." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:TheVenusberg a schema:Place ;
    rpg:name "The Venusberg" ;
    dc:description "A splendid subterranean home of the goddess Venus beneath a mountain in an unknown spot in Germany, discovered by the knight Tannhäuser." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheVerminousInfestation a rpg:Spell ;
    rpg:name "The Verminous Infestation" ;
    dc:description "A Rego Animal spell (Req: Perdo, Corpus) that infests a target with fleshworms in his intestines, inflicting the Worms disease immediately." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheVirtuousHound a rpg:Creature ;
    rpg:name "The Virtuous Hound" ;
    dc:description "A magical beast with Magic Might 10 (Animal), an intelligent bloodhound recruited as covenfolk who can flawlessly track prey and speak; based on the bloodhound from The Book of Mundane Beasts." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:TheVitalizerOfProvisions a rpg:Item ;
    rpg:name "The Vitalizer of Provisions" ;
    dc:description "A Creo Animal (Herbam) 19 enchanted chest that preserves food placed within it, preventing decay while the door remains closed." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheViticulturalists a rpg:Faction ;
    rpg:name "The Viticulturalists" ;
    dc:description "A Jerbiton league that believes peasant life has virtue and engages in magically assisted manorial agriculture, led by Sabina of the Seine." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:TheVoiceOfTheBjornaerMagus a rpg:Spell ;
    rpg:name "The Voice of the Bjornaer Magus" ;
    dc:description "A Muto Animal 15 spell allowing a Bjornaer caster in animal form to speak with a human voice, cast without words or gestures." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheVosgesMountains a schema:Place ;
    rpg:name "The Vosges Mountains" ;
    dc:description "A mountain range bounding Upper Lorraine to the east, once dominated by a secretive fir spirit that was extinguished by the planting of the holy staff at Thann." ;
    skos:altLabel "Vosges", "Vosges forest" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheWartburg a schema:Place ;
    rpg:name "The Wartburg" ;
    dc:description "A great unbreached castle near Eisenach, ancestral home of the landgraves of Thuringia and famed center of literature and music hosting the Sangerkrieg." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheWayfarers a rpg:Faction ;
    rpg:name "The Wayfarers" ;
    dc:description "A group of Merinitae who style themselves Arcadian experts, recording earthly gateway locations and guiding travelers into Faerie; they typically Initiate Arcadian Travel and rival House Mercere's Redcaps." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:TheWeightlessTransportationOfBooks a rpg:Spell ;
    rpg:name "The Weightless Transportation of Books" ;
    dc:description "A Perdo Animal 25 spell that makes the books within a chest almost weightless, easing transport or reducing a library's load on covenant floors." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheWelcomeAdditionOfFalseSunlight a rpg:Spell ;
    rpg:name "The Welcome Addition of False Sunlight" ;
    dc:description "A Creo Ignem 15 spell creating a steady, cool, smokeless, non-flickering light; often enchanted into library devices that float, embed in ceilings, or overlook desks." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TheWhiteHorseOfUffington a rpg:Creature ;
    rpg:name "The White Horse of Uffington" ;
    dc:description "A horse figure carved into a Berkshire hillside that can rise and move about the country or Arcadia as a white horse of surpassing beauty, uncontrollable by mortals." ;
    skos:altLabel "The White Horse", "White Horse" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:TheWildHuntsman a rpg:Creature ;
    rpg:name "The Wild Huntsman" ;
    dc:description "A grim Unseelie faerie lord (Faerie Might 50) on an immense black horse, focus of every Wild Hunt, perhaps once a fragment of Woden, who seeks to maintain winter's hold on the land." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:TheWindingPath a rpg:Tag ;
    skos:prefLabel "The Winding Path" ;
    dc:description "The 'path' of Criamon magi who do not consciously develop themselves spiritually; the widest path of directionlessness, first followed by Juliasta." ;
    rpg:hasTag amol:HermeticConcept .
amol:TheWizardSBridle a rpg:Item ;
    rpg:name "The Wizard's Bridle" ;
    dc:description "Philippus Niger's feared magical item, a head frame and shackles that trap a victim's tongue and limbs to prevent casting, enchanted with Bind The Gift and Hinder the Gift; used once to restrain a Marched Tytalus magus." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TheZiegensteine a schema:Place ;
    rpg:name "The Ziegensteine" ;
    dc:description "A megalithic barrow of stone slabs under a giant oak near Monchgut on Rugen, used as a cemetery by the volkhvy; secretly a faerie-trod gateway through Arcadia to the Novgorod covenant Pripet Major." ;
    skos:altLabel "The Goats' Stones" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheNamelessGoblin a rpg:Creature ;
    rpg:name "The nameless goblin" ;
    dc:description "A goblin noble who rebelled against the goblin king and was stripped of his name and transformed into a stalactite; the stalagmite he grows beneath himself yields Terram vis when ground to powder." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:ThebanLeague a rpg:Faction ;
    rpg:name "Theban League" ;
    dc:description "A military alliance formed by magi in the north of the Empire to resist the emperor, the Infernal, and House Tremere; they joined the Order under Jerbiton's nominal leadership and later founded the Tribunal of Thebes." ;
    skos:altLabel "the Thebans" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:ThebanLegion a rpg:Faction ;
    rpg:name "Theban Legion" ;
    dc:description "A legion of early Christians, including St. Victor, said by legend to have died at the Roman colony that became Xanten." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:ThebanTribunalMagusLucian a rpg:Character ;
    rpg:name "Theban Tribunal magus Lucian" ;
    dc:description "Duplicate placeholder removed." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Thelxiope a rpg:Character ;
    rpg:name "Thelxiope" ;
    dc:description "The founder of the Seirenes, a Greek woman saved by the sirens and taught their magic, who then traveled Europe rescuing and training Gifted girls." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Theobald a rpg:Character ;
    rpg:name "Theobald" ;
    dc:description "A bishop of Gubbio in Umbria whose episcopal ring and thumb, carried by his loyal servant, miraculously rooted a staff into the ground in the Vosges, leading to the founding of Thann Chapel." ;
    skos:altLabel "Theobald, bishop of Gubbio" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Theocracy a rpg:Tag ;
    skos:prefLabel "Theocracy" ;
    dc:description "A covenant governance form in which the magi rule as priests through lesser priests, as in the Worshipful covenant." ;
    skos:altLabel "Theocratic" ;
    rpg:hasTag amol:HermeticConcept .
amol:TheodoreLascaris a rpg:Character ;
    rpg:name "Theodore Lascaris" ;
    dc:description "The Byzantine Emperor living in exile in Nicea, whose agent seeks the magi's help to contact the goddess Hecate and expel the Latin usurpers from Constantinople." ;
    skos:altLabel "Byzantine Emperor" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:TheodorusOfSamos a rpg:Character ;
    rpg:name "Theodorus of Samos" ;
    dc:description "The sixth-century Greek inventor credited with creating the first locks in Mythic Europe; namesake of the spell The Key of Theodorus." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Theophilus a rpg:Character ;
    rpg:name "Theophilus" ;
    dc:description "The monk credited as author of the craft manual On Divers Arts." ;
    skos:altLabel "Theophius" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:TheopholusOfHouseJerbiton a rpg:Character ;
    rpg:name "Theopholus of House Jerbiton" ;
    dc:description "A magus of House Jerbiton with the Gentle Gift who covertly teaches Magic Theory to university students to find naturally inclined Gifted individuals and recruit covenant members." ;
    skos:altLabel "Theopholus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Thera a schema:Place ;
    rpg:name "Thera" ;
    dc:description "A volcanic island, site of Akrotiri, whose ancient people discovered many magical and technological secrets; now infested with vampires." ;
    skos:altLabel "Santorini" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TheriacCureAll a rpg:Item ;
    rpg:name "Theriac (cure-all)" ;
    dc:description "A wonderful cure-all for any ailment sold by traveling empirici, often claimed to be from a secret family recipe; real theriacs exist but most sold are pondwater and grass." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:Theriomorphy a rpg:Tag ;
    skos:prefLabel "Theriomorphy" ;
    dc:description "A Minor House Mystery of Bjornaer allowing a magus to apply a Quality or Virtue of his Heartbeast to his human form via partial physical change." ;
    skos:altLabel "Mystery of Theriomorphy" ;
    rpg:hasTag amol:Virtue .
amol:Thetis a rpg:Character ;
    rpg:name "Thetis" ;
    dc:description "A sea nymph who, with Eurynome, rescued and raised the cast-out Hephaestus and built him an underwater forge." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:TheurgicSpiritFamiliar a rpg:Tag ;
    skos:prefLabel "Theurgic Spirit Familiar" ;
    dc:description "A Mystery Virtue the Titanoi cult can Initiate." ;
    rpg:hasTag amol:Virtue .
amol:ThiefOfEmotions a rpg:Tag ;
    skos:prefLabel "Thief of Emotions" ;
    dc:description "A new Major Supernatural Virtue granting the Emotion Theft Supernatural Ability to remove an emotion from one person and transfer it to another; the second Fruit of the Arcadian Path." ;
    rpg:hasTag amol:Virtue .
amol:ThiefSSlippers a rpg:Item ;
    rpg:name "Thief's Slippers" ;
    dc:description "Wondrous shoes that let the wearer move without making a sound (Craft Level 15)." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:ThierryOfChartres a rpg:Character ;
    rpg:name "Thierry of Chartres" ;
    dc:description "A scholar who taught at the cathedral school of Chartres." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Thoroughfare a rpg:Tag ;
    skos:prefLabel "Thoroughfare" ;
    dc:description "A Minor laboratory Supernatural Flaw: supernatural creatures such as gnomes pass through the lab and cause minor nuisance (-1 Safety)." ;
    rpg:hasTag amol:Flaw .
amol:ThoughtsDistinctlyBurned a rpg:Spell ;
    rpg:name "Thoughts Distinctly Burned" ;
    dc:description "A Rego Aquam 15 spell that controls ink so it forms patterns on pages corresponding to the magus's spoken words." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ThoughtsWithinBabble a rpg:Spell ;
    rpg:name "Thoughts within Babble" ;
    dc:description "An Intellego Mentem spell (Level 25) that lets the caster understand the speech of those within the target area, including misused language." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:ThroughTheAegis a rpg:Item ;
    rpg:name "Through the Aegis" ;
    dc:description "An Ars Magica supplement containing five fully developed covenants, one for each season plus one that returned from Winter to Spring." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:Thunor a rpg:Character ;
    rpg:name "Thunor" ;
    dc:description "An old Germanic thunder god worshiped by the German tribes." ;
    skos:altLabel "Thunrs" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Thuringia a schema:Place ;
    rpg:name "Thuringia" ;
    dc:description "A landlocked upland region of the Rhine Tribunal bounded by the Kyffhauser Mountains and the Thuringian Forest, quaint rather than bustling." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TieTheThreadsThatBind a rpg:Spell ;
    rpg:name "Tie the Threads That Bind" ;
    dc:description "A general-level Rego Vim ritual formulaic spell used uniquely to unite an automaton's magic into a cohesive unit, requiring a level equal to the construct's Magic Might + 15." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TillitusOfHouseBonisagus a rpg:Character ;
    rpg:name "Tillitus of House Bonisagus" ;
    dc:description "A magus of House Bonisagus of the covenant Semita Errabunda who invents Rego Vim warding spells against magical creatures in a spell-invention example." ;
    skos:altLabel "Tillitus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:TinctureOfParsley a rpg:Item ;
    rpg:name "Tincture of Parsley" ;
    dc:description "A Theriac of Level 10, Potency Strong, a herbal infusion that acts as an antidote to any serpent bite when consumed immediately after the bite." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:Tinderdry a rpg:Item ;
    rpg:name "Tinderdry" ;
    dc:description "A Level 5 alchemical Reagent, a wool-like substance that when rubbed over damp wood dries it enough to be lit with flint and steel." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:Titania a rpg:Character ;
    rpg:name "Titania" ;
    dc:description "A faerie queen who gifted the King of England a hippogriff that fell ill from London's strong Divine aura." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:TitanoiCultLore a rpg:Proficiency ;
    rpg:name "Titanoi Cult Lore" ;
    dc:description "A cult lore Ability taught to magi raised in the Titanoi Mystery Cult of House Tytalus." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:Tius a rpg:Character ;
    rpg:name "Tius" ;
    dc:description "The battle god of the Germans, worshiped by Hermann and the Cheruski, whose priests' magic aided the tribes at the Teutoburger Forest." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Tobias a rpg:Character ;
    rpg:name "Tobias" ;
    dc:description "An example swineherd whose body Antigone inhabits during a psychodramatic Quest on the Avenue of the Unexpected Pages, charged with delivering a candlestick." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:TomTheCutpurse a rpg:Character ;
    rpg:name "Tom the Cutpurse" ;
    dc:description "An example agent of Carolus, a thief with a Bond of Gratitude who is asked to steal a mayor's signet ring using Dexterity plus Legerdemain." ;
    skos:altLabel "Tom" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:TonicOfGold a rpg:Item ;
    rpg:name "Tonic of Gold" ;
    dc:description "A Theriac of Level 5, Potency Weak, made with minute quantities of gold, that restores a Winded character to a non-fatigued state." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TortureChairOfZeus a rpg:Item ;
    rpg:name "Torture Chair of Zeus" ;
    dc:description "A mechanized chair Hephaestus made that Zeus used to torture Hera; rediscovered by Milo and prize of the first Verditius Contest, won by Gelon." ;
    skos:altLabel "mechanical torture chair", "mechanized torture chair" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TouchOfTheGooseFeather a rpg:Spell ;
    rpg:name "Touch of the Goose Feather" ;
    dc:description "A Perdo Corpus spell (Level 5) that causes the target to let out a loud sneeze, disrupting concentration and activities." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TouchOfThePearls a rpg:Spell ;
    rpg:name "Touch of the Pearls" ;
    dc:description "An Intellego Aquam spell (Level 5) that tells the caster whether a touched liquid is poisonous, like a pearl, without tasting it." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Toul a schema:Place ;
    rpg:name "Toul" ;
    dc:description "A venerable city forty miles up the Mosel from Metz, formerly Roman Tullum, surrounded by tall white stone walls and remaining loyal to its duke." ;
    skos:altLabel "Tullum" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Toulouse a schema:Place ;
    rpg:name "Toulouse" ;
    dc:description "A location in the Provencal Tribunal where the covenant of Tolosa Paratge resides." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TowerOfNotatus a schema:Place ;
    rpg:name "Tower of Notatus" ;
    dc:description "A tower at Durenmar conjured by and named after the first Primus of House Bonisagus; it houses most Bonisagus magi and Murion's sanctum." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TowerOfTrianoma a schema:Place ;
    rpg:name "Tower of Trianoma" ;
    dc:description "The youngest of Durenmar's three towers, named in honor of Trianoma; its basement houses one of the Rhine's official Mercer Houses." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TowerOfWhirlingWater a rpg:Spell ;
    rpg:name "Tower of Whirling Water" ;
    dc:description "A Rego Aquam spell (Level 35) that forms a waterspout under the caster's mental direction, damaging and potentially drowning those it hits." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TraditionalWard a rpg:Tag ;
    skos:prefLabel "Traditional Ward" ;
    dc:description "A taboo that a faerie may not touch with its glamour; it cannot regenerate Might in the ward's presence and is harmed if forced to touch it." ;
    rpg:hasTag amol:Flaw .
amol:Traditionalists a rpg:Faction ;
    rpg:name "Traditionalists" ;
    dc:description "A philosophical faction within House Guernicus that believes the Code should be preserved as it has been since the Founding." ;
    skos:altLabel "Traditionalist" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Transitionalists a rpg:Faction ;
    rpg:name "Transitionalists" ;
    dc:description "A philosophical faction within House Guernicus, started by Simprim, that believes the Code should be revised and seeks greater legal powers for the Quaesitores." ;
    skos:altLabel "Transitionalist" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Transmission a rpg:Tag ;
    skos:prefLabel "Transmission" ;
    dc:description "The process by which a Criamon magus passes learned wisdom on to other members of the House, sometimes encapsulating it perfectly into a place or object upon entering Twilight." ;
    skos:altLabel "Final Transmission", "perfect transmission" ;
    rpg:hasTag amol:HermeticConcept .
amol:TrappingTheFire a rpg:Spell ;
    rpg:name "Trapping the Fire" ;
    dc:description "A Muto Ignem spell (Level 25) with a Terram requisite that turns the heat and flames of a large campfire into a small hard object such as a gem; breaking the object releases the flame." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TreadingTheAshenPath a rpg:Spell ;
    rpg:name "Treading the Ashen Path" ;
    dc:description "A Perdo Herbam spell (Level 30) that withers and destroys plant material in front of the caster as they walk up to 7 miles; invented by a magus of House Flambeau." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TreasureOfTheNibelungs a rpg:Item ;
    rpg:name "Treasure of the Nibelungs" ;
    dc:description "The great treasure Siegfried won from the Nibelungs, later sunk in the Rhine by Hagen and lost forever after the tragedy of the Nibelungenlied." ;
    skos:altLabel "Nibelung hoard", "Nibelung treasure" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:TreeFallingInTheForest a rpg:Spell ;
    rpg:name "Tree Falling in the Forest" ;
    dc:description "A Pe(Re)He 35 spell that instantly cuts down a tree in a chosen direction; with an aiming roll it can fall on a creature for up to +18 damage and bypasses Magic Resistance." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TresExMiscellanea a rpg:Character ;
    rpg:name "Tres Ex Miscellanea" ;
    dc:description "A rustic magus tried at the Provencal Tribunal of 1214 for interfering with mundanes after declaring Wizard's War and destroying a rival covenant's tower with an army." ;
    skos:altLabel "Tres" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:TrethevyQuoit a schema:Place ;
    rpg:name "Trethevy Quoit" ;
    dc:description "A group of standing stones supporting a capstone, believed to be the home of a powerful faerie who does not like to be disturbed." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Trevelyan a rpg:Character ;
    rpg:name "Trevelyan" ;
    dc:description "The first Trevelyan, the only man who escaped the drowning of Lyonesse by riding his white horse ahead of the flood to St. Michael's Mount." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:TrianomaSThirdFilia a rpg:Character ;
    rpg:name "Trianoma's third filia" ;
    dc:description "Reference duplicates Irmele." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Trianomans a rpg:Faction ;
    rpg:name "Trianomans" ;
    dc:description "Wandering magi who politically defend certain sites of mystical significance across Mythic Europe." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:TribunalFieldOfDurenmar a schema:Place ;
    rpg:name "Tribunal Field of Durenmar" ;
    dc:description "The traditional grounds at Durenmar where the Rhine Tribunal gathers, containing the Forum and the ancient seat of Bjornaer; site of the Order's initiation ceremonies." ;
    skos:altLabel "the Forum" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:TribunalOfNovgorod a rpg:Faction ;
    rpg:name "Tribunal of Novgorod" ;
    dc:description "A Hermetic Tribunal whose covenants often take advantage of the great fair of Thessalonica (the Demetria)." ;
    skos:altLabel "Novgorod" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Tribunal .
amol:TribunalOfTransylvania a rpg:Faction ;
    rpg:name "Tribunal of Transylvania" ;
    dc:description "A Hermetic Tribunal whose covenants frequent the great fair of Thessalonica for its eastern goods." ;
    skos:altLabel "Transylvania" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Tribunal .
amol:Trinitarians a rpg:Faction ;
    rpg:name "Trinitarians" ;
    dc:description "An order of monks active since 1198 dedicated to ransoming slaves." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Tristan a rpg:Character ;
    rpg:name "Tristan" ;
    dc:description "Hero whose place of birth was the land of Lyonesse." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:TrocheOfColocynth a rpg:Item ;
    rpg:name "Troche of Colocynth" ;
    dc:description "A Theriac of Level 5, Potency Weak, a compressed pill that causes violent bowel evacuations and can purge retained humors from a patient with a melancholic disease." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:Trods a rpg:Tag ;
    skos:prefLabel "Trods" ;
    dc:description "Special pathways that lead into and out of Faerie, connecting regio levels to each other and the mundane world and even leading to Arcadia; Arcadian Travel lets Merinitae create them at will." ;
    skos:altLabel "trod" ;
    rpg:hasTag amol:HermeticConcept .
amol:Trolls a rpg:Creature ;
    rpg:name "Trolls" ;
    dc:description "Supernatural creatures given as an example of guardians for a magical jewel in a tournament special challenge." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Trollsynir a rpg:Faction ;
    rpg:name "Trollsynir" ;
    dc:description "Wizards said to live in Scandinavia and Iceland who claim descent from giants and bear the power to curse their enemies; a Damhadh-Duidsan variant." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:TrotulaOfSalerno a rpg:Character ;
    rpg:name "Trotula of Salerno" ;
    dc:description "A famous recent example of a female physician (medica) practicing medicine in Mythic Europe." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:TroupeUpbringing a rpg:Tag ;
    skos:prefLabel "Troupe Upbringing" ;
    dc:description "A Minor General Virtue for a character raised among entertainers, granting +2 to rolls involving abilities in a selected area such as acrobatics or storytelling." ;
    rpg:hasTag amol:Virtue .
amol:TrouvRes a rpg:Tag ;
    skos:prefLabel "Trouvères" ;
    dc:description "A type of minstrel from northern France, concentrating on Arthurian poems, of whom Chrétien of Troyes is the most famous." ;
    skos:altLabel "trouvère" ;
    rpg:hasTag amol:CharacterType .
amol:TrueMerinitae a rpg:Faction ;
    rpg:name "True Merinitae" ;
    dc:description "A cult and House lineage following Mendalus's effort to reconstruct Merinita's nature Mysteries, who claim to learn Nature Lore directly from the Founder via Agnes." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:TrueRestOfTheInjuredBrute a rpg:Spell ;
    rpg:name "True Rest of the Injured Brute" ;
    dc:description "A Creo Animal spell (Level 20) granting an injured animal target a +9 bonus to all Recovery rolls while the spell is in effect." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TrueSightOfTheAir a rpg:Spell ;
    rpg:name "True Sight of the Air" ;
    dc:description "An Intellego Auram spell (Level 15) that lets the caster see clearly through smoke, fog, and dust, even if magical." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TrutinaTheQuaesitor a rpg:Character ;
    rpg:name "Trutina the Quaesitor" ;
    dc:description "A beautiful mature maga and quaesitor who joined Burnham in 1195, says little, and instructs an unGifted Redcap to vote with Iudicium; wears the badge of House Guernicus." ;
    skos:altLabel "Trutina" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Tuareg a rpg:Faction ;
    rpg:name "Tuareg" ;
    dc:description "A North African people with designated religious tribes; the Ineslemen Social Status belongs to one of these tribes." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:TuathaDeDanu a rpg:Faction ;
    rpg:name "Tuatha de Danu" ;
    dc:description "The fair folk of Ireland, said to be the children of the faerie goddess embodied in the Danube." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Tuisto a rpg:Character ;
    rpg:name "Tuisto" ;
    dc:description "The earth-born god of Germanic legend whose son Mannus sired the three ancestral fathers of the German tribes." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Tulgank a rpg:Creature ;
    rpg:name "Tulgank" ;
    dc:description "An ugly mountain-spirit faerie melded forever into his cavern floor by the Seelie he loved; his petrified hand still nurtures a rose whose petals yield Herbam vis." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:TurbTrained a rpg:Tag ;
    skos:prefLabel "Turb Trained" ;
    dc:description "A Minor Social Status Virtue for a character raised at a covenant and trained to fight in the turb, allowed to learn Martial Abilities at character creation." ;
    rpg:hasTag amol:Virtue .
amol:Turnis a rpg:Character ;
    rpg:name "Turnis" ;
    dc:description "The second Primus of House Verditius who developed the ritual allowing other Hermetic magi to join the House and set the rules of the Contest." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:TwilightMastery a rpg:Tag ;
    skos:prefLabel "Twilight Mastery" ;
    dc:description "A new Major Hermetic Virtue letting a magus choose the effects of Wizard's Twilight and induce Warping in others; the second Fruit of the Path of Warping." ;
    rpg:hasTag amol:Virtue .
amol:TwistTheLivingTree a rpg:Spell ;
    rpg:name "Twist the Living Tree" ;
    dc:description "A Rego Herbam spell (Level 25) that bends a living tree into unusual positions to form a cage, shelter, or wall while the caster maintains concentration." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:TwistedSpine a rpg:Tag ;
    skos:prefLabel "Twisted Spine" ;
    dc:description "A Minor Curse (Rego Corpus effect) that twists the victim's spine grotesquely, imposing -3 to social rolls." ;
    rpg:hasTag amol:Flaw .
amol:TytalanInk a rpg:Item ;
    rpg:name "Tytalan Ink" ;
    dc:description "A charged item in the form of colorless ink that becomes visible (turns black or another color) upon a command word, used by Tytalan magi for secret writing." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:Ulm a schema:Place ;
    rpg:name "Ulm" ;
    dc:description "A city on the northern bank of the upper Danube first settled by Jews in the 9th century, declared a Free Imperial City by Frederick Barbarossa in 1164 and known for linen weaving." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:UltimaThule a schema:Place ;
    rpg:name "Ultima Thule" ;
    dc:description "A far-northern region where the walking dead are prevalent, leading Donatores there to concentrate on Corpus." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Ultor a rpg:Item ;
    rpg:name "Ultor" ;
    dc:description "A Summa on Penetration (Level 5, Quality 11) by Elaine, emphasizing penetrating the Parma Magica." ;
    skos:altLabel "The Avenger" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:Unbaptized a rpg:Tag ;
    skos:prefLabel "Unbaptized" ;
    dc:description "A Major Story Flaw in which the character is a Christian who has never been baptized, often due to a supernatural background, and does not benefit from the sacraments." ;
    rpg:hasTag amol:Flaw .
amol:UncertainFaith a rpg:Tag ;
    skos:prefLabel "Uncertain Faith" ;
    dc:description "A Minor General Flaw in which doubt stands between the character and the Divine, giving -3 to holy influence rolls and a +1 Personality Trait that demons exploit." ;
    rpg:hasTag amol:Flaw .
amol:UncontrollableStrength a rpg:Tag ;
    skos:prefLabel "Uncontrollable Strength" ;
    dc:description "A Minor General Flaw in which the character doesn't know his own strength, requiring a stress roll against Ease Factor 6 to avoid overdoing delicate tasks." ;
    rpg:hasTag amol:Flaw .
amol:Undecorated a rpg:Tag ;
    skos:prefLabel "Undecorated" ;
    dc:description "A Minor laboratory Outfittings Flaw: the lab has spartan or absent decoration, making it uninspiring (-1 Upkeep, -1 Aesthetics)." ;
    rpg:hasTag amol:Flaw .
amol:Underwater a rpg:Tag ;
    skos:prefLabel "Underwater" ;
    dc:description "A Minor laboratory Supernatural Flaw: the lab is filled with water instead of air, causing breathing and movement difficulties (+2 Safety, +1 Warping, -2 Aesthetics, +4 Aquam)." ;
    rpg:hasTag amol:Flaw .
amol:UndoingTheStonemasonSHandiwork a rpg:Spell ;
    rpg:name "Undoing the Stonemason's Handiwork" ;
    dc:description "A PeTe 15 spell that smashes masonry or pavement into component stones; used by School of Vilano followers to produce loose stones for ammunition or to collapse structures." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:UneaseOfTheStillForest a rpg:Spell ;
    rpg:name "Unease of the Still Forest" ;
    dc:description "A Mentem power of the bockman faeries that radiates an aura of unease up to 100 paces, silencing birds and instilling growing dread and paranoia in those within." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:UnevenFloor a rpg:Tag ;
    skos:prefLabel "Uneven Floor" ;
    dc:description "A Free laboratory Structure Flaw: the lab has a wonky or dangerous floor, e.g. a cave or sand-covered floor (-1 Safety, -1 Health, -1 Aesthetics)." ;
    rpg:hasTag amol:Flaw .
amol:UnimaginativeLearner a rpg:Tag ;
    skos:prefLabel "Unimaginative Learner" ;
    dc:description "A Minor Hermetic Flaw in which the character has trouble figuring things out, subtracting 3 from rolls when studying from raw vis." ;
    rpg:hasTag amol:Flaw .
amol:Uninspirational a rpg:Tag ;
    skos:prefLabel "Uninspirational" ;
    dc:description "A Minor General Flaw in which the character is bland and boring; Presence and Communication may not exceed 0, and social Abilities used to impress suffer -3." ;
    rpg:hasTag amol:Flaw .
amol:UniversityOfArezzo a schema:Place ;
    rpg:name "University of Arezzo" ;
    dc:description "A small student-run Italian university south of Florence, founded in 1215, offering faculties of law, medicine, and the arts." ;
    skos:altLabel "Arezzo", "Avezzo" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:UniversityOfPalencia a schema:Place ;
    rpg:name "University of Palencia" ;
    dc:description "A royal Spanish university founded by King Alfonso VIII of Castile in 1208, with faculties of arts, canon law, and theology, overseen by the Bishop of Palencia." ;
    skos:altLabel "Palencia" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:UniversityOfReggio a schema:Place ;
    rpg:name "University of Reggio" ;
    dc:description "A small student-run Italian university northwest of Bologna teaching law exclusively, founded by departing Bolognese scholars." ;
    skos:altLabel "Reggio" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:UniversityOfVicenza a schema:Place ;
    rpg:name "University of Vicenza" ;
    dc:description "A short-lived Italian university swarmed from Bologna, lasting from 1204 until scholars returned to Bologna in 1210." ;
    skos:altLabel "Vicenza" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Unlucky a rpg:Tag ;
    skos:prefLabel "Unlucky" ;
    dc:description "A Minor General Flaw in which the character is exceptionally unlucky, getting -1 to -3 on rolls in luck-based situations." ;
    rpg:hasTag amol:Flaw .
amol:Unraveling a rpg:Proficiency ;
    rpg:name "Unraveling" ;
    dc:description "A new Mastery special ability applicable to Perdo Vim spells, adding three times the Mastery score to the spell's effective level for destroying magic." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:UnravelingTheFabricOfForm a rpg:Spell ;
    rpg:name "Unraveling the Fabric of (Form)" ;
    dc:description "A Perdo Vim 20 spell enchanted into Philippus Niger's talisman with ten related effects, one for each Hermetic Form; basis for Shattering the Malicious Rune." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:UnravelingTheFabricOfImaginem a rpg:Spell ;
    rpg:name "Unraveling the Fabric of Imaginem" ;
    dc:description "A Perdo Vim (PeVi 20) spell that dispels Imaginem (image) magic." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Unravelling a rpg:Tag ;
    skos:prefLabel "Unravelling" ;
    dc:description "A Mastered Spell special ability for Perdo Vim spells, adding three times Mastery score to the effective level when destroying a targeted magical effect." ;
    rpg:hasTag amol:HermeticConcept .
amol:UnravellingTheFabricOfForm a rpg:Spell ;
    rpg:name "Unravelling the Fabric of (Form)" ;
    dc:description "A Perdo Vim spell that cancels the effects of one spell of a specified Form; ten Form variants exist plus rarer non-Hermetic variants." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Unseelie a rpg:Faction ;
    rpg:name "Unseelie" ;
    dc:description "A dark faction of faeries; an Unseelie faerie lord holds a melancholy feast on the last day of winter at which a doomed mortal is danced to death, leaving footprints where destroying angel mushrooms grow." ;
    skos:altLabel "Unseelie faeries" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:Unspecialized a rpg:Tag ;
    skos:prefLabel "Unspecialized" ;
    dc:description "A Minor General Flaw in which the character does not have any specialties for any of her Abilities." ;
    rpg:hasTag amol:Flaw .
amol:Unstable a rpg:Tag ;
    skos:prefLabel "Unstable" ;
    dc:description "A Free laboratory Structure Flaw: the lab is prone to movement, e.g. on a ship or earthquake-prone, causing occasional accidents (+1 Upkeep, -1 Safety)." ;
    rpg:hasTag amol:Flaw .
amol:UnstructuredCaster a rpg:Tag ;
    skos:prefLabel "Unstructured Caster" ;
    dc:description "A Major Hermetic Flaw in which the character casts all Formulaic spells as Ritual spells (including needing vis) and may not learn Ritual spells, but casts Spontaneous spells normally." ;
    rpg:hasTag amol:Flaw .
amol:UnyieldingEarth a rpg:Spell ;
    rpg:name "Unyielding Earth" ;
    dc:description "A Rego Terram spell that compacts the ground surface in a 15-by-15-pace area, making it more solid." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:UpperLorraine a schema:Place ;
    rpg:name "Upper Lorraine" ;
    dc:description "A duchy that came into existence on the division of the Carolingian empire, a moderately populated rolling plain bounded by the Vosges, Rhine, Ardennes, and Argonne; its seat is Nancy." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:UrgenOfCrintera a rpg:Character ;
    rpg:name "Urgen of Crintera" ;
    dc:description "Leader of the Weissdorngilde (Hawthorn Gild), a follower of House Bjornaer from the covenant of Crintera." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:UrielTheAngelOfPunishment a rpg:Creature ;
    rpg:name "Uriel, the Angel of Punishment" ;
    dc:description "An angel known as the Angel of Punishment, whom the chastising angel Kolazonta serves." ;
    skos:altLabel "Uriel" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:UrsulaDensacer a rpg:Character ;
    rpg:name "Ursula Densacer" ;
    dc:description "Clan Chief of Clan Arelie, a wolf-heartbeast maga acclaimed for erudition and poetry, and a friend of Prima Falke." ;
    skos:altLabel "Sharp-Tooth", "Ursula Sharp Tooth" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:UsamaIbnMunqidh a rpg:Character ;
    rpg:name "Usama ibn Munqidh" ;
    dc:description "A historical author (d. 1188) quoted from The Book of Learning by Example describing an angelic rescue on a mountain, illustrating the angel Nasir." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Usurer a rpg:Tag ;
    skos:prefLabel "Usurer" ;
    dc:description "A Minor Social Status Flaw in which the character lends valuables at abusive interest rates, earning about ten pounds of silver yearly but holding a poor reputation at level 4." ;
    rpg:hasTag amol:Flaw .
amol:Uswaurpa a rpg:Tag ;
    skos:prefLabel "Uswaurpa" ;
    dc:description "A byname ('reject') for a Bjornaer magus known to have shapeshifted before Initiation, who acquires the scorn of his peers." ;
    skos:altLabel "reject" ;
    rpg:hasTag amol:CharacterType .
amol:ValdemarI a rpg:Character ;
    rpg:name "Valdemar I" ;
    dc:description "The Danish king whose invasion of Rügen in 1168 surprised the Bjornaer covenant of Crintera and triggered its crisis." ;
    skos:altLabel "Danish king Valdemar I" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:ValdemarII a rpg:Character ;
    rpg:name "Valdemar II" ;
    dc:description "The King of Denmark, relatively secure with Schleswig and Holstein under his control, who in the historical timeline grants Kolding a full charter in 1230." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Valdus a rpg:Character ;
    rpg:name "Valdus" ;
    dc:description "A magus of House Tytalus charged in 1109 AD by Treverorum for theft of vis from a site outside Trier; fined one pawn of vis and ordered to seek permission before harvesting again." ;
    skos:altLabel "Valdus of House Tytalus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:VanasalusOfCriamon a rpg:Character ;
    rpg:name "Vanasalus of Criamon" ;
    dc:description "A young, friendly Criamon maga of Semitae who believes magic reflects one's personality and follows Gerfallon to understand the Enigma." ;
    skos:altLabel "Vanasalus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:VardianSTomb a rpg:Faction ;
    rpg:name "Vardian's Tomb" ;
    dc:description "A covenant whose necromancer created the plague that halted Barbarossa's army at the gates of Rome." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Covenant .
amol:VariablePower a rpg:Tag ;
    skos:prefLabel "Variable Power" ;
    dc:description "A Minor Supernatural Virtue: one of the character's magic powers grows more powerful over time based on age, Might, Warping, or an Ability score." ;
    rpg:hasTag amol:Virtue .
amol:Variola a rpg:Creature ;
    rpg:name "Variola" ;
    dc:description "A Serious Choleric Disease from putrid choler accumulating in the skin; highly contagious and disfiguring." ;
    skos:altLabel "small pox" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Varstus a rpg:Character ;
    rpg:name "Varstus" ;
    dc:description "An Italian Alps wizard skilled in sympathetic magic whom Flambeau confronted with the words 'Join us or die!' in 771 and slew when he fled." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Venatus a rpg:Character ;
    rpg:name "Venatus" ;
    dc:description "An eighty-year-post-Gauntlet Collegium-turned-Lyceum magus of Trianoma's lineage who discovered the New Aristotle at Bologna, split from the Collegium to found the Lyceum, and still teaches at a university." ;
    skos:altLabel "Venatus Trianomae" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:VenetianArsenal a schema:Place ;
    rpg:name "Venetian Arsenal" ;
    dc:description "The most heavily capitalized manufactory in Europe, located in Venice, capable of outfitting three war galleys per day to assemble a fleet for the Fourth Crusade." ;
    skos:altLabel "the Arsenal" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:VengefulPowers a rpg:Tag ;
    skos:prefLabel "Vengeful Powers" ;
    dc:description "A Major Story Tainted Flaw in which the Infernal realm has taken interest in the character's non-Infernal Powers, causing harmful side effects whenever they are used without sin." ;
    rpg:hasTag amol:Flaw .
amol:Venus a rpg:Character ;
    rpg:name "Venus" ;
    dc:description "The goddess who dwells in the subterranean Venusberg, where the knight Tannhäuser worshiped her for a year." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:VenusSBlessing a rpg:Tag ;
    skos:prefLabel "Venus's Blessing" ;
    dc:description "A suitable Free Virtue for Jerbiton magi, preferred for characters desiring weaker emotional attachments." ;
    skos:altLabel "Venus's Blessing Virtue" ;
    rpg:hasTag amol:Virtue .
amol:VerdanOfExMiscellanea a rpg:Character ;
    rpg:name "Verdan of Ex Miscellanea" ;
    dc:description "A magus of House Ex Miscellanea whose sigil makes all his spells involve the color green, such as turning poisonous liquids faint green." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Verderis a rpg:Character ;
    rpg:name "Verderis" ;
    dc:description "The third Primus of House Criamon, author of the epic poem The Travels of Fedoso; his ghost is absent from the Cave of Twisting Shadows and he had the Premonitions Virtue." ;
    skos:altLabel "the third Primus" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:VerditiusForge a schema:Place ;
    rpg:name "Verditius' Forge" ;
    dc:description "The laboratory built by the Founder Verditius near the Tower of Bonisagus at Durenmar, traditionally housing the covenant's Artificer." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Verdun a schema:Place ;
    rpg:name "Verdun" ;
    dc:description "A border city on the River Meuse famous for the Treaty of 843, where spies and assassins can be recruited and Redcaps meet while traveling between the Rhine and Normandy Tribunals." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:VernacularEducation a rpg:Tag ;
    skos:prefLabel "Vernacular Education" ;
    dc:description "A minor general Virtue of secular tutoring for merchant-house scions, allowing purchase of Academic Abilities and granting extra experience points for trade-relevant Abilities." ;
    rpg:hasTag amol:Virtue .
amol:Vesta a rpg:Creature ;
    rpg:name "Vesta" ;
    dc:description "A Roman goddess of hearth and home whose rites were integrated into the cult of Diana and adopted as patron by the Cult of Vesta; treated as a faerie/pagan deity in Mythic Europe." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:ViatorOfMercere a rpg:Character ;
    rpg:name "Viator of Mercere" ;
    dc:description "The only Gifted Redcap in the tribunal, retired to Ungulus to develop a magical means of communication between covenants without compromising their defenses." ;
    skos:altLabel "Viator" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Vilano a rpg:Character ;
    rpg:name "Vilano" ;
    dc:description "A ninth-century Flambeau magus from Istria in the Transylvanian Tribunal who suffered the Flaw Weak Magic but pioneered combat with only indirect spells, famously slaying the Green Dragon of Labin with falling trees." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:VileSurroundings a rpg:Tag ;
    skos:prefLabel "Vile Surroundings" ;
    dc:description "A Free laboratory Structure Flaw: the lab sits in an undesirable place such as a swamp or by a filthy hovel (-2 Health, -1 Aesthetics)." ;
    rpg:hasTag amol:Flaw .
amol:VileWaterOfSterility a rpg:Spell ;
    rpg:name "Vile Water of Sterility" ;
    dc:description "A Muto Aquam Ritual spell that ruins a body of water up to a small lake, making it dark, noxious, and unfit for habitation or consumption." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:VillardDeHonnecourt a rpg:Character ;
    rpg:name "Villard de Honnecourt" ;
    dc:description "The most famous master mason of 1220, who worked on cathedrals at Laon, Chartres, Reims, and Meux and produced tractatus sketchbooks usable to study Craft: Mason." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:VirginMary a rpg:Character ;
    rpg:name "Virgin Mary" ;
    dc:description "By far the most important saint, the mother of God, believed to have particularly strong influence in interceding with God; Margaret of Beverley was rescued by her grace." ;
    skos:altLabel "mother of God", "the Virgin" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:VirtuesAndFlaws a rpg:Tag ;
    skos:prefLabel "Virtues and Flaws" ;
    dc:description "Special character features: Virtues grant benefits while Flaws impose disadvantages or story hooks, including supernatural abilities, aptitudes, and personality traits." ;
    rpg:hasTag amol:HermeticConcept .
amol:VisExtraction a rpg:Tag ;
    skos:prefLabel "Vis Extraction" ;
    dc:description "The laboratory activity of distilling raw vis, appearing as a lab Specialization aided by superior equipment, stills, and certain Features." ;
    rpg:hasTag amol:HermeticConcept .
amol:VisGrant a rpg:Tag ;
    skos:prefLabel "Vis Grant" ;
    dc:description "A covenant Boon representing the annual division of surplus vis among the members." ;
    rpg:hasTag amol:HermeticConcept .
amol:VisSalary a rpg:Tag ;
    skos:prefLabel "Vis Salary" ;
    dc:description "A covenant Hook in which members must work to earn a share of vis, appropriate when individuals must petition the council for vis." ;
    rpg:hasTag amol:HermeticConcept .
amol:VisionOfHeatSLight a rpg:Spell ;
    rpg:name "Vision of Heat's Light" ;
    dc:description "An Intellego Ignem spell (Level 20) that lets the caster see the heat of objects of human body temperature or hotter, useful in the dark though not giving true vision." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:VisionOfTheScryingPool a rpg:Spell ;
    rpg:name "Vision of the Scrying Pool" ;
    dc:description "A Hermetic spell adapted from one of the lost golden-tablet rituals of the Cult of Mercury." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:VisionsOfTheInfernalTerrors a rpg:Spell ;
    rpg:name "Visions of the Infernal Terrors" ;
    dc:description "A spell that causes everything the target sees and hears to appear terrifying, potentially scaring them to death." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Vitriol a rpg:Item ;
    rpg:name "Vitriol" ;
    dc:description "A Level 15 Alteration Reagent that creates strong acid able to dissolve stone, base metal, and wood, inflicting +10 damage if poured on a person; only glass is proof against it." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:VoiceLikeABard a rpg:Tag ;
    skos:prefLabel "Voice Like a Bard" ;
    dc:description "A common automaton power (base effect 10, Creo Imaginem) letting the automaton masterfully sing a small repertoire of ballads." ;
    rpg:hasTag amol:HermeticConcept .
amol:VoiceLikeANightingale a rpg:Tag ;
    skos:prefLabel "Voice Like a Nightingale" ;
    dc:description "A common automaton power (base effect 5, Creo Imaginem) letting the automaton sing bird songs through its mouth." ;
    rpg:hasTag amol:HermeticConcept .
amol:VoiceOfTheLand a rpg:Tag ;
    skos:prefLabel "Voice of the (Land)" ;
    dc:description "A Minor Supernatural Virtue letting the character speak with any creature whose natural habitat is a particular environment, without being perceived as threat or prey." ;
    rpg:hasTag amol:Virtue .
amol:Volkhvy a rpg:Tag ;
    skos:prefLabel "Volkhvy" ;
    dc:description "Exclusively male pagan priests of Rugen who serve gods such as the Forest Brothers and Svantovit; nearly all have the Ways of the Forest Virtue and can open faerie gates." ;
    skos:altLabel "volkhv" ;
    rpg:hasTag amol:CharacterType .
amol:VowOfService a rpg:Tag ;
    skos:prefLabel "Vow of Service" ;
    dc:description "A Flaw binding a character to a vow of service, taken by the Ghostly Warden." ;
    rpg:hasTag amol:Flaw .
amol:Vulcan a rpg:Character ;
    rpg:name "Vulcan" ;
    dc:description "The Roman god of fire and the forge after whom the Cult of Vulcan was renamed; Balento claimed descent from him and his Mysteries emphasized destructive fire." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Vulnerable a rpg:Tag ;
    skos:prefLabel "Vulnerable" ;
    dc:description "A Free laboratory Structure Flaw: the lab lacks even basic defenses and is easily entered (-1 Aesthetics)." ;
    rpg:hasTag amol:Flaw .
amol:VysehradRock a schema:Place ;
    rpg:name "Vysehrad Rock" ;
    dc:description "A hilltop south of Prague where the Gifted Princess Libuse had her vision foretelling her husband Premysl, founder of Bohemia's ruling dynasty; now site of Prague's second castle." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Wahhab a rpg:Creature ;
    rpg:name "Wahhab" ;
    dc:description "An example jinni with Magic Might 15 (Ignem), a fire spirit inhabiting ancient ruins of a fane to a forgotten god in Iberia, with fire and shapeshifting powers." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Waldgeister a rpg:Creature ;
    rpg:name "Waldgeister" ;
    dc:description "German wood-faeries dwelling in huge numbers in forests, some benevolent and some malicious, including Katzenveit, Gübich, and Rübezahl." ;
    skos:altLabel "Waldgeist", "wood-spirits" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:WallOfLivingWood a rpg:Spell ;
    rpg:name "Wall of Living Wood" ;
    dc:description "A Creo Herbam spell (Level 25) that creates a straight wall of living oak 20 paces long, growing quickly from nearby trees or fertile earth." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:WallOfThorns a rpg:Spell ;
    rpg:name "Wall of Thorns" ;
    dc:description "A Creo Herbam spell (Level 15) that creates a straight wall of resilient thorny bushes up to 20 paces long and 4 paces high." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:WalpurgisNight a rpg:Tag ;
    skos:prefLabel "Walpurgis Night" ;
    dc:description "The eve of the 1st of May on which Rhine Tribunal gatherings begin and a procession of witches takes place on the Brocken." ;
    rpg:hasTag amol:HermeticConcept .
amol:Walsingham a schema:Place ;
    rpg:name "Walsingham" ;
    dc:description "A shrine of Our Lady in Norfolk and a pilgrimage site of growing importance; the Virgin of Walsingham is claimed to be especially powerful." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:WalterDeGrey a rpg:Character ;
    rpg:name "Walter de Grey" ;
    dc:description "The Archbishop of York (elected 1215), a royal servant and former chancellor who quarrels with Stephen Langton over the right to bear his cross in the southern province." ;
    skos:altLabel "Walter", "Walter Gray" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:WaltherVonDerVogelweide a rpg:Character ;
    rpg:name "Walther von der Vogelweide" ;
    dc:description "The most brilliant minnesanger, who bested rivals at the 1204 Wartburg Sangerkrieg and composed poems for rival claimants to the imperial throne." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:WaltherVonDerVogelwiede a rpg:Character ;
    rpg:name "Walther von der Vogelwiede" ;
    dc:description "One of the most famous German minnesingers, living in Vienna at the court of Leopold VI." ;
    skos:altLabel "Walther" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Wanderlust a rpg:Tag ;
    skos:prefLabel "Wanderlust" ;
    dc:description "A Major Story Flaw in which the character is compelled to travel and cannot spend more than a season in the same place." ;
    rpg:hasTag amol:Flaw .
amol:WardAgainstBeastsOfLegend a rpg:Spell ;
    rpg:name "Ward Against Beasts of Legend" ;
    dc:description "A Rego Animal 25 warding effect enchanted into Philippus Niger's Subtle Chain." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:WardAgainstFlame a rpg:Spell ;
    rpg:name "Ward Against Flame" ;
    dc:description "A Rego Ignem 15 spell creating a circle that mundane fires cannot cross, used around heat sources, grain stores, and sometimes whole laboratories." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:WardAgainstMonstersWhichWalkAsMan a rpg:Spell ;
    rpg:name "Ward Against Monsters Which Walk As Man" ;
    dc:description "A Rego Corpus 25 warding effect enchanted into Philippus Niger's Subtle Chain, protecting against Might-bearing creatures affected by Corpus." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:WardAgainstMundaneIntrusions a rpg:Spell ;
    rpg:name "Ward Against Mundane Intrusions" ;
    dc:description "A Rego Ignem 35 spell with Corpus, Animal, Aquam, and Herbam requisites that conglomerates other wards to hold off flame, light, thieves, pests, moisture, and mildew." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:WardAgainstTheCuriousScullion a rpg:Spell ;
    rpg:name "Ward Against the Curious Scullion" ;
    dc:description "A Rego Corpus 10 spell creating a circle that humans lacking Magic Resistance cannot cross, used to bar entry to Hermetic sancta." ;
    skos:altLabel "Tytalus's Prison" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:WardAgainstFaeriesOfTheMountain a rpg:Spell ;
    rpg:name "Ward against Faeries of the Mountain" ;
    dc:description "A Rego Terram spell warding against faeries of earth and stone, working like Ward Against Faeries of the Waters." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:WardAgainstWood a rpg:Spell ;
    rpg:name "Ward against Wood" ;
    dc:description "A Rego Herbam spell (Level 25) that protects the caster from nonenchanted wood so that none of it can contact his body." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:WardAgainstTheBeastsOfLegend a rpg:Spell ;
    rpg:name "Ward against the Beasts of Legend" ;
    dc:description "A Rego Animal General ward spell that prevents any magical beast whose Magic Might is at or below the spell level from affecting those within a circle." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:WardTheCruelTouchOfPestilence a rpg:Spell ;
    rpg:name "Ward the Cruel Touch of Pestilence" ;
    dc:description "A CrCo 20 spell that grants the target a +9 bonus to Stamina rolls to avoid contracting diseases." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:WarpedSenses a rpg:Tag ;
    skos:prefLabel "Warped Senses" ;
    dc:description "A Minor General Flaw making a character overly sensitive to environmental conditions such as light, sound, taste, smell, cold, or heat, with variants like Sensitive (Sense) and Weak (Sense)." ;
    rpg:hasTag amol:Flaw .
amol:WarpedByMagic a rpg:Tag ;
    skos:prefLabel "Warped by Magic" ;
    dc:description "A Minor Supernatural Flaw representing exposure to powerful magical forces, granting Warping Points, a Warping Score of 1, and a related Minor Flaw." ;
    rpg:hasTag amol:Flaw .
amol:WasterOfVis a rpg:Tag ;
    skos:prefLabel "Waster of Vis" ;
    dc:description "A Major Hermetic Flaw causing the character to waste a quarter of the raw vis pawns he uses in any application of vis." ;
    rpg:hasTag amol:Flaw .
amol:Watchtower a schema:Place ;
    rpg:name "Watchtower" ;
    dc:description "A fortified stone building atop the cliffs overlooking Durenmar's valley, occupied by the Protector Philippus Niger and surrounded by blasted ground." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:WaterElemental a rpg:Creature ;
    rpg:name "Water Elemental" ;
    dc:description "An elemental being of water that can be created via Creo Aquam ritual and whose Might can be reduced or controlled by Aquam spells." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:WaterSprites a rpg:Creature ;
    rpg:name "Water sprites" ;
    dc:description "Water spirits encountered by Hagen at the River Danube who foretell that all the Burgundians but one priest are doomed to die." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:WaylandSSmithy a schema:Place ;
    rpg:name "Wayland's Smithy" ;
    dc:description "A barrow near the White Horse that is the home of the invisible smith Wayland, who shoes horses left with a penny and is said to be able to shoe the White Horse itself." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:WaysOfTheLocalEnvironment a rpg:Tag ;
    skos:prefLabel "Ways of the (Local Environment)" ;
    dc:description "A supernatural Virtue possessed by the angel Nasir, tied to a local environment." ;
    rpg:hasTag amol:Virtue .
amol:WaysOfTheMountains a rpg:Tag ;
    skos:prefLabel "Ways of the Mountains" ;
    dc:description "A Virtue possessed by Adranus, the spirit of Mount Etna, attuning a being to its mountain environment." ;
    rpg:hasTag amol:Virtue .
amol:WaysOfTheSwamp a rpg:Tag ;
    skos:prefLabel "Ways of the Swamp" ;
    dc:description "A Virtue granting bonuses in swamp terrain; possessed by the Boglin, who gains combat bonuses from it." ;
    rpg:hasTag amol:Virtue .
amol:WeakCharacteristics a rpg:Tag ;
    skos:prefLabel "Weak Characteristics" ;
    dc:description "A Minor General Flaw giving the character three fewer points to spend buying Characteristics." ;
    rpg:hasTag amol:Flaw .
amol:WeakEnchanter a rpg:Tag ;
    skos:prefLabel "Weak Enchanter" ;
    dc:description "A Minor Hermetic Flaw in which the magus's Gift is ill attuned to creating enchanted devices, halving Lab Total for creating or investigating enchanted items." ;
    rpg:hasTag amol:Flaw .
amol:WeakPersonality a rpg:Tag ;
    skos:prefLabel "Weak Personality" ;
    dc:description "A Minor Personality Flaw in which the character lacks strong feelings, restricting Personality Traits to between +1 and -1." ;
    rpg:hasTag amol:Flaw .
amol:WeakScholar a rpg:Tag ;
    skos:prefLabel "Weak Scholar" ;
    dc:description "A Minor Hermetic Flaw giving a -6 penalty to Lab Totals when working from the Lab Texts of others, including re-inventing spells." ;
    rpg:hasTag amol:Flaw .
amol:WeakWilled a rpg:Tag ;
    skos:prefLabel "Weak-Willed" ;
    dc:description "A Minor Personality Flaw in which the character looks to others for guidance rather than himself." ;
    rpg:hasTag amol:Flaw .
amol:Weaving a rpg:Proficiency ;
    rpg:name "Weaving" ;
    dc:description "The commonest Craft Ability for factors, reflecting skill in producing their main product." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:HermeticAbility .
amol:WellInsulated a rpg:Tag ;
    skos:prefLabel "Well Insulated" ;
    dc:description "A Minor laboratory Structure Virtue: the lab is especially shielded from the outside world, suitable for sensitive locations (+1 Safety, +1 Aesthetics)." ;
    rpg:hasTag amol:Virtue .
amol:WellTraveled_2 a rpg:Tag ;
    skos:prefLabel "Well Traveled" ;
    dc:description "A Virtue incompatible with the No Sense of Direction Flaw." ;
    rpg:hasTag amol:Virtue .
amol:WellWithoutLight a rpg:Spell ;
    rpg:name "Well without Light" ;
    dc:description "A Perdo Ignem spell (Level 25) that removes light from a target structure so that only spells above level 25 can create light there; the light flows into the caster's clenched fist." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:WelshDruids a rpg:Faction ;
    rpg:name "Welsh druids" ;
    dc:description "Indigenous Welsh magical tradition with which House Díedne had close links, though they did not join the Order; associated with stone circles." ;
    skos:altLabel "druids" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:WestCountry a schema:Place ;
    rpg:name "West Country" ;
    dc:description "The covenant-free region of Devon and Cornwall, suitable for magical colonization, near the ruins of Sursum and Stellapser and sites associated with Arthur." ;
    skos:altLabel "Devon and Cornwall" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:WesternChristendom a schema:Place ;
    rpg:name "Western Christendom" ;
    dc:description "A cultural society of Mythic Europe centered on western Europe and including the Crusader States, defining a set of Social Status Virtues and Flaws." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Westminster a schema:Place ;
    rpg:name "Westminster" ;
    dc:description "The seat of the court of the King's Bench and site of the king's Maundy Thursday ceremony in Westminster Abbey." ;
    skos:altLabel "Westminster Abbey" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Wiederich a rpg:Character ;
    rpg:name "Wiederich" ;
    dc:description "The sole survivor of the Magyar attack on Sirmium in 930, a Flambeau magus who joined the German armies to avenge himself on the Magyars; his vengeful descendants persist." ;
    skos:altLabel "Wiederich of House Flambeau" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Wieliczka a schema:Place ;
    rpg:name "Wieliczka" ;
    dc:description "A location in Poland named for its salt mines, cited as a Greater mining income example." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Wilding a rpg:Tag ;
    skos:prefLabel "Wilding" ;
    dc:description "A Major Nature Mystery letting a maga extract temporary vis from completely natural objects according to her Nature Lore." ;
    rpg:hasTag amol:Virtue .
amol:Wilkis a rpg:Character ;
    rpg:name "Wilkis" ;
    dc:description "Most eloquent of Birna's six apprentices, told to 'Nourish,' a wolf from a Prussian tribe, appointed first primus of the House; founder of Clan Wilkis." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:WilliamFireheartOfFlambeau a rpg:Character ;
    rpg:name "William Fireheart of Flambeau" ;
    dc:description "Ungulus's most infamous member at the end of the twelfth century, who caused trouble in northern France and lost a Wizard's War to a magus of Fudarus in 1220." ;
    skos:altLabel "William Fireheart" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:WilliamMarshalTheYounger a rpg:Character ;
    rpg:name "William Marshal the Younger" ;
    dc:description "The earl of Pembroke who holds Fotheringhay castle against royal orders and is suing Falkes de Bréauté over four disputed manors." ;
    skos:altLabel "earl of Pembroke" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:WilliamDeFors a rpg:Character ;
    rpg:name "William de Fors" ;
    dc:description "The count of Aumale who holds the royal castle of Rockingham despite government demands that he surrender it." ;
    skos:altLabel "count of Aumale" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:WilliamOfConches a rpg:Character ;
    rpg:name "William of Conches" ;
    dc:description "A scholar who taught at the cathedral school of Chartres." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:WilliamOfJerbiton a rpg:Character ;
    rpg:name "William of Jerbiton" ;
    dc:description "A Jerbiton magus of Rosalba targeted by Diana of Tremere in the 873 Wizards' War; his death began near-constant skirmishing." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:WilliamOfNewburgh a rpg:Character ;
    rpg:name "William of Newburgh" ;
    dc:description "A medieval chronicler quoted in the Donatores history, author of Historia Rerum Anglicarum, who recorded accounts of cadavers leaving their tombs to wander among the living." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:WilliamOfThanet a rpg:Character ;
    rpg:name "William of Thanet" ;
    dc:description "The aging, capable autocrat who has handled the day-to-day operation of Nigrasaxa since its founding." ;
    skos:altLabel "William" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:WilliamTheConqueror a rpg:Character ;
    rpg:name "William the Conqueror" ;
    dc:description "Duke of Normandy who conquered England after the Battle of Hastings in 1066, built the Tower of London, and commissioned the Domesday Book." ;
    skos:altLabel "Duke William of Normandy", "William" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Willigis a rpg:Character ;
    rpg:name "Willigis" ;
    dc:description "A tenth-century archbishop of Mainz from whom onwards the archbishop enjoyed the status of Archchancellor of the Empire." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Wilton a schema:Place ;
    rpg:name "Wilton" ;
    dc:description "The stone-built village fifteen minutes from Voluntas that serves as part of the covenant, housing covenfolk and providing an inn for guests." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Wimpfen a schema:Place ;
    rpg:name "Wimpfen" ;
    dc:description "A small fortified city high above the River Neckar with Roman, Frankish, and episcopal history, now a favorite imperial residence." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Winchester a schema:Place ;
    rpg:name "Winchester" ;
    dc:description "A declined but important city, former capital of England, with two castles (the royal castle and Wolvesey Castle of the bishop) and the great St. Giles's Fair." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:WindAtTheBack a rpg:Spell ;
    rpg:name "Wind at the Back" ;
    dc:description "A Rego Auram spell (Level 5) that makes an existing breeze follow the caster as they travel, causing phenomena like fog or haze to follow." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:Winfrida a rpg:Character ;
    rpg:name "Winfrida" ;
    dc:description "A young, timid Follower of Guernicus (age 27) and Quaesitor at Durenmar whom Murion is grooming; one of only two Guernicus magi in the Rhine Tribunal." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:WingsOfTheSoaringWinds a rpg:Spell ;
    rpg:name "Wings of the Soaring Winds" ;
    dc:description "A flight spell that lets a maga move at 40 miles per hour, cited in calculations about flying to the moon." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:WinterSIcyGrip a rpg:Spell ;
    rpg:name "Winter's Icy Grip" ;
    dc:description "A Perdo Ignem 30 spell known by Philippus Niger, mastered for Fast Casting." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:WisdomFromIgnorance a rpg:Tag ;
    skos:prefLabel "Wisdom from Ignorance" ;
    dc:description "A Minor Supernatural Virtue used by certain Egyptian Sufis interested in calligraphy, allowing them to use unreadable books as sources of training for spiritual subjects." ;
    rpg:hasTag amol:Virtue .
amol:WitchMarks a rpg:Tag ;
    skos:prefLabel "Witch Marks" ;
    dc:description "A Minor General Tainted Flaw giving the character disfigurements recognized by folk lore as belonging to diabolists." ;
    rpg:hasTag amol:Flaw .
amol:WitchesAltar a schema:Place ;
    rpg:name "Witches' Altar" ;
    dc:description "A mass of granite blocks atop the Brocken where, every Walpurgis Night, Walpurga summons the spirits of summer to defeat those of winter." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:WizardSAutumn a rpg:Spell ;
    rpg:name "Wizard's Autumn" ;
    dc:description "A Perdo Herbam spell (Level 15) that makes all deciduous leaves on target plants turn brown and fall, affecting a small grove of trees." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:WizardSEclipse a rpg:Spell ;
    rpg:name "Wizard's Eclipse" ;
    dc:description "A Perdo Ignem ritual (Level 35) that eclipses the sun within a target area, suddenly making it as dark as night." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:WizardSLeap a rpg:Spell ;
    rpg:name "Wizard's Leap" ;
    dc:description "A ReCo 15 spell that instantly transports the caster up to 50 paces toward a visible destination or Arcane Connection; effective as a fast-cast defense, bringing the caster's Talisman automatically." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:WizardSReach a rpg:Spell ;
    rpg:name "Wizard's Reach" ;
    dc:description "A Muto Vim spell that increases the range of a targeted spell by one category; ten Form-specific versions exist." ;
    skos:altLabel "Wizard's Reach (Form)" ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:WizardSWell a schema:Place ;
    rpg:name "Wizard's Well" ;
    dc:description "A site that Merlin is said to have created, according to the legends of the mage." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:WizardsMelee a rpg:Tag ;
    skos:prefLabel "Wizards' Melee" ;
    dc:description "A controversial Flambeau tournament event where teams of one magus and five grogs fight, the goal being to cast a Touch-range spell on the opposing magus." ;
    rpg:hasTag amol:HermeticConcept .
amol:WolfClan a rpg:Faction ;
    rpg:name "Wolf Clan" ;
    dc:description "One of Crintera's six clans; makes up the bulk of the covenant's warriors and servants, fights with axes, and protects the Prima. Its leader is traditionally a wolf skinchanger and the Prima's personal shield grog." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:FactionTag .
amol:WolfMount a rpg:Creature ;
    rpg:name "Wolf Mount" ;
    dc:description "A faerie wolf the size of a horse (Might 20) made of the glamour of a Valkyrie, sharing her Might pool, which carries her and passengers through the sky." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:WolfOfVirtue a rpg:Creature ;
    rpg:name "Wolf of Virtue" ;
    dc:description "A Great Beast Mythic Blood lineage granting the Paralyze a Man at R: Eye feat, a Focus in Wolves, and the Envious flaw." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:WolfSCloak a rpg:Item ;
    rpg:name "Wolf's Cloak" ;
    dc:description "A wondrous cloak made by a furrier that allows the wearer to change into a wolf until the next sunrise or sunset (Craft Level 17)." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:WondrousItems a rpg:Item ;
    rpg:name "Wondrous Items" ;
    dc:description "The highest quality of crafted goods, minor enchanted items whose Craft Level is 12 plus the magnitude of effect; the goldsmith Banco is renowned for making them." ;
    skos:altLabel "minor enchanted items", "wondrous goods" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:WookeyHoleCaves a schema:Place ;
    rpg:name "Wookey Hole Caves" ;
    dc:description "A deep, partly flooded cave hung with stalactites, in which something is said to live, though local legends disagree about the details." ;
    skos:altLabel "Wookey Hole" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:WordsOfTheUnbrokenSilence a rpg:Spell ;
    rpg:name "Words of the Unbroken Silence" ;
    dc:description "A Creo Mentem spell (Level 10) that lets the caster say two words directly to the mind of a target, who recognizes the supernatural origin and the caster's voice." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:WorldOfForms a rpg:Tag ;
    skos:prefLabel "World of Forms" ;
    dc:description "The metaphysical source from which magic draws the details of created things; magi disagree whether it is the realm of Magic, the human mind, or the mind of God." ;
    rpg:hasTag amol:HermeticConcept .
amol:WrathOfWhirlingWindsAndWater a rpg:Spell ;
    rpg:name "Wrath of Whirling Winds and Water" ;
    dc:description "A Creo Auram Ritual spell (Level 65) that creates an immense hurricane-intensity storm 40 or more miles wide, causing massive damage along shorelines and inland." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:WreathsOfFoulSmoke a rpg:Spell ;
    rpg:name "Wreaths of Foul Smoke" ;
    dc:description "A Creo Auram spell (Level 10) that raises thick yellow sulfurous smoke that blocks sight and causes Fatigue or wound loss to those who breathe it." ;
    rpg:capabilityDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:NamedSpell .
amol:WritOfReprisal a rpg:Tag ;
    skos:prefLabel "Writ of Reprisal" ;
    dc:description "A court order allowing a wronged merchant to seize goods from any merchant of a fraudster's home town; such a writ against the Order could trigger Quaesitor review of a covenant's representatives." ;
    rpg:hasTag amol:HermeticConcept .
amol:Wurzburg a schema:Place ;
    rpg:name "Wurzburg" ;
    dc:description "An influential episcopal city in the middle of Franconia at the center of its largest vineyards; its cathedral houses the shrine of St. Kilian." ;
    skos:altLabel "Würzburg" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Xanten a schema:Place ;
    rpg:name "Xanten" ;
    dc:description "A town on the west bank of the Rhine, formerly the Roman colony Colonia Ulpia Traiana, birthplace of the hero Siegfried and former capital of Nibelungland." ;
    skos:altLabel "Ad Santos Martyres", "Colonia Ulpia Traiana" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Xantippes a rpg:Character ;
    rpg:name "Xantippes" ;
    dc:description "A magus of House Jerbiton who helped found Treverorum to recover Roman secrets, later found guilty of meddling with the mundanes of Trier using his own Mentem magics for personal enrichment." ;
    skos:altLabel "Xantippes of House Jerbiton" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Xavier a rpg:Character ;
    rpg:name "Xavier" ;
    dc:description "A Gifted magus of House Mercere, the Rhine Tribunal's only Gifted Mercere and its archivist, who dwells at Durenmar at one of the two official Mercer Houses." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:XenophonOfBonisagus a rpg:Character ;
    rpg:name "Xenophon of Bonisagus" ;
    dc:description "The Bonisagus magus who founded the Platonist Hermetic societas the Collegium, believing the Founder had stripped Hermetic Theory of any inquiry into magic's nature or origin." ;
    skos:altLabel "Xenophon" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Xerxes a rpg:Character ;
    rpg:name "Xerxes" ;
    dc:description "A hoplite magus who took Uwe as an apprentice and trained him to become Darius, a hunter of evils within the Order; he is now too frail for combat." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:YGododdin a rpg:Item ;
    rpg:name "Y Gododdin" ;
    dc:description "The single famous poem by which the Welsh poet Aneirin is known, praising the war band of Mynyddawg Mwynfawr sent to recapture a Roman stronghold from the Saxons." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:Yanartas a schema:Place ;
    rpg:name "Yanartas" ;
    dc:description "A site near the Antalya Gulf in Asia Minor, where the mythical Chimera fell and fire leaps from the ground, location of one of Hephaestus's forges." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Yenghissar a schema:Place ;
    rpg:name "Yenghissar" ;
    dc:description "A small village along the route to Khashgar plagued every seven years by the Infernal storm spirit known as the Buran." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Yeshiva a schema:Place ;
    rpg:name "Yeshiva" ;
    dc:description "A Jewish school where students learn grammar and Jewish instruction by studying the Talmud and Mishnah from the local rabbi; large ones are in Cordoba and Granada." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Yonec a rpg:Character ;
    rpg:name "Yonec" ;
    dc:description "The son of a hawk-knight and an imprisoned lady in a Lai of Marie de France; he avenged his father by killing the jealous old lord and took his father's place as king." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:YonecSRingAndSword a rpg:Item ;
    rpg:name "Yonec's ring and sword" ;
    dc:description "Gifts the dying hawk-knight gave his lover: a ring ensuring her husband would remember nothing, and a sword for their son Yonec to avenge him." ;
    skos:altLabel "the hawk-knight's ring", "the hawk-knight's sword" ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
amol:York a schema:Place ;
    rpg:name "York" ;
    dc:description "The largest town of northern England and seat of the second English archbishop, a port on the River Ouse, site of the 1190 massacre of the Jews." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:YoungHenry a rpg:Character ;
    rpg:name "Young Henry" ;
    dc:description "The eldest son of Henry II at whose court William Marshal served, leading his mesnie at tournaments; he died of dysentery having taken a crusading vow." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Zanzibar a schema:Place ;
    rpg:name "Zanzibar" ;
    dc:description "A rich city, reachable by circumnavigating Africa, where gold is traded by equal weight for salt; a potential reward for an insured speculative covenant expedition." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Place .
amol:Zephyrus a rpg:Creature ;
    rpg:name "Zephyrus" ;
    dc:description "Air elementals composed of chains of octahedral corpuscles, encompassing wind, cloud, and lightning forms; utterly restless, highly perceptive travelers that crave the dissolution of barriers." ;
    skos:altLabel "Air Elementals", "Zephyri", "aeoliae", "brontes", "nenuphas", "silvestres", "sylphs" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:Zora a rpg:Character ;
    rpg:name "Zora" ;
    dc:description "The faeblooded priestess who leads the priesthood of Hertha; she gives Crintera Creo vis yearly and is the lover of Istvan Padas." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Zurenzialle a rpg:Character ;
    rpg:name "Zurenzialle" ;
    dc:description "An unremarkable magus of the 1100s who vanished from his covenant in the Greater Alps; his sodales discovered he had never been human but was a faerie being impersonating a magus." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:ZwinSeaDragon a rpg:Creature ;
    rpg:name "Zwin Sea Dragon" ;
    dc:description "A sea dragon that created the storm carving the Zwin channel near Brugge in a secret agreement with Derrick of Alsace, now demanding accumulated tolls via drowned-sailor emissaries." ;
    skos:altLabel "sea dragon" ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:AlGhazali a rpg:Character ;
    rpg:name "al-Ghazali" ;
    dc:description "An eleventh-century Islamic writer who firmly rejected the ideas of Aristotle, Plato, and Socrates in his book The Incoherence of the Philosophers." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:CharacterTag .
amol:Gruagachan a rpg:Creature ;
    rpg:name "gruagachan" ;
    dc:description "Monstrous wizards of northern Britain who, along with the Anglo-Saxon rune wizards, joined Damhan-Allaidh to oppose the Order." ;
    rpg:inWorld amol:MythicEurope ;
    rpg:hasTag amol:Creature .
amol:MagicalRavenCloak a rpg:Item ;
    rpg:name "magical raven cloak" ;
    dc:description "A magical cloak carried by the Skinchanger spouse covenfolk character, associated with her raven Skinchanger form." ;
    rpg:itemDefinedInRuleSet amol:ArM5 ;
    rpg:hasTag amol:MagicItem .
